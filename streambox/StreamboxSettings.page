<?PHP
$sb_file = '/boot/config/plugins/streambox/settings.cfg';
$sb = [
  'jf_host' => '127.0.0.1', 'jf_port' => '8096', 'jf_key' => '', 'jf_url' => '',
  'streams_max' => '8', 'added_rows' => '5', 'show_load' => '1',
  'socket_host' => '', 'socket_id' => '0',
  'notify' => '0', 'dc_movies' => '', 'dc_series' => '', 'notify_settle' => '5', 'notify_wait' => '30',
  'weekly' => '0', 'dc_weekly' => '', 'weekly_day' => '5', 'weekly_hour' => '18',
  'wk_show' => '1', 'wk_src' => 'seedbox', 'son_url' => '', 'son_key' => '', 'wk_delay' => 'series', 'wk_late' => '2', 'wk_dc' => '0', 'wk_web' => '1', 'wk_web_dir' => '/mnt/cache/docker/streambox/web', 'wk_web_view' => 'grid',
];
$sb_log = is_file('/tmp/streambox_notify.log') ? implode("\n", array_slice((array)@file('/tmp/streambox_notify.log', FILE_IGNORE_NEW_LINES), -6)) : '';
if (is_file($sb_file)) {
  $sb_c = @parse_ini_file($sb_file);
  if (is_array($sb_c)) { $sb = array_merge($sb, $sb_c); }
}
$sb_nicks = [];
$sb_nf = '/boot/config/plugins/streambox/nicknames.json';
if (is_file($sb_nf)) {
  $sb_n = json_decode((string)@file_get_contents($sb_nf), true);
  if (is_array($sb_n)) { $sb_nicks = $sb_n; }
}
$sb_var = @parse_ini_file('/var/local/emhttp/var.ini');
$sb_tok = is_array($sb_var) ? (string)($sb_var['csrf_token'] ?? '') : '';

// Jellyfin users, for the nickname table
$sb_users = null;
if ((string)$sb['jf_key'] !== '' && preg_match('/^[A-Za-z0-9.\-]+$/', (string)$sb['jf_host'])) {
  $sb_ch = curl_init('http://' . $sb['jf_host'] . ':' . (int)$sb['jf_port'] . '/Users');
  curl_setopt_array($sb_ch, [
    CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 3, CURLOPT_TIMEOUT => 4,
    CURLOPT_HTTPHEADER => ['Authorization: MediaBrowser Token="' . $sb['jf_key'] . '"', 'Accept: application/json'],
  ]);
  $sb_body = curl_exec($sb_ch);
  $sb_code = (int)curl_getinfo($sb_ch, CURLINFO_HTTP_CODE);
  curl_close($sb_ch);
  if ($sb_code === 200) {
    $sb_list = json_decode((string)$sb_body, true);
    if (is_array($sb_list)) {
      $sb_users = [];
      foreach ($sb_list as $sb_u) {
        if (!empty($sb_u['Id'])) { $sb_users[] = ['id' => (string)$sb_u['Id'], 'name' => (string)($sb_u['Name'] ?? '?')]; }
      }
      usort($sb_users, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
    }
  }
}
if (!function_exists('sb_h')) {
  function sb_h($v) { return htmlspecialchars((string)$v, ENT_QUOTES); }
}
if (!function_exists('sb_chk')) {
  function sb_chk($v) { return in_array(strtolower(trim((string)$v)), ['0', 'no', 'false', 'off', ''], true) ? '' : 'checked'; }
}
if (!function_exists('sb_auto')) {
  function sb_auto($name) {
    $parts = preg_split('/[\s._\-@]+/u', trim((string)$name));
    $first = ($parts && $parts[0] !== '') ? $parts[0] : trim((string)$name);
    $n = preg_match_all('/./us', $first);
    if ($n > 8) { return (preg_match('/^.{1,8}/us', $first, $m) ? $m[0] : substr($first, 0, 8)) . "\u{2026}"; }
    return $first;
  }
}
