<script>
$(function () {
  var T = function (k, v) { return MTL.t('sb', k, v); };
  var $msg = $('#sb-msg');
  $('#sb-save').on('click', function () {
    var $b = $(this).prop('disabled', true);
    $msg.css('color', '').text(T('set.saving'));
    $.post('/plugins/streambox/save.php', $('#sb-form').serialize(), null, 'json')
      .done(function (r) {
        if (r && r.ok) {
          $msg.css('color', '#3fa24a').text(T('set.saved'));
        } else {
          $msg.css('color', '#e5534b').text(T('set.not_saved', { e: (r && r.error) ? r.error : T('set.unknown_error') }));
        }
      })
      .fail(function (x) {
        var e = (x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : 'HTTP ' + x.status;
        $msg.css('color', '#e5534b').text(T('set.not_saved', { e: e }));
      })
      .always(function () { $b.prop('disabled', false); });
  });
  $('#sb-wtest').on('click', function () {
    var $b = $(this).prop('disabled', true), $m = $('#sb-wmsg').css('color', '').text(T('set.asking_sonarr'));
    $.getJSON('/plugins/streambox/week.php', { test: 1, _: Date.now() })
      .done(function (r) { $m.css('color', r && r.ok ? '#3fa24a' : '#e5534b').text((r && r.message) ? r.message : T('set.unknown_answer')); })
      .fail(function (x) { $m.css('color', '#e5534b').text('HTTP ' + x.status); })
      .always(function () { $b.prop('disabled', false); });
  });
  var $nm = $('#sb-nmsg');
  $('#sb-ntest, #sb-nprev, #sb-nweek').on('click', function () {
    var mode = (this.id === 'sb-nprev') ? 'preview' : ((this.id === 'sb-nweek') ? 'weekly' : 'test');
    var $b = $('#sb-ntest, #sb-nprev, #sb-nweek').prop('disabled', true);
    $nm.css('color', '').text(T('set.sending'));
    $.post('/plugins/streambox/notify_test.php', { mode: mode }, null, 'json')
      .done(function (r) { $nm.css('color', r && r.ok ? '#3fa24a' : '#e5534b').text((r && r.message) ? r.message : T('set.unknown_answer')); })
      .fail(function (x) {
        var e = (x.responseJSON && x.responseJSON.message) ? x.responseJSON.message : 'HTTP ' + x.status;
        $nm.css('color', '#e5534b').text(e);
      })
      .always(function () { $b.prop('disabled', false); });
  });
});
</script>
