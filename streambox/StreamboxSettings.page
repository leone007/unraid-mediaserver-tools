.uset dl dd>[class*="-mut"],.uset dl dd>.uset-hint,.uset dl dd>.uset-brk,.uset dl dd>div,.uset dl dd>p{flex:1 1 100%;margin:0}
.uset dl dd>[class*="-mut"],.uset dl dd>.uset-hint{opacity:.55;font-size:12px;max-width:120ch}
