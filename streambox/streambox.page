<script>
$(function () {
  var T = function (k, v) { return MTL.t('sb', k, v); };
  var API = '/plugins/streambox/api_fetch.php';
  var LOAD = '/plugins/streambox/load.php';
  var busy = false, loadBusy = false, loadTimer = null, themed = false;
  var DEF_UI = { port: 8096, url: '', load: true, added: 5 };
  var COLOR = { red: '#e5534b', amber: '#d9921f', green: '#3fa24a', blue: '#4a90e2', grey: '#8a8a8a', orange: '#f5a524' };
  var TYPE_ICON = { Movie: 'fa-film', Episode: 'fa-television', Season: 'fa-television', Audio: 'fa-music',
    TvChannel: 'fa-video-camera', LiveTvChannel: 'fa-video-camera', Program: 'fa-video-camera', Recording: 'fa-video-camera' };
  var MODE = {
    DirectPlay:   ['sb-play', T('mode.direct_play')],
    DirectStream: ['sb-stream', T('mode.direct_stream')],
    Transcode:    ['sb-trans', T('mode.transcode')]
  };

  // The embedded icon is light; invert it when the page background is light
  function applyTheme() {
    if (themed) { return; }
    themed = true;
    var el = document.getElementById('sb-now');
    while (el) {
      var m = /rgba?\(([^)]+)\)/.exec(getComputedStyle(el).backgroundColor || '');
      if (m) {
        var p = m[1].split(',');
        var a = p.length > 3 ? parseFloat(p[3]) : 1;
        if (a > 0.5) {
          if ((0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2]) > 150) { $('i.sb-ic').addClass('sb-inv'); }
          return;
        }
      }
      el = el.parentElement;
    }
  }

  function leftTxt(s) {
    s = Math.max(0, Math.floor(s));
    var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
    if (h > 0) { return T('time.left_hm', { h: h, m: (m < 10 ? '0' : '') + m }); }
    if (m > 0) { return T('time.left_m', { m: m }); }
    return T('time.left_s', { s: s });
  }
  function agoTxt(ts) {
    var d = Math.max(0, Math.floor(Date.now() / 1000) - ts);
    if (d < 60) { return T('time.just_now'); }
    if (d < 3600) { return T('time.ago_m', { m: Math.floor(d / 60) }); }
    if (d < 86400) { return T('time.ago_h', { h: Math.floor(d / 3600) }); }
    return T('time.ago_d', { d: Math.floor(d / 86400) });
  }
  function band(text, meta, first) {
    var $b = $('<div class="mt-band">').toggleClass('mt-first', !!first).append($('<span>').text(text));
    if (meta) { $b.append($('<b>').text(meta)); }
    return $b;
  }
  function mnote(t) { return $('<div class="mt-note">').text(t); }
  function note(t) { return $('<div class="sb-note">').text(t); }
  function moreLink(href, text) {
    return $('<a class="sb-more" target="_blank" rel="noopener">').attr('href', href)
      .append(document.createTextNode(text + ' ')).append($('<i class="fa fa-external-link">'));
  }
  function icon(cls, color) { return $('<i class="fa fa-fw">').addClass(cls).css('color', color); }

  function renderPill(r) {
    var $p = $('<div class="sb-pill">');
    var ok = r && r.ok;
    var st = ok ? [COLOR.green, 'fa-server', T('pill.online')]
         : (r && r.error === 'auth') ? [COLOR.amber, 'fa-key', T('pill.api_key')]
         : [COLOR.red, 'fa-chain-broken', T('pill.offline')];
    $p.append($('<span>').css('color', st[0]).append($('<i class="fa">').addClass(st[1])).append(document.createTextNode(' ' + st[2])));
    if (ok) {
      var n = r.streams_total || 0;
      if (n > 0) {
        $p.append($('<span>').css('color', COLOR.green).append($('<i class="fa fa-play">')).append(document.createTextNode(' ' + T('pill.streaming', { n: n }))));
      }
      if (r.transcoding > 0) {
        $p.append($('<span>').css('color', COLOR.amber).append($('<i class="fa fa-bolt">')).append(document.createTextNode(' ' + T('pill.transcoding', { n: r.transcoding }))));
      }
    }
    $('#sb-status').empty().append($p);
  }

  function renderSummary(r) {
    var $s = $('#sb-summary');
    if (!r || !r.ok) { $s.text(T('sum.unavailable')); return; }
    if (!r.streams_total) { $s.text(T('sum.no_streams')); return; }
    $s.text(T('sum.streams', { n: r.streams_total }) + ' \u00B7 ' + T('sum.users', { n: r.users })
      + (r.mbps > 0 ? ' \u00B7 ' + r.mbps.toFixed(1) + ' Mbps' : ''));
  }

  function renderNow(r) {
    var $n = $('#sb-now').empty();
    if (!r || !r.ok) {
      var msg = (r && r.error === 'auth') ? T('now.err_auth')
              : (r && r.error === 'nokey') ? T('now.err_nokey')
              : T('now.err_down');
      $n.append(note(msg));
      return;
    }
    var t = '18px minmax(0,1fr) 64px 84px 120px';
    $n.append(band(T('now.title') + ' \u00B7 ' + r.streams_total, '', true));
    var $box = $('<div class="mt-box">').appendTo($n);
    if (!r.streams.length) { $box.append(mnote(T('sum.no_streams'))); return; }
    $box.append($('<div class="mt-cols">').css('grid-template-columns', t)
      .append($('<div>')).append($('<div>').text(T('col.title'))).append($('<div>').text(T('col.user'))).append($('<div>').text(T('col.device')))
      .append($('<div>').css('color', COLOR.orange).text(T('col.mode'))));

    $.each(r.streams, function (i, x) {
      var m = MODE[x.mode] || MODE.DirectPlay;
      var $row = $('<div class="mt-r">').css('grid-template-columns', t).addClass('mt-n').addClass(x.paused ? 'mt-s-grey' : (x.mode === 'Transcode' ? 'mt-s-amber' : (x.mode === 'DirectStream' ? 'mt-s-blue' : 'mt-s-green')));
      $row.append(x.paused ? icon('fa-pause', COLOR.grey) : icon(TYPE_ICON[x.type] || 'fa-play-circle', '#9fb4c8'));

      var pct = Math.max(0, Math.min(100, x.pct * 100));
      var col = x.paused ? COLOR.grey : (x.mode === 'Transcode' ? COLOR.orange : COLOR.green);
      var $pl;
      if (x.live) {
        // live TV has no length: a label instead of a progress bar
        $pl = $('<div class="sb-pl">').append($('<span>').css('color', x.paused ? COLOR.grey : COLOR.red)
          .text(x.paused ? T('now.paused') : '\u25CF ' + T('now.live')));
        if (x.epg) {
          $pl.append($('<div class="sb-pb">').append($('<i>').css({ width: pct + '%', background: col })));
          if (x.left > 0) { $pl.append($('<span class="sb-u">').text(leftTxt(x.left))); }
        }
      } else {
        $pl = $('<div class="sb-pl">')
          .append($('<div class="sb-pb">').append($('<i>').css({ width: pct + '%', background: col })))
          .append($('<span>').css('color', col).text(x.paused ? T('now.paused') : Math.round(pct) + '%'));
        if (x.paused) { $pl.append($('<span class="sb-u">').text(Math.round(pct) + '%')); }
        else if (x.left > 0) { $pl.append($('<span class="sb-u">').text(leftTxt(x.left))); }
      }
      $row.append($('<div>').append($('<div class="sb-nm">').attr('title', x.title).text(x.title)).append($pl));

      $row.append($('<div class="sb-el">').attr('title', x.user_full).text(x.user));
      $row.append($('<div class="sb-el">').attr('title', x.device_full).text(x.device));
      $row.append($('<div>').attr('title', x.info || '').append($('<span class="sb-bd">').addClass(m[0]).text(m[1]))
        .append($('<div class="sb-rs">').addClass(x.mode === 'Transcode' ? 'sb-warn' : '').text(x.detail)));
      $box.append($row);
    });
  }

  function renderAdded(r, href) {
    var $a = $('#sb-added').empty();
    if (!r || !r.ok || !r.added || !r.added.length) { return; }
    var t = '18px minmax(0,1fr) 74px 52px 62px';
    $a.append(band(T('added.title') + ' \u00B7 ' + r.added.length, T('added.meta')));
    var $box = $('<div class="mt-box">').appendTo($a);
    $box.append($('<div class="mt-cols">').css('grid-template-columns', t)
      .append($('<div>')).append($('<div>').text(T('col.title'))).append($('<div>').text(T('col.type'))).append($('<div>').text(T('col.quality')))
      .append($('<div class="sb-num">').text(T('col.added'))));
    $.each(r.added, function (i, x) {
      var $row = $('<div class="mt-r">').css('grid-template-columns', t).addClass('mt-n').addClass(x.type === 'Movie' ? 'mt-s-blue' : 'mt-s-purple');
      $row.append(icon(TYPE_ICON[x.type] || 'fa-play-circle', '#9fb4c8'));
      $row.append($('<div class="sb-nm">').attr('title', x.title).text(x.title));
      $row.append($('<div>').append($('<span class="sb-bd">').addClass(x.type === 'Movie' ? 'sb-t-blue' : 'sb-t-purple').text(x.type === 'Movie' ? T('type.movie') : (x.type === 'Episode' ? T('type.episode') : x.type))));
      $row.append($('<div class="sb-num">').css('text-align', 'left').text(x.quality || '\u2014'));
      $row.append($('<div class="sb-num sb-u">').text(x.added ? agoTxt(x.added) : '\u2014'));
      $box.append($row);
    });
    $a.append(moreLink(href, T('tile.open_jellyfin')));
  }

  function card(label, pct, sub) {
    var col = pct >= 85 ? COLOR.red : (pct >= 60 ? COLOR.amber : COLOR.green);
    return $('<div class="sb-card">')
      .append($('<div class="sb-k">').text(label))
      .append($('<div class="sb-v">').text(Math.round(pct) + '%'))
      .append($('<div class="sb-pb">').append($('<i>').css({ width: Math.min(100, pct) + '%', background: col })))
      .append($('<div class="sb-u sb-sm">').css('margin-top', '4px').text(sub));
  }

  function fmtW(w) { return (w >= 100 ? w.toFixed(0) : w.toFixed(1)) + ' W'; }

  function renderLoad(d) {
    var $l = $('#sb-load').empty();
    if (!d || !d.ok) { return; }
    var cards = [];
    if (d.gpu) {
      cards.push(card('GPU \u00B7 ' + T('load.video'), d.gpu.video, 'Quick Sync'));
      cards.push(card('GPU \u00B7 ' + T('load.render'), d.gpu.render, d.gpu.freq > 0 ? Math.round(d.gpu.freq) + ' MHz' : T('load.idle')));
    }
    if (d.cpu !== null && d.cpu !== undefined) { cards.push(card('CPU', d.cpu, T('load.all_cores'))); }
    var sock = d.socket;
    if (!cards.length && !sock && !d.socket_note) { return; }

    var watts = (d.gpu && d.gpu.power > 0) ? d.gpu.power : 0;
    var $sec = band(cards.length ? T('load.title') + (watts > 0 ? ' \u00B7 ' + watts.toFixed(1) + ' W' : '') : T('load.socket'), '');
    if (cards.length) { $sec.find('span').attr('title', watts > 0 ? T('load.power_tip') : ''); }
    if (sock) {
      var month = (sock.month_kwh !== null && sock.month_kwh !== undefined) ? ' \u00B7 ' + T('load.kwh_month', { kwh: sock.month_kwh.toFixed(1) }) : '';
      $sec.append($('<b>').text(T('load.socket') + ' \u00B7 ' + fmtW(sock.power) + month)
        .attr('title', T('load.socket_tip')));
    } else if (d.socket_note) {
      $sec.append($('<b>').css('color', COLOR.amber).text(T('load.socket') + ' \u00B7 ' + T('load.na')).attr('title', d.socket_note));
    }
    $l.append($sec);

    if (cards.length) {
      var $g = $('<div class="sb-cards">').css('margin-top', '8px').css('grid-template-columns', 'repeat(' + cards.length + ',1fr)');
      $.each(cards, function (i, c) { $g.append(c); });
      $l.append($g);
    }
  }

  function pollLoad() {
    if (loadBusy) { return; }
    loadBusy = true;
    $.getJSON(LOAD, { _: Date.now() }).done(renderLoad).always(function () { loadBusy = false; });
  }

  function render(r) {
    applyTheme();
    var ui = (r && r.ui) ? r.ui : DEF_UI;
    var href = ui.url ? ui.url : 'http://' + location.hostname + ':' + ui.port;
    $('#sb-home').attr('href', href);
    renderPill(r);
    renderSummary(r);
    renderNow(r);
    renderAdded(r, href);
    if (r && r.ok && ui.load) {
      if (!loadTimer) { pollLoad(); loadTimer = setInterval(pollLoad, 10000); }
    } else {
      if (loadTimer) { clearInterval(loadTimer); loadTimer = null; }
      $('#sb-load').empty();
    }
  }

  function poll() {
    if (busy) { return; }
    busy = true;
    $.getJSON(API, { _: Date.now() })
      .done(render)
      .fail(function () { render({ ok: false, error: 'unreachable' }); })
      .always(function () { busy = false; });
  }

  poll();
  setInterval(poll, 5000);

  // ---- This week's episodes (week.php, Sonarr calendar + usual delay) ----
  var WEEK = '/plugins/streambox/week.php';
  var weekBusy = false;
  function hm(ts) { var d = new Date(ts * 1000); return (d.getHours() < 10 ? '0' : '') + d.getHours() + ':' + (d.getMinutes() < 10 ? '0' : '') + d.getMinutes(); }
  function durTxt(s) {
    s = Math.max(0, Math.floor(s / 60));
    var h = Math.floor(s / 60), m = s % 60;
    return h > 0 ? h + 'h' + (m ? ' ' + (m < 10 ? '0' : '') + m + 'm' : '') : m + 'm';
  }
  function cdTxt(s) {   // 1d 12h (minutes only under a day: 12h 46m)
    s = Math.max(0, Math.floor(s / 60));
    var d = Math.floor(s / 1440), h = Math.floor((s % 1440) / 60), m = s % 60, o = [];
    if (d) { o.push(d + 'd'); }
    if (d || h) { o.push(h + 'h'); }
    if (!d) { o.push((o.length && m < 10 ? '0' : '') + m + 'm'); }
    return o.join(' ');
  }
  var DOW = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'], MON = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
  function dhm(ts) { return T('date.dow.' + DOW[new Date(ts * 1000).getDay()]) + ' ' + hm(ts); }
  function dayLabel(ts) { var d = new Date(ts * 1000); return T('date.day', { dow: T('date.dow.' + DOW[d.getDay()]), d: d.getDate(), mon: T('date.mon.' + MON[d.getMonth()]) }); }
  var WST = {
    jf:    ['mt-s-green', 'sb-t-green', T('week.st.jf')],
    file:  ['mt-s-green', 'sb-t-green', T('week.st.file')],
    imp:   ['mt-s-blue', 'sb-t-blue', T('week.st.imp')],
    scan:  ['mt-s-blue', 'sb-t-blue', T('week.st.scan')],
    dl:    ['mt-s-blue', 'sb-t-blue', T('week.st.dl')],
    grab:  ['mt-s-blue', 'sb-t-blue', T('week.st.grab')],
    pause: ['mt-s-grey', 'sb-t-grey', T('week.st.pause')],
    fail:  ['mt-s-red', 'sb-t-red', T('week.st.fail')],
    late:  ['mt-s-amber', 'sb-t-amber', T('week.st.late')],
    aired: ['mt-s-grey', 'sb-t-grey', T('week.st.aired')],
    wait:  ['mt-s-grey', 'sb-t-grey', T('week.st.wait')]
  };
  // A season that comes out at once (2 or more episodes of one season on one day) is one row with one status:
  // the most urgent state of the episodes not yet in Jellyfin (all in Jellyfin: green), as in the Jellyfin week row
  var WORD = ['fail', 'dl', 'grab', 'imp', 'scan', 'pause', 'late', 'aired', 'wait'];
  function weekItems(rows) {
    var by = {}, order = [];
    $.each(rows, function (i, r) {
      var k = r.series + '|' + r.code.slice(0, 3);
      if (!by[k]) { by[k] = []; order.push(k); }
      by[k].push(r);
    });
    var out = [];
    $.each(order, function (i, k) {
      var g = by[k];
      if (g.length < 2) { out.push(g[0]); return; }
      g = g.slice().sort(function (a, b) { return a.code < b.code ? -1 : (a.code > b.code ? 1 : 0); });
      var f = g[0], l = g[g.length - 1], run = +l.code.slice(4) - +f.code.slice(4) + 1 === g.length;
      var jf = $.grep(g, function (r) { return r.st === 'jf' || r.st === 'file'; }).length, m = null;
      for (var j = 0; j < WORD.length && !m; j++) {
        var x = $.grep(g, function (r) { return r.st === WORD[j]; });
        if (x.length) { m = WORD[j] === 'dl' ? x.sort(function (a, b) { return (a.pct || 0) - (b.pct || 0); })[0] : x[0]; }
      }
      m = m || f;
      out.push($.extend({}, m, { code: run ? f.code + '–' + l.code.slice(3) : f.code.slice(0, 3), title: '', grp: g, jf: jf,
        st: jf === g.length ? 'jf' : m.st, idx: [], 'new': $.grep(g, function (r) { return r['new']; }).length > 0 }));
    });
    return out;
  }
  function renderWeek(w) {
    var $w = $('#sb-week').empty();
    if (!w || !w.show) { return; }
    var f = new Date(w.from * 1000), t = new Date((w.to - 1) * 1000);
    var range = T('date.range', { from: f.getMonth() !== t.getMonth() ? dayLabel(w.from) : T('date.day_short', { dow: T('date.dow.' + DOW[f.getDay()]), d: f.getDate() }), to: dayLabel(w.to - 1) });
    if (!w.ok) {
      if (w.show < 2) { return; }
      $w.append(band(T('week.title'), range));
      var why = w.error === 'nosonarr' ? T('week.err_nosonarr') : (w.error === 'auth' ? T('week.err_auth') : T('week.err_down'));
      $w.append($('<div class="mt-box">').append(mnote(why)));
      return;
    }
    if (!w.counts.all && w.show < 2) { return; }
    var meta = [range];
    if (w.counts.jf) { meta.push(T('week.n_jf', { n: w.counts.jf })); }
    if (w.counts.dl) { meta.push(T('week.n_dl', { n: w.counts.dl })); }
    if (w.counts.late) { meta.push(T('week.n_late', { n: w.counts.late })); }
    var $b = band(T('week.title') + ' \u00B7 ' + w.counts.all, meta.join(' \u00B7 '));
    if (w.counts.late) { $b.find('b').css({ color: COLOR.amber, opacity: 1 }); }
    $w.append($b);
    var $box = $('<div class="mt-box">').appendTo($w);
    if (!w.counts.all) { $box.append(mnote(T('week.none'))); return; }
    var t3 = '18px minmax(0,1fr) 108px 104px';
    $.each(w.days, function (i, d) {
      var ready = 0;
      $.each(d.rows, function (j, r) { if (r.st === 'jf' || r.st === 'file') { ready++; } });
      $box.append($('<div class="sb-day">').toggleClass('sb-today', !!d.today)
        .append($('<span>').text((d.today ? T('week.today') + ' \u00B7 ' : '') + (d.ts ? dayLabel(d.ts) : d.label)))
        .append($('<span>').text(ready ? T('week.n_jf', { n: ready }) : '')));
      $.each(weekItems(d.rows), function (j, r) {
        var s = WST[r.st] || WST.wait;
        var $row = $('<div class="mt-r mt-n">').addClass(s[0]).css('grid-template-columns', t3);
        $row.append(icon('fa-television', '#9fb4c8'));
        var ttl = r.grp ? $.map(r.grp, function (x) { return x.code + (x.title ? ' \u00B7 ' + x.title : '') + ' \u00B7 ' + (WST[x.st] || WST.wait)[2]; }).join('\n')
          : (r.title ? r.code + ' \u00B7 ' + r.title : r.code);
        var $t = $('<div class="sb-nm">').attr('title', ttl).text(r.series + ' \u00B7 ' + r.code);
        if (r['new']) { $t.append(' ').append($('<span class="sb-new">').attr('title', T('week.new_tip')).text(T('week.new'))); }
        var $nm = $('<div>').append($t);
        var sub = '';
        if (r.st === 'late') { sub = r.delay !== null ? T('week.late_usual', { usual: durTxt(r.delay), now: durTxt(w.now - r.air) }) : T('week.late_ago', { t: durTxt(w.now - r.air) }); }
        else if (r.idx && r.idx.length > 1 && (r.st === 'wait' || r.st === 'aired')) { sub = $.map(r.idx, function (x) { return x[0] + ' ~' + hm(x[1]); }).join(' \u00B7 '); }
        if (r.grp) { sub = T('week.eps', { n: r.grp.length }) + (r.jf && r.jf < r.grp.length ? ' \u00B7 ' + T('week.eps_jf', { n: r.jf }) : '') + (sub ? ' \u00B7 ' + sub : ''); }
        if (sub) { $nm.append($('<div class="sb-wsub">').text(sub)); }
        if (r.st === 'dl' && r.pct !== null) { $nm.append($('<div class="sb-pb">').css('margin-top', '5px').append($('<i>').css({ width: r.pct + '%', background: COLOR.blue }))); }
        $row.append($nm);
        // countdown to the expected time (to the air time when the delay is unknown); after it: overdue
        var nowS = Math.floor(Date.now() / 1000), target = r.exp !== null ? r.exp : r.air, when;
        if (r.st === 'wait' || r.st === 'aired' || r.st === 'late') {
          when = target > nowS ? T(r.exp === null ? 'week.airs_in' : 'week.in', { t: cdTxt(target - nowS) }) : (nowS - target < 60 ? T('week.due_now') : T('week.overdue', { t: cdTxt(nowS - target) }));
        } else { when = T('week.aired_at', { t: hm(r.air) }); }
        var tip = T('week.tip_airs', { t: dhm(r.air) }) + (r.exp !== null ? ' \u00b7 ' + T('week.tip_expected', { t: dhm(r.exp) }) : '') + '\n'
          + (r.exp === null ? T('week.tip_nohist')
            : T(r.basis === 'series' ? 'week.tip_delay_series' : 'week.tip_delay_all', { t: durTxt(r.delay), n: r.n }));
        $row.append($('<div class="sb-num sb-u">').css({ 'text-align': 'left', overflow: 'hidden', 'text-overflow': 'ellipsis' }).attr('title', when + '\n' + tip).text(when));
        var lab = s[2];
        if (r.st === 'dl' && r.pct !== null) { lab = r.pct + '%' + (r.left ? ' \u00B7 ' + durTxt(r.left) : ''); }
        $row.append($('<div>').append($('<span class="sb-bd">').addClass(s[1]).text(lab)
          .attr('title', r.st === 'scan' ? T('week.scan_tip') : '')));
        $box.append($row);
      });
    });
  }
  function pollWeek() {
    if (weekBusy) { return; }
    weekBusy = true;
    $.getJSON(WEEK, { _: Date.now() }).done(renderWeek).always(function () { weekBusy = false; });
  }
  pollWeek();
  setInterval(pollWeek, 60000);
});
</script>
