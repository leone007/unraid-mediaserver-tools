</style>
<script>
$(function () {
  var API = '/plugins/streambox/api_fetch.php';
  var LOAD = '/plugins/streambox/load.php';
  var busy = false, loadBusy = false, loadTimer = null, themed = false;
  var DEF_UI = { port: 8096, url: '', load: true, added: 5 };
  var COLOR = { red: '#e5534b', amber: '#d9921f', green: '#3fa24a', blue: '#4a90e2', grey: '#8a8a8a', orange: '#f5a524' };
  var TYPE_ICON = { Movie: 'fa-film', Episode: 'fa-television', Season: 'fa-television', Audio: 'fa-music',
    TvChannel: 'fa-video-camera', LiveTvChannel: 'fa-video-camera', Program: 'fa-video-camera', Recording: 'fa-video-camera' };
  var MODE = {
    DirectPlay:   ['sb-play', 'Direct play'],
    DirectStream: ['sb-stream', 'Direct stream'],
    Transcode:    ['sb-trans', 'Transcode']
  };

  // The embedded icon is light; invert it when the page background is light
  function applyTheme() {
    if (themed) { return; }
    themed = true;
    var el = document.getElementById('sb-now');
    while (el) {
      var m = /rgba?\(([^)]+)\)/.exec(getComputedStyle(el).backgroundColor || '');
      if (m) {
        var p = m[1].split(',');
        var a = p.length > 3 ? parseFloat(p[3]) : 1;
        if (a > 0.5) {
          if ((0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2]) > 150) { $('i.sb-ic').addClass('sb-inv'); }
          return;
        }
      }
      el = el.parentElement;
    }
  }

  function leftTxt(s) {
    s = Math.max(0, Math.floor(s));
    var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
    if (h > 0) { return h + 'h ' + (m < 10 ? '0' : '') + m + 'm left'; }
    if (m > 0) { return m + 'm left'; }
    return s + 's left';
  }
  function agoTxt(ts) {
    var d = Math.max(0, Math.floor(Date.now() / 1000) - ts);
    if (d < 60) { return 'just now'; }
    if (d < 3600) { return Math.floor(d / 60) + 'm ago'; }
    if (d < 86400) { return Math.floor(d / 3600) + 'h ago'; }
    return Math.floor(d / 86400) + 'd ago';
  }
  function band(text, meta, first) {
    var $b = $('<div class="mt-band">').toggleClass('mt-first', !!first).append($('<span>').text(text));
    if (meta) { $b.append($('<b>').text(meta)); }
    return $b;
  }
  function mnote(t) { return $('<div class="mt-note">').text(t); }
  function note(t) { return $('<div class="sb-note">').text(t); }
  function moreLink(href, text) {
    return $('<a class="sb-more" target="_blank" rel="noopener">').attr('href', href)
      .append(document.createTextNode(text + ' ')).append($('<i class="fa fa-external-link">'));
  }
  function icon(cls, color) { return $('<i class="fa fa-fw">').addClass(cls).css('color', color); }

  function renderPill(r) {
    var $p = $('<div class="sb-pill">');
    var ok = r && r.ok;
    var st = ok ? [COLOR.green, 'fa-server', 'Online']
         : (r && r.error === 'auth') ? [COLOR.amber, 'fa-key', 'API key']
         : [COLOR.red, 'fa-chain-broken', 'Offline'];
    $p.append($('<span>').css('color', st[0]).append($('<i class="fa">').addClass(st[1])).append(document.createTextNode(' ' + st[2])));
    if (ok) {
      var n = r.streams_total || 0;
      if (n > 0) {
        $p.append($('<span>').css('color', COLOR.green).append($('<i class="fa fa-play">')).append(document.createTextNode(' ' + n + ' streaming')));
      }
      if (r.transcoding > 0) {
        $p.append($('<span>').css('color', COLOR.amber).append($('<i class="fa fa-bolt">')).append(document.createTextNode(' ' + r.transcoding + ' transcoding')));
      }
    }
    $('#sb-status').empty().append($p);
  }

  function renderSummary(r) {
    var $s = $('#sb-summary');
    if (!r || !r.ok) { $s.text('Unavailable'); return; }
    if (!r.streams_total) { $s.text('No active streams'); return; }
    $s.text(r.streams_total + (r.streams_total === 1 ? ' stream' : ' streams') + ' \u00B7 ' + r.users + (r.users === 1 ? ' user' : ' users')
      + (r.mbps > 0 ? ' \u00B7 ' + r.mbps.toFixed(1) + ' Mbps' : ''));
  }

  function renderNow(r) {
    var $n = $('#sb-now').empty();
    if (!r || !r.ok) {
      var msg = (r && r.error === 'auth') ? 'Jellyfin rejected the API key (check Streambox settings)'
              : (r && r.error === 'nokey') ? 'Enter the Jellyfin API key in the Streambox settings'
              : 'Jellyfin unreachable';
      $n.append(note(msg));
      return;
    }
    var t = '18px minmax(0,1fr) 64px 84px 120px';
    $n.append(band('Now playing \u00B7 ' + r.streams_total, '', true));
    var $box = $('<div class="mt-box">').appendTo($n);
    if (!r.streams.length) { $box.append(mnote('No active streams')); return; }
    $box.append($('<div class="mt-cols">').css('grid-template-columns', t)
      .append($('<div>')).append($('<div>').text('Title')).append($('<div>').text('User')).append($('<div>').text('Device'))
      .append($('<div>').css('color', COLOR.orange).text('Mode')));

    $.each(r.streams, function (i, x) {
      var m = MODE[x.mode] || MODE.DirectPlay;
      var $row = $('<div class="mt-r">').css('grid-template-columns', t).addClass('mt-n').addClass(x.paused ? 'mt-s-grey' : (x.mode === 'Transcode' ? 'mt-s-amber' : (x.mode === 'DirectStream' ? 'mt-s-blue' : 'mt-s-green')));
      $row.append(x.paused ? icon('fa-pause', COLOR.grey) : icon(TYPE_ICON[x.type] || 'fa-play-circle', '#9fb4c8'));

      var pct = Math.max(0, Math.min(100, x.pct * 100));
      var col = x.paused ? COLOR.grey : (x.mode === 'Transcode' ? COLOR.orange : COLOR.green);
      var $pl;
      if (x.live) {
        // live TV has no length: a label instead of a progress bar
        $pl = $('<div class="sb-pl">').append($('<span>').css('color', x.paused ? COLOR.grey : COLOR.red)
          .text(x.paused ? 'Paused' : '\u25CF LIVE'));
        if (x.epg) {
          $pl.append($('<div class="sb-pb">').append($('<i>').css({ width: pct + '%', background: col })));
          if (x.left > 0) { $pl.append($('<span class="sb-u">').text(leftTxt(x.left))); }
        }
      } else {
        $pl = $('<div class="sb-pl">')
          .append($('<div class="sb-pb">').append($('<i>').css({ width: pct + '%', background: col })))
          .append($('<span>').css('color', col).text(x.paused ? 'Paused' : Math.round(pct) + '%'));
        if (x.paused) { $pl.append($('<span class="sb-u">').text(Math.round(pct) + '%')); }
        else if (x.left > 0) { $pl.append($('<span class="sb-u">').text(leftTxt(x.left))); }
      }
      $row.append($('<div>').append($('<div class="sb-nm">').attr('title', x.title).text(x.title)).append($pl));

      $row.append($('<div class="sb-el">').attr('title', x.user_full).text(x.user));
      $row.append($('<div class="sb-el">').attr('title', x.device_full).text(x.device));
      $row.append($('<div>').attr('title', x.info || '').append($('<span class="sb-bd">').addClass(m[0]).text(m[1]))
        .append($('<div class="sb-rs">').addClass(x.mode === 'Transcode' ? 'sb-warn' : '').text(x.detail)));
      $box.append($row);
    });
  }

  function renderAdded(r, href) {
    var $a = $('#sb-added').empty();
    if (!r || !r.ok || !r.added || !r.added.length) { return; }
    var t = '18px minmax(0,1fr) 74px 52px 62px';
    $a.append(band('Recently added \u00B7 ' + r.added.length, 'latest from Jellyfin'));
    var $box = $('<div class="mt-box">').appendTo($a);
    $box.append($('<div class="mt-cols">').css('grid-template-columns', t)
      .append($('<div>')).append($('<div>').text('Title')).append($('<div>').text('Type')).append($('<div>').text('Quality'))
      .append($('<div class="sb-num">').text('Added')));
    $.each(r.added, function (i, x) {
      var $row = $('<div class="mt-r">').css('grid-template-columns', t).addClass('mt-n').addClass(x.type === 'Movie' ? 'mt-s-blue' : 'mt-s-purple');
      $row.append(icon(TYPE_ICON[x.type] || 'fa-play-circle', '#9fb4c8'));
      $row.append($('<div class="sb-nm">').attr('title', x.title).text(x.title));
      $row.append($('<div>').append($('<span class="sb-bd">').addClass(x.type === 'Movie' ? 'sb-t-blue' : 'sb-t-purple').text(x.type)));
      $row.append($('<div class="sb-num">').css('text-align', 'left').text(x.quality || '\u2014'));
      $row.append($('<div class="sb-num sb-u">').text(x.added ? agoTxt(x.added) : '\u2014'));
      $box.append($row);
    });
    $a.append(moreLink(href, 'Open Jellyfin'));
  }

  function card(label, pct, sub) {
    var col = pct >= 85 ? COLOR.red : (pct >= 60 ? COLOR.amber : COLOR.green);
    return $('<div class="sb-card">')
      .append($('<div class="sb-k">').text(label))
      .append($('<div class="sb-v">').text(Math.round(pct) + '%'))
      .append($('<div class="sb-pb">').append($('<i>').css({ width: Math.min(100, pct) + '%', background: col })))
      .append($('<div class="sb-u sb-sm">').css('margin-top', '4px').text(sub));
  }

  function fmtW(w) { return (w >= 100 ? w.toFixed(0) : w.toFixed(1)) + ' W'; }

  function renderLoad(d) {
    var $l = $('#sb-load').empty();
    if (!d || !d.ok) { return; }
    var cards = [];
    if (d.gpu) {
      cards.push(card('GPU \u00B7 Video', d.gpu.video, 'Quick Sync'));
      cards.push(card('GPU \u00B7 Render', d.gpu.render, d.gpu.freq > 0 ? Math.round(d.gpu.freq) + ' MHz' : 'idle'));
    }
    if (d.cpu !== null && d.cpu !== undefined) { cards.push(card('CPU', d.cpu, 'all cores')); }
    var sock = d.socket;
    if (!cards.length && !sock && !d.socket_note) { return; }

    var watts = (d.gpu && d.gpu.power > 0) ? d.gpu.power : 0;
    var $sec = band(cards.length ? 'Server load' + (watts > 0 ? ' \u00B7 ' + watts.toFixed(1) + ' W' : '') : 'Socket', '');
    if (cards.length) { $sec.find('span').attr('title', watts > 0 ? 'CPU package power (includes the integrated GPU); not the power drawn at the wall' : ''); }
    if (sock) {
      var month = (sock.month_kwh !== null && sock.month_kwh !== undefined) ? ' \u00B7 ' + sock.month_kwh.toFixed(1) + ' kWh/mo' : '';
      $sec.append($('<b>').text('Socket \u00B7 ' + fmtW(sock.power) + month)
        .attr('title', "Smart socket: power drawn at the wall. The monthly figure is the socket's own energy counter since the 1st of the month."));
    } else if (d.socket_note) {
      $sec.append($('<b>').css('color', COLOR.amber).text('Socket \u00B7 n/a').attr('title', d.socket_note));
    }
    $l.append($sec);

    if (cards.length) {
      var $g = $('<div class="sb-cards">').css('margin-top', '8px').css('grid-template-columns', 'repeat(' + cards.length + ',1fr)');
      $.each(cards, function (i, c) { $g.append(c); });
      $l.append($g);
    }
  }

  function pollLoad() {
    if (loadBusy) { return; }
    loadBusy = true;
    $.getJSON(LOAD, { _: Date.now() }).done(renderLoad).always(function () { loadBusy = false; });
  }

  function render(r) {
    applyTheme();
    var ui = (r && r.ui) ? r.ui : DEF_UI;
    var href = ui.url ? ui.url : 'http://' + location.hostname + ':' + ui.port;
    $('#sb-home').attr('href', href);
    renderPill(r);
    renderSummary(r);
    renderNow(r);
    renderAdded(r, href);
    if (r && r.ok && ui.load) {
      if (!loadTimer) { pollLoad(); loadTimer = setInterval(pollLoad, 10000); }
    } else {
      if (loadTimer) { clearInterval(loadTimer); loadTimer = null; }
      $('#sb-load').empty();
    }
  }

  function poll() {
    if (busy) { return; }
    busy = true;
    $.getJSON(API, { _: Date.now() })
      .done(render)
      .fail(function () { render({ ok: false, error: 'unreachable' }); })
      .always(function () { busy = false; });
  }

  poll();
  setInterval(poll, 5000);

  // ---- This week's episodes (week.php, Sonarr calendar + usual delay) ----
  var WEEK = '/plugins/streambox/week.php';
  var weekBusy = false;
  function hm(ts) { var d = new Date(ts * 1000); return (d.getHours() < 10 ? '0' : '') + d.getHours() + ':' + (d.getMinutes() < 10 ? '0' : '') + d.getMinutes(); }
  function durTxt(s) {
    s = Math.max(0, Math.floor(s / 60));
    var h = Math.floor(s / 60), m = s % 60;
    return h > 0 ? h + 'h' + (m ? ' ' + (m < 10 ? '0' : '') + m + 'm' : '') : m + 'm';
  }
  function cdTxt(s) {   // 1d 12h 46m
    s = Math.max(0, Math.floor(s / 60));
    var d = Math.floor(s / 1440), h = Math.floor((s % 1440) / 60), m = s % 60, o = [];
    if (d) { o.push(d + 'd'); }
    if (d || h) { o.push(h + 'h'); }
    o.push((o.length && m < 10 ? '0' : '') + m + 'm');
    return o.join(' ');
  }
  function dhm(ts) { return ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date(ts * 1000).getDay()] + ' ' + hm(ts); }
  var WST = {
    jf:    ['mt-s-green', 'sb-t-green', 'In Jellyfin'],
    file:  ['mt-s-green', 'sb-t-green', 'Downloaded'],
    imp:   ['mt-s-blue', 'sb-t-blue', 'Importing'],
    scan:  ['mt-s-blue', 'sb-t-blue', 'Imported'],
    dl:    ['mt-s-blue', 'sb-t-blue', 'Downloading'],
    grab:  ['mt-s-blue', 'sb-t-blue', 'Grabbed'],
    pause: ['mt-s-grey', 'sb-t-grey', 'Paused'],
    fail:  ['mt-s-red', 'sb-t-red', 'Failed'],
    late:  ['mt-s-amber', 'sb-t-amber', 'No release'],
    aired: ['mt-s-grey', 'sb-t-grey', 'Aired'],
    wait:  ['mt-s-grey', 'sb-t-grey', 'Waiting']
  };
  function renderWeek(w) {
    var $w = $('#sb-week').empty();
    if (!w || !w.show) { return; }
    var f = new Date(w.from * 1000), t = new Date((w.to - 1) * 1000);
    var M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    var range = 'Mon ' + f.getDate() + (f.getMonth() !== t.getMonth() ? ' ' + M[f.getMonth()] : '') + ' \u2013 Sun ' + t.getDate() + ' ' + M[t.getMonth()];
    if (!w.ok) {
      if (w.show < 2) { return; }
      $w.append(band("This week's episodes", range));
      var why = w.error === 'nosonarr' ? 'Sonarr is not set (Streambox settings)' : (w.error === 'auth' ? 'Sonarr rejected the API key' : 'Sonarr unreachable');
      $w.append($('<div class="mt-box">').append(mnote(why)));
      return;
    }
    if (!w.counts.all && w.show < 2) { return; }
    var meta = [range];
    if (w.counts.jf) { meta.push(w.counts.jf + ' in Jellyfin'); }
    if (w.counts.dl) { meta.push(w.counts.dl + ' downloading'); }
    if (w.counts.late) { meta.push(w.counts.late + ' late'); }
    var $b = band("This week's episodes \u00B7 " + w.counts.all, meta.join(' \u00B7 '));
    if (w.counts.late) { $b.find('b').css({ color: COLOR.amber, opacity: 1 }); }
    $w.append($b);
    var $box = $('<div class="mt-box">').appendTo($w);
    if (!w.counts.all) { $box.append(mnote('No monitored episode airs this week')); return; }
    var t3 = '18px minmax(0,1fr) 108px 104px';
    $.each(w.days, function (i, d) {
      var ready = 0;
      $.each(d.rows, function (j, r) { if (r.st === 'jf' || r.st === 'file') { ready++; } });
      $box.append($('<div class="sb-day">').toggleClass('sb-today', !!d.today)
        .append($('<span>').text((d.today ? 'Today \u00B7 ' : '') + d.label))
        .append($('<span>').text(ready ? ready + ' in Jellyfin' : '')));
      $.each(d.rows, function (j, r) {
        var s = WST[r.st] || WST.wait;
        var $row = $('<div class="mt-r mt-n">').addClass(s[0]).css('grid-template-columns', t3);
        $row.append(icon('fa-television', '#9fb4c8'));
        var $t = $('<div class="sb-nm">').attr('title', r.title ? r.code + ' \u00B7 ' + r.title : r.code).text(r.series + ' \u00B7 ' + r.code);
        if (r['new']) { $t.append(' ').append($('<span class="sb-new">').attr('title', 'New series: its first episode airs this week').text('New')); }
        var $nm = $('<div>').append($t);
        var sub = '';
        if (r.st === 'late') { sub = (r.delay !== null ? 'usually ' + durTxt(r.delay) + ' after airing, now ' : 'aired ') + durTxt(w.now - r.air) + (r.delay !== null ? '' : ' ago'); }
        else if (r.idx && r.idx.length > 1 && (r.st === 'wait' || r.st === 'aired')) { sub = $.map(r.idx, function (x) { return x[0] + ' ~' + hm(x[1]); }).join(' \u00B7 '); }
        if (sub) { $nm.append($('<div class="sb-wsub">').text(sub)); }
        if (r.st === 'dl' && r.pct !== null) { $nm.append($('<div class="sb-pb">').css('margin-top', '5px').append($('<i>').css({ width: r.pct + '%', background: COLOR.blue }))); }
        $row.append($nm);
        // countdown to the expected time (to the air time when the delay is unknown); after it: overdue
        var nowS = Math.floor(Date.now() / 1000), target = r.exp !== null ? r.exp : r.air, when;
        if (r.st === 'wait' || r.st === 'aired' || r.st === 'late') {
          when = target > nowS ? (r.exp === null ? 'airs in ' : 'in ') + cdTxt(target - nowS) : (nowS - target < 60 ? 'due now' : 'overdue ' + cdTxt(nowS - target));
        } else { when = 'aired ' + hm(r.air); }
        var tip = 'Airs ' + dhm(r.air) + (r.exp !== null ? ' \u00b7 expected ~' + dhm(r.exp) : '') + '\n'
          + (r.exp === null ? 'No grab history yet: the usual delay after airing is unknown'
            : 'Usual delay after airing: ' + durTxt(r.delay) + ' (median of ' + r.n + ' episode' + (r.n === 1 ? '' : 's') + (r.basis === 'series' ? ' of this series' : ' of all series') + ')');
        $row.append($('<div class="sb-num sb-u">').css('text-align', 'left').attr('title', tip).text(when));
        var lab = s[2];
        if (r.st === 'dl' && r.pct !== null) { lab = r.pct + '%' + (r.left ? ' \u00B7 ' + durTxt(r.left) : ''); }
        $row.append($('<div>').append($('<span class="sb-bd">').addClass(s[1]).text(lab)
          .attr('title', r.st === 'scan' ? 'Sonarr imported it; Jellyfin has not listed it yet' : '')));
        $box.append($row);
      });
    });
  }
  function pollWeek() {
    if (weekBusy) { return; }
    weekBusy = true;
    $.getJSON(WEEK, { _: Date.now() }).done(renderWeek).always(function () { weekBusy = false; });
  }
  pollWeek();
  setInterval(pollWeek, 60000);
});
</script>
