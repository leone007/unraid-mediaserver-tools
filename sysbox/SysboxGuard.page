<?=mt_i18n_js($gdm_lang, 'gdm')?>
<script>
$(function () {
  var T = function (k, v) { return MTL.t('gdm', k, v); };
  var URL = '/plugins/sysbox/guard.php', D = null, OPEN = {}, CONF = null, pollT = null, WAIT = 0;
  var LV = {red: ['r', 's-red', T('lv.red')], amber: ['a', 's-amber', T('lv.amber')], green: ['g', 's-green', T('lv.green')]};
  var LINK = {diskbox: '/Dashboard', updates: '/Settings/SysboxUpdates', docker: '/Docker', seedbox: '/Settings/SeedboxTools', syslog: '/Tools/Syslog'};
  function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
  function api(op, data) { return $.post(URL, $.extend({op: op}, data || {}), null, 'json'); }
  function err(x) { return (x && x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : (x && x.error) ? x.error : 'HTTP ' + (x && x.status); }
  function ago(t) { var s = Math.max(0, Math.floor(Date.now() / 1000) - t); return s >= 86400 ? T('ago.d', { n: Math.floor(s / 86400) }) : s >= 3600 ? T('ago.h', { n: Math.floor(s / 3600) }) : T('ago.m', { n: Math.max(1, Math.floor(s / 60)) }); }
  function two(n) { return ('0' + n).slice(-2); }
  function hm(t) { var d = new Date(t * 1000); return two(d.getHours()) + ':' + two(d.getMinutes()); }
  function day(t) { var d = new Date(t * 1000); return T('dow.' + ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'][d.getDay()]) + ' ' + two(d.getMonth() + 1) + '-' + two(d.getDate()); }
  function dur(s) { return s >= 60 ? T('dur.ms', { m: Math.floor(s / 60), s: s % 60 }) : T('dur.s', { s: s }); }
  function gbar(g, cls, title, count) { return '<div class="gdm-gbar ' + cls + '" data-g="' + esc(g) + '"><span class="pm">' + (OPEN[g] ? '&minus;' : '+') + '</span><span>' + title + '</span><span class="c">' + count + '</span></div>'; }
  function grp(g, inner) { return '<div class="gdm-grp" data-g="' + esc(g) + '"' + (OPEN[g] ? '' : ' hidden') + '>' + inner + '</div>'; }
  $(document).on('click', '#gdm .gdm-gbar', function () { var g = String($(this).data('g')); OPEN[g] = !OPEN[g]; $(this).find('.pm').html(OPEN[g] ? '&minus;' : '+'); $('#gdm .gdm-grp').filter(function () { return String($(this).data('g')) === g; }).prop('hidden', !OPEN[g]); });
  function bad(r) { return $.grep(r.items || [], function (x) { return x.level !== 'green'; }).length; }

  // ---- Activity
  function drawAct(r) {
    var run = [], fin = [];
    $.each(r.jobs || [], function (i, j) { (j.state === 'running' ? run : fin).push(j); });
    fin.sort(function (a, b) { return (b.finished || 0) - (a.finished || 0); });
    var h = '';
    $.each(run, function (i, j) { h += '<div class="gdm-row gdm-job s-blue"><span class="gdm-ico">&#8635;</span><span><b>' + esc(j.text) + '</b><small>' + esc((j.log || []).slice(-1).join('') || T('gdm.started', { t: hm(j.started) })) + '</small></span><span class="gdm-num">' + esc(dur(Math.max(0, Math.floor(Date.now() / 1000) - j.started))) + '</span></div>'; });
    var f = '';
    $.each(fin, function (i, j) { var ok = j.state === 'done'; f += '<div class="gdm-row gdm-job ' + (ok ? 's-green' : 's-red') + '"><span class="gdm-ico ' + (ok ? 'gdm-ok">&#10003;' : 'gdm-er">!') + '</span><span>' + esc(j.text) + '</span><span class="gdm-num">' + esc(hm(j.finished || j.started)) + '</span></div>'; });
    if (fin.length) { h += gbar('fin', 's-grey', esc(T('gdm.fin_today')), fin.length) + grp('fin', f); }
    if (r.log && r.log.length) { h += gbar('log', 's-grey', esc(T('gdm.log')), esc(T('gdm.lines', { n: r.log.length }))) + grp('log', '<div class="gdm-log">' + esc(r.log.slice().reverse().join('\n')) + '</div>'); }
    if (r.night) { h += '<div class="gdm-row gdm-job s-grey"><span class="gdm-ico">&#9790;</span><span>' + esc(T('gdm.night', { n: r.night })) + '</span><span></span></div>'; }
    $('#gdm-act').html(h || '<div class="gdm-status gdm-mut">' + esc(T('gdm.nothing_run')) + '</div>');
    $('#gdm-aband').text(run.length ? T('gdm.n_running', { n: run.length }) : fin.length ? T('gdm.n_fin', { n: fin.length }) : '');
  }

  // ---- one finding
  function item(x, r, i) {
    var l = LV[x.level] || LV.amber, acts = '<span class="gdm-chip ' + l[0] + '">' + esc(l[2]) + '</span>';
    if (x.known) { acts = '<span class="gdm-chip p">' + esc(T('gdm.known')) + '</span>'; }
    else if (x.dismissed) { acts = '<span class="gdm-chip">' + esc(T('gdm.dismissed', { t: hm(x.dismissed) })) + '</span>'; }
    if (x.link && LINK[x.link]) { acts += '<a class="gdm-link" href="' + LINK[x.link] + '">' + esc(T('link.' + x.link)) + '</a>'; }
    if (x.level !== 'green' && r && !x.known) {   // the owner's answers (item 84)
      acts += '<input type="button" class="gdm-kn gdm-ghost gdm-sm" value="' + esc(T('gdm.b_known')) + '">' +
        '<input type="button" class="gdm-nt gdm-ghost gdm-sm" value="' + esc(x.noted ? T('gdm.b_noted') : T('gdm.b_note')) + '">' +
        '<input type="button" class="gdm-ds gdm-ghost gdm-sm" value="' + esc(x.dismissed ? T('gdm.b_undismiss') : T('gdm.b_dismiss')) + '">';
    }
    return '<div class="gdm-row gdm-it ' + l[1] + (x.dismissed || x.known ? ' gdm-dis' : '') + '"' + (r ? ' data-rid="' + esc(r.id) + '" data-idx="' + i + '"' : '') + '><span><b class="k">' + esc(x.area) + '</b><small>' + esc(T('topic.' + x.topic)) + '</small></span><span>' +
      '<p><b>' + esc(x.title) + '</b> ' + esc(x.text) + '</p>' + (x.todo ? '<p class="why">' + esc(T('gdm.todo', { t: x.todo })) + '</p>' : '') +
      (x.cmd ? '<div class="gdm-cmd"><span>' + esc(x.cmd) + '</span><input type="button" class="gdm-copy gdm-ghost gdm-sm" value="' + esc(T('gdm.copy')) + '"></div>' : '') +
      '</span><span class="gdm-acts">' + acts + '</span></div>';
  }
  $(document).on('click', '#gdm .gdm-copy', function () {
    var b = this, t = $(b).prev().text();
    try { navigator.clipboard.writeText(t).then(function () { b.value = T('gdm.copied'); }, function () { b.value = T('gdm.select'); }); } catch (e) { b.value = T('gdm.select'); }
  });
  function body(r) {
    if (r.error) { return '<div class="gdm-row gdm-it s-red"><span><b class="k">' + esc(T('gdm.failed')) + '</b></span><span><p>' + esc(r.error) + '</p></span><span></span></div>'; }
    if (r.skipped) { return '<div class="gdm-row gdm-it s-grey"><span><b class="k">' + esc(T('gdm.skipped')) + '</b></span><span><p>' + esc(r.skipped) + '</p></span><span></span></div>'; }
    var h = '';
    $.each(r.items || [], function (i, x) { h += item(x, r, i); });
    if (r.noise) { var g = 'noise' + r.id; h += gbar(g, 's-grey', esc(T('gdm.noise')), '') + grp(g, '<div class="gdm-row gdm-it s-grey"><span><b class="k">syslog</b></span><span><p>' + esc(r.noise) + '</p></span><span></span></div>'); }
    return h;
  }
  function kindTxt(r) { return r.kind === 'event' ? T('gdm.k_event') : r.kind === 'manual' ? T('gdm.k_manual') : T('gdm.k_daily'); }

  // ---- answers to a finding: Known (with why and an optional condition), a note for Claude Code, Dismiss from the tile
  function itemRef(el) { var $r = $(el).closest('[data-rid]'); return {$r: $r, rid: String($r.data('rid')), idx: +$r.data('idx')}; }
  function act(op, data, $b) { $b.prop('disabled', true); api(op, data).done(function (r) { if (!r.ok) { window.alert(r.error); $b.prop('disabled', false); } else { FORM = null; load(); } }).fail(function (x) { window.alert(err(x)); $b.prop('disabled', false); }); }
  var FORM = null;   // an open form survives the 3-second refresh: {rid, idx, kind}
  function formHtml(kind) {
    return kind === 'known' ?
      '<div class="gdm-form"><label>' + esc(T('gdm.f_why')) + '<input type="text" class="gdm-f1" maxlength="300"></label><label>' + esc(T('gdm.f_again')) + '<input type="text" class="gdm-f2" maxlength="200"></label>' +
      '<input type="button" class="gdm-f-ok" value="' + esc(T('gdm.b_mark')) + '"><input type="button" class="gdm-f-no gdm-ghost gdm-sm" value="' + esc(T('gdm.cancel')) + '"></div>' :
      '<div class="gdm-form"><label>' + esc(T('gdm.f_note')) + '<input type="text" class="gdm-f1" maxlength="600"></label>' +
      '<input type="button" class="gdm-f-ok" value="' + esc(T('gdm.b_send')) + '"><input type="button" class="gdm-f-no gdm-ghost gdm-sm" value="' + esc(T('gdm.cancel')) + '"></div>';
  }
  function openForm(el, kind) { var o = itemRef(el); o.$r.find('.gdm-form').remove(); o.$r.append(formHtml(kind)); o.$r.find('.gdm-f1').focus(); FORM = {rid: o.rid, idx: o.idx, kind: kind}; }
  $(document).on('click', '#gdm .gdm-kn', function () { openForm(this, 'known'); });
  $(document).on('click', '#gdm .gdm-nt', function () { openForm(this, 'note'); });
  $(document).on('click', '#gdm .gdm-f-no', function () { $(this).closest('.gdm-form').remove(); FORM = null; });
  $(document).on('click', '#gdm .gdm-f-ok', function () {
    var o = itemRef(this), $f = $(this).closest('.gdm-form');
    if (FORM && FORM.kind === 'known') { act('known', {rid: o.rid, idx: o.idx, why: $f.find('.gdm-f1').val(), again: $f.find('.gdm-f2').val()}, $(this)); }
    else { act('note', {rid: o.rid, idx: o.idx, text: $f.find('.gdm-f1').val()}, $(this)); }
  });
  $(document).on('click', '#gdm .gdm-ds', function () { var o = itemRef(this), on = !$(this).closest('.gdm-it').hasClass('gdm-dis'); act('dismiss', {rid: o.rid, idx: o.idx, on: on ? 1 : 0}, $(this)); });
  $(document).on('click', '#gdm .gdm-kdel', function () { act('unknown', {kid: String($(this).data('kid'))}, $(this)); });
  function drawKnown(r) {
    var K = r.known || [], h = '';
    $.each(K, function (i, k) {
      h += '<div class="gdm-row gdm-it s-purple"><span><b class="k">' + esc(k.area) + '</b><small>' + esc(day(k.t)) + '</small></span><span><p>' + esc(k.title) + '</p><p class="why">' + esc(T('gdm.k_why', { t: k.why })) +
        (k.again ? ' · ' + esc(T('gdm.k_again', { t: k.again })) : '') + '</p></span><span class="gdm-acts"><input type="button" class="gdm-kdel gdm-ghost gdm-sm" data-kid="' + esc(k.id) + '" value="' + esc(T('gdm.b_remove')) + '"></span></div>';
    });
    $('#gdm-known').html(h || '<div class="gdm-status gdm-mut">' + esc(T('gdm.no_known')) + '</div>');
    $('#gdm-kband').text(T('gdm.known_band', { n: K.length }));
  }
  function restoreForm() {   // the refresh redraws the rows: put an open form back with what was typed
    if (!FORM) { return; }
    var $r = $('#gdm [data-rid="' + FORM.rid + '"][data-idx="' + FORM.idx + '"]').first(); if (!$r.length || $r.find('.gdm-form').length) { return; }
    $r.append(formHtml(FORM.kind)); if (FORM.v1) { $r.find('.gdm-f1').val(FORM.v1); } if (FORM.v2) { $r.find('.gdm-f2').val(FORM.v2); }
  }
  $(document).on('input', '#gdm .gdm-form input[type=text]', function () { if (FORM) { var $f = $(this).closest('.gdm-form'); FORM.v1 = $f.find('.gdm-f1').val(); FORM.v2 = $f.find('.gdm-f2').val(); } });

  // ---- the latest report
  function drawRep(r) {
    var busy = r.busy || WAIT, btn = '<input type="button" class="gdm-run" value="' + esc(busy ? T('gdm.running') : T('gdm.run_now')) + '"' + (busy || !r.cfg.on ? ' disabled' : '') + '>';
    if (!r.ct) {
      $('#gdm-rep').html('<div class="gdm-lead"><p>' + esc(T('gdm.no_ct')) + '</p></div>');
      $('#gdm-rband').text(''); $('#gdm-rb').attr('class', 'mt-band'); return;
    }
    var rep = null; $.each(r.reports || [], function (i, x) { if (!rep && x.kind !== 'event') { rep = x; } });
    if (!rep) {
      $('#gdm-rep').html('<div class="gdm-lead"><p>' + esc(r.cfg.on ? T('gdm.no_report', { t: two(r.cfg.hour) + ':' + two(r.cfg.min) }) : T('gdm.off')) + '</p>' + btn + '</div>');
      $('#gdm-rband').text(''); $('#gdm-rb').attr('class', 'mt-band'); return;
    }
    var n = bad(rep), v = rep.error || rep.skipped ? 'amber' : rep.verdict;
    var lead = rep.error || rep.skipped ? esc(rep.error ? T('gdm.failed') : T('gdm.skipped')) : '<b class="v-' + v + '">' + esc(T('verdict.' + v)) + '</b> ' + esc(rep.summary);
    var st = '<span>' + esc(kindTxt(rep)) + ' · <b>' + esc(day(rep.t) + ' ' + hm(rep.t)) + '</b></span>';
    if (rep.took != null) { st += '<span>' + esc(T('gdm.took', { t: dur(rep.took) })) + '</span>'; }
    if (r.usage) { st += '<span>' + esc(T('gdm.usage', { p: Math.round(r.usage.week), l: r.cfg.limit })) + '</span>'; }
    $('#gdm-rep').html('<div class="gdm-lead"><p>' + lead + '</p>' + btn + '</div><div class="gdm-status">' + st + '</div>' + body(rep));
    $('#gdm-rtitle').text(n ? T('gdm.h.latest_n', { n: n }) : T('gdm.h.latest'));
    $('#gdm-rb').attr('class', 'mt-band' + (v === 'red' ? ' gdm-b-red' : v === 'amber' ? ' gdm-b-amber' : ''));
    $('#gdm-rband').text(day(rep.t) + ' ' + hm(rep.t));
  }
  $(document).on('click', '#gdm .gdm-run', function () {
    $(this).prop('disabled', true).val(T('gdm.running')); WAIT = Math.floor(Date.now() / 1000);
    api('run').done(function (r) { if (!r.ok) { WAIT = 0; window.alert(r.error); } load(); }).fail(function (x) { WAIT = 0; window.alert(err(x)); });
  });

  // ---- event reports of the last 7 days, and the earlier reports folded by week
  function evRow(x) {
    var n = bad(x), v = x.error || x.skipped ? 'amber' : x.verdict, l = LV[v] || LV.amber;
    var head = '<span><b class="k">' + esc(day(x.t)) + '</b><small>' + esc(hm(x.t) + ' · ' + kindTxt(x)) + '</small></span>';
    var ev = (x.events || []).map(function (e) { return e.text; }).join(' · ');
    return '<div class="gdm-row gdm-it ' + l[1] + '">' + head + '<span>' + (ev ? '<p class="why">' + esc(ev) + '</p>' : '') + '<p>' + esc(x.error || x.skipped || x.summary) + '</p></span><span class="gdm-acts"><span class="gdm-chip ' + l[0] + '">' + esc(n ? T('gdm.n_look', { n: n }) : l[2]) + '</span></span></div>';
  }
  function drawOld(r) {
    var now = Math.floor(Date.now() / 1000), ev = [], weeks = {}, order = [], latest = null;
    $.each(r.reports || [], function (i, x) { if (!latest && x.kind !== 'event') { latest = x; } });
    $.each(r.reports || [], function (i, x) {
      if (x.kind === 'event') { if (now - x.t < 7 * 86400) { ev.push(x); } return; }
      if (x === latest) { return; }
      var w = Math.floor((now - x.t) / (7 * 86400)); if (!weeks[w]) { weeks[w] = []; order.push(w); } weeks[w].push(x);
    });
    var h = '';
    $.each(ev, function (i, x) { var g = 'ev' + x.id; h += evRow(x) + (x.items && x.items.length ? gbar(g, 's-grey', esc(T('gdm.details')), '') + grp(g, body(x)) : ''); });
    $('#gdm-ev').html(h || '<div class="gdm-status gdm-mut">' + esc(T('gdm.no_events')) + '</div>');
    $('#gdm-eband').text(T('gdm.ev_band', { n: ev.length, d: r.ev_today, m: r.cfg.ev_max }));
    var o = '';
    $.each(order, function (i, w) {
      var L = weeks[w], nb = $.grep(L, function (x) { return bad(x) > 0; }).length, sk = $.grep(L, function (x) { return x.skipped || x.error; }).length;
      var rows = ''; $.each(L, function (j, x) { var g = 'r' + x.id; rows += evRow(x) + (x.items && x.items.length ? gbar(g, 's-grey', esc(T('gdm.details')), '') + grp(g, body(x)) : ''); });
      o += gbar('w' + w, nb ? 's-amber' : 's-grey', esc(w === 0 ? T('gdm.this_week') : T('gdm.weeks_ago', { n: w })), esc(T('gdm.week_count', { n: L.length, b: nb, s: sk }))) + grp('w' + w, rows);
    });
    $('#gdm-old').html(o || '<div class="gdm-status gdm-mut">' + esc(T('gdm.no_old')) + '</div>');
  }

  // ---- settings
  function drawSet(r) {
    var c = r.cfg;
    function ck(id, on, text) { return '<label><input type="checkbox" id="' + id + '"' + (+on ? ' checked' : '') + '> ' + text + '</label>'; }
    function num(id, v, lo, hi) { return '<input type="number" id="' + id + '" min="' + lo + '" max="' + hi + '" value="' + v + '">'; }
    function row(lb, ctl, hint) { return '<div class="gdm-row gdm-set"><span class="lb">' + lb + '</span><div class="gdm-ctl">' + ctl + (hint ? '<span class="gdm-hint">' + hint + '</span>' : '') + '</div></div>'; }
    var dc = $.map(['issues', 'short', 'full', 'off'], function (k) { return '<option value="' + k + '"' + (c.discord === k ? ' selected' : '') + '>' + esc(T('gds.dc_' + k)) + '</option>'; }).join('');
    $('#gdm-set').html(
      row(esc(T('gds.on_lb')), ck('gdm-on', c.on, esc(T('gds.on'))) + '<span class="gdm-chip p">' + esc(T('gds.ro')) + '</span>', esc(T('gds.on_hint'))) +
      row(esc(T('gds.daily')), esc(T('gds.at')) + ' ' + num('gdm-h', c.hour, 0, 23) + ' : ' + num('gdm-m', c.min, 0, 59), esc(T('gds.daily_hint'))) +
      row(esc(T('gds.quiet')), esc(T('gds.from')) + ' ' + num('gdm-qf', c.q_from, 0, 23) + ' ' + esc(T('gds.to')) + ' ' + num('gdm-qt', c.q_to, 0, 23) + ' ' + esc(T('gds.hours')), esc(T('gds.quiet_hint'))) +
      row(esc(T('gds.events')), ck('gdm-es', c.ev_sys, esc(T('gds.ev_sys'))) + ck('gdm-ed', c.ev_dsk, esc(T('gds.ev_dsk'))) + ck('gdm-eb', c.ev_sbx, esc(T('gds.ev_sbx'))) + esc(T('gds.at_most')) + ' ' + num('gdm-em', c.ev_max, 0, 10) + ' ' + esc(T('gds.a_day')), esc(T('gds.events_hint'))) +
      row(esc(T('gds.topics')), ck('gdm-td', c.t_disk, esc(T('topic.disks'))) + ck('gdm-tc', c.t_ct, esc(T('topic.containers'))) + ck('gdm-tl', c.t_log, esc(T('topic.logs'))) + ck('gdm-ta', c.t_arr, esc(T('topic.services'))), esc(T('gds.topics_hint'))) +
      row(esc(T('gds.limit')), esc(T('gds.skip_above')) + ' ' + num('gdm-lim', c.limit, 10, 100) + ' %' + (r.usage ? ' <span class="gdm-chip ' + (r.usage.week >= c.limit ? 'a' : 'g') + '">' + esc(T('gds.now', { p: Math.round(r.usage.week) })) + '</span>' : ''), esc(T('gds.limit_hint'))) +
      row(esc(T('gds.lang')), '<select id="gdm-lang">' + $.map(['auto', 'hu', 'en'], function (k) { return '<option value="' + k + '"' + (c.lang === k ? ' selected' : '') + '>' + esc(T('gds.lang_' + k)) + '</option>'; }).join('') + '</select>' +
        (c.lang === 'auto' ? ' <span class="gdm-chip g">' + esc(T('gds.lang_now', { l: T('gds.lang_' + r.lang_now) })) + '</span>' : ''), esc(T('gds.lang_hint'))) +
      row(esc(T('gds.ctx')), '<input type="text" id="gdm-ctx" style="width:340px;max-width:100%" value="' + esc(c.ctx) + '">' +
        ' <span class="gdm-chip ' + (r.ctx_path ? 'g' : 'a') + '">' + esc(r.ctx_path ? T('gds.ctx_reads', { p: r.ctx_path }) : T('gds.ctx_none')) + '</span>', esc(T('gds.ctx_hint'))) +
      row('Discord', '<select id="gdm-dc">' + dc + '</select>', esc(T('gds.dc_hint'))) +
      row(esc(T('gds.brief_lb')), ck('gdm-br', c.brief, esc(T('gds.brief'))), esc(T('gds.brief_hint'))) +
      row(esc(T('gds.parts')), $.map(['ep', 'dl', 'upd', 'net', 'pow'], function (k) { return ck('gdm-b' + k, c['b_' + k], esc(T('gds.p_' + k))); }).join('') +
        '<input type="button" id="gdm-brnow" value="' + esc(T('gds.brief_now')) + '"><span id="gdm-brmsg"></span>', esc(T('gds.parts_hint'))) +
      row(esc(T('gds.todo_lb')), ck('gdm-todo', c.todo, esc(T('gds.todo'))), esc(T('gds.todo_hint'))) +
      '<div class="gdm-row gdm-set"><span></span><div class="gdm-ctl"><input type="button" id="gdm-save" value="' + esc(T('gds.save')) + '"><span id="gdm-smsg"></span></div></div>');
  }
  $(document).on('click', '#gdm-save', function () {
    var $m = $('#gdm-smsg').attr('class', '').text(T('gdm.saving'));
    function b(id) { return $('#' + id).prop('checked') ? 1 : 0; }
    api('save', {on: b('gdm-on'), hour: $('#gdm-h').val(), min: $('#gdm-m').val(), q_from: $('#gdm-qf').val(), q_to: $('#gdm-qt').val(),
      ev_sys: b('gdm-es'), ev_dsk: b('gdm-ed'), ev_sbx: b('gdm-eb'), ev_max: $('#gdm-em').val(), t_disk: b('gdm-td'), t_ct: b('gdm-tc'), t_log: b('gdm-tl'), t_arr: b('gdm-ta'),
      limit: $('#gdm-lim').val(), discord: $('#gdm-dc').val(), todo: b('gdm-todo'), lang: $('#gdm-lang').val(), ctx: $('#gdm-ctx').val(),
      brief: b('gdm-br'), b_ep: b('gdm-bep'), b_dl: b('gdm-bdl'), b_upd: b('gdm-bupd'), b_net: b('gdm-bnet'), b_pow: b('gdm-bpow')})
      .done(function (r) { if (r.ok) { $m.attr('class', 'gdm-ok').text(T('gdm.saved')); load(); } else { $m.attr('class', 'gdm-er').text(r.error); } }).fail(function (x) { $m.attr('class', 'gdm-er').text(err(x)); });
  });

  // the morning brief now (item 95 B): the saved settings and the latest report, to see it without waiting for the morning
  $(document).on('click', '#gdm-brnow', function () {
    var $b = $(this).prop('disabled', true), $m = $('#gdm-brmsg').attr('class', '').text(T('gds.brief_sending'));
    api('brief').done(function (r) { $m.attr('class', r.ok ? 'gdm-ok' : 'gdm-er').text(r.ok ? r.msg : r.error); })
      .fail(function (x) { $m.attr('class', 'gdm-er').text(err(x)); }).always(function () { $b.prop('disabled', false); });
  });

  function draw(r) {
    D = r; drawAct(r); drawRep(r); drawOld(r); drawKnown(r); restoreForm();
    if (!CONF || JSON.stringify(CONF) !== JSON.stringify(r.cfg)) { CONF = r.cfg; drawSet(r); }
  }
  function load() {
    api('state').done(function (r) {
      // the worker starts in the background: right after the click its job may not exist yet
      if (WAIT && (r.busy || Math.floor(Date.now() / 1000) - WAIT > 20 || $.grep(r.reports || [], function (x) { return x.t >= WAIT - 2; }).length)) { if (!r.busy) { WAIT = 0; } }
      draw(r);
      clearTimeout(pollT); if (r.busy || WAIT) { pollT = setTimeout(load, 3000); }
    }).fail(function (x) { $('#gdm-act').html('<div class="gdm-status gdm-er">' + esc(err(x)) + '</div>'); });
  }
  load();
});
</script>
