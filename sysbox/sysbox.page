      $b.append($('<span>').html(g).children());
      $b.append(el('sx-cl').append(txt('span', '', T('net.last30', { v: fmtRate(mxv / 1.15, U) + ' ' + unitTxt(U) })),
        $('<span class="sx-nleg">').append($('<i>').css('background', '#3fa24a'), document.createTextNode(T('net.down_s')), $('<i>').css('background', '#4a90e2'), document.createTextNode(T('net.up_s')))));
    }
    if (mx('net_inet')) {
      var I = N.inet, st = I.state, cls = { ok: 'g', slow: 'a', down: 'rd', norouter: 'rd' }[st] || 'mu';
      var det = [];
