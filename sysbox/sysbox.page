  // ---- containers ----------------------------------------------------------------------------
  function stripAnsi(s) { return String(s).replace(/\u001b\[[0-9;?]*[A-Za-z]/g, ''); }
  function renderLogBody(name) {
    var $pre = $('<pre>');
    if (S.logErr[name]) { return $pre.text(S.logErr[name]).addClass('sx-a'); }
    var raw = S.logs[name];
    if (raw === undefined) { return $pre.text(T('tile.loading')); }
    var lines = stripAnsi(raw).split('\n');
    if (lines.length && lines[lines.length - 1] === '') { lines.pop(); }
    if (!lines.length) { return $pre.text('(the log is empty)'); }
    $.each(lines, function (i, l) {
      var m = /^(\d{4}-\d\d-\d\dT[\d:.]+Z)\s?(.*)$/.exec(l), t = '', body = l;
      if (m) {
        var d = new Date(m[1]);
        if (!isNaN(d.getTime())) { t = ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2) + ':' + ('0' + d.getSeconds()).slice(-2); body = m[2]; }
      }
      var cls = /\b(error|fatal|exception|panic|critical|failed|failure)\b/i.test(body) ? 'e' : (/\b(warn|warning)\b/i.test(body) ? 'w' : '');
      var $ln = $('<span>');
      if (t) { $ln.append($('<span class="d">').text(t + ' ')); }
      $ln.append($('<span>').addClass(cls).text(body));
      $pre.append($ln).append(document.createTextNode('\n'));
    });
    return $pre;
  }

  function fetchLog(name, quiet) {
    var C = last && last.containers;
    $.getJSON(LOGS, { name: name, lines: C ? C.log_lines : 100, _: Date.now() })
      .done(function (r) {
        if (r && r.ok) { S.logs[name] = r.text; delete S.logErr[name]; }
        else { S.logErr[name] = (r && r.error) ? r.error : T('log.err'); }
      })
      .fail(function (x) { S.logErr[name] = (x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : 'HTTP ' + x.status; })
      .always(function () { if (S.logOpen === name) { renderCon(); } });
  }
  function toggleLog(name) {
    if (S.logTimer) { clearInterval(S.logTimer); S.logTimer = null; }
    if (S.logOpen === name) { S.logOpen = null; renderCon(); return; }
    S.logOpen = name;
    delete S.logs[name]; delete S.logErr[name];
    renderCon();
    fetchLog(name);
    S.logTimer = setInterval(function () { if (S.logOpen) { fetchLog(S.logOpen, true); } }, 5000);
  }
  function copyText(t) {
    if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(t); return; }
    var ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }

  function doOp(name, op) {
    S.busy[name] = op; S.confirm = null; S.err = null; renderCon();
    $.post(ACT, { name: name, op: op }, null, 'json')
      .done(function (r) { if (!r || !r.ok) { S.err = name + ': ' + ((r && r.error) ? r.error : 'failed'); } })
      .fail(function (x) { S.err = name + ': ' + ((x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : 'HTTP ' + x.status); })
      .always(function () { delete S.busy[name]; poll(); });
  }

  var PILL = { exited: ['mu', T('con.stopped')], created: ['mu', T('con.created')], restarting: ['am', T('con.restarting')], paused: ['am', T('con.paused')], dead: ['rd', T('con.dead')], removing: ['am', T('con.removing')] };
  var BUSYTXT = { start: T('con.starting'), stop: T('con.stopping'), restart: T('con.restarting') };

  // waiting updates (Update manager): one purple row with a link, only when something waits
  function renderUpd($d) {
    var U = last && last.updates; if (!U) { return; }
    var n = U.n, tot = n.green + n.amber + n.red; if (!tot && !U.os) { return; }
    var parts = []; if (n.green) { parts.push(T('con.upd_safe', { n: n.green })); } if (n.amber) { parts.push(T('con.upd_look', { n: n.amber })); } if (n.red) { parts.push(T('con.upd_wait', { n: n.red })); }
    if (U.os) { parts.push('Unraid ' + U.os); }
    var $a = $('<a>').attr('href', '/Settings/SysboxUpdates').css({ color: 'inherit', textDecoration: 'none', display: 'block' })
      .append(el('mt-r mt-s-purple').css({ 'grid-template-columns': '18px minmax(0,1fr)', 'margin-top': '6px' })
        .append(icon('fa-arrow-circle-up', ''), txt('span', '', (tot ? T('con.upd_n', { n: tot }) + ': ' : '') + parts.join(' · '))));
    $d.append($a);
  }
  function renderCon() {
    var $d = $('#sx-con').empty();
    var C = last && last.containers;
    if (!C || !C.enabled) { return; }
    if (!C.docker) { $d.append(band(T('con.title'), '')); $d.append(el('sx-box').append(txt('div', 'sx-fine', T('con.no_docker')).css('margin', 0))); return; }
    var title = C.mode === 'selected' ? T('con.title') + ' · ' + T('con.selected') : T('con.top', { n: C.n, by: C.mode === 'ram' ? 'RAM' : 'CPU' });
    $d.append(band(title, 'CPU · RAM'));
    if (S.err) { $d.append(el('sx-warn sx-rd').append(icon('fa-exclamation-triangle', 'sx-rd'), txt('span', '', S.err))); }
    if (!C.rows.length) { $d.append(el('sx-note').text(C.pending ? 'Reading containers…' : (C.mode === 'selected' ? 'No containers selected (see the Sysbox settings)' : 'No running containers'))); return; }
    var $box = el('mt-box').appendTo($d);
    renderUpd($d);
    $.each(C.rows, function (i, c) {
      var running = c.state === 'running', bz = S.busy[c.name];
      var stripe = c.unhealthy || c.state === 'dead' ? 'red' : (bz || c.state === 'restarting' || c.state === 'paused' || c.state === 'removing' ? 'amber' : (running ? 'green' : 'grey'));
      var $row = el('sx-cr mt-r mt-n mt-s-' + stripe + (running ? '' : ' off')).css('grid-template-columns', 'minmax(0,1fr) 44px 92px 68px');
      var $n = txt('span', 'n', c.name).attr('title', c.name + (c.status ? ' — ' + c.status : ''));
