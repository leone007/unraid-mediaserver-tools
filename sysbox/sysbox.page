    var W = HMIN * 60000, now = Date.now(), t0 = now - W, bw = Math.max(2000, Math.ceil(W / 200 / 2000) * 2000), out = [], bk = {}, ids = [];
    for (var k = 0; k < hist.length; k++) {
      var t = hist[k][0]; if (t < t0) { continue; }
      var bi = Math.floor(t / bw);
      if (!bk[bi]) { bk[bi] = [0, 0]; ids.push(bi); }
      bk[bi][0] += hist[k][1]; bk[bi][1]++;
