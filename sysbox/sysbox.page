      if (pill) { $n.append($('<span class="sx-pill">').addClass(pill[0]).text(pill[1])); }
      $row.append($('<div>').css({ minWidth: 0, overflow: 'hidden' }).append($n));
      $row.append(el('sx-mini').append($('<i>').css('width', (c.bar || 0) + '%')));
      var v = running ? ((c.cpu !== null && c.cpu !== undefined ? (c.cpu >= 100 ? c.cpu.toFixed(0) : c.cpu.toFixed(1)) + '%' : '…') + (c.mem !== null && c.mem !== undefined ? ' · ' + fmtB(c.mem, true, false).replace('iB', 'B') : '')) : (c.status || '');
      $row.append($('<span class="sx-val sx-sub">').text(v).attr('title', v + (running && c.cpu_core !== null && c.cpu_core !== undefined ? ' \u2014 ' + T('con.cpu_tip', { p: c.cpu_core.toFixed(1) }) : '')));
      var $a = el('sx-act');
      if (C.controls) {
        if (running) {
          $a.append(btn('restart', T('con.restart'), bz ? 'dis' : '', function () { doOp(c.name, 'restart'); }));
          $a.append(btn('stop', T('con.stop'), (bz ? 'dis ' : '') + (S.confirm === c.name ? 'on' : ''), function () { S.confirm = (S.confirm === c.name) ? null : c.name; renderCon(); }));
        } else {
