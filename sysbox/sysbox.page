    }
    if (mx('net_today')) { var tb = fmtB(N.today[0] + N.today[1]).split(' '); items.push(kp(T('net.today'), [document.createTextNode(tb[0]), small(' ' + tb[1])], '')); }
    if (items.length) { var $k = el('sx-kp').css('grid-template-columns', 'repeat(' + items.length + ',1fr)'); $.each(items, function (i, x) { $k.append(x); }); $b.append($k); }
    if (mx('net_hist') && N.pts && N.pts.length > 1) {
      var mxv = 1; $.each(N.pts, function (i, p) { mxv = Math.max(mxv, p[1], p[2]); }); mxv *= 1.15;
      function line(k) { return $.map(N.pts, function (p) { return (400 - p[0] / 1800 * 400).toFixed(1) + ',' + (52 - p[k] / mxv * 50).toFixed(1); }).join(' '); }
      var dn = line(1), x0 = (400 - N.pts[0][0] / 1800 * 400).toFixed(1), x1 = (400 - N.pts[N.pts.length - 1][0] / 1800 * 400).toFixed(1);
