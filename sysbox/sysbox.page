        var v = b / th[i], s = (trim && v >= 100) ? v.toFixed(0) : (i === 3 ? v.toFixed(0) : (v >= 100 ? v.toFixed(0) : v.toFixed(v >= 10 ? 1 : 2)));
        if (trim) { s = s.replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, ''); }
