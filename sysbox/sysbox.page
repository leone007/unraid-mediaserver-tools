  // the top band sits closer to the header when no Needs attention list is above it
  function firstBand() {
    $('.sx-tile .mt-band.mt-first').removeClass('mt-first');
    if ($('#sx-attn').children().length) { return; }
    var k = ORDER ? ORDER.split(',') : ['ram', 'sto', 'cpu', 'gpu', 'pow', 'net', 'rtr', 'con'];
    for (var i = 0; i < k.length; i++) { var $b = $('#' + BLK[k[i]]).find('.mt-band').first(); if ($b.length) { $b.addClass('mt-first'); return; } }
  }

  function render(r) {
    applyTheme();
    last = r;
    var $s = $('#sx-summary');
    if (!r || !r.ok) {
      $s.text(T('sum.unavailable'));
      $('#sx-attn,#sx-sto,#sx-cpu,#sx-gpu,#sx-pow,#sx-net,#sx-con').empty();
      $('#sx-mem').empty().append(el('sx-note').text(T('sum.no_data')));
      return;
    }
    var m = r.summary, parts = [Math.round(m.ram) + '% RAM'];
    var cl = (live && live.load !== undefined && live.load !== null) ? live.load : m.cpu;
    if (cl !== null && cl !== undefined) { parts.push(Math.round(cl) + '% CPU'); }
    var ct = (live && live.temp !== undefined && live.temp !== null) ? live.temp : m.temp;
    if (ct !== null && ct !== undefined) { parts.push(ct + '\u00B0C'); }
    parts.push(T('sum.up', { t: m.uptime }));
    $s.text(parts.join(' · '));
    if (r.ui) { applyUi(r.ui); }
    if (r.ui && r.ui.metrics) { MX = r.ui.metrics; }
    if (r.ui && r.ui.show) { SHOW = r.ui.show; }
    if (r.ui && r.ui.order && r.ui.order.join(',') !== ORDER) {
      ORDER = r.ui.order.join(',');
      var $after = $('#sx-attn');
      $.each(r.ui.order, function (i, k) { var $x = $('#' + BLK[k]); if ($x.length) { $after.after($x); $after = $x; } });
    }
    renderAttn(r.attention);
    if (SHOW.ram) { renderMem(r.memory, false); } else { $('#sx-mem').empty(); }
    if (SHOW.sto) { renderSto(r.storage); } else { $('#sx-sto').empty(); }
    if (SHOW.cpu) { renderCpu(r.cpu); } else { $('#sx-cpu').empty(); }
    renderGpu(r.gpu);
    if (SHOW.pow) { renderPow(r.power); } else { $('#sx-pow').empty(); }
    if (SHOW.net) { renderNet(r.net); } else { $('#sx-net').empty(); }
    if (SHOW.rtr) { renderRtr(r.router); } else { $('#sx-rtr').empty(); }
    renderCon();
    firstBand();
  }

  function poll() {
    if (busy) { return; }
    busy = true;
    $.getJSON(API, { _: Date.now() })
      .done(render)
      .fail(function () { render({ ok: false }); })
      .always(function () { busy = false; });
  }

  // refresh settings: the CPU numbers and the clock each have their own timer
  function applyUi(u) {
    var cs = parseInt(u.cpu_sec, 10) || 1, ks = parseInt(u.clk_sec, 10) || 2, sc = (u.show_clock !== false);
    HMIN = u.hist_min || 2;
    var pts = Math.max(2, Math.round(HMIN * 60 / cs));
    var hm = HMIN; HMAX = pts; histTrim();
    if (!histSeeded || hm !== seededMin) { histSeeded = true; seededMin = HMIN; seedHist(); }
    if (cs !== cpuSec || !cpuTimer) { cpuSec = cs; if (cpuTimer) { clearInterval(cpuTimer); } cpuTimer = setInterval(pollCpu, cpuSec * 1000); }
    if (!sc) { showClock = false; if (clkTimer) { clearInterval(clkTimer); clkTimer = null; } }
    else if (!showClock || ks !== clkSec || !clkTimer) { showClock = true; clkSec = ks; if (clkTimer) { clearInterval(clkTimer); } clkTimer = setInterval(pollClock, clkSec * 1000); }
  }

  // fill the graph from the server's background recording (page open, tab visible again)
  var seeding = false;
  function seedHist() {
    if (seeding) { return; }
    seeding = true;
    $.ajax({ url: CPU, data: { only: 'hist', min: HMIN, _: Date.now() }, dataType: 'json', timeout: 10000 })
      .done(function (r) {
        if (!r || !r.ok || !r.pts || !r.pts.length) { return; }
        var now = Date.now(), srv = [], tmax = 0;
        $.each(r.pts, function (i, p) { var t = now - p[0]; srv.push([t, p[1]]); if (t > tmax) { tmax = t; } });
        hist = srv.concat($.grep(hist, function (p) { return p[0] > tmax; }));
        if (last && last.ok) { if (SHOW.cpu) { renderCpu(last.cpu); firstBand(); } }
      })
      .always(function () { seeding = false; });
  }
  document.addEventListener('visibilitychange', function () { if (!document.hidden) { seedHist(); } });
  window.addEventListener('pageshow', function () { seedHist(); });
  // the server records the load every 2 s whatever this browser does, so refill the graph from it regularly
  setInterval(function () { if (!document.hidden) { seedHist(); } }, 15000);

  function pollClock() {
    if (clkBusy || !last || !last.ok || !showClock) { return; }
    clkBusy = true;
    $.getJSON(CPU, { only: 'clock', _: Date.now() })
      .done(function (r) { if (r && r.ok && r.clock !== null && r.clock !== undefined) { clockVal = r.clock; if (SHOW.cpu) { renderCpu(last.cpu); firstBand(); } } })
      .always(function () { clkBusy = false; });
  }

  function pollCpu() {
    if (cpuBusy || !last || !last.ok) { return; }
    cpuBusy = true;
    $.getJSON(CPU, { _: Date.now() })
      .done(function (r) {
        if (!r || !r.ok) { return; }
        live = r;
        if (r.load !== null && r.load !== undefined) { hist.push([Date.now(), r.load]); histTrim(); }
        if (SHOW.cpu) { renderCpu(last.cpu); firstBand(); }
        var m = last.summary, parts = [Math.round(m.ram) + '% RAM'];
        if (r.load !== null && r.load !== undefined) { parts.push(Math.round(r.load) + '% CPU'); }
        if (r.temp !== null && r.temp !== undefined) { parts.push(r.temp + '\u00B0C'); }
        parts.push(T('sum.up', { t: m.uptime }));
        $('#sx-summary').text(parts.join(' \u00B7 '));
      })
      .always(function () { cpuBusy = false; });
  }

  poll();
  setInterval(poll, 3000);
});
</script>
