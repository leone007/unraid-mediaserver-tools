---
<style>
/* the Dashboard tile look (common/tile.css, inserted by the build): Activity on top, then a band and a box per part */
/*@@TILE_CSS@@*/
#upm{--upm-line:rgba(128,128,128,.22)}
#upm .upm-mut{opacity:.6}
#upm .upm-ok{color:#3fa24a}#upm .upm-er{color:#e5534b}#upm .upm-am{color:#d9921f}
#upm .upm-sub{opacity:.65;margin:4px 0 0;max-width:120ch}
#upm .mt-band{margin-top:26px;padding:9px 12px}
#upm .mt-band span{font-weight:600}
#upm .mt-box{margin-top:8px}
#upm .mt-box>:first-child{border-top:0}
#upm .upm-status{display:flex;flex-wrap:wrap;gap:6px 18px;align-items:center;padding:9px 12px;border-top:1px solid var(--upm-line)}
#upm .upm-status b{font-variant-numeric:tabular-nums}
#upm .upm-row{display:grid;gap:10px;align-items:center;padding:9px 12px;border-top:1px solid var(--upm-line)}
#upm .upm-row small{display:block;opacity:.6}
#upm .s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
#upm .s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
#upm .s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
#upm .s-red{background:rgba(229,83,75,.13);box-shadow:inset 3px 0 0 #e5534b}
#upm .s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
#upm .s-grey{background:rgba(128,128,128,.07);box-shadow:inset 3px 0 0 #8a8a8a}
#upm .upm-job{grid-template-columns:22px minmax(0,1fr) auto}
#upm .upm-ico{font-family:monospace;font-weight:bold;text-align:center}
#upm .upm-num{font-family:monospace;font-size:12px;opacity:.7;text-align:right;white-space:nowrap}
#upm .upm-ct{grid-template-columns:minmax(140px,1.2fr) minmax(170px,1.4fr) minmax(130px,1.1fr) minmax(130px,1fr) auto}
#upm .upm-img{display:block;font-family:monospace;font-size:11.5px;opacity:.6;overflow-wrap:anywhere}
#upm .upm-ver{font-family:monospace;font-size:12px;overflow-wrap:anywhere}
#upm .upm-ver i{opacity:.5;font-style:normal;margin:0 4px}
#upm .upm-chip{display:inline-block;font-size:11px;padding:1px 6px;margin:1px 4px 1px 0;background:rgba(128,128,128,.25);font-weight:normal;white-space:nowrap}
#upm .upm-chip.g{background:rgba(63,162,74,.22);color:#7fd08a}#upm .upm-chip.a{background:rgba(217,146,31,.25);color:#f0b85a}
#upm .upm-chip.r{background:rgba(229,83,75,.25);color:#ff8a83}#upm .upm-chip.b{background:rgba(74,144,226,.25);color:#8fbdf0}#upm .upm-chip.p{background:rgba(150,120,230,.25);color:#c3b0ff}
#upm .upm-acts{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}
#upm input.upm-ghost{color:inherit!important;opacity:.75;border-color:rgba(128,128,128,.45)!important}
#upm input.upm-sm{padding:2px 8px!important;font-size:11px!important;letter-spacing:0!important;text-transform:none!important;margin:0!important;min-width:0}
#upm .upm-det{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;border-top:1px dashed var(--upm-line);padding-top:10px}
#upm .upm-ans{grid-template-columns:minmax(0,1fr)}
#upm .upm-tdo{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:10px;padding-top:8px;border-top:1px dashed rgba(150,120,230,.35);white-space:normal}
#upm .upm-det h4{margin:0 0 6px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.65;font-weight:600}
#upm .upm-notes{max-height:320px;overflow:auto;white-space:pre-wrap;font-size:12px;line-height:1.45;margin:0;opacity:.85;overflow-wrap:anywhere}
#upm .upm-notes mark{background:rgba(229,83,75,.25);color:#ffb3ae;padding:0 2px}
#upm .upm-claude{border:1px solid rgba(150,120,230,.45);background:rgba(150,120,230,.08);padding:10px;white-space:pre-wrap;font-size:12.5px;line-height:1.5;overflow-wrap:anywhere}
#upm .upm-claude .upm-code{font-family:monospace;font-size:12px;background:rgba(0,0,0,.35);padding:6px 8px;margin:4px 0;white-space:pre-wrap;overflow-wrap:anywhere}
#upm .upm-claude code{font-family:monospace;font-size:11.5px;background:rgba(0,0,0,.3);padding:0 3px}
#upm .upm-claude .who{display:flex;justify-content:space-between;gap:8px;font-size:11px;color:#c3b0ff;margin-bottom:6px;white-space:normal}
#upm .upm-conf{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px 10px;align-items:center;background:rgba(229,83,75,.10);border:1px solid rgba(229,83,75,.4);padding:8px 10px}
#upm .upm-conf span{flex:1 1 320px;min-width:0}
#upm .upm-gbar{display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:8px;align-items:center;padding:10px 12px;border-top:1px solid var(--upm-line);cursor:pointer;font-weight:600}
#upm .upm-gbar .c{font-weight:normal;font-size:12px;opacity:.7}
#upm .upm-gbar.empty{opacity:.5}
#upm .upm-grp[hidden]{display:none}
#upm .upm-lead{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;padding:10px 12px}
#upm .upm-lead p{margin:0;opacity:.7;max-width:95ch;flex:1 1 420px}
#upm .upm-test{grid-template-columns:22px minmax(140px,220px) minmax(0,1fr) auto}
#upm .upm-pl{grid-template-columns:minmax(0,1fr) auto}
#upm .upm-log{max-height:240px;overflow:auto;font-family:monospace;font-size:12px;white-space:pre-wrap;padding:10px 12px;margin:0;opacity:.75}
#upm .upm-set{grid-template-columns:minmax(200px,280px) minmax(0,1fr)}
#upm .upm-set .lb{opacity:.75}
#upm .upm-ctl{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center}
#upm .upm-ctl input[type=number]{width:70px!important;margin:0}
#upm .upm-ctl select{margin:0;min-width:0}
#upm .upm-ctl label{display:inline-flex;align-items:center;gap:6px}
#upm .upm-ctl input[type=checkbox]{margin:0}
#upm .upm-hint{flex:1 1 100%;opacity:.55;font-size:12px}
@media (max-width:860px){#upm .upm-ct{grid-template-columns:1fr 1fr}#upm .upm-ct .upm-acts{grid-column:1/-1;justify-content:flex-start}#upm .upm-det{grid-template-columns:1fr}#upm .upm-set{grid-template-columns:1fr}#upm .upm-test{grid-template-columns:22px minmax(0,1fr)}#upm .upm-test>:nth-child(n+3){grid-column:2}}
</style>
<div id="upm">
<p class="upm-sub">What the waiting updates change and what of ours uses the container, before you install them. The page and the daily check only read (the containers' labels, the registries, GitHub, Unraid's own update check); a container is updated only with its button, after a ZFS snapshot of its data.</p>

<div class="mt-band"><span>Activity</span><b id="upm-aband"></b></div>
<div class="mt-box" id="upm-act"><div class="upm-status upm-mut">Loading...</div></div>

<div class="mt-band"><span>Summary</span><b id="upm-sband"></b></div>
<div class="mt-box" id="upm-sum"></div>

<div class="mt-band"><span>Docker containers</span><b id="upm-dband"></b></div>
<div class="mt-box" id="upm-ct"></div>

<div class="mt-band"><span>Unraid OS</span><b id="upm-oband"></b></div>
<div class="mt-box" id="upm-os"></div>

<div class="mt-band"><span>Plugins</span><b id="upm-pband"></b></div>
<div class="mt-box" id="upm-pl"></div>

<div class="mt-band"><span>Self-test</span><b id="upm-tband"></b></div>
<div class="mt-box" id="upm-test"></div>

<div class="mt-band"><span>Settings</span><b>daily check</b></div>
<div class="mt-box" id="upm-set"></div>
</div>

<script>
$(function () {
  var URL = '/plugins/sysbox/upd.php', D = null, OPEN = {}, DET = {}, CONF = null, pollT = null;
  var RISK = {red: ['r', 's-red', 'Wait'], amber: ['a', 's-amber', 'Look first'], green: ['g', 's-green', 'Safe']};
  var KIND = {rebuild: ['g', 'image rebuild'], patch: ['g', 'patch'], feature: ['a', 'new features'], major: ['r', 'major version'], unknown: ['a', 'version not labelled']};
  function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
  function api(op, data) { return $.post(URL, $.extend({op: op}, data || {}), null, 'json'); }
  function err(x) { return (x && x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : (x && x.error) ? x.error : 'HTTP ' + (x && x.status); }
  function ago(t) { var s = Math.max(0, Math.floor(Date.now() / 1000) - t); return s >= 86400 ? Math.floor(s / 86400) + ' d' : s >= 3600 ? Math.floor(s / 3600) + ' h' : Math.max(1, Math.floor(s / 60)) + ' min'; }
  function hm(t) { var d = new Date(t * 1000); return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }
  function gbar(g, cls, title, count, empty) { return '<div class="upm-gbar ' + cls + (empty ? ' empty' : '') + '" data-g="' + esc(g) + '"><span class="pm">' + (OPEN[g] ? '&minus;' : '+') + '</span><span>' + title + '</span><span class="c">' + count + '</span></div>'; }
  function grp(g, inner) { return '<div class="upm-grp" data-g="' + esc(g) + '"' + (OPEN[g] ? '' : ' hidden') + '>' + inner + '</div>'; }
  $(document).on('click', '#upm .upm-gbar', function () { var g = String($(this).data('g')); OPEN[g] = !OPEN[g]; $(this).find('.pm').html(OPEN[g] ? '&minus;' : '+'); $('#upm .upm-grp').filter(function () { return String($(this).data('g')) === g; }).prop('hidden', !OPEN[g]); });

  // ---- Activity: running jobs, then the finished ones of the last day folded
  function drawAct(r) {
    var run = [], fin = [];
    $.each(r.jobs || [], function (i, j) { (j.state === 'running' ? run : fin).push(j); });
    fin.sort(function (a, b) { return (b.finished || 0) - (a.finished || 0); });
    var h = '';
    $.each(run, function (i, j) { h += '<div class="upm-row upm-job ' + (j.kind === 'ask' ? 's-purple' : 's-blue') + '"><span class="upm-ico">&#8635;</span><span><b>' + esc(j.text) + '</b><small>' + esc((j.log || []).slice(-2).join(' · ') || 'started ' + hm(j.started)) + '</small></span><span class="upm-num">' + ago(j.started) + '</span></div>'; });
    var f = '';
    $.each(fin, function (i, j) { var ok = j.state === 'done'; f += '<div class="upm-row upm-job ' + (ok ? 's-green' : 's-red') + '"><span class="upm-ico ' + (ok ? 'upm-ok">&#10003;' : 'upm-er">!') + '</span><span>' + esc(j.text) + (j.log && j.log.length ? '<small>' + esc(j.log.join(' · ')) + '</small>' : '') + '</span><span class="upm-num">' + hm(j.finished || j.started) + '</span></div>'; });
    if (fin.length) { h += gbar('fin', 's-grey', 'Finished today', fin.length) + grp('fin', f); }
    if (r.log && r.log.length) { h += gbar('log', 's-grey', 'Log', r.log.length + ' lines') + grp('log', '<div class="upm-log">' + esc(r.log.slice().reverse().join('\n')) + '</div>'); }
    $('#upm-act').html(h || '<div class="upm-status upm-mut">Nothing has run yet.</div>');
    $('#upm-aband').text(run.length ? run.length + ' running' : fin.length ? fin.length + ' finished today' : '');
  }

  // ---- Summary
  function counts(s) { var n = {red: 0, amber: 0, green: 0}; $.each((s && s.rows) || [], function (i, x) { if (x.state === 'update') { n[x.risk]++; } }); return n; }
  function drawSum(r) {
    var s = r.scan, busy = r.busy.scan;
    if (!s) { $('#upm-sum').html('<div class="upm-lead"><p>No check has run yet. The first one reads the containers\' labels and asks the registries for the newest images; it takes about a minute.</p><input type="button" class="upm-scan" value="' + (busy ? 'Checking...' : 'Check now') + '"' + (busy ? ' disabled' : '') + '></div>'); $('#upm-sband').text(''); return; }
    var n = counts(s), tot = n.red + n.amber + n.green;
    var lead = tot ? '<b>' + tot + ' update' + (tot > 1 ? 's' : '') + ' waiting.</b> ' + [n.green ? n.green + ' safe (image rebuild or patch)' : '', n.amber ? n.amber + ' to look at first' : '', n.red ? n.red + ' to wait with' : ''].filter(Boolean).join(', ') + '. Each one installs only with its button.' : '<b>Everything is up to date.</b>';
    $('#upm-sum').html('<div class="upm-lead"><p>' + lead + '</p><input type="button" class="upm-scan" value="' + (busy ? 'Checking...' : 'Check now') + '"' + (busy ? ' disabled' : '') + '></div>' +
      '<div class="upm-status"><span><b class="upm-ok">' + n.green + '</b> green</span><span><b class="upm-am">' + n.amber + '</b> amber</span><span><b class="upm-er">' + n.red + '</b> red</span>' +
      '<span>Unraid OS: <b>' + esc(s.os.cur) + '</b>' + (s.os.new ? ' &rarr; ' + esc(s.os.new) + ' available' : '') + '</span><span class="upm-mut">checked ' + ago(s.t) + ' ago</span></div>');
    $('#upm-sband').text('last check: ' + ago(s.t) + ' ago');
  }
  $(document).on('click', '#upm .upm-scan', function () { $(this).prop('disabled', true).val('Checking...'); api('scan').done(function (r) { if (!r.ok) { window.alert(r.error); } load(); }).fail(function (x) { window.alert(err(x)); }); });

  // ---- containers
  function updating(r) { var u = {}; $.each(r.jobs || [], function (i, j) { if (j.kind === 'update' && j.state === 'running') { u[j.name] = 1; } }); return u; }
  function asking(r) { var u = {}; $.each(r.jobs || [], function (i, j) { if (j.kind === 'ask' && j.state === 'running') { u[j.name] = 1; } }); return u; }
  function ctRow(c, r, ask) {
    var rk = RISK[c.risk] || RISK.amber, k = KIND[c.kind] || KIND.unknown, fl = [];
    $.each(c.flags || {}, function (w, n) { fl.push('<span class="upm-chip ' + (w === 'breaking' || w === 'removed' ? 'r' : 'a') + '">' + esc(w) + ' &times;' + n + '</span>'); });
    var h = '<div class="upm-row upm-ct ' + rk[1] + '" data-name="' + esc(c.name) + '">' +
      '<div><b>' + esc(c.name) + '</b><span class="upm-img">' + esc(c.image) + '</span></div>' +
      '<div><div class="upm-ver">' + esc(c.ver || '?') + '<i>&rarr;</i>' + esc(c.rver || '?') + '</div><span class="upm-chip ' + k[0] + '">' + k[1] + '</span>' + (c.age !== null && c.age !== undefined ? '<span class="upm-mut" style="font-size:12px">' + (c.age < 1 ? 'today' : Math.floor(c.age) + ' day' + (Math.floor(c.age) === 1 ? '' : 's') + ' old') + '</span>' : '') + '</div>' +
      '<div>' + ($.map(c.deps || [], function (d) { return '<span class="upm-chip b">' + esc(d) + '</span>'; }).join('') || '<span class="upm-mut" style="font-size:12px">nothing of ours uses it</span>') + '</div>' +
      '<div>' + (fl.join('') || '<span class="upm-mut" style="font-size:12px">no warning words in the notes</span>') + (c.running ? '' : '<small>stopped</small>') + '</div>' +
      '<div class="upm-acts"><input type="button" class="upm-det-b upm-ghost upm-sm" value="Changes">' +
      (r.cfg.claude && r.claude ? '<input type="button" class="upm-ask upm-ghost upm-sm" value="' + (ask[c.name] ? 'Claude is reading...' : c.claude_t ? 'Ask Claude again' : 'Ask Claude') + '"' + (ask[c.name] || r.busy.ask ? ' disabled' : '') + '>' : '') +
      '<input type="button" class="upm-upd upm-sm" value="Update"' + (r.busy.update ? ' disabled' : '') + '></div>';
    if (DET[c.name]) { h += '<div class="upm-det" data-for="' + esc(c.name) + '">' + DET[c.name] + '</div>'; }
    return h + ansHtml(c.claude) + '</div>';
  }
  function drawCt(r) {
    var s = r.scan; if (!s) { $('#upm-ct').html('<div class="upm-status upm-mut">No check yet.</div>'); $('#upm-dband').text(''); return; }
    var up = updating(r), ask = asking(r), G = {red: [], amber: [], green: [], current: [], other: []};
    $.each(s.rows, function (i, c) {
      if (up[c.name]) { return; }   // its update runs: it is in Activity, back here only if it fails
      if (c.state === 'update') { G[c.risk || 'amber'].push(c); } else if (c.state === 'current') { G.current.push(c); } else { G.other.push(c); }
    });
    var h = '';
    $.each(['red', 'amber', 'green'], function (i, k) {
      var L = G[k], rk = RISK[k], g = 'ct|' + k, inner = '';
      $.each(L, function (j, c) { inner += ctRow(c, r, ask); });
      h += gbar(g, rk[1], '<span class="upm-chip ' + rk[0] + '">' + rk[2] + '</span> ' + {red: 'Major version and something of ours uses it', amber: 'New features, a fresh release, warning words or no version label', green: 'Image rebuild or patch: the program barely changes'}[k], L.length, !L.length) + grp(g, inner || '<div class="upm-status upm-mut">None.</div>');
    });
    var cur = $.map(G.current, function (c) { return esc(c.name) + (c.ver ? ' <span class="upm-mut">' + esc(c.ver) + '</span>' : ''); }).join(', ');
    h += gbar('ct|cur', 's-grey', 'Up to date', G.current.length, !G.current.length) + grp('ct|cur', '<div class="upm-status">' + (cur || 'none') + '</div>');
    var oth = $.map(G.other, function (c) { return '<div class="upm-row upm-pl s-grey"><span><b>' + esc(c.name) + '</b> <span class="upm-mut">' + esc(c.image) + '</span><small>' + (c.state === 'local' ? 'built on this server: nothing to compare with' : esc(c.error)) + '</small></span><span></span></div>'; }).join('');
    h += gbar('ct|oth', 's-grey', 'Not checkable', G.other.length, !G.other.length) + grp('ct|oth', oth || '<div class="upm-status upm-mut">None.</div>');
    $('#upm-ct').html(h);
    $('#upm-dband').text(s.rows.length + ' containers · ' + (G.red.length + G.amber.length + G.green.length) + ' updates');
  }
  // Claude's answer: only **bold** and `code` are shown as such (escaped first)
  function md(t) {
    return String(t || '').split('```').map(function (part, i) {
      if (i % 2) { return '<pre class="upm-code">' + esc(part.replace(/^[a-z]*\n/, '').replace(/\n$/, '')) + '</pre>'; }   // a fenced block: copyable as it is
      return esc(part).replace(/\*\*([^*\n]+)\*\*/g, '<b>$1</b>').replace(/`([^`\n]+)`/g, '<code>$1</code>');
    }).join('');
  }
  function mark(t) { return esc(t).replace(/\b(breaking|removed|deprecated|deprecation|API|migration|migrate|database)\b/gi, '<mark>$1</mark>'); }
  // the answer stays under its row (also after a reload) for as long as that version is the waiting update
  function ansHtml(cl) {
    if (!cl || !cl.text) { return ''; }
    var td = cl.todo ? '<span class="upm-mut" style="font-size:12px">&#10003; saved as a to-do ' + ago(cl.todo) + ' ago (updates_todo.md: Claude moves it into the task list)</span>'
      : '<input type="button" class="upm-todo upm-ghost upm-sm" value="Save as a to-do"><span class="upm-mut" style="font-size:12px">the Sysbox writes it to updates_todo.md in the repo; the next Claude session moves it into the task list</span>';
    return '<div class="upm-det upm-ans"><div class="upm-claude"><div class="who"><span>CLAUDE</span><span>' + ago(cl.t) + ' ago, for this version</span></div>' + md(cl.text) + '<div class="upm-tdo">' + td + '</div></div></div>';
  }
  $(document).on('click', '#upm .upm-todo', function () {
    var name = String($(this).closest('[data-name]').data('name')); $(this).prop('disabled', true).val('Saving...');
    api('todo', {name: name}).done(function (r) { if (!r.ok) { window.alert(r.error); } load(); }).fail(function (x) { window.alert(err(x)); load(); });
  });
  function detHtml(name, d) {
    if (d.claude) { return '<div style="grid-column:1/-1"><h4>What changed' + (d.url ? ' · <a href="' + esc(d.url) + '" target="_blank" rel="noopener">source</a>' : '') + '</h4><pre class="upm-notes">' + (d.notes ? mark(d.notes) : 'No release notes found.') + '</pre></div>'; }
    var cl = '<div class="upm-status upm-mut" style="padding:0">Claude has not been asked about this version.' + (D && D.cfg.claude ? ' Ask Claude reads these notes and our code that uses the program (read-only).' : '') + '</div>';
    return '<div><h4>What changed' + (d.url ? ' · <a href="' + esc(d.url) + '" target="_blank" rel="noopener">source</a>' : '') + '</h4><pre class="upm-notes">' + (d.notes ? mark(d.notes) : 'No release notes found.') + '</pre></div><div><h4>Ask Claude</h4>' + cl + '</div>';
  }
  function openDet(name, force) {
    if (DET[name] && !force) { delete DET[name]; draw(D); return; }
    DET[name] = '<div class="upm-mut">Loading...</div>'; draw(D);
    api('detail', {name: name}).done(function (d) { DET[name] = d.ok ? detHtml(name, d) : '<div class="upm-er">' + esc(d.error) + '</div>'; draw(D); });
  }
  $(document).on('click', '#upm .upm-det-b', function () { openDet(String($(this).closest('[data-name]').data('name'))); });
  $(document).on('click', '#upm .upm-ask', function () {
    var name = String($(this).closest('[data-name]').data('name')); $(this).prop('disabled', true).val('Claude is reading...');
    api('ask', {name: name}).done(function (r) { if (!r.ok) { window.alert(r.error); } else { WATCH[name] = r.now || Math.floor(Date.now() / 1000) - 5; } load(); }).fail(function (x) { window.alert(err(x)); });
  });
  var WATCH = {};   // name => server time of the click: polling goes on until that answer (or the job's error) arrives
  $(document).on('click', '#upm .upm-upd', function () {
    var $row = $(this).closest('[data-name]'), name = String($row.data('name')), c = null;
    $.each(D.scan.rows, function (i, x) { if (x.name === name) { c = x; } });
    if (!c || $row.find('.upm-conf').length) { return; }
    var qb = /qbittorrent/i.test(c.image), t = D.test && $.grep(D.test.tests || [], function (x) { return x.name === 'qBittorrent'; })[0];
    var mv = qb && t && /(\d+) moving/.exec(t.msg);
    var txt = '<b>Update ' + esc(name) + '</b> ' + esc(c.ver || '?') + ' &rarr; ' + esc(c.rver || '?') + '? ' +
      (D.cfg.backup ? '1) a ZFS snapshot of its data (restore it on the Snapshots page if needed), ' : '1) no snapshot (switched off), ') +
      '2) stop it' + (qb ? ' (up to 5 minutes, qBittorrent saves its torrents\' state)' : '') + ', 3) Unraid pulls the new image and recreates it from its template, 4) start it again' + (D.cfg.selftest ? ' and run the self-test' : '') + '.' +
      (c.risk !== 'green' ? ' <span class="upm-er">This one is ' + (c.risk === 'red' ? 'red' : 'amber') + ': read Changes first.</span>' : '') +
      (mv ? ' <span class="upm-am">qBittorrent is moving ' + mv[1] + ' torrent(s) now (at the last self-test): the move is interrupted.</span>' : '') +
      (name === 'claude' ? ' The Claude session stops.' : '');
    $row.append('<div class="upm-conf"><span>' + txt + '</span><input type="button" class="upm-go upm-sm" value="Yes, update"><input type="button" class="upm-no upm-ghost upm-sm" value="Cancel"></div>');
  });
  $(document).on('click', '#upm .upm-no', function () { $(this).closest('.upm-conf').remove(); });
  $(document).on('click', '#upm .upm-go', function () {
    var name = String($(this).closest('[data-name]').data('name')); $(this).prop('disabled', true);
    api('update', {name: name}).done(function (r) { if (!r.ok) { window.alert(r.error); } load(); }).fail(function (x) { window.alert(err(x)); });
  });

  // ---- Unraid OS and plugins
  function drawOs(r) {
    var s = r.scan; if (!s) { $('#upm-os').html('<div class="upm-status upm-mut">No check yet.</div>'); return; }
    var o = s.os, h;
    if (o.new) {
      var fl = []; $.each(o.flags || {}, function (w, n) { fl.push('<span class="upm-chip ' + (w === 'breaking' || w === 'removed' ? 'r' : 'a') + '">' + esc(w) + ' &times;' + n + '</span>'); });
      var k = KIND[o.kind] || KIND.unknown, ask = asking(r);
      h = '<div class="upm-row upm-ct ' + (o.risk === 'green' ? 's-green' : 's-amber') + '" data-name="unraid-os"><div><b>Unraid ' + esc(o.new) + '</b><span class="upm-img">released ' + esc(o.date) + ' · checked ' + (o.checked ? ago(o.checked) + ' ago' : '?') + '</span></div>' +
        '<div><div class="upm-ver">' + esc(o.cur) + '<i>&rarr;</i>' + esc(o.new) + '</div><span class="upm-chip ' + k[0] + '">' + (o.kind === 'feature' ? 'new features' : k[1]) + '</span>' + (o.age !== null && o.age !== undefined ? '<span class="upm-mut" style="font-size:12px">' + Math.floor(o.age) + ' days old</span>' : '') + (o.php ? '<span class="upm-chip a">PHP changes</span>' : '') + '</div>' +
        '<div><span class="upm-chip b">all 5 of our plugins</span></div><div>' + (fl.join('') || '<span class="upm-mut" style="font-size:12px">no warning words in the notes</span>') + '<small>needs a reboot</small></div>' +
        '<div class="upm-acts"><input type="button" class="upm-det-b upm-ghost upm-sm" value="Release notes">' +
        (r.cfg.claude && r.claude ? '<input type="button" class="upm-ask upm-ghost upm-sm" value="' + (ask['unraid-os'] ? 'Claude is reading...' : o.claude_t ? 'Ask Claude again' : 'Ask Claude') + '"' + (ask['unraid-os'] || r.busy.ask ? ' disabled' : '') + '>' : '') +
        '<a href="/Tools/Update" style="font-size:12px;align-self:center">Update OS page</a></div>' + (DET['unraid-os'] ? '<div class="upm-det">' + DET['unraid-os'] + '</div>' : '') + ansHtml(o.claude) + '</div>' +
        '<div class="upm-status upm-mut">The OS is not installed from here. Before it: no parity check running, qBittorrent stopped (Safe shutdown).</div>';
    } else {
      h = '<div class="upm-status"><span>Unraid <b>' + esc(o.cur) + '</b> · ' + (o.checked ? 'no newer version at Unraid\'s last check, ' + ago(o.checked) + ' ago' : 'Unraid has not checked for an OS update yet (Tools, Update OS, Check)') + '</span></div>';
    }
    $('#upm-os').html(h); $('#upm-oband').text(o.new ? o.cur + ' → ' + o.new : o.cur);
    var P = s.plugins || [], up = $.grep(P, function (p) { return p.new; });
    var rows = $.map(P, function (p) { return '<div class="upm-row upm-pl ' + (p.new ? 's-amber' : 's-grey') + '"><span><b>' + esc(p.id) + '</b>' + (p.ours ? ' <span class="upm-chip b">ours: ' + esc(p.ours) + '</span>' : '') + '<small>' + esc(p.cur || '?') + (p.new ? ' &rarr; ' + esc(p.new) : '') + '</small></span><span class="upm-num">' + (p.new ? 'update' : '') + '</span></div>'; }).join('');
    $('#upm-pl').html(gbar('pl', up.length ? 's-amber' : 's-grey', up.length ? up.length + ' plugin update' + (up.length > 1 ? 's' : '') + ' (install them on the Plugins page; ours with their .plg)' : 'Up to date at Unraid\'s last plugin check', P.length + ' plugins') + grp('pl', rows));
    $('#upm-pband').text(P.length + ' plugins · ' + up.length + ' updates');
  }

  // ---- self-test
  function drawTest(r) {
    var t = r.test, busy = r.busy.selftest, h = '<div class="upm-lead"><p>Read-only checks of our connections: logins and GET requests. It runs by itself after an update; Discord gets the result.</p><input type="button" class="upm-test-b upm-ghost" value="' + (busy ? 'Testing...' : 'Run the self-test') + '"' + (busy ? ' disabled' : '') + '></div>';
    if (t) { $.each(t.tests, function (i, x) { h += '<div class="upm-row upm-test ' + (x.ok ? 's-green' : 's-red') + '"><span class="upm-ico ' + (x.ok ? 'upm-ok">&#10003;' : 'upm-er">!') + '</span><span><b>' + esc(x.name) + '</b><small>for ' + esc(x.for) + '</small></span><span>' + esc(x.msg) + '</span><span class="upm-num">' + x.ms + ' ms</span></div>'; }); }
    $('#upm-test').html(h);
    $('#upm-tband').text(t ? 'last: ' + ago(t.t) + ' ago · ' + $.grep(t.tests, function (x) { return x.ok; }).length + '/' + t.tests.length + ' passed' : 'not run yet');
  }
  $(document).on('click', '#upm .upm-test-b', function () { $(this).prop('disabled', true).val('Testing...'); api('selftest').done(function (r) { if (!r.ok) { window.alert(r.error); } load(); }); });

  // ---- settings
  function drawSet(r) {
    var c = r.cfg;
    function ck(id, on, text) { return '<label><input type="checkbox" id="' + id + '"' + (+on ? ' checked' : '') + '> ' + text + '</label>'; }
    $('#upm-set').html(
      '<div class="upm-row upm-set"><span class="lb">Daily check</span><div class="upm-ctl">' + ck('upm-on', c.on, 'on') + ' at <input type="number" id="upm-h" min="0" max="23" value="' + c.hour + '"> : <input type="number" id="upm-m" min="0" max="59" value="' + c.min + '"><span class="upm-hint">only reads (registries, GitHub). Nothing is installed by itself</span></div></div>' +
      '<div class="upm-row upm-set"><span class="lb">Maturing time</span><div class="upm-ctl"><input type="number" id="upm-soak" min="0" max="60" value="' + c.soak + '"> days<span class="upm-hint">a new-features release younger than this is amber, even without warning words</span></div></div>' +
      '<div class="upm-row upm-set"><span class="lb">Discord</span><div class="upm-ctl"><select id="upm-dc"><option value="warn"' + (c.discord === 'warn' ? ' selected' : '') + '>amber and red ones</option><option value="all"' + (c.discord === 'all' ? ' selected' : '') + '>every new update</option><option value="off"' + (c.discord === 'off' ? ' selected' : '') + '>off</option></select><span class="upm-hint">after the daily check, once per update (the Sysbox webhook); updates you start always report their result</span></div></div>' +
      '<div class="upm-row upm-set"><span class="lb">Before an update</span><div class="upm-ctl">' + ck('upm-bk', c.backup, 'ZFS snapshot of the container\'s data') + ck('upm-st', c.selftest, 'self-test after it') + '<span class="upm-hint">the snapshot is named before-update-&lt;name&gt;-&lt;date&gt; and stays until you delete it on the Snapshots page</span></div></div>' +
      '<div class="upm-row upm-set"><span class="lb">Ask Claude</span><div class="upm-ctl">' + ck('upm-cl', c.claude, 'show the button') + '<span class="upm-chip p">read-only: Read, Grep</span><span class="upm-hint">Claude Code in the claude container, in the repo folder, without a saved session; it never runs commands or writes. The answer is kept per version. A new Unraid OS version is asked about by itself after a check, once</span></div></div>' +
      '<div class="upm-row upm-set"><span></span><div class="upm-ctl"><input type="button" id="upm-save" value="Save"><span id="upm-smsg"></span></div></div>');
  }
  $(document).on('click', '#upm-save', function () {
    var $m = $('#upm-smsg').attr('class', '').text('Saving...');
    api('save', {on: $('#upm-on').prop('checked') ? 1 : 0, hour: $('#upm-h').val(), min: $('#upm-m').val(), soak: $('#upm-soak').val(), discord: $('#upm-dc').val(),
      backup: $('#upm-bk').prop('checked') ? 1 : 0, selftest: $('#upm-st').prop('checked') ? 1 : 0, claude: $('#upm-cl').prop('checked') ? 1 : 0})
      .done(function (r) { if (r.ok) { $m.attr('class', 'upm-ok').text('Saved.'); load(); } else { $m.attr('class', 'upm-er').text(r.error); } }).fail(function (x) { $m.attr('class', 'upm-er').text(err(x)); });
  });

  function draw(r) {
    D = r; drawAct(r); drawSum(r); drawCt(r); drawOs(r); drawTest(r);
    if (!CONF || JSON.stringify(CONF) !== JSON.stringify(r.cfg)) { CONF = r.cfg; drawSet(r); }
  }
  function load() {
    api('state').done(function (r) {
      // the worker starts in the background: right after the click the job may not exist yet, so "not running" alone
      // does not mean done; an ask is over when an answer newer than the click is there or its job has ended
      var ask = asking(r);
      $.each(WATCH, function (n, w) {
        var row = n === 'unraid-os' ? (r.scan && r.scan.os) : null, ended = false;
        if (!row) { $.each((r.scan && r.scan.rows) || [], function (i, x) { if (x.name === n) { row = x; } }); }
        $.each(r.jobs || [], function (i, j) { if (j.kind === 'ask' && j.name === n && j.state !== 'running' && (j.started || 0) >= w - 2) { ended = true; } });
        var got = row && row.claude && row.claude.t >= w - 2;
        if (!ask[n] && (got || ended || !row || Date.now() / 1000 - w > 900)) { delete WATCH[n]; if (got && row.risk && n !== 'unraid-os') { OPEN['ct|' + row.risk] = true; } }
      });
      draw(r);
      clearTimeout(pollT); var b = r.busy; if (b.scan || b.ask || b.update || b.selftest || !$.isEmptyObject(WATCH)) { pollT = setTimeout(load, 3000); }
    }).fail(function (x) { $('#upm-act').html('<div class="upm-status upm-er">' + esc(err(x)) + '</div>'); });
  }
  load();
});
</script>
