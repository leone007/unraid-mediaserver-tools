<?PHP
$pluginname = "diskbox";
// texts from the dictionary (lang/en.json and its translations, see i18n.php); own names: Monitor runs this in its scope
require_once '/usr/local/emhttp/plugins/diskbox/i18n.php';
$dbt_lang = '/usr/local/emhttp/plugins/diskbox/lang';
$dbt_T = mt_i18n_t($dbt_lang);
$dbt_t = [];
foreach (['reading' => 'tile.reading', 'loading' => 'tile.loading', 'main' => 'tile.open_main', 'set' => 'tile.settings'] as $dbt_k => $dbt_v) { $dbt_t[$dbt_k] = htmlspecialchars($dbt_T($dbt_v), ENT_QUOTES); }

$mytiles[$pluginname]['column2'] =
<<<EOT
<tbody title="_(Diskbox)_">
<tr><td>
  <span class="tile-header">
    <span class="tile-header-left">
      <i class="f32 dbx-ic"></i>
      <div class="section">
        <h3 class="tile-header-main dbx-ttl">Diskbox</h3>
        <span id="dbx-summary" class="dbx-sum">{$dbt_t['reading']}</span>
      </div>
    </span>
    <span class="tile-header-right">
      <span class="tile-header-right-controls">
        <a href="/Main" title="{$dbt_t['main']}"><i class="fa fa-fw fa-home control"></i></a>
        <a href="/Settings/DiskboxSettings" title="{$dbt_t['set']}"><i class="fa fa-fw fa-cog control"></i></a>
      </span>
    </span>
  </span>
</td></tr>
<tr><td>
  <div class="dbx-tile">
    <div id="dbx-attn"></div>
    <div id="dbx-bal"></div>
    <div id="dbx-array"><div class="dbx-note">{$dbt_t['loading']}</div></div>
    <div id="dbx-pools"></div>
    <div id="dbx-ua"></div>
  </div>
</td></tr>
</tbody>
EOT;
echo mt_i18n_js($dbt_lang, 'dbx', ['tile.', 'bar.', 'attn.', 'hd.', 'card.', 'sum.', 'err.', 'time.', 'bal.moving', 'bal.finished', 'bal.stopped', 'bal.error', 'bal.skipped']);
?>
<style>
