    var bar = function (k, cls, label) {
      var g = 'r' + k, n = grp[k].length; if (!n) { return ''; }
      return '<div class="dbb-gbar ' + cls + '" data-g="' + g + '"><span class="pm">' + (GOPEN[g] ? '&minus;' : '+') + '</span><span></span><span>' + label(n) + '</span><span class="c">' + fb(gsz[k]) + '</span></div><div class="dbb-grp" data-g="' + g + '"' + (GOPEN[g] ? '' : ' hidden') + '>' + grp[k].join('') + '</div>';
    };
    $('#dbb-rtab').html(top + bar('wait', 's-grey', function (n) { return esc(T(s.state === 'running' ? 'run.more_waiting' : 'run.not_moved', { n: n })); })
      + bar('skip', 's-amber', function (n) { return esc(T('run.n_skipped', { n: n })); }) + bar('ok', 's-green', function (n) { return esc(T('run.n_done', { n: n })); }));
    var $l = $('#dbb-rlog'), atEnd = $l[0].scrollTop + $l[0].clientHeight >= $l[0].scrollHeight - 5;
    $l.text((s.log || []).join('\n')); if (atEnd) { $l[0].scrollTop = $l[0].scrollHeight; }
    $('#dbb-runbox .dbb-gbar[data-g="rlog"] .c').text(T('run.lines', { n: (s.log || []).length }));
    $('#dbb-stop').toggle(!!running).prop('disabled', false);
  }
  // the finished runs, folded under one bar
  function drawHist(r) {
    var hh = (r.history || []).filter(function (x) { return x; }), runs = 0, ab = 0, last = '';
    $.each(hh, function (i, l) { if (/ start /.test(l)) { runs++; } if (/ aborted /.test(l)) { ab++; } last = l.slice(0, 10); });
    $('#dbb-hist').html(hh.length ? '<div class="dbb-gbar s-grey" data-g="hist"><span class="pm">' + (GOPEN.hist ? '&minus;' : '+') + '</span><span></span><span>' + esc(T('hist.title') + ' · ' + T('hist.runs', { n: runs })) + '</span><span class="c">' + (ab ? esc(T('hist.stopped', { n: ab })) + ' &middot; ' : '') + esc(T('hist.last', { d: last })) + '</span></div><div class="dbb-grp" data-g="hist"' + (GOPEN.hist ? '' : ' hidden') + '><div class="dbb-log">' + esc(hh.join('\n')) + '</div></div>'
      : '<div class="dbb-status dbb-mut">' + esc(T('hist.none')) + '</div>');
    if ((!r.run || r.run.state === 'idle') && !$('#dbb-rmact').children().length) { $('#dbb-aband').text(hh.length ? T('hist.idle_last', { d: last }) : T('hist.idle')); }
  }
  function poll() {
    clearTimeout(pollT);
    api('state').done(function (r) {
      drawRun(r.run, r.running); drawHist(r);
      if (r.running || r.run.state === 'running') { pollT = setTimeout(poll, 2000); }
    });
  }

  api('state').done(function (r) {
    BUSY = r.busy || '';
    drawCfg(r);
    drawRun(r.run, r.running); drawHist(r);
    if (r.running || r.run.state === 'running') { poll(); }
    else if (r.plan.state === 'running') { $('#dbb-plan').prop('disabled', true); pollPlan(); }
    else if (r.plan.state === 'ready') { api('getplan').done(function (g) { BUSY = g.busy || BUSY; if (g.plan.units) { drawPlan(g.plan); } }); }
  }).fail(function (x) { $('#dbb-pmsg').css('color', '#e5534b').text(err(x)); });
});
</script>
