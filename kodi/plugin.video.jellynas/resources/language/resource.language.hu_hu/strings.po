msgctxt "#30001"
msgid "Continue watching"
msgstr "Megtekintés folytatása"

msgctxt "#30002"
msgid "Spotlight"
msgstr "Kiemelt"

msgctxt "#30003"
msgid "This week"
msgstr "Ezen a héten"

#. Folder: the next episode of each series in progress (Jellyfin next up)
msgctxt "#30004"
msgid "Next up"
msgstr "Következik"

#. Folder: movies added lately (Jellyfin latest)
msgctxt "#30005"
msgid "Recently added movies"
msgstr "Nemrég hozzáadott filmek"

#. Folder: series with new episodes (Jellyfin latest, grouped by series)
msgctxt "#30006"
msgid "Recently added series"
msgstr "Nemrég hozzáadott sorozatok"

#. Folder: the whole movie library, newest first (a category's poster wall)
msgctxt "#30007"
msgid "All movies"
msgstr "Összes film"

#. Folder: the whole series library, newest first (a category's poster wall)
msgctxt "#30008"
msgid "All series"
msgstr "Összes sorozat"

msgctxt "#30010"
msgid "Log in to Kofin first"
msgstr "Előbb jelentkezz be a Kofinban"

msgctxt "#30012"
msgid "Not available yet: {st}"
msgstr "Még nem elérhető: {st}"

msgctxt "#30020"
msgid "Available"
msgstr "Elérhető"

msgctxt "#30021"
msgid "Available soon"
msgstr "Hamarosan elérhető"

msgctxt "#30022"
msgid "Downloading"
msgstr "Letöltés"

msgctxt "#30023"
msgid "Downloading {p}%"
msgstr "Letöltés {p}%"

msgctxt "#30024"
msgid "Download starting"
msgstr "Letöltés indul"

msgctxt "#30025"
msgid "Paused"
msgstr "Szünetel"

msgctxt "#30026"
msgid "Download failed"
msgstr "Letöltési hiba"

msgctxt "#30027"
msgid "Late {d}"
msgstr "Késik {d}"

msgctxt "#30028"
msgid "In {d}"
msgstr "{d} múlva"

