msgid "Airs in {d}"
msgstr "Adás {d} múlva"

msgctxt "#30030"
msgid "Any time now"
msgstr "Bármikor jöhet"

msgctxt "#30031"
msgid "Today"
msgstr "Ma"

msgctxt "#30032"
msgid "{d}d {h}h"
msgstr "{d}n {h}ó"

msgctxt "#30033"
msgid "{h}h {m}m"
msgstr "{h}ó {m}p"

msgctxt "#30034"
msgid "{m}m"
msgstr "{m}p"

msgctxt "#30035"
msgid "{n}/{m} available"
msgstr "{n}/{m} elérhető"

msgctxt "#30036"
msgid "{n} episodes"
msgstr "{n} epizód"

msgctxt "#30040"
msgid "Monday"
msgstr "Hétfő"

msgctxt "#30041"
msgid "Tuesday"
msgstr "Kedd"

msgctxt "#30042"
msgid "Wednesday"
msgstr "Szerda"

msgctxt "#30043"
msgid "Thursday"
msgstr "Csütörtök"

msgctxt "#30044"
msgid "Friday"
msgstr "Péntek"

msgctxt "#30045"
msgid "Saturday"
msgstr "Szombat"

msgctxt "#30046"
msgid "Sunday"
msgstr "Vasárnap"

#. Grid bar sort choice: date added, newest first (the default)
msgctxt "#30050"
msgid "Newest"
msgstr "Legújabb"

#. Grid bar sort choice: by title, A to Z
msgctxt "#30051"
msgid "Title"
msgstr "Cím"

#. Grid bar sort choice: by release year, newest first
msgctxt "#30052"
msgid "Year"
msgstr "Év"

#. Grid bar sort choice: by the IMDb rating shown on the badges, best first
msgctxt "#30053"
msgid "IMDb rating"
msgstr "IMDb-értékelés"

#. First line of the genre chooser: no genre filter
msgctxt "#30054"
msgid "All genres"
msgstr "Minden műfaj"

#. Grid bar button and dialog heading: the sort order of the poster grid
msgctxt "#30055"
msgid "Sort by"
msgstr "Rendezés"

#. Grid bar button and dialog heading: genre filter of the poster grid
msgctxt "#30056"
msgid "Genre"
msgstr "Műfaj"

#. Grid filter line: only titles not watched yet are shown
msgctxt "#30057"
msgid "Unwatched"
msgstr "Nem látott"

#. Grid bar: no filter (first item of the letter row, value of the watched and genre buttons)
msgctxt "#30058"
msgid "All"
msgstr "Mind"

#. Grid bar button: back to the whole library, newest first
msgctxt "#30059"
msgid "Clear filters"
msgstr "Szűrők törlése"

#. Grid bar button: show or hide titles already watched
msgctxt "#30060"
msgid "Watched"
msgstr "Megnézettek"

#. Grid bar: value of the watched button when watched titles are hidden
msgctxt "#30061"
msgid "Hidden"
msgstr "Elrejtve"

#. Folder: Seerr catalog (discover and request titles)
msgctxt "#30070"
msgid "Catalog"
msgstr "Katalógus"

#. Catalog row: trending movies and series this week
msgctxt "#30071"
msgid "Trending"
msgstr "Felkapott"

#. Catalog row
msgctxt "#30072"
msgid "Popular movies"
msgstr "Népszerű filmek"

#. Catalog row: movies not released yet
msgctxt "#30073"
msgid "Upcoming movies"
msgstr "Hamarosan érkező filmek"

#. Catalog row
msgctxt "#30074"
msgid "Popular series"
msgstr "Népszerű sorozatok"

#. Catalog row: series starting soon
msgctxt "#30075"
msgid "Upcoming series"
msgstr "Hamarosan érkező sorozatok"

#. Catalog folder: the Seerr requests
msgctxt "#30076"
msgid "Requests"
msgstr "Kérések"

#. Requests folder: every request
msgctxt "#30077"
msgid "All requests"
msgstr "Összes kérés"

#. Requests folder: approved, being downloaded
msgctxt "#30078"
msgid "Processing"
msgstr "Folyamatban"

#. Requests folder: requested, not released yet
msgctxt "#30079"
msgid "Coming soon"
msgstr "Hamarosan"

#. Requests folder and card badge: the title can be watched
msgctxt "#30080"
msgid "Available"
msgstr "Elérhető"

#. Card badge: some seasons can be watched
msgctxt "#30081"
msgid "Partially available"
msgstr "Részben elérhető"

#. Status in the card dialog heading: requested, not available yet
msgctxt "#30082"
msgid "Requested"
msgstr "Kérve"

#. Card dialog: play in Jellyfin
msgctxt "#30083"
msgid "Play"
msgstr "Lejátszás"

#. Card dialog option (movie) and the heading of the yes/no question
msgctxt "#30084"
msgid "Request"
msgstr "Kérés"

#. Card dialog option (series); {n} is the number of seasons
msgctxt "#30085"
msgid "Request the missing seasons ({n})"
msgstr "Kérés: a hiányzó évadok ({n})"

#. Card dialog option (series) and the heading of the season list
msgctxt "#30086"
msgid "Choose seasons..."
msgstr "Évadok kiválasztása..."

#. Card dialog option: the info window
msgctxt "#30087"
msgid "Details"
msgstr "Részletek"

#. Yes/no question before the request is sent; {title} is the title (and the seasons)
msgctxt "#30088"
msgid "Request {title}?"
msgstr "Kérjük ezt: {title}?"

#. Notification after a request
msgctxt "#30089"
msgid "Request sent"
msgstr "Kérés elküldve"

#. Notification: Seerr has this request already
msgctxt "#30090"
msgid "Already requested"
msgstr "Már kérték"

#. Notification: the request could not be made
msgctxt "#30091"
msgid "No Seerr account for this Jellyfin user"
msgstr "Ehhez a Jellyfin-fiókhoz nincs Seerr-fiók"

#. Notification: the JELLYNAS catalog proxy is not reachable
msgctxt "#30092"
msgid "The catalog server does not answer"
msgstr "A katalógus-szerver nem válaszol"

#. Season name in the season list; {n} is its number
msgctxt "#30093"
msgid "Season {n}"
msgstr "{n}. évad"

#. Second line of a request card: who asked and when (date); keep the order if it reads well
msgctxt "#30094"
msgid "{who} · {day}"
msgstr "{who} · {day}"

#. Setting: the address of the JELLYNAS catalog proxy, e.g. http://192.168.50.30:5056
msgctxt "#30095"
msgid "Catalog server address"
msgstr "Katalógus-szerver címe"

#. Card badge (short, the badge is narrow): some seasons can be watched
msgctxt "#30096"
msgid "Partly"
msgstr "Részben"

#. Catalog page tab (skin): movies
msgctxt "#30097"
msgid "Movies"
msgstr "Filmek"

#. Catalog page tab (skin): series
msgctxt "#30098"
msgid "Series"
msgstr "Sorozatok"

#. Catalog page row (skin)
msgctxt "#30110"
msgid "Trending movies"
msgstr "Felkapott filmek"

#. Catalog page row (skin)
msgctxt "#30111"
msgid "Trending series"
msgstr "Felkapott sorozatok"

msgctxt "#30100"
msgid "General"
msgstr "Általános"

msgctxt "#30101"
msgid "Language of the rows"
msgstr "A sorok nyelve"

msgctxt "#30102"
msgid "Same as Kodi"
msgstr "Ugyanaz, mint a Kodié"

msgctxt "#30103"
msgid "English"
msgstr "English"

msgctxt "#30104"
msgid "Magyar"
msgstr "Magyar"

#. Card second line: a length of hours and minutes, e.g. 2 h 5 min
msgctxt "#30105"
msgid "{h} h {m} min"
msgstr "{h} ó {m} p"

#. Card second line: a length under an hour, e.g. 45 min
msgctxt "#30106"
msgid "{m} min"
msgstr "{m} p"

#. Card second line: number of seasons of a series (more than one)
msgctxt "#30107"
msgid "{n} seasons"
msgstr "{n} évad"

#. Card second line: a series with one season
msgctxt "#30108"
msgid "1 season"
msgstr "1 évad"
