diff --git a/1080i/Includes_Labels.xml b/1080i/Includes_Labels.xml
index 1138f53..87b1fd2 100644
--- a/1080i/Includes_Labels.xml
+++ b/1080i/Includes_Labels.xml
@@ -964,6 +964,23 @@
         <value>SDR</value>
     </variable>
 
+    <!-- JELLYNAS: Player process info (patch 10) -->
+    <variable name="Label_JellynasPlayMethod">
+        <value condition="VideoPlayer.Content(livetv)"></value>
+        <value condition="String.Contains(Player.Filenameandpath,master.m3u8) | String.Contains(Player.Filenameandpath,/hls) | String.Contains(Player.Filenameandpath,transcod)">[COLOR FFF0B43C]$LOCALIZE[31907][/COLOR]</value>
+        <value>[COLOR FF3ECF7A]$LOCALIZE[31906][/COLOR]</value>
+    </variable>
+
+    <variable name="Label_JellynasChapter">
+        <value condition="Integer.IsGreater(Player.ChapterCount,1) + [String.IsEmpty(Player.ChapterName) | String.StartsWith(Player.ChapterName,Chapter) | String.StartsWith(Player.ChapterName,Fejezet)]">$LOCALIZE[31910] $INFO[Player.Chapter]/$INFO[Player.ChapterCount]</value>
+        <value condition="Integer.IsGreater(Player.ChapterCount,1)">$LOCALIZE[31910] $INFO[Player.Chapter]/$INFO[Player.ChapterCount]$INFO[Player.ChapterName, ,]</value>
+    </variable>
+
+    <variable name="Label_JellynasSubtitle">
+        <value condition="VideoPlayer.SubtitlesEnabled + !String.IsEmpty(VideoPlayer.SubtitlesLanguage)">$LOCALIZE[31901] $INFO[VideoPlayer.SubtitlesLanguage]</value>
+        <value>$LOCALIZE[31901] $LOCALIZE[31913]</value>
+    </variable>
+
     <variable name="Label_VideoHWDecoder">
         <value condition="Player.Process(videohwdecoder)">HW</value>
         <value>SW</value>
