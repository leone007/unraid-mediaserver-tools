<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.jellynas" name="JELLYNAS Repository" version="1.0.1" provider-name="leone007">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="JELLYNAS Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/leone007/unraid-mediaserver-tools/main/dist/kodi/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/leone007/unraid-mediaserver-tools/main/dist/kodi/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/leone007/unraid-mediaserver-tools/main/dist/kodi/</datadir>
    </dir>
    <dir>
      <!-- the skin zip (~67 MB) is a GitHub release asset (tag = skin id), not a git file -->
      <info compressed="false">https://raw.githubusercontent.com/leone007/unraid-mediaserver-tools/main/dist/kodi/skins/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/leone007/unraid-mediaserver-tools/main/dist/kodi/skins/addons.xml.md5</checksum>
      <datadir zip="true">https://github.com/leone007/unraid-mediaserver-tools/releases/download/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Kodi add-ons of the JELLYNAS media server (unraid-mediaserver-tools)</summary>
    <summary lang="hu_HU">A JELLYNAS médiaszerver Kodi-kiegészítői (unraid-mediaserver-tools)</summary>
    <description lang="en_GB">Updates the JELLYNAS add-ons and the Arctic Fuse 2 JELLYNAS skin from the public GitHub repository leone007/unraid-mediaserver-tools.</description>
    <description lang="hu_HU">A JELLYNAS-kiegészítőket és az Arctic Fuse 2 JELLYNAS skint frissíti a leone007/unraid-mediaserver-tools nyilvános GitHub-repóból.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
