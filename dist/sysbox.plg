</div>
<p class="sx-attn-note">The Needs attention list stays on top of the tile whatever is switched off.</p>

<h3>Containers</h3>
<dl>
<dt>Which containers:</dt>
<dd>
  <select name="top_mode" id="sx-mode" style="width:auto">
    <option value="cpu" <?=$sx['top_mode'] === 'cpu' ? 'selected' : ''?>>The busiest by CPU</option>
    <option value="ram" <?=$sx['top_mode'] === 'ram' ? 'selected' : ''?>>The busiest by RAM</option>
    <option value="selected" <?=$sx['top_mode'] === 'selected' ? 'selected' : ''?>>The containers I select below</option>
  </select>
</dd>

<dt>Number of rows (busiest modes):</dt>
<dd><input type="number" name="top_n" min="1" max="10" class="narrow" value="<?=sx_h($sx['top_n'])?>"></dd>

<dt>Selected containers:</dt>
<dd>
<?php if (!$sx_ps): ?>
  <i>No containers found (Docker is not running, or there are none).</i>
<?php else: foreach ($sx_ps as $sx_n => $sx_p): ?>
  <label style="display:block"><input type="checkbox" name="sel[]" value="<?=sx_h($sx_n)?>" <?=in_array($sx_n, $sx_sel, true) ? 'checked' : ''?>> <?=sx_h($sx_n)?></label>
<?php endforeach; endif; ?>
</dd>

<dt>Start, stop and restart buttons:</dt>
