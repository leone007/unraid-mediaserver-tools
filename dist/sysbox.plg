 "set.help_tile": {
  "text": "Sysbox replaces the System and Processor tiles (hide them in the dashboard's tile management) and, when switched on, takes over the server load of the Streambox tile. The container buttons use the Docker command line with the exact name of an existing container; nothing else can be started from the dashboard. Statistics, GPU and socket readings are collected in the background only while the dashboard is open. The monthly energy figure is the socket's own counter since the 1st of the month, and a small cron job keeps it exact even when nobody has the dashboard open.",
  "note": "grey paragraph at the bottom of the settings page."
 },
 "set.help_discord": {
  "text": "Discord alerts: Unraid checks every minute and posts to the webhook only when something changes: a problem appears, gets worse, or is over. A container that stops with a normal exit (code 0 or a plain stop) or through the dashboard button is not reported; one that crashes, is killed or runs out of memory is. Memory, CPU temperature and unhealthy checks must last a few minutes before they are reported, and a restart loop means three restarts within ten minutes. Red alerts can repeat after the chosen number of hours. The buttons use the saved settings, so press Apply first. Create a webhook in Discord under channel settings, Integrations, Webhooks.",
  "note": "grey paragraph at the bottom of the settings page."
 },
 "set.sending": {
  "text": "Sending...",
  "note": "message next to the test buttons while sending."
 },
 "set.saving": {
  "text": "Saving...",
  "note": "message next to Apply while saving."
 },
 "set.saved": {
  "text": "Saved. The dashboard picks it up within a few seconds.",
  "note": "message next to Apply after saving."
 },
