 "sg.why": {
  "text": "Claude: {t}",
  "note": "why Claude suggests it. {t} Claude's sentence."
 },
 "sg.none": {
  "text": "No suggestion waiting. In the daily report Claude may suggest an action from a fixed list; you approve it here or with a reaction on Discord.",
  "note": "lead text when no suggestion waits."
 },
 "sg.off": {
  "text": "Suggestions are off (no action type is allowed in the settings below).",
  "note": "lead text when every suggestion type is off."
 },
 "sg.old": {
  "text": "Earlier suggestions",
  "note": "foldable bar title."
 },
 "sg.old_count": {
  "text": "{n} · {a} approved, {d} not now, {e} expired",
  "note": "count on the Earlier suggestions bar."
 },
 "gds.p_sug": {
  "text": "Suggestions",
  "note": "morning brief part chip: Claude's suggestions."
 },
 "gds.s_lb": {
  "text": "Suggestions may offer",
  "note": "settings label."
 },
 "gds.s_upd_safe": {
  "text": "Safe container updates",
  "note": "checkbox: suggestion type."
 },
 "gds.s_upd_look": {
  "text": "Look-first updates",
  "note": "checkbox: suggestion type."
 },
 "gds.s_snap": {
  "text": "Old before-update snapshots to delete",
  "note": "checkbox: suggestion type."
 },
 "gds.s_test": {
  "text": "Self-test, Check now",
  "note": "checkbox: suggestion type."
 },
 "gds.s_sbx": {
  "text": "Seedbox: stuck job to hide",
  "note": "checkbox: suggestion type."
 },
 "gds.s_hint": {
  "text": "Claude picks from these in the daily report (at most 3). Never the red (Wait) updates, never anything outside this list; each needs Approve and its own confirmation. Not now hides it for 3 days.",
  "note": "hint under the suggestion types."
 },
 "gds.sdc_lb": {
  "text": "Approve from Discord",
  "note": "settings label."
 },
 "gds.sdc": {
  "text": "with reactions under the morning brief",
  "note": "checkbox label."
 },
 "gds.bot_ok": {
  "text": "bot set ✓",
  "note": "chip: the shared Discord bot is set."
 },
 "gds.bot_no": {
  "text": "set the Discord bot below",
  "note": "chip: the shared Discord bot is not set."
 },
 "gds.sdc_hint": {
  "text": "The bot puts 1️⃣ 2️⃣ 3️⃣ 👎 under the brief; only your reaction counts, for 24 hours (👎 = Not now for all). A number starts the action without another question, like Approve and the confirmation here.",
  "note": "hint under Approve from Discord."
 },
 "brief.h_sug": {
  "text": "Suggestions ({n})",
  "note": "Discord morning brief: field title of Claude's suggestions."
 },
 "brief.sug_how": {
  "text": "Approve: react with the number (valid for 24 hours), 👎 = not now; or on the Claude Guard page",
  "note": "Discord morning brief: how to approve (bot set)."
 },
 "brief.sug_page": {
  "text": "Approve them on the Claude Guard page (Settings, Utilities)",
  "note": "Discord morning brief: how to approve (no bot)."
 },
 "brief.h_sst": {
  "text": "Status",
  "note": "Discord morning brief: field title of the suggestions' status, edited later."
 },
 "brief.sst_wait": {
  "text": "⏳ waiting",
  "note": "Discord morning brief: state of one suggestion in the status field."
 },
 "brief.sst_run": {
  "text": "▶ running",
  "note": "Discord morning brief: state of one suggestion in the status field."
 },
 "brief.sst_done": {
  "text": "✅ done",
  "note": "Discord morning brief: state of one suggestion in the status field."
 },
 "brief.sst_fail": {
  "text": "⛔ failed (see the Guard page)",
  "note": "Discord morning brief: state of one suggestion in the status field."
 },
 "brief.sst_no": {
  "text": "👎 not now",
  "note": "Discord morning brief: state of one suggestion in the status field."
 },
 "brief.sst_expired": {
  "text": "⌛ expired",
  "note": "Discord morning brief: state of one suggestion in the status field."
 },
 "brief.sst_gone": {
  "text": "✖ no longer valid",
  "note": "Discord morning brief: state of one suggestion in the status field."
 }
}
]]></INLINE>
</FILE>

