 "upm.intro": {
  "text": "What the waiting updates change and what of ours uses the container, before you install them. The page and the daily check only read (the containers' labels, the registries, GitHub, Unraid's own update check); a container is updated only with its button, after a ZFS snapshot of its data.",
  "note": "lead line at the top of the Update manager page (Settings, Utilities, Update manager)."
 },
 "upm.h.activity": {
  "text": "Activity",
  "note": "band title (upper case on screen)."
 },
 "upm.h.summary": {
  "text": "Summary",
  "note": "band title (upper case on screen)."
 },
