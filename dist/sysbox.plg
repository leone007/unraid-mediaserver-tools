#gdm .gdm-lead p b.v-amber{color:#d9921f}#gdm .gdm-lead p b.v-red{color:#e5534b}#gdm .gdm-lead p b.v-green{color:#3fa24a}
#gdm .gdm-log{max-height:240px;overflow:auto;font-family:monospace;font-size:12px;white-space:pre-wrap;padding:10px 12px;margin:0;opacity:.75}
#gdm .gdm-set{grid-template-columns:minmax(200px,280px) minmax(0,1fr);align-items:center}
#gdm .gdm-set .lb{opacity:.75}
#gdm .gdm-ctl{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center}
#gdm .gdm-ctl input[type=number]{width:62px!important;margin:0}
#gdm .gdm-ctl select{margin:0;min-width:0}
