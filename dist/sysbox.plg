 "sd.intro": {
  "text": "Stops the containers (qBittorrent first, with up to 5 minutes to close its files) and the VMs, shows every process that still uses the array or pool disks, then calls Unraid's own shutdown or restart, the same as the buttons on the Main page. Nothing is stopped until you press a button.",
  "note": "lead line at the top of the Safe shutdown page (Settings, Utilities, Safe shutdown). Main is Unraid's page."
 },
 "sd.h.activity": {
  "text": "Activity",
  "note": "band title (upper case on screen)."
 },
 "sd.nothing": {
  "text": "Nothing has been stopped from this page.",
  "note": "Activity before anything was done."
 },
 "sd.log": {
  "text": "Log of the last run",
  "note": "foldable bar with the technical log."
 },
 "sd.h1": {
  "text": "Before you start",
  "note": "band title of step 1 (upper case on screen)."
 },
 "sd.checking": {
  "text": "Checking...",
  "note": "placeholder of step 1."
 },
 "sd.h2": {
  "text": "Containers and VMs",
  "note": "band title of step 2 (upper case on screen)."
 },
 "sd.s2": {
  "text": "qBittorrent stops first with up to 5 minutes to close its files, then the others together. The server keeps running; the stopped ones can be started again here.",
  "note": "lead line of step 2."
 },
 "sd.btn.stop": {
  "text": "Stop the containers and VMs",
  "note": "main button of step 2."
 },
 "sd.btn.cancel": {
  "text": "Cancel",
  "note": "button while the stop runs. Short."
 },
 "sd.btn.start": {
  "text": "Start them again",
  "note": "button: starts the containers this page stopped."
 },
 "sd.h3": {
  "text": "Still using the disks",
  "note": "band title of step 3 (upper case on screen)."
 },
 "sd.s3": {
  "text": "Every process that has a file open on the array or pool disks. Ask to quit sends TERM, so the program can save and close its files; Force quit sends KILL, only for what does not quit (unsaved data of that program is lost). What Unraid stops by itself (Samba, Docker, the VM manager) or what runs inside a container is not offered.",
  "note": "lead line of step 3. TERM and KILL are signal names: keep them."
 },
 "sd.btn.term": {
  "text": "Ask the ticked ones to quit",
  "note": "button of step 3 (sends TERM)."
 },
 "sd.btn.kill": {
  "text": "Force quit",
  "note": "red button of step 3 (sends KILL)."
 },
 "sd.btn.refresh": {
  "text": "Check again",
  "note": "button of step 3."
 },
 "sd.h4": {
  "text": "Shut down",
  "note": "band title of step 4 (upper case on screen)."
 },
 "sd.h4_sub": {
  "text": "Unraid's own shutdown, as on the Main page",
  "note": "grey text on the right of the step 4 band."
 },
 "sd.btn.off": {
  "text": "Shut down",
  "note": "button: Unraid shutdown. Short."
 },
 "sd.btn.reboot": {
  "text": "Restart",
  "note": "button: Unraid restart. Short."
 },
 "sd.foot": {
  "text": "When the last row is green, nothing uses the disks and no container or VM runs.",
  "note": "grey line at the bottom of the page."
 },
 "dur.ms": {
