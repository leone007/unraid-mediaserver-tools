<?PHP
// texts from the dictionary (lang/en.json, see i18n.php)
require_once '/usr/local/emhttp/plugins/sysbox/i18n.php';
$sds_lang = '/usr/local/emhttp/plugins/sysbox/lang';
$sds_T = mt_i18n_t($sds_lang);
$sds_t = function ($k, $v = []) use ($sds_T) { return htmlspecialchars($sds_T($k, $v), ENT_QUOTES); };
$sds_var = @parse_ini_file('/var/local/emhttp/var.ini');
$sds_tok = is_array($sds_var) ? (string)($sds_var['csrf_token'] ?? '') : '';
?>
<style>
/* the Dashboard tile look (common/tile.css, inserted by the build): Activity on top, then the four steps, each a dark band + striped rows */
/* Shared tile look (the Sysbox / Diskbox style): dark section bands, the content in a box under them, colored left stripes on rows.
   Used by Seedbox and Streambox; the build copies this block into each plugin's page where the marker below stands. */
.mt-band{display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(0,0,0,.25);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:7px 10px;margin-top:14px}
.mt-band.mt-first{margin-top:6px}
.mt-band span{opacity:.75}
.mt-band b{font-weight:400;opacity:.5;text-transform:none;letter-spacing:0;text-align:right}
.mt-band.mt-red span{color:#e5534b;opacity:1}
.mt-box{background:rgba(128,128,128,.12);margin-top:8px}
.mt-cols{display:grid;gap:8px;align-items:center;padding:6px 10px 4px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid rgba(128,128,128,.2)}
.mt-cols>div{opacity:.6}
.mt-r{display:grid;gap:8px;align-items:center;padding:8px 10px;border-top:1px solid rgba(128,128,128,.2)}
.mt-box>.mt-r:first-child,.mt-cols+.mt-r{border-top:0}
.mt-s-orange{background:rgba(245,165,36,.10);box-shadow:inset 3px 0 0 #f5a524}
.mt-s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
.mt-s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
.mt-s-red{background:rgba(229,83,75,.14);box-shadow:inset 3px 0 0 #e5534b}
.mt-s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
.mt-s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
.mt-s-grey{background:rgba(128,128,128,.08);box-shadow:inset 3px 0 0 #8a8a8a}
.mt-box .mt-n{background:none}
.mt-note{padding:8px 10px;text-align:center;font-style:italic;opacity:.6}
#sds{--sds-line:rgba(128,128,128,.22)}
#sds .sds-mut{opacity:.6}
#sds .sds-ok{color:#3fa24a}#sds .sds-er{color:#e5534b}#sds .sds-am{color:#d9921f}
#sds .sds-sub{opacity:.65;margin:4px 0 0;max-width:120ch}
#sds .mt-band{margin-top:26px;padding:9px 12px}
#sds .mt-band span{font-weight:600}
#sds .mt-box{margin-top:8px}
#sds .sds-lead{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;padding:10px 12px}
#sds .sds-lead p{margin:0;opacity:.65;max-width:95ch;flex:1 1 420px}
#sds .sds-acts{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
#sds .sds-acts input{margin:0}
#sds .sds-status{display:flex;flex-wrap:wrap;gap:6px 18px;align-items:center;padding:9px 12px;border-top:1px solid var(--sds-line)}
#sds .mt-box>.sds-status:first-child,#sds .mt-box>.sds-row:first-child{border-top:0}
#sds .sds-prog{flex:1 1 220px;height:8px;background:rgba(128,128,128,.25);position:relative;min-width:120px}
#sds .sds-prog i{position:absolute;left:0;top:0;bottom:0;background:#4a90e2}
#sds .sds-row{display:grid;gap:10px;align-items:center;padding:9px 12px;border-top:1px solid var(--sds-line)}
#sds .sds-row small{display:block;opacity:.6}
#sds .s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
#sds .s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
#sds .s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
#sds .s-red{background:rgba(229,83,75,.13);box-shadow:inset 3px 0 0 #e5534b}
#sds .s-grey{background:rgba(128,128,128,.07);box-shadow:inset 3px 0 0 #8a8a8a}
#sds .sds-chk{grid-template-columns:22px minmax(0,1fr)}
#sds .sds-ico{font-family:monospace;font-weight:bold;text-align:center}
#sds .sds-ct{grid-template-columns:minmax(0,1fr) 170px}
#sds .sds-pr{grid-template-columns:22px 70px minmax(0,1fr) minmax(140px,24%)}
#sds .sds-pr input{margin:0}
#sds .sds-pr b,#sds .sds-ct b{font-weight:600}
#sds .sds-files{font-family:monospace;font-size:12px;opacity:.65;overflow-wrap:anywhere}
#sds .sds-num{font-family:monospace;text-align:right}
#sds .sds-chip{display:inline-block;font-size:11px;padding:1px 6px;margin-left:6px;background:rgba(128,128,128,.25);font-weight:normal}
#sds .sds-chip.a{background:rgba(217,146,31,.25);color:#d9921f}
#sds .sds-gbar{display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:8px;align-items:center;padding:10px 12px;border-top:1px solid var(--sds-line);cursor:pointer;font-weight:600}
#sds .sds-gbar .c{font-weight:normal;font-size:12px;opacity:.7}
#sds .sds-grp[hidden]{display:none}
#sds .sds-log{max-height:220px;overflow:auto;font-family:monospace;font-size:12px;white-space:pre-wrap;padding:10px 12px;margin:0;opacity:.75}
#sds .sds-final{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;justify-content:space-between;padding:14px 12px}
#sds .sds-final .msg{font-size:15px}
#sds .sds-foot{opacity:.55;font-size:12px;margin:8px 2px 0;max-width:120ch}
#sds input.sds-ghost{color:inherit!important;opacity:.7;border-color:rgba(128,128,128,.45)!important}
#sds input.sds-danger{color:#e5534b!important;border-color:rgba(229,83,75,.7)!important}
@media (max-width:760px){#sds .sds-ct,#sds .sds-pr{grid-template-columns:22px minmax(0,1fr)}#sds .sds-ct>:nth-child(n+2),#sds .sds-pr>:nth-child(n+3){grid-column:2}}
</style>
<div id="sds">
<p class="sds-sub"><?=$sds_t('sd.intro')?></p>

<div class="mt-band"><span><?=$sds_t('sd.h.activity')?></span><b id="sds-aband"></b></div>
<div class="mt-box">
<div class="sds-status" id="sds-astat"><span class="sds-mut"><?=$sds_t('sd.nothing')?></span></div>
<div id="sds-arows"></div>
<div id="sds-alog" style="display:none"><div class="sds-gbar s-grey" data-g="log"><span class="pm">+</span><span><?=$sds_t('sd.log')?></span><span class="c" id="sds-alogc"></span></div><div class="sds-grp" data-g="log" hidden><div class="sds-log" id="sds-rlog"></div></div></div>
</div>

<div class="mt-band"><span>1 &middot; <?=$sds_t('sd.h1')?></span><b id="sds-b1"></b></div>
<div class="mt-box" id="sds-checks"><div class="sds-status sds-mut"><?=$sds_t('sd.checking')?></div></div>

<div class="mt-band"><span>2 &middot; <?=$sds_t('sd.h2')?></span><b id="sds-b2"></b></div>
<div class="mt-box">
<div class="sds-lead"><p><?=$sds_t('sd.s2')?></p><span class="sds-acts"><input type="button" id="sds-stop" value="<?=$sds_t('sd.btn.stop')?>"> <input type="button" id="sds-cancel" class="sds-ghost" value="<?=$sds_t('sd.btn.cancel')?>" style="display:none"> <input type="button" id="sds-start" class="sds-ghost" value="<?=$sds_t('sd.btn.start')?>" style="display:none"></span></div>
<div class="sds-status" id="sds-rmsgrow" style="display:none"><span id="sds-rmsg"></span></div>
<div id="sds-cts"></div>
</div>

<div class="mt-band"><span>3 &middot; <?=$sds_t('sd.h3')?></span><b id="sds-b3"></b></div>
<div class="mt-box">
<div class="sds-lead"><p><?=$sds_t('sd.s3')?></p><span class="sds-acts"><input type="button" id="sds-term" value="<?=$sds_t('sd.btn.term')?>"> <input type="button" id="sds-kill" class="sds-danger" value="<?=$sds_t('sd.btn.kill')?>"> <input type="button" id="sds-refresh" class="sds-ghost" value="<?=$sds_t('sd.btn.refresh')?>"></span></div>
<div class="sds-status" id="sds-kmsgrow" style="display:none"><span id="sds-kmsg"></span></div>
<div id="sds-hold"></div>
</div>

<div class="mt-band"><span>4 &middot; <?=$sds_t('sd.h4')?></span><b><?=$sds_t('sd.h4_sub')?></b></div>
<div class="mt-box">
<div class="sds-final" id="sds-finalrow"><span class="msg" id="sds-final"></span><span class="sds-acts"><input type="button" id="sds-off" value="<?=$sds_t('sd.btn.off')?>"> <input type="button" id="sds-reboot" value="<?=$sds_t('sd.btn.reboot')?>"></span></div>
</div>
<p class="sds-foot"><?=$sds_t('sd.foot')?></p>
<form id="sds-boot" method="POST" action="/webGui/include/Boot.php" target="_top" style="display:none"><input type="hidden" name="cmd" value=""><input type="hidden" name="csrf_token" value="<?=htmlspecialchars($sds_tok, ENT_QUOTES)?>"></form>
</div>

<?=mt_i18n_js($sds_lang, 'sds')?>
<script>
$(function () {
  var T = function (k, v) { return MTL.t('sds', k, v); };
  var URL = '/plugins/sysbox/shutdown.php', S = null, pollT = null, GOPEN = {};
  function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
  function api(op, data) { return $.post(URL, $.extend({op: op}, data || {}), null, 'json'); }
  function err(x) { return (x && x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : (x && x.error) ? x.error : 'HTTP ' + (x && x.status); }
  function free() { return S ? S.holders.filter(function (h) { return !h.protected; }) : []; }
  function dur(s) { s = Math.max(0, Math.round(s)); var m = Math.floor(s / 60); return m ? T('dur.ms', { m: m, s: s % 60 }) : T('dur.s', { s: s }); }
  function hm(t) { var d = new Date(t * 1000); return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }
  function msg(id, cls, t) { $('#' + id).attr('class', cls || '').text(t || ''); $('#' + id + 'row').toggle(!!t); }

  // foldable bars, closed when the page loads
  $(document).on('click', '#sds .sds-gbar', function () { var g = String($(this).data('g')); GOPEN[g] = !GOPEN[g]; $(this).find('.pm').html(GOPEN[g] ? '&minus;' : '+'); $('#sds .sds-grp[data-g="' + g + '"]').prop('hidden', !GOPEN[g]); });

  function draw(r) {
    S = r;
    var run = r.run || {state: 'idle'}, busy = r.running || run.state === 'running', stopped = run.stopped || [];

    // ---- Activity: the last stop or start run of this page
    if (!run.state || run.state === 'idle') {
      $('#sds-aband').text(T('sd.ab_idle'));
      $('#sds-astat').html('<span class="sds-mut">' + esc(T('sd.nothing')) + '</span>');
      $('#sds-arows').empty(); $('#sds-alog').hide();
    } else {
      var start = run.mode === 'start', el = (run.finished || r.now || Math.floor(Date.now() / 1000)) - (run.started || 0);
      var tot = stopped.length + (busy && !start ? r.containers.length : 0), qbRun = busy && !start && r.containers.some(function (c) { return c.qb; });
      var t = {done: T('sd.st.done'), error: T('sd.st.error'), cancelled: T('sd.st.cancelled')}[run.state] || (start ? T('sd.st.starting') : T('sd.st.stopping'));
      var cls = {done: 'sds-ok', error: 'sds-er', cancelled: 'sds-am'}[run.state] || '';
      $('#sds-aband').text(busy ? (start ? T('sd.ab_starting') : T('sd.ab_stopping')) + ' · ' + dur(el) : t.toLowerCase() + ' · ' + hm(run.finished || run.started));
      var h = '<b class="' + cls + '">' + esc(t) + '</b> ';
      if (busy && !start) { h += esc(T('sd.n_of_stopped', { n: stopped.length, tot: tot })); }
      else if (run.msg) { h += '<span class="' + cls + '">' + esc(run.msg) + '</span>'; }
      var back = (!busy && run.back) || [], gone = (!busy && run.gone) || [];
      if (back.length) { h += ' <span class="sds-mut">· ' + esc(T('sd.back', { n: back.length })) + '</span>'; }
      if (gone.length) { h += ' <span class="sds-mut">· ' + esc(T('sd.removed_n', { n: gone.length })) + '</span>'; }
      if ((back.length || gone.length) && !stopped.length) { h += ' <span class="sds-mut">· ' + esc(T('sd.nothing_left')) + '</span>'; }
      $('#sds-astat').html(h + (busy && !start && tot ? '<span class="sds-prog"><i style="width:' + Math.round(stopped.length / tot * 100) + '%"></i></span>' : '') + (qbRun ? '<span class="sds-am">' + esc(T('sd.qb_closing')) + '</span>' : '') + ' <span class="sds-mut">' + dur(el) + '</span>');
      var rows = '';
      if (busy && !start) { $.each(r.containers, function (i, c) { rows += '<div class="sds-row sds-ct s-blue"><div><b>' + esc(c.name) + '</b>' + (c.qb ? '<span class="sds-chip a">' + esc(T('sd.qb_first')) + '</span>' : '') + '</div><span class="sds-am">' + esc(T('sd.stopping_waiting')) + '</span></div>'; }); }
      $.each(stopped, function (i, n) { rows += '<div class="sds-row sds-ct ' + (start && busy ? 's-blue' : 's-green') + '"><div><b>' + esc(n) + '</b></div><span class="' + (start && busy ? 'sds-am">' + esc(T('sd.c_starting')) : 'sds-ok">' + esc(T('sd.c_stopped'))) + '</span></div>'; });
      $.each(gone, function (i, n) { rows += '<div class="sds-row sds-ct s-grey"><div><b>' + esc(n) + '</b></div><span class="sds-mut">' + esc(T('sd.c_removed')) + '</span></div>'; });
      $('#sds-arows').html(rows);
      if (run.log && run.log.length) {
        $('#sds-alog').show(); $('#sds-alogc').text(T('sd.lines', { n: run.log.length }));
        var $l = $('#sds-rlog'); $l.text(run.log.join('\n')); $l[0].scrollTop = $l[0].scrollHeight;
      }
    }

    // ---- 1. checks
    var h1 = '', bad = 0;
    $.each(r.checks, function (i, c) { if (!c.ok) { bad++; } h1 += '<div class="sds-row sds-chk ' + (c.ok ? 's-green' : 's-amber') + '"><span class="sds-ico ' + (c.ok ? 'sds-ok">&#10003;' : 'sds-am">!') + '</span><span>' + esc(c.text) + '</span></div>'; });
    $('#sds-checks').html(h1 || '<div class="sds-status sds-mut">' + esc(T('sd.no_checks')) + '</div>');
    $('#sds-b1').text(bad ? T('sd.n_things', { n: bad }) : T('sd.all_clear'));

    // ---- 2. containers and VMs
    var h2 = '', cts = r.containers.slice().sort(function (a, b) { return (b.qb ? 1 : 0) - (a.qb ? 1 : 0); }); // qBittorrent first: it is stopped first
    $.each(cts, function (i, c) { h2 += '<div class="sds-row sds-ct ' + (busy && run.mode === 'stop' ? 's-blue' : 's-grey') + '"><div><b>' + esc(c.name) + '</b>' + (c.qb ? '<span class="sds-chip a">' + esc(T('sd.qb_first')) + '</span>' : '') + '</div><span' + (busy && run.mode === 'stop' ? ' class="sds-am">' + esc(T('sd.stopping_waiting')) : '>' + esc(T('sd.running'))) + '</span></div>'; });
    $.each(r.vms, function (i, v) { h2 += '<div class="sds-row sds-ct s-grey"><div><b>' + esc(v) + '</b><span class="sds-chip">VM</span></div><span>' + esc(T('sd.running')) + '</span></div>'; });
    $('#sds-cts').html(h2 || '<div class="sds-status sds-ok">' + esc(T('sd.none_running')) + '</div>');
    $('#sds-b2').text(T('sd.n_ctr', { n: r.containers.length }) + ' · ' + (r.vms.length ? T('sd.n_vm', { n: r.vms.length }) : T('sd.no_vm')) + (stopped.length && !busy ? ' · ' + T('sd.n_stopped_here', { n: stopped.length }) : ''));
    $('#sds-stop').prop('disabled', busy || (!r.containers.length && !r.vms.length));
    $('#sds-cancel').toggle(busy && run.mode === 'stop');
    $('#sds-start').toggle(!busy && stopped.length > 0).val(T('sd.btn.start_n', { n: stopped.length }));
    msg('sds-rmsg', {done: 'sds-ok', error: 'sds-er', cancelled: 'sds-am'}[run.state] || '', busy ? (run.mode === 'start' ? T('sd.starting_') : T('sd.stopping_')) : '');

    // ---- 3. processes on the disks
    var h3 = '', np = 0;
    $.each(r.holders, function (i, x) {
      if (x.protected) { np++; }
      var fl = x.protected ? x.files.slice(0, 2) : x.files;
      var files = fl.map(esc).join('<br>') + (x.nfiles > fl.length ? '<br>' + esc(T('sd.more', { n: x.nfiles - fl.length })) : '');
      h3 += '<div class="sds-row sds-pr ' + (x.protected ? 's-grey' : 's-amber') + '">' + (x.protected ? '<span></span>' : '<input type="checkbox" class="sds-k" data-pid="' + x.pid + '" data-start="' + esc(x.start) + '" checked>') + '<span class="sds-num">' + x.pid + '</span><div><b>' + esc(x.comm) + '</b><span class="sds-chip">' + esc(x.user) + '</span><div class="sds-files">' + esc(x.cmd) + '</div><div class="sds-files">' + files + '</div></div><span class="' + (x.protected ? 'sds-mut' : 'sds-am') + '">' + (x.protected ? esc(x.protected) : esc(T('sd.can_stop'))) + '</span></div>';
    });
    $('#sds-hold').html(h3 || '<div class="sds-status sds-ok">' + esc(T('sd.free')) + '</div>');
    $('#sds-b3').text(r.holders.length ? T('sd.n_proc', { n: r.holders.length }) + (np ? ' · ' + T('sd.n_prot', { n: np }) : '') : T('sd.nothing_b'));
    $('#sds-term, #sds-kill').prop('disabled', !free().length || busy);

    // ---- 4. the summary
    var n = free().length, nprot = r.holders.length - n, nc = r.containers.length, ready = !busy && !n && !nc && !r.vms.length;
    var f = busy ? T('sd.f.wait') : ready ? T('sd.f.ready') + (nprot ? ' ' + T('sd.f.prot_left', { n: nprot }) : '') :
      [nc ? T('sd.f.ctr', { n: nc }) : '', r.vms.length ? T('sd.f.vm', { n: r.vms.length }) : '', n ? T('sd.f.proc', { n: n }) : ''].filter(Boolean).join(', ') + '. ' + T('sd.f.hang') + (nprot ? ' ' + T('sd.f.prot_more', { n: nprot }) : '');
    $('#sds-final').attr('class', 'msg ' + (ready ? 'sds-ok' : 'sds-am')).text(f);
    $('#sds-finalrow').removeClass('s-green s-amber').addClass(ready ? 's-green' : 's-amber');
    // not ready: the buttons stay usable (a way out in an emergency) but say so
    $('#sds-off').prop('disabled', busy).val(ready || busy ? T('sd.btn.off') : T('sd.btn.off_any'));
    $('#sds-reboot').prop('disabled', busy).val(ready || busy ? T('sd.btn.reboot') : T('sd.btn.reboot_any'));

    clearTimeout(pollT);
    if (busy) { pollT = setTimeout(load, 2500); }
  }
  function load() {
    api('state').done(draw).fail(function (x) { $('#sds-checks').html('<div class="sds-status sds-er">' + esc(err(x)) + '</div>'); });
  }

  $('#sds-stop').on('click', function () {
    var n = S ? S.containers.length : 0, v = S ? S.vms.length : 0;
    if (!window.confirm(T(v ? 'sd.c.stop_vm' : 'sd.c.stop', { n: n, v: v }))) return;
    $(this).prop('disabled', true);
    api('stop').done(function (r) { if (!r.ok) { msg('sds-rmsg', 'sds-er', r.error); } load(); }).fail(function (x) { msg('sds-rmsg', 'sds-er', err(x)); });
  });
  $('#sds-cancel').on('click', function () { api('cancel').always(load); });
  $('#sds-start').on('click', function () {
    if (!window.confirm(T('sd.c.start'))) return;
    api('start').done(function (r) { if (!r.ok) { msg('sds-rmsg', 'sds-er', r.error); } load(); });
  });
  function kill(sig) {
    var p = [];
    $('.sds-k:checked').each(function () { p.push({pid: $(this).data('pid'), start: String($(this).data('start'))}); });
    if (!p.length) return;
    var txt = sig === 'KILL' ? T('sd.c.kill', { n: p.length }) : T('sd.c.term', { n: p.length });
    if (!window.confirm(txt)) return;
    msg('sds-kmsg', '', '...');
    api('kill', {sig: sig, pids: JSON.stringify(p)}).done(function (r) {
      if (!r.ok) { msg('sds-kmsg', 'sds-er', r.error); return; }
      msg('sds-kmsg', '', (r.done.length ? T('sd.sent', { l: r.done.join(', ') }) + ' ' : '') + (r.skipped.length ? T('sd.not_sent', { l: r.skipped.join(', ') }) + ' ' : '') + T('sd.again5'));
      setTimeout(function () { msg('sds-kmsg', '', ''); load(); }, 5000);
    }).fail(function (x) { msg('sds-kmsg', 'sds-er', err(x)); });
  }
  $('#sds-term').on('click', function () { kill('TERM'); });
  $('#sds-kill').on('click', function () { kill('KILL'); });
  $('#sds-refresh').on('click', load);

  function boot(cmd) {
    var still = [];
    if (S) {
      if (S.containers.length) { still.push(T('sd.n_ctr', { n: S.containers.length }) + ': ' + S.containers.slice(0, 6).map(function (c) { return c.name; }).join(', ') + (S.containers.length > 6 ? ', ...' : '')); }
      if (S.vms.length) { still.push(T('sd.n_vm', { n: S.vms.length }) + ': ' + S.vms.join(', ')); }
      var fr = free(); if (fr.length) { still.push(T('sd.n_proc_disks', { n: fr.length }) + ': ' + fr.slice(0, 4).map(function (h) { return h.comm + ' (' + h.pid + ')'; }).join(', ')); }
    }
    if (!window.confirm(still.length ? T(cmd === 'reboot' ? 'sd.c.reboot_any' : 'sd.c.off_any', { list: '- ' + still.join('\n- ') }) : T(cmd === 'reboot' ? 'sd.c.reboot' : 'sd.c.off'))) return;
    var $f = $('#sds-boot'); $f.find('[name=cmd]').val(cmd); $f[0].submit();
  }
  $('#sds-off').on('click', function () { boot('shutdown'); });
  $('#sds-reboot').on('click', function () { boot('reboot'); });

  load();
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SAFE SHUTDOWN LIBRARY -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/shutdown_lib.php">
<INLINE><![CDATA[<?php
// Sysbox Safe shutdown: what is still using the array and pool disks, and the state of the stop run.
// Used by shutdown.php (web) and shutdown_run.php (background). The shutdown itself is Unraid's own (Boot.php).
require_once __DIR__ . '/lib.php';

// tests only: SX_SD_DIR keeps the state files in that folder, SX_SD_MNT replaces /mnt, SX_SD_VIRSH a fake virsh
$sd_t = getenv('SX_SD_DIR');
define('SD_DIR', ($sd_t !== false && $sd_t !== '') ? rtrim($sd_t, '/') : '/tmp');
unset($sd_t);
define('SD_STATUS', SD_DIR . '/sysbox_shutdown.json');
define('SD_LOCK',   SD_DIR . '/sysbox_shutdown.lock');
define('SD_CANCEL', SD_DIR . '/sysbox_shutdown_cancel');
const SD_QB_WAIT = 300;    // seconds qBittorrent gets to close its files
const SD_CT_WAIT = 60;     // seconds the other containers get
const SD_VM_WAIT = 180;    // seconds the VMs get to shut down

function sd_mnt() { $m = getenv('SX_SD_MNT'); return ($m !== false && $m !== '') ? rtrim($m, '/') : '/mnt'; }

// a path on the array or a pool (not Unassigned Devices or remote shares, which Unraid does not stop with the array)
function sd_watched($p) {
    $b = sd_mnt() . '/';
    if (strpos($p, $b) !== 0) { return false; }
    $first = explode('/', substr($p, strlen($b)), 2)[0];
    return $first !== '' && !in_array($first, ['disks', 'remotes', 'addons', 'rootshare'], true);
}

// processes Unraid stops by itself during the array stop, or that must not be killed by hand
function sd_protect($comm, $cmd, $pid) {
    if ($pid <= 2) { return sx_tr('prot.system'); }
    if (preg_match('/^(emhttpd?|shfs|dockerd|containerd|containerd-shim.*|docker-proxy|runc|libvirtd|virtlogd|virtlockd|qemu-system.*|smbd|nmbd|winbindd|rpc\..*|nfsd.*|mountd)$/', $comm)) { return sx_tr('prot.unraid'); }
    if ($comm === 'mover' || $comm === 'move' || strpos($cmd, '/usr/local/sbin/mover') !== false) { return sx_tr('prot.mover'); }
    if ($comm === 'rsync' && is_file('/tmp/diskbox_balance_status.json') && strpos((string)@file_get_contents('/tmp/diskbox_balance_status.json'), '"running"') !== false) { return sx_tr('prot.balance'); }
    return '';
}

// container id -> name, for the processes that run inside a container
function sd_container_names() {
    $d = sx_docker();
    if ($d === '') { return []; }
    [$rc, $txt] = sx_run(escapeshellarg($d) . " ps --no-trunc --format '{{.ID}} {{.Names}}'", 8);
    $m = [];
    foreach (explode("\n", (string)$txt) as $l) { $x = explode(' ', trim($l), 2); if (count($x) === 2) { $m[$x[0]] = $x[1]; } }
    return $m;
}

// Every process with an open file, working folder or mapped file on the array or a pool.
function sd_holders() {
    $me = getmypid(); $rows = []; $cn = null;
    foreach ((array)glob('/proc/[0-9]*', GLOB_ONLYDIR) as $pd) {
        $pid = (int)basename($pd);
        if ($pid === $me) { continue; }
        $cmd = trim(str_replace("\0", ' ', (string)@file_get_contents("$pd/cmdline")));
        if ($cmd === '') { continue; }   // kernel thread or gone
        $files = [];
        $cwd = @readlink("$pd/cwd");
        if ($cwd !== false && sd_watched($cwd)) { $files[$cwd . ' (working folder)'] = true; }
        foreach ((array)@scandir("$pd/fd") as $fd) {
            if ($fd === '.' || $fd === '..') { continue; }
            $l = @readlink("$pd/fd/$fd");
            if ($l !== false && sd_watched($l)) { $files[$l] = true; }
        }
        foreach ((array)@file("$pd/maps", FILE_IGNORE_NEW_LINES) as $ln) {
            $p = strpos($ln, '/');
            if ($p !== false) { $f = substr($ln, $p); if (sd_watched($f)) { $files[$f] = true; } }
        }
        if (!$files) { continue; }
        $comm = trim((string)@file_get_contents("$pd/comm"));
        $stat = (string)@file_get_contents("$pd/stat");
        $start = '';
        if (($q = strrpos($stat, ')')) !== false) { $f = preg_split('/\s+/', trim(substr($stat, $q + 1))); $start = (string)($f[19] ?? ''); }
        $ct = '';
        if (preg_match('/docker[-\/]([0-9a-f]{64})/', (string)@file_get_contents("$pd/cgroup"), $m)) {
            if ($cn === null) { $cn = sd_container_names(); }
            $ct = $cn[$m[1]] ?? substr($m[1], 0, 12);
        }
        $st = @stat($pd);
        $user = $st ? (function_exists('posix_getpwuid') ? ((posix_getpwuid($st['uid'])['name'] ?? '') ?: (string)$st['uid']) : (string)$st['uid']) : '';
        $prot = $ct !== '' ? sx_tr('prot.ctr', ['c' => $ct]) : sd_protect($comm, $cmd, $pid);
        $fl = array_keys($files); sort($fl);
        $rows[] = ['pid' => $pid, 'start' => $start, 'comm' => $comm, 'cmd' => mb_substr($cmd, 0, 220), 'user' => $user, 'container' => $ct,
                   'files' => array_slice($fl, 0, 6), 'nfiles' => count($fl), 'protected' => $prot];
    }
    usort($rows, function ($a, $b) { return [$a['protected'] !== '', $a['pid']] <=> [$b['protected'] !== '', $b['pid']]; });
    return $rows;
}

function sd_virsh() {
    $v = getenv('SX_SD_VIRSH');
    if ($v !== false && $v !== '') { return $v; }
    return file_exists('/var/run/libvirt/libvirt-sock') ? sx_bin('virsh') : '';
}
function sd_vms() {
    $v = sd_virsh();
    if ($v === '') { return []; }
    [$rc, $txt] = sx_run(escapeshellarg($v) . ' list --name --state-running', 10);
    if ($rc !== 0) { return []; }
    return array_values(array_filter(array_map('trim', explode("\n", (string)$txt)), 'strlen'));
}

// qBittorrent first (it needs the most time to close ~500 torrents' files)
function sd_is_qb($c) { return (bool)preg_match('/qbittorrent/i', $c['name'] . ' ' . $c['image']); }

function sd_running() {
    $f = @fopen(SD_LOCK, 'c');
    if (!$f) { return false; }
    if (flock($f, LOCK_EX | LOCK_NB)) { flock($f, LOCK_UN); fclose($f); return false; }
    fclose($f);
    return true;
}

function sd_status() {
    $s = is_file(SD_STATUS) ? json_decode((string)@file_get_contents(SD_STATUS), true) : null;
    return is_array($s) ? $s : ['state' => 'idle'];
}
function sd_status_write($s) {
    $tmp = SD_STATUS . '.tmp' . getmypid();
    @file_put_contents($tmp, json_encode($s, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
    @rename($tmp, SD_STATUS);
}

// warnings before a shutdown: array state, parity check, mover, Diskbox Balance
function sd_checks() {
    $v = @parse_ini_file('/var/local/emhttp/var.ini');
    $v = is_array($v) ? $v : [];
    $w = [];
    $w[] = ['k' => 'array', 'ok' => true, 'text' => sx_tr('chk.array', ['s' => ($v['mdState'] ?? '?'), 't' => ($v['shutdownTimeout'] ?? '?')])];
    if ((float)($v['mdResync'] ?? 0) > 0) {
        $pct = (float)($v['mdResync'] ?? 0) > 0 ? round((float)($v['mdResyncPos'] ?? 0) / (float)$v['mdResync'] * 100, 1) : 0;
        $w[] = ['k' => 'parity', 'ok' => false, 'text' => sx_tr('chk.parity', ['p' => $pct])];
    }
    if (trim((string)@shell_exec('pgrep -x mover 2>/dev/null')) !== '') { $w[] = ['k' => 'mover', 'ok' => false, 'text' => sx_tr('chk.mover')]; }
    $bl = is_file('/tmp/diskbox_balance.lock') ? @fopen('/tmp/diskbox_balance.lock', 'r') : false;
    if ($bl) {
        if (!flock($bl, LOCK_EX | LOCK_NB)) { $w[] = ['k' => 'balance', 'ok' => false, 'text' => sx_tr('chk.balance')]; }
        else { flock($bl, LOCK_UN); }
        fclose($bl);
    }
    return $w;
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SAFE SHUTDOWN ENDPOINT -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/shutdown.php">
<INLINE><![CDATA[<?php
// Web endpoint of Safe shutdown. POST op=state|stop|start|cancel|kill
// The shutdown or restart itself is not here: the page posts to Unraid's own /webGui/include/Boot.php.
require_once __DIR__ . '/shutdown_lib.php';

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { sx_json(['ok' => false, 'error' => 'method'], 405); }
sx_guard();
$op = (string)($_POST['op'] ?? 'state');

function sd_spawn($mode) {
    @exec('setsid nohup ' . escapeshellarg(sx_php()) . ' ' . escapeshellarg(__DIR__ . '/shutdown_run.php') . ' ' . $mode . ' >/dev/null 2>&1 &');
}

// The stopped list of the last run, compared with Docker now: a container started again outside this page (Unraid's
// autostart after an array restart, the Docker page) or removed since then is not offered for Start them again.
function sd_prune($run, $all) {
    if (!$all || ($run['state'] ?? '') === 'running' || empty($run['stopped'])) { return $run; }   // no Docker answer: keep the list
    $keep = []; $back = []; $gone = [];
    foreach ((array)$run['stopped'] as $n) {
        $st = $all[$n]['state'] ?? null;
        if ($st === null) { $gone[] = $n; } elseif ($st === 'running') { $back[] = $n; } else { $keep[] = $n; }
    }
    $run['stopped'] = $keep; $run['back'] = $back; $run['gone'] = $gone;
    return $run;
}

if ($op === 'state') {
    $run = sd_status();
    $running = sd_running();
    if (!$running && ($run['state'] ?? '') === 'running' && time() - (int)($run['started'] ?? 0) > 20) { $run['state'] = 'error'; $run['msg'] = sx_tr('sdb.died'); }
    $all = sx_ps(true);
    if (!$running) { $run = sd_prune($run, $all); }
    $cts = [];
    foreach ($all as $c) { if ($c['state'] === 'running') { $cts[] = ['name' => $c['name'], 'qb' => sd_is_qb($c)]; } }
    sx_json(['ok' => true, 'checks' => sd_checks(), 'containers' => $cts, 'vms' => sd_vms(), 'holders' => sd_holders(), 'run' => $run, 'running' => $running, 'now' => time()]);
}

if ($op === 'stop' || $op === 'start') {
    if (sd_running()) { sx_json(['ok' => false, 'error' => sx_tr('sdb.busy')]); }
    $prev = $op === 'start' ? sd_prune(sd_status(), sx_ps(true)) : sd_status();
    if ($op === 'start' && !($prev['stopped'] ?? [])) { sx_json(['ok' => false, 'error' => sx_tr('sdb.nothing')]); }
    sd_status_write(['state' => 'running', 'mode' => $op, 'started' => time(), 'log' => ['starting...'], 'stopped' => (array)($prev['stopped'] ?? []), 'vms' => [], 'msg' => '']);
    sd_spawn($op);
    sx_json(['ok' => true]);
}

if ($op === 'cancel') {
    if (sd_running()) { @file_put_contents(SD_CANCEL, '1'); }
    sx_json(['ok' => true]);
}

// End processes that still use the disks. Only processes that are in a fresh scan, with the same start time as shown on
// the page (so a reused process id is never hit) and that are not protected. TERM asks them to quit, KILL forces it.
if ($op === 'kill') {
    $sig = (string)($_POST['sig'] ?? '');
    if (!in_array($sig, ['TERM', 'KILL'], true)) { sx_json(['ok' => false, 'error' => 'unknown signal'], 400); }
    $want = json_decode((string)($_POST['pids'] ?? ''), true);
    if (!is_array($want) || !$want) { sx_json(['ok' => false, 'error' => sx_tr('sdb.none_sel')], 400); }
    $now = [];
    foreach (sd_holders() as $h) { $now[$h['pid']] = $h; }
    $done = []; $skip = [];
    foreach ($want as $w) {
        $pid = (int)($w['pid'] ?? 0); $start = (string)($w['start'] ?? '');
        $h = $now[$pid] ?? null;
        if (!$h) { $skip[] = $pid . ' (no longer uses the disks)'; continue; }
        if ($h['start'] !== $start) { $skip[] = $pid . ' (a different process now)'; continue; }
        if ($h['protected'] !== '') { $skip[] = $pid . ' (' . $h['protected'] . ')'; continue; }
        $ok = function_exists('posix_kill') ? posix_kill($pid, $sig === 'KILL' ? 9 : 15) : (sx_run('kill -' . $sig . ' ' . $pid, 5)[0] === 0);
        if ($ok) { $done[] = $pid . ' ' . $h['comm']; } else { $skip[] = $pid . ' (the signal failed)'; }
    }
    @exec('logger -t sysbox ' . escapeshellarg('Safe shutdown: ' . $sig . ' sent to ' . (implode(', ', $done) ?: 'nothing')));
    sx_json(['ok' => true, 'done' => $done, 'skipped' => $skip]);
}

sx_json(['ok' => false, 'error' => 'unknown action'], 400);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SAFE SHUTDOWN WORKER -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/shutdown_run.php">
<INLINE><![CDATA[<?php
// Background worker of Safe shutdown (started by shutdown.php):
//   php shutdown_run.php stop    stop the running containers (qBittorrent first, with a long wait) and the VMs
//   php shutdown_run.php start   start again the containers the stop run stopped (if you change your mind)
// It never shuts the server down: that is a separate button that calls Unraid's own shutdown.
if (PHP_SAPI !== 'cli') { exit(1); }
require_once __DIR__ . '/shutdown_lib.php';
@set_time_limit(0);
$mode = $argv[1] ?? '';
if (!in_array($mode, ['stop', 'start'], true)) { exit(1); }

$lock = @fopen(SD_LOCK, 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }
@unlink(SD_CANCEL);

$prev = sd_status();
$S = ['state' => 'running', 'mode' => $mode, 'started' => time(), 'finished' => 0, 'log' => [], 'stopped' => [], 'vms' => [], 'msg' => ''];
if ($mode === 'start') { $S['stopped'] = (array)($prev['stopped'] ?? []); }
function sd_log($m) {
    global $S;
    $S['log'][] = date('H:i:s') . ' ' . $m;
    sd_status_write($S);
}
function sd_mark_userstop($names) {   // so the Sysbox Discord alerts do not report these stops
    $f = '/tmp/sysbox_userstop.json';
    if (getenv('SX_SD_DIR')) { $f = SD_DIR . '/sysbox_userstop.json'; }
    $mk = is_file($f) ? (json_decode((string)@file_get_contents($f), true) ?: []) : [];
    foreach ($names as $n) { $mk[$n] = time(); }
    @file_put_contents($f, json_encode($mk));
}
function sd_cancelled() { return is_file(SD_CANCEL); }

$d = sx_docker();

if ($mode === 'start') {
    $names = array_values(array_filter($S['stopped'], 'sx_valid_name'));
    if ($d === '' || !$names) { $S['state'] = 'done'; $S['msg'] = sx_tr('sdr.nothing'); $S['finished'] = time(); sd_status_write($S); exit(0); }
    sd_log('starting ' . count($names) . ' container(s) again');
    $failed = [];
    foreach ($names as $n) {
        [$rc, $out] = sx_run(escapeshellarg($d) . ' start ' . escapeshellarg($n), 90);
        sd_log(($rc === 0 ? 'started ' : 'FAILED to start ') . $n . ($rc === 0 ? '' : ': ' . substr(trim($out), 0, 200)));
        if ($rc !== 0) { $failed[] = $n; }
    }
    @unlink('/tmp/sysbox_ps.json');
    $S['stopped'] = $failed;
    $S['state'] = $failed ? 'error' : 'done';
    $S['msg'] = $failed ? sx_tr('sdr.failed', ['l' => implode(', ', $failed)]) : sx_tr('sdr.started');
    $S['finished'] = time(); sd_status_write($S);
    exit(0);
}

// ---- stop -----------------------------------------------------------------------------------------
sd_log('start');
$cts = [];
if ($d !== '') { foreach (sx_ps(true) as $c) { if ($c['state'] === 'running') { $cts[] = $c; } } }
$qb = array_values(array_filter($cts, 'sd_is_qb'));
$rest = array_values(array_filter($cts, function ($c) { return !sd_is_qb($c); }));
$err = [];

foreach ($qb as $c) {
    if (sd_cancelled()) { break; }
    sd_log('stopping ' . $c['name'] . ' (it may take up to ' . SD_QB_WAIT . ' s to close its files)');
    sd_mark_userstop([$c['name']]);
    $t0 = time();
    [$rc, $out] = sx_run(escapeshellarg($d) . ' stop -t ' . SD_QB_WAIT . ' ' . escapeshellarg($c['name']), SD_QB_WAIT + 30);
    if ($rc === 0) { $S['stopped'][] = $c['name']; sd_log('stopped ' . $c['name'] . ' in ' . (time() - $t0) . ' s'); }
    else { $err[] = $c['name']; sd_log('FAILED to stop ' . $c['name'] . ': ' . substr(trim($out), 0, 200)); }
}
if ($rest && !sd_cancelled()) {
    $names = array_column($rest, 'name');
    sd_log('stopping ' . count($names) . ' other container(s) together: ' . implode(', ', $names));
    sd_mark_userstop($names);
    $t0 = time();
    [$rc, $out] = sx_run(escapeshellarg($d) . ' stop -t ' . SD_CT_WAIT . ' ' . implode(' ', array_map('escapeshellarg', $names)), SD_CT_WAIT + 60);
    $now = sx_ps(true);
    foreach ($names as $n) {
        if (($now[$n]['state'] ?? '') !== 'running') { $S['stopped'][] = $n; }
        else { $err[] = $n; sd_log('still running: ' . $n); }
    }
    sd_log('containers stopped in ' . (time() - $t0) . ' s');
}
@unlink('/tmp/sysbox_ps.json');

$vms = sd_cancelled() ? [] : sd_vms();
if ($vms) {
    $v = sd_virsh();
    foreach ($vms as $vm) { sd_log('shutting down the VM ' . $vm); sx_run(escapeshellarg($v) . ' shutdown ' . escapeshellarg($vm), 20); }
    $t0 = time();
    while (time() - $t0 < SD_VM_WAIT && !sd_cancelled()) {
        $left = array_intersect($vms, sd_vms());
        if (!$left) { break; }
        sleep(5);
    }
    $left = array_values(array_intersect($vms, sd_vms()));
    foreach ($vms as $vm) { if (!in_array($vm, $left, true)) { $S['vms'][] = $vm; } }
    if ($left) { $err[] = 'VM ' . implode(', ', $left); sd_log('VM(s) still running after ' . SD_VM_WAIT . ' s: ' . implode(', ', $left) . ' (Unraid will force them off during the shutdown)'); }
    else { sd_log('VM(s) shut down: ' . implode(', ', $vms)); }
}

$S['finished'] = time();
if (sd_cancelled()) { $S['state'] = 'cancelled'; $S['msg'] = sx_tr('sdr.cancelled'); }
elseif ($err) { $S['state'] = 'error'; $S['msg'] = sx_tr('sdr.not_stopped', ['l' => implode(', ', $err)]); }
else { $S['state'] = 'done'; $S['msg'] = $S['vms'] ? sx_tr('sdr.done_vm', ['n' => count($S['stopped']), 'v' => count($S['vms'])]) : sx_tr('sdr.done', ['n' => count($S['stopped'])]); }
sd_log($S['msg']);
@unlink(SD_CANCEL);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- CLAUDE HEADER BUTTON -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/ClaudeButton.page">
<INLINE><![CDATA[Menu="Buttons:3b"
Cond="is_file('/tmp/sysbox_claude_ct')"
Title="Claude"
Icon="fa-comments"
---
<?PHP
/* Sysbox: the Claude button in the header, next to the terminal. One click starts the claude container, the tmux session and
   Claude Code with Remote Control when they are not running yet, and opens the session on claude.ai in a new tab. */
$cl_var = @parse_ini_file('/var/local/emhttp/var.ini');
$cl_tok = is_array($cl_var) ? (string)($cl_var['csrf_token'] ?? '') : '';
// texts from the dictionary (lang/en.json, see i18n.php): only the cl. keys, this button is on every page
require_once '/usr/local/emhttp/plugins/sysbox/i18n.php';
echo mt_i18n_js('/usr/local/emhttp/plugins/sysbox/lang', 'sxcl', ['cl.']);
?>
<script>
function ClaudeButton() {
  var T = function (k, v) { return MTL.t('sxcl', k, v); };
  // the tab is opened right away (a popup blocker allows it only during the click) and shows the progress
  var w = window.open('', '_blank');
  function say(t) { try { if (w && w.document) { w.document.title = 'Claude'; w.document.body.style.cssText = 'background:#141414;color:#e8e8e8;font:15px/1.5 system-ui,sans-serif;padding:40px'; w.document.body.textContent = t; } } catch (e) {} }
  say(T('cl.starting', { host: <?=json_encode((string)gethostname())?> }));
  $.post('/plugins/sysbox/claude.php', {op: 'open', csrf_token: '<?=htmlspecialchars($cl_tok, ENT_QUOTES)?>'}, null, 'json').done(function (r) {
    if (!r.ok) { say(T('cl.failed', { e: r.error })); return; }
    if (w) { w.location.href = r.url; } else { window.open(r.url, '_blank'); }
  }).fail(function (x) { say(T('cl.failed', { e: 'HTTP ' + (x && x.status) })); });
}
// Tooltip with the plan usage (item 62): asked when the page loads and again on hover when it is older than a minute
(function () {
  var T = function (k, v) { return window.MTL ? MTL.t('sxcl', k, v) : k; };
  var got = 0, busy = false, base = T('cl.base');
  function btn() { return $('[onclick*="ClaudeButton"]'); }
  function ago(s) { s = Math.max(0, Math.round(s / 60)); return s < 1 ? T('cl.just_now') : s < 60 ? T('cl.min_ago', { m: s }) : s < 1440 ? T('cl.hm_ago', { h: Math.floor(s / 60), m: s % 60 }) : T('cl.d_ago', { d: Math.floor(s / 1440) }); }
  function left(s) { s = Math.max(0, Math.round(s / 60)); var d = Math.floor(s / 1440), h = Math.floor(s % 1440 / 60); return d ? T('cl.dh', { d: d, h: h }) : h ? T('cl.hm', { h: h, m: s % 60 }) : T('cl.m', { m: s % 60 }); }
  function pct(v) { return (Math.round(v * 10) / 10).toString() + '%'; }
  function when(ts) { var d = new Date(ts * 1000); return T('cl.dow.' + ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'][d.getDay()]) + ' ' + ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2); }
  function text(r) {
    if (!r || !r.ok) { return base + '\n' + ((r && r.error) || T('cl.no_usage')); }
    var t = [base];
    if (r.expired) { t.push(T('cl.week_new', { t: when(r.reset) })); }
    else {
      t.push(T('cl.week', { p: pct(r.week), t: when(r.reset), left: left(r.reset - r.now) }));
      t.push(T('cl.today', { v: r.today === null ? T('cl.from_tomorrow') : pct(r.today) }));
      t.push(T('cl.avg', { p: pct(r.avg), q: pct(r.quota) }));
    }
    if (r.five) { t.push(T('cl.five', { p: pct(r.five.pct), left: left(r.five.reset - r.now) })); }
    t.push(T('cl.updated', { t: ago(r.now - r.seen) }));
    return t.join('\n');
  }
  function load() {
    if (busy || Date.now() - got < 60000) { return; }
    busy = true;
    $.post('/plugins/sysbox/claude.php', {op: 'usage', csrf_token: '<?=htmlspecialchars($cl_tok, ENT_QUOTES)?>'}, null, 'json')
      .done(function (r) { got = Date.now(); btn().attr('title', text(r)); })
      .always(function () { busy = false; });
  }
  function start() { load(); $(document).on('mouseenter', '[onclick*="ClaudeButton"]', load); }
  if (window.jQuery) { $(start); } else { document.addEventListener('DOMContentLoaded', start); }
})();
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- CLAUDE BUTTON ENDPOINT -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/claude.php">
<INLINE><![CDATA[<?php
// Web endpoint of the Claude button in the Unraid header (ClaudeButton.page). POST op=open:
// starts the claude container if it is stopped, starts Claude Code with Remote Control in the tmux session 'main' if it is not
// running there yet (claude --continue: the last conversation goes on), and returns the address of the session on claude.ai.
// Nothing is stopped or changed in a running session. Only fixed commands, no input from the request reaches the shell.
require_once __DIR__ . '/lib.php';

const CL_CONTAINER = 'claude';
const CL_USER      = 'claude';
const CL_HOME      = '/home/claude';
const CL_DIR       = '/work/unraid-mediaserver-tools';
const CL_TMUX      = 'main';
const CL_HOME_URL  = 'https://claude.ai/code';

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { sx_json(['ok' => false, 'error' => 'method'], 405); }
sx_guard();

// Plan usage for the button's tooltip (op=usage, item 62): the status line script in the container (tools/claude_statusline.sh)
// writes ~/usage/hist.log (a line per change: time, 7-day %, its reset, 5-hour %, its reset) and touches ~/usage/seen.
// Read-only: the files are found through the container's /home/claude mount and only read here.
function cl_usage_dir($d) {
    $src = trim((string)@shell_exec(escapeshellarg($d) . ' inspect -f ' . escapeshellarg('{{range .Mounts}}{{if eq .Destination "' . CL_HOME . '"}}{{.Source}}{{end}}{{end}}') . ' ' . CL_CONTAINER . ' 2>/dev/null'));
    return $src !== '' ? $src . '/usage' : '';
}
function cl_usage($dir, $now) {
    $rows = [];
    foreach ((@file($dir . '/hist.log', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: []) as $l) {
        $p = preg_split('/\s+/', trim($l));
        if (count($p) >= 3 && is_numeric($p[0]) && is_numeric($p[1]) && is_numeric($p[2])) {
            $rows[] = [(int)$p[0], (float)$p[1], (int)$p[2], isset($p[3]) && is_numeric($p[3]) ? (float)$p[3] : null, isset($p[4]) && is_numeric($p[4]) ? (int)$p[4] : null];
        }
    }
    if (!$rows) { return null; }
    $last = end($rows);
    $seen = max($last[0], (int)@filemtime($dir . '/seen'));
    $week = $last[1]; $reset = $last[2]; $start = $reset - 7 * 86400;
    // today: the rises since local midnight; a new weekly window counts from 0. Unknown when the first sample of the day
    // has no earlier sample of the same window to compare with (the first day of logging).
    $mid = strtotime('today', $now); $today = 0.0; $known = true; $prev = null;
    foreach ($rows as $r) {
        if ($r[0] <= $mid) { $prev = $r; continue; }
        if ($prev !== null && $prev[2] === $r[2]) { $today += max(0, $r[1] - $prev[1]); }
        elseif ($r[2] - 7 * 86400 >= $mid - 60) { $today += $r[1]; }   // the window started today
        else { $known = false; }
        $prev = $r;
    }
    $days = max(1, (min($now, $reset) - $start) / 86400);
    $five = ($last[3] !== null && $last[4] !== null && $last[4] > $now) ? ['pct' => $last[3], 'reset' => $last[4]] : null;
    return ['week' => $week, 'reset' => $reset, 'expired' => $now >= $reset, 'today' => $known ? round($today, 1) : null,
            'avg' => round($week / $days, 1), 'quota' => round(100 / 7, 1), 'seen' => $seen, 'five' => $five, 'now' => $now];
}
if (($_POST['op'] ?? '') === 'usage') {
    $d = sx_docker();
    $dir = $d !== '' ? cl_usage_dir($d) : '';
    $u = $dir !== '' ? cl_usage($dir, time()) : null;
    sx_json($u ? ['ok' => true] + $u : ['ok' => false, 'error' => sx_tr('cl.e_nodata')]);
}

function cl_run($cmd, &$rc = null) { $o = []; @exec($cmd . ' 2>&1', $o, $rc); return trim(implode("\n", $o)); }
function cl_exec($d, $args, &$rc = null) {
    return cl_run(escapeshellarg($d) . ' exec -u ' . CL_USER . ' -e HOME=' . CL_HOME . ' -w ' . escapeshellarg(CL_DIR) . ' ' . CL_CONTAINER . ' ' . $args, $rc);
}
// the last claude.ai session address the terminal printed (Remote Control prints it when it starts)
function cl_url($d) {
    $t = cl_exec($d, 'tmux capture-pane -p -J -S -3000 -t ' . CL_TMUX);
    return preg_match_all('#https://claude\.ai/code[A-Za-z0-9/_\-?=&.%]*#', $t, $m) ? end($m[0]) : '';
}

$d = sx_docker();
if ($d === '') { sx_json(['ok' => false, 'error' => sx_tr('cl.e_docker')]); }
$host = preg_replace('/[^A-Za-z0-9_.\-]/', '', (string)gethostname()) ?: 'unraid';
$steps = [];

// 1. the container
$st = cl_run(escapeshellarg($d) . ' inspect -f {{.State.Running}} ' . CL_CONTAINER, $rc);
if ($rc !== 0) { sx_json(['ok' => false, 'error' => sx_tr('cl.e_noct', ['c' => CL_CONTAINER])]); }
if ($st !== 'true') {
    cl_run(escapeshellarg($d) . ' start ' . CL_CONTAINER, $rc);
    if ($rc !== 0) { sx_json(['ok' => false, 'error' => sx_tr('cl.e_nostart', ['c' => CL_CONTAINER])]); }
    for ($i = 0; $i < 20 && cl_run(escapeshellarg($d) . ' inspect -f {{.State.Running}} ' . CL_CONTAINER) !== 'true'; $i++) { sleep(1); }
    $steps[] = 'container started';
}

// 2. the tmux session and Claude Code in it
$cmd = 'claude --continue --remote-control ' . $host;
cl_exec($d, 'tmux has-session -t ' . CL_TMUX, $rc);
if ($rc !== 0) {
    cl_exec($d, 'tmux new-session -d -s ' . CL_TMUX . ' ' . escapeshellarg($cmd), $rc);
    if ($rc !== 0) { sx_json(['ok' => false, 'error' => sx_tr('cl.e_tmux')]); }
    $steps[] = 'Claude started with Remote Control';
} else {
    $cur = cl_exec($d, 'tmux display-message -p -t ' . CL_TMUX . ' ' . escapeshellarg('#{pane_current_command}'));
    if (stripos($cur, 'claude') === false) {
        // the session is there but Claude is not running in it (a plain shell): start it in the repo folder. The container's
        // own session starts in /work, and there --continue finds no conversation and the folder trust question waits for a key.
        cl_exec($d, 'tmux send-keys -t ' . CL_TMUX . ' ' . escapeshellarg('cd ' . CL_DIR . ' && ' . $cmd) . ' Enter');
        $steps[] = 'Claude started with Remote Control in the existing session';
    }
}

// 3. the address: Remote Control prints it within a few seconds after a start
$url = cl_url($d);
for ($i = 0; $steps && $url === '' && $i < 15; $i++) { sleep(1); $url = cl_url($d); }
sx_json(['ok' => true, 'url' => $url !== '' ? $url : CL_HOME_URL, 'exact' => $url !== '',
         'msg' => $steps ? implode(', ', $steps) : 'Claude is already running']);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SNAPSHOTS PAGE -->
