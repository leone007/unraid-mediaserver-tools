  "note": "confirmation text before the suggested self-test."
 },
 "sug.c_check": {
  "text": "Check for updates now? It only reads (image registries, release notes).",
  "note": "confirmation text before the suggested Check now."
 },
 "sug.c_sbx_dismiss": {
