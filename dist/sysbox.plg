#gdm .gdm-hint{flex:1 1 100%;opacity:.55;font-size:12px}
#gdm .gdm-dis{opacity:.55}
#gdm .gdm-form{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px 12px;align-items:flex-end;border:1px solid rgba(154,125,230,.5);background:rgba(154,125,230,.08);padding:8px 10px}
#gdm .gdm-form label{display:flex;flex-direction:column;gap:3px;font-size:12px;opacity:.85;flex:1 1 240px;min-width:0}
#gdm .gdm-form input[type=text]{margin:0;width:100%}
#gdm .gdm-conf{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;background:rgba(229,83,75,.08);box-shadow:inset 3px 0 0 #e5534b;padding:8px 10px}
#gdm .gdm-conf span{flex:1 1 260px;white-space:normal}
#gdm .gdm-acts.gdm-row2{flex-direction:row;flex-wrap:wrap;justify-content:flex-end}
@media (max-width:860px){#gdm .gdm-it{grid-template-columns:1fr}#gdm .gdm-acts{align-items:flex-start;flex-direction:row;flex-wrap:wrap}#gdm .gdm-set{grid-template-columns:1fr}}
</style>
<div id="gdm">
