#gdm .mt-band.gdm-b-amber span{color:#d9921f}#gdm .mt-band.gdm-b-purple span{color:#9a7de6}#gdm .mt-band.gdm-b-red span{color:#e5534b}
#gdm .mt-box{margin-top:8px}
