#gdm .gdm-chip.g{background:rgba(63,162,74,.22);color:#7fd08a}#gdm .gdm-chip.a{background:rgba(217,146,31,.25);color:#f0b85a}
#gdm .gdm-chip.r{background:rgba(229,83,75,.25);color:#ff8a83}#gdm .gdm-chip.b{background:rgba(74,144,226,.25);color:#8fbdf0}#gdm .gdm-chip.p{background:rgba(150,120,230,.25);color:#c3b0ff}
#gdm .gdm-cmd{display:flex;gap:8px;align-items:center;font-family:monospace;font-size:12px;background:rgba(0,0,0,.35);padding:4px 8px;margin-top:6px;overflow-x:auto;white-space:nowrap}
#gdm .gdm-cmd span{flex:1;min-width:0}
#gdm input.gdm-ghost{color:inherit!important;opacity:.75;border-color:rgba(128,128,128,.45)!important}
