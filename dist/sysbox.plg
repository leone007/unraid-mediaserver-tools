#gdm a.gdm-link{font-size:12px;white-space:nowrap}
#gdm .gdm-gbar{display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:8px;align-items:center;padding:10px 12px;border-top:1px solid var(--gdm-line);cursor:pointer;font-weight:600}
#gdm .gdm-gbar .c{font-weight:normal;font-size:12px;opacity:.7}
#gdm .gdm-grp[hidden]{display:none}
#gdm .gdm-lead{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;padding:10px 12px}
