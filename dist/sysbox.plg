<FILE Name="&plugdir;/SysboxSettings.page">
<INLINE><![CDATA[Menu="Utilities"
Type="xmenu"
Title="Sysbox"
Icon="sysbox.png"
Markdown="false"
---
<?PHP
require_once '/usr/local/emhttp/plugins/sysbox/lib.php';
$sx = sx_cfg();
$sx_ps = sx_ps(true);
$sx_sel = array_filter(array_map('trim', explode(',', (string)$sx['sel'])));
$sx_var = @parse_ini_file('/var/local/emhttp/var.ini');
$sx_tok = is_array($sx_var) ? (string)($sx_var['csrf_token'] ?? '') : '';
if (!function_exists('sx_h')) {
  function sx_h($v) { return htmlspecialchars((string)$v, ENT_QUOTES); }
}
if (!function_exists('sx_chk')) {
  function sx_chk($v) { return sx_on($v) ? 'checked' : ''; }
}
?>
<style>
/* Shared settings-page look (the owner's design rule, 2026-10-10): a dark band per part (the h3), the rows in a box, the label on the
   left, the controls of one setting on one line, the explanation as a quiet line under them. Scoped to a form with class "uset".
   The builds copy this block into each settings page where the marker below stands. Unraid 7 lays every dd out as a flex column:
   overridden here for these forms only. */
.uset h3{display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(0,0,0,.25);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:9px 12px;margin:26px 0 8px;line-height:1.4}
.uset h3:first-child{margin-top:6px}
.uset h3 small{font-weight:400;opacity:.55;text-transform:none;letter-spacing:0}
.uset dl{display:grid;grid-template-columns:minmax(200px,300px) minmax(0,1fr);gap:0;margin:0;padding:0;background:rgba(128,128,128,.12)}
.uset dl dt,.uset dl dd{float:none;width:auto;margin:0;padding:9px 12px;border-top:1px solid rgba(128,128,128,.22);text-align:left;line-height:1.5}
.uset dl dt{opacity:.75;font-weight:normal}
.uset dl dt:first-child,.uset dl dt:first-child+dd{border-top:0}
.uset dl dd{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px 12px}
.uset dl dd>[class*="-mut"],.uset dl dd>.uset-hint,.uset dl dd>.uset-brk,.uset dl dd>div,.uset dl dd>p{flex:1 1 100%;margin:0}
.uset dl dd>[class*="-mut"],.uset dl dd>.uset-hint{opacity:.55;font-size:12px;max-width:120ch}
.uset dl dd>.uset-brk{height:0}
.uset dd input,.uset dd select,.uset dd textarea{margin:0;max-width:100%}
.uset dd select{width:auto!important;min-width:110px}
.uset dd input.narrow{width:110px!important;min-width:0}
.uset dd input[type=checkbox]{width:auto!important;margin:0 4px 0 0}
.uset dd label{display:inline-flex;align-items:center;gap:4px}
.uset dd input[type=button]{margin:0}
.uset dl.uset-save{background:none;margin-top:14px}
.uset dl.uset-save dt,.uset dl.uset-save dd{border-top:0}
.uset .uset-ok{color:#3fa24a}.uset .uset-er{color:#e5534b}
@media (max-width:760px){.uset dl{grid-template-columns:1fr}.uset dl dd{border-top:0;padding-top:0}}
#sx-blocks .sx-blk+.sx-blk{border-top:1px solid rgba(128,128,128,.22)}
#sx-blocks dt{display:flex;align-items:center;justify-content:space-between;gap:8px;opacity:1}
#sx-blocks .sx-sw{display:inline-flex;align-items:center;gap:6px;font-weight:600}
#sx-blocks .sx-blk.off dd{opacity:.4}
.sx-mv a{display:inline-block;width:20px;text-align:center;opacity:.55;font-size:10px;color:inherit;text-decoration:none}
#sx-blocks select{min-width:0!important;width:auto!important}
.sx-mv a:hover{opacity:1}
.sx-chip{display:inline-flex!important;align-items:center;gap:5px;padding:2px 9px;border-radius:12px;border:1px solid rgba(128,128,128,.35);cursor:pointer}
.sx-chip input[type=checkbox]{margin:0!important}
.sx-attn-note{opacity:.55;font-size:12px;margin:6px 0 0}
</style>
<form id="sx-form" class="uset" method="POST" action="/plugins/sysbox/save.php" onsubmit="return false;">
<input type="hidden" name="csrf_token" value="<?=sx_h($sx_tok)?>">

<h3>Dashboard tile <small>switch a part off, choose what it shows; the arrows change the order</small></h3>
<input type="hidden" name="order" id="sx-order" value="<?=sx_h(implode(',', sx_order($sx)))?>">
<div id="sx-blocks">
<?php
$sx_secs = ['1', '2', '5', '10'];
if (!function_exists('sx_sel_opts')) {
  function sx_sel_opts($cur, $opts) { $o = ''; foreach ($opts as $v) { $o .= '<option value="' . $v . '"' . ((string)$cur === $v ? ' selected' : '') . '>' . $v . '</option>'; } return $o; }
}
$sx_blk = [
  'ram' => ['RAM', 'show_ram', [['ram_leg', 'breakdown (System, ZFS cache, Docker, Free)']], ''],
  'sto' => ['Storage', 'show_sto', [], 'boot drive, log and Docker vdisk; the limits are below'],
  'cpu' => ['CPU', 'show_cpu', [['cpu_load', 'Load (total)'], ['cpu_temp', 'Temperature'], ['cpu_pow', 'Package power'], ['show_clock', 'Clock'], ['cpu_hist', 'History graph'], ['cpu_per', 'Per thread'], ['cpu_la', 'Load average (footer)']], ''],
  'gpu' => ['GPU', 'show_gpu', [], 'Intel Quick Sync (intel_gpu_top): video and render load'],
  'pow' => ['Power', 'show_pow', [['pow_w', 'Wall (W)'], ['pow_day', 'Today (kWh)'], ['pow_mon', 'This month (kWh)'], ['pow_cost', 'Cost'], ['pow_name', 'Socket name']], 'Today counts from midnight with the socket\'s own energy counter. The socket address and the price are under Smart socket below. UPS figures need a UPS data cable; Unraid sees no UPS now.'],
  'con' => ['Containers', 'show_containers', [], 'which ones, rows, buttons and logs: in the Containers band below'],
];
foreach (sx_order($sx) as $sx_k):
  $sx_b = $sx_blk[$sx_k];
?>
<dl class="sx-blk" data-k="<?=$sx_k?>">
<dt><label class="sx-sw"><input type="hidden" name="<?=$sx_b[1]?>" value="0"><input type="checkbox" name="<?=$sx_b[1]?>" value="1" <?=sx_chk($sx[$sx_b[1]])?>> <?=$sx_b[0]?></label>
<span class="sx-mv"><a href="#" class="up" title="Move up">&#9650;</a><a href="#" class="dn" title="Move down">&#9660;</a></span></dt>
<dd>
<?php foreach ($sx_b[2] as $sx_c): ?>
  <label class="sx-chip"><input type="hidden" name="<?=$sx_c[0]?>" value="0"><input type="checkbox" name="<?=$sx_c[0]?>" value="1" <?=sx_chk($sx[$sx_c[0]])?>><?=$sx_c[1]?></label>
<?php endforeach; ?>
<?php if ($sx_k === 'cpu'): ?>
  <span class="uset-brk"></span>
  graph <input type="number" name="hist_min" min="1" max="60" class="narrow" style="width:60px!important" value="<?=sx_h($sx['hist_min'])?>"> min
  &middot; refresh <select name="cpu_sec"><?=sx_sel_opts($sx['cpu_sec'], $sx_secs)?></select> s
  &middot; clock refresh <select name="clk_sec"><?=sx_sel_opts($sx['clk_sec'], $sx_secs)?></select> s
  <span class="uset-hint">The last hour of load is recorded in the background, so the graph is full as soon as the page opens. A longer refresh is gentler on the server.</span>
<?php endif; ?>
