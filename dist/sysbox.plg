<FILE Name="&plugdir;/api_fetch.php">
<INLINE><![CDATA[<?php
require_once __DIR__ . '/lib.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');

$cfg = sx_cfg();
$attn = [];   // [level, name, text, small]

// ---- memory ------------------------------------------------------------------------------------
function sx_physical_ram() {
    $f = '/tmp/sysbox_dmi.json';
    if (is_file($f)) { $j = json_decode((string)@file_get_contents($f), true); if (is_array($j)) { return $j; } }
    $res = ['size' => null, 'type' => ''];
    $b = sx_bin('dmidecode');
    if ($b !== '') {
        list($rc, $txt) = sx_run(escapeshellarg($b) . ' -t memory', 6);
        if ($rc === 0) {
            $sum = 0.0;
            foreach (preg_split('/Memory Device/', $txt) as $blk) {
                if (preg_match('/^\s*Size:\s*(\d+)\s*(MB|GB)/m', $blk, $m)) { $sum += $m[2] === 'GB' ? (float)$m[1] : (float)$m[1] / 1024; }
                if ($res['type'] === '' && preg_match('/^\s*Type:\s*(DDR\d\w*|LPDDR\d\w*)/m', $blk, $m)) { $res['type'] = $m[1]; }
            }
            if ($sum > 0) { $res['size'] = $sum; }
        }
    }
    @file_put_contents($f, json_encode($res));
    return $res;
}

function sx_arc() {
    foreach ((array)@file('/proc/spl/kstat/zfs/arcstats', FILE_IGNORE_NEW_LINES) as $l) {
        if (preg_match('/^size\s+\d+\s+(\d+)/', $l, $m)) { return (float)$m[1]; }
    }
    return 0.0;
}

$mi = [];
foreach ((array)@file('/proc/meminfo', FILE_IGNORE_NEW_LINES) as $l) {
    if (preg_match('/^(\w+):\s+(\d+)/', $l, $m)) { $mi[$m[1]] = (float)$m[2] * 1024; }
}
$mTotal = $mi['MemTotal'] ?? 0.0;
$mAvail = $mi['MemAvailable'] ?? ($mi['MemFree'] ?? 0.0);
$mUsed  = max(0.0, $mTotal - $mAvail);
$arc    = min(sx_arc(), $mUsed);

// ---- slow readings (containers' stats, GPU, socket): collected in the background ----------------
$slowFile = '/tmp/sysbox_slow.json';
$slow = is_file($slowFile) ? json_decode((string)@file_get_contents($slowFile), true) : null;
$age = is_array($slow) ? time() - (int)($slow['t'] ?? 0) : 9999;
if ($age > 8) {
    $lk = '/tmp/sysbox_collect.lock';
    if (!is_file($lk) || (time() - filemtime($lk)) > 1 || $age > 60) {
        @exec('nohup ' . escapeshellarg(sx_php()) . ' ' . escapeshellarg(__DIR__ . '/collect.php') . ' >/dev/null 2>&1 &');
    }
}
$stats = (is_array($slow) && isset($slow['containers']) && is_array($slow['containers'])) ? $slow['containers'] : null;

$dockerMem = 0.0;
if ($stats) { foreach ($stats as $s) { $dockerMem += (float)($s['mem'] ?? 0); } }
$dockerMem = min($dockerMem, max(0.0, $mUsed - $arc));
$system = max(0.0, $mUsed - $arc - $dockerMem);
$phys = sx_physical_ram();

$memPct = $mTotal > 0 ? $mUsed / $mTotal * 100 : 0;
$memAlertPct = $mTotal > 0 ? max(0.0, $mUsed - $arc) / $mTotal * 100 : 0;   // the ZFS cache gives way to applications
if ($memAlertPct >= (float)$cfg['ram_warn']) {
    $crit = $memAlertPct >= (float)$cfg['ram_crit'];
    $attn[] = [$crit ? 'rd' : 'a', 'RAM', 'is ' . round($memAlertPct) . '% used', '@FREE@' . $mAvail . ' free'];
}
$memory = [
    'total' => $mTotal, 'used' => $mUsed, 'pct' => $memPct, 'free' => $mAvail,
    'system' => $system, 'zfs' => $arc, 'docker' => $dockerMem, 'docker_known' => $stats !== null,
    'phys' => $phys['size'], 'type' => $phys['type'],
    'level' => $memAlertPct >= (float)$cfg['ram_crit'] ? 'rd' : ($memAlertPct >= (float)$cfg['ram_warn'] ? 'a' : ''),
];

// ---- storage -------------------------------------------------------------------------------------
function sx_mounted($path) {
    foreach ((array)@file('/proc/mounts', FILE_IGNORE_NEW_LINES) as $l) {
        $p = explode(' ', $l);
        if (isset($p[1]) && $p[1] === $path) { return true; }
    }
    return false;
}
function sx_fs($label, $path, $warn, $crit, &$attn) {
    $t = @disk_total_space($path); $f = @disk_free_space($path);
    if (!$t) { return null; }
    $used = $t - $f; $pct = $used / $t * 100;
    $lv = $pct >= $crit ? 'rd' : ($pct >= $warn ? 'a' : '');
    if ($lv !== '') { $attn[] = [$lv, $label, 'is ' . number_format($pct, 0) . '% full', '@FREE@' . $f . ' free']; }
    return ['label' => $label, 'size' => $t, 'used' => $used, 'pct' => $pct, 'level' => $lv];
}
$storage = [];
$s = sx_fs('BOOT', '/boot', 90, 97, $attn); if ($s) { $storage[] = $s; }
$s = sx_fs('LOG', '/var/log', (float)$cfg['log_warn'], (float)$cfg['log_crit'], $attn); if ($s) { $storage[] = $s; }
if (sx_mounted('/var/lib/docker')) {
    $s = sx_fs('DOCKER VDISK', '/var/lib/docker', (float)$cfg['vd_warn'], (float)$cfg['vd_crit'], $attn); if ($s) { $storage[] = $s; }
}

// ---- CPU -----------------------------------------------------------------------------------------
list($load, $threads) = sx_cpu_rates();
$info = sx_cpu_info();
list($tPkg, $tCore) = sx_temps();
$clock = sx_on($cfg['show_clock']) ? sx_clock() : null;
$gpuRaw = (is_array($slow) && isset($slow['gpu']) && is_array($slow['gpu'])) ? $slow['gpu'] : null;
$tlevel = '';
if ($tPkg !== null) {
    $tlevel = $tPkg >= (float)$cfg['temp_crit'] ? 'rd' : ($tPkg >= (float)$cfg['temp_warn'] ? 'a' : '');
    if ($tlevel !== '') { $attn[] = [$tlevel, 'CPU', $tlevel === 'rd' ? 'is too hot' : 'is running hot', $tPkg . '°C']; }
}
$la = @sys_getloadavg();
$cpu = [
    'model' => $info['model'], 'cores' => $info['cores'], 'threads' => $info['threads'],
    'load' => $load, 'per' => $threads, 'temp' => $tPkg, 'tlevel' => $tlevel, 'hot_core' => $tCore,
    'clock' => $clock, 'power' => ($gpuRaw && $gpuRaw['power'] > 0) ? $gpuRaw['power'] : null,
    'loadavg' => $la ? round($la[0], 2) : null,
];

// ---- GPU -----------------------------------------------------------------------------------------
$gpu = null;
if (sx_on($cfg['show_gpu'])) {
    $gpu = ['name' => sx_gpu_name(), 'data' => $gpuRaw, 'note' => (is_array($slow) ? (string)($slow['gpu_note'] ?? '') : ''), 'pending' => !is_array($slow)];
}

// ---- smart socket --------------------------------------------------------------------------------
$power = null;
if (trim((string)$cfg['socket_host']) !== '') {
    $sk = (is_array($slow) && isset($slow['socket']) && is_array($slow['socket'])) ? $slow['socket'] : null;
    $price = is_numeric($cfg['kwh_price']) ? (float)$cfg['kwh_price'] : null;
    $power = [
        'data' => $sk, 'note' => is_array($slow) ? (string)($slow['socket_note'] ?? '') : '', 'pending' => !is_array($slow),
        'cost' => ($sk && $price !== null && $sk['month_kwh'] !== null) ? $sk['month_kwh'] * $price : null,
        'currency' => (string)$cfg['currency'],
    ];
}

// ---- containers ----------------------------------------------------------------------------------
$cont = ['enabled' => sx_on($cfg['show_containers']), 'docker' => false, 'rows' => [], 'mode' => $cfg['top_mode'], 'n' => (int)$cfg['top_n'],
         'controls' => sx_on($cfg['controls']), 'logs' => sx_on($cfg['logs']), 'log_lines' => (int)$cfg['log_lines'], 'pending' => $stats === null];
if ($cont['enabled']) {
    $ps = sx_ps();
    $cont['docker'] = (sx_docker() !== '');
    $rows = [];
    foreach ($ps as $n => $p) {
        $st = $stats[$n] ?? null;
        $running = ($p['state'] === 'running' || $p['state'] === 'restarting' || $p['state'] === 'paused');
        $rows[$n] = [
            'name' => $n, 'state' => $p['state'], 'status' => $p['status'], 'unhealthy' => $p['unhealthy'],
            // Docker reports a share of one core; the tile shows the share of the whole CPU (all threads), like the Load figure
            'cpu' => ($st && $p['state'] === 'running') ? $st['cpu'] / max(1, $info['threads']) : null,
            'cpu_core' => ($st && $p['state'] === 'running') ? $st['cpu'] : null,
            'mem' => ($st && $p['state'] === 'running') ? $st['mem'] : null,
        ];
        if ($p['state'] === 'restarting') { $attn[] = ['a', $n, 'is restarting', $p['status']]; }
        elseif ($p['unhealthy']) { $attn[] = ['a', $n, 'is unhealthy', '']; }
    }
    $mode = in_array($cont['mode'], ['cpu', 'ram', 'selected'], true) ? $cont['mode'] : 'cpu';
    $n = max(1, min(10, (int)$cfg['top_n']));
    $pick = [];
    if ($mode === 'selected') {
        foreach (array_filter(array_map('trim', explode(',', (string)$cfg['sel']))) as $name) { if (isset($rows[$name])) { $pick[] = $rows[$name]; } }
    } else {
        $run = array_filter($rows, function ($r) { return $r['state'] === 'running'; });
        $key = $mode === 'cpu' ? 'cpu' : 'mem';
        usort($run, function ($a, $b) use ($key) { return ((float)($b[$key] ?? -1)) <=> ((float)($a[$key] ?? -1)); });
        $pick = array_slice($run, 0, $n);
    }
    foreach ($pick as &$r) {
        $r['bar'] = ($mode === 'ram')
            ? ($mTotal > 0 && $r['mem'] !== null ? min(100, $r['mem'] / $mTotal * 100) : 0)
            : ($r['cpu'] !== null ? min(100, max(0, $r['cpu'])) : 0);
    }
    unset($r);
    $cont['mode'] = $mode; $cont['n'] = $n; $cont['rows'] = $pick;
}

// ---- summary and attention -----------------------------------------------------------------------
$up = (int)((float)@file_get_contents('/proc/uptime'));
$d = intdiv($up, 86400); $h = intdiv($up % 86400, 3600); $m = intdiv($up % 3600, 60);
$order = ['rd' => 0, 'a' => 1];
usort($attn, function ($a, $b) use ($order) { return ($order[$a[0]] ?? 2) <=> ($order[$b[0]] ?? 2); });
$attOut = [];
foreach ($attn as $a) { $attOut[] = ['level' => $a[0], 'name' => $a[1], 'text' => $a[2], 'small' => $a[3]]; }

$sxShow = [];
foreach (['ram_leg', 'cpu_load', 'cpu_temp', 'cpu_pow', 'cpu_hist', 'cpu_per', 'cpu_la', 'pow_w', 'pow_day', 'pow_mon', 'pow_cost', 'pow_name'] as $k) { $sxShow[$k] = sx_on($cfg[$k]); }

sx_json([
    'ok' => true, 'ts' => time(),
    'summary' => ['ram' => $memPct, 'cpu' => $load, 'temp' => $tPkg, 'uptime' => ($d > 0 ? $d . ' d ' . $h . ' h' : ($h > 0 ? $h . ' h ' . $m . ' m' : $m . ' m'))],
    'attention' => $attOut, 'memory' => $memory, 'storage' => $storage, 'cpu' => $cpu, 'gpu' => $gpu, 'power' => $power, 'containers' => $cont,
    'limits' => ['temp_warn' => (float)$cfg['temp_warn'], 'temp_crit' => (float)$cfg['temp_crit']],
    'ui' => ['hist_min' => max(1, min(60, (int)$cfg['hist_min'])), 'cpu_sec' => (int)$cfg['cpu_sec'], 'clk_sec' => (int)$cfg['clk_sec'], 'show_clock' => sx_on($cfg['show_clock']),
             'order' => sx_order($cfg), 'show' => ['ram' => sx_on($cfg['show_ram']), 'sto' => sx_on($cfg['show_sto']), 'cpu' => sx_on($cfg['show_cpu']),
             'gpu' => sx_on($cfg['show_gpu']), 'pow' => sx_on($cfg['show_pow']), 'con' => sx_on($cfg['show_containers'])], 'metrics' => $sxShow],
]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- BACKGROUND COLLECTOR -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/collect.php">
<INLINE><![CDATA[<?php
// Slow readings (container statistics, GPU, smart socket), collected in the background by api_fetch.php
// so the dashboard request itself stays fast. Result: /tmp/sysbox_slow.json
if (PHP_SAPI !== 'cli') { exit(1); } // started by api_fetch.php, not a web page
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/energy.php';

$lock = @fopen('/tmp/sysbox_collect.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

$cfg = sx_cfg();
$res = ['t' => time(), 'containers' => null, 'gpu' => null, 'gpu_note' => '', 'socket' => null, 'socket_note' => ''];

function sx_bytes($s) {
    if (!preg_match('/^\s*([0-9.]+)\s*([A-Za-z]*)/', (string)$s, $m)) { return null; }
    $mul = ['' => 1, 'b' => 1, 'kb' => 1e3, 'kib' => 1024, 'mb' => 1e6, 'mib' => 1048576, 'gb' => 1e9, 'gib' => 1073741824, 'tb' => 1e12, 'tib' => 1099511627776];
    $u = strtolower($m[2]);
    return isset($mul[$u]) ? (float)$m[1] * $mul[$u] : null;
}

// ---- containers: CPU and memory of the running ones ----
$d = sx_docker();
if ($d !== '') {
    list($rc, $txt) = sx_run(escapeshellarg($d) . " stats --no-stream --format '{{json .}}'", 20);
    if ($rc === 0) {
        $c = [];
        foreach (explode("\n", $txt) as $l) {
            $j = json_decode(trim($l), true);
            if (!is_array($j) || !isset($j['Name'])) { continue; }
            $n = (string)$j['Name'];
            if (!sx_valid_name($n)) { continue; }
            $used = explode('/', (string)($j['MemUsage'] ?? ''))[0];
            $c[$n] = ['cpu' => (float)rtrim((string)($j['CPUPerc'] ?? '0'), '%'), 'mem' => sx_bytes($used)];
        }
        $res['containers'] = $c;
    }
}

// ---- GPU: intel_gpu_top ----
if (sx_on($cfg['show_gpu'])) {
    $bin = sx_bin('intel_gpu_top');
    $disabled = array_map('trim', explode(',', (string)ini_get('disable_functions')));
    if ($bin === '') {
        $res['gpu_note'] = 'intel_gpu_top not found';
    } elseif (!function_exists('shell_exec') || in_array('shell_exec', $disabled, true)) {
        $res['gpu_note'] = 'shell_exec is disabled in PHP';
    } else {
        $to = sx_bin('timeout');
        $errf = '/tmp/sysbox_gpu.err';
        @unlink($errf);
        $raw = (string)@shell_exec(($to !== '' ? $to . ' 4 ' : '') . escapeshellarg($bin) . ' -J -s 400 -n 2 2>' . escapeshellarg($errf));
        // not always strict JSON (nan values, a cut-off last sample): read the numbers from the last sample with engine data
        $chunks = preg_split('/"period"\s*:/', $raw);
        array_shift($chunks);
        $pick = null;
        for ($i = count($chunks) - 1; $i >= 0; $i--) {
            if (preg_match('/"Render\/3D"\s*:\s*\{[^}]*?"busy"\s*:\s*([^,}\s]+)/', $chunks[$i])) { $pick = $chunks[$i]; break; }
        }
        if ($pick !== null) {
            $num = function ($pat) use ($pick) { return (preg_match($pat, $pick, $m) && is_numeric($m[1])) ? (float)$m[1] : 0.0; };
            $res['gpu'] = [
                'video'  => max($num('/"Video"\s*:\s*\{[^}]*?"busy"\s*:\s*([^,}\s]+)/'), $num('/"VideoEnhance"\s*:\s*\{[^}]*?"busy"\s*:\s*([^,}\s]+)/')),
                'render' => $num('/"Render\/3D"\s*:\s*\{[^}]*?"busy"\s*:\s*([^,}\s]+)/'),
                'freq'   => $num('/"actual"\s*:\s*([^,}\s]+)/'),
                'power'  => $num('/"Package"\s*:\s*([^,}\s]+)/'),
            ];
        } else {
            $e = is_file($errf) ? trim((string)@file_get_contents($errf)) : '';
            $res['gpu_note'] = $raw === '' ? 'intel_gpu_top printed nothing' . ($e !== '' ? ': ' . substr($e, 0, 160) : '') : 'no engine data in the output';
        }
    }
}

// ---- smart socket ----
$host = trim((string)$cfg['socket_host']);
if ($host !== '') {
    list($sd, $se) = sx_socket_fetch($host, (int)$cfg['socket_id']);
    if ($sd !== null) {
        $res['socket'] = [
            'power' => $sd['power'], 'output' => $sd['output'], 'name' => sx_socket_name($host),
            'month_kwh' => ($sd['total_wh'] !== null) ? sx_energy_month_wh($sd['total_wh']) / 1000 : null,
            'day_kwh' => ($sd['total_wh'] !== null && ($t = sx_energy_today_wh($sd['total_wh'])) !== null) ? $t / 1000 : null,
        ];
    } else { $res['socket_note'] = $se; }
}

$tmp = '/tmp/sysbox_slow.json.tmp';
@file_put_contents($tmp, json_encode($res));
@rename($tmp, '/tmp/sysbox_slow.json');
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- CONTAINER ACTIONS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/action.php">
<INLINE><![CDATA[<?php
// Start, stop or restart one container. POST name=<container>&op=start|stop|restart
require_once __DIR__ . '/lib.php';

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { sx_json(['ok' => false, 'error' => 'method'], 405); }
sx_guard();
$cfg = sx_cfg();
if (!sx_on($cfg['controls'])) { sx_json(['ok' => false, 'error' => 'the container buttons are switched off in the Sysbox settings'], 403); }

$name = (string)($_POST['name'] ?? '');
$op   = (string)($_POST['op'] ?? '');
if (!in_array($op, ['start', 'stop', 'restart'], true)) { sx_json(['ok' => false, 'error' => 'unknown action'], 400); }
if (!sx_valid_name($name)) { sx_json(['ok' => false, 'error' => 'invalid container name'], 400); }

$d = sx_docker();
if ($d === '') { sx_json(['ok' => false, 'error' => 'Docker is not running'], 503); }
$ps = sx_ps(true);
if (!isset($ps[$name])) { sx_json(['ok' => false, 'error' => 'no such container'], 404); }

list($rc, $out) = sx_run(escapeshellarg($d) . ' ' . $op . ' ' . escapeshellarg($name), 90);
@unlink('/tmp/sysbox_ps.json');
if ($rc === 0 && $op === 'stop') {   // so the Discord alerts do not report a stop made from the dashboard
    $mk = is_file('/tmp/sysbox_userstop.json') ? (json_decode((string)@file_get_contents('/tmp/sysbox_userstop.json'), true) ?: []) : [];
    $mk[$name] = time();
    @file_put_contents('/tmp/sysbox_userstop.json', json_encode($mk));
}
if ($rc !== 0) { sx_json(['ok' => false, 'error' => substr(trim($out), 0, 300) ?: ('docker exited with ' . $rc)], 500); }
sx_json(['ok' => true]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- CONTAINER LOGS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/logs.php">
<INLINE><![CDATA[<?php
// The last lines of one container's log. GET name=<container>&lines=<n>
require_once __DIR__ . '/lib.php';

if (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') { sx_json(['ok' => false, 'error' => 'not an AJAX request'], 403); }
$cfg = sx_cfg();
if (!sx_on($cfg['logs'])) { sx_json(['ok' => false, 'error' => 'the log button is switched off in the Sysbox settings'], 403); }

$name = (string)($_GET['name'] ?? '');
if (!sx_valid_name($name)) { sx_json(['ok' => false, 'error' => 'invalid container name'], 400); }
$n = max(10, min(500, (int)($_GET['lines'] ?? $cfg['log_lines'])));

$d = sx_docker();
if ($d === '') { sx_json(['ok' => false, 'error' => 'Docker is not running'], 503); }
$ps = sx_ps();
if (!isset($ps[$name])) { sx_json(['ok' => false, 'error' => 'no such container'], 404); }

list($rc, $out) = sx_run(escapeshellarg($d) . ' logs --tail ' . $n . ' --timestamps ' . escapeshellarg($name), 10);
if ($rc !== 0 && $out === '') { sx_json(['ok' => false, 'error' => 'could not read the log'], 500); }
if (strlen($out) > 200000) { $out = substr($out, -200000); }
sx_json(['ok' => true, 'text' => $out]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SAVE -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/save.php">
<INLINE><![CDATA[<?php
require_once __DIR__ . '/lib.php';

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { sx_json(['ok' => false, 'error' => 'method'], 405); }
sx_guard();

function sx_int($v, $min, $max, $name) {
    $v = trim((string)$v);
    if ($v === '' || !is_numeric($v) || $v < $min || $v > $max) { sx_json(['ok' => false, 'error' => $name . ' must be a number between ' . $min . ' and ' . $max], 400); }
    return (string)(int)$v;
}
function sx_hook($v) {
    $v = trim((string)$v);
    if ($v !== '' && !preg_match('#^https://(?:discord|discordapp)\.com/api/webhooks/\d{15,25}/[A-Za-z0-9_\-]{20,120}$#', $v)) { sx_json(['ok' => false, 'error' => 'the webhook is not a valid Discord webhook URL'], 400); }
    return $v;
}
// the page does not get the saved webhook: empty keeps it, - removes it
function sx_hook_keep($v) { $v = trim((string)$v); if ($v === '') { return (string)(sx_cfg()['dc_hook'] ?? ''); } if ($v === '-') { return ''; } return sx_hook($v); }
function sx_choice($v, $allowed, $name) {
    $v = trim((string)$v);
    if (!in_array($v, $allowed, true)) { sx_json(['ok' => false, 'error' => $name . ' must be one of ' . implode(', ', $allowed) . ' seconds'], 400); }
    return $v;
}
function sx_bool($v) { return in_array(strtolower(trim((string)$v)), ['1', 'yes', 'true', 'on'], true) ? '1' : '0'; }

$ping = trim((string)($_POST['dc_ping'] ?? ''));
if ($ping !== '' && !preg_match('/^(\d{15,25}|role:\d{15,25}|@here|@everyone)$/', $ping)) { sx_json(['ok' => false, 'error' => 'the ping must be a Discord user ID, role:<role ID>, @here or @everyone'], 400); }
$mode = (string)($_POST['top_mode'] ?? 'cpu');
if (!in_array($mode, ['cpu', 'ram', 'selected'], true)) { sx_json(['ok' => false, 'error' => 'unknown container mode'], 400); }

$sel = [];
foreach ((array)($_POST['sel'] ?? []) as $n) {
    $n = (string)$n;
    if (sx_valid_name($n)) { $sel[] = $n; }
}

$host = trim((string)($_POST['socket_host'] ?? ''));
if ($host !== '' && !preg_match('/^[A-Za-z0-9.\-]+$/', $host)) { sx_json(['ok' => false, 'error' => 'the socket address may only contain letters, digits, dots and dashes'], 400); }
$price = trim((string)($_POST['kwh_price'] ?? ''));
if ($price !== '' && (!is_numeric($price) || $price < 0 || $price > 100000)) { sx_json(['ok' => false, 'error' => 'the energy price must be a number'], 400); }
$cur = preg_replace('/[^\p{L}\p{N}$€£ .\-]/u', '', (string)($_POST['currency'] ?? ''));
$cur = function_exists('mb_substr') ? mb_substr($cur, 0, 6) : substr($cur, 0, 6);

$new = [
    'top_mode' => $mode, 'top_n' => sx_int($_POST['top_n'] ?? '3', 1, 10, 'Number of rows'),
    'sel' => implode(',', array_values(array_unique($sel))),
    'controls' => sx_bool($_POST['controls'] ?? '1'), 'logs' => sx_bool($_POST['logs'] ?? '1'),
    'log_lines' => sx_int($_POST['log_lines'] ?? '100', 10, 500, 'Log lines'),
    'hist_min' => sx_int($_POST['hist_min'] ?? '2', 1, 60, 'CPU history'),
    'cpu_sec' => sx_choice($_POST['cpu_sec'] ?? '1', ['1', '2', '5', '10'], 'CPU refresh'), 'clk_sec' => sx_choice($_POST['clk_sec'] ?? '2', ['1', '2', '5', '10'], 'Clock refresh'),
    'show_clock' => sx_bool($_POST['show_clock'] ?? '1'),
    'show_gpu' => sx_bool($_POST['show_gpu'] ?? '1'), 'show_containers' => sx_bool($_POST['show_containers'] ?? '1'),
    'show_ram' => sx_bool($_POST['show_ram'] ?? '1'), 'show_sto' => sx_bool($_POST['show_sto'] ?? '1'), 'show_cpu' => sx_bool($_POST['show_cpu'] ?? '1'), 'show_pow' => sx_bool($_POST['show_pow'] ?? '1'),
    'order' => implode(',', sx_order(['order' => (string)($_POST['order'] ?? '')])), 'ram_leg' => sx_bool($_POST['ram_leg'] ?? '1'),
    'cpu_load' => sx_bool($_POST['cpu_load'] ?? '1'), 'cpu_temp' => sx_bool($_POST['cpu_temp'] ?? '1'), 'cpu_pow' => sx_bool($_POST['cpu_pow'] ?? '1'),
    'cpu_hist' => sx_bool($_POST['cpu_hist'] ?? '1'), 'cpu_per' => sx_bool($_POST['cpu_per'] ?? '1'), 'cpu_la' => sx_bool($_POST['cpu_la'] ?? '0'),
    'pow_w' => sx_bool($_POST['pow_w'] ?? '1'), 'pow_day' => sx_bool($_POST['pow_day'] ?? '1'), 'pow_mon' => sx_bool($_POST['pow_mon'] ?? '1'),
    'pow_cost' => sx_bool($_POST['pow_cost'] ?? '1'), 'pow_name' => sx_bool($_POST['pow_name'] ?? '1'),
    'ram_warn' => sx_int($_POST['ram_warn'] ?? '80', 1, 100, 'RAM warning'), 'ram_crit' => sx_int($_POST['ram_crit'] ?? '92', 1, 100, 'RAM critical'),
    'log_warn' => sx_int($_POST['log_warn'] ?? '80', 1, 100, 'Log warning'), 'log_crit' => sx_int($_POST['log_crit'] ?? '92', 1, 100, 'Log critical'),
    'vd_warn' => sx_int($_POST['vd_warn'] ?? '80', 1, 100, 'Docker vdisk warning'), 'vd_crit' => sx_int($_POST['vd_crit'] ?? '92', 1, 100, 'Docker vdisk critical'),
    'temp_warn' => sx_int($_POST['temp_warn'] ?? '75', 20, 120, 'CPU temperature warning'), 'temp_crit' => sx_int($_POST['temp_crit'] ?? '90', 20, 120, 'CPU temperature critical'),
    'socket_host' => $host, 'socket_id' => sx_int($_POST['socket_id'] ?? '0', 0, 3, 'Socket channel'),
    'kwh_price' => $price, 'currency' => $cur,
    'dc_hook' => sx_hook_keep($_POST['dc_hook'] ?? ''), 'dc_ping' => $ping, 'dc_lang' => (($_POST['dc_lang'] ?? 'hu') === 'en') ? 'en' : 'hu',
    'n_containers' => sx_bool($_POST['n_containers'] ?? '1'), 'n_ram' => sx_bool($_POST['n_ram'] ?? '1'), 'n_storage' => sx_bool($_POST['n_storage'] ?? '1'),
    'n_cpu' => sx_bool($_POST['n_cpu'] ?? '1'), 'n_boot' => sx_bool($_POST['n_boot'] ?? '1'),
    'n_remind' => sx_int($_POST['n_remind'] ?? '24', 0, 168, 'Repeat interval'),
    'wk_on' => sx_bool($_POST['wk_on'] ?? '1'), 'wk_day' => sx_int($_POST['wk_day'] ?? '7', 1, 7, 'Weekly day'), 'wk_hour' => sx_int($_POST['wk_hour'] ?? '19', 0, 23, 'Weekly hour'),
];
foreach (['ram', 'log', 'vd', 'temp'] as $k) {
    if ((int)$new[$k . '_warn'] > (int)$new[$k . '_crit']) { sx_json(['ok' => false, 'error' => 'a warning limit cannot be higher than its critical limit'], 400); }
}

$text = '';
foreach ($new as $k => $v) { $text .= $k . '="' . str_replace('"', '', $v) . '"' . "\n"; }

$dir = dirname(SX_CFG);
if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
$tmp = SX_CFG . '.tmp';
if (@file_put_contents($tmp, $text) === false) { sx_json(['ok' => false, 'error' => 'could not write the settings file'], 500); }
if (!@rename($tmp, SX_CFG)) { @file_put_contents(SX_CFG, $text); @unlink($tmp); }
@chmod(SX_CFG, 0600);
@unlink('/tmp/sysbox_slow.json');
sx_json(['ok' => true]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SMART SOCKET ENERGY -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/energy.php">
<INLINE><![CDATA[<?php
// Smart socket (Shelly Gen2 and newer) helpers: wall power and a monthly energy total.

// Returns [array|null, error text]
function sx_socket_fetch($host, $id) {
    if (!preg_match('/^[A-Za-z0-9.\-]+$/', (string)$host)) { return [null, 'invalid socket address']; }
    $ch = curl_init('http://' . $host . '/rpc/Switch.GetStatus?id=' . (int)$id);
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 2, CURLOPT_TIMEOUT => 3]);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err  = curl_errno($ch);
    curl_close($ch);
    if ($err) { return [null, 'socket unreachable']; }
    if ($code === 401 || $code === 403) { return [null, 'the socket asks for a password (not supported)']; }
    if ($code !== 200) { return [null, 'socket answered HTTP ' . $code]; }
    $d = json_decode((string)$body, true);
    if (!is_array($d) || !isset($d['apower'])) { return [null, 'unexpected answer from the socket']; }
    $total = isset($d['aenergy']['total']) ? (float)$d['aenergy']['total'] : null;
    return [['power' => (float)$d['apower'], 'total_wh' => $total, 'output' => !empty($d['output'])], ''];
}

// The socket's type for the tile, from its model ("PlugSG3" -> "Shelly Plug S Gen3").
// Asked at most once an hour; the answer is kept in /tmp.
function sx_socket_name($host) {
    $f = '/tmp/sysbox_socket_name.json';
    $c = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null;
    if (is_array($c) && ($c['host'] ?? '') === $host && time() - (int)($c['t'] ?? 0) < 3600) { return (string)$c['name']; }
    if (!preg_match('/^[A-Za-z0-9.\-]+$/', (string)$host)) { return ''; }
    $ch = curl_init('http://' . $host . '/rpc/Shelly.GetDeviceInfo');
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 2, CURLOPT_TIMEOUT => 3]);
    $d = json_decode((string)curl_exec($ch), true);
    $ok = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE) === 200;
    curl_close($ch);
    if (!$ok || !is_array($d)) { return is_array($c) ? (string)$c['name'] : ''; }
    $name = '';
    if (!empty($d['app'])) {
        $m = preg_replace('/G(\d+)$/', ' Gen$1', (string)$d['app']);   // PlugSG3 -> PlugS Gen3
        $m = preg_replace('/([a-z])([A-Z])/', '$1 $2', $m);              // PlugS -> Plug S
        $name = 'Shelly ' . $m;
    }
    $name = function_exists('mb_substr') ? mb_substr($name, 0, 40) : substr($name, 0, 40);
    @file_put_contents($f, json_encode(['host' => $host, 't' => time(), 'name' => $name]));
    return $name;
}

// Energy used since the 1st of the month, in Wh. The socket keeps a running counter; the counter value at
// the start of the month is remembered on the flash drive. It is written only when the month changes or
// the counter is reset, never on every reading.
function sx_energy_month_wh($total) {
    $sf    = '/boot/config/plugins/sysbox/energy.json';
    $lf    = '/tmp/sysbox_energy_last.json';
    $month = date('Y-m');
    $st    = is_file($sf) ? json_decode((string)@file_get_contents($sf), true) : null;
    $last  = is_file($lf) ? json_decode((string)@file_get_contents($lf), true) : null;
    $dirty = false;

    if (!is_array($st) || !isset($st['month']) || !isset($st['base'])) {
        $st = ['month' => $month, 'base' => $total, 'carry' => 0.0];
        $dirty = true;
    } elseif ((string)$st['month'] !== $month) {
        $st = ['month' => $month, 'base' => $total, 'carry' => 0.0];
        $dirty = true;
    }

    // The counter went backwards: it was reset (or the socket was replaced). Keep what was counted so far.
    $ref = (is_array($last) && isset($last['total'])) ? (float)$last['total'] : (float)$st['base'];
    if ($total < $ref - 0.001) {
        $st['carry'] = (float)($st['carry'] ?? 0) + max(0.0, $ref - (float)$st['base']);
        $st['base']  = 0.0;
        $dirty = true;
    }

    if ($dirty) {
        $tmp = $sf . '.tmp';
        if (@file_put_contents($tmp, json_encode($st)) !== false) {
            if (!@rename($tmp, $sf)) { @file_put_contents($sf, json_encode($st)); @unlink($tmp); }
        }
    }
    @file_put_contents($lf, json_encode(['total' => $total, 't' => time()]));
    return max(0.0, (float)($st['carry'] ?? 0) + $total - (float)$st['base']);
}

// Daily consumption (Wh per day) for the last 40 days, built from the socket's counter. Works on its own running
// total, so a counter reset does not lose the day. Updated every 10 minutes by sample.php; kept in /tmp and copied
// to the flash drive once an hour.
function sx_energy_days_update($total) {
    $tf = '/tmp/sysbox_edays.json';
    $ff = '/boot/config/plugins/sysbox/energy_days.json';
    $st = null;
    foreach ([$tf, $ff] as $f) {
        if (is_file($f)) { $j = json_decode((string)@file_get_contents($f), true); if (is_array($j) && isset($j['days'])) { $st = $j; break; } }
    }
    if (!is_array($st)) { $st = ['last' => null, 'days' => [], 'flushed' => 0]; }
    $today = date('Y-m-d');
    if ($st['last'] !== null) {
        $d = ($total >= (float)$st['last']) ? $total - (float)$st['last'] : $total;   // a smaller counter means it was reset
        $st['days'][$today] = (float)($st['days'][$today] ?? 0) + max(0.0, $d);
    } else {
        $st['days'][$today] = (float)($st['days'][$today] ?? 0);
    }
    $st['last'] = $total;
    ksort($st['days']);
    $st['days'] = array_slice($st['days'], -40, null, true);
    @file_put_contents($tf, json_encode($st));
    if (time() - (int)($st['flushed'] ?? 0) >= 3600) {
        $st['flushed'] = time();
        $tmp = $ff . '.tmp';
        if (@file_put_contents($tmp, json_encode($st)) !== false) { if (!@rename($tmp, $ff)) { @file_put_contents($ff, json_encode($st)); @unlink($tmp); } }
        @file_put_contents($tf, json_encode($st));
    }
}

// Today's consumption (Wh): what the 10-minute sampler counted since midnight plus the counter's rise since its last sample.
// Read-only: the sampler alone writes the daily file. Null before the sampler has run.
function sx_energy_today_wh($total) {
    foreach (['/tmp/sysbox_edays.json', '/boot/config/plugins/sysbox/energy_days.json'] as $f) {
        if (!is_file($f)) { continue; }
        $j = json_decode((string)@file_get_contents($f), true);
        if (!is_array($j) || !isset($j['days'])) { continue; }
        $wh = (float)($j['days'][date('Y-m-d')] ?? 0);
        if ($j['last'] !== null && $total >= (float)$j['last']) { $wh += $total - (float)$j['last']; }
        return $wh;
    }
    return null;
}

// Average daily use in Wh over up to the last $n complete days (today is left out); [average Wh, days counted] or null
function sx_energy_days_avg($n = 7) {
    foreach (['/tmp/sysbox_edays.json', '/boot/config/plugins/sysbox/energy_days.json'] as $f) {
        if (!is_file($f)) { continue; }
        $j = json_decode((string)@file_get_contents($f), true);
        if (!is_array($j) || empty($j['days'])) { continue; }
        $vals = [];
        for ($i = 1; $i <= $n; $i++) {
            $k = date('Y-m-d', strtotime("-$i day"));
            if (isset($j['days'][$k])) { $vals[] = (float)$j['days'][$k]; }
        }
        if ($vals) { return [array_sum($vals) / count($vals), count($vals)]; }
    }
    return null;
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- ENERGY SAMPLER -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/sample.php">
<INLINE><![CDATA[<?php
// Started by cron every 10 minutes: remember the smart socket's energy counter, so the monthly
// consumption stays correct even when nobody has the dashboard open.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/energy.php';

$cfg = sx_cfg();
$host = trim((string)$cfg['socket_host']);
if ($host === '') { exit(0); }

list($s, $err) = sx_socket_fetch($host, (int)$cfg['socket_id']);
if ($s !== null && $s['total_wh'] !== null) { sx_energy_month_wh($s['total_wh']); sx_energy_days_update($s['total_wh']); }
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- CPU ENDPOINT -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/cpu.php">
<INLINE><![CDATA[<?php
// Light and fast: only the CPU numbers, polled every second by the dashboard tile.
require_once __DIR__ . '/lib.php';
if (($_GET['only'] ?? '') === 'clock') { sx_json(['ok' => true, 'clock' => sx_clock()]); }   // the clock has its own, slower refresh
if (($_GET['only'] ?? '') === 'hist') {                // history for the graph, as ages (ms), independent of any clock difference
    $now = time(); $min = max(1, min(60, (int)($_GET['min'] ?? 2))); $out = [];
    $d = is_file('/tmp/sysbox_hist.json') ? json_decode((string)@file_get_contents('/tmp/sysbox_hist.json'), true) : [];
    foreach ((array)$d as $p) { if (is_array($p) && $p[0] >= $now - $min * 60) { $out[] = [($now - $p[0]) * 1000, $p[1]]; } }
    sx_json(['ok' => true, 'pts' => $out]);
}
list($load, $per) = sx_cpu_rates();
list($tPkg, $tCore) = sx_temps();
$cfg = sx_cfg();
$tl = '';
if ($tPkg !== null) { $tl = $tPkg >= (float)$cfg['temp_crit'] ? 'rd' : ($tPkg >= (float)$cfg['temp_warn'] ? 'a' : ''); }
sx_json(['ok' => true, 'load' => $load, 'per' => $per, 'temp' => $tPkg, 'tlevel' => $tl, 'hot_core' => $tCore]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- CPU HISTORY SAMPLER -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/cpuhist.php">
<INLINE><![CDATA[<?php
// Long-running CPU sampler (started by cron, one instance only): keeps the last hour of total CPU load
// in RAM (/tmp), so the dashboard graph is already full when the page is opened.
if (PHP_SAPI !== 'cli') { exit; }
require_once __DIR__ . '/lib.php';
const SX_HF = '/tmp/sysbox_hist.json';
$step = 2; $keep = 3600;
$pts = [];
$f0 = is_file(SX_HF) ? json_decode((string)@file_get_contents(SX_HF), true) : null;
if (is_array($f0)) { $now = time(); foreach ($f0 as $p) { if (is_array($p) && count($p) === 2 && $p[0] > $now - $keep) { $pts[] = $p; } } }
$prev = (sx_stat())['all'] ?? null; $n = 0;
while (true) {
    sleep($step);
    if (!is_dir(__DIR__)) { exit; }                       // plugin removed
    $cur = (sx_stat())['all'] ?? null;
    if ($cur && $prev) {
        $dt = $cur[0] - $prev[0]; $di = $cur[1] - $prev[1];
        $v = $dt > 0 ? max(0, min(100, (1 - $di / $dt) * 100)) : 0;
        $pts[] = [time(), round($v, 1)];
        $lim = time() - $keep;
        while ($pts && $pts[0][0] < $lim) { array_shift($pts); }
        if (++$n % 2 === 0) { @file_put_contents(SX_HF . '.tmp', json_encode($pts)); @rename(SX_HF . '.tmp', SX_HF); }
    }
    $prev = $cur;
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD HELPERS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/discord.php">
<INLINE><![CDATA[<?php
// Sysbox Discord helpers: webhook post, embeds, and alert state with de-duplication.
// Alert state lives on the flash drive and is written only when it changes; short-lived counters live in /tmp.
const SXN_STATE = '/boot/config/plugins/sysbox/notify_state.json';
const SXN_TMP   = '/tmp/sysbox_notify_tmp.json';

function sxn_hook_ok($u) { return (bool)preg_match('#^https://(?:discord|discordapp)\.com/api/webhooks/\d{15,25}/[A-Za-z0-9_\-]{20,120}$#', (string)$u); }

require_once __DIR__ . '/lang.php';
// the Discord language is shared by all the plugins (lang.php; Settings, the Language block of any of them)
function sxn_lang($cfg) { return mt_lang_discord(); }

// Returns ['ok'|'retry'|'fail', message]
// The text that pings someone on red alerts: a user ID, "role:<id>", "@here" or "@everyone" (setting dc_ping)
function sxn_ping_text($v) {
    $v = trim((string)$v);
    if (preg_match('/^\d{15,25}$/', $v)) { return '<@' . $v . '>'; }
    if (preg_match('/^role:(\d{15,25})$/', $v, $m)) { return '<@&' . $m[1] . '>'; }
    if ($v === '@here' || $v === '@everyone') { return $v; }
    return '';
}
function sxn_ping_set($v = null) {
    static $p = '';
    if ($v !== null) { $p = sxn_ping_text($v); }
    return $p;
}

function sxn_post($hook, $embeds, $content = '', $attempt = 0) {
    static $last = 0.0;
    $gap = microtime(true) - $last;
    if ($gap < 0.5) { usleep((int)((0.5 - $gap) * 1000000)); }
    $am = ['parse' => []];
    if ($content !== '') {
        if (preg_match('/^<@(\d+)>$/', $content, $m)) { $am = ['parse' => [], 'users' => [$m[1]]]; }
        elseif (preg_match('/^<@&(\d+)>$/', $content, $m)) { $am = ['parse' => [], 'roles' => [$m[1]]]; }
        else { $am = ['parse' => ['everyone']]; }
    }
    $pl = ['embeds' => $embeds, 'allowed_mentions' => $am];
    if ($content !== '') { $pl['content'] = $content; }
    $json = json_encode($pl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
    $ch = curl_init($hook);
    curl_setopt_array($ch, [CURLOPT_POST => true, CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 20,
        CURLOPT_POSTFIELDS => $json, CURLOPT_HTTPHEADER => ['Content-Type: application/json']]);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err = curl_errno($ch);
    curl_close($ch);
    $last = microtime(true);
    if ($err) { return ['retry', 'network error ' . $err]; }
    if ($code === 200 || $code === 204) { return ['ok', '']; }
    if ($code === 429) {
        $d = json_decode((string)$body, true);
        $wait = is_array($d) && isset($d['retry_after']) ? (float)$d['retry_after'] : 2.0;
        if ($attempt < 1 && $wait <= 5.0) { usleep((int)(($wait + 0.3) * 1000000)); return sxn_post($hook, $embeds, $content, $attempt + 1); }
        return ['retry', 'rate limited'];
    }
    if ($code >= 500 || $code === 0) { return ['retry', 'Discord HTTP ' . $code]; }
    $d = json_decode((string)$body, true);
    return ['fail', 'Discord HTTP ' . $code . (is_array($d) && !empty($d['message']) ? ' (' . $d['message'] . ')' : '')];
}

// $level: rd red, a amber, g green, i blue. $fields: [[name, value, inline?], ...]
function sxn_embed($level, $title, $desc = '', $fields = [], $footer = '') {
    $col = ['rd' => 0xE5534B, 'a' => 0xD9921F, 'g' => 0x3FA24A, 'i' => 0x4A90E2];
    $host = @gethostname();
    $e = ['title' => mb_substr($title, 0, 250), 'color' => $col[$level] ?? $col['i'], 'timestamp' => gmdate('c'),
          'footer' => ['text' => trim(($host ? $host . ' · ' : '') . 'Sysbox' . ($footer !== '' ? ' · ' . $footer : ''))]];
    if ($desc !== '') { $e['description'] = mb_substr($desc, 0, 3900); }
    $f = [];
    foreach ($fields as $x) {
        if ($x[1] === '' || $x[1] === null) { continue; }
        $f[] = ['name' => mb_substr((string)$x[0], 0, 250), 'value' => mb_substr((string)$x[1], 0, 1000), 'inline' => !empty($x[2])];
    }
    if ($f) { $e['fields'] = array_slice($f, 0, 24); }
    return $e;
}

function sxn_load($file, $def) {
    $j = is_file($file) ? json_decode((string)@file_get_contents($file), true) : null;
    return is_array($j) ? array_merge($def, $j) : $def;
}
function sxn_state() { return sxn_load(SXN_STATE, ['k' => [], 'log' => [], 'misc' => []]); }
function sxn_tmp() { return sxn_load(SXN_TMP, ['deb' => [], 'x' => []]); }
function sxn_write($file, $data) {
    $dir = dirname($file);
    if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
    $tmp = $file . '.tmp';
    if (@file_put_contents($tmp, json_encode($data)) === false) { return; }
    if (!@rename($tmp, $file)) { @file_put_contents($file, json_encode($data)); @unlink($tmp); }
}

// Remembers one sent alert in the 7-day log (used by the weekly summary)
function sxn_log(&$st, $key, $level) {
    $st['log'][] = [time(), $key, $level];
    $cut = time() - 14 * 86400;
    $st['log'] = array_values(array_filter($st['log'], function ($x) use ($cut) { return $x[0] >= $cut; }));
    if (count($st['log']) > 300) { $st['log'] = array_slice($st['log'], -300); }
}

// One alert with its life cycle. $level: '' (fine), 'a' or 'rd'. $sig: changes when an active alert gets worse in another way.
// $mk('alert'|'resolved') returns an embed. $o: need = consecutive checks before the first alert, resolve = send an all-clear,
// remind = hours between repeats of a red alert (0 = never).
function sxn_track(&$st, &$tm, $key, $level, $sig, $mk, $hook, $o = []) {
    $need = (int)($o['need'] ?? 1); $resolve = $o['resolve'] ?? true; $remind = (int)($o['remind'] ?? 0);
    $cur = $st['k'][$key] ?? null;
    if ($level !== '') {
        $tm['deb'][$key] = (int)($tm['deb'][$key] ?? 0) + 1;
        if ($tm['deb'][$key] < $need) { return; }
        $send = false;
        if ($cur === null) { $send = true; }
        elseif ($level === 'rd' && $cur['l'] === 'a') { $send = true; }
        elseif ((string)$sig !== (string)$cur['s']) { $send = true; }
        elseif ($level === 'rd' && $remind > 0 && time() - (int)$cur['t'] >= $remind * 3600) { $send = true; }
        if ($send) {
            $r = sxn_post($hook, [$mk('alert')], $level === 'rd' ? sxn_ping_set() : '');
            if ($r[0] === 'retry') { $tm['x']['err'] = $r[1]; return; }
            if ($r[0] === 'fail') { $tm['x']['err'] = $r[1]; }
            $st['k'][$key] = ['l' => $level, 's' => (string)$sig, 't' => time()];
            sxn_log($st, $key, $level);
        } elseif ($cur !== null && $cur['l'] !== $level) {
            $st['k'][$key]['l'] = $level;
        }
    } else {
        $tm['deb'][$key] = 0;
        if ($cur !== null) {
            if ($resolve) {
                $r = sxn_post($hook, [$mk('resolved')]);
                if ($r[0] === 'retry') { $tm['x']['err'] = $r[1]; return; }
                if ($r[0] === 'fail') { $tm['x']['err'] = $r[1]; }
            }
            unset($st['k'][$key]);
        }
    }
}

function sxn_cur_level($st, $key) { return $st['k'][$key]['l'] ?? ''; }

function sxn_fmt_bytes($b) {
    $b = (float)$b;
    if ($b >= 1e12) { return number_format($b / 1e12, $b >= 1e13 ? 1 : 2, '.', '') . ' TB'; }
    if ($b >= 1e9) { return number_format($b / 1e9, $b >= 1e11 ? 0 : 1, '.', '') . ' GB'; }
    if ($b >= 1e6) { return number_format($b / 1e6, 0, '.', '') . ' MB'; }
    return number_format($b / 1e3, 0, '.', '') . ' KB';
}

function sxn_fmt_dur($s) {
    $s = (int)$s; $d = intdiv($s, 86400); $h = intdiv($s % 86400, 3600); $m = intdiv($s % 3600, 60);
    return $d > 0 ? $d . ' d ' . $h . ' h' : ($h > 0 ? $h . ' h ' . $m . ' m' : $m . ' m');
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD ALERT TEXTS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/alerts.php">
<INLINE><![CDATA[<?php
// Sysbox Discord alerts: texts (Hungarian and English), data readers and message builders.

function sxn_t($lang, $k, $a = []) {
    static $T = [
      'hu' => [
        'ct_down' => '%s leállt', 'ct_down_d' => 'A konténer váratlanul leállt.', 'ct_up' => '%s újra fut',
        'exit' => 'Kilépési kód', 'oom' => 'Elfogyott a memória (OOM)', 'yes' => 'igen', 'status' => 'Állapot',
        'ct_loop' => '%s újra és újra újraindul', 'ct_loop_d' => '%s újraindulás az elmúlt %s percben.', 'ct_calm' => '%s már nem indul újra',
        'ct_unh' => '%s nem egészséges', 'ct_unh_d' => 'A konténer állapotellenőrzése hibát jelez.', 'ct_ok' => '%s újra egészséges',
        'ram_w' => 'Sok memória használt: %s%%', 'ram_c' => 'Majdnem elfogyott a memória: %s%%', 'ram_ok' => 'A memória használata rendben (%s%%)',
        'ram_d' => 'A ZFS cache nélkül számolva, mert az átadja a helyét a programoknak.', 'ram' => 'Memória', 'free' => 'Szabad', 'zfs' => 'ZFS cache',
        'st_w' => '%s telik: %s%%', 'st_c' => '%s majdnem megtelt: %s%%', 'st_ok' => '%s már nem tele (%s%%)',
        'used' => 'Használt', 'freev' => 'Szabad',
        'cpu_w' => 'A CPU melegszik: %s °C', 'cpu_c' => 'A CPU túl meleg: %s °C', 'cpu_ok' => 'A CPU lehűlt (%s °C)', 'limits' => 'Határok', 'limits_v' => 'figyelmeztetés %s °C · kritikus %s °C',
        'boot' => 'A szerver újraindult', 'boot_d' => 'Indulás ideje: %s.', 'seen' => 'Utoljára látva', 'upnow' => 'Üzemidő most', 'offline' => 'Kimaradás kb.',
        'wk' => 'Heti összefoglaló', 'uptime' => 'Üzemidő', 'reboots' => 'Újraindulás (7 nap)', 'alerts' => 'Riasztás (7 nap)', 'none' => 'nincs',
        'cpu_t' => 'CPU hőmérséklet', 'conts' => 'Konténerek', 'running' => 'fut', 'top' => 'Legtöbb memória', 'stor' => 'Tárhely', 'energy' => 'Áramfogyasztás (e hónap)',
        'cost' => 'költség', 'avg_day' => 'Átlagos napi fogyasztás', 'per_day' => 'nap', 'day_avg' => 'napi átlag', 'sample' => 'MINTA', 'test_t' => 'Sysbox teszt', 'test_d' => 'A Discord-értesítés működik.',
      ],
      'en' => [
        'ct_down' => '%s stopped', 'ct_down_d' => 'The container stopped unexpectedly.', 'ct_up' => '%s is running again',
        'exit' => 'Exit code', 'oom' => 'Ran out of memory (OOM)', 'yes' => 'yes', 'status' => 'Status',
        'ct_loop' => '%s keeps restarting', 'ct_loop_d' => '%s restarts in the last %s minutes.', 'ct_calm' => '%s has stopped restarting',
        'ct_unh' => '%s is unhealthy', 'ct_unh_d' => 'The container\'s health check is failing.', 'ct_ok' => '%s is healthy again',
        'ram_w' => 'High memory use: %s%%', 'ram_c' => 'Memory is almost exhausted: %s%%', 'ram_ok' => 'Memory use is fine again (%s%%)',
        'ram_d' => 'Counted without the ZFS cache, which gives way to applications.', 'ram' => 'Memory', 'free' => 'Free', 'zfs' => 'ZFS cache',
        'st_w' => '%s is filling up: %s%%', 'st_c' => '%s is almost full: %s%%', 'st_ok' => '%s is no longer full (%s%%)',
        'used' => 'Used', 'freev' => 'Free',
        'cpu_w' => 'The CPU is running hot: %s °C', 'cpu_c' => 'The CPU is too hot: %s °C', 'cpu_ok' => 'The CPU has cooled down (%s °C)', 'limits' => 'Limits', 'limits_v' => 'warning %s °C · critical %s °C',
        'boot' => 'The server restarted', 'boot_d' => 'Started at %s.', 'seen' => 'Last seen', 'upnow' => 'Uptime now', 'offline' => 'Down for about',
        'wk' => 'Weekly summary', 'uptime' => 'Uptime', 'reboots' => 'Restarts (7 days)', 'alerts' => 'Alerts (7 days)', 'none' => 'none',
        'cpu_t' => 'CPU temperature', 'conts' => 'Containers', 'running' => 'running', 'top' => 'Most memory', 'stor' => 'Storage', 'energy' => 'Energy (this month)',
        'cost' => 'cost', 'avg_day' => 'Average daily use', 'per_day' => 'day', 'day_avg' => 'day average', 'sample' => 'SAMPLE', 'test_t' => 'Sysbox test', 'test_d' => 'Discord notifications work.',
      ],
    ];
    $s = $T[$lang][$k] ?? ($T['en'][$k] ?? $k);
    return $a ? vsprintf($s, $a) : $s;
}

// ---- readers -----------------------------------------------------------------------------------
// name => [restart count, state, exit code, oom killed, health] or null when Docker is not available
function sxn_inspect() {
    $d = sx_docker();
    if ($d === '') { return null; }
    list($rc, $ids) = sx_run(escapeshellarg($d) . ' ps -aq --no-trunc', 8);
    if ($rc !== 0) { return null; }
    $ids = array_values(array_filter(array_map('trim', explode("\n", $ids)), function ($x) { return preg_match('/^[0-9a-f]{12,64}$/', $x); }));
    if (!$ids) { return []; }
    $fmt = "{{.Name}}|{{.RestartCount}}|{{.State.Status}}|{{.State.ExitCode}}|{{.State.OOMKilled}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}";
    list($rc, $txt) = sx_run(escapeshellarg($d) . ' inspect -f ' . escapeshellarg($fmt) . ' ' . implode(' ', array_map('escapeshellarg', $ids)), 15);
    if ($rc !== 0) { return null; }
    $out = [];
    foreach (explode("\n", $txt) as $l) {
        $p = explode('|', trim($l));
        if (count($p) < 6) { continue; }
        $n = ltrim($p[0], '/');
        if (!sx_valid_name($n)) { continue; }
        $out[$n] = ['restart' => (int)$p[1], 'state' => $p[2], 'exit' => (int)$p[3], 'oom' => ($p[4] === 'true'), 'health' => $p[5]];
    }
    return $out;
}

function sxn_mem() {
    $mi = [];
    foreach ((array)@file('/proc/meminfo', FILE_IGNORE_NEW_LINES) as $l) { if (preg_match('/^(\w+):\s+(\d+)/', $l, $m)) { $mi[$m[1]] = (float)$m[2] * 1024; } }
    $total = $mi['MemTotal'] ?? 0.0; $avail = $mi['MemAvailable'] ?? ($mi['MemFree'] ?? 0.0);
    $arc = 0.0;
    foreach ((array)@file('/proc/spl/kstat/zfs/arcstats', FILE_IGNORE_NEW_LINES) as $l) { if (preg_match('/^size\s+\d+\s+(\d+)/', $l, $m)) { $arc = (float)$m[1]; break; } }
    $used = max(0.0, $total - $avail); $arc = min($arc, $used);
    return ['total' => $total, 'avail' => $avail, 'arc' => $arc, 'app' => max(0.0, $used - $arc), 'pct' => $total > 0 ? max(0.0, $used - $arc) / $total * 100 : 0.0];
}

function sxn_fs($path) {
    $t = @disk_total_space($path); $f = @disk_free_space($path);
    if (!$t) { return null; }
    return ['size' => $t, 'used' => $t - $f, 'pct' => ($t - $f) / $t * 100];
}

function sxn_mounted($path) {
    foreach ((array)@file('/proc/mounts', FILE_IGNORE_NEW_LINES) as $l) { $p = explode(' ', $l); if (isset($p[1]) && $p[1] === $path) { return true; } }
    return false;
}

// ---- builders (kind: 'alert' | 'resolved') ------------------------------------------------------
function sxn_e_down($lang, $name, $exit, $oom, $kind) {
    if ($kind === 'resolved') { return sxn_embed('g', '🟢 ' . sxn_t($lang, 'ct_up', [$name])); }
    return sxn_embed('rd', '🔴 🐳 ' . sxn_t($lang, 'ct_down', [$name]), sxn_t($lang, 'ct_down_d'), [
        [sxn_t($lang, 'exit'), (string)$exit, true], [sxn_t($lang, 'oom'), $oom ? sxn_t($lang, 'yes') : '', true]]);
}
function sxn_e_loop($lang, $name, $n, $min, $exit, $kind) {
    if ($kind === 'resolved') { return sxn_embed('g', '🟢 ' . sxn_t($lang, 'ct_calm', [$name])); }
    return sxn_embed('rd', '🔴 🔁 ' . sxn_t($lang, 'ct_loop', [$name]), sxn_t($lang, 'ct_loop_d', [$n, $min]), [[sxn_t($lang, 'exit'), (string)$exit, true]]);
}
function sxn_e_unhealthy($lang, $name, $kind) {
    if ($kind === 'resolved') { return sxn_embed('g', '🟢 ' . sxn_t($lang, 'ct_ok', [$name])); }
    return sxn_embed('a', '🟡 🩺 ' . sxn_t($lang, 'ct_unh', [$name]), sxn_t($lang, 'ct_unh_d'));
}
function sxn_e_ram($lang, $m, $level, $kind) {
    $p = number_format($m['pct'], 0, '.', '');
    if ($kind === 'resolved') { return sxn_embed('g', '🟢 ' . sxn_t($lang, 'ram_ok', [$p])); }
    return sxn_embed($level, ($level === 'rd' ? '🔴 🧠 ' : '🟡 🧠 ') . sxn_t($lang, $level === 'rd' ? 'ram_c' : 'ram_w', [$p]), sxn_t($lang, 'ram_d'), [
        [sxn_t($lang, 'used'), sxn_fmt_bytes($m['app']) . ' / ' . sxn_fmt_bytes($m['total']), true],
        [sxn_t($lang, 'free'), sxn_fmt_bytes($m['avail']), true], [sxn_t($lang, 'zfs'), sxn_fmt_bytes($m['arc']), true]]);
}
function sxn_e_storage($lang, $label, $f, $level, $kind) {
    $p = number_format($f['pct'], 0, '.', '');
    if ($kind === 'resolved') { return sxn_embed('g', '🟢 ' . sxn_t($lang, 'st_ok', [$label, $p])); }
    return sxn_embed($level, ($level === 'rd' ? '🔴 💾 ' : '🟡 💾 ') . sxn_t($lang, $level === 'rd' ? 'st_c' : 'st_w', [$label, $p]), '', [
        [sxn_t($lang, 'used'), sxn_fmt_bytes($f['used']) . ' / ' . sxn_fmt_bytes($f['size']), true], [sxn_t($lang, 'freev'), sxn_fmt_bytes($f['size'] - $f['used']), true]]);
}
function sxn_e_cpu($lang, $temp, $warn, $crit, $level, $kind) {
    if ($kind === 'resolved') { return sxn_embed('g', '🟢 ' . sxn_t($lang, 'cpu_ok', [$temp])); }
    return sxn_embed($level, ($level === 'rd' ? '🔴 🌡️ ' : '🟡 🌡️ ') . sxn_t($lang, $level === 'rd' ? 'cpu_c' : 'cpu_w', [$temp]), '', [
        [sxn_t($lang, 'limits'), sxn_t($lang, 'limits_v', [(int)$warn, (int)$crit])]]);
}
function sxn_e_boot($lang, $bootTs, $seenTs) {
    $f = [[sxn_t($lang, 'upnow'), sxn_fmt_dur(max(0, time() - $bootTs)), true]];
    if ($seenTs > 0) {
        $f[] = [sxn_t($lang, 'seen'), date('Y-m-d H:i', $seenTs), true];
        $gap = $bootTs - $seenTs;
        if ($gap > 0) { $f[] = [sxn_t($lang, 'offline'), '≤ ' . sxn_fmt_dur($gap), true]; }
    }
    return sxn_embed('i', '🔌 ' . sxn_t($lang, 'boot'), sxn_t($lang, 'boot_d', [date('Y-m-d H:i', $bootTs)]), $f);
}

// Top containers by memory right now (name => bytes), best effort
function sxn_top_mem($n = 3) {
    $d = sx_docker();
    if ($d === '') { return []; }
    list($rc, $txt) = sx_run(escapeshellarg($d) . " stats --no-stream --format '{{.Name}}|{{.MemUsage}}'", 20);
    if ($rc !== 0) { return []; }
    $out = [];
    foreach (explode("\n", $txt) as $l) {
        $p = explode('|', trim($l));
        if (count($p) < 2 || !preg_match('/^([\d.]+)\s*([KMGT]?i?B)/i', $p[1], $m)) { continue; }
        $mul = ['b' => 1, 'kib' => 1024, 'mib' => 1048576, 'gib' => 1073741824, 'tib' => 1099511627776, 'kb' => 1e3, 'mb' => 1e6, 'gb' => 1e9, 'tb' => 1e12];
        $out[$p[0]] = (float)$m[1] * ($mul[strtolower($m[2])] ?? 1);
    }
    arsort($out);
    return array_slice($out, 0, $n, true);
}

function sxn_e_weekly($lang, $cfg, $st) {
    $cut = time() - 7 * 86400; $n = 0; $boots = 0; $by = ['ct' => 0, 'ram' => 0, 'st' => 0, 'cpu' => 0];
    foreach ($st['log'] ?? [] as $x) {
        if ($x[0] < $cut) { continue; }
        if ($x[1] === 'boot') { $boots++; continue; }
        $n++;
        $g = preg_match('/^(down|loop|unh):/', $x[1]) ? 'ct' : (strpos($x[1], 'st:') === 0 ? 'st' : ($x[1] === 'ram' ? 'ram' : ($x[1] === 'cpu_temp' ? 'cpu' : '')));
        if ($g !== '') { $by[$g]++; }
    }
    $up = (int)((float)@file_get_contents('/proc/uptime'));
    $m = sxn_mem();
    $lines = [];
    foreach ([['BOOT', '/boot'], ['LOG', '/var/log'], ['DOCKER VDISK', '/var/lib/docker']] as $x) {
        if ($x[1] === '/var/lib/docker' && !sxn_mounted($x[1])) { continue; }
        $f = sxn_fs($x[1]);
        if ($f) { $lines[] = str_pad($x[0], 13) . number_format($f['pct'], 0, '.', '') . '%'; }
    }
    list($tp,) = sx_temps();
    $ct = sxn_inspect();
    $run = 0; foreach ((array)$ct as $c) { if ($c['state'] === 'running') { $run++; } }
    $top = [];
    foreach (sxn_top_mem(3) as $name => $b) { $top[] = $name . ' · ' . sxn_fmt_bytes($b); }
    $fields = [
        [sxn_t($lang, 'uptime'), sxn_fmt_dur($up), true],
        [sxn_t($lang, 'reboots'), $boots > 0 ? (string)$boots : sxn_t($lang, 'none'), true],
        [sxn_t($lang, 'alerts'), $n > 0 ? $n . ' (' . implode(', ', array_map(function ($k, $v) { return $k . ' ' . $v; }, array_keys(array_filter($by)), array_filter($by))) . ')' : sxn_t($lang, 'none'), true],
        [sxn_t($lang, 'ram'), number_format($m['pct'], 0, '.', '') . '% · ' . sxn_fmt_bytes($m['app']) . ' / ' . sxn_fmt_bytes($m['total']), true],
        [sxn_t($lang, 'cpu_t'), $tp !== null ? $tp . ' °C' : '', true],
        [sxn_t($lang, 'conts'), $ct !== null ? $run . ' / ' . count($ct) . ' ' . sxn_t($lang, 'running') : '', true],
        [sxn_t($lang, 'top'), implode("\n", $top)],
    ];
    if (trim((string)$cfg['socket_host']) !== '') {
        require_once __DIR__ . '/energy.php';
        list($sk,) = sx_socket_fetch($cfg['socket_host'], (int)$cfg['socket_id']);
        if ($sk && $sk['total_wh'] !== null) {
            $kwh = sx_energy_month_wh($sk['total_wh']) / 1000;
            $t = number_format($kwh, 1, '.', '') . ' kWh';
            if (is_numeric($cfg['kwh_price'])) { $t .= ' · ' . sxn_t($lang, 'cost') . ' ' . number_format($kwh * (float)$cfg['kwh_price'], 0, '.', ' ') . ' ' . $cfg['currency']; }
            $fields[] = [sxn_t($lang, 'energy'), $t];
            sx_energy_days_update($sk['total_wh']);
            $avg = sx_energy_days_avg(7);
            if ($avg === null) {   // no complete day recorded yet: fall back to this month so far
                if ((int)date('j') > 1) { $avg = [$kwh * 1000 / (int)date('j'), 1]; }
            }
            if ($avg !== null) {
                $akwh = $avg[0] / 1000;
                $at = number_format($akwh, 1, '.', '') . ' kWh/' . sxn_t($lang, 'per_day') . ' · ≈ ' . number_format($avg[0] / 24, 0, '.', '') . ' W · ' . $avg[1] . ' ' . sxn_t($lang, 'day_avg');
                if (is_numeric($cfg['kwh_price'])) { $at .= ' · ' . number_format($akwh * (float)$cfg['kwh_price'], 0, '.', ' ') . ' ' . $cfg['currency'] . '/' . sxn_t($lang, 'per_day'); }
                $fields[] = [sxn_t($lang, 'avg_day'), $at];
            }
        }
    }
    return sxn_embed('i', '📊 ' . sxn_t($lang, 'wk'), $lines ? '```' . "\n" . implode("\n", $lines) . "\n" . '```' : '', $fields, sxn_t($lang, 'wk'));
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD ALERTS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/notify.php">
<INLINE><![CDATA[<?php
// Started by cron every minute: Discord alerts for containers, memory, storage, CPU temperature and restarts.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/discord.php';
require_once __DIR__ . '/alerts.php';

$cfg = sx_cfg();
$hook = (string)$cfg['dc_hook'];
if (!sxn_hook_ok($hook)) { exit(0); }
$lock = @fopen('/tmp/sysbox_notify.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

$lang = sxn_lang($cfg);
sxn_ping_set($cfg['dc_ping']);
$st = sxn_state(); $st0 = json_encode($st);
$tm = sxn_tmp();
$remind = max(0, (int)$cfg['n_remind']);
$now = time();

// ---- server restart ------------------------------------------------------------------------------
if (sx_on($cfg['n_boot'])) {
    $bid = trim((string)@file_get_contents('/proc/sys/kernel/random/boot_id'));
    $bootTs = $now - (int)((float)@file_get_contents('/proc/uptime'));
    $prevId = (string)($st['misc']['boot_id'] ?? '');
    $seen = (int)($st['misc']['seen'] ?? 0);
    if ($bid !== '' && $bid !== $prevId) {
        $send = ($prevId !== '');
        if ($send) {
            $r = sxn_post($hook, [sxn_e_boot($lang, $bootTs, $seen)]);
            if ($r[0] === 'retry') { $send = null; } else { sxn_log($st, 'boot', 'i'); }
        }
        if ($send !== null) { $st['misc']['boot_id'] = $bid; $st['misc']['seen'] = $now; }
    } elseif ($now - $seen >= 1800) { $st['misc']['seen'] = $now; }   // written to flash at most every 30 minutes
}

// ---- containers ------------------------------------------------------------------------------------
$ct = sx_on($cfg['n_containers']) ? sxn_inspect() : null;
if ($ct !== null) {
    $stop = is_file('/tmp/sysbox_userstop.json') ? (json_decode((string)@file_get_contents('/tmp/sysbox_userstop.json'), true) ?: []) : [];
    foreach ($ct as $name => $c) {
        $s = $tm['x']['ct'][$name] ?? ['up' => false, 'dn' => 0, 'al' => false, 'h' => []];

        // stopped unexpectedly: it ran at the last check, and its exit was not a normal one (0 or SIGTERM) nor made from the dashboard
        if (in_array($c['state'], ['running', 'restarting', 'paused'], true)) { $s['up'] = true; $s['dn'] = 0; $s['al'] = false; }
        elseif ($s['up']) {
            $s['dn']++;
            if ($s['dn'] >= 2) {
                $byUser = isset($stop[$name]) && ($now - (int)$stop[$name]) < 900;
                $s['al'] = (!$byUser && !in_array($c['exit'], [0, 143], true)) || $c['oom'];
                $s['up'] = false;
            }
        }
        $ex = $c['exit']; $oom = $c['oom'];
        sxn_track($st, $tm, 'down:' . $name, $s['al'] ? 'rd' : '', (string)$ex, function ($kind) use ($lang, $name, $ex, $oom) {
            return sxn_e_down($lang, $name, $ex, $oom, $kind);
        }, $hook, ['remind' => $remind]);

        // restart loop: three or more restarts within ten minutes
        $h = $s['h'];
        $h[] = [$now, $c['restart']];
        $h = array_values(array_filter($h, function ($x) use ($now) { return $x[0] >= $now - 600; }));
        $delta = $c['restart'] - $h[0][1];
        if ($delta < 0) { $h = [[$now, $c['restart']]]; $delta = 0; }
        $s['h'] = $h;
        $active = (sxn_cur_level($st, 'loop:' . $name) !== '');
        $lvl = ($delta >= 3 || ($active && $delta > 0)) ? 'rd' : '';
        sxn_track($st, $tm, 'loop:' . $name, $lvl, '', function ($kind) use ($lang, $name, $delta, $ex) {
            return sxn_e_loop($lang, $name, $delta, 10, $ex, $kind);
        }, $hook, ['remind' => $remind]);

        // unhealthy for three minutes in a row
        sxn_track($st, $tm, 'unh:' . $name, ($c['health'] === 'unhealthy' && $c['state'] === 'running') ? 'a' : '', '', function ($kind) use ($lang, $name) {
            return sxn_e_unhealthy($lang, $name, $kind);
        }, $hook, ['need' => 3]);

        $tm['x']['ct'][$name] = $s;
    }
    // forget containers that were deleted
    foreach (array_keys($st['k']) as $k) {
        if (preg_match('/^(down|loop|unh):(.+)$/', $k, $m) && !isset($ct[$m[2]])) { unset($st['k'][$k]); }
    }
    foreach (array_keys($tm['x']['ct'] ?? []) as $n) { if (!isset($ct[$n])) { unset($tm['x']['ct'][$n]); } }
}

// ---- memory ----------------------------------------------------------------------------------------
if (sx_on($cfg['n_ram'])) {
    $m = sxn_mem();
    $w = (float)$cfg['ram_warn']; $c = (float)$cfg['ram_crit'];
    $lv = $m['pct'] >= $c ? 'rd' : ($m['pct'] >= $w ? 'a' : '');
    $prev = sxn_cur_level($st, 'ram');
    if ($lv === '' && $prev !== '' && $m['pct'] >= $w - 3) { $lv = $prev; }
    sxn_track($st, $tm, 'ram', $lv, '', function ($kind) use ($lang, $m, $lv) { return sxn_e_ram($lang, $m, $lv, $kind); }, $hook, ['need' => 5, 'remind' => $remind]);
}

// ---- storage ---------------------------------------------------------------------------------------
if (sx_on($cfg['n_storage'])) {
    $items = [['BOOT', '/boot', 90, 97, 'boot'], ['LOG', '/var/log', (float)$cfg['log_warn'], (float)$cfg['log_crit'], 'log']];
    if (sxn_mounted('/var/lib/docker')) { $items[] = ['DOCKER VDISK', '/var/lib/docker', (float)$cfg['vd_warn'], (float)$cfg['vd_crit'], 'vdisk']; }
    foreach ($items as $it) {
        $f = sxn_fs($it[1]);
        if (!$f) { continue; }
        $key = 'st:' . $it[4];
        $lv = $f['pct'] >= $it[3] ? 'rd' : ($f['pct'] >= $it[2] ? 'a' : '');
        $prev = sxn_cur_level($st, $key);
        if ($lv === '' && $prev !== '' && $f['pct'] >= $it[2] - 3) { $lv = $prev; }
        $label = $it[0];
        sxn_track($st, $tm, $key, $lv, '', function ($kind) use ($lang, $label, $f, $lv) { return sxn_e_storage($lang, $label, $f, $lv, $kind); }, $hook, ['need' => 2, 'remind' => $remind]);
    }
}

// ---- CPU temperature ---------------------------------------------------------------------------------
if (sx_on($cfg['n_cpu'])) {
    list($tp,) = sx_temps();
    if ($tp !== null) {
        $w = (float)$cfg['temp_warn']; $c = (float)$cfg['temp_crit'];
        $lv = $tp >= $c ? 'rd' : ($tp >= $w ? 'a' : '');
        $prev = sxn_cur_level($st, 'cpu_temp');
        if ($lv === '' && $prev !== '' && $tp >= $w - 3) { $lv = $prev; }
        sxn_track($st, $tm, 'cpu_temp', $lv, '', function ($kind) use ($lang, $tp, $w, $c, $lv) { return sxn_e_cpu($lang, $tp, $w, $c, $lv, $kind); }, $hook, ['need' => 5, 'remind' => $remind]);
    }
}

if (json_encode($st) !== $st0) { sxn_write(SXN_STATE, $st); }
sxn_write(SXN_TMP, $tm);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD WEEKLY -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/weekly.php">
<INLINE><![CDATA[<?php
// Started by cron every hour: sends the weekly summary once, on the chosen day, from the chosen hour.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/discord.php';
require_once __DIR__ . '/alerts.php';

$cfg = sx_cfg();
$hook = (string)$cfg['dc_hook'];
if (!sxn_hook_ok($hook) || !sx_on($cfg['wk_on'])) { exit(0); }
if ((int)date('N') !== (int)$cfg['wk_day'] || (int)date('G') < (int)$cfg['wk_hour']) { exit(0); }
$lock = @fopen('/tmp/sysbox_weekly.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

$st = sxn_state();
$week = date('o-W');
if (($st['misc']['wk_last'] ?? '') === $week) { exit(0); }
$r = sxn_post($hook, [sxn_e_weekly(sxn_lang($cfg), $cfg, $st)]);
if ($r[0] === 'retry') { exit(0); }
$st['misc']['wk_last'] = $week;
sxn_write(SXN_STATE, $st);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD TEST -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/test.php">
<INLINE><![CDATA[<?php
// Test and sample messages for the Discord alerts. POST op=test|sample|weekly (uses the saved settings).
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/discord.php';
require_once __DIR__ . '/alerts.php';

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { sx_json(['ok' => false, 'error' => 'method'], 405); }
sx_guard();
$cfg = sx_cfg();
$hook = (string)$cfg['dc_hook'];
if (!sxn_hook_ok($hook)) { sx_json(['ok' => false, 'error' => 'No valid Discord webhook is saved yet. Enter it, press Apply, then try again.']); }
$lang = sxn_lang($cfg);
$op = (string)($_POST['op'] ?? 'test');

if ($op === 'weekly') {
    $r = sxn_post($hook, [sxn_e_weekly($lang, $cfg, sxn_state())]);
    sx_json($r[0] === 'ok' ? ['ok' => true] : ['ok' => false, 'error' => $r[1]]);
}
if ($op === 'sample') {
    $tag = '[' . sxn_t($lang, 'sample') . '] ';
    $m = ['total' => 33.4e9, 'avail' => 3.1e9, 'arc' => 1.1e9, 'app' => 29.2e9, 'pct' => 93.0];
    $emb = [
        sxn_e_down($lang, 'jellyfin', 137, true, 'alert'),
        sxn_e_loop($lang, 'qbittorrent', 5, 10, 1, 'alert'),
        sxn_e_unhealthy($lang, 'seerr', 'alert'),
        sxn_e_ram($lang, $m, 'rd', 'alert'),
        sxn_e_storage($lang, 'DOCKER VDISK', ['size' => 53.6e9, 'used' => 49.3e9, 'pct' => 92.0], 'rd', 'alert'),
        sxn_e_cpu($lang, 82, 75, 90, 'a', 'alert'),
        sxn_e_boot($lang, time() - 420, time() - 1500),
        sxn_e_down($lang, 'jellyfin', 0, false, 'resolved'),
    ];
    foreach ($emb as $e) {
        $e['title'] = $tag . $e['title'];
        $r = sxn_post($hook, [$e]);
        if ($r[0] !== 'ok') { sx_json(['ok' => false, 'error' => $r[1]]); }
    }
    sx_json(['ok' => true]);
}
$r = sxn_post($hook, [sxn_embed('i', '✅ ' . sxn_t($lang, 'test_t'), sxn_t($lang, 'test_d'))], sxn_ping_text($cfg['dc_ping']));
sx_json($r[0] === 'ok' ? ['ok' => true] : ['ok' => false, 'error' => $r[1]]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- README -->
<!-- ========================================================= -->
<FILE Name="/usr/local/emhttp/plugins/Sysbox/README.md">
<INLINE><![CDATA[**Sysbox** replaces the System and Processor dashboard tiles with one native-looking tile: memory as a single bar (system, ZFS cache, Docker, free), boot, log and Docker vdisk usage, CPU load with history, temperature, power and per-thread heat map, the Intel GPU engines, wall power from a Shelly smart socket with the monthly kWh, and a list of containers (busiest or selected) with start, stop, restart and log buttons. Anything that needs attention is listed at the top.

Settings: Settings, Utilities, Sysbox (or the gear icon on the tile).
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SHARED LANGUAGE SETTING -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/lang.php">
<INLINE><![CDATA[<?php
// Shared language setting of the media server tools (Sysbox, Diskbox, Seedbox, Streambox): one file on the
// flash drive that every plugin reads, so changing it on any settings page changes it for all of them.
//   ui      = auto (follow Unraid's language, Settings, Display Settings) | en
//   discord = auto (follow Unraid) | en | hu
// A language the pages or Discord are not translated to falls back to English. Every plugin ships its own
// copy of this file; the guard keeps a second copy from being declared again in the same request.
if (!function_exists('mt_lang_cfg')) {

define('MT_LANG_FILE', '/boot/config/plugins/mediaserver-tools/lang.cfg');

function mt_lang_have($what) { return $what === 'discord' ? ['en', 'hu'] : ['en']; }

// Unraid's display language as a locale ('' = English, the built-in one)
function mt_lang_unraid() {
    $d = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true);
    return (is_array($d) && isset($d['display']) && is_array($d['display'])) ? trim((string)($d['display']['locale'] ?? '')) : '';
}
function mt_lang_code($locale) { $c = strtolower(substr((string)$locale, 0, 2)); return preg_match('/^[a-z]{2}$/', $c) ? $c : 'en'; }
function mt_lang_name($code) {
    $n = ['en' => 'English', 'hu' => 'Magyar', 'de' => 'Deutsch', 'fr' => 'Français', 'es' => 'Español', 'it' => 'Italiano', 'nl' => 'Nederlands',
          'pl' => 'Polski', 'pt' => 'Português', 'ru' => 'Русский', 'zh' => '中文', 'ja' => '日本語', 'ko' => '한국어', 'cs' => 'Čeština', 'sv' => 'Svenska'];
    return $n[$code] ?? $code;
}

// Before the shared setting existed every plugin had its own Discord language, Hungarian by default: a server
// that already sends Discord messages keeps the language it had; a new install starts in English.
function mt_lang_legacy() {
    $ini = function ($f) { $c = is_file($f) ? @parse_ini_file($f, false, INI_SCANNER_RAW) : false; return is_array($c) ? $c : null; };
    foreach (['/boot/config/plugins/sysbox/settings.cfg', '/boot/config/plugins/diskbox/settings.cfg'] as $f) {
        $c = $ini($f);
        if ($c === null) { continue; }
        if (isset($c['dc_lang'])) { return trim((string)$c['dc_lang'], "\"' ") === 'en' ? 'en' : 'hu'; }
        if (trim((string)($c['dc_hook'] ?? ''), "\"' ") !== '') { return 'hu'; }
    }
    $j = @json_decode((string)@file_get_contents('/boot/config/plugins/qbittorrent_widget/tools.json'), true);
    if (is_array($j)) {
        if (isset($j['dc_lang'])) { return $j['dc_lang'] === 'en' ? 'en' : 'hu'; }
        if (trim((string)($j['dc_hook'] ?? '')) !== '') { return 'hu'; }
    }
    $c = $ini('/boot/config/plugins/streambox/settings.cfg');
    if ($c !== null && (trim((string)($c['dc_movies'] ?? ''), "\"' ") !== '' || trim((string)($c['dc_series'] ?? ''), "\"' ") !== '')) { return 'hu'; }
    return 'en';
}

function mt_lang_cfg() {
    $c = ['ui' => 'auto', 'discord' => ''];
    $f = is_file(MT_LANG_FILE) ? @parse_ini_file(MT_LANG_FILE) : false;
    if (is_array($f)) {
        if (in_array($f['ui'] ?? '', ['auto', 'en'], true)) { $c['ui'] = $f['ui']; }
        if (in_array($f['discord'] ?? '', ['auto', 'en', 'hu'], true)) { $c['discord'] = $f['discord']; }
    }
    if ($c['discord'] === '') { $c['discord'] = mt_lang_legacy(); }
    return $c;
}

// The language the pages and tiles use, and the one Discord messages use (always one that exists)
function mt_lang_ui() {
    $c = mt_lang_cfg();
    $w = $c['ui'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['ui'];
    return in_array($w, mt_lang_have('ui'), true) ? $w : 'en';
}
function mt_lang_discord() {
    static $l = null;
    if ($l !== null) { return $l; }
    $c = mt_lang_cfg();
    $w = $c['discord'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['discord'];
    return $l = in_array($w, mt_lang_have('discord'), true) ? $w : 'en';
}

function mt_lang_save($ui, $discord) {
    if (!in_array($ui, ['auto', 'en'], true) || !in_array($discord, ['auto', 'en', 'hu'], true)) { return false; }
    @mkdir(dirname(MT_LANG_FILE), 0777, true);
    $tmp = MT_LANG_FILE . '.tmp';
    if (@file_put_contents($tmp, 'ui="' . $ui . "\"\ndiscord=\"" . $discord . "\"\n") === false) { return false; }
    return @rename($tmp, MT_LANG_FILE);
}

}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- LANGUAGE BLOCK OF THE SETTINGS PAGE -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/lang_block.php">
<INLINE><![CDATA[<?php
// The Language block of every settings page (Sysbox, Diskbox, Seedbox Tools, Streambox): the shared setting of
// lang.php. The page sets $mt_lang_post (this plugin's lang_save.php) and includes this file.
require_once __DIR__ . '/lang.php';
$mtl_c = mt_lang_cfg();
$mtl_u = mt_lang_code(mt_lang_unraid());
$mtl_var = @parse_ini_file('/var/local/emhttp/var.ini');
$mtl_tok = is_array($mtl_var) ? (string)($mtl_var['csrf_token'] ?? '') : '';
$mtl_ui_now = in_array($mtl_u, mt_lang_have('ui'), true) ? mt_lang_name($mtl_u) : mt_lang_name($mtl_u) . ', shown in English';
$mtl_dc_now = in_array($mtl_u, mt_lang_have('discord'), true) ? mt_lang_name($mtl_u) : mt_lang_name($mtl_u) . ', sent in English';
$mtl_h = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES); };
$mtl_sel = function ($a, $b) { return $a === $b ? ' selected' : ''; };
?>
<style>
#mtl{margin:28px 0 8px;max-width:1100px}
#mtl .mtl-band{display:flex;justify-content:space-between;align-items:center;gap:12px;background:rgba(0,0,0,.35);padding:10px 14px;text-transform:uppercase;letter-spacing:1.5px;font-size:12px}
#mtl .mtl-band b{font-weight:normal;text-transform:none;letter-spacing:0;opacity:.6}
#mtl .mtl-box{background:rgba(128,128,128,.08);border-radius:0 0 6px 6px}
#mtl .mtl-row{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px;padding:14px 16px;border-left:3px solid #8a8a8a;border-bottom:1px solid rgba(128,128,128,.15)}
#mtl .mtl-row label{padding-top:6px}
#mtl .mtl-row select{width:auto;min-width:260px;max-width:100%;margin:0}
#mtl .mtl-hint{display:block;opacity:.6;line-height:1.5;margin-top:6px;white-space:normal}
#mtl .mtl-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px}
#mtl .mtl-foot button{margin:0}
@media (max-width:700px){#mtl .mtl-row{grid-template-columns:1fr;gap:4px}}
</style>
<div id="mtl">
  <div class="mtl-band"><span>Language</span><b>shared by Sysbox, Diskbox, Seedbox and Streambox</b></div>
  <div class="mtl-box">
    <div class="mtl-row">
      <label for="mtl-ui">Pages and tiles:</label>
      <div>
        <select id="mtl-ui">
          <option value="auto"<?=$mtl_sel($mtl_c['ui'], 'auto')?>>Follow Unraid (now: <?=$mtl_h($mtl_ui_now)?>)</option>
          <option value="en"<?=$mtl_sel($mtl_c['ui'], 'en')?>>English</option>
        </select>
        <span class="mtl-hint">Unraid's language is set under Settings, Display Settings. A language the plugins are not translated to yet shows in English. More languages come here as they are translated.</span>
      </div>
    </div>
    <div class="mtl-row">
      <label for="mtl-dc">Discord messages:</label>
      <div>
        <select id="mtl-dc">
          <option value="auto"<?=$mtl_sel($mtl_c['discord'], 'auto')?>>Follow Unraid (now: <?=$mtl_h($mtl_dc_now)?>)</option>
          <option value="en"<?=$mtl_sel($mtl_c['discord'], 'en')?>>English</option>
          <option value="hu"<?=$mtl_sel($mtl_c['discord'], 'hu')?>>Magyar</option>
        </select>
        <span class="mtl-hint">Every message of the four plugins: alerts, weekly summaries, new movies and series, the Discord bot. Movie and series titles stay as Jellyfin and Sonarr give them.</span>
      </div>
    </div>
    <div class="mtl-foot">
      <span id="mtl-msg" class="mtl-hint" style="margin:0">Saved for all plugins at once.</span>
      <button type="button" id="mtl-apply">Save language</button>
    </div>
  </div>
</div>
<script>
$(function () {
  // Unraid disables the Apply buttons of a page until its form changes: this block is outside every form, so it is a
  // button of its own name, enabled here (also after Unraid's own page scripts ran)
  var en = function () { $('#mtl-apply').prop('disabled', false).removeAttr('disabled'); };
  en(); setTimeout(en, 500); $('#mtl-ui, #mtl-dc').on('change', en);
  $('#mtl-apply').on('click', function () {
    var $b = $(this).prop('disabled', true), $m = $('#mtl-msg');
    $.post(<?=json_encode((string)$mt_lang_post)?>, { ui: $('#mtl-ui').val(), discord: $('#mtl-dc').val(), csrf_token: <?=json_encode($mtl_tok)?> }, null, 'json')
      .done(function (r) { $m.css({ color: r.ok ? '#3fa24a' : '#e5534b', opacity: 1 }).text(r.ok ? 'Saved for Sysbox, Diskbox, Seedbox and Streambox.' : (r.error || 'Not saved')); })
      .fail(function (x) { $m.css({ color: '#e5534b', opacity: 1 }).text((x.responseJSON && x.responseJSON.error) || 'Not saved'); })
      .always(function () { $b.prop('disabled', false); });
  });
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- LANGUAGE SAVE -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/lang_save.php">
<INLINE><![CDATA[<?php
// Saves the shared language setting (see lang.php). POST ui, discord, csrf_token.
require_once __DIR__ . '/lang.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function mt_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra)); exit; }
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); mt_out(false, ['error' => 'method']); }
$var = @parse_ini_file('/var/local/emhttp/var.ini');
$tok = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
if ($tok === '' || !hash_equals($tok, (string)($_POST['csrf_token'] ?? ''))) { http_response_code(403); mt_out(false, ['error' => 'csrf token mismatch']); }
if (!mt_lang_save((string)($_POST['ui'] ?? ''), (string)($_POST['discord'] ?? ''))) { mt_out(false, ['error' => 'could not save the language setting']); }
mt_out(true);
]]></INLINE>
</FILE>

