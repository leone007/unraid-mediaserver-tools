<INLINE><![CDATA[Menu="Utilities"
Type="xmenu"
Title="Network"
Icon="sysbox.png"
Markdown="false"
---
<?PHP
// texts from the dictionary (lang/en.json, see i18n.php)
require_once '/usr/local/emhttp/plugins/sysbox/i18n.php';
$nwp_lang = '/usr/local/emhttp/plugins/sysbox/lang';
$nwp_T = mt_i18n_t($nwp_lang);
$nwp_t = function ($k, $v = []) use ($nwp_T) { return htmlspecialchars($nwp_T($k, $v), ENT_QUOTES); };
?>
<style>
/* the Dashboard tile look (common/tile.css, inserted by the build): now, traffic, totals, containers, outages, settings */
/* Shared tile look (the Sysbox / Diskbox style): dark section bands, the content in a box under them, colored left stripes on rows.
   Used by Seedbox and Streambox; the build copies this block into each plugin's page where the marker below stands. */
.mt-band{display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(0,0,0,.25);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:7px 10px;margin-top:14px}
.mt-band.mt-first{margin-top:6px}
.mt-band span{opacity:.75}
.mt-band b{font-weight:400;opacity:.5;text-transform:none;letter-spacing:0;text-align:right}
.mt-band.mt-red span{color:#e5534b;opacity:1}
.mt-box{background:rgba(128,128,128,.12);margin-top:8px}
.mt-cols{display:grid;gap:8px;align-items:center;padding:6px 10px 4px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid rgba(128,128,128,.2)}
.mt-cols>div{opacity:.6}
.mt-r{display:grid;gap:8px;align-items:center;padding:8px 10px;border-top:1px solid rgba(128,128,128,.2)}
.mt-box>.mt-r:first-child,.mt-cols+.mt-r{border-top:0}
.mt-s-orange{background:rgba(245,165,36,.10);box-shadow:inset 3px 0 0 #f5a524}
.mt-s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
.mt-s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
.mt-s-red{background:rgba(229,83,75,.14);box-shadow:inset 3px 0 0 #e5534b}
.mt-s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
.mt-s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
.mt-s-grey{background:rgba(128,128,128,.08);box-shadow:inset 3px 0 0 #8a8a8a}
.mt-box .mt-n{background:none}
.mt-note{padding:8px 10px;text-align:center;font-style:italic;opacity:.6}
#nwp{--nwp-line:rgba(128,128,128,.22)}
#nwp .nwp-mut{opacity:.6}
#nwp .nwp-ok{color:#3fa24a}#nwp .nwp-er{color:#e5534b}#nwp .nwp-am{color:#d9921f}#nwp .nwp-dn{color:#3fa24a}#nwp .nwp-up{color:#4a90e2}
#nwp .nwp-sub{opacity:.65;margin:4px 0 0;max-width:120ch}
#nwp .mt-band{margin-top:26px;padding:9px 12px}
#nwp .mt-band span{font-weight:600}
#nwp .mt-box{margin-top:8px}
#nwp .mt-box>:first-child{border-top:0}
#nwp .nwp-lead{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;padding:10px 12px}
#nwp .nwp-lead p{margin:0;max-width:95ch;flex:1 1 380px}
#nwp .nwp-status{display:flex;flex-wrap:wrap;gap:6px 18px;align-items:center;padding:9px 12px;border-top:1px solid var(--nwp-line);font-size:12px}
#nwp .nwp-status span{opacity:.75}#nwp .nwp-status b{font-variant-numeric:tabular-nums}
#nwp input.nwp-ghost{color:inherit!important;opacity:.7;border-color:rgba(128,128,128,.45)!important}
#nwp input.nwp-sm{padding:2px 8px!important;font-size:11px!important;letter-spacing:0!important;text-transform:none!important;margin:0!important;min-width:0}
#nwp .nwp-chart{padding:10px 12px}
#nwp .nwp-chart svg{display:block;width:100%;height:190px}
#nwp .nwp-leg{display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px 12px;font-size:12px;opacity:.75;margin-top:4px}
#nwp .nwp-leg i{display:inline-block;width:10px;height:3px;margin:0 5px 2px 10px;vertical-align:middle}
#nwp .nwp-tabs{display:inline-flex;gap:4px}
#nwp .nwp-tabs a{font-size:11px;letter-spacing:0;text-transform:none;padding:2px 9px;border-radius:3px;background:rgba(128,128,128,.18);color:inherit;opacity:.7;cursor:pointer}
#nwp .nwp-tabs a.on{opacity:1;background:rgba(128,128,128,.45)}
#nwp .nwp-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px;align-items:end;height:120px;padding:12px 12px 0}
#nwp .nwp-day{display:flex;flex-direction:column;justify-content:flex-end;height:100%;gap:1px}
#nwp .nwp-day i{display:block;border-radius:2px 2px 0 0;min-height:1px}
#nwp .nwp-dlab{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px;padding:4px 12px 0;font-size:11px;text-align:center;opacity:.7;font-variant-numeric:tabular-nums}
#nwp .nwp-dlab b{display:block;font-weight:600}
#nwp .nwp-kp{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:12px}
#nwp .nwp-kp .k{font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6}
#nwp .nwp-kp .v{font-size:20px;font-weight:600;font-variant-numeric:tabular-nums}
#nwp .nwp-kp .v small{font-size:12px;font-weight:400;opacity:.65}
#nwp .nwp-kp .s{font-size:12px;opacity:.65}
#nwp .nwp-row{display:grid;gap:10px;align-items:center;padding:8px 12px;border-top:1px solid var(--nwp-line)}
#nwp .nwp-row small{display:block;opacity:.6}
#nwp .nwp-ct{grid-template-columns:minmax(0,1fr) 150px 100px 100px}
#nwp .nwp-ct.h{font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6}
#nwp .nwp-num{font-family:monospace;text-align:right;white-space:nowrap}
#nwp .nwp-ev{grid-template-columns:minmax(0,1fr) auto}
#nwp .s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
#nwp .s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
#nwp .s-red{background:rgba(229,83,75,.13);box-shadow:inset 3px 0 0 #e5534b}
#nwp .s-grey{background:rgba(128,128,128,.07);box-shadow:inset 3px 0 0 #8a8a8a}
#nwp .nwp-gbar{display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:8px;align-items:center;padding:10px 12px;border-top:1px solid var(--nwp-line);cursor:pointer;font-weight:600}
#nwp .nwp-gbar .c{font-weight:normal;font-size:12px;opacity:.7}
#nwp .nwp-set{grid-template-columns:minmax(200px,280px) minmax(0,1fr)}
#nwp .nwp-set .lb{opacity:.75}
#nwp .nwp-ctl{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center}
#nwp .nwp-ctl input[type=number]{width:80px!important;margin:0}
#nwp .nwp-ctl input[type=text]{width:220px;margin:0}
#nwp .nwp-ctl select{min-width:0!important;width:auto!important;margin:0}
#nwp .nwp-ctl label{display:inline-flex;align-items:center;gap:6px}
#nwp .nwp-ctl input[type=checkbox]{margin:0}
#nwp .nwp-hint{flex:1 1 100%;opacity:.55;font-size:12px}
@media (max-width:760px){#nwp .nwp-ct{grid-template-columns:minmax(0,1fr) 120px}#nwp .nwp-ct>:nth-child(n+3){display:none}#nwp .nwp-set{grid-template-columns:1fr}#nwp .nwp-kp{grid-template-columns:1fr 1fr}}
</style>
<div id="nwp">
<p class="nwp-sub"><?=$nwp_t('netp.intro')?></p>

<div class="mt-band"><span><?=$nwp_t('netp.h.now')?></span><b id="nwp-nband"></b></div>
<div class="mt-box" id="nwp-now"><div class="nwp-status nwp-mut"><?=$nwp_t('netp.loading')?></div></div>

<div class="mt-band"><span><?=$nwp_t('netp.h.traffic')?></span><span class="nwp-tabs" id="nwp-tabs"><a data-r="1h">1 h</a><a data-r="24h" class="on">24 h</a><a data-r="7d">7 d</a></span></div>
<div class="mt-box nwp-chart" id="nwp-chart"></div>

<div class="mt-band"><span><?=$nwp_t('netp.h.totals')?></span><b><?=$nwp_t('netp.h.totals_sub')?></b></div>
<div class="mt-box" id="nwp-tot"></div>

<div class="mt-band"><span><?=$nwp_t('netp.h.containers')?></span><b><?=$nwp_t('netp.h.containers_sub')?></b></div>
<div class="mt-box" id="nwp-ct"></div>

<div class="mt-band"><span><?=$nwp_t('netp.h.outages')?></span><b id="nwp-oband"></b></div>
<div class="mt-box" id="nwp-ev"></div>

<div class="mt-band"><span><?=$nwp_t('netp.h.settings')?></span><b><?=$nwp_t('netp.h.settings_sub')?></b></div>
<div class="mt-box" id="nwp-set"></div>
</div>

<?=mt_i18n_js($nwp_lang, 'nwp', ['netp.', 'net.'])?>
<script>
$(function () {
  var T = function (k, v) { return MTL.t('nwp', k, v); };
  var URL = '/plugins/sysbox/net.php', pollT = null, D = null, RANGE = '24h', OPEN = false, IP = null, CHK = null, setDrawn = false;
  function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
  function err(x) { return (x && x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : (x && x.error) ? x.error : 'HTTP ' + (x && x.status); }
  function fb(b) { b = +b || 0; if (b >= 1e12) return (b / 1e12).toFixed(2) + ' TB'; if (b >= 1e9) return (b / 1e9).toFixed(b >= 1e11 ? 0 : 1) + ' GB'; if (b >= 1e6) return (b / 1e6).toFixed(0) + ' MB'; return Math.round(b / 1e3) + ' KB'; }
  function unit() { return (D && D.cfg && D.cfg.unit === 'Mbit') ? 'Mbit' : 'MB'; }
  function ut() { return unit() === 'Mbit' ? 'Mbit/s' : 'MB/s'; }
  function rv(b) { return unit() === 'Mbit' ? (+b || 0) * 8 / 1e6 : (+b || 0) / 1e6; }
  function fr(b) { var v = rv(b); return v >= 100 ? v.toFixed(0) : v.toFixed(v >= 10 ? 1 : 2); }
  function two(n) { return ('0' + n).slice(-2); }
  function hm(ts) { var d = new Date(ts * 1000); return two(d.getHours()) + ':' + two(d.getMinutes()); }
  function dayLab(ts) { var d = new Date(ts * 1000); return T('netp.dow.' + d.getDay()) + ' ' + d.getDate(); }
  function linkTxt(sp) { return !sp ? '' : (sp >= 1000 ? (sp / 1000).toString().replace(/\.0$/, '') + ' Gbit/s' : sp + ' Mbit/s'); }
  function api(op, data) { return $.post(URL, $.extend({op: op}, data || {}), null, 'json'); }

  // ---- now
  function drawNow() {
    var L = D.live, $b = $('#nwp-now').empty();
    if (!D.on) { $b.append($('<div class="nwp-lead">').append($('<p>').html(esc(T('netp.off')) + ' <a href="/Settings/SysboxSettings">' + esc(T('netp.off_link')) + '</a>'))); $('#nwp-nband').text(''); return; }
    if (!L || !D.running) { $b.append($('<div class="nwp-status nwp-mut">').text(T('netp.starting'))); $('#nwp-nband').text(''); return; }
    var I = L.inet || {}, st = I.state || 'wait', cls = { ok: 'nwp-ok', slow: 'nwp-am', down: 'nwp-er', norouter: 'nwp-er' }[st] || 'nwp-mut';
    var top = null; $.each(L.ct || {}, function (n, r) { if (!top || r[0] + r[1] > top[1]) { top = [n, r[0] + r[1]]; } });
    var tot = (L.rate[0] + L.rate[1]) || 0, share = (top && tot > 0 && top[1] > 0) ? Math.min(100, Math.round(top[1] / tot * 100)) : 0;
    var lead = '<b class="' + cls + '">' + esc(T('net.inet_' + st)) + '.</b> ' + esc(T('netp.lead', { d: fr(L.rate[0]), u: fr(L.rate[1]), unit: ut() }));
    if (share >= 10) { lead += ' ' + esc(T('netp.lead_top', { c: top[0], p: share })); }
    $b.append($('<div class="nwp-lead">').append($('<p>').html(lead), $('<span>').append(
      $('<input type="button" class="nwp-chk nwp-ghost nwp-sm">').val(T('netp.check_now')), document.createTextNode(' '),
      $('<input type="button" class="nwp-ip nwp-ghost nwp-sm">').val(T('netp.show_ip')))));
    var k = L.link || {}, $s = $('<div class="nwp-status">');
    function it(label, val) { $s.append($('<span>').text(label + ' '), $('<b>').text(val)); }
    it(L.iface, (k.speed ? linkTxt(k.speed) : '?') + (k.duplex ? ' ' + k.duplex : ''));
    it(T('netp.errors'), k.errors || 0); it(T('netp.dropped'), k.dropped || 0);
    if ((D.today[2] || 0) + (D.today[3] || 0) > 0) { it(T('netp.ts_today'), fb((D.today[2] || 0) + (D.today[3] || 0))); }
    it(T('netp.router'), (I.router || '?') + ' ' + (I.router_ms === null || I.router_ms === undefined ? T('net.no_answer') : I.router_ms + ' ms'));
    if (I.out) { it(I.out, I.out_ms + ' ms'); }
    if (IP) { it(T('netp.public_ip'), IP); }
    if (CHK) { it(T('netp.checked'), CHK); }
    $b.append($s);
    $('#nwp-nband').text(T('netp.checked_ago', { s: Math.max(0, Math.round(Date.now() / 1000 - (I.t || L.t))) }));
  }

  // ---- traffic chart: down filled green, up blue; y in the chosen unit, x in time
  function drawChart() {
    var L = D.live, $c = $('#nwp-chart').empty();
    if (!L) { $c.append($('<div class="nwp-mut">').text(T('netp.no_data'))); return; }
    var pts = RANGE === '1h' ? L.live : (RANGE === '24h' ? L.h24 : L.d7), span = RANGE === '1h' ? 3600 : (RANGE === '24h' ? 86400 : 7 * 86400), now = L.t, t0 = now - span;
    pts = $.grep(pts || [], function (p) { return p[0] >= t0; });
    if (pts.length < 2) { $c.append($('<div class="nwp-mut">').text(T('netp.collecting'))); return; }
    var W = 600, H = 190, top = 10, bot = 22, left = 34, mx = 0, pk = null;
    $.each(pts, function (i, p) { if (p[1] > mx || p[2] > mx) { mx = Math.max(p[1], p[2]); } if (!pk || p[1] > pk[1]) { pk = p; } });
    var vmax = rv(mx) || 0.01, steps = [0.01, 0.02, 0.05, 0.1, 0.2, 0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000], st = 1000;
    for (var i = 0; i < steps.length; i++) { if (vmax / steps[i] <= 4) { st = steps[i]; break; } }
    var ymax = Math.ceil(vmax / st) * st || st;
    function X(t) { return (left + (t - t0) / span * (W - left)).toFixed(1); }
    function Y(b) { return (H - bot - rv(b) / ymax * (H - bot - top)).toFixed(1); }
    var g = '';
    for (var v = 0; v <= ymax + 1e-9; v += st) {
      var y = (H - bot - v / ymax * (H - bot - top)).toFixed(1);
      g += '<line x1="' + left + '" x2="' + W + '" y1="' + y + '" y2="' + y + '" stroke="#808080" stroke-opacity=".25" stroke-dasharray="3 4" vector-effect="non-scaling-stroke"/>'
        + '<text x="' + (left - 4) + '" y="' + (+y + 3) + '" fill="currentColor" fill-opacity=".55" font-size="10" text-anchor="end">' + (st < 1 ? v.toFixed(st < 0.1 ? 2 : 1) : Math.round(v)) + '</text>';
    }
    var xt = RANGE === '1h' ? 900 : (RANGE === '24h' ? 4 * 3600 : 86400);
    for (var t = Math.ceil(t0 / xt) * xt; t <= now; t += xt) {
      if (+X(t) > W - 22 || +X(t) < left + 14) { continue; }   // a label cut by the edge is left out
      g += '<text x="' + X(t) + '" y="' + (H - 6) + '" fill="currentColor" fill-opacity=".55" font-size="10" text-anchor="middle">' + esc(RANGE === '7d' ? dayLab(t) : hm(t)) + '</text>';
    }
    var dn = $.map(pts, function (p) { return X(p[0]) + ',' + Y(p[1]); }).join(' '), up = $.map(pts, function (p) { return X(p[0]) + ',' + Y(p[2]); }).join(' ');
    g += '<polygon points="' + X(pts[0][0]) + ',' + (H - bot) + ' ' + dn + ' ' + X(pts[pts.length - 1][0]) + ',' + (H - bot) + '" fill="#3fa24a" fill-opacity=".22"/>'
      + '<polyline points="' + dn + '" fill="none" stroke="#3fa24a" stroke-width="1.6" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>'
      + '<polyline points="' + up + '" fill="none" stroke="#4a90e2" stroke-width="1.6" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>';
    $c.append($('<span>').html('<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none" role="img">' + g + '</svg>').children());
    var avg = { '1h': T('netp.avg_5s'), '24h': T('netp.avg_5m'), '7d': T('netp.avg_30m') }[RANGE];
    $c.append($('<div class="nwp-leg">').append($('<span>').text(ut() + ' · ' + avg + (pk ? ' · ' + T('netp.peak', { v: fr(pk[1]) + ' ' + ut(), t: RANGE === '7d' ? dayLab(pk[0]) + ' ' + hm(pk[0]) : hm(pk[0]) }) : '')),
      $('<span>').append($('<i>').css('background', '#3fa24a'), document.createTextNode(T('net.down_s')), $('<i>').css('background', '#4a90e2'), document.createTextNode(T('net.up_s')))));
  }

  // ---- totals: the last 7 days, today, this month, last month
  function drawTot() {
    var $t = $('#nwp-tot').empty(), mx = 1;
    $.each(D.last7, function (i, d) { mx = Math.max(mx, d.rx + d.tx); });
    var $d = $('<div class="nwp-days">'), $l = $('<div class="nwp-dlab">');
    $.each(D.last7, function (i, d) {
      $d.append($('<div class="nwp-day">').attr('title', fb(d.rx) + ' ↓ · ' + fb(d.tx) + ' ↑').append(
        $('<i>').css({ height: (d.tx / mx * 100) + '%', background: '#4a90e2' }), $('<i>').css({ height: (d.rx / mx * 100) + '%', background: '#3fa24a' })));
      $l.append($('<span>').append($('<b>').text(dayLab(d.ts)), document.createTextNode(fb(d.rx + d.tx))));
    });
    $t.append($d, $l);
    function k(label, v) {
      var tb = v ? fb(v[0] + v[1]).split(' ') : ['–', ''];
      return $('<div>').append($('<div class="k">').text(label), $('<div class="v">').append(document.createTextNode(tb[0]), $('<small>').text(' ' + tb[1])),
        $('<div class="s">').text(v ? '↓ ' + fb(v[0]) + ' · ↑ ' + fb(v[1]) : ''));
    }
    $t.append($('<div class="nwp-kp">').append(k(T('netp.today'), D.today), k(T('netp.this_month'), D.month.v), k(T('netp.last_month'), D.prev.v)));
  }

  // ---- containers: now and today, the busiest first
  function drawCt() {
    var L = D.live, $c = $('#nwp-ct').empty();
    if (!L) { return; }
    var day = (L.ctday && L.ctday.ct) || {}, rows = [];
    $.each(L.ct_names || [], function (i, n) { var r = (L.ct || {})[n] || [0, 0], d = day[n] || [0, 0]; rows.push([n, r, d]); });
    rows.sort(function (a, b) { return (b[2][0] + b[2][1]) - (a[2][0] + a[2][1]) || (b[1][0] + b[1][1]) - (a[1][0] + a[1][1]); });
    if (!rows.length) { $c.append($('<div class="nwp-row nwp-mut">').text(T('netp.no_ct'))); return; }
    $c.append($('<div class="nwp-row nwp-ct h">').append($('<span>').text(T('netp.c_name')), $('<span class="nwp-num">').text(T('netp.c_now', { unit: ut() })), $('<span class="nwp-num">').text(T('netp.c_rx')), $('<span class="nwp-num">').text(T('netp.c_tx'))));
    $.each(rows, function (i, r) {
      $c.append($('<div class="nwp-row nwp-ct">').addClass(r[1][0] + r[1][1] > 0 ? 's-green' : 's-grey').append($('<span>').text(r[0]),
        $('<span class="nwp-num">').text(fr(r[1][0]) + ' / ' + fr(r[1][1])), $('<span class="nwp-num">').text(fb(r[2][0])), $('<span class="nwp-num">').text(fb(r[2][1]))));
    });
    $c.append($('<div class="nwp-row nwp-mut">').append($('<small>').text(T('netp.ct_note'))));
  }

  // ---- outages: the last 7 days open, older ones under a closed bar
  function evRow(e) {
    var dur = Math.max(1, Math.round(((e.e || Date.now() / 1000) - e.s) / 60)), d = new Date(e.s * 1000);
    var when = d.getFullYear() + '-' + two(d.getMonth() + 1) + '-' + two(d.getDate()) + ' ' + hm(e.s) + '–' + (e.e ? hm(e.e) : T('netp.ongoing'));
    return $('<div class="nwp-row nwp-ev">').addClass(e.e ? 's-red' : 's-red').append(
      $('<span>').append($('<b>').text(T(e.k === 'norouter' ? 'netp.ev_router' : 'netp.ev_down', { m: dur })), $('<small>').text(T(e.k === 'norouter' ? 'netp.ev_router_d' : 'netp.ev_down_d'))),
      $('<span class="nwp-num">').text(when));
  }
  function drawEv() {
    var $e = $('#nwp-ev').empty(), cut = Date.now() / 1000 - 7 * 86400, ev = (D.events || []).slice().reverse();
    var recent = $.grep(ev, function (e) { return !e.e || e.s >= cut; }), old = $.grep(ev, function (e) { return e.e && e.s < cut; });
    $('#nwp-oband').text(recent.length ? T('netp.n_outages', { n: recent.length }) : T('netp.no_outages')).toggleClass('nwp-ok', !recent.length);
    $.each(recent, function (i, e) { $e.append(evRow(e)); });
    if (!recent.length) { $e.append($('<div class="nwp-row nwp-mut">').text(T('netp.no_outages_long'))); }
    if (old.length) {
      $e.append($('<div class="nwp-gbar">').append($('<span>').text(OPEN ? '–' : '+'), $('<span>').text(T('netp.older')), $('<span class="c">').text(old.length)));
      if (OPEN) { $.each(old, function (i, e) { $e.append(evRow(e)); }); }
    }
  }

  // ---- settings (drawn once, so typing is not lost on the 5-second refresh)
  function drawSet() {
    if (setDrawn) { return; }
    setDrawn = true;
    var c = D.cfg, $s = $('#nwp-set').empty();
    function row(label, $ctl, hint) { $s.append($('<div class="nwp-row nwp-set">').append($('<span class="lb">').text(label), $('<div class="nwp-ctl">').append($ctl, hint ? $('<span class="nwp-hint">').text(hint) : ''))); }
    var $if = $('<select id="nwp-if">').append($('<option value="auto">').text(T('netp.s_auto', { v: D.auto_if })));
    $.each(D.ifaces, function (i, n) { $if.append($('<option>').val(n).text(n)); });
    $if.val(c.iface);
    row(T('netp.s_if'), $if, T('netp.s_if_hint'));
    row(T('netp.s_router'), $('<input type="text" id="nwp-rt">').val(c.router === 'auto' ? '' : c.router).attr('placeholder', T('netp.s_auto', { v: D.auto_gw || '?' })), T('netp.s_router_hint'));
    row(T('netp.s_out'), $('<input type="text" id="nwp-out">').val(c.outside), T('netp.s_out_hint'));
    row(T('netp.s_slow'), [$('<input type="number" id="nwp-ms" min="20" max="5000">').val(c.slow_ms), document.createTextNode(' ms')], T('netp.s_slow_hint'));
    row(T('netp.s_unit'), $('<select id="nwp-unit">').append($('<option value="MB">').text(T('netp.u_mb')), $('<option value="Mbit">').text(T('netp.u_mbit'))).val(c.unit), '');
    row('Discord', $('<label>').append($('<input type="checkbox" id="nwp-dc">').prop('checked', c.dc === '1'), document.createTextNode(T('netp.s_dc'))), T('netp.s_dc_hint'));
    row('', [$('<input type="button" id="nwp-save">').val(T('netp.save')), $('<span id="nwp-msg">')], '');
  }
  $(document).on('click', '#nwp-save', function () {
    var $b = $(this).prop('disabled', true), $m = $('#nwp-msg').css('color', '').text(T('netp.saving'));
    api('save', { iface: $('#nwp-if').val(), router: $.trim($('#nwp-rt').val()) || 'auto', outside: $('#nwp-out').val(), slow_ms: $('#nwp-ms').val(), unit: $('#nwp-unit').val(), dc: $('#nwp-dc').prop('checked') ? '1' : '0' })
      .done(function (r) { if (r && r.ok) { $m.css('color', '#3fa24a').text(T('netp.saved')); load(); } else { $m.css('color', '#e5534b').text(T('netp.not_saved', { e: err(r) })); } })
      .fail(function (x) { $m.css('color', '#e5534b').text(T('netp.not_saved', { e: err(x) })); })
      .always(function () { $b.prop('disabled', false); });
  });
  $(document).on('click', '#nwp .nwp-chk', function () {
    var $b = $(this).prop('disabled', true).val(T('netp.checking'));
    api('check').done(function (r) {
      if (r && r.ok) { var c = r.check; CHK = (c.out_ms !== null ? c.out + ' ' + c.out_ms + ' ms' : T('net.outside_none')) + ' · ' + T('netp.router') + ' ' + (c.router_ms !== null ? c.router_ms + ' ms' : T('net.no_answer')); }
      else { CHK = err(r); }
    }).fail(function (x) { CHK = err(x); }).always(function () { if (D) { drawNow(); } });
  });
  $(document).on('click', '#nwp .nwp-ip', function () {
    var $b = $(this).prop('disabled', true).val(T('netp.asking'));
    api('ip').done(function (r) { IP = (r && r.ok) ? r.ip : err(r); }).fail(function (x) { IP = err(x); }).always(function () { if (D) { drawNow(); } });
  });
  $('#nwp-tabs').on('click', 'a', function () { RANGE = $(this).data('r'); $('#nwp-tabs a').removeClass('on'); $(this).addClass('on'); if (D) { drawChart(); } });
  $(document).on('click', '#nwp .nwp-gbar', function () { OPEN = !OPEN; drawEv(); });

  function load() {
    $.getJSON(URL, { op: 'state', _: Date.now() }).done(function (r) {
      if (!r || !r.ok) { return; }
      D = r; drawNow(); drawChart(); drawTot(); drawCt(); drawEv(); drawSet();
    }).always(function () { clearTimeout(pollT); pollT = setTimeout(load, document.hidden ? 30000 : 5000); });
  }
  load();
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- NETWORK LIBRARY -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/net_lib.php">
<INLINE><![CDATA[<?php
// Network meter (item 94): settings, interface and gateway detection, counters of the host and of the containers, pings.
// Only reads; netmon.php samples in the background, net.php serves the Network page, api_fetch.php the tile.
require_once __DIR__ . '/lib.php';

const SXNET_CFG  = '/boot/config/plugins/sysbox/network.cfg';
const SXNET_HIST = '/boot/config/plugins/sysbox/net_hist.json';   // days, 24 h and 7 d series, today per container, outages
const SXNET_LIVE = '/tmp/sysbox_net.json';                         // written by netmon.php every 5 seconds

function sxnet_dir() { $d = getenv('SX_NET_DIR'); return ($d !== false && $d !== '') ? rtrim($d, '/') : ''; }   // tests only
function sxnet_cfg_file() { return sxnet_dir() !== '' ? sxnet_dir() . '/network.cfg' : SXNET_CFG; }
function sxnet_hist_file() { return sxnet_dir() !== '' ? sxnet_dir() . '/net_hist.json' : SXNET_HIST; }
function sxnet_live_file() { return sxnet_dir() !== '' ? sxnet_dir() . '/sysbox_net.json' : SXNET_LIVE; }
function sxnet_sys() { $d = getenv('SX_NET_SYS'); return ($d !== false && $d !== '') ? rtrim($d, '/') : ''; }       // tests only: a fake /proc and /sys root

function sxnet_defaults() { return ['iface' => 'auto', 'router' => 'auto', 'outside' => '1.1.1.1, 8.8.8.8', 'slow_ms' => '150', 'unit' => 'MB', 'dc' => '1']; }
function sxnet_cfg() {
    $c = sxnet_defaults(); $f = sxnet_cfg_file();
    if (is_file($f)) { $x = @parse_ini_file($f); if (is_array($x)) { $c = array_merge($c, array_intersect_key($x, $c)); } }
    return $c;
}
function sxnet_cfg_save($c) {
    $txt = '';
    foreach (sxnet_defaults() as $k => $v) { $txt .= $k . '="' . str_replace('"', '', (string)($c[$k] ?? $v)) . "\"\n"; }
    $f = sxnet_cfg_file(); @mkdir(dirname($f), 0755, true);
    if (@file_put_contents($f . '.tmp', $txt) === false) { return false; }
    return @rename($f . '.tmp', $f);
}
function sxnet_host_ok($h) { return (bool)preg_match('/^[A-Za-z0-9][A-Za-z0-9.:\-]{0,252}$/', (string)$h); }
function sxnet_if_ok($i) { return (bool)preg_match('/^[A-Za-z0-9_.:\-]{1,15}$/', (string)$i); }
function sxnet_outside($cfg) {
    $o = [];
    foreach (explode(',', (string)$cfg['outside']) as $h) { $h = trim($h); if ($h !== '' && sxnet_host_ok($h)) { $o[] = $h; } }
    return array_slice($o, 0, 3);
}

// ---- /proc and /sys readers -------------------------------------------------------------------
// iface => [rx bytes, tx bytes] from a net/dev file (the host's, or a container's /proc/<pid>/net/dev)
function sxnet_dev($file = null) {
    $file = $file ?? sxnet_sys() . '/proc/net/dev';
    $out = [];
    foreach ((array)@file($file, FILE_IGNORE_NEW_LINES) as $l) {
        if (!preg_match('/^\s*([^:\s]+):\s*(.*)$/', $l, $m)) { continue; }
        $v = preg_split('/\s+/', trim($m[2]));
        if (count($v) >= 9) { $out[$m[1]] = [(float)$v[0], (float)$v[8]]; }
    }
    return $out;
}
// [interface of the default route, gateway address] from /proc/net/route
function sxnet_route() {
    foreach ((array)@file(sxnet_sys() . '/proc/net/route', FILE_IGNORE_NEW_LINES) as $l) {
        $p = preg_split('/\s+/', trim($l));
        if (count($p) < 3 || $p[1] !== '00000000' || !preg_match('/^[0-9A-Fa-f]{8}$/', $p[2])) { continue; }
        $g = implode('.', array_reverse(array_map('hexdec', str_split($p[2], 2))));
        return [$p[0], $g === '0.0.0.0' ? '' : $g];
    }
    return ['', ''];
}
function sxnet_sysnet($i, $f) { $v = @file_get_contents(sxnet_sys() . '/sys/class/net/' . $i . '/' . $f); return $v === false ? null : trim($v); }
// the interface whose counters show the wire: the default route's one, or the physical port under a bridge (br0 -> eth0)
function sxnet_iface($cfg) {
    if ($cfg['iface'] !== 'auto' && sxnet_if_ok($cfg['iface'])) { return $cfg['iface']; }
    [$dev] = sxnet_route();
    if ($dev === '') { return 'eth0'; }
    if (is_dir(sxnet_sys() . '/sys/class/net/' . $dev . '/bridge')) {
        $m = glob(sxnet_sys() . '/sys/class/net/' . $dev . '/brif/*') ?: [];
        foreach ($m as $p) { $n = basename($p); if (file_exists(sxnet_sys() . '/sys/class/net/' . $n . '/device') || is_dir(sxnet_sys() . '/sys/class/net/' . $n . '/bonding')) { return $n; } }
    }
    return $dev;
}
// interfaces offered on the settings page: real ports, bonds and bridges (no veth, docker or loopback)
function sxnet_ifaces() {
    $o = [];
    foreach (glob(sxnet_sys() . '/sys/class/net/*') ?: [] as $p) {
        $n = basename($p);
        if ($n === 'lo' || preg_match('/^(veth|docker|br-|vnet|virbr|tunl|shim|vhost)/', $n)) { continue; }
        $o[] = $n;
    }
    sort($o, SORT_NATURAL);
    return $o;
}
function sxnet_link($i) {
    $sp = (int)sxnet_sysnet($i, 'speed');
    $st = function ($f) use ($i) { return (int)sxnet_sysnet($i, 'statistics/' . $f); };
    return ['speed' => $sp > 0 ? $sp : null, 'duplex' => (string)sxnet_sysnet($i, 'duplex'), 'up' => sxnet_sysnet($i, 'operstate') === 'up',
            'errors' => $st('rx_errors') + $st('tx_errors'), 'dropped' => $st('rx_dropped') + $st('tx_dropped')];
}

// ---- containers -------------------------------------------------------------------------------
// name => pid of the running containers that have their own network (host-network ones share the host's counters)
function sxnet_ct_pids() {
    $t = getenv('SX_NET_PIDS');   // tests only: "name=pid,name=pid"
    if ($t !== false && $t !== '') { $o = []; foreach (explode(',', $t) as $x) { [$n, $p] = array_pad(explode('=', $x, 2), 2, ''); if (sx_valid_name($n) && ctype_digit($p)) { $o[$n] = (int)$p; } } return $o; }
    $d = sx_docker(); if ($d === '') { return []; }
    [$rc, $ids] = sx_run(escapeshellarg($d) . ' ps -q --no-trunc', 8);
    $ids = array_values(array_filter(array_map('trim', explode("\n", (string)$ids)), function ($x) { return preg_match('/^[0-9a-f]{12,64}$/', $x); }));
    if ($rc !== 0 || !$ids) { return []; }
    [$rc, $txt] = sx_run(escapeshellarg($d) . ' inspect -f ' . escapeshellarg('{{.Name}} {{.State.Pid}}') . ' ' . implode(' ', array_map('escapeshellarg', $ids)), 15);
    if ($rc !== 0) { return []; }
    $host = @readlink('/proc/self/ns/net'); $o = [];
    foreach (explode("\n", (string)$txt) as $l) {
        if (!preg_match('/^\/?(\S+)\s+(\d+)$/', trim($l), $m) || !sx_valid_name($m[1]) || (int)$m[2] <= 0) { continue; }
        if ($host && @readlink('/proc/' . $m[2] . '/ns/net') === $host) { continue; }
        $o[$m[1]] = (int)$m[2];
    }
    ksort($o, SORT_NATURAL | SORT_FLAG_CASE);
    return $o;
}
// [rx, tx] of a container: the sum of its interfaces except loopback
function sxnet_ct_bytes($pid) {
    $f = getenv('SX_NET_SYS') ? sxnet_sys() . '/proc/' . (int)$pid . '/net/dev' : '/proc/' . (int)$pid . '/net/dev';
    $d = sxnet_dev($f); if (!$d) { return null; }
    $rx = 0.0; $tx = 0.0;
    foreach ($d as $i => $v) { if ($i !== 'lo') { $rx += $v[0]; $tx += $v[1]; } }
    return [$rx, $tx];
}

// ---- ping ---------------------------------------------------------------------------------------
// round trip in ms, or null when there was no answer within 2 seconds
function sxnet_ping($host) {
    if (!sxnet_host_ok($host)) { return null; }
    $fake = getenv('SX_NET_PING');   // tests only: "host=ms,host=-" ('-' = no answer), or a file that holds it
    if ($fake !== false && $fake !== '' && $fake[0] === '/') { $fake = trim((string)@file_get_contents($fake)); }
    if ($fake !== false && $fake !== '') { foreach (explode(',', $fake) as $x) { [$h, $v] = array_pad(explode('=', $x, 2), 2, '-'); if ($h === $host) { return is_numeric($v) ? (float)$v : null; } } return null; }
    $b = sx_bin('ping'); if ($b === '') { return null; }
    [$rc, $o] = sx_run(escapeshellarg($b) . ' -n -c 1 -W 2 ' . escapeshellarg($host), 4);
    return ($rc === 0 && preg_match('/time[=<]\s*([0-9.]+)\s*ms/', $o, $m)) ? round((float)$m[1], 1) : null;
}
// one check: router, then the outside addresses until one answers. state: ok | slow | down | norouter (before the debounce)
function sxnet_check($cfg) {
    $gw = $cfg['router'] !== 'auto' && sxnet_host_ok($cfg['router']) ? $cfg['router'] : sxnet_route()[1];
    $r = $gw !== '' ? sxnet_ping($gw) : null; $out = null; $oh = '';
    foreach (sxnet_outside($cfg) as $h) { $v = sxnet_ping($h); if ($v !== null) { $out = $v; $oh = $h; break; } }
    $raw = $out !== null ? ($out > (float)$cfg['slow_ms'] ? 'slow' : 'ok') : (($gw !== '' && $r === null) ? 'norouter' : 'down');
    return ['t' => time(), 'router' => $gw, 'router_ms' => $r, 'out' => $oh, 'out_ms' => $out, 'raw' => $raw];
}

// Discord texts in the Discord language (lang/<code>.json, English for a missing text)
function sxnet_dt($lang, $k, $v = []) {
    static $tab = [];
    if (!isset($tab[$lang])) {
        $rd = function ($f) { $j = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null; return is_array($j) ? $j : []; };
        $en = $rd(__DIR__ . '/lang/en.json'); $tr = $lang !== 'en' ? $rd(__DIR__ . '/lang/' . $lang . '.json') : [];
        $tab[$lang] = ['en' => $en, 'tr' => $tr];
    }
    $e = $tab[$lang]['tr'][$k] ?? null; $s = (is_array($e) && trim((string)($e['text'] ?? '')) !== '') ? $e : ($tab[$lang]['en'][$k] ?? null);
    return is_array($s) ? mt_i18n_fmt(['text' => (string)($s['text'] ?? $k)], $v) : $k;
}
function sxnet_live() { $j = json_decode((string)@file_get_contents(sxnet_live_file()), true); return is_array($j) ? $j : null; }
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- NETWORK ENDPOINT -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/net.php">
<INLINE><![CDATA[<?php
// Network page endpoint (item 94). GET: the page data. POST op=save (the page's settings), op=check (one internet check
// now), op=ip (the public address, asked from api.ipify.org only on this click). Nothing on the server is changed.
require_once __DIR__ . '/net_lib.php';

$op = (string)($_POST['op'] ?? ($_GET['op'] ?? 'state'));
if ($op !== 'state') {
    if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { sx_json(['ok' => false, 'error' => 'method'], 405); }
    sx_guard();
}

if ($op === 'state') {
    $L = sxnet_live(); $cfg = sxnet_cfg(); $sx = sx_cfg();
    $hist = json_decode((string)@file_get_contents(sxnet_hist_file()), true); $days = is_array($hist) ? (array)($hist['days'] ?? []) : [];
    if ($L) { $days = array_merge($days, (array)($L['days'] ?? [])); }
    $mon = []; foreach ($days as $d => $v) { $m = substr((string)$d, 0, 7); $mon[$m] = [($mon[$m][0] ?? 0) + $v[0], ($mon[$m][1] ?? 0) + $v[1]]; }
    ksort($days); $last7 = [];
    for ($i = 6; $i >= 0; $i--) { $d = date('Y-m-d', strtotime("-$i days")); $last7[] = ['d' => $d, 'ts' => strtotime($d), 'rx' => $days[$d][0] ?? 0, 'tx' => $days[$d][1] ?? 0]; }
    $tm = date('Y-m'); $pm = date('Y-m', strtotime(date('Y-m-01') . ' -1 month'));
    sx_json(['ok' => true, 'on' => sx_on($sx['show_net'] ?? '1'), 'running' => $L !== null && time() - (int)$L['t'] < 30, 'cfg' => $cfg, 'ifaces' => sxnet_ifaces(), 'auto_if' => sxnet_iface(['iface' => 'auto']),
        'auto_gw' => sxnet_route()[1], 'live' => $L, 'last7' => $last7, 'today' => $days[date('Y-m-d')] ?? [0, 0, 0, 0],
        'month' => ['key' => $tm, 'v' => $mon[$tm] ?? [0, 0]], 'prev' => ['key' => $pm, 'v' => $mon[$pm] ?? null],
        'events' => is_array($hist) ? array_slice((array)($hist['events'] ?? []), -50) : []]);
}

if ($op === 'save') {
    $c = sxnet_cfg();
    $if = trim((string)($_POST['iface'] ?? 'auto')); if ($if !== 'auto' && !sxnet_if_ok($if)) { sx_json(['ok' => false, 'error' => sx_tr('netp.err_if')]); }
    $rt = trim((string)($_POST['router'] ?? 'auto')); if ($rt === '') { $rt = 'auto'; } if ($rt !== 'auto' && !sxnet_host_ok($rt)) { sx_json(['ok' => false, 'error' => sx_tr('netp.err_host', ['h' => $rt])]); }
    $out = [];
    foreach (explode(',', (string)($_POST['outside'] ?? '')) as $h) { $h = trim($h); if ($h === '') { continue; } if (!sxnet_host_ok($h)) { sx_json(['ok' => false, 'error' => sx_tr('netp.err_host', ['h' => $h])]); } $out[] = $h; }
    if (!$out || count($out) > 3) { sx_json(['ok' => false, 'error' => sx_tr('netp.err_out')]); }
    $ms = (int)($_POST['slow_ms'] ?? 150); if ($ms < 20 || $ms > 5000) { sx_json(['ok' => false, 'error' => sx_tr('save.err_number', ['name' => sx_tr('netp.s_slow'), 'min' => 20, 'max' => 5000])]); }
    $c = ['iface' => $if, 'router' => $rt, 'outside' => implode(', ', $out), 'slow_ms' => (string)$ms,
          'unit' => (($_POST['unit'] ?? 'MB') === 'Mbit') ? 'Mbit' : 'MB', 'dc' => in_array((string)($_POST['dc'] ?? '0'), ['1', 'on', 'yes'], true) ? '1' : '0'];
    if (!sxnet_cfg_save($c)) { sx_json(['ok' => false, 'error' => sx_tr('save.err_write')]); }
    sx_json(['ok' => true]);
}

if ($op === 'check') { sx_json(['ok' => true, 'check' => sxnet_check(sxnet_cfg())]); }

if ($op === 'ip') {
    $ch = curl_init('https://api.ipify.org');
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 6, CURLOPT_CONNECTTIMEOUT => 4]);
    $b = trim((string)curl_exec($ch)); $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE); curl_close($ch);
    if ($code !== 200 || !filter_var($b, FILTER_VALIDATE_IP)) { sx_json(['ok' => false, 'error' => sx_tr('netp.ip_fail')]); }
    sx_json(['ok' => true, 'ip' => $b]);
}
sx_json(['ok' => false, 'error' => 'op'], 400);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- NETWORK SAMPLER -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/netmon.php">
<INLINE><![CDATA[<?php
// Long-running network sampler (item 94; cron starts it every minute, one instance only, it exits when the Network part
// is switched off). Every 5 s the wire interface's counters, every 15 s the containers' own counters, every 30 s a ping
// to the router and outside. Live data in /tmp (SXNET_LIVE), the history on the flash every 30 minutes (SXNET_HIST).
// It only reads counters and sends pings; nothing on the server is changed.
if (PHP_SAPI !== 'cli') { exit; }
require_once __DIR__ . '/net_lib.php';

function sxnet_enabled() { return sx_on(sx_cfg()['show_net'] ?? '1'); }
if (!sxnet_enabled()) { exit(0); }

// tests: --rounds=N stops after N rounds, SX_NET_STEP sets the seconds between rounds
$rounds = 0; foreach ($argv as $a) { if (preg_match('/^--rounds=(\d+)$/', $a, $m)) { $rounds = (int)$m[1]; } }
$step = max(1, (int)(getenv('SX_NET_STEP') ?: 5));
$H = json_decode((string)@file_get_contents(sxnet_hist_file()), true);
if (!is_array($H)) { $H = []; }
$H += ['v' => 1, 'days' => [], 'h24' => [], 'd7' => [], 'ctday' => ['d' => date('Y-m-d'), 'ct' => []], 'events' => []];
$L0 = sxnet_live();
if (is_array($L0) && !empty($L0['live']) && time() - (int)($L0['t'] ?? 0) < 600) { $live = $L0['live']; } else { $live = []; }

$cfg = sxnet_cfg(); $iface = sxnet_iface($cfg);
$prev = null; $prevT = 0; $prevTs = null;
$b5 = [0, 0.0, 0.0]; $b30 = [0, 0.0, 0.0];
$pids = []; $pidsT = 0; $ctPrev = []; $ctT = 0; $ctRate = [];
$inet = ['state' => 'wait', 'since' => time()]; $pingT = 0; $slowN = 0; $failN = 0; $failSince = 0;
$cfgT = time(); $saveT = time(); $link = sxnet_link($iface);

function sxnet_save_hist(&$H) {
    $f = sxnet_hist_file(); @mkdir(dirname($f), 0755, true);
    $cut = date('Y-m-d', strtotime('-400 days'));
    foreach (array_keys($H['days']) as $d) { if ($d < $cut) { unset($H['days'][$d]); } }
    $H['events'] = array_slice($H['events'], -50);
    @file_put_contents($f . '.tmp', json_encode($H)); @rename($f . '.tmp', $f);
}
function sxnet_bucket(&$b, &$list, $now, $len, $keep, $drx, $dtx) {
    $k = intdiv($now, $len) * $len;
    if ($b[0] && $b[0] !== $k) { $list[] = [$b[0], round($b[1] / $len), round($b[2] / $len)]; $b = [0, 0.0, 0.0]; }
    if (!$b[0]) { $b[0] = $k; }
    $b[1] += $drx; $b[2] += $dtx;
    while ($list && $list[0][0] < $now - $keep) { array_shift($list); }
}

// a plugin update stops the sampler (pkill): keep the history of the last minutes
if (function_exists('pcntl_async_signals')) {
    pcntl_async_signals(true);
    foreach ([SIGTERM, SIGINT] as $sg) { pcntl_signal($sg, function () use (&$H) { sxnet_save_hist($H); exit(0); }); }
}

while (true) {
    $now = time(); $today = date('Y-m-d');
    if (!is_dir(__DIR__)) { exit; }   // plugin removed

    // settings: every minute (the Network page or the Sysbox settings may have changed)
    if ($now - $cfgT >= 60) {
        $cfgT = $now;
        if (!sxnet_enabled()) { sxnet_save_hist($H); @unlink(sxnet_live_file()); exit(0); }
        $cfg = sxnet_cfg(); $i2 = sxnet_iface($cfg);
        if ($i2 !== $iface) { $iface = $i2; $prev = null; }
        $link = sxnet_link($iface);
    }

    // a new day: today's per-container totals start again
    if (($H['ctday']['d'] ?? '') !== $today) { $H['ctday'] = ['d' => $today, 'ct' => []]; sxnet_save_hist($H); $saveT = $now; }

    // the wire interface (and Tailscale, which is part of it)
    $dev = sxnet_dev(); $cur = $dev[$iface] ?? null; $ts = $dev['tailscale0'] ?? null; $rate = [0, 0];
    if ($cur && $prev && $now > $prevT) {
        $drx = $cur[0] >= $prev[0] ? $cur[0] - $prev[0] : $cur[0]; $dtx = $cur[1] >= $prev[1] ? $cur[1] - $prev[1] : $cur[1];   // a counter reset counts from 0
        $dt = $now - $prevT; $rate = [round($drx / $dt), round($dtx / $dt)];
        $live[] = [$now, $rate[0], $rate[1]];
        while ($live && $live[0][0] < $now - 3600) { array_shift($live); }
        sxnet_bucket($b5, $H['h24'], $now, 300, 86400, $drx, $dtx);
        sxnet_bucket($b30, $H['d7'], $now, 1800, 7 * 86400, $drx, $dtx);
        $dd = $H['days'][$today] ?? [0, 0, 0, 0];
        $dd[0] += $drx; $dd[1] += $dtx;
        if ($ts && $prevTs) { $dd[2] += $ts[0] >= $prevTs[0] ? $ts[0] - $prevTs[0] : $ts[0]; $dd[3] += $ts[1] >= $prevTs[1] ? $ts[1] - $prevTs[1] : $ts[1]; }
        $H['days'][$today] = $dd;
    }
    if ($cur) { $prev = $cur; $prevT = $now; }
    $prevTs = $ts;

    // containers: their own network counters (/proc/<pid>/net/dev); the list of containers every minute
    if ($now - $ctT >= 3 * $step) {
        if ($now - $pidsT >= 12 * $step) { $pids = sxnet_ct_pids(); $pidsT = $now; }
        $dtc = $ctT ? $now - $ctT : 0; $ctT = $now; $newPrev = []; $ctRate = [];
        foreach ($pids as $n => $pid) {
            $b = sxnet_ct_bytes($pid); if ($b === null) { continue; }
            $p = $ctPrev[$n] ?? null;
            if ($p && $dtc > 0) {
                $samePid = $p[2] === $pid;
                $drx = ($samePid && $b[0] >= $p[0]) ? $b[0] - $p[0] : $b[0]; $dtx = ($samePid && $b[1] >= $p[1]) ? $b[1] - $p[1] : $b[1];
                $ctRate[$n] = [round($drx / $dtc), round($dtx / $dtc)];
                $c = $H['ctday']['ct'][$n] ?? [0, 0]; $H['ctday']['ct'][$n] = [$c[0] + $drx, $c[1] + $dtx];
            }
            $newPrev[$n] = [$b[0], $b[1], $pid];
        }
        $ctPrev = $newPrev;
    }

    // internet: every 30 s; slow after 3 slow checks in a row, down after 2 failed ones; an outage is logged when it ends
    if ($now - $pingT >= 6 * $step) {
        $pingT = $now; $c = sxnet_check($cfg); $raw = $c['raw'];
        if ($raw === 'ok' || $raw === 'slow') {
            $failN = 0; $slowN = $raw === 'slow' ? $slowN + 1 : 0;
            $st = $slowN >= 3 ? 'slow' : 'ok';
            $n = count($H['events']);
            if ($n && $H['events'][$n - 1]['e'] === null) { $H['events'][$n - 1]['e'] = $now; sxnet_save_hist($H); $saveT = $now; }
        } else {
            $slowN = 0; if ($failN === 0) { $failSince = $c['t']; } $failN++;
            $st = $failN >= 2 ? $raw : ($inet['state'] === 'wait' ? 'ok' : $inet['state']);
            $n = count($H['events']);
            if ($failN >= 2 && (!$n || $H['events'][$n - 1]['e'] !== null)) { $H['events'][] = ['s' => $failSince, 'e' => null, 'k' => $raw]; }
            elseif ($failN >= 2 && $n) { $H['events'][$n - 1]['k'] = $raw; }
        }
        if ($st !== $inet['state']) { $inet['since'] = ($st === 'down' || $st === 'norouter') ? $failSince : $now; }
        $inet = array_merge($inet, $c, ['state' => $st]);
    }

    // the live file for the tile and the page
    $L = ['t' => $now, 'iface' => $iface, 'link' => $link, 'rate' => $rate, 'live' => $live, 'ct' => $ctRate, 'ct_names' => array_keys($pids),
          'inet' => $inet, 'h24' => $H['h24'], 'd7' => $H['d7'], 'days' => array_slice($H['days'], -62, null, true), 'ctday' => $H['ctday'], 'events' => array_slice($H['events'], -20),
          'unit' => $cfg['unit'], 'slow_ms' => (int)$cfg['slow_ms']];
    $f = sxnet_live_file(); @file_put_contents($f . '.tmp', json_encode($L)); @rename($f . '.tmp', $f);
    if ($now - $saveT >= 1800) { sxnet_save_hist($H); $saveT = $now; }
    if ($rounds && --$rounds === 0) { sxnet_save_hist($H); exit(0); }
    sleep($step);
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SHARED DISCORD BOT SETTING -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/bot.php">
<INLINE><![CDATA[<?php
// Shared Discord bot setting of the media server tools (Seedbox, Sysbox; item 95): one file on the flash drive with the
// bot token and the owner's Discord user id, so the bot is set once and every plugin's messages can get reactions.
//   token = the bot token (Discord Developer Portal, your app, Bot, Reset Token); never sent to a page
//   user  = the owner's user id: only this user's reactions count
// Before this file existed the bot lived in the Seedbox settings (tools.json bot_token, bot_user): while the file is
// missing those are used, and the first save writes the file (from then on an empty token in it means none).
// The bot has no gateway connection: messages go out through the plugin's webhook with ?wait=true, the bot adds the
// reactions and reads them back over REST, so it needs only View Channel, Add Reactions and Read Message History.
// Every plugin ships its own copy of this file; the guard keeps a second copy from being declared again.
if (!function_exists('mt_bot_cfg')) {

require_once __DIR__ . '/lang.php';

function mt_bot_file() { return getenv('MT_BOT_FILE') ?: '/boot/config/plugins/mediaserver-tools/discord_bot.cfg'; }

function mt_bot_cfg() {
    $f = mt_bot_file();
    if (is_file($f)) {
        $c = @parse_ini_file($f, false, INI_SCANNER_RAW);
        $c = is_array($c) ? $c : [];
        return ['token' => trim((string)($c['token'] ?? ''), "\"' "), 'user' => trim((string)($c['user'] ?? ''), "\"' "), 'src' => 'shared'];
    }
    $j = @json_decode((string)@file_get_contents(getenv('MT_BOT_SEEDBOX') ?: '/boot/config/plugins/qbittorrent_widget/tools.json'), true);
    $j = is_array($j) ? $j : [];
    return ['token' => trim((string)($j['bot_token'] ?? '')), 'user' => trim((string)($j['bot_user'] ?? '')), 'src' => 'seedbox'];
}
function mt_bot_ready() { $c = mt_bot_cfg(); return $c['token'] !== '' && preg_match('/^\d{15,25}$/', $c['user']) === 1; }

// $token: empty keeps the saved one, - removes it. Returns '' or the dictionary key of the error.
function mt_bot_save($token, $user) {
    $old = mt_bot_cfg();
    $token = trim((string)$token); $user = trim((string)$user);
    if ($token === '-') { $token = ''; }
    elseif ($token === '') { $token = $old['token']; }
    elseif (!preg_match('/^[A-Za-z0-9_\-.]{50,100}$/', $token)) { return 'bot.e.token'; }
    if ($user !== '' && !preg_match('/^\d{15,25}$/', $user)) { return 'bot.e.user'; }
    $f = mt_bot_file();
    @mkdir(dirname($f), 0777, true);
    if (@file_put_contents($f . '.tmp', 'token="' . $token . "\"\nuser=\"" . $user . "\"\n") === false || !@rename($f . '.tmp', $f)) { return 'bot.e.write'; }
    @chmod($f, 0600);
    return '';
}

// the texts of this file (Discord messages in the Discord language, page messages in the page language)
function mt_bot_dir() { return is_dir(__DIR__ . '/mtlang') ? __DIR__ . '/mtlang' : __DIR__ . '/lang'; }
function mt_bot_t($key, $vars = [], $discord = false) {
    static $tabs = [];
    $code = $discord ? mt_lang_discord() : mt_lang_ui();
    if (!isset($tabs[$code])) {
        $rd = function ($f) { $j = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null; return is_array($j) ? $j : []; };
        $en = $rd(mt_bot_dir() . '/en.json'); $tr = $code !== 'en' ? $rd(mt_bot_dir() . '/' . $code . '.json') : [];
        $tabs[$code] = [];
        foreach ($en as $k => $v) { if (is_array($v) && isset($v['text'])) { $t = $tr[$k]['text'] ?? ''; $tabs[$code][$k] = is_string($t) && trim($t) !== '' ? $t : (string)$v['text']; } }
    }
    $s = $tabs[$code][$key] ?? $key;
    return preg_replace_callback('/\{([a-z0-9_]+)\}/', function ($m) use ($vars) { return array_key_exists($m[1], $vars) ? (string)$vars[$m[1]] : $m[0]; }, $s);
}

// the Discord webhook of the plugin this copy belongs to (the bot reacts under that plugin's messages)
function mt_bot_hook() {
    if (getenv('MT_BOT_HOOK') !== false) { return (string)getenv('MT_BOT_HOOK'); }
    $p = basename(__DIR__);
    if ($p === 'qbittorrent_widget') {
        $j = @json_decode((string)@file_get_contents('/boot/config/plugins/qbittorrent_widget/tools.json'), true);
        return is_array($j) ? trim((string)($j['dc_hook'] ?? '')) : '';
    }
    $c = @parse_ini_file('/boot/config/plugins/' . $p . '/settings.cfg', false, INI_SCANNER_RAW);
    return is_array($c) ? trim((string)($c['dc_hook'] ?? ''), "\"' ") : '';
}

// one HTTP request: [code, body, error]
function mt_bot_http($method, $url, $headers, $body = null) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [CURLOPT_CUSTOMREQUEST => $method, CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 15, CURLOPT_CONNECTTIMEOUT => 8, CURLOPT_HTTPHEADER => $headers]);
    if ($body !== null) { curl_setopt($ch, CURLOPT_POSTFIELDS, $body); }
    $b = curl_exec($ch); $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE); $err = $b === false ? curl_error($ch) : '';
    curl_close($ch);
    return [$code, (string)$b, $err];
}
// Discord REST as the bot: [code, json, error]; one wait on a rate limit
function mt_bot_api($method, $path, $body = null) {
    $base = getenv('MT_BOT_API') ?: 'https://discord.com/api/v10';
    $tok = mt_bot_cfg()['token'];
    for ($try = 0; $try < 2; $try++) {
        $h = ['Authorization: Bot ' . $tok, 'User-Agent: DiscordBot (mediaserver-tools, 1)', 'Content-Type: application/json'];
        [$code, $b, $err] = mt_bot_http($method, $base . $path, $h, $body !== null ? json_encode($body, JSON_UNESCAPED_UNICODE) : ($method === 'PUT' ? '' : null));
        if ($err !== '') { return [0, null, $err]; }
        $j = json_decode($b, true);
        if ($code === 429 && $try === 0) { $w = is_array($j) ? (float)($j['retry_after'] ?? 1) : 1.0; if ($w <= 5) { usleep((int)(($w + 0.2) * 1e6)); continue; } }
        if ($code >= 400) { return [$code, $j, 'Discord HTTP ' . $code . (is_array($j) && !empty($j['message']) ? ': ' . $j['message'] : '')]; }
        return [$code, $j, ''];
    }
    return [429, null, 'Discord rate limit'];
}

// The Test button of the block: the token works, a message goes out with this plugin's webhook, the bot reacts under it
// and reads the reaction back (the three permissions). Nothing waits for the owner. Returns [ok, page text].
function mt_bot_test($plugin) {
    $c = mt_bot_cfg();
    if ($c['token'] === '') { return [false, mt_bot_t('bot.t.no_token')]; }
    [$code, $me, $e] = mt_bot_api('GET', '/users/@me');
    if ($e !== '') { return [false, mt_bot_t('bot.t.token', ['e' => $e])]; }
    $name = (string)($me['username'] ?? 'bot');
    $hook = mt_bot_hook();
    if ($hook === '') { return [false, mt_bot_t('bot.t.no_hook', ['p' => $plugin])]; }
    $emb = ['title' => mt_bot_t('bot.d.title', ['p' => $plugin], true), 'description' => mt_bot_t('bot.d.desc', ['bot' => $name], true), 'color' => 0x9A7DE6];
    [$hc, $hb, $he] = mt_bot_http('POST', $hook . (strpos($hook, '?') === false ? '?' : '&') . 'wait=true', ['Content-Type: application/json'], json_encode(['embeds' => [$emb]], JSON_UNESCAPED_UNICODE));
    $msg = json_decode($hb, true);
    if ($he !== '' || $hc >= 400 || !is_array($msg) || empty($msg['id'])) { return [false, mt_bot_t('bot.t.hook', ['e' => $he !== '' ? $he : 'HTTP ' . $hc])]; }
    $path = '/channels/' . (string)($msg['channel_id'] ?? '') . '/messages/' . $msg['id'] . '/reactions/' . rawurlencode("\u{2705}");
    [$rc, $rj, $re] = mt_bot_api('PUT', $path . '/@me');
    if ($re !== '') { return [false, mt_bot_t('bot.t.react', ['e' => $re])]; }
    [$gc, $gj, $ge] = mt_bot_api('GET', $path . '?limit=10');
    if ($ge !== '' || !is_array($gj)) { return [false, mt_bot_t('bot.t.read', ['e' => $ge !== '' ? $ge : 'HTTP ' . $gc])]; }
    return [true, trim(mt_bot_t('bot.t.ok', ['bot' => $name]) . ($c['user'] === '' ? ' ' . mt_bot_t('bot.t.no_user') : ''))];
}

}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD BOT BLOCK -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/bot_block.php">
<INLINE><![CDATA[<?php
// The Discord bot block (Seedbox Tools settings, Sysbox Claude Guard; item 95): the shared setting of bot.php. The page
// sets $mt_bot_post (this plugin's bot_save.php) and includes this file. The token never goes into the page.
require_once __DIR__ . '/bot.php';
$mtb_c = mt_bot_cfg();
$mtb_var = @parse_ini_file('/var/local/emhttp/var.ini');
$mtb_tok = is_array($mtb_var) ? (string)($mtb_var['csrf_token'] ?? '') : '';
$mtb_h = function ($k, $v = []) { return htmlspecialchars(mt_bot_t($k, $v), ENT_QUOTES); };
$mtb_state = $mtb_c['token'] === '' ? mt_bot_t('bot.st.off') : ($mtb_c['user'] === '' ? mt_bot_t('bot.st.no_user') : mt_bot_t('bot.st.on'));
?>
<style>
#mtb{margin:28px 0 8px;max-width:1100px}
#mtb .mtb-band{display:flex;justify-content:space-between;align-items:center;gap:12px;background:rgba(0,0,0,.35);padding:10px 14px;text-transform:uppercase;letter-spacing:1.5px;font-size:12px}
#mtb .mtb-band b{font-weight:normal;text-transform:none;letter-spacing:0;opacity:.6}
#mtb .mtb-box{background:rgba(128,128,128,.08);border-radius:0 0 6px 6px}
#mtb .mtb-row{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px;padding:14px 16px;border-left:3px solid #8a8a8a;border-bottom:1px solid rgba(128,128,128,.15)}
#mtb .mtb-row.on{border-left-color:#3fa24a}
#mtb .mtb-row label{padding-top:6px}
#mtb .mtb-row input[type=password],#mtb .mtb-row input[type=text]{width:320px;max-width:100%;margin:0}
#mtb .mtb-hint{display:block;opacity:.6;line-height:1.5;margin-top:6px;white-space:normal}
#mtb .mtb-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px;flex-wrap:wrap}
#mtb .mtb-foot button{margin:0 0 0 8px}
#mtb .mtb-foot .mtb-ghost{background:transparent;border:1px solid rgba(128,128,128,.5)}
@media (max-width:700px){#mtb .mtb-row{grid-template-columns:1fr;gap:4px}}
</style>
<div id="mtb">
  <div class="mtb-band"><span><?=$mtb_h('bot.h.band')?></span><b id="mtb-state"><?=htmlspecialchars($mtb_state, ENT_QUOTES)?></b></div>
  <div class="mtb-box">
    <div class="mtb-row<?=$mtb_c['token'] !== '' ? ' on' : ''?>">
      <label for="mtb-token"><?=$mtb_h('bot.l.token')?></label>
      <div>
        <input type="password" id="mtb-token" autocomplete="new-password" placeholder="<?=$mtb_h($mtb_c['token'] !== '' ? 'bot.ph.saved' : 'bot.ph.token')?>">
        <span class="mtb-hint"><?=$mtb_h('bot.hint.token')?></span>
      </div>
    </div>
    <div class="mtb-row<?=$mtb_c['user'] !== '' ? ' on' : ''?>">
      <label for="mtb-user"><?=$mtb_h('bot.l.user')?></label>
      <div>
        <input type="text" id="mtb-user" inputmode="numeric" value="<?=htmlspecialchars($mtb_c['user'], ENT_QUOTES)?>" placeholder="<?=$mtb_h('bot.ph.user')?>">
        <span class="mtb-hint"><?=$mtb_h('bot.hint.user')?></span>
      </div>
    </div>
    <div class="mtb-foot">
      <span id="mtb-msg" class="mtb-hint" style="margin:0"><?=$mtb_h('bot.hint.foot')?></span>
      <span><button type="button" id="mtb-test" class="mtb-ghost"><?=$mtb_h('bot.btn.test')?></button><button type="button" id="mtb-apply"><?=$mtb_h('bot.btn.save')?></button></span>
    </div>
  </div>
</div>
<script>
$(function () {
  // outside every form: Unraid's Apply-disabling does not apply, enable the buttons after Unraid's scripts ran (like the Language block)
  var en = function () { $('#mtb-apply, #mtb-test').prop('disabled', false).removeAttr('disabled'); };
  en(); setTimeout(en, 500);
  var URL = <?=json_encode((string)$mt_bot_post)?>, TOK = <?=json_encode($mtb_tok)?>;
  var TX = <?=json_encode(['wait' => mt_bot_t('bot.wait'), 'fail' => mt_bot_t('bot.fail'), 'saved_ph' => mt_bot_t('bot.ph.saved'), 'ph' => mt_bot_t('bot.ph.token'), 'on' => mt_bot_t('bot.st.on'), 'off' => mt_bot_t('bot.st.off'), 'no_user' => mt_bot_t('bot.st.no_user')], JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP)?>;
  var show = function (ok, t) { $('#mtb-msg').css({ color: ok ? '#3fa24a' : '#e5534b', opacity: 1 }).text(t); };
  var call = function ($b, data, done) {
    $b.prop('disabled', true); $('#mtb-msg').css({ color: '', opacity: .6 }).text(TX.wait);
    $.post(URL, $.extend({ csrf_token: TOK }, data), null, 'json')
      .done(function (r) { show(r.ok, r.ok ? r.msg : (r.error || TX.fail)); if (r.ok && done) { done(r); } })
      .fail(function (x) { show(false, (x.responseJSON && x.responseJSON.error) || TX.fail); })
      .always(function () { $b.prop('disabled', false); });
  };
  $('#mtb-apply').on('click', function () {
    var u = $.trim($('#mtb-user').val());
    call($(this), { op: 'save', token: $.trim($('#mtb-token').val()), user: u }, function (r) {
      $('#mtb-token').val('').attr('placeholder', r.token_set ? TX.saved_ph : TX.ph);
      $('#mtb-token').closest('.mtb-row').toggleClass('on', r.token_set); $('#mtb-user').closest('.mtb-row').toggleClass('on', u !== '');
      $('#mtb-state').text(!r.token_set ? TX.off : (u === '' ? TX.no_user : TX.on));
    });
  });
  $('#mtb-test').on('click', function () { call($(this), { op: 'test' }); });
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD BOT SAVE AND TEST -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/bot_save.php">
<INLINE><![CDATA[<?php
// Saves or tests the shared Discord bot setting (see bot.php). POST op=save (token, user) | test, csrf_token.
require_once __DIR__ . '/bot.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function mt_bot_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra)); exit; }
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); mt_bot_out(false, ['error' => 'method']); }
$var = @parse_ini_file('/var/local/emhttp/var.ini');
$tok = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
// Unraid's own prepend checks the token of every POST and then removes it from $_POST (like lang_save.php)
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); mt_bot_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); mt_bot_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}
$op = (string)($_POST['op'] ?? '');
if ($op === 'save') {
    $e = mt_bot_save((string)($_POST['token'] ?? ''), (string)($_POST['user'] ?? ''));
    if ($e !== '') { mt_bot_out(false, ['error' => mt_bot_t($e)]); }
    $c = mt_bot_cfg();
    mt_bot_out(true, ['msg' => mt_bot_t($c['token'] === '' ? 'bot.saved_off' : 'bot.saved'), 'token_set' => $c['token'] !== '']);
}
if ($op === 'test') {
    $p = basename(__DIR__) === 'qbittorrent_widget' ? 'Seedbox' : ucfirst(basename(__DIR__));
    [$ok, $m] = mt_bot_test($p);
    mt_bot_out($ok, $ok ? ['msg' => $m] : ['error' => $m]);
}
mt_bot_out(false, ['error' => 'op']);
]]></INLINE>
</FILE>

