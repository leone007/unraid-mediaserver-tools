#gdm .gdm-status{display:flex;flex-wrap:wrap;gap:6px 18px;align-items:center;padding:9px 12px;border-top:1px solid var(--gdm-line);font-size:12px}
#gdm .gdm-status b{font-variant-numeric:tabular-nums;font-weight:600}
#gdm .gdm-row{display:grid;gap:10px;align-items:start;padding:10px 12px;border-top:1px solid var(--gdm-line)}
#gdm .gdm-row small{display:block;opacity:.6}
#gdm .s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
#gdm .s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
#gdm .s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
#gdm .s-red{background:rgba(229,83,75,.13);box-shadow:inset 3px 0 0 #e5534b}
#gdm .s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
#gdm .s-grey{background:rgba(128,128,128,.07);box-shadow:inset 3px 0 0 #8a8a8a}
#gdm .gdm-job{grid-template-columns:22px minmax(0,1fr) auto;align-items:center}
#gdm .gdm-ico{font-family:monospace;font-weight:bold;text-align:center}
#gdm .gdm-num{font-family:monospace;font-size:12px;opacity:.7;text-align:right;white-space:nowrap}
#gdm .gdm-it{grid-template-columns:minmax(120px,170px) minmax(0,1fr) auto}
