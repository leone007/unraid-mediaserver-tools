<FILE Name="&plugdir;/Monitor.page">
<INLINE><![CDATA[Menu="Utilities"
Type="xmenu"
Title="Monitor"
Icon="monitor.png"
Markdown="false"
---
<?PHP
// Phone-friendly server monitor: shows the Sysbox, Diskbox, Streambox and Seedbox tiles on one page,
// in an order you choose. The tiles are not copied: each one is taken from the plugin's own dashboard
// page, so they always match the dashboard and update with the plugins.
$mon_tiles = [
  ['sysbox', 'Sysbox'],
  ['diskbox', 'Diskbox'],
  ['streambox', 'Streambox'],
  ['qbittorrent_widget', 'Seedbox'],
];
$mon_root = '/usr/local/emhttp/plugins/';
// texts from the dictionary (lang/en.json and its translations, see i18n.php)
require_once $mon_root . 'mediaserver_monitor/i18n.php';
$mon_lang = $mon_root . 'mediaserver_monitor/lang';
$mon_T = mt_i18n_t($mon_lang);   // own name: the tile pages below run in this same scope
$mon_out = [];
foreach ($mon_tiles as $mon_t) {
  $mon_f = $mon_root . $mon_t[0] . '/' . $mon_t[0] . '.page';
  if (!is_file($mon_f)) { continue; }
  $mon_src = (string)file_get_contents($mon_f);
  $mon_p = strpos($mon_src, "\n---\n");
  if ($mon_p === false) { continue; }
  $mytiles = [];
  ob_start();
  try { eval('?>' . substr($mon_src, $mon_p + 5)); } catch (\Throwable $mon_e) { }
  $mon_rest = ob_get_clean();
  $mon_html = $mytiles[$mon_t[0]]['column2'] ?? '';
  if ($mon_html === '') { continue; }
  $mon_out[] = [$mon_t[0], $mon_t[1], $mon_html, $mon_rest];
}
?>
<style>
.mon-in{max-width:760px;margin:0 auto;padding:0 2px}
html.mon-full,html.mon-full body{overflow:hidden!important}
html.mon-full .mon-wrap{position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483000;overflow-y:auto;-webkit-overflow-scrolling:touch;box-sizing:border-box;padding:calc(env(safe-area-inset-top,0px) + 10px) 12px calc(env(safe-area-inset-bottom,0px) + 18px)}
a.mon-btn{text-decoration:none;display:inline-block}
.mon-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 0 10px}
.mon-top h2{margin:0;font-size:18px;letter-spacing:.04em}
.mon-top .mon-b{display:flex;gap:8px}
.mon-btn{font:inherit;font-size:13px;line-height:1;padding:8px 14px;border-radius:6px;border:0;cursor:pointer;background:rgba(128,128,128,.25);color:inherit}
.mon-btn.on{background:#e68a00;color:#fff}
.mon-sec{margin:0 0 14px}
.mon-ed{display:none;align-items:center;justify-content:space-between;gap:8px;margin:0 0 6px;font-size:13px;opacity:.9}
.mon-edit .mon-ed{display:flex}
.mon-ed .mon-nm{font-weight:600;letter-spacing:.04em}
.mon-ed .mon-bt{display:flex;gap:6px}
.mon-ed .mon-btn{padding:9px 14px;font-size:15px}
.mon-sec table.mon-t{width:100%;margin:0;border-collapse:separate;border-spacing:0;table-layout:fixed;box-sizing:border-box;padding:12px 14px;border:1px solid rgba(128,128,128,.35);border-radius:6px;background:rgba(128,128,128,.07)}
.mon-sec table.mon-t td{display:block;padding:0}
.mon-sec .tile-header{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 0 6px}
.mon-sec .tile-header-left{display:flex;align-items:center;gap:10px;min-width:0}
.mon-sec .tile-header-left .section{min-width:0}
.mon-sec .tile-header-main{margin:0}
.mon-sec .tile-header-right-controls{display:flex;gap:12px;white-space:nowrap}
.mon-sec.mon-off table.mon-t,.mon-sec.mon-off .mon-x{display:none}
.mon-sec.mon-off{opacity:.55}
.mon-sec:not(.mon-off) .mon-ed .mon-eye{opacity:1}
.mon-off .mon-eye{opacity:.6}
.mon-sec.mon-off{display:none}
.mon-edit .mon-sec.mon-off{display:block}
.mon-note{font-size:12px;opacity:.65;margin:8px 0 0;text-align:center}
@media (max-width:600px){.mon-wrap{padding:0}}
</style>
<script>
// A request that iOS drops (page in the background, flaky connection) must not freeze a tile for good:
// every tile request gets a time limit, so its "busy" flag is always released and the next poll goes out.
(function () {
  if (!window.jQuery) { return; }
  var $ = window.jQuery;
  $.getJSON = function (url, data, cb) {
    if (typeof data === 'function') { cb = data; data = undefined; }
    return $.ajax({ url: url, data: data, dataType: 'json', timeout: 12000, success: cb });
  };
})();
</script>
<div class="mon-wrap" id="mon-wrap"><div class="mon-in">
  <div class="mon-top">
    <h2>Monitor</h2>
    <span class="mon-b"><button type="button" class="mon-btn" id="mon-full"><?=htmlspecialchars($mon_T('btn.full_screen'))?></button><button type="button" class="mon-btn" id="mon-edit"><?=htmlspecialchars($mon_T('btn.reorder'))?></button><button type="button" class="mon-btn" id="mon-reset" style="display:none"><?=htmlspecialchars($mon_T('btn.reset'))?></button></span>
  </div>
  <div id="mon-list">
<?PHP foreach ($mon_out as $mon_o) { ?>
    <section class="mon-sec" data-id="<?=htmlspecialchars($mon_o[0])?>">
      <div class="mon-ed"><span class="mon-nm"><?=htmlspecialchars($mon_o[1])?></span><span class="mon-bt"><button type="button" class="mon-btn mon-eye" data-a="eye"><?=htmlspecialchars($mon_T('btn.hide'))?></button><button type="button" class="mon-btn" data-a="up" title="<?=htmlspecialchars($mon_T('btn.up'))?>">&#9650;</button><button type="button" class="mon-btn" data-a="down" title="<?=htmlspecialchars($mon_T('btn.down'))?>">&#9660;</button></span></div>
      <table class="mon-t dashboard"><?=$mon_o[2]?></table>
      <div class="mon-x"><?=$mon_o[3]?></div>
    </section>
<?PHP } ?>
  </div>
<?PHP if (!$mon_out) { ?>
  <p class="mon-note"><?=htmlspecialchars($mon_T('note.no_tiles'))?></p>
<?PHP } else { ?>
  <p class="mon-note"><?=htmlspecialchars($mon_T('note.saved_here'))?></p>
<?PHP } ?>
</div></div>
<?=mt_i18n_js($mon_lang, 'mon')?>
<script>
(function () {
  var T = function (k, v) { return MTL.t('mon', k, v); };
  var DEF = ['sysbox', 'diskbox', 'streambox', 'qbittorrent_widget'], KO = 'mon_order', KH = 'mon_hide';
  function ld(k, d) { try { var v = JSON.parse(localStorage.getItem(k)); return v instanceof Array ? v : d; } catch (e) { return d; } }
  function sv(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { } }
  var list = document.getElementById('mon-list'), wrap = document.getElementById('mon-wrap');
  function secs() { return [].slice.call(list.children).filter(function (n) { return n.tagName === 'SECTION'; }); }
  function byId(id) { return secs().filter(function (s) { return s.getAttribute('data-id') === id; })[0]; }
  function apply() {
    var saved = ld(KO, []), order = [];
    saved.concat(DEF).forEach(function (id) { if (order.indexOf(id) < 0 && byId(id)) { order.push(id); } });
    order.forEach(function (id) { list.appendChild(byId(id)); });
    var hid = ld(KH, []);
    secs().forEach(function (s) {
      var off = hid.indexOf(s.getAttribute('data-id')) >= 0;
      s.classList.toggle('mon-off', off);
      s.querySelector('.mon-eye').textContent = off ? T('btn.show') : T('btn.hide');
    });
  }
  function save() { sv(KO, secs().map(function (s) { return s.getAttribute('data-id'); })); }
  list.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('button[data-a]') : null;
    if (!b) { return; }
    var s = b.closest('section'), a = b.getAttribute('data-a'), id = s.getAttribute('data-id');
    if (a === 'up') { var p = s.previousElementSibling; if (p) { list.insertBefore(s, p); } save(); }
    else if (a === 'down') { var n = s.nextElementSibling; if (n) { list.insertBefore(n, s); } save(); }
    else if (a === 'eye') {
      var hid = ld(KH, []), i = hid.indexOf(id);
      if (i >= 0) { hid.splice(i, 1); } else { hid.push(id); }
      sv(KH, hid); apply();
    }
  });
  var eb = document.getElementById('mon-edit'), rb = document.getElementById('mon-reset');
  eb.addEventListener('click', function () {
    var on = !wrap.classList.contains('mon-edit');
    wrap.classList.toggle('mon-edit', on); eb.classList.toggle('on', on);
    eb.textContent = on ? T('btn.done') : T('btn.reorder'); rb.style.display = on ? '' : 'none';
  });
  rb.addEventListener('click', function () { sv(KO, []); sv(KH, []); apply(); });
  // full screen: covers the Unraid header and menu (automatic when opened from the home screen)
  var root = document.documentElement, fb = document.getElementById('mon-full');
  var standalone = (window.navigator.standalone === true) || (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches);
  function bg() {
    var c = '';
    [document.body, root].forEach(function (n) { var v = getComputedStyle(n).backgroundColor; if (!c && v && v !== 'transparent' && v !== 'rgba(0, 0, 0, 0)') { c = v; } });
    return c || '#1c1b1b';
  }
  function full(on, keep) {
    root.classList.toggle('mon-full', on);
    wrap.style.background = on ? bg() : '';
    fb.textContent = on ? T('btn.unraid_menu') : T('btn.full_screen');
    if (keep) { try { localStorage.setItem('mon_full', on ? '1' : '0'); } catch (e) { } }
  }
  fb.addEventListener('click', function () {
    if (standalone && root.classList.contains('mon-full')) { location.href = '/Dashboard'; return; }
    full(!root.classList.contains('mon-full'), true);
  });
  var sf = null; try { sf = localStorage.getItem('mon_full'); } catch (e) { }
  full(standalone || sf === '1' || /[?&]full=1/.test(location.search), false);
  apply();
  // home screen app on iPhone: own name and icon
  try {
    var h = document.head, add = function (t, a) { var x = document.createElement(t); for (var k in a) { x.setAttribute(k, a[k]); } h.appendChild(x); };
    add('meta', { name: 'apple-mobile-web-app-capable', content: 'yes' });
    add('meta', { name: 'apple-mobile-web-app-title', content: 'Monitor' });
    add('link', { rel: 'apple-touch-icon', href: '/plugins/mediaserver_monitor/touch.png' });
  } catch (e) { }
})();
</script>
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/lang.php">
<INLINE><![CDATA[<?php
// Shared language setting of the media server tools (Sysbox, Diskbox, Seedbox, Streambox): one file on the
// flash drive that every plugin reads, so changing it on any settings page changes it for all of them.
//   ui      = auto (follow Unraid's language, Settings, Display Settings) | en
//   discord = auto (follow Unraid) | en | hu
// A language the pages or Discord are not translated to falls back to English. Every plugin ships its own
// copy of this file; the guard keeps a second copy from being declared again in the same request.
if (!function_exists('mt_lang_cfg')) {

define('MT_LANG_FILE', '/boot/config/plugins/mediaserver-tools/lang.cfg');

function mt_lang_have($what) { return $what === 'discord' ? ['en', 'hu'] : ['en']; }

// Unraid's display language as a locale ('' = English, the built-in one)
function mt_lang_unraid() {
    $d = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true);
    return (is_array($d) && isset($d['display']) && is_array($d['display'])) ? trim((string)($d['display']['locale'] ?? '')) : '';
}
function mt_lang_code($locale) { $c = strtolower(substr((string)$locale, 0, 2)); return preg_match('/^[a-z]{2}$/', $c) ? $c : 'en'; }
function mt_lang_name($code) {
    $n = ['en' => 'English', 'hu' => 'Magyar', 'de' => 'Deutsch', 'fr' => 'Français', 'es' => 'Español', 'it' => 'Italiano', 'nl' => 'Nederlands',
          'pl' => 'Polski', 'pt' => 'Português', 'ru' => 'Русский', 'zh' => '中文', 'ja' => '日本語', 'ko' => '한국어', 'cs' => 'Čeština', 'sv' => 'Svenska'];
    return $n[$code] ?? $code;
}

// Before the shared setting existed every plugin had its own Discord language, Hungarian by default: a server
// that already sends Discord messages keeps the language it had; a new install starts in English.
function mt_lang_legacy() {
    $ini = function ($f) { $c = is_file($f) ? @parse_ini_file($f, false, INI_SCANNER_RAW) : false; return is_array($c) ? $c : null; };
    foreach (['/boot/config/plugins/sysbox/settings.cfg', '/boot/config/plugins/diskbox/settings.cfg'] as $f) {
        $c = $ini($f);
        if ($c === null) { continue; }
        if (isset($c['dc_lang'])) { return trim((string)$c['dc_lang'], "\"' ") === 'en' ? 'en' : 'hu'; }
        if (trim((string)($c['dc_hook'] ?? ''), "\"' ") !== '') { return 'hu'; }
    }
    $j = @json_decode((string)@file_get_contents('/boot/config/plugins/qbittorrent_widget/tools.json'), true);
    if (is_array($j)) {
        if (isset($j['dc_lang'])) { return $j['dc_lang'] === 'en' ? 'en' : 'hu'; }
        if (trim((string)($j['dc_hook'] ?? '')) !== '') { return 'hu'; }
    }
    $c = $ini('/boot/config/plugins/streambox/settings.cfg');
    if ($c !== null && (trim((string)($c['dc_movies'] ?? ''), "\"' ") !== '' || trim((string)($c['dc_series'] ?? ''), "\"' ") !== '')) { return 'hu'; }
    return 'en';
}

function mt_lang_cfg() {
    $c = ['ui' => 'auto', 'discord' => ''];
    $f = is_file(MT_LANG_FILE) ? @parse_ini_file(MT_LANG_FILE) : false;
    if (is_array($f)) {
        if (($f['ui'] ?? '') === 'auto' || in_array($f['ui'] ?? '', mt_lang_have('ui'), true)) { $c['ui'] = $f['ui']; }
        if (in_array($f['discord'] ?? '', ['auto', 'en', 'hu'], true)) { $c['discord'] = $f['discord']; }
    }
    if ($c['discord'] === '') { $c['discord'] = mt_lang_legacy(); }
    return $c;
}

// The language the pages and tiles ask for (the dictionaries of i18n.php fall back to English per text)
function mt_lang_ui_want() {
    $c = mt_lang_cfg();
    return $c['ui'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['ui'];
}
// The language the pages and tiles use, and the one Discord messages use (always one that exists)
function mt_lang_ui() {
    $c = mt_lang_cfg();
    $w = $c['ui'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['ui'];
    return in_array($w, mt_lang_have('ui'), true) ? $w : 'en';
}
function mt_lang_discord() {
    static $l = null;
    if ($l !== null) { return $l; }
    $c = mt_lang_cfg();
    $w = $c['discord'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['discord'];
    return $l = in_array($w, mt_lang_have('discord'), true) ? $w : 'en';
}

function mt_lang_save($ui, $discord) {
    if (($ui !== 'auto' && !in_array($ui, mt_lang_have('ui'), true)) || !in_array($discord, ['auto', 'en', 'hu'], true)) { return false; }
    @mkdir(dirname(MT_LANG_FILE), 0777, true);
    $tmp = MT_LANG_FILE . '.tmp';
    if (@file_put_contents($tmp, 'ui="' . $ui . "\"\ndiscord=\"" . $discord . "\"\n") === false) { return false; }
    return @rename($tmp, MT_LANG_FILE);
}

}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/i18n.php">
<INLINE><![CDATA[<?php
// Dictionaries of the pages and tiles. Each plugin keeps its texts in <plugdir>/lang/<code>.json:
// en.json is the source (every key, with a note for the translator), <code>.json a translation of it.
// The language is the shared setting of lang.php (Follow Unraid or a chosen one); a missing file, key or
// form falls back to English, so a partial translation never breaks a page.
//   entry:        "key": {"text": "Hide", "note": "button ..."}
//   plural entry: "key": {"one": "{n} torrent", "other": "{n} torrents", "note": "..."}
//   placeholders: {name} in the text, filled from $vars / vars
// PHP: $T = mt_i18n_t('/usr/local/emhttp/plugins/<id>/lang'); echo $T('key', ['n' => 3]);
// JS:  echo mt_i18n_js($dir, 'mon'); then MTL.t('mon', 'key', {n: 3}) (pages wrap it as T('key'))
if (!function_exists('mt_i18n')) {

require_once __DIR__ . '/lang.php';

function mt_i18n($dir) {
    static $cache = [];
    if (isset($cache[$dir])) { return $cache[$dir]; }
    $read = function ($f) { $j = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null; return is_array($j) ? $j : []; };
    $en = $read($dir . '/en.json');
    $code = mt_lang_ui_want();
    $tr = $code !== 'en' && preg_match('/^[a-z]{2}$/', $code) ? $read($dir . '/' . $code . '.json') : [];
    $out = [];
    foreach ($en as $k => $v) {
        if ($k === '' || $k[0] === '_' || !is_array($v)) { continue; }
        $e = [];
        foreach (['text', 'one', 'other'] as $f) {
            if (!isset($v[$f])) { continue; }
            $t = $tr[$k][$f] ?? null;
            $e[$f] = (is_string($t) && trim($t) !== '') ? $t : (string)$v[$f];
        }
        $out[$k] = $e;
    }
    return $cache[$dir] = $out;
}

function mt_i18n_fmt($e, $vars) {
    if ($e === null) { return null; }
    if (isset($e['other'])) { $n = (float)($vars['n'] ?? 0); $s = (abs($n) == 1 && isset($e['one'])) ? $e['one'] : $e['other']; }
    else { $s = $e['text'] ?? ''; }
    return preg_replace_callback('/\{([a-z0-9_]+)\}/', function ($m) use ($vars) { return array_key_exists($m[1], $vars) ? (string)$vars[$m[1]] : $m[0]; }, $s);
}

// a translate function for one plugin's dictionary; an unknown key shows as itself (easy to spot)
function mt_i18n_t($dir) {
    $tab = mt_i18n($dir);
    return function ($key, $vars = []) use ($tab) { $s = mt_i18n_fmt($tab[$key] ?? null, (array)$vars); return $s === null ? $key : $s; };
}

// the same dictionary for the page's JavaScript: MTL.t(name, key, vars)
function mt_i18n_js($dir, $name) {
    return '<script>window.MTL=window.MTL||{d:{},t:function(n,k,v){var e=(this.d[n]||{})[k],s;if(!e){return k;}v=v||{};'
        . 'if(e.other!==undefined){var c=Math.abs(+v.n||0);s=(c===1&&e.one!==undefined)?e.one:e.other;}else{s=e.text||"";}'
        . 'return s.replace(/\{([a-z0-9_]+)\}/g,function(a,b){return v.hasOwnProperty(b)?String(v[b]):a;});}};'
        . 'MTL.d[' . json_encode((string)$name) . ']=' . json_encode(mt_i18n($dir), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP) . ';</script>';
}

}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/lang/en.json">
<INLINE><![CDATA[{
  "_meta": {
    "plugin": "Monitor",
    "language": "English",
    "about": "Texts of the Monitor page (Settings, Utilities, Monitor): the Sysbox, Diskbox, Streambox and Seedbox dashboard tiles in one column, made for a phone. Product names (Monitor, Sysbox, Diskbox, Streambox, Seedbox, Unraid) are not translated."
  },
  "btn.full_screen": {"text": "Full screen", "note": "button at the top of the page: hides the Unraid header and menu so only the tiles show. Short, it sits next to two other buttons on a phone screen."},
  "btn.unraid_menu": {"text": "Unraid menu", "note": "the same button while full screen is on: shows the Unraid header and menu again. Short."},
  "btn.reorder": {"text": "Reorder", "note": "button: starts editing the order of the tiles (up, down, hide). Short."},
  "btn.done": {"text": "Done", "note": "the Reorder button while editing: ends editing. Short."},
  "btn.reset": {"text": "Reset", "note": "button shown while editing: puts the tiles back in the default order and shows the hidden ones. Short."},
  "btn.hide": {"text": "Hide", "note": "button next to a tile's name while editing: hides that tile on this page. Short."},
  "btn.show": {"text": "Show", "note": "the same button for a hidden tile: shows it again. Short."},
  "btn.up": {"text": "Move up", "note": "tooltip of the up arrow button next to a tile's name while editing."},
  "btn.down": {"text": "Move down", "note": "tooltip of the down arrow button next to a tile's name while editing."},
  "note.no_tiles": {"text": "No tiles found. Install Sysbox, Diskbox, Streambox or Seedbox first.", "note": "small centred line when none of the four plugins is installed."},
  "note.saved_here": {"text": "The order is saved on this device only.", "note": "small centred line under the tiles: the order and the hidden tiles are kept in this browser, not on the server."}
}
]]></INLINE>
</FILE>

<FILE Name="/tmp/&name;_finish.sh" Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
DIR="/usr/local/emhttp/plugins/mediaserver_monitor"
chmod 644 "$DIR"/*.page "$DIR"/*.php "$DIR"/*.png
PHPBIN="$(command -v php || echo /usr/bin/php)"
# Updates come from GitHub (pluginURL): stop the local update server of earlier versions
pkill -f "php -S 127.0.0.1:18185" 2>/dev/null
rm -f /usr/local/emhttp/plugins/mediaserver_monitor/repo.php
rm -f /tmp/mediaserver_monitor_setup.sh /tmp/mediaserver_monitor_finish.sh
echo ""
echo "----------------------------------------------------"
echo " Monitor installed: Settings -> Utilities -> Monitor"
echo " It shows the Sysbox, Diskbox, Streambox and Seedbox"
echo " tiles, so install those plugins too."
echo "----------------------------------------------------"
exit 0
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
rm -rf /usr/local/emhttp/plugins/mediaserver_monitor
rm -rf /usr/local/emhttp/plugins/Monitor
pkill -f "php -S 127.0.0.1:18185" 2>/dev/null
echo "Monitor removed."
exit 0
]]></INLINE>
</FILE>

</PLUGIN>
