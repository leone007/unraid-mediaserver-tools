</FILE>

<FILE Name="&plugdir;/Monitor.page">
<INLINE><![CDATA[Menu="Utilities"
Type="xmenu"
Title="Monitor"
Icon="monitor.png"
Markdown="false"
---
<?PHP
// Phone-friendly server monitor: shows the Sysbox, Diskbox, Streambox and Seedbox tiles on one page,
// in an order you choose. The tiles are not copied: each one is taken from the plugin's own dashboard
// page, so they always match the dashboard and update with the plugins.
$mon_tiles = [
  ['sysbox', 'Sysbox'],
  ['diskbox', 'Diskbox'],
  ['streambox', 'Streambox'],
  ['qbittorrent_widget', 'Seedbox'],
];
$mon_root = '/usr/local/emhttp/plugins/';
$mon_out = [];
foreach ($mon_tiles as $mon_t) {
  $mon_f = $mon_root . $mon_t[0] . '/' . $mon_t[0] . '.page';
  if (!is_file($mon_f)) { continue; }
  $mon_src = (string)file_get_contents($mon_f);
  $mon_p = strpos($mon_src, "\n---\n");
  if ($mon_p === false) { continue; }
  $mytiles = [];
  ob_start();
  try { eval('?>' . substr($mon_src, $mon_p + 5)); } catch (\Throwable $mon_e) { }
  $mon_rest = ob_get_clean();
  $mon_html = $mytiles[$mon_t[0]]['column2'] ?? '';
  if ($mon_html === '') { continue; }
  $mon_out[] = [$mon_t[0], $mon_t[1], $mon_html, $mon_rest];
}
?>
<style>
.mon-in{max-width:760px;margin:0 auto;padding:0 2px}
html.mon-full,html.mon-full body{overflow:hidden!important}
html.mon-full .mon-wrap{position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483000;overflow-y:auto;-webkit-overflow-scrolling:touch;box-sizing:border-box;padding:calc(env(safe-area-inset-top,0px) + 10px) 12px calc(env(safe-area-inset-bottom,0px) + 18px)}
a.mon-btn{text-decoration:none;display:inline-block}
.mon-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 0 10px}
.mon-top h2{margin:0;font-size:18px;letter-spacing:.04em}
.mon-top .mon-b{display:flex;gap:8px}
.mon-btn{font:inherit;font-size:13px;line-height:1;padding:8px 14px;border-radius:6px;border:0;cursor:pointer;background:rgba(128,128,128,.25);color:inherit}
.mon-btn.on{background:#e68a00;color:#fff}
.mon-sec{margin:0 0 14px}
.mon-ed{display:none;align-items:center;justify-content:space-between;gap:8px;margin:0 0 6px;font-size:13px;opacity:.9}
.mon-edit .mon-ed{display:flex}
.mon-ed .mon-nm{font-weight:600;letter-spacing:.04em}
.mon-ed .mon-bt{display:flex;gap:6px}
.mon-ed .mon-btn{padding:9px 14px;font-size:15px}
.mon-sec table.mon-t{width:100%;margin:0;border-collapse:separate;border-spacing:0;table-layout:fixed;box-sizing:border-box;padding:12px 14px;border:1px solid rgba(128,128,128,.35);border-radius:6px;background:rgba(128,128,128,.07)}
.mon-sec table.mon-t td{display:block;padding:0}
.mon-sec .tile-header{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 0 6px}
.mon-sec .tile-header-left{display:flex;align-items:center;gap:10px;min-width:0}
.mon-sec .tile-header-left .section{min-width:0}
.mon-sec .tile-header-main{margin:0}
.mon-sec .tile-header-right-controls{display:flex;gap:12px;white-space:nowrap}
.mon-sec.mon-off table.mon-t,.mon-sec.mon-off .mon-x{display:none}
.mon-sec.mon-off{opacity:.55}
.mon-sec:not(.mon-off) .mon-ed .mon-eye{opacity:1}
.mon-off .mon-eye{opacity:.6}
.mon-sec.mon-off{display:none}
.mon-edit .mon-sec.mon-off{display:block}
.mon-note{font-size:12px;opacity:.65;margin:8px 0 0;text-align:center}
@media (max-width:600px){.mon-wrap{padding:0}}
</style>
<script>
// A request that iOS drops (page in the background, flaky connection) must not freeze a tile for good:
// every tile request gets a time limit, so its "busy" flag is always released and the next poll goes out.
(function () {
  if (!window.jQuery) { return; }
  var $ = window.jQuery;
  $.getJSON = function (url, data, cb) {
    if (typeof data === 'function') { cb = data; data = undefined; }
    return $.ajax({ url: url, data: data, dataType: 'json', timeout: 12000, success: cb });
  };
})();
</script>
<div class="mon-wrap" id="mon-wrap"><div class="mon-in">
  <div class="mon-top">
    <h2>Monitor</h2>
    <span class="mon-b"><button type="button" class="mon-btn" id="mon-full">Full screen</button><button type="button" class="mon-btn" id="mon-edit">Reorder</button><button type="button" class="mon-btn" id="mon-reset" style="display:none">Reset</button></span>
  </div>
  <div id="mon-list">
<?PHP foreach ($mon_out as $mon_o) { ?>
    <section class="mon-sec" data-id="<?=htmlspecialchars($mon_o[0])?>">
      <div class="mon-ed"><span class="mon-nm"><?=htmlspecialchars($mon_o[1])?></span><span class="mon-bt"><button type="button" class="mon-btn mon-eye" data-a="eye">Hide</button><button type="button" class="mon-btn" data-a="up">&#9650;</button><button type="button" class="mon-btn" data-a="down">&#9660;</button></span></div>
      <table class="mon-t dashboard"><?=$mon_o[2]?></table>
      <div class="mon-x"><?=$mon_o[3]?></div>
    </section>
<?PHP } ?>
  </div>
<?PHP if (!$mon_out) { ?>
  <p class="mon-note">No tiles found. Install Sysbox, Diskbox, Streambox or Seedbox first.</p>
<?PHP } else { ?>
  <p class="mon-note">The order is saved on this device only.</p>
<?PHP } ?>
</div></div>
<script>
(function () {
  var DEF = ['sysbox', 'diskbox', 'streambox', 'qbittorrent_widget'], KO = 'mon_order', KH = 'mon_hide';
  function ld(k, d) { try { var v = JSON.parse(localStorage.getItem(k)); return v instanceof Array ? v : d; } catch (e) { return d; } }
  function sv(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { } }
  var list = document.getElementById('mon-list'), wrap = document.getElementById('mon-wrap');
  function secs() { return [].slice.call(list.children).filter(function (n) { return n.tagName === 'SECTION'; }); }
  function byId(id) { return secs().filter(function (s) { return s.getAttribute('data-id') === id; })[0]; }
  function apply() {
    var saved = ld(KO, []), order = [];
    saved.concat(DEF).forEach(function (id) { if (order.indexOf(id) < 0 && byId(id)) { order.push(id); } });
    order.forEach(function (id) { list.appendChild(byId(id)); });
    var hid = ld(KH, []);
    secs().forEach(function (s) {
      var off = hid.indexOf(s.getAttribute('data-id')) >= 0;
      s.classList.toggle('mon-off', off);
      s.querySelector('.mon-eye').textContent = off ? 'Show' : 'Hide';
    });
  }
  function save() { sv(KO, secs().map(function (s) { return s.getAttribute('data-id'); })); }
  list.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('button[data-a]') : null;
    if (!b) { return; }
    var s = b.closest('section'), a = b.getAttribute('data-a'), id = s.getAttribute('data-id');
    if (a === 'up') { var p = s.previousElementSibling; if (p) { list.insertBefore(s, p); } save(); }
    else if (a === 'down') { var n = s.nextElementSibling; if (n) { list.insertBefore(n, s); } save(); }
    else if (a === 'eye') {
      var hid = ld(KH, []), i = hid.indexOf(id);
      if (i >= 0) { hid.splice(i, 1); } else { hid.push(id); }
      sv(KH, hid); apply();
    }
  });
  var eb = document.getElementById('mon-edit'), rb = document.getElementById('mon-reset');
  eb.addEventListener('click', function () {
    var on = !wrap.classList.contains('mon-edit');
    wrap.classList.toggle('mon-edit', on); eb.classList.toggle('on', on);
    eb.textContent = on ? 'Done' : 'Reorder'; rb.style.display = on ? '' : 'none';
  });
  rb.addEventListener('click', function () { sv(KO, []); sv(KH, []); apply(); });
  // full screen: covers the Unraid header and menu (automatic when opened from the home screen)
  var root = document.documentElement, fb = document.getElementById('mon-full');
  var standalone = (window.navigator.standalone === true) || (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches);
  function bg() {
    var c = '';
    [document.body, root].forEach(function (n) { var v = getComputedStyle(n).backgroundColor; if (!c && v && v !== 'transparent' && v !== 'rgba(0, 0, 0, 0)') { c = v; } });
    return c || '#1c1b1b';
  }
  function full(on, keep) {
    root.classList.toggle('mon-full', on);
    wrap.style.background = on ? bg() : '';
    fb.textContent = on ? 'Unraid menu' : 'Full screen';
    if (keep) { try { localStorage.setItem('mon_full', on ? '1' : '0'); } catch (e) { } }
  }
  fb.addEventListener('click', function () {
    if (standalone && root.classList.contains('mon-full')) { location.href = '/Dashboard'; return; }
    full(!root.classList.contains('mon-full'), true);
  });
  var sf = null; try { sf = localStorage.getItem('mon_full'); } catch (e) { }
  full(standalone || sf === '1' || /[?&]full=1/.test(location.search), false);
  apply();
  // home screen app on iPhone: own name and icon
  try {
    var h = document.head, add = function (t, a) { var x = document.createElement(t); for (var k in a) { x.setAttribute(k, a[k]); } h.appendChild(x); };
    add('meta', { name: 'apple-mobile-web-app-capable', content: 'yes' });
    add('meta', { name: 'apple-mobile-web-app-title', content: 'Monitor' });
    add('link', { rel: 'apple-touch-icon', href: '/plugins/mediaserver_monitor/touch.png' });
  } catch (e) { }
})();
</script>
]]></INLINE>
</FILE>

<FILE Name="/tmp/&name;_finish.sh" Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
DIR="/usr/local/emhttp/plugins/mediaserver_monitor"
chmod 644 "$DIR"/*.page "$DIR"/*.php "$DIR"/*.png
PHPBIN="$(command -v php || echo /usr/bin/php)"
# Updates come from GitHub (pluginURL): stop the local update server of earlier versions
pkill -f "php -S 127.0.0.1:18185" 2>/dev/null
rm -f /usr/local/emhttp/plugins/mediaserver_monitor/repo.php
rm -f /tmp/mediaserver_monitor_setup.sh /tmp/mediaserver_monitor_finish.sh
echo ""
echo "----------------------------------------------------"
echo " Monitor installed: Settings -> Utilities -> Monitor"
echo " It shows the Sysbox, Diskbox, Streambox and Seedbox"
echo " tiles, so install those plugins too."
echo "----------------------------------------------------"
exit 0
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
rm -rf /usr/local/emhttp/plugins/mediaserver_monitor
rm -rf /usr/local/emhttp/plugins/Monitor
pkill -f "php -S 127.0.0.1:18185" 2>/dev/null
echo "Monitor removed."
exit 0
]]></INLINE>
</FILE>

</PLUGIN>
