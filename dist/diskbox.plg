 "bal.also_on": {
  "text": "the folder is also on {d}",
  "note": "grey line under a media-only folder: the same folder exists on another disk."
 },
 "bal.no_other": {
  "text": "on no other disk",
  "note": "grey line under a media-only folder."
 },
 "bal.vid_nodl": {
  "text": "video without a download",
  "note": "amber chip: a video file whose download (and torrent) is gone."
 },
 "bal.more": {
  "text": "Show {m} more ({n} left)",
  "note": "button under a long list: shows the next rows."
 },
 "bal.lib_tip": {
  "text": "Files in the media folders of this disk that have no hardlink (a hardlink cannot cross disks, so they have none anywhere). Mostly pictures and .nfo that Radarr, Sonarr or Jellyfin wrote next to a film whose video and download are on another disk. A video file here has lost its download: nothing seeds it.",
  "note": "tooltip of the \"Library files without a hardlink\" bar."
 },
 "bal.lib_bar": {
  "text": "Library files without a hardlink",
  "note": "title of a foldable bar under a disk in the plan."
 },
 "bal.n_folders": {
  "one": "{n} folder",
  "other": "{n} folders",
  "note": "count of folders."
 },
 "bal.n_also": {
  "text": "{n} also on another disk",
  "note": "count: folders that exist on another disk too."
 },
 "bal.n_only": {
  "text": "{n} only here",
  "note": "count: folders only on this disk."
 },
 "bal.n_vid": {
  "one": "{n} video file without a download",
  "other": "{n} video files without a download",
  "note": "amber count in the bar."
 },
 "bal.nothing": {
  "text": "Nothing to move: the disks are balanced or no title can be moved.",
  "note": "message in the plan when there is nothing to move."
 },
 "bal.stays": {
  "text": "Stays on the disk to empty (outside the folders above, or left out; move or delete it yourself)",
  "note": "title of the bar that lists what would stay on a disk to empty."
 },
 "bal.nothing_stays": {
  "text": "Nothing else stays on the disk to empty once the ticked titles are moved",
  "note": "the same bar when nothing would stay."
 },
 "bal.scanning": {
  "text": "Scanning...",
  "note": "message next to Make a plan while the scan runs."
 },
 "bal.saving": {
  "text": "Saving...",
  "note": "message next to Make a plan while the setup is saved."
 },
 "bal.scanning_long": {
  "text": "Scanning the disks, this can take a minute...",
  "note": "message next to Make a plan when the scan starts."
 },
 "bal.confirm": {
  "one": "Move {n} title, {s}, between disks?\n\nThe files are copied, checked and only then removed from the old disk. This can take hours. Pause or stop the torrents of these titles first if you can.",
  "other": "Move {n} titles, {s}, between disks?\n\nThe files are copied, checked and only then removed from the old disk. This can take hours. Pause or stop the torrents of these titles first if you can.",
  "note": "confirmation box before the move. Keep the two line breaks (\\n\\n)."
 },
 "run.moving": {
  "text": "Moving",
  "note": "state of the move in Activity (bold)."
 },
 "run.finished": {
  "text": "Finished",
  "note": "state of the move after it ended."
 },
 "run.stopped": {
  "text": "Stopped",
  "note": "state of the move after it was stopped."
 },
 "run.error": {
  "text": "Stopped with an error",
  "note": "state of the move after an error."
 },
 "run.line": {
  "text": "{ok} / {n} titles · {done} of {total} ({p}%)",
  "note": "progress line of the move in Activity."
 },
 "run.aband": {
  "text": "moving now · {p}%",
  "note": "grey text on the right of the Activity band during a move."
 },
 "run.of_titles": {
  "one": "{ok} of {n} title",
  "other": "{ok} of {n} titles",
  "note": "after the state on the Activity band when the move ended."
 },
 "it.wait": {
  "text": "waiting",
  "note": "state of a title in the move list: not started yet. Short."
 },
 "it.run": {
  "text": "moving",
  "note": "state of a title in the move list: being copied now. Short."
 },
 "it.ok": {
  "text": "done",
  "note": "state of a title in the move list: moved. Short."
 },
 "it.skip": {
  "text": "skipped",
  "note": "state of a title in the move list: left out (the reason follows). Short."
 },
 "it.fail": {
  "text": "FAILED",
  "note": "state of a title in the move list: failed, in capitals on purpose (the reason follows). Short."
 },
 "run.more_waiting": {
  "text": "{n} more waiting",
  "note": "foldable bar of the titles still waiting."
 },
 "run.not_moved": {
  "text": "{n} not moved",
  "note": "foldable bar of the titles that were not moved (after a stop)."
 },
 "run.n_skipped": {
  "text": "{n} skipped",
  "note": "foldable bar of the skipped titles."
 },
 "run.n_done": {
  "text": "{n} done",
  "note": "foldable bar of the moved titles."
 },
 "run.lines": {
  "one": "{n} line",
  "other": "{n} lines",
  "note": "count on the right of the log bar."
 },
 "hist.title": {
  "text": "Recent moves",
  "note": "foldable bar in Activity with the log of earlier moves."
 },
 "hist.runs": {
  "one": "{n} run",
  "other": "{n} runs",
  "note": "count of earlier moves."
 },
 "hist.stopped": {
  "text": "{n} stopped",
  "note": "count of earlier moves that were stopped."
 },
 "hist.last": {
  "text": "last on {d}",
  "note": "date of the last move ({d} like 2026-10-14)."
 },
 "hist.none": {
  "text": "Nothing moved yet.",
  "note": "text in Activity before the first move."
 },
 "hist.idle": {
  "text": "nothing running",
  "note": "grey text on the right of the Activity band."
 },
 "hist.idle_last": {
  "text": "nothing running · last move on {d}",
  "note": "grey text on the right of the Activity band."
 },
 "why.not_started": {
  "text": "the array is not started",
  "note": "reason a plan or a move cannot start (after \"Cannot start:\" or \"Moving waits:\")."
 },
 "why.resync": {
  "text": "a parity check or rebuild is running",
  "note": "reason a move or the clearing cannot start now."
 },
 "why.mover": {
  "text": "the mover is running",
  "note": "reason a move cannot start now (Unraid's Mover)."
 },
 "skip.shares": {
  "text": "shares files with another title",
  "note": "why a title is left out of the plan (grey line under it)."
 },
 "skip.outside": {
  "text": "has hardlinks outside the configured folders",
  "note": "why a title is left out of the plan."
 },
 "skip.partial": {
  "text": "looks unfinished (partial download)",
  "note": "why a title is left out of the plan."
 },
 "skip.recent": {
  "text": "changed in the last 2 hours",
  "note": "why a title is left out of the plan."
 },
 "plan.two_disks": {
  "text": "At least two array data disks must be included.",
  "note": "error next to Make a plan."
 },
 "plan.no_pair": {
  "text": "No valid folder pair is configured.",
  "note": "error next to Make a plan."
 },
 "plan.target_raised": {
  "text": "The array as a whole is {avg}% full, so {req}% is not reachable; balancing to {avg}% instead.",
  "note": "amber note above the plan when the target fill is below the array average."
 },
 "plan.balanced": {
  "text": "The disks are already balanced.",
  "note": "note above the plan when there is nothing to move."
 },
 "plan.tick_drain": {
  "text": "Tick at least one disk to empty.",
  "note": "error next to Make a plan."
 },
 "plan.one_stays": {
  "text": "At least one included disk must stay to receive the data.",
  "note": "error next to Make a plan."
 },
 "run.died": {
  "text": "The worker stopped unexpectedly.",
  "note": "red text in Activity when the background move died."
 },
 "err.bad_line": {
  "text": "Invalid folder line: {line} (use paths relative to the disk root, for example data/downloads/FILM = data/media/film)",
  "note": "error next to Make a plan. Keep the example path as it is."
 },
 "err.no_folder": {
  "text": "Enter at least one downloads folder.",
  "note": "error on the Balance page."
 },
 "err.target": {
  "text": "The target fill must be between 5 and 95 percent.",
  "note": "error on the Balance page."
 },
 "err.write": {
  "text": "could not write the settings",
  "note": "error on the Balance page."
 },
 "err.running": {
  "text": "A move is running.",
  "note": "error on the Balance page."
 },
 "err.already": {
  "text": "A move is already running.",
  "note": "error on the Balance page."
 },
 "err.no_plan": {
  "text": "Make a plan first.",
  "note": "error on the Balance page."
 },
 "err.nothing": {
  "text": "Nothing is selected.",
  "note": "error on the Balance page."
 },
 "err.bad_sel": {
  "text": "Invalid selection.",
  "note": "error on the Balance page."
 },
 "err.tick_remove": {
  "text": "Tick the disk(s) to remove.",
  "note": "error on the Balance page."
 },
 "err.tick_drain": {
  "text": "Tick the disk(s) to empty.",
  "note": "error on the Balance page."
 },
 "err.cannot_plan": {
  "text": "Cannot plan now: {why}.",
  "note": "error next to Make a plan ({why} a reason like \"the array is not started\")."
 },
 "err.cannot_start": {
  "text": "Cannot start: {why}.",
  "note": "error next to Move ({why} a reason)."
 },
 "why.disk_not_ok": {
  "text": "{d} is not OK ({s})",
  "note": "reason the clearing cannot start ({s} is Unraid's disk status code)."
 },
 "why.no_parity": {
  "text": "there is no parity disk",
  "note": "reason the clearing cannot start."
 },
 "rm.err.choose": {
  "text": "Choose Remove disks in the Setup and tick the disks first.",
  "note": "error on the Balance page, Remove disks."
 },
 "rm.err.move_check": {
  "text": "A move is running; check when it has finished.",
  "note": "error on the Balance page, Remove disks."
 },
 "rm.err.step2": {
  "text": "Step 2 first: a share can still write to the disks.",
  "note": "error on the Balance page, Remove disks."
 },
 "rm.err.step4": {
  "text": "Step 4 first: check that the disks are empty.",
  "note": "error on the Balance page, Remove disks."
 },
 "rm.err.clearing": {
  "text": "A clearing is running.",
  "note": "error on the Balance page, Remove disks."
 },
 "rm.err.cannot": {
  "text": "Cannot clear: {why}.",
  "note": "error of step 5 ({why} a reason)."
 },
 "rm.err.nodev": {
  "text": "The parity-protected device of {d} was not found.",
  "note": "error of step 5 (technical: the /dev/md device)."
 },
 "rm.err.clearing_d": {
  "text": "{d} is being cleared already.",
  "note": "error of step 5."
 },
 "rm.err.cleared": {
  "text": "{d} is cleared already; it does not need a second clearing.",
  "note": "error of step 5 when the disk was fully zeroed before."
 },
 "rm.err.starting": {
  "text": "The clearing of {d} is starting (unmount, stand-in image); wait until the log shows it running or failed.",
  "note": "error of step 5 after a second click right after the start."
 },
 "rm.err.not_empty_now": {
  "text": "{d} is not empty any more ({n} files). See step 4.",
  "note": "error of step 5; {n} number of files."
 },
 "rm.err.not_mounted": {
  "text": "{d} is not mounted.",
  "note": "error of step 5."
 },
 "rm.err.type": {
  "text": "Type exactly: {w}",
  "note": "error of step 5; {w} the disk names to type."
 },
 "run.nothing": {
  "text": "Nothing to move.",
  "note": "red text in Activity when a started move has no title."
 },
 "run.gone": {
  "text": "a file is gone from the source",
  "note": "why a title was skipped during the move (after \"skipped:\")."
 },
 "run.exists": {
  "text": "a file already exists on the target",
  "note": "why a title was skipped during the move (after \"skipped:\")."
 },
 "run.changed": {
  "text": "a file changed in the last 2 hours",
  "note": "why a title was skipped during the move (after \"skipped:\")."
 },
 "run.links": {
  "text": "the hardlinks changed since the scan",
  "note": "why a title was skipped during the move (after \"skipped:\")."
 },
 "run.space": {
  "text": "not enough free space on {d}",
  "note": "why a title was skipped during the move."
 },
 "run.verify": {
  "text": "verification failed: {p}",
  "note": "why a title failed: the copy of a file differs ({p} the file)."
 },
 "run.verify_src": {
  "text": "{p} changed on the source during the copy (a new hardlink or a replaced file); the copy was removed, the source is untouched",
  "note": "Balance error after a copy; {p} a file path."
 },
 "run.rsync_fail": {
  "text": "rsync failed ({n}) {e}",
  "note": "Balance error; {n} exit code, {e} the end of rsync's error output (not translated)."
 },
 "run.verify_link": {
  "text": "verification failed: the hardlink was not kept ({p})",
  "note": "why a title failed."
 },
 "run.verify_count": {
  "text": "verification failed: link count ({p})",
  "note": "why a title failed."
 },
 "run.stopped_copy": {
  "text": "stopped, the copy was removed",
  "note": "state text of the title being copied when the move was stopped."
 },
 "run.rm_fail": {
  "text": "could not remove the source files",
  "note": "why a title failed after the copy."
 },
 "run.rm_fail_t": {
  "text": "could not remove the source files of {t}",
  "note": "red text in Activity: the move stopped ({t} the title)."
 },
 "rm.err.step2_shares": {
  "text": "Step 2 first: {l} can still write to the disks to remove.",
  "note": "error next to Make a plan in the Remove disks mode ({l} share names)."
 },
 "run.fatal_why": {
  "text": "Stopped: {why}.",
  "note": "red text in Activity: the move stopped because Unraid became busy ({why} like \"a parity check or rebuild is running\")."
 },
 "run.stopped_msg": {
  "text": "Stopped.",
  "note": "amber text in Activity after a stop."
 },
 "bal.btn.stop_now": {
  "text": "Stop now",
  "note": "button while a move runs: stops at once; the title being copied is rolled back."
 },
 "bal.stopping_after": {
  "text": "Stops after this title...",
  "note": "the Stop after this title button after it was pressed."
 },
 "bal.stop_now_confirm": {
  "text": "Stop now?\n\nThe title being copied is rolled back: its copy is removed from the target disk and the original stays where it is. The copying done on it so far is lost. Stop after this title keeps it instead.",
  "note": "confirmation box of Stop now. Keep the line breaks (\\n\\n)."
 }
}]]></INLINE>
</FILE>

