<style>
/* the Dashboard tile look (common/tile.css, inserted by the build): Activity on top, a dark band per part, striped rows, foldable bars */
/* Shared tile look (the Sysbox / Diskbox style): dark section bands, the content in a box under them, colored left stripes on rows.
   Used by Seedbox and Streambox; the build copies this block into each plugin's page where the marker below stands. */
.mt-band{display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(0,0,0,.25);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:7px 10px;margin-top:14px}
.mt-band.mt-first{margin-top:6px}
.mt-band span{opacity:.75}
.mt-band b{font-weight:400;opacity:.5;text-transform:none;letter-spacing:0;text-align:right}
.mt-band.mt-red span{color:#e5534b;opacity:1}
.mt-box{background:rgba(128,128,128,.12);margin-top:8px}
.mt-cols{display:grid;gap:8px;align-items:center;padding:6px 10px 4px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid rgba(128,128,128,.2)}
.mt-cols>div{opacity:.6}
.mt-r{display:grid;gap:8px;align-items:center;padding:8px 10px;border-top:1px solid rgba(128,128,128,.2)}
.mt-box>.mt-r:first-child,.mt-cols+.mt-r{border-top:0}
.mt-s-orange{background:rgba(245,165,36,.10);box-shadow:inset 3px 0 0 #f5a524}
.mt-s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
.mt-s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
.mt-s-red{background:rgba(229,83,75,.14);box-shadow:inset 3px 0 0 #e5534b}
.mt-s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
.mt-s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
.mt-s-grey{background:rgba(128,128,128,.08);box-shadow:inset 3px 0 0 #8a8a8a}
.mt-box .mt-n{background:none}
.mt-note{padding:8px 10px;text-align:center;font-style:italic;opacity:.6}
#dbb{--dbb-line:rgba(128,128,128,.22);--dbb-box:rgba(128,128,128,.12)}
#dbb .dbb-r{text-align:right!important;white-space:nowrap}
#dbb .dbb-mut{opacity:.6}
#dbb .dbb-ok{color:#3fa24a}#dbb .dbb-er{color:#e5534b}#dbb .dbb-am{color:#d9921f}
#dbb .dbb-sub{opacity:.65;margin:4px 0 0;max-width:120ch}
#dbb .mt-band{margin-top:26px;padding:9px 12px}
#dbb .mt-band span{font-weight:600}
#dbb .mt-box{margin-top:8px}
#dbb .dbb-status{display:flex;flex-wrap:wrap;gap:6px 18px;align-items:center;padding:9px 12px;border-top:1px solid var(--dbb-line)}
#dbb .mt-box>.dbb-status:first-child{border-top:0}
#dbb .dbb-prog{flex:1 1 220px;height:8px;background:rgba(128,128,128,.25);position:relative;min-width:120px}
#dbb .dbb-prog i{position:absolute;left:0;top:0;bottom:0;background:#4a90e2}
#dbb .dbb-foot{opacity:.55;font-size:12px;margin:8px 2px 0;max-width:130ch}
/* rows */
#dbb .dbb-row{display:grid;gap:10px;align-items:center;padding:9px 12px;border-top:1px solid var(--dbb-line)}
#dbb .dbb-row small{display:block;opacity:.6}
#dbb .s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
#dbb .s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
#dbb .s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
#dbb .s-red{background:rgba(229,83,75,.13);box-shadow:inset 3px 0 0 #e5534b}
#dbb .s-grey{background:rgba(128,128,128,.07);box-shadow:inset 3px 0 0 #8a8a8a}
#dbb .dbb-run{grid-template-columns:minmax(0,1fr) 90px 150px minmax(120px,30%)}
/* disks: fill now (blue) and after the ticked moves (green, amber when it grows, red when nearly full) */
#dbb .dbb-disk{grid-template-columns:110px 70px minmax(0,1fr) 140px}
#dbb .dbb-disk b{font-weight:600}
#dbb .dbb-bars{display:grid;gap:4px}
#dbb .dbb-bar{position:relative;height:9px;background:rgba(128,128,128,.25)}
#dbb .dbb-bar i{position:absolute;left:0;top:0;bottom:0;background:#4a90e2}
#dbb .dbb-bar i.dbb-res{background:repeating-linear-gradient(45deg,rgba(160,160,160,.55) 0 3px,rgba(160,160,160,.2) 3px 6px)}
#dbb .dbb-bar b{position:absolute;top:-2px;bottom:-2px;width:2px;background:#d9921f}
