  "note": "row of step 6 when the disks are no longer in the array."
 },
 "rm.btn.finish": {
  "text": "Finish",
  "note": "button: ends the Remove disks job. Short."
 },
 "rm.nc1": {
  "text": "Main &rarr; <b>Stop</b> the array.",
  "note": "step 6, first instruction. Main and Stop are Unraid's words: use Unraid's own translation. May contain simple HTML tags: keep them."
 },
 "rm.nc2": {
  "text": "Tools &rarr; <b>New Config</b> &rarr; Preserve current assignments: <b>All</b> &rarr; Apply.",
  "note": "step 6, second instruction (Unraid's menu words). May contain simple HTML tags: keep them."
 },
 "rm.nc3": {
