  "note": "text next to the warning utilization field."
 },
 "set.crit_hint": {
  "text": "red; empty = Unraid's value ({v}%)",
  "note": "text next to the critical utilization field."
 },
 "set.hot_hint": {
  "text": "hard disks, amber; empty = Unraid's value ({v}°C)",
  "note": "text next to the hot temperature field."
 },
 "set.max_hint": {
  "text": "hard disks, red; empty = Unraid's value ({v}°C)",
  "note": "text next to the maximum temperature field."
 },
 "set.acked_at": {
  "text": "acknowledged {t}",
  "note": "an acknowledged SMART warning: when ({t} is a date and time)."
 },
 "set.acked_attr": {
  "text": "(attribute {a})",
  "note": "after the date: which SMART attribute and its raw value, like \"(attribute 187: 2)\"."
 },
 "set.btn.forget": {
  "text": "Forget",
  "note": "button: forgets the acknowledgement, so the warning counts again. Short."
 },
 "set.saved_keep": {
  "text": "(saved, leave empty to keep)",
  "note": "grey text inside the empty webhook field: a webhook is saved; leaving the field empty keeps it."
 },
 "set.hook_hint": {
  "text": "the saved webhook is not sent to the page; type - to remove it",
  "note": "grey text next to the webhook field: the saved webhook is never shown; typing a single - removes it."
 },
 "set.ping_ph": {
  "text": "your Discord user ID, role:ID, @here or @everyone",
  "note": "grey example text inside the ping field. Keep role:ID, @here and @everyone as they are."
 },
 "set.ping_hint": {
  "text": "empty = no ping. Amber alerts and all-clear messages never ping",
  "note": "text next to the ping field."
 },
 "set.utest_hint": {
  "text": "one message when a test that was running is over",
  "note": "text next to the checkbox."
 },
 "set.never_hint": {
  "text": "0 = never",
  "note": "text next to the repeat hours field."
 },
 "date.long.mon": {
  "text": "Monday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.tue": {
  "text": "Tuesday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.wed": {
  "text": "Wednesday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.thu": {
  "text": "Thursday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.fri": {
  "text": "Friday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.sat": {
  "text": "Saturday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.sun": {
  "text": "Sunday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "set.oclock": {
  "text": "o'clock",
  "note": "after the hour field of the weekly summary (0 to 23)."
 },
 "set.btn.test": {
  "text": "Send test message",
  "note": "button: sends a short test message to the webhook."
 },
 "set.btn.sample": {
  "text": "Send sample alerts",
  "note": "button: sends examples of the alert messages."
 },
 "set.btn.weekly": {
  "text": "Send weekly summary now",
  "note": "button: sends the weekly summary now."
 },
 "set.btn.apply": {
  "text": "Apply",
  "note": "button: saves the settings (Unraid's usual word). Short."
 },
 "set.btn.done": {
  "text": "Done",
  "note": "button: leaves the settings page (Unraid's usual word). Short."
 },
 "set.help_tile": {
  "text": "Diskbox replaces the Disk Viewer tile. The array is shown as one card with a parity row underneath: green when the array is protected, amber while a parity check or rebuild runs, red when there is no protection, a data disk is emulated, or a disk has failed. The Needs attention list collects disks that are too full, too hot, show SMART warnings or are in a bad state.",
  "note": "grey paragraph at the bottom of the settings page. \"Disk Viewer\" is the name of Unraid's own tile; \"Needs attention\" names the list on the tile."
 },
 "set.help_smart": {
  "text": "Temperature limits for SSDs and NVMe devices are taken from Unraid's own display settings (Settings, Display Settings). SMART data is collected every 20 minutes with <code>smartctl</code>; disks that are spun down are skipped, so Diskbox never wakes a sleeping disk. Utilization and temperature colours use the values above, or Unraid's own when a field is empty.",
  "note": "grey paragraph at the bottom of the settings page. Settings, Display Settings is Unraid's menu: use Unraid's own words. May contain simple HTML tags: keep them."
 },
 "set.help_discord": {
  "text": "Discord alerts: Unraid checks every minute and posts to the webhook only when something changes: a problem appears, gets worse, or is over. A temperature alert needs three minutes in a row and an all-clear only after the disk has cooled two degrees; red alerts can repeat after the chosen number of hours. A SMART warning can be acknowledged with the button next to it on the dashboard tile; it then counts again only when it gets worse (the attribute's raw value rises). A failed health check cannot be acknowledged. SMART alerts name each attribute, say whether it is Pre-fail or Old age, and show its raw value, its previous value, and the value, worst and threshold. The buttons use the saved settings, so press Apply first. Create a webhook in Discord under channel settings, Integrations, Webhooks.",
  "note": "grey paragraph at the bottom of the settings page. Pre-fail and Old age are SMART terms: keep them as smartctl shows them."
 },
 "set.sending": {
  "text": "Sending...",
  "note": "message next to the test buttons while sending."
 },
 "set.sent": {
  "text": "Sent.",
  "note": "message next to the test buttons after sending."
 },
 "set.not_sent": {
  "text": "Not sent: {e}",
  "note": "message when sending failed; {e} is the reason."
 },
 "set.unknown_error": {
  "text": "unknown error",
  "note": "reason when none is known."
 },
 "set.forgotten": {
  "text": "forgotten: a warning on this disk counts again",
  "note": "text after pressing Forget."
 },
 "set.saving_s": {
  "text": "Saving...",
  "note": "message next to Apply while saving."
 },
 "set.saved": {
  "text": "Saved. The dashboard picks it up within a few seconds.",
  "note": "message next to Apply after saving."
 },
 "set.not_saved": {
  "text": "Not saved: {e}",
  "note": "message next to Apply when saving failed; {e} is the reason."
 },
 "save.err_range": {
  "text": "{name} must be between {min} and {max}",
  "note": "error after \"Not saved:\" ({name} is the setting's field name, like warn_use)."
 },
 "save.err_number": {
  "text": "{name} must be a number between {min} and {max}",
  "note": "error after \"Not saved:\"."
 },
 "save.err_hook": {
  "text": "the webhook is not a valid Discord webhook URL",
  "note": "error after \"Not saved:\" when the settings page is saved."
 },
 "save.err_ping": {
  "text": "the ping must be a Discord user ID, role:<role ID>, @here or @everyone",
  "note": "error after \"Not saved:\" when the settings page is saved."
 },
 "save.err_fill": {
  "text": "the fill warning cannot be higher than the critical value",
  "note": "error after \"Not saved:\" when the settings page is saved."
 },
 "save.err_write": {
  "text": "could not write the settings file",
  "note": "error after \"Not saved:\" when the settings page is saved."
 },
 "test.no_hook": {
  "text": "No valid Discord webhook is saved yet. Enter it, press Apply, then try again.",
  "note": "error after \"Not sent:\" of the test buttons."
 },
 "test.no_data": {
  "text": "No disk data available right now.",
  "note": "error after \"Not sent:\" of Send sample alerts."
 },
 "bal.intro": {
  "text": "Whole titles (a downloads folder together with its hardlinked media files) are moved between the array disks, and the hardlinks are kept. Nothing moves until you press Move. The paths in <code>/mnt/user</code> do not change, so qBittorrent, Sonarr, Radarr and Jellyfin keep working.",
  "note": "lead line at the top of the Diskbox Balance page. A \"title\" is one movie or season: its download folder and the hardlinked files in the media library. May contain simple HTML tags: keep them."
 },
 "bal.h.activity": {
  "text": "Activity",
  "note": "band title (upper case on screen)."
 },
 "bal.btn.stop": {
  "text": "Stop after this title",
  "note": "button while a move runs: the title being copied is finished (copied, checked, removed from the old disk), then the move stops."
 },
 "bal.log_run": {
  "text": "Log of this run",
  "note": "foldable bar with the technical log of the current move."
 },
 "bal.h.setup": {
  "text": "Setup",
  "note": "band title (upper case on screen)."
 },
 "bal.f.pairs": {
  "text": "Folders on the disk (one pair per line):",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "bal.f.mode": {
  "text": "What to do:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "bal.f.target": {
  "text": "Target fill (%):",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "bal.f.strategy": {
  "text": "Which titles first:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "bal.f.disks": {
  "text": "Disks included:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "bal.f.drain": {
  "text": "Disks to empty:",
  "note": "label of the disk choice in the Empty disks mode."
 },
 "bal.f.remove": {
  "text": "Disks to remove:",
  "note": "label of the disk choice in the Remove disks mode."
 },
 "bal.f.pairs_hint": {
  "text": "downloads folder = media folder with the hardlinks, relative to the disk root (for example the share <code>data</code>, folder <code>downloads/FILM</code>). Every folder directly inside the downloads folder is one title. The media part can be left out.",
  "note": "hint under the folder pairs field. Keep \"downloads folder = media folder\" as the format of a line. May contain simple HTML tags: keep them."
 },
 "bal.mode.balance": {
  "text": "Spread the data evenly",
  "note": "choice of What to do."
 },
 "bal.mode.drain": {
  "text": "Empty disks (move everything off them)",
  "note": "choice of What to do."
 },
 "bal.mode.remove": {
  "text": "Remove disks (empty, check, clear, take out)",
  "note": "choice of What to do."
 },
 "bal.f.target_ph": {
  "text": "average",
  "note": "grey text in the empty target fill field."
 },
 "bal.f.target_hint": {
  "text": "empty = equal fill on all included disks (the array average); a target below the average is not reachable and is raised to it",
  "note": "hint next to the target fill field."
 },
 "bal.strat.old": {
  "text": "Oldest first",
  "note": "choice: which titles are moved first."
 },
 "bal.strat.big": {
  "text": "Largest first",
  "note": "choice: which titles are moved first."
 },
 "bal.f.drain_hint": {
  "text": "Everything in the folders above is moved to the other included disks: the titles with their hardlinks, the media files without a download (also .nfo, pictures, subtitles) and the items in the Seedbox trash (.seedbox_trash). The plan lists what would still stay on the disk, so you can see whether it can be removed from the array.",
  "note": "hint under the disks to empty. .seedbox_trash is a folder name: keep it."
 },
 "bal.btn.plan": {
  "text": "Make a plan",
  "note": "main button of the Setup: scans the disks and suggests the moves."
 },
 "rm.h2": {
  "text": "Keep new files off them",
  "note": "band title of step 2 of Remove disks (upper case on screen)."
 },
 "rm.s2": {
  "text": "Change every share listed here in <a href=\"/Shares\">Shares</a>: put the disks in <b>Excluded disk(s)</b> (or take them out of Included disk(s)). Diskbox only checks; it changes no share.",
  "note": "lead line of step 2. Shares, Excluded disk(s) and Included disk(s) are Unraid's words: use Unraid's own translation. Keep the link. May contain simple HTML tags: keep them."
 },
 "rm.btn.check_again": {
  "text": "Check again",
  "note": "button of step 2: looks at the shares again."
 },
 "rm.h3": {
  "text": "Empty them",
  "note": "band title of step 3 (upper case on screen)."
 },
 "rm.s3": {
  "text": "Make a plan in the Setup above: the plan (below) moves everything in the folders of the Setup to the other disks, then press Move. What it does not watch (for example appdata) is listed under the plan; move it yourself.",
  "note": "lead line of step 3."
 },
 "rm.h4": {
  "text": "Check they are empty",
  "note": "band title of step 4 (upper case on screen)."
 },
 "rm.s4": {
  "text": "Lists every file still on the disks, hidden ones too (empty folders do not count). Clearing is possible only when nothing is left.",
  "note": "lead line of step 4."
 },
 "rm.btn.check": {
  "text": "Check the disks",
  "note": "button of step 4."
 },
 "rm.h5": {
  "text": "Clear them",
  "note": "band title of step 5 (upper case on screen)."
 },
 "rm.s5": {
  "text": "Each disk is unmounted and filled with zeros through parity (side by side), so parity stays valid without it: about 7 hours per TB. <b>This erases everything on the disk.</b> If the server stops meanwhile, Unraid shows the disk as Unmountable after the restart: do <b>not</b> format it, start the clearing again here.",
  "note": "lead line of step 5: a strong warning. Unmountable is Unraid's word. May contain simple HTML tags: keep them."
 },
 "rm.h6": {
  "text": "Take them out of the array",
  "note": "band title of step 6 (upper case on screen)."
 },
 "bal.h.plan": {
  "text": "Plan",
  "note": "band title (upper case on screen)."
 },
 "bal.legend": {
  "text": "blue = fill now · green = after the ticked moves (amber: it grows, red: nearly full) · striped grey = the file system's own space on a disk to empty (metadata, not data; it goes with the disk) · the orange mark is the target",
  "note": "small legend under the disk bars of the plan."
 },
 "bal.selall": {
  "text": "Select / deselect all",
  "note": "tooltip of a checkbox that ticks every row."
 },
 "bal.all_titles": {
  "text": "all titles",
  "note": "label next to the tick-all checkbox."
 },
 "bal.tick_hint": {
  "text": "the suggestion is ticked; change the ticks or the target disk as you like",
  "note": "grey hint next to it."
 },
 "bal.skipped_bar": {
  "text": "Titles that are left out",
  "note": "foldable bar of the titles the plan cannot move (the reason is on each row)."
 },
 "bal.btn.go": {
  "text": "Move the selected titles",
  "note": "main button under the plan when nothing or the count is not known yet."
 },
 "bal.foot": {
  "text": "Each title is copied, checked (sizes and hardlinks), and only then removed from the old disk. If a check fails the copy is removed and the old files stay. Moving runs in the background at idle disk priority; it needs the array started and no parity check, rebuild or mover running. Closing this page does not stop it.",
  "note": "grey paragraph at the bottom of the page. \"mover\" is Unraid's Mover."
 },
 "dur.hm": {
  "text": "{h} h {m} m",
  "note": "a duration in hours and minutes. Short."
 },
 "dur.ms": {
  "text": "{m} m {s} s",
  "note": "a duration in minutes and seconds. Short."
 },
 "bal.no_disks": {
  "text": "No array data disks found (is the array started?)",
  "note": "text in the Disks included field when none is found."
 },
 "bal.used": {
