#dbb .dbb-chg small{display:block;opacity:.8}
#dbb .dbb-chip{display:inline-block;font-size:11px;padding:1px 6px;margin-left:6px;background:rgba(128,128,128,.25);font-weight:normal}
#dbb .dbb-chip.am{background:rgba(217,146,31,.25);color:#d9921f}
#dbb .dbb-chip.rd{background:rgba(229,83,75,.25);color:#e5534b}
/* foldable bars (one per source disk, what stays, what is left out, recent moves) */
#dbb .dbb-gbar{display:grid;grid-template-columns:18px 22px minmax(0,1fr) auto;gap:8px;align-items:center;padding:10px 12px;border-top:1px solid var(--dbb-line);cursor:pointer;font-weight:600}
#dbb .mt-box>.dbb-gbar:first-child{border-top:0}
#dbb .dbb-gbar .c{font-weight:normal;font-size:12px;opacity:.7}
#dbb .dbb-gbar input{margin:0}
#dbb .dbb-grp[hidden],#dbb .dbb-mv[hidden]{display:none}
#dbb .dbb-mv{grid-template-columns:22px minmax(0,1fr) 90px 120px;padding-left:34px}
#dbb .dbb-mv input{margin:0}
#dbb .dbb-mv b{font-weight:600;overflow-wrap:anywhere}
#dbb .dbb-left{grid-template-columns:90px minmax(0,1fr) 80px 90px;padding-left:34px}
#dbb select.dbb-dst{min-width:90px;margin:0}
#dbb .dbb-log{max-height:220px;overflow:auto;font-family:monospace;font-size:12px;white-space:pre-wrap;padding:10px 12px;margin:0;opacity:.75}
/* settings: label left, controls on one line (Unraid 7 makes every dd a flex column), explanation under them */
#dbb-form dl{display:grid;grid-template-columns:minmax(200px,280px) minmax(0,1fr);margin:0;padding:0;gap:0;background:var(--dbb-box)}
#dbb-form dl dt,#dbb-form dl dd{float:none;width:auto;margin:0;padding:9px 12px;border-top:1px solid var(--dbb-line);text-align:left;line-height:1.5}
#dbb-form dl dt{opacity:.75;font-weight:normal}
#dbb-form dl dt:first-child,#dbb-form dl dt:first-child+dd{border-top:0}
#dbb-form dl dd{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px 12px}
#dbb-form dl dd>.dbb-hint,#dbb-form dl dd>div{flex:1 1 100%}
#dbb-form dd input,#dbb-form dd select,#dbb-form dd textarea{margin:0;max-width:100%}
#dbb-form dd select{width:auto!important;min-width:110px}
#dbb-form dd input.narrow{width:90px!important}
#dbb-form dd input[type=checkbox]{width:auto!important;margin:0 4px 0 0}
#dbb-form dd label{display:inline-flex;align-items:center}
#dbb-form dd textarea{width:min(560px,100%)!important;font-family:monospace}
#dbb .dbb-hint{opacity:.55;font-size:12px;max-width:120ch}
#dbb input.dbb-ghost{color:inherit!important;opacity:.7;border-color:rgba(128,128,128,.45)!important}
@media (max-width:760px){
  #dbb-form dl{grid-template-columns:1fr}#dbb-form dl dd{border-top:0;padding-top:0}
  #dbb .dbb-disk{grid-template-columns:90px 1fr}#dbb .dbb-disk .dbb-bars,#dbb .dbb-disk .dbb-chg{grid-column:1 / -1;text-align:left}
  #dbb .dbb-mv,#dbb .dbb-run,#dbb .dbb-left{grid-template-columns:22px minmax(0,1fr);padding-left:12px}
}
</style>
<div id="dbb">
<p class="dbb-sub">Whole titles (a downloads folder together with its hardlinked media files) are moved between the array disks, and the hardlinks are kept. Nothing moves until you press Move. The paths in <code>/mnt/user</code> do not change, so qBittorrent, Sonarr, Radarr and Jellyfin keep working.</p>

<div class="mt-band"><span>Activity</span><b id="dbb-aband"></b></div>
<div class="mt-box" id="dbb-act">
<div id="dbb-runbox" style="display:none">
<div class="dbb-status"><span id="dbb-rstat"></span><span class="dbb-prog"><i id="dbb-rbar" style="width:0%"></i></span><input type="button" id="dbb-stop" class="dbb-ghost" value="Stop after the current file set" style="display:none"></div>
<div id="dbb-rtab"></div>
<div class="dbb-gbar s-grey" data-g="rlog"><span class="pm">+</span><span></span><span>Log of this run</span><span class="c"></span></div>
<div class="dbb-grp" data-g="rlog" hidden><div class="dbb-log" id="dbb-rlog"></div></div>
</div>
<div id="dbb-rmact"></div>
<div id="dbb-hist"></div>
</div>

<div class="mt-band"><span>Setup</span><b id="dbb-sband"></b></div>
<form id="dbb-form" onsubmit="return false;" class="mt-box">
<dl>
<dt>Folders on the disk (one pair per line):</dt>
<dd><textarea id="dbb-pairs" rows="2" placeholder="data/downloads/FILM = data/media/film"></textarea>
<span class="dbb-hint">downloads folder = media folder with the hardlinks, relative to the disk root (for example the share <code>data</code>, folder <code>downloads/FILM</code>). Every folder directly inside the downloads folder is one title. The media part can be left out.</span></dd>
<dt>What to do:</dt>
<dd><select id="dbb-mode"><option value="balance">Spread the data evenly</option><option value="drain">Empty disks (move everything off them)</option><option value="remove">Remove disks (empty, check, clear, take out)</option></select></dd>
<dt class="dbb-bal">Target fill (%):</dt>
<dd class="dbb-bal"><input type="number" id="dbb-target" min="5" max="95" class="narrow" placeholder="average"> <span class="dbb-hint">empty = equal fill on all included disks (the array average); a target below the average is not reachable and is raised to it</span></dd>
<dt class="dbb-bal">Which titles first:</dt>
<dd class="dbb-bal"><select id="dbb-strategy"><option value="old">Oldest first</option><option value="big">Largest first</option></select></dd>
<dt>Disks included:</dt>
<dd id="dbb-disks"></dd>
<dt class="dbb-drn" id="dbb-drnlbl">Disks to empty:</dt>
<dd class="dbb-drn"><span id="dbb-drain"></span><span class="dbb-hint">Everything in the folders above is moved to the other included disks: the titles with their hardlinks, the media files without a download (also .nfo, pictures, subtitles) and the items in the Seedbox trash (.seedbox_trash). The plan lists what would still stay on the disk, so you can see whether it can be removed from the array.</span></dd>
<dt>&nbsp;</dt>
<dd><input type="button" id="dbb-plan" value="Make a plan"> <span id="dbb-pmsg"></span></dd>
</dl>
</form>

<div id="dbb-rm" style="display:none">
<div class="mt-band"><span>2 &middot; Keep new files off them</span><b id="dbb-rb2"></b></div>
<div class="mt-box"><div class="dbb-status"><span style="flex:1 1 400px">Change every share listed here in <a href="/Shares">Shares</a>: put the disks in <b>Excluded disk(s)</b> (or take them out of Included disk(s)). Diskbox only checks; it changes no share.</span> <input type="button" id="dbb-rm2" class="dbb-ghost" value="Check again"></div><div id="dbb-rs2"></div></div>
<div class="mt-band"><span>3 &middot; Empty them</span><b id="dbb-rb3"></b></div>
<div class="mt-box"><div class="dbb-status"><span>Make a plan in the Setup above: the plan (below) moves everything in the folders of the Setup to the other disks, then press Move. What it does not watch (for example appdata) is listed under the plan; move it yourself.</span></div><div id="dbb-rs3"></div></div>
<div class="mt-band"><span>4 &middot; Check they are empty</span><b id="dbb-rb4"></b></div>
<div class="mt-box"><div class="dbb-status"><span style="flex:1 1 400px">Lists every file still on the disks, hidden ones too (empty folders do not count). Clearing is possible only when nothing is left.</span> <input type="button" id="dbb-rm4" value="Check the disks"></div><div id="dbb-rs4"></div></div>
<div class="mt-band"><span>5 &middot; Clear them</span><b id="dbb-rb5"></b></div>
<div class="mt-box"><div class="dbb-status"><span>Each disk is unmounted and filled with zeros through parity (side by side), so parity stays valid without it: about 7 hours per TB. <b>This erases everything on the disk.</b> If the server stops meanwhile, Unraid shows the disk as Unmountable after the restart: do <b>not</b> format it, start the clearing again here.</span></div><div id="dbb-rs5"></div></div>
<div class="mt-band"><span>6 &middot; Take them out of the array</span><b id="dbb-rb6"></b></div>
<div class="mt-box"><div id="dbb-rs6"></div></div>
</div>

<div id="dbb-planbox" style="display:none">
<div class="mt-band"><span>Plan</span><b id="dbb-pband"></b></div>
<div class="mt-box">
<div id="dbb-note" class="dbb-status dbb-am" style="display:none"></div>
<div id="dbb-dtab"></div>
<div class="dbb-status dbb-mut" style="font-size:12px">blue = fill now &middot; green = after the ticked moves (amber: it grows, red: nearly full) &middot; striped grey = the file system's own space on a disk to empty (metadata, not data; it goes with the disk) &middot; the orange mark is the target</div>
</div>
<div class="mt-box">
<div class="dbb-status"><label><input type="checkbox" id="dbb-all" title="Select / deselect all"> all titles</label><span class="dbb-mut">the suggestion is ticked; change the ticks or the target disk as you like</span></div>
<div id="dbb-units"></div>
<div id="dbb-leftbox" style="display:none"><div class="dbb-gbar s-amber" data-g="left"><span class="pm">+</span><span></span><span id="dbb-lefttg"></span><span class="c" id="dbb-leftc"></span></div><div class="dbb-grp" data-g="left" hidden id="dbb-leftlist"></div></div>
<div id="dbb-skipbox" style="display:none"><div class="dbb-gbar s-grey" data-g="skip"><span class="pm">+</span><span></span><span>Titles that are left out</span><span class="c" id="dbb-skipc"></span></div><div class="dbb-grp" data-g="skip" hidden id="dbb-skiplist"></div></div>
<div class="dbb-status"><input type="button" id="dbb-go" value="Move the selected titles"> <span id="dbb-gomsg"></span></div>
</div>
<p class="dbb-foot">Each title is copied, checked (sizes and hardlinks), and only then removed from the old disk. If a check fails the copy is removed and the old files stay. Moving runs in the background at idle disk priority; it needs the array started and no parity check, rebuild or mover running. Closing this page does not stop it.</p>
</div>
</div>

<script>
$(function () {
  var URL = '/plugins/diskbox/balance.php', P = null, disks = {}, pollT = null, planPoll = null, GOPEN = {}, BUSY = '', busyT = null, LIM = {};
  function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
  function fb(b) { b = +b; if (b >= 1e12) return (b / 1e12).toFixed(2) + ' TB'; if (b >= 1e9) return (b / 1e9).toFixed(b >= 1e11 ? 0 : 1) + ' GB'; if (b >= 1e6) return (b / 1e6).toFixed(0) + ' MB'; return (b / 1e3).toFixed(0) + ' KB'; }
  function dur(s) { s = Math.max(0, Math.round(s)); var h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60); return h ? h + ' h ' + m + ' m' : m + ' m ' + (s % 60) + ' s'; }
  function api(op, data) { return $.post(URL, $.extend({op: op}, data || {}), null, 'json'); }
  function err(x) { return (x && x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : (x && x.error) ? x.error : 'HTTP ' + (x && x.status); }
  function up(s) { return esc(String(s).toUpperCase()); }

  // foldable bars: closed when the page loads, GOPEN keeps what you opened while the page is open
  function gbarSet(g) { var o = !!GOPEN[g]; $('#dbb .dbb-gbar[data-g="' + g + '"] .pm').html(o ? '&minus;' : '+'); $('#dbb .dbb-grp[data-g="' + g + '"]').prop('hidden', !o); }
  $(document).on('click', '#dbb .dbb-gbar', function (e) { if ($(e.target).is('input,select,label')) { return; } var g = String($(this).data('g')); GOPEN[g] = !GOPEN[g]; gbarSet(g); });

  function drawCfg(r) {
    var c = r.cfg, lines = [];
    $.each(c.pairs, function (i, p) { lines.push(p.dl + (p.media ? ' = ' + p.media : '')); });
    $('#dbb-pairs').val(lines.join('\n'));
    $('#dbb-target').val(c.target); $('#dbb-strategy').val(c.strategy);
    var h = '';
    $.each(r.disks, function (i, d) {
      var on = !c.disks.length || c.disks.indexOf(d.name) >= 0;
      h += '<label><input type="checkbox" class="dbb-dsel" value="' + esc(d.name) + '"' + (on ? ' checked' : '') + '> ' + esc(d.label) + ' <span class="dbb-chip">' + d.pct.toFixed(0) + '%</span></label>';
    });
    $('#dbb-disks').html(h || '<span class="dbb-mut">No array data disks found (is the array started?)</span>');
    h = '';
    $.each(r.disks, function (i, d) {
      h += '<label><input type="checkbox" class="dbb-drsel" value="' + esc(d.name) + '"' + ((c.drain || []).indexOf(d.name) >= 0 ? ' checked' : '') + '> ' + esc(d.label) + ' <span class="dbb-chip">' + fb(d.used) + ' used</span></label>';
    });
    $('#dbb-drain').html(h);
    $('#dbb-mode').val(c.mode === 'drain' || c.mode === 'remove' ? c.mode : 'balance'); SAVEDMODE = $('#dbb-mode').val();
    $('#dbb-sband').text(r.disks.length + ' array disk' + (r.disks.length === 1 ? '' : 's'));
    modeUi();
  }
  function modeUi() {
    var m = $('#dbb-mode').val(), dr = m !== 'balance';
    $('.dbb-bal').toggle(!dr); $('.dbb-drn').toggle(dr);
    $('#dbb-drnlbl').text(m === 'remove' ? 'Disks to remove:' : 'Disks to empty:');
    $('#dbb-rm').toggle(m === 'remove' && SAVEDMODE === 'remove');
    if (m === 'remove') { rmLoad(); }
  }
  $('#dbb-mode').on('change', modeUi);
  // Remove disks: the choice in the Setup is saved at once (the steps below check the saved choice)
  var SAVEDMODE = '', RMT = null, RM = null;
  $(document).on('change', '#dbb-mode, .dbb-drsel, .dbb-dsel', function () {
    if ($('#dbb-mode').val() !== 'remove') { return; }
    api('saveconfig', cfgData()).done(function () { SAVEDMODE = 'remove'; modeUi(); }).fail(function (x) { $('#dbb-pmsg').css('color', '#e5534b').text(err(x)); });
  });
  function rmLoad() { clearTimeout(RMT); api('rm_state').done(function (r) { RM = r.rm; rmDraw(RM); }); }
  function rowH(cls, main, sub, right) { return '<div class="dbb-row s-' + cls + '" style="grid-template-columns:minmax(0,1fr) auto"><span><b>' + main + '</b>' + (sub ? '<small>' + sub + '</small>' : '') + '</span><span class="dbb-r">' + (right || '') + '</span></div>'; }
  function when(t) { var d = new Date(t * 1000); return d.toLocaleString(undefined, {month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'}); }
  function rmDraw(m) {
    var sel = m.sel || [], names = $.map(sel, function (d) { return d.toUpperCase(); }).join(', ');
    $('#dbb-rm').toggle(!!sel.length && $('#dbb-mode').val() === 'remove');
    if (!sel.length) { $('#dbb-rmact').empty(); return; }
    var st = m.step, h, act = '', running = false;
    // 2 shares
    h = m.shares.length ? $.map(m.shares, function (x) { return rowH('amber', esc(x[0]), 'can still write new files to ' + esc(x[1].join(', ').toUpperCase()), '<a href="/Shares/Share?name=' + encodeURIComponent(x[0]) + '">change it</a>'); }).join('')
      : rowH('green', 'No share writes to ' + esc(names), 'every share excludes them or uses only a pool', '<span class="dbb-ok">done</span>');
    $('#dbb-rs2').html(h); $('#dbb-rb2').text(m.shares.length ? m.shares.length + ' share' + (m.shares.length === 1 ? '' : 's') + ' to change' : 'done');
    // 3 empty
    h = '';
    $.each(sel, function (i, d) { var x = m.disks[d]; h += rowH(st > 3 ? 'green' : (st < 3 ? 'grey' : 'blue'), d.toUpperCase(), x.used == null ? 'not mounted' : fb(x.used) + ' used (with the file system\'s own space)', st > 3 ? '<span class="dbb-ok">emptied</span>' : ''); });
    $('#dbb-rs3').html(h); $('#dbb-rb3').text(st < 3 ? 'after step 2' : (st > 3 ? 'done' : (m.balance ? 'moving' : 'to do')));
    // 4 check
    h = ''; var c = m.check;
    if (c) {
      $.each(sel, function (i, d) {
        var x = c.res[d]; if (!x) { return; }
        h += x.n === 0 ? rowH('green', d.toUpperCase() + ': empty', '0 files', '<span class="dbb-ok">empty</span>')
          : rowH('amber', d.toUpperCase() + ': ' + (x.n < 0 ? 'could not be read' : x.n + ' file' + (x.n === 1 ? '' : 's') + ' left, ' + fb(x.bytes)), $.map(x.sample, esc).join('<br>') + (x.n > x.sample.length ? '<br>...' : ''), '<span class="dbb-am">not empty</span>');
      });
      h += '<div class="dbb-status dbb-mut" style="font-size:12px">checked ' + when(c.t) + '</div>';
    }
    $('#dbb-rs4').html(h); $('#dbb-rm4').prop('disabled', st < 3 || m.balance || st > 4); $('#dbb-rb4').text(st < 3 ? 'after step 2' : (c ? (c.ok ? 'empty' : 'not empty') : 'to do'));
    // 5 clear
    h = '';
    $.each(sel, function (i, d) {
      var x = m.disks[d], z = x.zero;
      if (z && z.run) {
        running = true; var pc = z.size > 0 ? z.pos / z.size * 100 : 0, left = z.rate > 0 ? (z.size - z.pos) / z.rate : 0;
        var line = pc.toFixed(1) + ' %' + (z.rate > 0 ? ' &middot; ' + fb(z.rate) + '/s &middot; ' + dur(left) + ' left' : '');
        h += rowH('blue', d.toUpperCase(), 'writing zeros through parity &middot; ' + line, '<span>clearing</span>');
        act += rowH('blue', 'Clearing ' + d.toUpperCase(), 'writing zeros through parity &middot; ' + line, '') + '<div class="dbb-status"><span class="dbb-prog"><i style="width:' + pc.toFixed(1) + '%"></i></span></div>';
      } else if (z && z.done) {
        h += rowH('green', d.toUpperCase() + ' zeroed', 'checked: the end of the disk reads zero', '<span class="dbb-ok">ready to remove</span>');
      } else if (z) {
        h += rowH('red', d.toUpperCase() + ': clearing stopped at ' + (z.size > 0 ? (z.pos / z.size * 100).toFixed(1) : 0) + ' %', 'see the log; start it again when the reason is fixed', '');
      } else if (m.clear) {
        h += rowH('amber', d.toUpperCase() + ': the clearing did not start', 'see the log', '');
      }
    });
    if (st === 5 && !running && !m.cleared) {
      h += '<div class="dbb-status"><span>Type <b>' + esc(sel.join(' ')) + '</b> to confirm:</span> <input type="text" id="dbb-rmtype" autocomplete="off" style="width:200px;margin:0"> <input type="button" id="dbb-rm5" value="Clear ' + esc(names) + '" disabled>' + (m.parity || m.busy ? ' <span class="dbb-am">' + esc(m.parity || m.busy) + '</span>' : '') + '</div>';
    }
    if (m.clear) { h += '<div class="dbb-gbar s-grey" data-g="rmlog"><span class="pm">' + (GOPEN.rmlog ? '&minus;' : '+') + '</span><span></span><span>Log of the clearing</span><span class="c"></span></div><div class="dbb-grp" data-g="rmlog"' + (GOPEN.rmlog ? '' : ' hidden') + '><div class="dbb-log" id="dbb-rmlog"></div></div>'; }
    $('#dbb-rs5').html(h); $('#dbb-rb5').text(st < 5 ? 'after step 4' : (running ? 'running' : (m.cleared ? 'done' : 'to do')));
    if (m.clear && GOPEN.rmlog) { api('rm_log').done(function (r) { $('#dbb-rmlog').text($.map(sel, function (d) { return '== ' + d + '\n' + (r.log[d] || '(empty)'); }).join('\n')); }); }
    // 6 New Config (the owner does it in Unraid)
    var ids = $.map(sel, function (d) { return d.toUpperCase() + (m.disks[d].id ? ' (' + esc(m.disks[d].id) + ')' : ''); }).join(', ');
    h = m.gone ? rowH('green', esc(names) + ' are out of the array', '', '<input type="button" id="dbb-rmend" class="dbb-ghost" value="Finish">')
      : '<ol style="margin:0;padding:10px 12px 10px 32px;line-height:1.7"><li>Main &rarr; <b>Stop</b> the array.</li><li>Tools &rarr; <b>New Config</b> &rarr; Preserve current assignments: <b>All</b> &rarr; Apply.</li><li>Main &rarr; set ' + esc(names) + ' to <b>no device</b>; leave the other slots as they are.</li><li>Tick <b>Parity is already valid</b> &rarr; <b>Start</b>.</li><li>Shut down and take out: ' + ids + '.</li></ol>' + rowH(st === 6 ? 'green' : 'grey', st === 6 ? 'Ready: your turn' : 'after step 5', '', '');
    $('#dbb-rs6').html(h); $('#dbb-rb6').text(m.gone ? 'done' : (st === 6 ? 'your turn' : 'after step 5'));
    $('#dbb-rmact').html(act);
    if (running) { $('#dbb-aband').text('clearing ' + names); }
    if (running || m.balance) { RMT = setTimeout(rmLoad, 15000); }
  }
  $(document).on('input', '#dbb-rmtype', function () { $('#dbb-rm5').prop('disabled', $.trim($(this).val()).replace(/\s+/g, ' ') !== (RM ? RM.sel.join(' ') : '-')); });
  $(document).on('click', '#dbb-rm2', rmLoad);
  $(document).on('click', '#dbb-rm4', function () { var $b = $(this).prop('disabled', true).val('Checking...'); api('rm_check').always(function () { $b.val('Check the disks'); }).done(rmLoad).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); }); });
  $(document).on('click', '#dbb-rm5', function () {
    var names = RM.sel.join(', ').toUpperCase();
    if (!window.confirm('Clear ' + names + '?\n\nEach disk is unmounted and every byte on it is overwritten with zeros (through parity, so parity stays valid). This cannot be undone.')) { return; }
    var $b = $(this).prop('disabled', true);
    api('rm_clear', {confirm: $('#dbb-rmtype').val()}).done(function () { setTimeout(rmLoad, 3000); }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '#dbb-rmend', function () { api('rm_reset').done(function () { $('#dbb-mode').val('balance').trigger('change'); modeUi(); }); });
  $(document).on('click', '#dbb .dbb-gbar[data-g="rmlog"]', function () { if (GOPEN.rmlog && RM) { rmDraw(RM); } });
  function cfgData() {
    var d = [];
    $('.dbb-dsel:checked').each(function () { d.push($(this).val()); });
    var dr = [];
    $('.dbb-drsel:checked').each(function () { dr.push($(this).val()); });
    return {pairs: $('#dbb-pairs').val(), target: $('#dbb-target').val(), strategy: $('#dbb-strategy').val(), disks: d, mode: $('#dbb-mode').val(), drain: dr};
  }

  function barHtml(pct, tgt, col, res) {
    pct = Math.min(100, Math.max(0, pct)); res = Math.max(0, Math.min(100 - pct, res || 0));
    return '<div class="dbb-bar"><i style="width:' + pct + '%;' + (col ? 'background:' + col : '') + '"></i>' + (res > 0 ? '<i class="dbb-res" style="left:' + pct + '%;width:' + res + '%"></i>' : '') + (tgt > 0 ? '<b style="left:' + Math.min(100, tgt) + '%"></b>' : '') + '</div>';
  }
  // the disk rows and the group summaries follow the ticks and target disks
  function recalc() {
    if (!P) return;
    var used = {}, sel = 0, bytes = 0, grp = {}, keep = {};
    $.each(P.disks, function (i, d) { used[d.name] = d.used; keep[d.name] = 0; });
    $.each(P.left || [], function (i, x) { keep[x.disk] = (keep[x.disk] || 0) + (+x.size || 0); }); // data that stays on a disk to empty
    $('#dbb-units .dbb-mv').each(function () {
      var $r = $(this), u = P.units[$r.data('i')], g = grp[u.src] || (grp[u.src] = {n: 0, sel: 0, bytes: 0, to: {}, t: 0, m: 0});
      g.n++; if (u.media) { g.m++; } else { g.t++; }
      if (!$r.find('.dbb-chk').prop('checked')) { keep[u.src] = (keep[u.src] || 0) + u.size; }
      if ($r.find('.dbb-chk').prop('checked')) {
        var to = $r.find('.dbb-dst').val();
        if (to && used[to] != null) { used[u.src] -= u.size; used[to] += u.size; sel++; bytes += u.size; g.sel++; g.bytes += u.size; g.to[to] = (g.to[to] || 0) + 1; }
      }
    });
    var h = '';
    $.each(P.disks, function (i, d) {
      var now = d.used / d.size * 100, after = used[d.name] / d.size * 100, over = used[d.name] > d.size * 0.98, col = over ? '#e5534b' : after > now + 0.05 ? '#d9921f' : '#3fa24a'; // both from the bytes, so an untouched disk does not look as if it grew
      // a disk to empty: what is still used after the move but is neither a kept folder nor an unticked title is the file system's own space (XFS metadata), not data
      var res = d.drain ? Math.max(0, used[d.name] - (keep[d.name] || 0)) : 0, dataAfter = after - res / d.size * 100, chg;
      if (d.drain && res > 0) {
        chg = now.toFixed(1) + '% &rarr; ' + ((keep[d.name] || 0) < 1e9 ? 'empty' : dataAfter.toFixed(1) + '%') + '<small>+ ' + fb(res) + ' file system</small>';
      } else { chg = now.toFixed(1) + '% &rarr; ' + after.toFixed(1) + '%'; }
      h += '<div class="dbb-row dbb-disk ' + (d.drain ? 's-red' : over ? 's-red' : 's-grey') + '"><span><b>' + esc(d.label) + '</b>' + (d.drain ? '<span class="dbb-chip rd">empty</span>' : '') + '</span><span class="dbb-r">' + fb(d.size) + '</span>' +
           '<span class="dbb-bars" title="now ' + now.toFixed(1) + '%, after ' + after.toFixed(1) + '%' + (res > 0 ? ', of which ' + fb(res) + ' is the file system\'s own space (metadata), not data' : '') + '">' + barHtml(now, P.target) + barHtml(dataAfter, P.target, col, res / d.size * 100) + '</span><span class="dbb-chg">' + chg + '</span></div>';
    });
    $('#dbb-dtab').html(h);
    $.each(grp, function (src, g) {
      var to = $.map(Object.keys(g.to), function (k) { var d = $.grep(P.disks, function (x) { return x.name === k; })[0]; return (d ? d.label : k) + ' (' + g.to[k] + ')'; }).join(', ');
      var what = (g.t ? g.t + ' title' + (g.t === 1 ? '' : 's') : '') + (g.t && g.m ? ' + ' : '') + (g.m ? g.m + ' media-only item' + (g.m === 1 ? '' : 's') : '');
      $('#dbb-units .dbb-gbar[data-g="src-' + src + '"] .c').text(what + (g.sel < g.n ? ' · ' + g.sel + ' of ' + g.n + ' ticked' : '') + ' · ' + fb(g.bytes) + (to ? ' · to ' + to : ''));
      $('#dbb-units .dbb-gall[data-src="' + src + '"]').prop('checked', g.sel === g.n && g.n > 0).prop('indeterminate', g.sel > 0 && g.sel < g.n);
    });
    var tot = $('.dbb-chk').length; $('#dbb-all').prop('checked', tot > 0 && sel === tot).prop('indeterminate', sel > 0 && sel < tot);
    $('#dbb-go').val(sel ? 'Move ' + sel + ' title' + (sel > 1 ? 's' : '') + ' (' + fb(bytes) + ')' : 'Move the selected titles').prop('disabled', !sel || !!BUSY);
    // a plan can be made during a parity check, the move waits for its end: look again every minute
    $('#dbb-gomsg').toggleClass('dbb-am', !!BUSY).text(BUSY ? 'Moving waits: ' + BUSY + '.' : ($('#dbb-gomsg').hasClass('dbb-am') ? '' : $('#dbb-gomsg').text()));
    clearTimeout(busyT); if (BUSY) { busyT = setTimeout(function () { api('state').done(function (r) { BUSY = r.busy || ''; recalc(); }); }, 60000); }
    $('#dbb-pband').text((P.mode === 'drain' ? 'empty ' + $.map($.grep(P.disks, function (d) { return d.drain; }), function (d) { return d.label; }).join(', ') : 'spread evenly' + (P.target ? ' to ' + (+P.target).toFixed(0) + '%' : '')) + ' · ' + sel + ' title' + (sel === 1 ? '' : 's') + ' · ' + fb(bytes));
  }
  function drawPlan(p) {
    P = p; $('#dbb-planbox').show();
    $('#dbb-note').text(p.note || (p.msg || '')).toggle(!!(p.note || p.msg));
    var opts = function (src, sel) {
      var h = '';
      $.each(p.disks, function (i, d) { if (d.name !== src && !d.drain) h += '<option value="' + esc(d.name) + '"' + (d.name === sel ? ' selected' : '') + '>&rarr; ' + esc(d.label) + '</option>'; });
      return h;
    };
    // one foldable bar per source disk, the titles in it
    var by = {}, order = [];
    $.each(p.units || [], function (i, u) { if (!by[u.src]) { by[u.src] = []; order.push(u.src); } by[u.src].push(i); });
    var h = '';
    $.each(order, function (k, src) {
      var g = 'src-' + src, d = $.grep(p.disks, function (x) { return x.name === src; })[0];
      h += '<div class="dbb-gbar s-blue" data-g="' + g + '"><span class="pm">' + (GOPEN[g] ? '&minus;' : '+') + '</span><input type="checkbox" class="dbb-gall" data-src="' + esc(src) + '" title="Select / deselect all from this disk"><span>From ' + esc(d ? d.label : up(src)) + '</span><span class="c"></span></div>';
      h += '<div class="dbb-grp" data-g="' + g + '"' + (GOPEN[g] ? '' : ' hidden') + '>';
      // the titles first; the media files without a download (.nfo, pictures, subtitles of a title whose download is gone) in their own folded bar
      // every row is in the page (the move takes the hidden ones too); a long list shows 25 rows, then 50 more per click
      var VID = {mkv: 1, mp4: 1, avi: 1, m4v: 1, ts: 1, iso: 1, mov: 1, wmv: 1, m2ts: 1};
      var nVid = function (e) { var n = 0; $.each(e || {}, function (k, v) { if (VID[k]) { n += v; } }); return n; };
      var extTxt = function (e) { return $.map(Object.keys(e || {}), function (k) { return k + (e[k] > 1 ? ' ' + e[k] : ''); }).join(', '); };
      var row = function (i, n, lk) { var u = p.units[i]; return '<div class="dbb-row dbb-mv" data-i="' + i + '"' + (n >= (LIM[lk] || 25) ? ' data-more="' + lk + '" hidden' : '') + '><input type="checkbox" class="dbb-chk"' + (u.sel ? ' checked' : '') + '><span><b>' + esc(u.title) + '</b><small>' + esc(u.pair) + ' &middot; ' + u.nfiles + ' file' + (u.nfiles === 1 ? '' : 's') + (u.exts ? ' &middot; ' + esc(extTxt(u.exts)) : '') + (u.media && u.also ? (u.also.length ? ' &middot; the folder is also on ' + up(u.also.join(', ')) : ' &middot; on no other disk') : '') + (u.media && nVid(u.exts) ? ' <span class="dbb-chip am">video without a download</span>' : '') + '</small></span><span class="dbb-r">' + fb(u.size) + '</span><span><select class="dbb-dst">' + opts(u.src, u.dst) + '</select></span></div>'; };
      var more = function (lk, n) { var lim = LIM[lk] || 25; return n > lim ? '<div class="dbb-status"><input type="button" class="dbb-more dbb-ghost" data-k="' + lk + '" value="Show ' + Math.min(50, n - lim) + ' more (' + (n - lim) + ' left)"></div>' : ''; };
      var ti = $.grep(by[src], function (i) { return !p.units[i].media; }), mi = $.grep(by[src], function (i) { return !!p.units[i].media; });
      $.each(ti, function (j, i) { h += row(i, j, 't-' + src); });
      h += more('t-' + src, ti.length);
      if (mi.length) {
        // media files that have no hardlink to a download on this disk: a hardlink cannot cross disks, so the download (and the video) may be on another disk
        var mg = 'med-' + src, msz = 0, mex = {}, nEl = 0, nNo = 0;
        $.each(mi, function (j, i) { var u = p.units[i]; msz += u.size; $.each(u.exts || {}, function (k, v) { mex[k] = (mex[k] || 0) + v; }); if (u.also) { if (u.also.length) { nEl++; } else { nNo++; } } });
        var mv = 0; $.each(mi, function (j, i) { mv += nVid(p.units[i].exts); });
        var mtop = {}; $.each(Object.keys(mex).sort(function (a, b) { return mex[b] - mex[a]; }).slice(0, 5), function (j, k) { mtop[k] = mex[k]; });
        h += '<div class="dbb-gbar s-grey" data-g="' + mg + '" style="padding-left:34px" title="Files in the media folders of this disk that have no hardlink (a hardlink cannot cross disks, so they have none anywhere). Mostly pictures and .nfo that Radarr, Sonarr or Jellyfin wrote next to a film whose video and download are on another disk. A video file here has lost its download: nothing seeds it."><span class="pm">' + (GOPEN[mg] ? '&minus;' : '+') + '</span><span></span><span>Library files without a hardlink</span><span class="c">' + mi.length + ' folder' + (mi.length === 1 ? '' : 's') + ' &middot; ' + fb(msz) + (Object.keys(mtop).length ? ' &middot; ' + esc(extTxt(mtop)) : '') + (nEl || nNo ? ' &middot; ' + nEl + ' also on another disk' + (nNo ? ', ' + nNo + ' only here' : '') : '') + (mv ? ' &middot; <span class="dbb-am">' + mv + ' video file' + (mv === 1 ? '' : 's') + ' without a download</span>' : '') + '</span></div>';
        h += '<div class="dbb-grp" data-g="' + mg + '"' + (GOPEN[mg] ? '' : ' hidden') + '>';
        $.each(mi, function (j, i) { h += row(i, j, 'm-' + src); });
        h += more('m-' + src, mi.length) + '</div>';
      }
      h += '</div>';
    });
    $('#dbb-units').html(h || '<div class="dbb-status dbb-mut">Nothing to move: the disks are balanced or no title can be moved.</div>');
    var sk = '';
    $.each(p.skipped || [], function (i, u) { sk += '<div class="dbb-row dbb-left"><span></span><span><b>' + esc(u.title) + '</b><small>' + esc(u.pair) + ' &middot; ' + esc(u.why) + '</small></span><span></span><span class="dbb-r">' + fb(u.size) + '</span></div>'; });
    $('#dbb-skiplist').html(sk); $('#dbb-skipc').text((p.skipped || []).length + ' title' + ((p.skipped || []).length === 1 ? '' : 's')); $('#dbb-skipbox').toggle(!!sk);
    var lh = '';
    $.each(p.left || [], function (i, x) { lh += '<div class="dbb-row dbb-left"><span>' + up(x.disk) + '</span><span><b>' + esc(x.path) + '</b></span><span class="dbb-r">' + x.n + ' files</span><span class="dbb-r">' + fb(x.size) + '</span></div>'; });
    $('#dbb-leftlist').html(lh);
    var nl = (p.left || []).length;
    $('#dbb-lefttg').text(nl ? 'Stays on the disk to empty (outside the folders above, or left out; move or delete it yourself)' : 'Nothing else stays on the disk to empty once the ticked titles are moved');
    $('#dbb-leftc').text(nl ? nl + ' folder' + (nl === 1 ? '' : 's') + ' · ' + fb(p.leftSize || 0) : '');
    $('#dbb-leftbox').toggle(p.mode === 'drain');
    $('#dbb-leftbox .dbb-gbar').toggleClass('s-amber', !!nl).toggleClass('s-green', !nl);
    recalc();
  }
  $(document).on('change', '.dbb-chk, .dbb-dst', recalc);
  $(document).on('click', '.dbb-more', function () {
    var k = String($(this).data('k')), $h = $('#dbb-units .dbb-mv[data-more="' + k + '"]').filter('[hidden]'), n = $h.length;
    $h.slice(0, 50).prop('hidden', false).removeAttr('data-more'); LIM[k] = (LIM[k] || 25) + 50;
    if (n <= 50) { $(this).closest('.dbb-status').remove(); } else { $(this).val('Show ' + Math.min(50, n - 50) + ' more (' + (n - 50) + ' left)'); }
  });
  $(document).on('change', '.dbb-gall', function () { var src = String($(this).data('src')), on = $(this).prop('checked'); $('#dbb-units .dbb-mv').each(function () { if (P.units[$(this).data('i')].src === src) { $(this).find('.dbb-chk').prop('checked', on); } }); recalc(); });
  $('#dbb-all').on('change', function () { $('.dbb-chk').prop('checked', $(this).prop('checked')); recalc(); });

  function pollPlan() {
    api('getplan').done(function (r) {
      var p = r.plan;
      if (p.state === 'running') { $('#dbb-pmsg').css('color', '').text(p.msg || 'Scanning...'); planPoll = setTimeout(pollPlan, 1500); return; }
      $('#dbb-plan').prop('disabled', false);
      if (p.state === 'ready') { $('#dbb-pmsg').text(''); BUSY = r.busy || ''; drawPlan(p); }
      else if (p.state === 'error') { $('#dbb-pmsg').css('color', '#e5534b').text(p.msg); }
    }).fail(function (x) { $('#dbb-plan').prop('disabled', false); $('#dbb-pmsg').css('color', '#e5534b').text(err(x)); });
  }
  $('#dbb-plan').on('click', function () {
    var $b = $(this).prop('disabled', true);
    $('#dbb-pmsg').css('color', '').text('Saving...');
    api('saveconfig', cfgData()).done(function (r) {
      if (!r.ok) { $b.prop('disabled', false); $('#dbb-pmsg').css('color', '#e5534b').text(r.error); return; }
      api('plan').done(function (r2) {
        if (!r2.ok) { $b.prop('disabled', false); $('#dbb-pmsg').css('color', '#e5534b').text(r2.error); return; }
        $('#dbb-planbox').hide(); $('#dbb-pmsg').text('Scanning the disks, this can take a minute...'); setTimeout(pollPlan, 1200);
      }).fail(function (x) { $b.prop('disabled', false); $('#dbb-pmsg').css('color', '#e5534b').text(err(x)); });
    }).fail(function (x) { $b.prop('disabled', false); $('#dbb-pmsg').css('color', '#e5534b').text(err(x)); });
  });

  $('#dbb-go').on('click', function () {
    var sel = {}, n = 0, bytes = 0;
    $('#dbb-units .dbb-mv').each(function () {
      var $r = $(this), u = P.units[$r.data('i')];
      if ($r.find('.dbb-chk').prop('checked')) { sel[u.id] = $r.find('.dbb-dst').val(); n++; bytes += u.size; }
    });
    if (!n) return;
    if (!window.confirm('Move ' + n + ' title(s), ' + fb(bytes) + ', between disks?\n\nThe files are copied, checked and only then removed from the old disk. This can take hours. Pause or stop the torrents of these titles first if you can.')) return;
    var $b = $(this).prop('disabled', true);
    api('start', {sel: JSON.stringify(sel)}).done(function (r) {
      if (!r.ok) { $b.prop('disabled', false); $('#dbb-gomsg').css('color', '#e5534b').text(r.error); return; }
      $('#dbb-gomsg').text(''); $('#dbb-planbox').hide(); poll();
    }).fail(function (x) { $b.prop('disabled', false); $('#dbb-gomsg').css('color', '#e5534b').text(err(x)); });
  });
  $('#dbb-stop').on('click', function () { $(this).prop('disabled', true); api('stop'); });

  function drawRun(s, running) {
    if (!s || s.state === 'idle') { $('#dbb-runbox').hide(); return; }
    $('#dbb-runbox').show();
    var pct = s.total > 0 ? Math.min(100, (s.done + (s.curBytes || 0)) / s.total * 100) : 0;
    $('#dbb-rbar').css('width', pct + '%');
    var t = {running: 'Moving', done: 'Finished', aborted: 'Stopped', error: 'Stopped with an error'}[s.state] || s.state;
    var cls = {done: 'dbb-ok', error: 'dbb-er', aborted: 'dbb-am'}[s.state] || '';
    var el = ((s.finished || Math.floor(Date.now() / 1000)) - s.started), nok = 0, nall = (s.items || []).length;
    $.each(s.items || [], function (i, it) { if (it.state === 'ok') { nok++; } });
    $('#dbb-rstat').html('<b class="' + cls + '">' + t + '</b> ' + nok + ' / ' + nall + ' titles &middot; ' + fb(s.done + (s.curBytes || 0)) + ' of ' + fb(s.total) + ' (' + pct.toFixed(0) + '%) &middot; ' + dur(el) + (s.msg ? ' &middot; <span class="' + cls + '">' + esc(s.msg) + '</span>' : ''));
    $('#dbb-aband').text(s.state === 'running' ? 'moving now · ' + pct.toFixed(0) + '%' : t.toLowerCase() + ' · ' + nok + ' of ' + nall + ' titles');
    // short list: failed and moving titles and the next 5 waiting ones are shown, the rest is folded (waiting, skipped, done)
    var rowH = function (it) {
      var st = {wait: 'waiting', run: 'moving', ok: 'done', skip: 'skipped', fail: 'FAILED'}[it.state] || it.state;
      var c = {ok: 'dbb-ok', fail: 'dbb-er', skip: 'dbb-am'}[it.state] || '', sc = {ok: 's-green', fail: 's-red', skip: 's-amber', run: 's-blue'}[it.state] || 's-grey';
      return '<div class="dbb-row dbb-run ' + sc + '"><span><b>' + esc(it.title) + '</b><small>' + esc(it.pair) + '</small></span><span class="dbb-r">' + fb(it.size) + '</span><span>' + up(it.src) + ' &rarr; ' + up(it.dst) + '</span><span class="' + c + '">' + st + (it.msg ? ': ' + esc(it.msg) : '') + '</span></div>';
    };
    var top = '', grp = {wait: [], skip: [], ok: []}, gsz = {wait: 0, skip: 0, ok: 0}, nw = 0;
    $.each(s.items || [], function (i, it) {
      if (it.state === 'fail' || it.state === 'run' || (it.state === 'wait' && s.state === 'running' && nw++ < 5)) { top += rowH(it); return; }
      var k = grp[it.state] ? it.state : 'wait'; grp[k].push(rowH(it)); gsz[k] += +it.size || 0;
    });
    var bar = function (k, cls, label) {
      var g = 'r' + k, n = grp[k].length; if (!n) { return ''; }
      return '<div class="dbb-gbar ' + cls + '" data-g="' + g + '"><span class="pm">' + (GOPEN[g] ? '&minus;' : '+') + '</span><span></span><span>' + label(n) + '</span><span class="c">' + fb(gsz[k]) + '</span></div><div class="dbb-grp" data-g="' + g + '"' + (GOPEN[g] ? '' : ' hidden') + '>' + grp[k].join('') + '</div>';
    };
    $('#dbb-rtab').html(top + bar('wait', 's-grey', function (n) { return n + (s.state === 'running' ? ' more waiting' : ' not moved'); })
      + bar('skip', 's-amber', function (n) { return n + ' skipped'; }) + bar('ok', 's-green', function (n) { return n + ' done'; }));
    var $l = $('#dbb-rlog'), atEnd = $l[0].scrollTop + $l[0].clientHeight >= $l[0].scrollHeight - 5;
    $l.text((s.log || []).join('\n')); if (atEnd) { $l[0].scrollTop = $l[0].scrollHeight; }
    $('#dbb-runbox .dbb-gbar[data-g="rlog"] .c').text((s.log || []).length + ' lines');
    $('#dbb-stop').toggle(!!running).prop('disabled', false);
  }
  // the finished runs, folded under one bar
  function drawHist(r) {
    var hh = (r.history || []).filter(function (x) { return x; }), runs = 0, ab = 0, last = '';
    $.each(hh, function (i, l) { if (/ start /.test(l)) { runs++; } if (/ aborted /.test(l)) { ab++; } last = l.slice(0, 10); });
    $('#dbb-hist').html(hh.length ? '<div class="dbb-gbar s-grey" data-g="hist"><span class="pm">' + (GOPEN.hist ? '&minus;' : '+') + '</span><span></span><span>Recent moves &middot; ' + runs + ' run' + (runs === 1 ? '' : 's') + '</span><span class="c">' + (ab ? ab + ' stopped &middot; ' : '') + 'last on ' + esc(last) + '</span></div><div class="dbb-grp" data-g="hist"' + (GOPEN.hist ? '' : ' hidden') + '><div class="dbb-log">' + esc(hh.join('\n')) + '</div></div>'
      : '<div class="dbb-status dbb-mut">Nothing moved yet.</div>');
    if ((!r.run || r.run.state === 'idle') && !$('#dbb-rmact').children().length) { $('#dbb-aband').text(hh.length ? 'nothing running · last move on ' + last : 'nothing running'); }
  }
  function poll() {
    clearTimeout(pollT);
    api('state').done(function (r) {
      drawRun(r.run, r.running); drawHist(r);
      if (r.running || r.run.state === 'running') { pollT = setTimeout(poll, 2000); }
    });
  }

  api('state').done(function (r) {
    BUSY = r.busy || '';
    drawCfg(r);
    drawRun(r.run, r.running); drawHist(r);
    if (r.running || r.run.state === 'running') { poll(); }
    else if (r.plan.state === 'running') { $('#dbb-plan').prop('disabled', true); pollPlan(); }
    else if (r.plan.state === 'ready') { api('getplan').done(function (g) { BUSY = g.busy || BUSY; if (g.plan.units) { drawPlan(g.plan); } }); }
  }).fail(function (x) { $('#dbb-pmsg').css('color', '#e5534b').text(err(x)); });
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- BALANCE ENDPOINT -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/balance_lib.php">
<INLINE><![CDATA[<?php
// Diskbox Balance: plan and move whole titles (a downloads folder and its hardlinked media files)
// between array disks, keeping the hardlinks. Used by balance.php (web) and balance_run.php (background).
require_once __DIR__ . '/lib.php';

// DBX_BL_DIR (tests only): keep the settings and the /tmp files in that folder instead
$bl_t = getenv('DBX_BL_DIR'); $bl_t = ($bl_t !== false && $bl_t !== '') ? rtrim($bl_t, '/') : '';
define('BL_CFG',    $bl_t !== '' ? $bl_t . '/balance.json' : '/boot/config/plugins/diskbox/balance.json');
define('BL_LOG',    $bl_t !== '' ? $bl_t . '/balance.log' : '/boot/config/plugins/diskbox/balance.log');
$bl_t = $bl_t !== '' ? $bl_t : '/tmp';
define('BL_PLAN',   $bl_t . '/diskbox_balance_plan.json');
define('BL_PLANF',  $bl_t . '/diskbox_balance_planfiles.json');
define('BL_JOB',    $bl_t . '/diskbox_balance_job.json');
define('BL_STATUS', $bl_t . '/diskbox_balance_status.json');
define('BL_STOP',   $bl_t . '/diskbox_balance_stop');
define('BL_LOCK',   $bl_t . '/diskbox_balance.lock');
unset($bl_t);
// Seedbox keeps replaced or deleted downloads in this folder inside each downloads folder (purged after some days)
const BL_TRASH  = '.seedbox_trash';

function bl_mnt() { $m = getenv('DBX_MNT'); return ($m !== false && $m !== '') ? rtrim($m, '/') : '/mnt'; }
function bl_rsync() { $r = getenv('DBX_RSYNC'); return ($r !== false && $r !== '') ? $r : 'rsync'; }

function bl_json_read($f, $def = null) {
    if (!is_file($f)) { return $def; }
    $j = json_decode((string)@file_get_contents($f), true);
    return is_array($j) ? $j : $def;
}
function bl_json_write($f, $data, $mode = 0644) {
    $dir = dirname($f);
    if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
    $tmp = $f . '.tmp' . getmypid();
    if (@file_put_contents($tmp, json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)) === false) { return false; }
    if (!@rename($tmp, $f)) { @unlink($tmp); return false; }
    @chmod($f, $mode);
    return true;
}

function bl_cfg() {
    $c = ['pairs' => [['dl' => 'data/downloads/FILM', 'media' => 'data/media/film'], ['dl' => 'data/downloads/SOROZAT', 'media' => 'data/media/sorozat']],
          'target' => '', 'strategy' => 'old', 'disks' => [], 'mode' => 'balance', 'drain' => []];
    $x = bl_json_read(BL_CFG, []);
    foreach (['pairs', 'target', 'strategy', 'disks', 'mode', 'drain'] as $k) { if (isset($x[$k])) { $c[$k] = $x[$k]; } }
    return $c;
}

// a path relative to the disk root: no leading slash, no .. and no control characters
function bl_path_ok($p) {
    $p = trim((string)$p, " \t/");
    if ($p === '' || preg_match('/[\x00-\x1f\\\\]/', $p)) { return false; }
    foreach (explode('/', $p) as $seg) { if ($seg === '' || $seg === '.' || $seg === '..') { return false; } }
    return $p;
}

// array data disks that can take part: name => [name, label, size, free, used, pct]
function bl_disks() {
    $names = [];
    $t = getenv('DBX_DISKS');
    if ($t !== false && $t !== '') { $names = explode(',', $t); }
    else {
        foreach (db_disks() as $k => $d) {
            if (preg_match('/^disk\d+$/', $k) && ($d['type'] ?? '') === 'Data' && ($d['status'] ?? '') === 'DISK_OK') { $names[] = $k; }
        }
    }
    usort($names, function ($a, $b) { return (int)substr($a, 4) <=> (int)substr($b, 4); });
    $out = [];
    foreach ($names as $n) {
        $m = bl_mnt() . '/' . $n;
        if (!is_dir($m)) { continue; }
        $size = (float)@disk_total_space($m); $free = (float)@disk_free_space($m);
        $fk = getenv('DBX_FAKE');
        if ($fk !== false && $fk !== '') { $fj = json_decode($fk, true); if (isset($fj[$n])) { $size = (float)$fj[$n][0]; $free = $size - (float)$fj[$n][1]; } }
        if ($size <= 0) { continue; }
        $out[$n] = ['name' => $n, 'label' => strtoupper($n), 'size' => $size, 'free' => $free, 'used' => $size - $free, 'pct' => ($size - $free) / $size * 100];
    }
    return $out;
}

// why nothing may move now ('' = it may). $plan: a plan only reads the disks, so a parity check does not stop it (moving waits for its end)
function bl_busy_reason($plan = false) {
    $v = db_var();
    if (getenv('DBX_DISKS') === false || getenv('DBX_DISKS') === '') {
        if (($v['mdState'] ?? '') !== 'STARTED') { return 'the array is not started'; }
        if (!$plan && (float)($v['mdResync'] ?? 0) > 0) {
            $pos = (float)($v['mdResyncPos'] ?? 0); $size = (float)($v['mdResyncSize'] ?? 0);
            return 'a parity check or rebuild is running' . ($size > 0 ? ' (' . round($pos / $size * 100) . ' %)' : '');
        }
        $m = trim((string)@shell_exec('pgrep -x mover 2>/dev/null'));
        if ($m !== '') { return 'the mover is running'; }
    }
    return '';
}

function bl_running() {
    $f = @fopen(BL_LOCK, 'c');
    if (!$f) { return false; }
    if (flock($f, LOCK_EX | LOCK_NB)) { flock($f, LOCK_UN); fclose($f); return false; }
    fclose($f);
    return true;
}

// ---- scanning ---------------------------------------------------------------------------------------
function bl_find($args) {
    $o = (string)@shell_exec('find ' . $args . ' 2>/dev/null');
    return $o === '' ? [] : explode("\0", rtrim($o, "\0"));
}

// first path segment and the rest ('a/b/c' -> ['a', 'b/c'])
function bl_split($rel) {
    $i = strpos($rel, '/');
    return $i === false ? [$rel, ''] : [substr($rel, 0, $i), substr($rel, $i + 1)];
}

// Returns [units, skipped, leftovers] for one disk. A unit is the top-level entry of a downloads folder together with
// every other hardlink (in the media folders) of its files. Hardlinked names always stay in one unit, so one rsync -aH
// run recreates them on the target. The Seedbox trash folder (.seedbox_trash) is left out.
// $drain (emptying a disk): the trash items become units too (each item in the trash is one), and the media files that
// belong to no download (no hardlink, or the download is gone; also .nfo, pictures, subtitles) are added to the title
// whose video is in the same media folder, or become a title of their own ("media only"). leftovers: what would still
// stay on the disk (other folders, skipped titles), grouped by folder.
function bl_scan_disk($disk, $pairs, $drain = false) {
    $root = bl_mnt() . '/' . $disk;
    $units = []; $inodeUnits = []; $found = []; $wantInodes = []; $topUnits = []; $loose = [];
    $unit = function ($key, $title, $pair, $pi, $media = false) use (&$units) {
        if (!isset($units[$key])) { $units[$key] = ['title' => $title, 'pair' => $pair, 'files' => [], 'inodes' => [], 'mtime' => 0, 'partial' => false, 'pi' => $pi, 'media' => $media]; }
    };
    foreach ($pairs as $pi => $pr) {
        $dlAbs = $root . '/' . $pr['dl'];
        if (!is_dir($dlAbs)) { continue; }
        foreach (bl_find(escapeshellarg($dlAbs) . ' -mindepth 1 -type f -printf ' . escapeshellarg('%i\t%n\t%s\t%T@\t%P\0')) as $rec) {
            $f = explode("\t", $rec, 5);
            if (count($f) < 5) { continue; }
            [$ino, $nl, $sz, $mt, $rel] = $f;
            [$first, $rest] = bl_split($rel);
            if ($first === BL_TRASH) {
                if (!$drain || $rest === '') { continue; }
                $first = BL_TRASH . '/' . bl_split($rest)[0];
            }
            $key = $pi . '|' . $first;
            $unit($key, $first, basename($pr['dl']), $pi);
            $u = &$units[$key];
            $u['files'][] = [$pr['dl'] . '/' . $rel, $ino];
            $u['inodes'][$ino] = [(int)$nl, (float)$sz];
            $u['mtime'] = max($u['mtime'], (float)$mt);
            if (preg_match('/\.(!qb|!ut|part|crdownload|tmp)$/i', $rel)) { $u['partial'] = true; }
            unset($u);
            $inodeUnits[$ino][$key] = true;
            $found[$ino] = ($found[$ino] ?? 0) + 1;
            $wantInodes[$ino] = true;
        }
    }
    $seen = [];
    foreach ($pairs as $pi => $pr) {
        if ($pr['media'] === '' || !is_dir($root . '/' . $pr['media'])) { continue; }
        if (!$wantInodes && !$drain) { break; }
        foreach (bl_find(escapeshellarg($root . '/' . $pr['media']) . ' -mindepth 1 -type f -printf ' . escapeshellarg('%i\t%n\t%s\t%T@\t%P\0')) as $rec) {
            $f = explode("\t", $rec, 5);
            if (count($f) < 5) { continue; }
            [$ino, $nl, $sz, $mt, $rel] = $f;
            $path = $pr['media'] . '/' . $rel;
            if (isset($seen[$path])) { continue; }
            $seen[$path] = true;
            $top = $pi . '|' . bl_split($rel)[0];
            if (isset($wantInodes[$ino])) {
                $found[$ino] = ($found[$ino] ?? 0) + 1;
                foreach ($inodeUnits[$ino] as $key => $_) { $units[$key]['files'][] = [$path, $ino]; $topUnits[$top][$key] = true; }
            } elseif ($drain) {
                $found[$ino] = ($found[$ino] ?? 0) + 1;
                $loose[$top][] = [$path, $ino, (int)$nl, (float)$sz, (float)$mt];
            }
        }
    }
    // media files without a download: media folders that share a hardlink are joined (they must move together); a group
    // goes into the one title that has files in the same media folder(s), else it is a title of its own
    $par = [];
    $find = function ($t) use (&$par) { while ($par[$t] !== $t) { $t = $par[$t] = $par[$par[$t]]; } return $t; };
    $byIno = [];
    foreach ($loose as $top => $list) {
        $par[$top] = $par[$top] ?? $top;
        foreach ($list as $x) {
            if (isset($byIno[$x[1]])) { $a = $find($byIno[$x[1]]); $b = $find($top); if ($a !== $b) { $par[$b] = $a; } }
            else { $byIno[$x[1]] = $top; }
        }
    }
    $groups = [];
    foreach (array_keys($loose) as $top) { $groups[$find($top)][] = $top; }
    foreach ($groups as $tops) {
        $owners = [];
        foreach ($tops as $top) { foreach ($topUnits[$top] ?? [] as $k => $_) { $owners[$k] = true; } }
        $owners = array_keys($owners);
        $pi = (int)explode('|', $tops[0], 2)[0];
        if (count($owners) === 1) { $key = $owners[0]; }
        else {
            $key = 'm' . $tops[0];
            $unit($key, implode(' + ', array_map(function ($t) { return explode('|', $t, 2)[1]; }, $tops)), basename($pairs[$pi]['media']), $pi, true);
        }
        foreach ($tops as $top) {
            foreach ($loose[$top] as $x) {
                [$path, $ino, $nl, $sz, $mt] = $x;
                $units[$key]['files'][] = [$path, $ino];
                if (!isset($units[$key]['inodes'][$ino])) { $units[$key]['inodes'][$ino] = [$nl, $sz]; }
                $units[$key]['mtime'] = max($units[$key]['mtime'], $mt);
                $inodeUnits[$ino][$key] = true;
            }
        }
    }
    $ok = []; $skipped = []; $taken = [];
    foreach ($units as $key => $u) {
        $size = 0.0; $why = '';
        foreach ($u['inodes'] as $ino => $v) {
            $size += $v[1];
            if (count($inodeUnits[$ino]) > 1) { $why = 'shares files with another title'; }
            elseif ($v[0] != ($found[$ino] ?? 0) && $why === '') { $why = 'has hardlinks outside the configured folders'; }
        }
        if ($why === '' && $u['partial']) { $why = 'looks unfinished (partial download)'; }
        if ($why === '' && $u['mtime'] > time() - 7200) { $why = 'changed in the last 2 hours'; }
        $row = ['title' => $u['title'], 'pair' => $u['pair'], 'src' => $disk, 'size' => $size, 'nfiles' => count($u['files']), 'mtime' => (int)$u['mtime']];
        // what kind of files the title holds (extension => count), shown on the page instead of a guess
        $ext = []; foreach ($u['files'] as $x) { $e = strtolower(pathinfo((string)$x[0], PATHINFO_EXTENSION)); $e = $e === '' ? '(none)' : substr($e, 0, 8); $ext[$e] = ($ext[$e] ?? 0) + 1; }
        arsort($ext); $row['exts'] = array_slice($ext, 0, 6, true);
        if ($u['media'] && $u['files']) {
            // a hardlink cannot cross disks: is the same media folder on another array disk too (where the video and its download usually are)?
            $mp = $pairs[$u['pi']]['media'] ?? ''; $rel0 = (string)$u['files'][0][0];
            if ($mp !== '' && strpos($rel0, $mp . '/') === 0) {
                $topDir = $mp . '/' . bl_split(substr($rel0, strlen($mp) + 1))[0]; $also = [];
                foreach (array_keys(bl_disks()) as $od) { if ($od !== $disk && is_dir(bl_mnt() . '/' . $od . '/' . $topDir)) { $also[] = $od; } }
                $row['also'] = $also;
            }
        }
        if ($u['media']) { $row['media'] = true; }
        if ($why !== '') { $row['why'] = $why; $skipped[] = $row; }
        else { $row['files'] = $u['files']; $ok[] = $row; foreach ($u['files'] as $x) { $taken[$x[0]] = true; } }
    }
    return [$ok, $skipped, $drain ? bl_leftovers($disk, $pairs, $taken) : []];
}

// Everything on the disk that the plan does not move, grouped (a title inside a configured folder, else the first two
// folder levels), largest first. Hardlinked names are counted once.
function bl_leftovers($disk, $pairs, $taken) {
    $roots = [];
    foreach ($pairs as $pr) {
        $roots[] = $pr['dl'] . '/' . BL_TRASH; $roots[] = $pr['dl'];
        if ($pr['media'] !== '') { $roots[] = $pr['media']; }
    }
    usort($roots, function ($a, $b) { return strlen($b) <=> strlen($a); });
    $g = []; $ino = [];
    foreach (bl_find(escapeshellarg(bl_mnt() . '/' . $disk) . ' -mindepth 1 -type f -printf ' . escapeshellarg('%i\t%s\t%P\0')) as $rec) {
        $f = explode("\t", $rec, 3);
        if (count($f) < 3 || isset($taken[$f[2]])) { continue; }
        $p = $f[2]; $grp = '';
        foreach ($roots as $r) {
            if (strpos($p, $r . '/') === 0) { $grp = $r . '/' . bl_split(substr($p, strlen($r) + 1))[0]; break; }
        }
        if ($grp === '') { $s = explode('/', $p); $grp = count($s) > 2 ? $s[0] . '/' . $s[1] : $p; }
        if (!isset($g[$grp])) { $g[$grp] = ['disk' => $disk, 'path' => $grp, 'size' => 0.0, 'n' => 0]; }
        $g[$grp]['n']++;
        if (!isset($ino[$f[0]])) { $ino[$f[0]] = true; $g[$grp]['size'] += (float)$f[1]; }
    }
    usort($g, function ($a, $b) { return $b['size'] <=> $a['size']; });
    return array_values($g);
}

function bl_plan_status($state, $msg = '', $extra = []) {
    bl_json_write(BL_PLAN, array_merge(['state' => $state, 't' => time(), 'msg' => $msg], $extra));
}

// Builds the plan and writes BL_PLAN (what the page shows) and BL_PLANF (file lists, server side only).
function bl_make_plan() {
    $cfg = bl_cfg();
    $all = bl_disks();
    $want = array_filter((array)$cfg['disks'], 'is_string');
    $disks = $want ? array_intersect_key($all, array_flip($want)) : $all;
    if (count($disks) < 2) { bl_plan_status('error', 'At least two array data disks must be included.'); return; }
    $pairs = [];
    foreach ((array)$cfg['pairs'] as $p) {
        $dl = bl_path_ok($p['dl'] ?? ''); $md = trim((string)($p['media'] ?? '')) === '' ? '' : bl_path_ok($p['media']);
        if ($dl !== false && $md !== false) { $pairs[] = ['dl' => $dl, 'media' => $md]; }
    }
    if (!$pairs) { bl_plan_status('error', 'No valid folder pair is configured.'); return; }
    if (in_array($cfg['mode'] ?? '', ['drain', 'remove'], true)) { bl_plan_drain($cfg, $disks, $pairs); return; }

    $sumSize = 0; $sumUsed = 0;
    foreach ($disks as $d) { $sumSize += $d['size']; $sumUsed += $d['used']; }
    $avg = $sumUsed / $sumSize * 100;
    $req = trim((string)$cfg['target']) === '' ? null : (float)$cfg['target'];
    $note = '';
    if ($req === null || $req < $avg) {
        $T = $avg;
        if ($req !== null) { $note = 'The array as a whole is ' . number_format($avg, 1) . '% full, so ' . number_format($req, 0) . '% is not reachable; balancing to ' . number_format($avg, 1) . '% instead.'; }
    } else { $T = $req; }
    $need = []; $excess = [];
    foreach ($disks as $n => $d) {
        $tb = $T / 100 * $d['size'];
        $excess[$n] = max(0, $d['used'] - $tb);
        $need[$n] = max(0, $tb - $d['used']);
    }
    $totalExcess = array_sum($excess);
    if ($totalExcess < 0.005 * $sumSize) { bl_plan_status('ready', 'The disks are already balanced.', ['target' => $T, 'avg' => $avg, 'note' => $note, 'disks' => array_values($disks), 'units' => [], 'skipped' => []]); bl_json_write(BL_PLANF, []); return; }

    bl_plan_status('running', 'Scanning the disks...');
    $donors = array_keys(array_filter($excess, function ($x, $n) use ($disks) { return $x >= 0.005 * $disks[$n]['size']; }, ARRAY_FILTER_USE_BOTH));
    usort($donors, function ($a, $b) use ($excess) { return $excess[$b] <=> $excess[$a]; });
    $units = []; $skipped = [];
    $strategy = ($cfg['strategy'] === 'big') ? 'big' : 'old';
    $dnr = array_keys(array_filter($need, function ($x) { return $x > 0; }));
    foreach ($donors as $dn) {
        bl_plan_status('running', 'Scanning ' . strtoupper($dn) . '...');
        [$ok, $sk] = bl_scan_disk($dn, $pairs);
        foreach ($sk as $s) { $skipped[] = $s; }
        usort($ok, function ($a, $b) use ($strategy) { return $strategy === 'big' ? ($b['size'] <=> $a['size']) : ($a['mtime'] <=> $b['mtime']); });
        $ex = $excess[$dn];
        foreach ($ok as $u) {
            $u['sel'] = false; $u['dst'] = '';
            $tol = 0;
            if ($ex > 0) {
                $best = ''; $bn = 0;
                foreach ($dnr as $rn) {
                    if ($rn === $dn) { continue; }
                    $tol = 0.01 * $disks[$rn]['size'];
                    if ($need[$rn] + $tol >= $u['size'] && $need[$rn] > $bn) { $best = $rn; $bn = $need[$rn]; }
                }
                if ($best !== '') { $u['sel'] = true; $u['dst'] = $best; $need[$best] -= $u['size']; $ex -= $u['size']; }
            }
            $units[] = $u;
        }
    }
    // unselected titles get the neediest other disk as a default destination
    bl_plan_publish($units, $skipped, $disks, ['target' => $T, 'avg' => $avg, 'req' => $req, 'note' => $note, 'strategy' => $strategy]);
}

// writes BL_PLANF (file lists, server side only) and BL_PLAN (what the page shows)
function bl_plan_publish($units, $skipped, $disks, $extra) {
    usort($units, function ($a, $b) { return ($b['sel'] <=> $a['sel']); });
    $units = array_slice($units, 0, 3000);
    $pub = []; $filesById = [];
    foreach ($units as $i => $u) {
        $id = 'u' . $i;
        $filesById[$id] = $u['files']; unset($u['files']);
        if ($u['dst'] === '') {
            $bn = -1; foreach ($disks as $rn => $d) { if ($rn !== $u['src'] && empty($d['drain']) && $d['pct'] < ($bn < 0 ? 1000 : $bn)) { $bn = $d['pct']; $u['dst'] = $rn; } }
        }
        $u['id'] = $id; $pub[] = $u;
    }
    usort($skipped, function ($a, $b) { return $b['size'] <=> $a['size']; });
    bl_json_write(BL_PLANF, $filesById, 0600);
    bl_plan_status('ready', '', array_merge(['disks' => array_values($disks), 'units' => $pub, 'skipped' => array_slice($skipped, 0, 200)], $extra));
}

// Emptying disks: every title on the disks to empty is planned to the other included disks (the one that stays the least
// full gets the next title, largest titles first). What cannot be moved is listed (skipped titles and leftovers).
function bl_plan_drain($cfg, $disks, $pairs) {
    $drain = array_values(array_intersect(array_filter((array)$cfg['drain'], 'is_string'), array_keys($disks)));
    if (!$drain) { bl_plan_status('error', 'Tick at least one disk to empty.'); return; }
    $targets = array_values(array_diff(array_keys($disks), $drain));
    if (!$targets) { bl_plan_status('error', 'At least one included disk must stay to receive the data.'); return; }
    $used = []; $room = []; $sumSize = 0; $sumUsed = 0;
    foreach ($disks as $n => $d) { $sumUsed += $d['used']; }
    foreach ($targets as $n) { $used[$n] = $disks[$n]['used']; $room[$n] = $disks[$n]['free'] - max(5e9, 0.01 * $disks[$n]['size']); $sumSize += $disks[$n]['size']; }
    foreach ($drain as $n) { $disks[$n]['drain'] = true; }
    $T = $sumUsed / $sumSize * 100;
    $units = []; $skipped = []; $left = []; $nofit = 0;
    foreach ($drain as $dn) {
        bl_plan_status('running', 'Scanning ' . strtoupper($dn) . '...');
        [$ok, $sk, $lo] = bl_scan_disk($dn, $pairs, true);
        foreach ($sk as $x) { $skipped[] = $x; }
        foreach ($lo as $x) { $left[] = $x; }
        usort($ok, function ($a, $b) { return $b['size'] <=> $a['size']; });
        foreach ($ok as $u) {
            $u['sel'] = false; $u['dst'] = ''; $best = ''; $bp = 1e9;
            foreach ($targets as $n) {
                $p = ($used[$n] + $u['size']) / $disks[$n]['size'];
                if ($room[$n] >= $u['size'] && $p < $bp) { $best = $n; $bp = $p; }
            }
            if ($best !== '') { $u['sel'] = true; $u['dst'] = $best; $used[$best] += $u['size']; $room[$best] -= $u['size']; }
            else { $nofit++; }
            $units[] = $u;
        }
    }
    usort($left, function ($a, $b) { return $b['size'] <=> $a['size']; });
    $note = $nofit ? $nofit . ' title(s) do not fit on the other disks and are not ticked.' : '';
    bl_plan_publish($units, $skipped, $disks, ['mode' => 'drain', 'drain' => $drain, 'target' => min(100, $T), 'avg' => $T, 'req' => null, 'note' => $note,
        'left' => array_slice($left, 0, 300), 'leftSize' => array_sum(array_column($left, 'size'))]);
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- REMOVE DISKS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/balance.php">
<INLINE><![CDATA[<?php
// Web endpoint of Diskbox Balance. POST op=state|saveconfig|plan|getplan|start|stop, rm_state|rm_check|rm_clear|rm_log|rm_reset (remove.php)
require_once __DIR__ . '/balance_lib.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function bl_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra), JSON_UNESCAPED_UNICODE); exit; }

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); bl_out(false, ['error' => 'method']); }
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); bl_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); bl_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}

function bl_spawn($mode) {
    $php = db_php();
    @exec('setsid nohup ' . escapeshellarg($php) . ' ' . escapeshellarg(__DIR__ . '/balance_run.php') . ' ' . $mode . ' >/dev/null 2>&1 &');
}

$op = (string)($_POST['op'] ?? 'state');

if ($op === 'state') {
    $plan = bl_json_read(BL_PLAN, ['state' => 'none']);
    unset($plan['units'], $plan['skipped']);
    $st = bl_json_read(BL_STATUS, ['state' => 'idle']);
    $running = bl_running();
    if (!$running && ($st['state'] ?? '') === 'running' && time() - (int)($st['started'] ?? 0) > 20) { $st['state'] = 'error'; $st['msg'] = 'The worker stopped unexpectedly.'; }
    bl_out(true, ['cfg' => bl_cfg(), 'disks' => array_values(bl_disks()), 'plan' => $plan, 'run' => $st, 'running' => $running, 'busy' => bl_busy_reason(),
                  'history' => is_file(BL_LOG) ? array_slice(preg_split('/\r?\n/', trim((string)@file_get_contents(BL_LOG))), -8) : []]);
}

if ($op === 'saveconfig') {
    $pairs = [];
    foreach (preg_split('/\r?\n/', (string)($_POST['pairs'] ?? '')) as $line) {
        $line = trim($line);
        if ($line === '') { continue; }
        $x = array_map('trim', explode('=', $line, 2));
        $dl = bl_path_ok($x[0]); $md = (($x[1] ?? '') === '') ? '' : bl_path_ok($x[1]);
        if ($dl === false || $md === false) { bl_out(false, ['error' => 'Invalid folder line: ' . $line . ' (use paths relative to the disk root, for example data/downloads/FILM = data/media/film)']); }
        $pairs[] = ['dl' => $dl, 'media' => $md];
    }
    if (!$pairs) { bl_out(false, ['error' => 'Enter at least one downloads folder.']); }
    $t = trim((string)($_POST['target'] ?? ''));
    if ($t !== '' && (!is_numeric($t) || $t < 5 || $t > 95)) { bl_out(false, ['error' => 'The target fill must be between 5 and 95 percent.']); }
    $all = bl_disks();
    $dis = [];
    foreach ((array)($_POST['disks'] ?? []) as $d) { if (is_string($d) && isset($all[$d])) { $dis[] = $d; } }
    $mode = in_array($_POST['mode'] ?? '', ['drain', 'remove'], true) ? (string)$_POST['mode'] : 'balance';
    $drn = [];
    foreach ((array)($_POST['drain'] ?? []) as $d) { if (is_string($d) && isset($all[$d]) && (!$dis || in_array($d, $dis, true))) { $drn[] = $d; } }
    if ($mode !== 'balance' && !$drn) { bl_out(false, ['error' => $mode === 'remove' ? 'Tick the disk(s) to remove.' : 'Tick the disk(s) to empty.']); }
    if ($mode !== 'balance' && count($drn) >= count($dis ?: $all)) { bl_out(false, ['error' => 'At least one included disk must stay to receive the data.']); }
    $c = ['pairs' => $pairs, 'target' => $t === '' ? '' : (string)(int)$t, 'strategy' => (($_POST['strategy'] ?? '') === 'big') ? 'big' : 'old', 'disks' => $dis, 'mode' => $mode, 'drain' => $drn];
    if (!bl_json_write(BL_CFG, $c, 0600)) { bl_out(false, ['error' => 'could not write the settings']); }
    bl_out(true);
}

if ($op === 'plan') {
    if (bl_running()) { bl_out(false, ['error' => 'A move is running.']); }
    $why = bl_busy_reason(true);
    if ($why !== '') { bl_out(false, ['error' => 'Cannot plan now: ' . $why . '.']); }
    $p = bl_json_read(BL_PLAN, []);
    if (($p['state'] ?? '') === 'running' && time() - (int)($p['t'] ?? 0) < 120) { bl_out(true); }
    if ((bl_cfg()['mode'] ?? '') === 'remove') { // Remove disks: emptying (step 3) only after the shares keep new files off them (step 2)
        require_once __DIR__ . '/remove.php';
        $sh = rm_shares(rm_sel());
        if ($sh) { bl_out(false, ['error' => 'Step 2 first: ' . implode(', ', array_column($sh, 0)) . ' can still write to the disks to remove.']); }
    }
    bl_plan_status('running', 'Starting...');
    bl_spawn('plan');
    bl_out(true);
}

if ($op === 'getplan') {
    $p = bl_json_read(BL_PLAN, ['state' => 'none']);
    bl_out(true, ['plan' => $p, 'busy' => bl_busy_reason()]);
}

if ($op === 'start') {
    if (bl_running()) { bl_out(false, ['error' => 'A move is already running.']); }
    $why = bl_busy_reason();
    if ($why !== '') { bl_out(false, ['error' => 'Cannot start: ' . $why . '.']); }
    $plan = bl_json_read(BL_PLAN, []);
    if (($plan['state'] ?? '') !== 'ready' || empty($plan['units'])) { bl_out(false, ['error' => 'Make a plan first.']); }
    $sel = json_decode((string)($_POST['sel'] ?? ''), true);
    if (!is_array($sel) || !$sel) { bl_out(false, ['error' => 'Nothing is selected.']); }
    $disks = bl_disks();
    $byId = [];
    foreach ($plan['units'] as $u) { $byId[$u['id']] = $u; }
    $items = []; $perDst = [];
    foreach ($sel as $id => $dst) {
        if (!isset($byId[$id]) || !is_string($dst) || !isset($disks[$dst]) || $dst === $byId[$id]['src'] || in_array($dst, (array)($plan['drain'] ?? []), true)) { bl_out(false, ['error' => 'Invalid selection.']); }
        $items[] = ['id' => (string)$id, 'dst' => $dst];
        $perDst[$dst] = ($perDst[$dst] ?? 0) + $byId[$id]['size'];
    }
    foreach ($perDst as $d => $b) {
        if ($b + max(5e9, 0.01 * $disks[$d]['size']) > $disks[$d]['free']) { bl_out(false, ['error' => strtoupper($d) . ' does not have enough free space for the selected titles.']); }
    }
    @unlink(BL_STATUS);
    bl_json_write(BL_JOB, ['items' => $items, 't' => time()], 0600);
    bl_json_write(BL_STATUS, ['state' => 'running', 'started' => time(), 'items' => [], 'log' => ['starting...'], 'total' => 0, 'done' => 0, 'cur' => -1, 'curBytes' => 0]);
    bl_spawn('run');
    bl_out(true);
}

if ($op === 'stop') {
    if (!bl_running()) { bl_out(true); }
    @file_put_contents(BL_STOP, '1');
    bl_out(true);
}

if (strpos($op, 'rm_') === 0) { require_once __DIR__ . '/remove.php'; rm_op($op); }

http_response_code(400);
bl_out(false, ['error' => 'unknown action']);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- BALANCE WORKER -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/remove.php">
<INLINE><![CDATA[<?php
// Diskbox Balance, third mode "Remove disks" (item 52): after the disks are chosen in the Setup, the steps are
// 2 shares keep new files off them (the owner changes the shares; this only checks), 3 empty them (the Empty disks plan),
// 4 check they are empty, 5 clear them (zeros through parity, both side by side), 6 New Config (the owner, in Unraid).
// Every step is a button and checks every step before it again on the server: nothing can be skipped.
require_once __DIR__ . '/balance_lib.php';

define('RM_STATE', dirname(BL_CFG) . '/remove.json');

function rm_ini($f, $sections) {
    $d = getenv('DBX_EMHTTP'); $d = ($d !== false && $d !== '') ? rtrim($d, '/') : '/var/local/emhttp';
    $x = @parse_ini_file($d . '/' . $f, $sections);
    return is_array($x) ? $x : [];
}

// the disks chosen in the Setup (Remove disks mode), only array data disks that exist
function rm_sel() {
    $c = bl_cfg();
    if (($c['mode'] ?? '') !== 'remove') { return []; }
    $ini = rm_ini('disks.ini', true); $out = [];
    foreach ((array)$c['drain'] as $n) { if (is_string($n) && preg_match('/^disk\d+$/', $n) && isset($ini[$n])) { $out[] = $n; } }
    return $out;
}

// '' = parity protects the array now; else why not. An empty parity slot (DISK_NP_DSBL, for example Parity 2 not used) is fine.
function rm_parity_reason() {
    $v = rm_ini('var.ini', false);
    if (($v['mdState'] ?? '') !== 'STARTED') { return 'the array is not started'; }
    if ((float)($v['mdResync'] ?? 0) > 0) { return 'a parity check or rebuild is running'; }
    $np = 0;
    foreach (rm_ini('disks.ini', true) as $k => $d) {
        if (!is_array($d) || (string)($d['device'] ?? '') === '') { continue; }
        $t = (string)($d['type'] ?? '');
        if ($t !== 'Parity' && $t !== 'Data') { continue; }
        if (($d['status'] ?? '') !== 'DISK_OK') { return strtoupper($k) . ' is not OK (' . ($d['status'] ?? '?') . ')'; }
        if ($t === 'Parity') { $np++; }
    }
    return $np ? '' : 'there is no parity disk';
}

// shares that may still write new files onto the chosen disks: [[share, [disks]]]. A share only on a pool (useCache=only)
// never writes to the array. Included/excluded disks of the share and the global share settings are both applied.
function rm_shares($sel) {
    $v = rm_ini('var.ini', false);
    $lst = function ($s) { return array_values(array_filter(array_map('trim', explode(',', (string)$s)))); };
    $gi = $lst($v['shareUserInclude'] ?? ''); $ge = $lst($v['shareUserExclude'] ?? '');
    $out = [];
    foreach (rm_ini('shares.ini', true) as $name => $s) {
        if (!is_array($s) || ($s['useCache'] ?? '') === 'only') { continue; }
        $in = $lst($s['include'] ?? ''); $ex = $lst($s['exclude'] ?? ''); $w = [];
        foreach ($sel as $d) {
            if (($in && !in_array($d, $in, true)) || in_array($d, $ex, true) || ($gi && !in_array($d, $gi, true)) || in_array($d, $ge, true)) { continue; }
            $w[] = $d;
        }
        if ($w) { $out[] = [(string)$name, $w]; }
    }
    return $out;
}

// what is still on a disk: every entry that is not a folder (files, links), hidden ones too. Empty folders do not count.
function rm_scan($disk) {
    $n = 0; $bytes = 0.0; $sample = [];
    $h = @popen('find ' . escapeshellarg(bl_mnt() . '/' . $disk) . ' -xdev -mindepth 1 ! -type d -printf ' . escapeshellarg('%s\t%P\0') . ' 2>/dev/null', 'r');
    if (!$h) { return ['n' => -1, 'bytes' => 0, 'sample' => []]; }
    $buf = '';
    while (!feof($h)) {
        $buf .= (string)fread($h, 65536);
        while (($p = strpos($buf, "\0")) !== false) {
            $rec = substr($buf, 0, $p); $buf = substr($buf, $p + 1);
            $f = explode("\t", $rec, 2); $n++; $bytes += (float)$f[0];
            if (count($sample) < 30) { $sample[] = $f[1] ?? ''; }
        }
    }
    pclose($h);
    return ['n' => $n, 'bytes' => $bytes, 'sample' => $sample];
}

function rm_dev($disk) {
    $n = (int)substr($disk, 4);
    foreach (['/dev/md' . $n . 'p1', '/dev/md' . $n] as $d) { if (@filetype($d) === 'block') { return $d; } }
    return '';
}

// everything the page shows; also the check every step makes before it acts
function rm_status() {
    $sel = rm_sel(); $st = bl_json_read(RM_STATE, []);
    if (($st['disks'] ?? null) !== $sel) { $st = ['disks' => $sel]; } // another choice of disks: the old check and clearing do not count
    $ini = rm_ini('disks.ini', true); $bd = bl_disks(); $z = db_zeroing(); $info = [];
    foreach ($sel as $d) {
        $zz = $z[$d] ?? null;
        $info[$d] = ['id' => (string)($ini[$d]['id'] ?? ''), 'present' => (string)($ini[$d]['device'] ?? '') !== '', 'mounted' => ($ini[$d]['fsStatus'] ?? '') === 'Mounted',
                     'used' => $bd[$d]['used'] ?? null, 'size' => (float)($ini[$d]['size'] ?? 0) * 1024,
                     'zero' => $zz ? ['run' => !empty($zz['running']), 'done' => !empty($zz['done']), 'pos' => $zz['pos'], 'size' => $zz['size'], 'rate' => $zz['rate']] : null];
    }
    $shares = $sel ? rm_shares($sel) : [];
    $chk = $st['check'] ?? null;
    $cleared = $sel && count(array_filter($info, function ($i) { return $i['zero'] && $i['zero']['done']; })) === count($sel);
    $gone = $sel && count(array_filter($info, function ($i) { return !$i['present']; })) === count($sel);
    return ['sel' => $sel, 'disks' => $info, 'parity' => rm_parity_reason(), 'busy' => bl_busy_reason(), 'balance' => bl_running(),
            'shares' => $shares, 'check' => $chk, 'clear' => $st['clear'] ?? null, 'cleared' => $cleared, 'gone' => $gone,
            'step' => !$sel ? 1 : ($shares ? 2 : (!($chk['ok'] ?? false) ? 3 : (!$cleared ? 5 : 6))), 'st' => $st];
}

function rm_op($op) {
    $s = rm_status(); $sel = $s['sel']; $st = $s['st']; unset($s['st']);
    if ($op === 'rm_state') { bl_out(true, ['rm' => $s]); }
    if (!$sel) { bl_out(false, ['error' => 'Choose Remove disks in the Setup and tick the disks first.']); }
    if ($op === 'rm_check') {
        if ($s['shares']) { bl_out(false, ['error' => 'Step 2 first: ' . count($s['shares']) . ' share(s) can still write to the disks.']); }
        if ($s['balance']) { bl_out(false, ['error' => 'A move is running; check when it has finished.']); }
        $res = []; $ok = true;
        foreach ($sel as $d) { $r = rm_scan($d); $res[$d] = $r; if ($r['n'] !== 0) { $ok = false; } }
        $st['check'] = ['t' => time(), 'ok' => $ok, 'res' => $res];
        bl_json_write(RM_STATE, $st, 0600);
        bl_out(true);
    }
    if ($op === 'rm_clear') {
        $want = implode(' ', $sel);
        if (trim(preg_replace('/\s+/', ' ', (string)($_POST['confirm'] ?? ''))) !== $want) { bl_out(false, ['error' => 'Type exactly: ' . $want]); }
        if ($s['parity'] !== '') { bl_out(false, ['error' => 'Cannot clear: ' . $s['parity'] . '.']); }
        if ($s['busy'] !== '') { bl_out(false, ['error' => 'Cannot clear: ' . $s['busy'] . '.']); }
        if ($s['balance']) { bl_out(false, ['error' => 'A move is running.']); }
        if ($s['shares']) { bl_out(false, ['error' => 'Step 2 first: a share can still write to the disks.']); }
        if (!($s['check']['ok'] ?? false)) { bl_out(false, ['error' => 'Step 4 first: check that the disks are empty.']); }
        foreach ($sel as $d) { // checked again now: something may have arrived since the check
            $r = rm_scan($d);
            if ($r['n'] !== 0) { $st['check'] = ['t' => time(), 'ok' => false, 'res' => [$d => $r]]; bl_json_write(RM_STATE, $st, 0600); bl_out(false, ['error' => strtoupper($d) . ' is not empty any more (' . $r['n'] . ' files). See step 4.']); }
            if (!$s['disks'][$d]['mounted']) { bl_out(false, ['error' => strtoupper($d) . ' is not mounted.']); }
            if ($s['disks'][$d]['zero'] && $s['disks'][$d]['zero']['run']) { bl_out(false, ['error' => strtoupper($d) . ' is being cleared already.']); }
            if (rm_dev($d) === '') { bl_out(false, ['error' => 'The parity-protected device of ' . strtoupper($d) . ' was not found.']); }
        }
        foreach ($sel as $d) {
            $n = (int)substr($d, 4); $dev = rm_dev($d); $mnt = bl_mnt() . '/' . $d; $img = '/tmp/xmini' . $n . '.img'; $log = '/tmp/dbx_clear_' . $n . '.log';
            // unmount; a small XFS image takes the mount point (Unraid 6.12+ cannot stop the array otherwise); then zeros through
            // the md device, so parity is updated and stays valid. dd ends with 'No space left on device' at the end: that is the normal end.
            $sh = 'exec >>' . escapeshellarg($log) . ' 2>&1; echo "start $(date)";'
                . ' umount ' . escapeshellarg($mnt) . ' || { echo "FAILED: could not unmount ' . $mnt . ', nothing was changed"; exit 1; };'
                . ' rm -f ' . escapeshellarg($img) . '; truncate -s 400M ' . escapeshellarg($img) . ' && mkfs.xfs -f -q ' . escapeshellarg($img)
                . ' && mount -o loop ' . escapeshellarg($img) . ' ' . escapeshellarg($mnt) . ' || { echo "FAILED: the stand-in image could not be mounted; the disk is unmounted, not cleared"; exit 1; };'
                . ' echo "writing zeros to ' . $dev . '"; dd if=/dev/zero of=' . escapeshellarg($dev) . ' bs=1M; echo "dd ended (exit $?) $(date)"';
            $tm = getenv('DBX_MNT');
            if ($tm !== false && $tm !== '') { @file_put_contents($log, "test mode, not run: " . $sh . "\n", FILE_APPEND); continue; } // tests: never run it
            @exec('setsid nohup /bin/bash -c ' . escapeshellarg($sh) . ' >/dev/null 2>&1 &');
        }
        $st['clear'] = ['t' => time(), 'disks' => $sel];
        bl_json_write(RM_STATE, $st, 0600);
        @file_put_contents(BL_LOG, date('Y-m-d H:i') . ' clearing started: ' . $want . "\n", FILE_APPEND);
        bl_out(true);
    }
    if ($op === 'rm_log') {
        $o = [];
        foreach ($sel as $d) { $f = '/tmp/dbx_clear_' . (int)substr($d, 4) . '.log'; $o[$d] = is_file($f) ? substr((string)@file_get_contents($f), -2000) : ''; }
        bl_out(true, ['log' => $o]);
    }
    if ($op === 'rm_reset') {
        foreach ($s['disks'] as $d => $i) { if ($i['zero'] && $i['zero']['run']) { bl_out(false, ['error' => 'A clearing is running.']); } }
        @unlink(RM_STATE);
        bl_out(true);
    }
    bl_out(false, ['error' => 'unknown action']);
}
]]></INLINE>
</FILE>

<!-- Permissions + done -->
<FILE Name="/tmp/&name;_finish.sh" Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
DIR="/usr/local/emhttp/plugins/diskbox"
chmod 644 "$DIR"/*.page "$DIR"/*.php "$DIR"/icon.png

# SMART collector: Unraid collects /boot/config/plugins/<name>/*.cron with update_cron.
PHPBIN="$(command -v php || echo /usr/bin/php)"
cat > /boot/config/plugins/diskbox/diskbox.cron <<CRON
# Diskbox: read SMART health every 20 minutes (spun down disks are skipped)
*/20 * * * * $PHPBIN /usr/local/emhttp/plugins/diskbox/smart.php >/dev/null 2>&1
# Diskbox: Discord alerts, checked every minute
* * * * * $PHPBIN /usr/local/emhttp/plugins/diskbox/notify.php >/dev/null 2>&1
# Diskbox: unassigned disks (SMART, self-test progress, Discord when a test ends), every 5 minutes
*/5 * * * * $PHPBIN /usr/local/emhttp/plugins/diskbox/unassigned.php >/dev/null 2>&1
# Diskbox: weekly summary, checked hourly (day and hour are settings)
7 * * * * $PHPBIN /usr/local/emhttp/plugins/diskbox/weekly.php >/dev/null 2>&1
CRON
# update_cron reads the plugin link in /var/log/plugins, which appears only after the install scripts
# have finished, so wait for it in the background.
nohup bash -c 'for i in $(seq 1 60); do [ -e /var/log/plugins/diskbox.plg ] && break; sleep 1; done; /usr/local/sbin/update_cron' >/dev/null 2>&1 &

# First SMART reading right away (in the background, can take a minute)
nohup "$PHPBIN" "$DIR/smart.php" >/dev/null 2>&1 &

# Updates come from GitHub (pluginURL): stop the local update server of earlier versions
pkill -f "php -S 127.0.0.1:18183" 2>/dev/null
rm -f /usr/local/emhttp/plugins/diskbox/repo.php
rm -f /tmp/diskbox_setup.sh /tmp/diskbox_finish.sh
echo ""
echo "----------------------------------------------------"
echo " Diskbox installed."
echo " Settings: Settings -> Utilities -> Diskbox"
echo " (or the gear icon on the dashboard tile)."
echo "----------------------------------------------------"
exit 0
]]></INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
rm -rf /usr/local/emhttp/plugins/diskbox
rm -rf /usr/local/emhttp/plugins/Diskbox
pkill -f "php -S 127.0.0.1:18183" 2>/dev/null
rm -f /tmp/diskbox_*
rm -f /boot/config/plugins/diskbox/diskbox.cron
/usr/local/sbin/update_cron 2>/dev/null
# Settings in /boot/config/plugins/diskbox are kept intentionally.
echo "diskbox removed."
exit 0
]]></INLINE>
</FILE>

</PLUGIN>
