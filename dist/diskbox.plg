  "note": "amber text next to the Move button when the move cannot start now ({why} like \"a parity check or rebuild is running\")."
 },
 "bal.pb_empty": {
  "text": "empty {d}",
  "note": "grey text on the right of the Plan band in the Empty disks mode ({d} disk names)."
 },
 "bal.pb_spread": {
  "text": "spread evenly",
  "note": "grey text on the right of the Plan band."
