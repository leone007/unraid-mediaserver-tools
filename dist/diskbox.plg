<script>
$(function () {
  var T = function (k, v) { return MTL.t('dbs', k, v); };
  var $tm = $('#dbx-tmsg');
  $.each({test: '#dbx-test', sample: '#dbx-sample', weekly: '#dbx-weekly'}, function (op, sel) {
    $(sel).on('click', function () {
      var $b = $(this).prop('disabled', true);
      $tm.css('color', '').text(T('set.sending'));
      $.post('/plugins/diskbox/test.php', {op: op}, null, 'json')
        .done(function (r) { if (r && r.ok) { $tm.css('color', '#3fa24a').text(T('set.sent')); } else { $tm.css('color', '#e5534b').text(T('set.not_sent', { e: (r && r.error) ? r.error : T('set.unknown_error') })); } })
        .fail(function (x) { var e = (x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : 'HTTP ' + x.status; $tm.css('color', '#e5534b').text(T('set.not_sent', { e: e })); })
        .always(function () { $b.prop('disabled', false); });
    });
  });
  $('.dbx-forget').on('click', function () {
    var $b = $(this).prop('disabled', true);
    $.post('/plugins/diskbox/ack.php', { name: $b.data('disk'), op: 'forget' }, null, 'json').always(function () { $b.closest('dd').prev('dt').remove(); $b.closest('dd').text(T('set.forgotten')); });
  });
  var $msg = $('#dbx-msg');
  $('#dbx-save').on('click', function () {
    var $b = $(this).prop('disabled', true);
    $msg.css('color', '').text(T('set.saving_s'));
    $.post('/plugins/diskbox/save.php', $('#dbx-form').serialize(), null, 'json')
      .done(function (r) {
        if (r && r.ok) {
          $msg.css('color', '#3fa24a').text(T('set.saved'));
        } else {
          $msg.css('color', '#e5534b').text(T('set.not_saved', { e: (r && r.error) ? r.error : T('set.unknown_error') }));
        }
      })
      .fail(function (x) {
        var e = (x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : 'HTTP ' + x.status;
        $msg.css('color', '#e5534b').text(T('set.not_saved', { e: e }));
      })
      .always(function () { $b.prop('disabled', false); });
  });
});
</script>
]]></INLINE>
