 },
 "bal.strat.big": {
  "text": "A legnagyobbak előbb"
 },
 "bal.f.drain_hint": {
  "text": "A fenti mappákban minden átkerül a többi bevont lemezre: a címek a hardlinkjeikkel, a letöltés nélküli médiafájlok (.nfo, képek, feliratok is) és a Seedbox kukájának tartalma (.seedbox_trash). A terv felsorolja, mi maradna még a lemezen, így látod, kivehető-e a tömbből."
 },
 "bal.btn.plan": {
  "text": "Terv készítése"
 },
 "rm.h2": {
  "text": "Ne kerüljön rájuk új fájl"
 },
 "rm.s2": {
  "text": "Módosítsd az itt felsorolt összes megosztást a <a href=\"/Shares\">Shares</a> oldalon: tedd a lemezeket az <b>Excluded disk(s)</b> közé (vagy vedd ki őket az Included disk(s) közül). A Diskbox csak ellenőriz, megosztást nem módosít."
 },
 "rm.btn.check_again": {
  "text": "Újraellenőrzés"
 },
 "rm.h3": {
  "text": "Kiürítés"
 },
 "rm.s3": {
  "text": "Készíts tervet a fenti Beállításban: a terv (lent) mindent átvisz a Beállítás mappáiból a többi lemezre, utána nyomd meg az Áthelyezés gombot. Amit nem figyel (például az appdata), az a terv alatt látszik; azt helyezd át magad."
 },
 "rm.h4": {
  "text": "Üresek-e?"
 },
 "rm.s4": {
  "text": "Felsorol minden fájlt, ami még a lemezeken van, a rejtetteket is (az üres mappák nem számítanak). Kinullázni csak akkor lehet, ha semmi sem maradt."
 },
 "rm.btn.check": {
  "text": "Lemezek ellenőrzése"
 },
 "rm.h5": {
  "text": "Kinullázás"
 },
 "rm.s5": {
  "text": "Minden lemezt lecsatol, és a paritáson keresztül (párhuzamosan) nullákkal tölt fel, így a paritás nélküle is érvényes marad: kb. 7 óra TB-onként. <b>Ez mindent letöröl a lemezről.</b> Ha közben leáll a szerver, újraindítás után az Unraid Unmountable állapotúnak mutatja a lemezt: <b>ne</b> formázd meg, indítsd újra itt a kinullázást."
 },
 "rm.h6": {
  "text": "Kivétel a tömbből"
 },
 "bal.h.plan": {
  "text": "Terv"
 },
 "bal.legend": {
  "text": "kék = mostani telítettség · zöld = a kipipált áthelyezések után (sárga: nő, piros: majdnem tele) · szürke csíkos = a fájlrendszer saját helye egy kiürítendő lemezen (metaadat, nem adat; a lemezzel együtt megy) · a narancs jel a cél"
 },
