<!-- ========================================================= -->
<!-- LIBRARY -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/lib.php">
<INLINE><![CDATA[<?php
// Diskbox helpers: settings, Unraid state files, thresholds.
const DB_CFG = '/boot/config/plugins/diskbox/settings.cfg';
const DB_SMART = '/tmp/diskbox_smart.json';

function db_cfg() {
    $c = ['warn_use' => '', 'crit_use' => '', 'hot_temp' => '', 'max_temp' => '', 'smart' => '1',
          'dc_hook' => '', 'dc_lang' => 'hu', 'dc_ping' => '', 'n_array' => '1', 'n_temp' => '1', 'n_smart' => '1', 'n_fill' => '1', 'n_fill_warn' => '85', 'n_fill_crit' => '95',
          'n_pool' => '1', 'n_parity' => '1', 'n_utest' => '1', 'n_remind' => '24', 'wk_on' => '1', 'wk_day' => '7', 'wk_hour' => '18'];
    if (is_file(DB_CFG)) {
        $x = @parse_ini_file(DB_CFG);
        if (is_array($x)) { $c = array_merge($c, $x); }
    }
    return $c;
}

function db_on($v) { return !in_array(strtolower(trim((string)$v)), ['0', 'no', 'false', 'off', ''], true); }

function db_disks() {
    $ini = @parse_ini_file('/var/local/emhttp/disks.ini', true);
    $out = [];
    if (!is_array($ini)) { return $out; }
    foreach ($ini as $k => $d) {
        if (is_array($d)) { $out[trim((string)$k, '"')] = $d; }
    }
    return $out;
}

function db_var() {
    $v = @parse_ini_file('/var/local/emhttp/var.ini');
    return is_array($v) ? $v : [];
}

// What a running resync does and which disks it works on, from mdResyncAction ("check P Q", "recon Q", "recon D1",
// "recon P D2", "clear"): kind = check | sync (only parity disks are built) | rebuild (a data disk is rebuilt) | clear
function db_resync_kind($act) {
    $w = preg_split('/\s+/', trim((string)$act));
    $t = [];
    foreach (array_slice($w, 1) as $x) {
        if ($x === 'P') { $t[] = 'parity'; }
        elseif ($x === 'Q') { $t[] = 'parity2'; }
        elseif (preg_match('/^D(\d+)$/', $x, $m)) { $t[] = 'disk' . $m[1]; }
    }
    $a = (string)($w[0] ?? '');
    if (strpos($a, 'clear') === 0) { $kind = 'clear'; }
    elseif (strpos($a, 'recon') === 0) {
        $kind = 'sync';
        foreach ($t as $n) { if (strpos($n, 'parity') !== 0) { $kind = 'rebuild'; } }
        if (!$t) { $kind = 'rebuild'; }
    } else { $kind = 'check'; }
    return [$kind, $t];
}

// A slot counts as used when a disk is (or was) assigned to it
function db_assigned($d) {
    return trim((string)($d['idSb'] ?? '')) !== '' || trim((string)($d['id'] ?? '')) !== '';
}

// Thresholds: the page's own overrides first, then Unraid's display settings, then defaults. 0 = off.
function db_thr($cfg) {
    $d = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true);
    $disp = (is_array($d) && isset($d['display']) && is_array($d['display'])) ? $d['display'] : [];
    $pick = function ($mine, $key, $def) use ($disp) {
        $m = trim((string)$mine);
        if ($m !== '' && is_numeric($m)) { $v = (float)$m; }
        else { $u = $disp[$key] ?? ''; $v = is_numeric($u) ? (float)$u : (float)$def; }
        return $v;
    };
    return [
        'warn'   => $pick($cfg['warn_use'], 'warning', 70),
        'crit'   => $pick($cfg['crit_use'], 'critical', 90),
        'hot'    => $pick($cfg['hot_temp'], 'hot', 45),
        'max'    => $pick($cfg['max_temp'], 'max', 55),
        'hotssd' => $pick('', 'hotssd', 60),
        'maxssd' => $pick('', 'maxssd', 70),
    ];
}

function db_smart() {
    if (!is_file(DB_SMART)) { return []; }
    $j = json_decode((string)@file_get_contents(DB_SMART), true);
    return (is_array($j) && isset($j['disks']) && is_array($j['disks'])) ? $j['disks'] : [];
}

// ---- acknowledged SMART warnings -------------------------------------------------------------------
const DB_ACK = '/boot/config/plugins/diskbox/ack.json';

function db_ack() {
    $j = is_file(DB_ACK) ? json_decode((string)@file_get_contents(DB_ACK), true) : null;
    return is_array($j) ? $j : [];
}

function db_ack_write($ack) {
    $dir = dirname(DB_ACK);
    if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
    $tmp = DB_ACK . '.tmp';
    if (@file_put_contents($tmp, json_encode($ack)) === false) { return false; }
    if (!@rename($tmp, DB_ACK)) { @file_put_contents(DB_ACK, json_encode($ack)); @unlink($tmp); }
    @chmod(DB_ACK, 0600);
    return true;
}

// SMART problems of one disk that still count: an acknowledged attribute counts again only when its raw value rises
// above what it was when it was acknowledged. A failed health check cannot be acknowledged.
// Returns ['attrs' => [[id, name, prefail, raw, value, worst, thresh, failed, ackedRaw|null], ...], 'nvme' => [text, ...], 'health' => bool, 'hidden' => int]
function db_smart_issues($name, $s, $ack) {
    $out = ['attrs' => [], 'nvme' => [], 'health' => false, 'hidden' => 0];
    if (!is_array($s)) { return $out; }
    $a = $ack[$name] ?? null;
    $araw = (is_array($a) && isset($a['raw']) && is_array($a['raw'])) ? $a['raw'] : [];
    foreach ($s['attrs'] ?? [] as $x) {
        $id = (string)$x[0];
        $base = array_key_exists($id, $araw) ? (int)$araw[$id] : null;
        if ($base === null || (int)$x[3] > $base) { $x[8] = $base; $out['attrs'][] = $x; } else { $out['hidden']++; }
    }
    $an = (is_array($a) && isset($a['nvme']) && is_array($a['nvme'])) ? $a['nvme'] : [];
    $chk = function ($key, $val, $min, $label) use (&$out, $an) {
        if ($val >= $min && ($val > (int)($an[$key] ?? ($min - 1)))) { $out['nvme'][] = $label . ': ' . $val; } elseif ($val >= $min) { $out['hidden']++; }
    };
    $chk('warn', (int)($s['nvme_warn'] ?? 0), 1, 'critical_warning');
    $chk('media', (int)($s['nvme_media'] ?? 0), 1, 'media_errors');
    $chk('used', (int)($s['nvme_used'] ?? 0), 90, 'percentage_used');
    if (array_key_exists('ok', $s) && $s['ok'] === false) { $out['health'] = true; }
    return $out;
}

// The command line PHP (PHP_BINARY is php-fpm when this runs inside the web server)
function db_php() { return is_executable('/usr/bin/php') ? '/usr/bin/php' : 'php'; }

// ---- array disks being zeroed for removal (dd onto /dev/mdNp1), read only from /proc ------------
// Progress = write position of dd's output descriptor; speed from the previous sample. Read-only: nothing is started here.
// Is the rest of a zeroing run really zero? Reads 1 MiB at three places of the part after the last sample (its start, its middle,
// the end of the device). true = all zero, false = data found, null = could not read (checked again at the next refresh)
function db_zero_check($dev, $last, $size) {
    $f = @fopen($dev, 'rb'); if (!$f) { return null; }
    $mb = 1048576; $ok = true;
    foreach ([$last, $last + ($size - $last) / 2, $size - $mb] as $at) {
        $at = max(0, min($size - $mb, floor($at / 4096) * 4096));
        if (@fseek($f, (int)$at) !== 0) { fclose($f); return null; }
        $b = @fread($f, $mb);
        if ($b === false || strlen($b) !== $mb) { fclose($f); return null; }
        if (trim($b, "\0") !== '') { $ok = false; break; }
    }
    fclose($f);
    return $ok;
}
function db_zeroing($procDir = '/proc', $sysDir = '/sys/class/block', $state = '/tmp/diskbox_zero.json', $devDir = '/dev') {
    $now = microtime(true);
    $prev = @json_decode((string)@file_get_contents($state), true); if (!is_array($prev)) { $prev = []; }
    $out = []; $seen = [];
    foreach ((array)@glob($procDir . '/[0-9]*', GLOB_ONLYDIR) as $pd) {
        $cmd = (string)@file_get_contents($pd . '/cmdline');
        if ($cmd === '' || strpos($cmd, 'dd') === false) { continue; }
        $args = explode("\0", rtrim($cmd, "\0"));
        if (basename((string)$args[0]) !== 'dd') { continue; }
        $of = ''; foreach ($args as $a) { if (strpos($a, 'of=') === 0) { $of = substr($a, 3); } }
        if (!preg_match('#^/dev/md(\d+)(p1)?$#', $of, $m)) { continue; }
        $name = 'disk' . (int)$m[1]; $blk = 'md' . (int)$m[1] . (isset($m[2]) ? 'p1' : '');
        $pos = null;
        foreach ((array)@glob($pd . '/fd/*') as $fd) {
            if (@readlink($fd) === $of && preg_match('/^pos:\s+(\d+)/m', (string)@file_get_contents($pd . '/fdinfo/' . basename($fd)), $mm)) { $pos = (float)$mm[1]; }
        }
        if ($pos === null) { continue; }
        $size = (float)@file_get_contents($sysDir . '/' . $blk . '/size') * 512;
        $rate = 0.0; $p = $prev[$name] ?? null;
        if (is_array($p) && $now - (float)$p['t'] >= 3 && $pos >= (float)$p['pos']) { $rate = ($pos - (float)$p['pos']) / ($now - (float)$p['t']); }
        elseif (is_array($p) && isset($p['rate'])) { $rate = (float)$p['rate']; }
        $keep = (is_array($p) && $now - (float)$p['t'] < 3) ? $p : ['t' => $now, 'pos' => $pos];
        $seen[$name] = array_merge(['t' => $keep['t'], 'pos' => $keep['pos']], ['rate' => $rate, 'size' => $size, 'last' => $pos, 'lt' => $now, 'blk' => $blk]);
        $out[$name] = ['running' => true, 'pos' => $pos, 'size' => $size, 'rate' => $rate];
    }
    // a finished run: dd is gone, the last position reached the end of the device. The last sample is taken at a widget
    // refresh, so it can stop short of the end: from 99 % on, the rest is checked once by reading it (see db_zero_check)
    foreach ($prev as $name => $p) {
        if (isset($seen[$name]) || !is_array($p)) { continue; }
        if ($now - (float)($p['lt'] ?? 0) > 7 * 86400) { continue; }
        $n = (int)substr($name, 4); $blk = (string)($p['blk'] ?? (is_dir($sysDir . '/md' . $n . 'p1') ? 'md' . $n . 'p1' : 'md' . $n));
        $cur = (float)@file_get_contents($sysDir . '/' . $blk . '/size') * 512;
        if ($cur <= 0 || abs($cur - (float)($p['size'] ?? 0)) > 0) { continue; } // the disk is gone or another disk is in its slot: forget it
        $size = (float)$p['size']; $last = (float)($p['last'] ?? 0);
        $done = $last >= $size - 1048576;
        if (!$done && $last >= $size * 0.99) {
            if (!isset($p['vfy'])) { $p['vfy'] = db_zero_check($devDir . '/' . $blk, $last, $size); }
            $done = $p['vfy'] === true;
        }
        $p['blk'] = $blk;
        $seen[$name] = $p;
        $out[$name] = ['running' => false, 'pos' => (float)($p['last'] ?? 0), 'size' => (float)($p['size'] ?? 0), 'rate' => 0.0, 'done' => $done];
    }
    if ($seen || $prev) { @file_put_contents($state, json_encode($seen)); }
    return $out;
}

// ---- unassigned disks (item 58) ------------------------------------------------------------------------
// unassigned.php (cron) reads every unassigned disk with smartctl into DB_UA; api_fetch.php shows them in their own band.
const DB_UA = '/tmp/diskbox_ua.json';

function db_devs() {
    $ini = @parse_ini_file('/var/local/emhttp/devs.ini', true);
    $out = [];
    if (!is_array($ini)) { return $out; }
    foreach ($ini as $k => $d) { if (is_array($d) && !empty($d['device'])) { $out[$k] = $d; } }
    return $out;
}

// UD Preclear (unassigned.devices.preclear) of an unassigned disk: its status file /tmp/preclear/preclear_stat_<sdX> holds
// "sdX|NN|text|pid"; the run is alive while /proc/<pid> exists. Progress text: "Zeroing: 34% @ 190 MB/s (1:02:03)", with
// " (1 of 2)" after the step name for more cycles. Steps skipped by --skip-preread / --skip-postread are read from its
// command line. Read-only. Returns null when the disk has no preclear status.
function db_preclear($dev, $dir = '/tmp/preclear', $proc = '/proc') {
    $f = $dir . '/preclear_stat_' . preg_replace('/[^A-Za-z0-9]/', '', (string)$dev);
    if (!is_file($f)) { return null; }
    $p = explode('|', trim((string)@file_get_contents($f)));
    if (count($p) < 3) { return null; }
    $text = trim($p[2]); $pid = (int)($p[3] ?? 0);
    $run = $pid > 0 && is_dir($proc . '/' . $pid);
    $o = ['run' => $run, 'text' => $text, 't' => (int)@filemtime($f), 'step' => '', 'pct' => null, 'speed' => null, 'elapsed' => '',
          'paused' => false, 'n' => 0, 'of' => 0, 'fail' => (bool)preg_match('/failed|FAIL|Error|error|Aborted/', $text),
          'done' => (bool)preg_match('/Finished Successfully|Precleared!|verification successful/i', $text)];
    if (preg_match('/^(Pre-Read|Post-Read|Verify Zeroing|Zeroing|Erasing)(?: \(\d+ of \d+\))?: (?:(\d+)% @ (\d+) MB\/s \(([^)]*)\)|(PAUSED|QUEUED))/', $text, $m)) {
        $o['step'] = $m[1];
        if (($m[5] ?? '') !== '') { $o['paused'] = true; } else { $o['pct'] = (int)$m[2]; $o['speed'] = (int)$m[3]; $o['elapsed'] = $m[4]; }
    }
    if ($run && $o['step'] !== '') {
        $cl = str_replace("\0", ' ', (string)@file_get_contents($proc . '/' . $pid . '/cmdline'));
        $steps = array_values(array_filter([strpos($cl, '--skip-preread') === false ? 'Pre-Read' : '', 'Zeroing', strpos($cl, '--skip-postread') === false ? 'Post-Read' : '']));
        $i = array_search($o['step'], $steps, true);
        if ($i !== false) { $o['n'] = $i + 1; $o['of'] = count($steps); }
    }
    return $o;
}
// "1:02:03" or "62:03" -> seconds
function db_hms($s) { $x = array_map('intval', explode(':', (string)$s)); $t = 0; foreach ($x as $v) { $t = $t * 60 + $v; } return $t; }

function db_ua() {
    $j = is_file(DB_UA) ? json_decode((string)@file_get_contents(DB_UA), true) : null;
    return (is_array($j) && isset($j['disks']) && is_array($j['disks'])) ? $j['disks'] : [];
}

// One disk from `smartctl -j -i -H -A -c -l selftest`: identity, health (same attribute rules as smart.php) and the self-test:
// test.run with the % left while one runs, last = the newest finished test of the log (passed / aborted / failed).
function db_ua_entry($j) {
    if (!is_array($j) || empty($j['serial_number'])) { return null; }
    // the model as people know it: 'WDC WD180EDGZ-11B2DA0' -> 'WD180EDGZ'
    $model = trim((string)($j['model_name'] ?? ($j['model_family'] ?? '?')));
    $model = preg_replace('/^WDC[ _]/', '', $model);
    if (preg_match('/^(WD\w+?)-\w+$/', $model, $m)) { $model = $m[1]; }
    $e = ['t' => time(), 'model' => $model, 'serial' => (string)$j['serial_number'],
          'bytes' => (float)($j['user_capacity']['bytes'] ?? 0), 'hours' => isset($j['power_on_time']['hours']) ? (int)$j['power_on_time']['hours'] : null,
          'temp' => isset($j['temperature']['current']) ? (int)$j['temperature']['current'] : null,
          'ok' => isset($j['smart_status']['passed']) ? (bool)$j['smart_status']['passed'] : null, 'attrs' => [], 'test' => null, 'last' => null];
    foreach ((array)($j['ata_smart_attributes']['table'] ?? []) as $a) {
        $id = (int)($a['id'] ?? 0); $raw = (int)($a['raw']['value'] ?? 0);
        if ($id === 5)   { $e['realloc'] = $raw; }
        if ($id === 197) { $e['pending'] = $raw; }
        if ($id === 198) { $e['uncorr'] = $raw; }
        $wf = trim((string)($a['when_failed'] ?? ''));
        $failed = ($wf !== '' && $wf !== '-');
        if ($failed || ($raw > 0 && in_array($id, [5, 10, 184, 187, 196, 197, 198, 199], true))) {
            $e['attrs'][] = [$id, (string)($a['name'] ?? ('attr ' . $id)), !empty($a['flags']['prefail']), $raw,
                             (int)($a['value'] ?? 0), (int)($a['worst'] ?? 0), (int)($a['thresh'] ?? 0), $failed];
        }
    }
    $sv = $j['ata_smart_data']['self_test']['status']['value'] ?? null;
    if ($sv !== null && ((int)$sv >> 4) === 15) {
        $left = $j['ata_smart_data']['self_test']['status']['remaining_percent'] ?? (((int)$sv & 15) * 10);
        $e['test'] = ['run' => true, 'left' => (int)$left];
    }
    foreach ((array)($j['ata_smart_self_test_log']['standard']['table'] ?? []) as $t) {
        $v = (int)($t['status']['value'] ?? -1);
        if (($v >> 4) === 15) { continue; }   // the running one
        $kind = ($v >> 4) === 0 ? 'passed' : ((($v >> 4) === 1 || ($v >> 4) === 2) ? 'aborted' : 'failed');
        $type = (string)($t['type']['string'] ?? '');
        $e['last'] = ['status' => $kind, 'text' => (string)($t['status']['string'] ?? ''), 'type' => stripos($type, 'extended') !== false ? 'extended' : (stripos($type, 'short') !== false ? 'short' : strtolower($type)),
                      'hours' => isset($t['lifetime_hours']) ? (int)$t['lifetime_hours'] : null, 'left' => isset($t['status']['remaining_percent']) ? (int)$t['status']['remaining_percent'] : (isset($t['remaining_percent']) ? (int)$t['remaining_percent'] : null)];
        break;
    }
    return $e;
}

]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DATA ENDPOINT -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/api_fetch.php">
<INLINE><![CDATA[<?php
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/i18n.php';
$dbx_T = mt_i18n_t(__DIR__ . '/lang');   // texts shown on the tile (lang/en.json)
header('Content-Type: application/json');
header('Cache-Control: no-store');

function db_out($d) { echo json_encode($d, JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE); exit; }

function db_zero_text($z) {
    global $dbx_T;
    $pct = $z['size'] > 0 ? min(100, $z['pos'] / $z['size'] * 100) : 0;
    if (!$z['running']) { return !empty($z['done']) ? $dbx_T('sub.zeroed') : $dbx_T('sub.zero_stopped', ['p' => number_format($pct, 1)]); }
    $t = $dbx_T('sub.zeroing', ['p' => number_format($pct, 1)]);
    if ($z['rate'] > 0) {
        $left = ($z['size'] - $z['pos']) / $z['rate']; $h = (int)floor($left / 3600); $mi = (int)ceil(($left - $h * 3600) / 60);
        $t .= ' · ' . db_rate($z['rate']) . ' · ' . $dbx_T('time.left', ['t' => ($h ? $h . ' h ' . $mi . ' m' : max(1, $mi) . ' m')]);
    }
    return $t;
}

// ---- I/O rates from /proc/diskstats, between two requests ------------------------------------
function db_io_rates() {
    $now = microtime(true);
    $cur = [];
    foreach ((array)@file('/proc/diskstats', FILE_IGNORE_NEW_LINES) as $l) {
        $p = preg_split('/\s+/', trim((string)$l));
        if (count($p) >= 10) { $cur[$p[2]] = [(float)$p[5], (float)$p[9]]; }   // sectors read / written
    }
    $f = '/tmp/diskbox_io.json';
    $prev = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null;
    $rates = (is_array($prev) && isset($prev['rates'])) ? $prev['rates'] : [];
    $save = false;
    if (is_array($prev) && isset($prev['t'], $prev['d'])) {
        $dt = $now - (float)$prev['t'];
        if ($dt >= 2.0) {
            $rates = [];
            foreach ($cur as $n => $c) {
                if (isset($prev['d'][$n])) {
                    $rates[$n] = [max(0.0, ($c[0] - $prev['d'][$n][0]) * 512 / $dt), max(0.0, ($c[1] - $prev['d'][$n][1]) * 512 / $dt)];
                }
            }
            $save = true;
        }
    } else { $save = true; }
    if ($save) { @file_put_contents($f, json_encode(['t' => $now, 'd' => $cur, 'rates' => $rates])); }
    return $rates;
}

function db_rate($b) {
    if ($b >= 1e6) { return number_format($b / 1e6, $b >= 1e8 ? 0 : 1, '.', '') . ' MB/s'; }
    return max(1, (int)round($b / 1e3)) . ' KB/s';
}

// ---- ZFS pool health, cached for a minute -----------------------------------------------------
function db_zpool() {
    $f = '/tmp/diskbox_zpool.json';
    if (is_file($f) && (time() - filemtime($f)) < 60) {
        $j = json_decode((string)@file_get_contents($f), true);
        if (is_array($j)) { return $j; }
    }
    $out = [];
    $lines = [];
    @exec('zpool list -H -o name,health 2>/dev/null', $lines);
    foreach ($lines as $l) {
        $p = preg_split('/\s+/', trim($l));
        if (count($p) >= 2) { $out[$p[0]] = $p[1]; }
    }
    @file_put_contents($f, json_encode($out));
    return $out;
}

function db_state($status) {
    if ($status === 'DISK_OK') { return 'ok'; }
    if ($status === 'DISK_DSBL' || $status === 'DISK_DSBL_NEW') { return 'disabled'; }
    if ($status === 'DISK_NP_DSBL' || $status === 'DISK_NP_MISSING') { return 'missing'; }
    if ($status === 'DISK_NEW') { return 'new'; }
    return 'invalid';
}

function db_tlevel($temp, $ssd, $thr) {
    if ($temp === null) { return 'mu'; }
    $hot = $ssd ? $thr['hotssd'] : $thr['hot'];
    $max = $ssd ? $thr['maxssd'] : $thr['max'];
    if ($max > 0 && $temp >= $max) { return 'rd'; }
    if ($hot > 0 && $temp >= $hot) { return 'a'; }
    return 'g';
}

function db_health($name, $label, $d, $smart, &$attn) {
    global $dbx_T;
    $lvl = 'unk';
    $title = $dbx_T('health.unknown');
    $s = $smart[$name] ?? null;
    if (is_array($s)) {
        $lvl = 'ok';
        $title = $dbx_T('health.passed');
        $iss = db_smart_issues($name, $s, $GLOBALS['dbx_ack']);
        $w = [];
        foreach ($iss['attrs'] as $x) { $w[] = $x[0] . ' ' . $x[1] . ': ' . $x[3]; }
        foreach ($iss['nvme'] as $x) { $w[] = $x; }
        $failedAttr = false;
        foreach ($iss['attrs'] as $x) { if ($x[7]) { $failedAttr = true; } }
        if ($iss['health']) {
            $lvl = 'rd'; $title = $dbx_T('health.failed');
            $attn[] = ['rd', $label, $dbx_T('health.failed'), '', ''];
        } elseif ($w) {
            $lvl = $failedAttr ? 'rd' : 'a'; $title = implode(', ', $w);
            $attn[] = [$lvl, $label, $failedAttr ? $dbx_T('attn.smart_failing') : $dbx_T('attn.smart_warning'), implode(' · ', array_slice($w, 0, 2)), $name];
        } elseif ($iss['hidden'] > 0) {
            $title = $dbx_T('health.acked');
        }
    }
    $errs = (int)($d['numErrors'] ?? 0);
    if ($errs > 0 && $lvl !== 'rd') {
        $lvl = 'a';
        $title = $dbx_T('health.errors', ['n' => $errs]);
        $attn[] = ['a', $label, $dbx_T('health.errors', ['n' => $errs]), ''];
    }
    return [$lvl, $title];
}

function db_row($name, $d, $kind, $rates, $smart, $thr, $started, &$attn, $zero = []) {
    global $dbx_T;
    $label = strtoupper($name);
    $dev = (string)($d['device'] ?? '');
    $spun = (($d['spundown'] ?? '0') === '1');
    $temp = is_numeric($d['temp'] ?? '') ? (int)$d['temp'] : null;
    $ssd = (($d['rotational'] ?? '1') === '0');
    $state = db_state((string)($d['status'] ?? ''));
    $emul = ($kind === 'data' && ($state === 'disabled' || $state === 'missing'));

    // usage
    $fsSize = (float)($d['fsSize'] ?? 0) * 1024;
    $fsUsed = (float)($d['fsUsed'] ?? 0) * 1024;
    $size = $fsSize > 0 ? $fsSize : (float)($d['size'] ?? 0) * 1024;
    $used = null; $pct = null; $ulevel = '';
    if ($kind !== 'parity' && $fsSize > 0) {
        $used = $fsUsed;
        $pct = $fsUsed / $fsSize * 100;
        if ($thr['crit'] > 0 && $pct >= $thr['crit']) { $ulevel = 'rd'; }
        elseif ($thr['warn'] > 0 && $pct >= $thr['warn']) { $ulevel = 'a'; }
        if ($ulevel !== '') { $attn[] = [$ulevel, $label, $dbx_T('attn.full', ['p' => number_format($pct, 1)]), ($fsSize - $fsUsed) > 0 ? '@FREE@' . ($fsSize - $fsUsed) : '']; }
    }

    // activity text
    $io = $dbx_T('sub.idle');
    if (isset($rates[$dev])) {
        $r = $rates[$dev];
        $parts = [];
        if ($r[0] >= 1024) { $parts[] = $dbx_T('sub.reading', ['r' => db_rate($r[0])]); }
        if ($r[1] >= 1024) { $parts[] = $dbx_T('sub.writing', ['r' => db_rate($r[1])]); }
        if ($parts) { $io = implode(' · ', $parts); }
    }
    if ($state !== 'ok') {
        $sub = ($kind === 'data') ? ($state === 'new' ? $dbx_T('sub.new') : ($state === 'invalid' ? $dbx_T('sub.invalid') : $dbx_T('sub.emulated'))) : ($state === 'new' ? $dbx_T('sub.new') : ($state === 'missing' ? $dbx_T('sub.missing') : ($state === 'invalid' ? $dbx_T('sub.invalid') : $dbx_T('sub.disabled'))));
    } elseif ($started && $kind === 'data' && ($d['fsStatus'] ?? 'Mounted') !== 'Mounted' && ($d['fsStatus'] ?? '') !== '') {
        $sub = $dbx_T('sub.unmountable');
        $attn[] = ['rd', $label, $dbx_T('attn.unmountable'), (string)$d['fsStatus']];
    } else {
        $sub = $spun ? $dbx_T('sub.spun_down') : $io;
        if ($kind === 'parity') { $sub = $dbx_T('sub.valid') . ' · ' . $sub; }
    }
    // a disk being zeroed for removal: its progress replaces the activity text and the usage bar
    $z = ($kind === 'data') ? ($zero[$name] ?? null) : null;
    if ($z) { $sub = db_zero_text($z); $used = $z['pos']; if ($z['size'] > 0) { $size = $z['size']; } /* the device, not the stand-in image mounted on it */ $pct = $z['size'] > 0 ? min(100, $z['pos'] / $z['size'] * 100) : 0; $ulevel = ''; }
    $tlevel = db_tlevel($temp, $ssd, $thr);
    if ($temp !== null && ($tlevel === 'rd' || $tlevel === 'a')) {
        $attn[] = [$tlevel, $label, $tlevel === 'rd' ? $dbx_T('attn.too_hot') : $dbx_T('attn.hot'), $temp . '°C'];
    }
    if ($emul) { $attn[] = ['rd', $label, $dbx_T('attn.emulated'), $dbx_T('attn.emulated_why')]; }
    elseif ($state === 'invalid') { $attn[] = ['rd', $label, $dbx_T('attn.invalid'), (string)($d['status'] ?? '')]; }

    list($hl, $ht) = db_health($name, $label, $d, $smart, $attn);
    $hsmart = [$hl, $ht]; // the SMART result alone, shown again while the disk is being built
    if ($emul || $state === 'invalid') { $hl = 'rd'; $ht = $sub; }
    if ($state === 'missing' || $state === 'disabled') { $hl = 'rd'; $ht = $sub; }

    return [
        'name' => $name, 'label' => $label, 'kind' => $kind, 'state' => $state, 'emulated' => $emul,
        'dot' => ($state !== 'ok' && $state !== 'new') ? 'rd' : ($spun ? 'off' : 'on'),
        'sub' => $sub, 'fs' => strtoupper((string)($d['fsType'] ?? '')),
        'size' => $size, 'used' => $used, 'pct' => $pct, 'ulevel' => $ulevel, 'zero' => $z ? ($z['running'] ? 'run' : (!empty($z['done']) ? 'done' : 'stop')) : '', 'devices' => max(1, (int)($d['devices'] ?? 1)),
        'temp' => $temp, 'tlevel' => $tlevel, 'health' => [$hl, $ht], 'hsmart' => $hsmart,
        'link' => '/Main/Device?name=' . rawurlencode($name),
    ];
}

// ---- main -------------------------------------------------------------------------------------
$cfg = db_cfg();
$thr = db_thr($cfg);
$disks = db_disks();
$var = db_var();
if (!$disks) { db_out(['ok' => false, 'error' => 'nodata']); }

$started = (($var['mdState'] ?? '') === 'STARTED');
$rates = db_io_rates();
$smart = db_smart();
$zp = db_zpool();
$attn = [];
$dbx_ack = db_ack();

$parityRows = []; $dataRows = []; $pools = [];
$parityAssigned = 0; $parityOk = 0; $emulated = 0; $invalid = 0;
$sizeSum = 0.0; $usedSum = 0.0; $fsSet = []; $hottest = null;

$zero = db_zeroing();
foreach ($disks as $key => $d) {
    $type = (string)($d['type'] ?? '');
    $name = (string)($d['name'] ?? $key);
    if ($type === 'Flash') { continue; }

    if ($type === 'Parity' || $type === 'Data') {
        if (!db_assigned($d)) { continue; }
        $kind = ($type === 'Parity') ? 'parity' : 'data';
        $row = db_row($name, $d, $kind, $rates, $smart, $thr, $started, $attn, $zero);
        if ($kind === 'parity') {
            $parityAssigned++;
            if ($row['state'] === 'ok' || $row['state'] === 'new') { if ($row['state'] === 'ok') { $parityOk++; } }
            $parityRows[] = $row;
        } else {
            if ($row['emulated']) { $emulated++; }
            if ($row['state'] === 'invalid') { $invalid++; }
            if ($row['fs'] !== '') { $fsSet[$row['fs']] = true; }
            if ($row['zero'] === '') { // a disk being zeroed for removal is not counted in the array usage
                if ($row['used'] !== null) { $usedSum += $row['used']; }
                $sizeSum += (float)((float)($d['fsSize'] ?? 0) * 1024);
            }
            $dataRows[] = $row;
        }
        if ($row['temp'] !== null) { $hottest = ($hottest === null) ? $row['temp'] : max($hottest, $row['temp']); }
    } elseif ($type === 'Cache') {
        if (!db_assigned($d) || trim((string)($d['fsType'] ?? '')) === '') { continue; }
        $row = db_row($name, $d, 'pool', $rates, $smart, $thr, $started, $attn);
        if (strtolower($row['fs']) === 'zfs' && isset($zp[$name]) && $zp[$name] !== 'ONLINE') {
            $row['health'] = ['rd', $dbx_T('health.zfs', ['s' => $zp[$name]])];
            $attn[] = ['rd', $row['label'], $dbx_T('attn.pool_state', ['s' => strtolower($zp[$name])]), ''];
        }
        $pools[] = $row;
        if ($row['temp'] !== null) { $hottest = ($hottest === null) ? $row['temp'] : max($hottest, $row['temp']); }
    }
}

// no parity disk at all: a placeholder row so the missing protection is visible
if ($started && !$parityRows && $dataRows) {
    $parityRows[] = ['name' => 'parity', 'label' => 'PARITY', 'kind' => 'parity', 'state' => 'missing', 'emulated' => false, 'dot' => 'rd',
        'sub' => $dbx_T('sub.no_parity'), 'fs' => '', 'size' => 0, 'used' => null, 'pct' => null, 'ulevel' => '',
        'temp' => null, 'tlevel' => 'mu', 'health' => ['rd', $dbx_T('health.no_parity')], 'link' => '/Main'];
}

// resync (parity check / rebuild)
$resync = null;
if ($started && (float)($var['mdResync'] ?? 0) > 0) {
    $size = (float)($var['mdResyncSize'] ?? 0);
    $pos = (float)($var['mdResyncPos'] ?? 0);
    $dt = (float)($var['mdResyncDt'] ?? 0);
    $db = (float)($var['mdResyncDb'] ?? 0);
    $spd = ($dt > 0) ? $db / $dt : 0.0;      // KiB/s
    list($kind, $targets) = db_resync_kind($var['mdResyncAction'] ?? 'check');
    $resync = [
        'action' => $kind, 'targets' => $targets,
        'pct' => $size > 0 ? min(100, $pos / $size * 100) : 0,
        'speed' => $spd * 1024,
        'left' => ($spd > 0 && $size > $pos) ? (int)(($size - $pos) / $spd) : null,
    ];
}

// protection chip
$chip = ['g', $dbx_T('chip.protected')];
$arrState = 'ok';
if (!$started) { $chip = ['mu', $dbx_T('chip.stopped')]; $arrState = 'stopped'; }
else {
    $rebuilding = ($resync && $resync['action'] !== 'check' && $resync['action'] !== 'clear');
    // a parity disk being built (a new Parity 2, a replaced parity) is invalid until the sync ends: that is the sync, not an error
    $syncing = ($resync && $resync['action'] === 'sync');
    if ($syncing) { foreach ($parityRows as $pr) { if (in_array($pr['name'], $resync['targets'], true) && $pr['state'] !== 'ok') { $parityAssigned--; } } }
    if ($parityAssigned === 0 || $parityOk === 0) { $chip = ['rd', $dbx_T('chip.unprotected')]; $arrState = 'unprotected'; }
    elseif ($emulated > 0) { $chip = ['rd', $dbx_T('chip.emulated')]; $arrState = 'emulated'; }
    elseif ($invalid > 0) { $chip = ['rd', $dbx_T('chip.error')]; $arrState = 'invalid'; }
    elseif ($parityOk < $parityAssigned) { $chip = ['a', $dbx_T('chip.degraded')]; $arrState = 'degraded'; }
    // clearing a newly added data disk leaves the parity valid and the array protected: no chip, no amber state;
    // its progress is on the disk's row and in the header summary
    if ($resync && $resync['action'] !== 'clear' && ($arrState === 'ok' || $arrState === 'degraded' || $rebuilding)) {
        $lab = ['rebuild' => $dbx_T('chip.rebuild'), 'sync' => $dbx_T('chip.sync'), 'clear' => $dbx_T('chip.clear')][$resync['action']] ?? $dbx_T('chip.check');
        $chip = [$syncing ? 'bl' : 'a', $lab . ' ' . round($resync['pct']) . '%'];
        $arrState = $resync['action'];
    }
    if ($arrState === 'unprotected') { $attn[] = ['rd', $dbx_T('attn.unprotected'), '', $parityAssigned === 0 ? $dbx_T('attn.no_parity') : $dbx_T('attn.parity_gone')]; }
    elseif ($syncing && $parityOk === 0) { $attn[] = ['rd', $dbx_T('attn.unprotected'), '', $dbx_T('attn.until_sync')]; }
}

// rows while a check / parity sync / rebuild / clearing runs (item 68): the disk being built shows its progress in blue instead of a red
// 'invalid'; a check marks the parity disks it reads; a parity disk the sync does not touch stays 'valid'
$clearing = [];
if ($resync) {
    $tg = $resync['targets'];
    $tail = ' · ' . db_rate($resync['speed']);
    if ($resync['left'] !== null) {
        $h = intdiv($resync['left'], 3600); $m = intdiv($resync['left'] % 3600, 60);
        $tail .= ' · ' . $dbx_T('time.left', ['t' => ($h > 0 ? $h . ' h ' : '') . $m . ' m']);
    }
    $built = [];
    foreach ([&$parityRows, &$dataRows] as &$rows) {
        foreach ($rows as &$r) {
            $mine = in_array($r['name'], $tg, true);
            if ($resync['action'] === 'check') {
                if ($r['kind'] === 'parity' && $r['state'] === 'ok' && (!$tg || $mine)) {
                    $r['sub'] = $dbx_T('sub.checking') . $tail; $r['rpct'] = round($resync['pct'], 1); $r['rstill'] = $resync['speed'] <= 0;
                }
            } elseif ($mine && ($resync['action'] === 'sync' || $resync['action'] === 'rebuild')) {
                $r['sub'] = ($r['kind'] === 'parity' ? $dbx_T('sub.building') : $dbx_T('sub.rebuilding')) . $tail;
                $r['build'] = 1; $r['dot'] = 'on'; $r['health'] = $r['hsmart'];
                $r['rpct'] = round($resync['pct'], 1); $r['rstill'] = $resync['speed'] <= 0;
                $built[$r['label']] = $r['kind'];
            } elseif ($resync['action'] === 'clear' && $r['kind'] === 'data' && $r['state'] === 'new') {
                // "clear" names no disk: Unraid zeroes the newly added data disk(s), outside parity (zeros do not change it)
                $r['sub'] = $dbx_T('sub.clearing') . $tail;
                $r['build'] = 1; $r['blab'] = $dbx_T('bar.cleared'); $r['dot'] = 'on';
                $r['rpct'] = round($resync['pct'], 1); $r['rstill'] = $resync['speed'] <= 0;
                $clearing[] = $r['label'];
            }
        }
        unset($r);
    }
    unset($rows);
    // its 'is invalid' / 'is emulated' attention line goes; a data disk being rebuilt keeps one amber line
    if ($built) {
        $attn = array_values(array_filter($attn, function ($x) use ($built, $dbx_T) {
            return !(isset($built[$x[1]]) && in_array($x[2], [$dbx_T('attn.invalid'), $dbx_T('attn.emulated')], true));
        }));
        foreach ($built as $lab => $k) { if ($k === 'data') { $attn[] = ['a', $lab, $dbx_T('attn.rebuilding'), round($resync['pct']) . '%']; } }
    }
}

// Unassigned disks (item 58): Unraid's devs.ini for presence, temperature and transport, DB_UA (unassigned.php) for the rest
$ua = []; $uaRun = 0; $pcRun = 0; $uaInfo = db_ua();
foreach (db_devs() as $k => $d) {
    $id = (string)($d['id'] ?? $d['device']);
    $e = $uaInfo[$id] ?? null;
    $usb = (($d['transport'] ?? '') === 'usb');
    $temp = is_numeric($d['temp'] ?? '') ? (int)$d['temp'] : ($e['temp'] ?? null);
    $spun = (($d['spundown'] ?? '0') === '1');
    $label = $e ? $e['model'] : preg_replace('/_[^_]+$/', '', $id);
    $smartIn = $e ? ['ua:' . $id => ['t' => $e['t'], 'ok' => $e['ok'] !== false, 'attrs' => $e['attrs'], 'realloc' => $e['realloc'] ?? 0, 'pending' => $e['pending'] ?? 0, 'uncorr' => $e['uncorr'] ?? 0]] : [];
    list($hl, $ht) = db_health('ua:' . $id, $label . ($e ? ' ' . $e['serial'] : ''), $d, $smartIn, $attn);
    $lv = 'mu'; $sub = []; $tp = null; $tl = '';
    if ($e) {
        $sub[] = $e['serial'];
        if ($e['hours'] !== null) { $sub[] = number_format($e['hours'], 0, '.', ' ') . ' h'; }
        $T = $e['test']; $L = $e['last'];
        if (!empty($T['run'])) {
            $lv = 'bl'; $uaRun++; $tp = max(0, min(100, 100 - (int)$T['left'])); $tl = $dbx_T('ua.pct_left', ['p' => $T['left']]);
            $sub[] = $dbx_T('ua.test_running');
        } elseif ($L) {
            $ago = ($L['hours'] !== null && $e['hours'] !== null) ? max(0, $e['hours'] - $L['hours']) : null;
            $when = $ago === null ? '' : ' · ' . ($ago < 48 ? $dbx_T('ua.h_ago', ['n' => $ago]) : $dbx_T('ua.d_ago', ['n' => intdiv($ago, 24)]));
            if ($L['status'] === 'passed') { $lv = 'g'; $sub[] = $dbx_T('ua.passed', ['t' => $L['type']]) . $when; }
            elseif ($L['status'] === 'aborted') { $lv = 'a'; $sub[] = ($L['left'] !== null ? $dbx_T('ua.aborted_at', ['t' => $L['type'], 'p' => $L['left']]) : $dbx_T('ua.aborted', ['t' => $L['type']])) . $when; }
            else { $lv = 'rd'; $sub[] = $dbx_T('ua.failed', ['t' => $L['type'], 'e' => $L['text']]); $attn[] = ['rd', $label . ' ' . $e['serial'], $dbx_T('attn.test_failed'), $L['text']]; }
        }
        if ($spun || !empty($e['sleep'])) { $sub[] = $dbx_T('ua.asleep'); }
    } else { $sub[] = $spun ? $dbx_T('ua.asleep') : $dbx_T('ua.reading_smart'); }
    // a UD Preclear on this disk (item 63): it replaces the SMART test line while it runs, and its result stays until cleared
    $pc = db_preclear($d['device']);
    if ($pc) {
        $sub = array_slice($sub, 0, $e ? (($e['hours'] !== null && !$pc['run']) ? 2 : 1) : 0);   // while it runs: serial only, the step line is long
        if ($pc['run'] && $pc['paused']) { $lv = 'a'; $sub[] = $dbx_T('pc.paused_step', ['s' => strtolower($pc['step'])]); $tp = $pc['pct']; $tl = $dbx_T('pc.paused'); }
        elseif ($pc['run'] && $pc['pct'] !== null) {
            $lv = 'bl'; $pcRun++; $tp = $pc['pct']; $tl = $pc['pct'] . '%';
            $el = db_hms($pc['elapsed']); $left = $pc['pct'] > 0 ? (int)round($el * (100 - $pc['pct']) / $pc['pct']) : 0;
            $sub[] = $pc['step'] . ($pc['of'] ? ' ' . $pc['n'] . '/' . $pc['of'] : '') . ' · ' . $pc['speed'] . ' MB/s' .
                     ($left > 0 ? ' · ~' . $dbx_T('time.left', ['t' => ($left >= 3600 ? round($left / 3600, 1) . ' h' : max(1, (int)round($left / 60)) . ' min')]) : '');
        }
        elseif ($pc['run']) { $lv = 'bl'; $pcRun++; $sub[] = $dbx_T('pc.running', ['s' => $pc['text']]); }
        elseif ($pc['fail']) { $lv = 'rd'; $sub[] = $dbx_T('pc.failed_s', ['s' => $pc['text']]); $attn[] = ['rd', $label . ($e ? ' ' . $e['serial'] : ''), $dbx_T('pc.failed'), $pc['text']]; }
        elseif ($pc['done']) { if ($lv !== 'rd') { $lv = 'g'; } $sub[] = $dbx_T('pc.done') . ' · ' . date('M j H:i', $pc['t']); }
        else { $lv = 'a'; $sub[] = $dbx_T('pc.stopped', ['s' => $pc['text']]); }
    }
    if ($hl === 'rd') { $lv = 'rd'; } elseif ($hl === 'a' && $lv !== 'rd') { $lv = 'a'; }
    $ua[] = ['name' => $id, 'label' => $label, 'kind' => 'ua', 'bus' => $usb ? 'USB' : 'SATA', 'sub' => implode(' · ', $sub),
             'size' => $e && $e['bytes'] > 0 ? $e['bytes'] : (float)($d['sectors'] ?? 0) * (float)($d['sector_size'] ?? 512),
             'lv' => $lv, 'tpct' => $tp, 'tleft' => $tl, 'tlab' => $pc ? $dbx_T('bar.preclear') : $dbx_T('bar.test'), 'temp' => $temp, 'tlevel' => db_tlevel($temp, ($d['rotational'] ?? '1') === '0', $thr),
             'health' => [$hl, $ht], 'dot' => $spun ? 'off' : 'on', 'link' => '/Main'];
}

// attention list: red first
$order = ['rd' => 0, 'a' => 1];
usort($attn, function ($a, $b) use ($order) { return ($order[$a[0]] ?? 2) <=> ($order[$b[0]] ?? 2); });
$attOut = [];
foreach ($attn as $a) { $attOut[] = ['level' => $a[0], 'name' => $a[1], 'text' => $a[2], 'small' => $a[3], 'ack' => $a[4] ?? '']; }

// Balance (see balance.php): shown while a move runs and for a day after it ended
$bal = null;
$bsf = '/tmp/diskbox_balance_status.json';
$bs = is_file($bsf) ? json_decode((string)@file_get_contents($bsf), true) : null;
if (is_array($bs) && !empty($bs['state'])) {
    $bst = (string)$bs['state']; $bfin = (int)($bs['finished'] ?? 0); $bmsg = (string)($bs['msg'] ?? '');
    if ($bst === 'running' && time() - (int)@filemtime($bsf) > 180) { $bst = 'error'; $bmsg = $dbx_T('bal.stopped_unexpectedly'); $bfin = (int)@filemtime($bsf); }
    if ($bst === 'running' || ($bfin > 0 && time() - $bfin < 86400 && in_array($bst, ['done', 'aborted', 'error'], true))) {
        $nd = 0; $ns = 0; $nf = 0; $nt = 0;
        foreach ((array)($bs['items'] ?? []) as $bi) { $nt++; if (($bi['state'] ?? '') === 'ok') { $nd++; } elseif (($bi['state'] ?? '') === 'skip') { $ns++; } elseif (($bi['state'] ?? '') === 'fail') { $nf++; } }
        $bal = ['state' => $bst, 'total' => (float)($bs['total'] ?? 0), 'done' => (float)($bs['done'] ?? 0) + (float)($bs['curBytes'] ?? 0),
                'n' => $nt, 'ok' => $nd, 'skip' => $ns, 'fail' => $nf, 'started' => (int)($bs['started'] ?? 0), 'finished' => $bfin, 'msg' => $bmsg];
    }
}

$devices = count($parityRows) + count($dataRows) + count($pools);
if (!empty($parityRows) && $parityRows[0]['state'] === 'missing' && $parityRows[0]['sub'] === $dbx_T('sub.no_parity')) { $devices--; }
$arrDevices = count($dataRows) + count(array_filter($parityRows, function ($r) { return $r['sub'] !== $GLOBALS['dbx_T']('sub.no_parity'); }));

db_out([
    'ok' => true, 'started' => $started, 'ts' => time(),
    'summary' => ['devices' => $devices, 'used' => $usedSum, 'size' => $sizeSum, 'hottest' => $hottest,
                  'clearing' => $clearing ? ['disks' => $clearing, 'pct' => round($resync['pct'])] : null],
    'attention' => $attOut,
    'array' => [
        'devices' => $arrDevices, 'fs' => implode(' / ', array_keys($fsSet)), 'used' => $usedSum, 'size' => $sizeSum,
        'pct' => $sizeSum > 0 ? $usedSum / $sizeSum * 100 : 0,
        'chip' => $chip, 'rpct' => ($resync && $resync['action'] !== 'clear') ? round($resync['pct'], 1) : null, 'rstill' => $resync ? $resync['speed'] <= 0 : false, 'state' => $arrState, 'parity' => $parityRows, 'disks' => $dataRows,
        'warn' => $thr['warn'], 'crit' => $thr['crit'],
    ],
    'pools' => $pools,
    'unassigned' => $ua, 'ua_running' => $uaRun, 'pc_running' => $pcRun,
    'balance' => $bal,
]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SMART COLLECTOR -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/smart.php">
<INLINE><![CDATA[<?php
// Started by cron every 20 minutes: collect SMART health without waking sleeping disks.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/lib.php';

$cfg = db_cfg();
if (!db_on($cfg['smart'])) { exit(0); }
$bin = trim((string)@shell_exec('command -v smartctl 2>/dev/null'));
if ($bin === '') { $bin = '/usr/sbin/smartctl'; }
if (!is_executable($bin)) { exit(0); }

$lock = @fopen('/tmp/diskbox_smart.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

$prev = is_file(DB_SMART) ? json_decode((string)@file_get_contents(DB_SMART), true) : null;
$res = (is_array($prev) && isset($prev['disks']) && is_array($prev['disks'])) ? $prev['disks'] : [];

foreach (db_disks() as $name => $d) {
    $type = $d['type'] ?? '';
    if (!in_array($type, ['Parity', 'Data', 'Cache'], true)) { continue; }
    $dev = preg_replace('/[^A-Za-z0-9]/', '', (string)($d['device'] ?? ''));
    if ($dev === '' || ($d['spundown'] ?? '0') === '1') { continue; }

    // -n standby: never wake a sleeping disk
    $out = @shell_exec(escapeshellcmd($bin) . ' -n standby -j -H -A ' . escapeshellarg('/dev/' . $dev) . ' 2>/dev/null');
    $j = json_decode((string)$out, true);
    if (!is_array($j) || !isset($j['smart_status'])) { continue; }

    $e = ['t' => time(), 'ok' => !empty($j['smart_status']['passed'])];
    if (!empty($j['ata_smart_attributes']['table'])) {
        foreach ($j['ata_smart_attributes']['table'] as $a) {
            $id = (int)($a['id'] ?? 0);
            $raw = (int)($a['raw']['value'] ?? 0);
            if ($id === 5)   { $e['realloc'] = $raw; }
            if ($id === 197) { $e['pending'] = $raw; }
            if ($id === 198) { $e['uncorr'] = $raw; }
            // attributes worth a Discord alert: error counters above zero, or any value at or below its threshold.
            // Pre-fail / old age comes from the attribute's own flag.
            $wf = trim((string)($a['when_failed'] ?? ''));
            $failed = ($wf !== '' && $wf !== '-');
            if ($failed || ($raw > 0 && in_array($id, [5, 10, 184, 187, 196, 197, 198, 199], true))) {
                $e['attrs'][] = [$id, (string)($a['name'] ?? ('attr ' . $id)), !empty($a['flags']['prefail']), $raw,
                                 (int)($a['value'] ?? 0), (int)($a['worst'] ?? 0), (int)($a['thresh'] ?? 0), $failed];
            }
        }
    }
    if (!empty($j['nvme_smart_health_information_log'])) {
        $n = $j['nvme_smart_health_information_log'];
        $e['nvme_warn'] = (int)($n['critical_warning'] ?? 0);
        $e['nvme_media'] = (int)($n['media_errors'] ?? 0);
        $e['nvme_used'] = (int)($n['percentage_used'] ?? 0);
    }
    $res[$name] = $e;
}

$tmp = DB_SMART . '.tmp';
if (@file_put_contents($tmp, json_encode(['ts' => time(), 'disks' => $res])) !== false) { @rename($tmp, DB_SMART); }
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- UNASSIGNED DISKS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/unassigned.php">
<INLINE><![CDATA[<?php
// Started by cron every 5 minutes: reads the unassigned disks (devs.ini) with smartctl into DB_UA for the dashboard tile:
// model, serial, power-on hours, temperature, SMART health and the self-test (the % left while one runs, else the last result).
// A sleeping disk is never woken (-n standby): its last reading stays. When a test that was running is over (passed, aborted
// or failed), one Discord message goes to the Diskbox webhook (setting n_utest, on by default). Read-only towards the disks.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/discord.php';
require_once __DIR__ . '/alerts.php';

$lock = @fopen('/tmp/diskbox_ua.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }
$bin = trim((string)@shell_exec('command -v smartctl 2>/dev/null'));
if ($bin === '') { $bin = '/usr/sbin/smartctl'; }
if (!is_executable($bin)) { exit(0); }

$prev = db_ua();
$res = [];
foreach (db_devs() as $d) {
    $dev = preg_replace('/[^A-Za-z0-9]/', '', (string)$d['device']);
    if ($dev === '') { continue; }
    $key = (string)($d['id'] ?? $dev);
    if (($d['spundown'] ?? '0') === '1') { if (isset($prev[$key])) { $res[$key] = $prev[$key]; $res[$key]['sleep'] = true; } continue; }
    $cmd = escapeshellcmd($bin) . ' -n standby -j -i -H -A -c -l selftest ';
    $e = db_ua_entry(json_decode((string)@shell_exec($cmd . escapeshellarg('/dev/' . $dev) . ' 2>/dev/null'), true));
    // a USB enclosure that smartctl does not recognise by itself: try the SAT pass-through
    if ($e === null && ($d['transport'] ?? '') === 'usb') { $e = db_ua_entry(json_decode((string)@shell_exec($cmd . '-d sat ' . escapeshellarg('/dev/' . $dev) . ' 2>/dev/null'), true)); }
    if ($e === null) { if (isset($prev[$key])) { $res[$key] = $prev[$key]; $res[$key]['sleep'] = true; } continue; }
    $e['since'] = !empty($e['test']['run']) ? (int)($prev[$key]['since'] ?? time()) : 0;   // when this tile first saw the test running
    $res[$key] = $e;
}
$tmp = DB_UA . '.tmp';
if (@file_put_contents($tmp, json_encode(['ts' => time(), 'disks' => $res])) !== false) { @rename($tmp, DB_UA); }

// ---- Discord: a test that was running is over ----------------------------------------------------------
$cfg = db_cfg();
$hook = (string)$cfg['dc_hook'];
if (!db_on($cfg['n_utest']) || !dbn_hook_ok($hook)) { exit(0); }
$lang = dbn_lang($cfg);
$sf = '/boot/config/plugins/diskbox/ua_state.json';
$run = is_file($sf) ? json_decode((string)@file_get_contents($sf), true) : null;
$run = is_array($run) ? $run : [];   // serial => [since, model] of the tests seen running
$changed = false;
$T = [
    'hu' => ['ok' => 'SMART %s teszt rendben: %s', 'ab' => 'SMART %s teszt megszakadt: %s', 'fail' => 'SMART %s teszt HIBÁS: %s',
             'ab_d' => 'A teszt nem futott végig. USB-házban gyakori, hogy a ház elaltatja a lemezt; indítsd újra, és figyeld.',
             'fail_d' => 'A lemez a saját önellenőrzésén elbukott. Ne tegyél rá adatot; használt lemeznél kérd vissza a vételárat.',
             'res' => 'Eredmény', 'dur' => 'Időtartam', 'hours' => 'Üzemóra', 'sect' => 'Áthelyezett / függő', 'extended' => 'kiterjesztett', 'short' => 'rövid'],
    'en' => ['ok' => 'SMART %s test passed: %s', 'ab' => 'SMART %s test aborted: %s', 'fail' => 'SMART %s test FAILED: %s',
             'ab_d' => 'The test did not run to the end. In a USB enclosure the enclosure often puts the disk to sleep; start it again and watch it.',
             'fail_d' => 'The disk failed its own self-test. Do not put data on it; for a used disk, ask for a refund.',
             'res' => 'Result', 'dur' => 'Duration', 'hours' => 'Power-on hours', 'sect' => 'Reallocated / pending', 'extended' => 'extended', 'short' => 'short'],
][$lang];
foreach ($res as $e) {
    $sn = $e['serial'];
    if (!empty($e['test']['run'])) {
        if (!isset($run[$sn])) { $run[$sn] = [(int)$e['since'], $e['model']]; $changed = true; }
        continue;
    }
    if (!isset($run[$sn]) || !empty($e['sleep']) || !$e['last']) { continue; }   // asleep: wait until it can be read again
    $L = $e['last'];
    $name = $e['model'] . ' ' . $sn;
    $type = $T[$L['type']] ?? $L['type'];
    if ($L['status'] === 'passed') { $lv = 'g'; $t = '✅ ' . sprintf($T['ok'], $type, $name); $desc = ''; }
    elseif ($L['status'] === 'aborted') { $lv = 'a'; $t = '⏹️ ' . sprintf($T['ab'], $type, $name); $desc = $T['ab_d']; }
    else { $lv = 'rd'; $t = '🔴 ' . sprintf($T['fail'], $type, $name); $desc = $T['fail_d']; }
    $since = (int)$run[$sn][0];
    $emb = dbn_embed($lv, $t, $desc, [
        [$T['res'], $L['text'] . ($L['status'] !== 'passed' && $L['left'] !== null ? ' (' . $L['left'] . '%)' : ''), false],
        [$T['dur'], $since > 0 ? dbn_fmt_dur(time() - $since) : '', true],
        [$T['hours'], $e['hours'] !== null ? number_format($e['hours'], 0, '.', ' ') : '', true],
        [$T['sect'], (int)($e['realloc'] ?? 0) . ' / ' . (int)($e['pending'] ?? 0), true]]);
    list($r, $msg) = dbn_post($hook, [$emb], $lv === 'rd' ? dbn_ping_set($cfg['dc_ping']) : '');
    if ($r === 'retry') { break; }
    unset($run[$sn]);
    $changed = true;
}
// a disk that was unplugged while its test ran: forget it after a day
foreach ($run as $sn => $x) {
    $seen = false;
    foreach ($res as $e) { if ($e['serial'] === $sn) { $seen = true; } }
    if (!$seen && time() - (int)$x[0] > 86400) { unset($run[$sn]); $changed = true; }
}
if ($changed) { @file_put_contents($sf . '.tmp', json_encode($run)); @rename($sf . '.tmp', $sf); }

// ---- Discord: a UD Preclear that was running is over (item 63) -------------------------------------------
$pf = '/boot/config/plugins/diskbox/pc_state.json';
$pcs = is_file($pf) ? json_decode((string)@file_get_contents($pf), true) : null;
$pcs = is_array($pcs) ? $pcs : [];   // device => [since, name] of the preclears seen running
$pch = false;
$P = [
    'hu' => ['ok' => 'Preclear kész: %s', 'fail' => 'Preclear HIBÁS: %s', 'stop' => 'Preclear leállt: %s',
             'ok_d' => 'A lemez végig olvasva és kinullázva, hiba nélkül. Tartaléknak vagy a tömbbe mehet.',
             'fail_d' => 'A preclear elbukott. Nézd meg a jelentését (Tools, Preclear), és ne tegyél rá adatot.',
             'stop_d' => 'A preclear nem futott végig (leállították, vagy a gép újraindult).', 'res' => 'Eredmény', 'dur' => 'Időtartam'],
    'en' => ['ok' => 'Preclear finished: %s', 'fail' => 'Preclear FAILED: %s', 'stop' => 'Preclear stopped: %s',
             'ok_d' => 'The disk was read and zeroed end to end without an error. It can go on the shelf or into the array.',
             'fail_d' => 'The preclear failed. Read its report (Tools, Preclear) and do not put data on the disk.',
             'stop_d' => 'The preclear did not run to the end (it was stopped, or the server restarted).', 'res' => 'Result', 'dur' => 'Duration'],
][$lang];
foreach (db_devs() as $d) {
    $dev = preg_replace('/[^A-Za-z0-9]/', '', (string)$d['device']); $pc = db_preclear($dev);
    $e = $res[(string)($d['id'] ?? $dev)] ?? null; $name = $e ? $e['model'] . ' ' . $e['serial'] : (string)($d['id'] ?? $dev);
    if ($pc && $pc['run']) { if (!isset($pcs[$dev])) { $pcs[$dev] = [time(), $name]; $pch = true; } continue; }
    if (!isset($pcs[$dev])) { continue; }
    if (!$pc) { unset($pcs[$dev]); $pch = true; continue; }   // its status was cleared before we saw the end
    if ($pc['fail']) { $lv = 'rd'; $t = '🔴 ' . sprintf($P['fail'], $name); $desc = $P['fail_d']; }
    elseif ($pc['done']) { $lv = 'g'; $t = '✅ ' . sprintf($P['ok'], $name); $desc = $P['ok_d']; }
    else { $lv = 'a'; $t = '⏹️ ' . sprintf($P['stop'], $name); $desc = $P['stop_d']; }
    $emb = dbn_embed($lv, $t, $desc, [[$P['res'], $pc['text'], false], [$P['dur'], dbn_fmt_dur(max(0, $pc['t'] - (int)$pcs[$dev][0])), true]]);
    list($r, $msg) = dbn_post($hook, [$emb], $lv === 'rd' ? dbn_ping_set($cfg['dc_ping']) : '');
    if ($r === 'retry') { break; }
    unset($pcs[$dev]); $pch = true;
}
if ($pch) { @file_put_contents($pf . '.tmp', json_encode($pcs)); @rename($pf . '.tmp', $pf); }
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SAVE -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/save.php">
<INLINE><![CDATA[<?php
header('Content-Type: application/json');
header('Cache-Control: no-store');
require_once __DIR__ . '/i18n.php';
$dbx_T = mt_i18n_t(__DIR__ . '/lang');   // texts shown on the settings page (lang/en.json)

function db_out($ok, $extra = []) {
    echo json_encode(array_merge(['ok' => $ok], $extra), JSON_UNESCAPED_UNICODE);
    exit;
}

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); db_out(false, ['error' => 'method']); }

// CSRF: Unraid's prepend script validates csrf_token and removes it from $_POST;
// if a token is still present check it, otherwise require an AJAX request.
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); db_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403);
    db_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}

$dir  = '/boot/config/plugins/diskbox';
$file = $dir . '/settings.cfg';

// empty = use Unraid's own value
function db_num($v, $min, $max, $name) {
    $v = trim((string)$v);
    if ($v === '') { return ''; }
    if (!is_numeric($v) || $v < $min || $v > $max) { db_out(false, ['error' => $GLOBALS['dbx_T']('save.err_range', ['name' => $name, 'min' => $min, 'max' => $max])]); }
    return (string)(int)$v;
}

function db_bool($v) { return in_array(strtolower(trim((string)$v)), ['1', 'yes', 'true', 'on'], true) ? '1' : '0'; }
function db_req($v, $min, $max, $name) {
    $v = trim((string)$v);
    if ($v === '' || !is_numeric($v) || $v < $min || $v > $max) { db_out(false, ['error' => $GLOBALS['dbx_T']('save.err_number', ['name' => $name, 'min' => $min, 'max' => $max])]); }
    return (string)(int)$v;
}
$hook = trim((string)($_POST['dc_hook'] ?? ''));
// the page does not get the saved webhook: empty keeps it, - removes it
if ($hook === '') { $oldc = is_file($file) ? @parse_ini_file($file, false, INI_SCANNER_RAW) : []; $hook = is_array($oldc) ? (string)($oldc['dc_hook'] ?? '') : ''; }
elseif ($hook === '-') { $hook = ''; }
if ($hook !== '' && !preg_match('#^https://(?:discord|discordapp)\.com/api/webhooks/\d{15,25}/[A-Za-z0-9_\-]{20,120}$#', $hook)) {
    db_out(false, ['error' => $dbx_T('save.err_hook')]);
}
$ping = trim((string)($_POST['dc_ping'] ?? ''));
if ($ping !== '' && !preg_match('/^(\d{15,25}|role:\d{15,25}|@here|@everyone)$/', $ping)) { db_out(false, ['error' => $dbx_T('save.err_ping')]); }
$fw = db_req($_POST['n_fill_warn'] ?? '85', 1, 100, 'Fill warning');
$fc = db_req($_POST['n_fill_crit'] ?? '95', 1, 100, 'Fill critical');
if ((int)$fw > (int)$fc) { db_out(false, ['error' => $dbx_T('save.err_fill')]); }

$new = [
    'warn_use' => db_num($_POST['warn_use'] ?? '', 0, 100, 'Warning utilization'),
    'crit_use' => db_num($_POST['crit_use'] ?? '', 0, 100, 'Critical utilization'),
    'hot_temp' => db_num($_POST['hot_temp'] ?? '', 0, 100, 'Hot temperature'),
    'max_temp' => db_num($_POST['max_temp'] ?? '', 0, 100, 'Maximum temperature'),
    'smart'    => in_array(strtolower(trim((string)($_POST['smart'] ?? '1'))), ['1', 'yes', 'true', 'on'], true) ? '1' : '0',
    'dc_hook'  => $hook, 'dc_ping' => $ping,
    'dc_lang'  => (($_POST['dc_lang'] ?? 'hu') === 'en') ? 'en' : 'hu',
    'n_array' => db_bool($_POST['n_array'] ?? '1'), 'n_temp' => db_bool($_POST['n_temp'] ?? '1'), 'n_smart' => db_bool($_POST['n_smart'] ?? '1'),
    'n_fill' => db_bool($_POST['n_fill'] ?? '1'), 'n_fill_warn' => $fw, 'n_fill_crit' => $fc,
    'n_pool' => db_bool($_POST['n_pool'] ?? '1'), 'n_parity' => db_bool($_POST['n_parity'] ?? '1'), 'n_utest' => db_bool($_POST['n_utest'] ?? '1'),
    'n_remind' => db_req($_POST['n_remind'] ?? '24', 0, 168, 'Repeat interval'),
    'wk_on' => db_bool($_POST['wk_on'] ?? '1'), 'wk_day' => db_req($_POST['wk_day'] ?? '7', 1, 7, 'Weekly day'), 'wk_hour' => db_req($_POST['wk_hour'] ?? '18', 0, 23, 'Weekly hour'),
];

$text = '';
foreach ($new as $k => $v) { $text .= $k . '="' . str_replace('"', '', (string)$v) . '"' . "\n"; }

if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
$tmp = $file . '.tmp';
if (@file_put_contents($tmp, $text) === false) { db_out(false, ['error' => $dbx_T('save.err_write')]); }
if (!@rename($tmp, $file)) { @file_put_contents($file, $text); @unlink($tmp); }
@chmod($file, 0600);
@unlink('/tmp/diskbox_zpool.json');

db_out(true, ['saved' => $new]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD HELPERS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/discord.php">
<INLINE><![CDATA[<?php
// Diskbox Discord helpers: webhook post, embeds, and alert state with de-duplication.
// Alert state lives on the flash drive and is written only when it changes; short-lived counters live in /tmp.
const DBN_STATE = '/boot/config/plugins/diskbox/notify_state.json';
const DBN_TMP   = '/tmp/diskbox_notify_tmp.json';

function dbn_hook_ok($u) { return (bool)preg_match('#^https://(?:discord|discordapp)\.com/api/webhooks/\d{15,25}/[A-Za-z0-9_\-]{20,120}$#', (string)$u); }

require_once __DIR__ . '/lang.php';
// the Discord language is shared by all the plugins (lang.php; Settings, the Language block of any of them)
function dbn_lang($cfg) { return mt_lang_discord(); }

// Returns ['ok'|'retry'|'fail', message]
// The text that pings someone on red alerts: a user ID, "role:<id>", "@here" or "@everyone" (setting dc_ping)
function dbn_ping_text($v) {
    $v = trim((string)$v);
    if (preg_match('/^\d{15,25}$/', $v)) { return '<@' . $v . '>'; }
    if (preg_match('/^role:(\d{15,25})$/', $v, $m)) { return '<@&' . $m[1] . '>'; }
    if ($v === '@here' || $v === '@everyone') { return $v; }
    return '';
}
function dbn_ping_set($v = null) {
    static $p = '';
    if ($v !== null) { $p = dbn_ping_text($v); }
    return $p;
}

function dbn_post($hook, $embeds, $content = '', $attempt = 0) {
    static $last = 0.0;
    $gap = microtime(true) - $last;
    if ($gap < 0.5) { usleep((int)((0.5 - $gap) * 1000000)); }
    $am = ['parse' => []];
    if ($content !== '') {
        if (preg_match('/^<@(\d+)>$/', $content, $m)) { $am = ['parse' => [], 'users' => [$m[1]]]; }
        elseif (preg_match('/^<@&(\d+)>$/', $content, $m)) { $am = ['parse' => [], 'roles' => [$m[1]]]; }
        else { $am = ['parse' => ['everyone']]; }
    }
    $pl = ['embeds' => $embeds, 'allowed_mentions' => $am];
    if ($content !== '') { $pl['content'] = $content; }
    $json = json_encode($pl, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
    $ch = curl_init($hook);
    curl_setopt_array($ch, [CURLOPT_POST => true, CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 20,
        CURLOPT_POSTFIELDS => $json, CURLOPT_HTTPHEADER => ['Content-Type: application/json']]);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err = curl_errno($ch);
    curl_close($ch);
    $last = microtime(true);
    if ($err) { return ['retry', 'network error ' . $err]; }
    if ($code === 200 || $code === 204) { return ['ok', '']; }
    if ($code === 429) {
        $d = json_decode((string)$body, true);
        $wait = is_array($d) && isset($d['retry_after']) ? (float)$d['retry_after'] : 2.0;
        if ($attempt < 1 && $wait <= 5.0) { usleep((int)(($wait + 0.3) * 1000000)); return dbn_post($hook, $embeds, $content, $attempt + 1); }
        return ['retry', 'rate limited'];
    }
    if ($code >= 500 || $code === 0) { return ['retry', 'Discord HTTP ' . $code]; }
    $d = json_decode((string)$body, true);
    return ['fail', 'Discord HTTP ' . $code . (is_array($d) && !empty($d['message']) ? ' (' . $d['message'] . ')' : '')];
}

// $level: rd red, a amber, g green, i blue. $fields: [[name, value, inline?], ...]
function dbn_embed($level, $title, $desc = '', $fields = [], $footer = '') {
    $col = ['rd' => 0xE5534B, 'a' => 0xD9921F, 'g' => 0x3FA24A, 'i' => 0x4A90E2];
    $host = @gethostname();
    $e = ['title' => mb_substr($title, 0, 250), 'color' => $col[$level] ?? $col['i'], 'timestamp' => gmdate('c'),
          'footer' => ['text' => trim(($host ? $host . ' · ' : '') . 'Diskbox' . ($footer !== '' ? ' · ' . $footer : ''))]];
    if ($desc !== '') { $e['description'] = mb_substr($desc, 0, 3900); }
    $f = [];
    foreach ($fields as $x) {
        if ($x[1] === '' || $x[1] === null) { continue; }
        $f[] = ['name' => mb_substr((string)$x[0], 0, 250), 'value' => mb_substr((string)$x[1], 0, 1000), 'inline' => !empty($x[2])];
    }
    if ($f) { $e['fields'] = array_slice($f, 0, 24); }
    return $e;
}

function dbn_load($file, $def) {
    $j = is_file($file) ? json_decode((string)@file_get_contents($file), true) : null;
    return is_array($j) ? array_merge($def, $j) : $def;
}
function dbn_state() { return dbn_load(DBN_STATE, ['k' => [], 'log' => [], 'misc' => []]); }
function dbn_tmp() { return dbn_load(DBN_TMP, ['deb' => [], 'x' => []]); }
function dbn_write($file, $data) {
    $dir = dirname($file);
    if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
    $tmp = $file . '.tmp';
    if (@file_put_contents($tmp, json_encode($data)) === false) { return; }
    if (!@rename($tmp, $file)) { @file_put_contents($file, json_encode($data)); @unlink($tmp); }
}

// Remembers one sent alert in the 7-day log (used by the weekly summary)
function dbn_log(&$st, $key, $level) {
    $st['log'][] = [time(), $key, $level];
    $cut = time() - 14 * 86400;
    $st['log'] = array_values(array_filter($st['log'], function ($x) use ($cut) { return $x[0] >= $cut; }));
    if (count($st['log']) > 300) { $st['log'] = array_slice($st['log'], -300); }
}

// One alert with its life cycle. $level: '' (fine), 'a' or 'rd'. $sig: changes when an active alert gets worse in another way.
// $mk('alert'|'resolved') returns an embed. $o: need = consecutive checks before the first alert, resolve = send an all-clear,
// remind = hours between repeats of a red alert (0 = never).
function dbn_track(&$st, &$tm, $key, $level, $sig, $mk, $hook, $o = []) {
    $need = (int)($o['need'] ?? 1); $resolve = $o['resolve'] ?? true; $remind = (int)($o['remind'] ?? 0);
    $cur = $st['k'][$key] ?? null;
    if ($level !== '') {
        $tm['deb'][$key] = (int)($tm['deb'][$key] ?? 0) + 1;
        if ($tm['deb'][$key] < $need) { return; }
        $send = false;
        if ($cur === null) { $send = true; }
        elseif ($level === 'rd' && $cur['l'] === 'a') { $send = true; }
        elseif ((string)$sig !== (string)$cur['s']) { $send = true; }
        elseif ($level === 'rd' && $remind > 0 && time() - (int)$cur['t'] >= $remind * 3600) { $send = true; }
        if ($send) {
            $emb = $mk('alert');
            $r = dbn_post($hook, [$emb], $level === 'rd' ? dbn_ping_set() : '');
            dbn_guard_event($key, $level, $emb);
            if ($r[0] === 'retry') { $tm['x']['err'] = $r[1]; return; }
            if ($r[0] === 'fail') { $tm['x']['err'] = $r[1]; }
            $st['k'][$key] = ['l' => $level, 's' => (string)$sig, 't' => time()];
            dbn_log($st, $key, $level);
        } elseif ($cur !== null && $cur['l'] !== $level) {
            $st['k'][$key]['l'] = $level;
        }
    } else {
        $tm['deb'][$key] = 0;
        if ($cur !== null) {
            if ($resolve) {
                $r = dbn_post($hook, [$mk('resolved')]);
                if ($r[0] === 'retry') { $tm['x']['err'] = $r[1]; return; }
                if ($r[0] === 'fail') { $tm['x']['err'] = $r[1]; }
            }
            unset($st['k'][$key]);
        }
    }
}

// Claude Guard (Sysbox) reads its alerts from this queue and may explain them; one JSON line per alert, never secrets
// (the embed text only). The queue is emptied by the Guard; it stops growing at 256 KB when the Guard is not installed.
function dbn_guard_event($key, $level, $emb) {
    $f = '/tmp/mt_guard_events.jsonl';
    if (@filesize($f) > 262144) { return; }
    $txt = trim(($emb['title'] ?? '') . ' ' . ($emb['description'] ?? ''));
    foreach ((array)($emb['fields'] ?? []) as $x) { $txt .= ' · ' . ($x['name'] ?? '') . ': ' . ($x['value'] ?? ''); }
    @file_put_contents($f, json_encode(['src' => 'diskbox', 'key' => 'diskbox:' . $key, 'level' => $level, 'text' => mb_substr($txt, 0, 1500), 't' => time()], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n", FILE_APPEND | LOCK_EX);
}
function dbn_cur_level($st, $key) { return $st['k'][$key]['l'] ?? ''; }

function dbn_fmt_bytes($b) {
    $b = (float)$b;
    if ($b >= 1e12) { return number_format($b / 1e12, $b >= 1e13 ? 1 : 2, '.', '') . ' TB'; }
    if ($b >= 1e9) { return number_format($b / 1e9, $b >= 1e11 ? 0 : 1, '.', '') . ' GB'; }
    if ($b >= 1e6) { return number_format($b / 1e6, 0, '.', '') . ' MB'; }
    return number_format($b / 1e3, 0, '.', '') . ' KB';
}

function dbn_fmt_dur($s) {
    $s = (int)$s; $d = intdiv($s, 86400); $h = intdiv($s % 86400, 3600); $m = intdiv($s % 3600, 60);
    return $d > 0 ? $d . ' d ' . $h . ' h' : ($h > 0 ? $h . ' h ' . $m . ' m' : $m . ' m');
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD ALERT TEXTS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/alerts.php">
<INLINE><![CDATA[<?php
// Diskbox Discord alerts: texts (Hungarian and English) and message builders.

function dbn_t($lang, $k, $a = []) {
    static $T = [
      'hu' => [
        'unprot' => 'Az array nincs védve', 'unprot_d' => 'Nincs működő parity lemez: ha most kiesik egy lemez, az adat elveszhet.',
        'emul' => 'Lemez emulálva: %s', 'emul_d' => 'A lemez hiányzik vagy le van tiltva, az adatát az Unraid a parity-ből számolja. Cseréld ki mielőbb.',
        'inval' => 'Lemezhiba az arrayben: %s', 'inval_d' => 'A lemez állapota hibás.',
        'degr' => 'Csökkent parity védelem', 'degr_d' => 'Az egyik parity lemez nem működik rendesen.',
        'rebuild' => 'Az array újraépül (%s)', 'rebuild_d' => 'Amíg ez tart, az array nincs teljesen védve.',
        'arr_ok' => 'Az array újra védett', 'arr_ok_d' => 'A parity védelem helyreállt.',
        'hot' => '%s túl meleg', 'warm' => '%s melegszik', 'cool' => '%s lehűlt',
        'temp' => 'Hőmérséklet', 'limits' => 'Határok', 'limits_v' => 'meleg %s °C · kritikus %s °C', 'cool_d' => 'Már %s °C.',
        'fill' => '%s majdnem megtelt: %s%%', 'fill_c' => '%s megtelt: %s%%', 'fill_ok' => '%s már nem tele (%s%%)',
        'used' => 'Használt', 'free' => 'Szabad', 'thr' => 'Határ',
        'smart_f' => '%s: SMART hiba', 'smart_w' => '%s: SMART figyelmeztetés',
        'smart_fd' => 'A lemez állapotellenőrzése hibát jelzett. Mentsd le az adatait, és cseréld ki.',
        'smart_wd' => 'A lemez SMART-adataiban romlás látszik. Figyeld, és készülj a cserére.',
        'disk' => 'Lemez', 'attrs' => 'Érintett attribútumok', 'nvme' => 'NVMe állapotnapló',
        'pre' => 'Pre-fail', 'old' => 'Old age', 'raw' => 'nyers', 'was' => 'előző', 'val' => 'érték', 'worst' => 'legrosszabb', 'thresh' => 'küszöb',
        'failing' => 'A KÜSZÖB ALATT', 'healthfail' => 'A SMART állapotellenőrzés: HIBÁS',
        'smart_legend' => 'Pre-fail: a romló érték közelgő meghibásodást jelez. Old age: üzemi, elhasználódást mérő számláló.',
        'pool_bad' => '%s pool: %s', 'pool_bad_d' => 'A pool nem ONLINE állapotú, a redundancia vagy az adat veszélyben lehet.', 'pool_ok' => '%s pool újra ONLINE',
        'pc_start' => '%s elindult', 'pc_end' => '%s befejeződött', 'pc_cancel' => '%s megszakítva', 'pc_err' => '%s hibákkal fejeződött be',
        'pc_check' => 'Parity ellenőrzés', 'pc_rebuild' => 'Lemez újraépítés', 'pc_sync' => 'Paritásépítés', 'pc_clear' => 'Lemez törlés',
        'duration' => 'Időtartam', 'speed' => 'Sebesség', 'errors' => 'Hibák', 'at' => 'Mikor',
        'wk' => 'Heti összefoglaló', 'array' => 'Array', 'hottest' => 'Legmelegebb', 'fullest' => 'Legtelítettebb', 'lastpc' => 'Utolsó parity ellenőrzés',
        'alerts7' => 'Riasztás az elmúlt 7 napban', 'none' => 'nincs', 'smartw' => 'SMART figyelmeztetés', 'table' => 'Lemezek',
        'protected' => 'védett', 'sample' => 'MINTA',
        'ack_head' => 'Elfogadott SMART figyelmeztetések', 'ack_on' => 'elfogadva', 'ack_same' => 'azóta változatlan', 'ack_days' => '%s napja', 'ack_today' => 'ma',
        'sev' => 'Súlyosság', 'sev_fast' => 'GYORS ROMLÁS', 'sev_slow' => 'lassú romlás', 'worse' => 'Romlás',
        'sev_fast_d' => 'Rövid időn belül romlott tovább: ez sürgős lehet.', 'sev_slow_d' => 'Hosszabb idő alatt romlott tovább: figyeld, de nem sürgős.',
        'since_ack' => 'az elfogadás óta', 'since_alert' => 'az előző riasztás óta', 'within' => 'alatt', 'test_t' => 'Diskbox teszt', 'test_d' => 'A Discord-értesítés működik.',
        'stopped' => 'leállítva', 'total' => 'Összes tárhely',
      ],
      'en' => [
        'unprot' => 'The array is not protected', 'unprot_d' => 'There is no working parity disk: if a disk fails now, data can be lost.',
        'emul' => 'Disk emulated: %s', 'emul_d' => 'The disk is missing or disabled, so Unraid rebuilds its data from parity. Replace it soon.',
        'inval' => 'Disk error in the array: %s', 'inval_d' => 'The disk is in a bad state.',
        'degr' => 'Parity protection reduced', 'degr_d' => 'One of the parity disks is not working properly.',
        'rebuild' => 'The array is rebuilding (%s)', 'rebuild_d' => 'Until it finishes the array is not fully protected.',
        'arr_ok' => 'The array is protected again', 'arr_ok_d' => 'Parity protection is back.',
        'hot' => '%s is too hot', 'warm' => '%s is running hot', 'cool' => '%s has cooled down',
        'temp' => 'Temperature', 'limits' => 'Limits', 'limits_v' => 'hot %s °C · critical %s °C', 'cool_d' => 'Now %s °C.',
        'fill' => '%s is almost full: %s%%', 'fill_c' => '%s is full: %s%%', 'fill_ok' => '%s is no longer full (%s%%)',
        'used' => 'Used', 'free' => 'Free', 'thr' => 'Limit',
        'smart_f' => '%s: SMART failure', 'smart_w' => '%s: SMART warning',
        'smart_fd' => 'The drive reported a failed health check. Back up its data and replace it.',
        'smart_wd' => 'The drive\'s SMART data shows deterioration. Keep an eye on it and plan a replacement.',
        'disk' => 'Disk', 'attrs' => 'Attributes involved', 'nvme' => 'NVMe health log',
        'pre' => 'Pre-fail', 'old' => 'Old age', 'raw' => 'raw', 'was' => 'was', 'val' => 'value', 'worst' => 'worst', 'thresh' => 'threshold',
        'failing' => 'BELOW THE THRESHOLD', 'healthfail' => 'SMART health check: FAILED',
        'smart_legend' => 'Pre-fail: a failing value predicts imminent failure. Old age: an ordinary usage or wear counter.',
        'pool_bad' => '%s pool: %s', 'pool_bad_d' => 'The pool is not ONLINE; redundancy or data may be at risk.', 'pool_ok' => 'Pool %s is ONLINE again',
        'pc_start' => '%s started', 'pc_end' => '%s finished', 'pc_cancel' => '%s cancelled', 'pc_err' => '%s finished with errors',
        'pc_check' => 'Parity check', 'pc_rebuild' => 'Disk rebuild', 'pc_sync' => 'Parity sync', 'pc_clear' => 'Disk clearing',
        'duration' => 'Duration', 'speed' => 'Speed', 'errors' => 'Errors', 'at' => 'When',
        'wk' => 'Weekly summary', 'array' => 'Array', 'hottest' => 'Hottest', 'fullest' => 'Fullest', 'lastpc' => 'Last parity check',
        'alerts7' => 'Alerts in the last 7 days', 'none' => 'none', 'smartw' => 'SMART warnings', 'table' => 'Disks',
        'protected' => 'protected', 'sample' => 'SAMPLE',
        'ack_head' => 'Acknowledged SMART warnings', 'ack_on' => 'acknowledged', 'ack_same' => 'unchanged since', 'ack_days' => '%s days ago', 'ack_today' => 'today',
        'sev' => 'Severity', 'sev_fast' => 'RAPID DETERIORATION', 'sev_slow' => 'slow deterioration', 'worse' => 'Change',
        'sev_fast_d' => 'It got worse again within a short time: this may be urgent.', 'sev_slow_d' => 'It got worse again over a longer time: keep an eye on it, not urgent.',
        'since_ack' => 'since it was acknowledged', 'since_alert' => 'since the previous alert', 'within' => 'in', 'test_t' => 'Diskbox test', 'test_d' => 'Discord notifications work.',
        'stopped' => 'stopped', 'total' => 'Total capacity',
      ],
    ];
    $s = $T[$lang][$k] ?? ($T['en'][$k] ?? $k);
    return $a ? vsprintf($s, $a) : $s;
}

// kind: 'alert' | 'resolved'
function dbn_e_array($lang, $state, $names, $kind, $extra = '') {
    $n = implode(', ', $names);
    if ($kind === 'resolved') { return dbn_embed('g', '🟢 ' . dbn_t($lang, 'arr_ok'), dbn_t($lang, 'arr_ok_d')); }
    if ($state === 'unprotected') { return dbn_embed('rd', '🔴 ' . dbn_t($lang, 'unprot'), dbn_t($lang, 'unprot_d')); }
    if ($state === 'emulated')    { return dbn_embed('rd', '🔴 ' . dbn_t($lang, 'emul', [$n]), dbn_t($lang, 'emul_d')); }
    if ($state === 'invalid')     { return dbn_embed('rd', '🔴 ' . dbn_t($lang, 'inval', [$n]), dbn_t($lang, 'inval_d')); }
    if ($state === 'rebuild' || $state === 'clear') { return dbn_embed('a', '🟡 ' . dbn_t($lang, 'rebuild', [$extra]), dbn_t($lang, 'rebuild_d')); }
    return dbn_embed('a', '🟡 ' . dbn_t($lang, 'degr'), dbn_t($lang, 'degr_d'));
}

function dbn_e_temp($lang, $label, $temp, $hot, $max, $level, $kind, $info = '') {
    if ($kind === 'resolved') { return dbn_embed('g', '🟢 ' . dbn_t($lang, 'cool', [$label]), dbn_t($lang, 'cool_d', [$temp])); }
    $t = $level === 'rd' ? dbn_t($lang, 'hot', [$label]) : dbn_t($lang, 'warm', [$label]);
    return dbn_embed($level, ($level === 'rd' ? '🔴 🌡️ ' : '🟡 🌡️ ') . $t, '', [
        [dbn_t($lang, 'temp'), $temp . ' °C', true], [dbn_t($lang, 'limits'), dbn_t($lang, 'limits_v', [(int)$hot, (int)$max]), true], [dbn_t($lang, 'disk'), $info]]);
}

function dbn_e_fill($lang, $label, $pct, $used, $size, $level, $kind) {
    $p = number_format($pct, 1, '.', '');
    if ($kind === 'resolved') { return dbn_embed('g', '🟢 ' . dbn_t($lang, 'fill_ok', [$label, $p])); }
    return dbn_embed($level, ($level === 'rd' ? '🔴 💾 ' : '🟡 💾 ') . dbn_t($lang, $level === 'rd' ? 'fill_c' : 'fill', [$label, $p]), '', [
        [dbn_t($lang, 'used'), dbn_fmt_bytes($used) . ' / ' . dbn_fmt_bytes($size), true], [dbn_t($lang, 'free'), dbn_fmt_bytes(max(0, $size - $used)), true]]);
}

// $attrs: [[id, name, prefail(bool), raw, prevraw|null, value, worst, thresh, failed(bool)], ...]
function dbn_e_smart($lang, $label, $info, $attrs, $healthFailed, $nvme, $level, $sev = '', $trend = []) {
    $lines = [];
    foreach ($attrs as $a) {
        $type = $a[2] ? dbn_t($lang, 'pre') : dbn_t($lang, 'old');
        $s = '`' . $a[0] . '` ' . $a[1] . ' · **' . $type . '** · ' . dbn_t($lang, 'raw') . ' ' . $a[3];
        if ($a[4] !== null && (int)$a[4] !== (int)$a[3]) { $s .= ' (' . dbn_t($lang, 'was') . ' ' . $a[4] . ')'; }
        $s .= ' · ' . dbn_t($lang, 'val') . ' ' . $a[5] . ' / ' . dbn_t($lang, 'worst') . ' ' . $a[6] . ' / ' . dbn_t($lang, 'thresh') . ' ' . $a[7];
        if ($a[8]) { $s .= ' · **' . dbn_t($lang, 'failing') . '**'; }
        $lines[] = $s;
    }
    $fields = [[dbn_t($lang, 'disk'), $info]];
    if ($healthFailed) { $fields[] = ['SMART', '**' . dbn_t($lang, 'healthfail') . '**']; }
    if ($lines) { $fields[] = [dbn_t($lang, 'attrs'), implode("\n", $lines)]; }
    if ($nvme) { $fields[] = [dbn_t($lang, 'nvme'), implode("\n", $nvme)]; }
    if ($trend) { array_splice($fields, 1, 0, [[dbn_t($lang, 'worse'), implode("\n", $trend)]]); }
    if ($sev !== '') { array_splice($fields, 1, 0, [[dbn_t($lang, 'sev'), '**' . dbn_t($lang, $sev === 'fast' ? 'sev_fast' : 'sev_slow') . '** · ' . dbn_t($lang, $sev === 'fast' ? 'sev_fast_d' : 'sev_slow_d')]]); }
    $fields[] = ['​', '*' . dbn_t($lang, 'smart_legend') . '*'];
    $title = ($level === 'rd' ? '🔴 ' : '🟡 ') . dbn_t($lang, $level === 'rd' ? 'smart_f' : 'smart_w', [$label]);
    if ($sev !== '') { $title .= ' · ' . dbn_t($lang, $sev === 'fast' ? 'sev_fast' : 'sev_slow'); }
    return dbn_embed($level, $title, dbn_t($lang, $level === 'rd' ? 'smart_fd' : 'smart_wd'), $fields);
}

function dbn_e_pool($lang, $label, $health, $kind) {
    if ($kind === 'resolved') { return dbn_embed('g', '🟢 ' . dbn_t($lang, 'pool_ok', [$label])); }
    return dbn_embed('rd', '🔴 ' . dbn_t($lang, 'pool_bad', [$label, $health]), dbn_t($lang, 'pool_bad_d'));
}

function dbn_pc_name($lang, $action) {
    return dbn_t($lang, ['rebuild' => 'pc_rebuild', 'sync' => 'pc_sync', 'clear' => 'pc_clear'][$action] ?? 'pc_check');
}

function dbn_e_resync_start($lang, $action) {
    return dbn_embed('i', '🔄 ' . dbn_t($lang, 'pc_start', [dbn_pc_name($lang, $action)]));
}

// $r: ['status' => int|null, 'errors' => int|null, 'duration' => seconds|null, 'speed' => text, 'date' => text]
function dbn_e_resync_end($lang, $action, $r) {
    $name = dbn_pc_name($lang, $action);
    $errs = $r['errors'];
    if ($r['status'] !== null && $r['status'] !== 0) { $lvl = 'a'; $t = '⏹️ ' . dbn_t($lang, 'pc_cancel', [$name]); }
    elseif ($errs !== null && $errs > 0) { $lvl = 'rd'; $t = '🔴 ' . dbn_t($lang, 'pc_err', [$name]); }
    else { $lvl = 'g'; $t = '✅ ' . dbn_t($lang, 'pc_end', [$name]); }
    return dbn_embed($lvl, $t, '', [
        [dbn_t($lang, 'duration'), $r['duration'] !== null ? dbn_fmt_dur($r['duration']) : '', true],
        [dbn_t($lang, 'speed'), (string)$r['speed'], true],
        [dbn_t($lang, 'errors'), $errs !== null ? (string)$errs : '', true]]);
}

// Last line of Unraid's parity history: date|seconds|speed|exit status|errors|...
function dbn_last_parity() {
    $f = '/boot/config/parity-checks.log';
    $res = ['status' => null, 'errors' => null, 'duration' => null, 'speed' => '', 'date' => ''];
    if (!is_file($f)) { return $res; }
    $lines = array_values(array_filter(array_map('trim', (array)@file($f, FILE_IGNORE_NEW_LINES))));
    if (!$lines) { return $res; }
    $p = explode('|', end($lines));
    if (count($p) >= 5) {
        $res['date'] = trim($p[0]);
        $res['duration'] = is_numeric($p[1]) ? (int)$p[1] : null;
        $res['speed'] = is_numeric(trim($p[2])) && (float)$p[2] > 0 ? dbn_fmt_bytes((float)$p[2]) . '/s' : trim($p[2]);   // bytes per second in the log
        $res['status'] = is_numeric($p[3]) ? (int)$p[3] : null;
        $res['errors'] = is_numeric($p[4]) ? (int)$p[4] : null;
    }
    return $res;
}

// Result of the check that just ended: md's own fields in var.ini are set the moment it stops; the line in
// parity-checks.log can come later, and reading it too early reported the previous check (2026-10-15)
function dbn_resync_result($v) {
    $t0 = (int)($v['sbSynced'] ?? 0); $t1 = (int)($v['sbSynced2'] ?? 0);
    if ($t1 > $t0 && $t0 > 0 && $t1 >= time() - 6 * 3600 && isset($v['sbSyncErrs'])) {
        $d = $t1 - $t0; $size = (float)($v['mdResyncSize'] ?? 0) * 1024;
        return ['status' => (int)($v['sbSyncExit'] ?? 0), 'errors' => (int)$v['sbSyncErrs'], 'duration' => $d,
                'speed' => $size > 0 && $d > 0 ? dbn_fmt_bytes($size / $d) . '/s' : '', 'date' => date('Y-m-d H:i', $t1)];
    }
    return dbn_last_parity();
}

// $j: api_fetch.php output; $st: alert state
function dbn_e_weekly($lang, $j, $st, $smartWarn, $ackLines = []) {
    $arr = $j['array'] ?? [];
    $rows = [];
    foreach (array_merge($arr['parity'] ?? [], $arr['disks'] ?? [], $j['pools'] ?? []) as $r) { $rows[] = $r; }
    $tbl = [];
    $hot = null; $full = null;
    foreach ($rows as $r) {
        $line = str_pad($r['label'], 8) . str_pad($r['pct'] !== null ? number_format($r['pct'], 1, '.', '') . '%' : '', 8) . ($r['temp'] !== null ? $r['temp'] . ' °C' : '');
        $tbl[] = rtrim($line);
        if ($r['temp'] !== null && ($hot === null || $r['temp'] > $hot['temp'])) { $hot = $r; }
        if ($r['pct'] !== null && ($full === null || $r['pct'] > $full['pct'])) { $full = $r; }
    }
    $cut = time() - 7 * 86400; $n = 0;
    foreach ($st['log'] ?? [] as $x) { if ($x[0] >= $cut) { $n++; } }
    $pc = dbn_last_parity();
    $pcText = $pc['date'] !== '' ? $pc['date'] . ($pc['errors'] !== null ? ' · ' . dbn_t($lang, 'errors') . ': ' . $pc['errors'] : '') : '–';
    $chip = (string)($arr['chip'][1] ?? '');
    $sum = $j['summary'] ?? [];
    return dbn_embed($chip !== '' && ($arr['chip'][0] ?? '') === 'g' ? 'g' : (($arr['chip'][0] ?? '') === 'rd' ? 'rd' : 'i'), '📊 ' . dbn_t($lang, 'wk'), '```' . "\n" . implode("\n", $tbl) . "\n" . '```', [
        [dbn_t($lang, 'array'), $chip, true],
        [dbn_t($lang, 'used'), dbn_fmt_bytes($sum['used'] ?? 0) . ' / ' . dbn_fmt_bytes($sum['size'] ?? 0), true],
        [dbn_t($lang, 'hottest'), $hot ? $hot['label'] . ' · ' . $hot['temp'] . ' °C' : '–', true],
        [dbn_t($lang, 'fullest'), $full ? $full['label'] . ' · ' . number_format($full['pct'], 1, '.', '') . '%' : '–', true],
        [dbn_t($lang, 'smartw'), $smartWarn > 0 ? (string)$smartWarn : dbn_t($lang, 'none'), true],
        [dbn_t($lang, 'alerts7'), $n > 0 ? (string)$n : dbn_t($lang, 'none'), true],
        [dbn_t($lang, 'lastpc'), $pcText],
        [dbn_t($lang, 'ack_head'), $ackLines ? implode("\n", $ackLines) : '']], dbn_t($lang, 'wk'));
}

// Builds the weekly summary from the live data; null when the data is not available
function dbn_weekly_now($cfg) {
    $raw = (string)@shell_exec(escapeshellarg(db_php()) . ' ' . escapeshellarg(__DIR__ . '/api_fetch.php') . ' 2>/dev/null');
    $j = json_decode($raw, true);
    if (!is_array($j) || empty($j['ok'])) { return null; }
    $sw = 0;
    $ack = db_ack();
    foreach (db_smart() as $nm => $s) { $i = db_smart_issues($nm, $s, $ack); if ($i['attrs'] || $i['nvme'] || $i['health']) { $sw++; } }
    // warnings that were acknowledged and have not changed since: still on the disk, so the summary lists them
    $lang = dbn_lang($cfg);
    $smart = db_smart(); $dk = db_disks(); $lines = [];
    foreach ($ack as $nm => $ae) {
        if (!isset($dk[$nm]) || !isset($smart[$nm])) { continue; }
        $days = (int)floor((time() - (int)($ae['t'] ?? 0)) / 86400);
        $when = date('Y-m-d', (int)($ae['t'] ?? 0)) . ' (' . ($days > 0 ? dbn_t($lang, 'ack_days', [$days]) : dbn_t($lang, 'ack_today')) . ')';
        foreach ($smart[$nm]['attrs'] ?? [] as $x) {
            $base = $ae['raw'][(string)$x[0]] ?? null;
            if ($base === null || (int)$x[3] <= 0 || (int)$x[3] > (int)$base) { continue; }
            $lines[] = '**' . strtoupper($nm) . '** · `' . $x[0] . '` ' . $x[1] . ' · ' . ($x[2] ? dbn_t($lang, 'pre') : dbn_t($lang, 'old')) . ' · ' . dbn_t($lang, 'raw') . ' ' . $x[3] . ' · ' . dbn_t($lang, 'ack_on') . ' ' . $when . ' · ' . dbn_t($lang, 'ack_same');
        }
    }
    return dbn_e_weekly($lang, $j, dbn_state(), $sw, $lines);
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD ALERTS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/notify.php">
<INLINE><![CDATA[<?php
// Started by cron every minute: Discord alerts for the array, temperatures, SMART, fill level, pools and parity checks.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/discord.php';
require_once __DIR__ . '/alerts.php';

$cfg = db_cfg();
$hook = (string)$cfg['dc_hook'];
if (!dbn_hook_ok($hook)) { exit(0); }
$lock = @fopen('/tmp/diskbox_notify.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

// Same data and classification as the dashboard tile
$raw = (string)@shell_exec(escapeshellarg(db_php()) . ' ' . escapeshellarg(__DIR__ . '/api_fetch.php') . ' 2>/dev/null');
$j = json_decode($raw, true);
if (!is_array($j) || empty($j['ok']) || empty($j['started'])) { exit(0); }

$lang = dbn_lang($cfg);
dbn_ping_set($cfg['dc_ping']);
$st = dbn_state(); $st0 = json_encode($st);
$tm = dbn_tmp();
$remind = max(0, (int)$cfg['n_remind']);
$thr = db_thr($cfg);
$now = time();
$dk = db_disks();
$arr = $j['array'];

// ---- array protection ----------------------------------------------------------------------------
if (db_on($cfg['n_array'])) {
    $state = (string)$arr['state'];
    $level = '';
    if (in_array($state, ['unprotected', 'emulated', 'invalid'], true)) { $level = 'rd'; }
    elseif (in_array($state, ['degraded', 'rebuild', 'clear'], true)) { $level = 'a'; }
    $names = [];
    foreach ($arr['disks'] as $r) {
        if (($state === 'emulated' && !empty($r['emulated'])) || ($state === 'invalid' && $r['state'] === 'invalid')) { $names[] = $r['label']; }
    }
    $extra = '';
    foreach ((array)($j['array']['chip'] ?? []) as $c) { $extra = (string)$c; }
    dbn_track($st, $tm, 'array', $level, $state . '|' . implode(',', $names),
        function ($kind) use ($lang, $state, $names, $extra) { return dbn_e_array($lang, $state, $names, $kind, $extra); }, $hook, ['remind' => $remind]);
}

// ---- temperature, fill level, pools --------------------------------------------------------------
$rows = [];
foreach ($arr['parity'] as $r) { $rows[] = $r; }
foreach ($arr['disks'] as $r) { $rows[] = $r; }
foreach ($j['pools'] as $r) { $rows[] = $r; }
$fw = (float)$cfg['n_fill_warn']; $fc = (float)$cfg['n_fill_crit'];
foreach ($rows as $r) {
    $name = $r['name']; $label = $r['label'];
    $d = $dk[$name] ?? [];
    $info = trim((string)($d['id'] ?? '') . (isset($d['device']) ? ' (' . $d['device'] . ')' : ''));
    $ssd = (($d['rotational'] ?? '1') === '0');

    if (db_on($cfg['n_temp']) && $r['temp'] !== null) {
        $hot = $ssd ? $thr['hotssd'] : $thr['hot']; $max = $ssd ? $thr['maxssd'] : $thr['max'];
        $lv = ($r['tlevel'] === 'rd') ? 'rd' : (($r['tlevel'] === 'a') ? 'a' : '');
        $prev = dbn_cur_level($st, 'temp:' . $name);
        if ($lv === '' && $prev !== '' && $hot > 0 && $r['temp'] >= $hot - 2) { $lv = $prev; }   // cool down 2 degrees before the all-clear
        $t = (int)$r['temp'];
        dbn_track($st, $tm, 'temp:' . $name, $lv, '', function ($kind) use ($lang, $label, $t, $hot, $max, $lv, $info) {
            return dbn_e_temp($lang, $label, $t, $hot, $max, $lv, $kind, $info);
        }, $hook, ['need' => 3, 'remind' => $remind]);
    }

    if (db_on($cfg['n_fill']) && $r['pct'] !== null) {
        $pct = (float)$r['pct'];
        $prev = dbn_cur_level($st, 'fill:' . $name);
        $lv = ($fc > 0 && $pct >= $fc) ? 'rd' : (($fw > 0 && $pct >= $fw) ? 'a' : '');
        if ($lv === '' && $prev !== '' && $fw > 0 && $pct >= $fw - 2) { $lv = $prev; }
        // a disk being zeroed for removal: pct is the zeroing progress, not the fill level, so no fill alert;
        // an alert still open from such a reading is dropped without an all-clear message
        $zeroing = (($r['zero'] ?? '') !== '');
        if ($zeroing) { $lv = ''; }
        $used = (float)$r['used']; $size = (float)$r['size'];
        dbn_track($st, $tm, 'fill:' . $name, $lv, '', function ($kind) use ($lang, $label, $pct, $used, $size, $lv) {
            return dbn_e_fill($lang, $label, $pct, $used, $size, $lv, $kind);
        }, $hook, ['need' => 2, 'remind' => 0, 'resolve' => !$zeroing]);
    }

    if (db_on($cfg['n_pool']) && $r['kind'] === 'pool') {
        $bad = (!empty($r['health'][0]) && $r['health'][0] === 'rd' && strpos((string)$r['health'][1], 'ZFS pool') === 0);
        $htxt = $bad ? trim(substr((string)$r['health'][1], 8)) : '';
        dbn_track($st, $tm, 'pool:' . $name, $bad ? 'rd' : '', $htxt, function ($kind) use ($lang, $label, $htxt) {
            return dbn_e_pool($lang, $label, $htxt, $kind);
        }, $hook, ['need' => 2, 'remind' => $remind]);
    }
}

// ---- SMART ----------------------------------------------------------------------------------------
if (db_on($cfg['n_smart'])) {
    $ackAll = db_ack();
    foreach (db_smart() as $name => $s) {
        if (!isset($dk[$name]) || !is_array($s)) { continue; }
        $d = $dk[$name];
        $label = strtoupper($name);
        $info = trim((string)($d['id'] ?? '') . (isset($d['device']) ? ' (' . $d['device'] . ')' : ''));
        $iss = db_smart_issues($name, $s, $ackAll);
        $healthFailed = $iss['health'];
        $nvme = $iss['nvme'];
        $failedAttr = false; $sig = [];
        $last = $st['misc']['smart_last'][$name] ?? null;        // what the previous alert for this disk showed
        $ackT = (int)($ackAll[$name]['t'] ?? 0);
        $out = []; $trend = []; $fast = false; $slow = false;
        foreach ($iss['attrs'] as $a) {
            if ($a[7]) { $failedAttr = true; }
            $sig[] = $a[0] . ':' . $a[3];
            // reference: the previous alert if it already showed this attribute, else the acknowledged value
            $was = null; $refT = 0; $refName = '';
            if (is_array($last) && (int)$last['t'] >= $ackT && isset($last['raw'][(string)$a[0]]) && (int)$last['raw'][(string)$a[0]] <= (int)$a[3]) { $was = (int)$last['raw'][(string)$a[0]]; $refT = (int)$last['t']; $refName = 'since_alert'; }
            elseif ($a[8] !== null) { $was = (int)$a[8]; $refT = $ackT; $refName = 'since_ack'; }
            $out[] = [$a[0], $a[1], $a[2], $a[3], $was, $a[4], $a[5], $a[6], $a[7]];
            if ($was !== null && $a[3] > $was && $refT > 0) {
                $dl = $a[3] - $was; $age = max(60, $now - $refT);
                $trend[] = '`' . $a[0] . '` +' . $dl . ' ' . dbn_t($lang, 'within') . ' ' . dbn_fmt_dur($age) . ' (' . dbn_t($lang, $refName) . ')';
                if ($age <= 7 * 86400 || $dl >= 10) { $fast = true; } else { $slow = true; }
            }
        }
        $sev = $fast ? 'fast' : ($slow ? 'slow' : '');
        if ($healthFailed) { $sig[] = 'FAIL'; }
        foreach ($nvme as $nv) { $sig[] = $nv; }
        $lv = ($sig) ? (($healthFailed || $failedAttr || $fast) ? 'rd' : 'a') : '';
        $before = (int)($st['k']['smart:' . $name]['t'] ?? 0);
        dbn_track($st, $tm, 'smart:' . $name, $lv, implode(',', $sig), function ($kind) use ($lang, $label, $info, $out, $healthFailed, $nvme, $lv, $sev, $trend) {
            return dbn_e_smart($lang, $label, $info, $out, $healthFailed, $nvme, $lv, $sev, $trend);
        }, $hook, ['resolve' => false, 'remind' => $remind]);
        if ($lv !== '' && (int)($st['k']['smart:' . $name]['t'] ?? 0) !== $before) {   // an alert went out: remember what it showed
            $lr = [];
            foreach ($iss['attrs'] as $a) { $lr[(string)$a[0]] = $a[3]; }
            $st['misc']['smart_last'][$name] = ['t' => $now, 'raw' => $lr];
        }
    }
}

// ---- parity check / rebuild -----------------------------------------------------------------------
if (db_on($cfg['n_parity'])) {
    $v = db_var();
    $now = ((float)($v['mdResync'] ?? 0) > 0);
    $act = db_resync_kind($v['mdResyncAction'] ?? 'check')[0];
    $was = $st['misc']['resync'] ?? '';
    if ($now && $was === '') {
        $r = dbn_post($hook, [dbn_e_resync_start($lang, $act)]);
        if ($r[0] !== 'retry') { $st['misc']['resync'] = $act; }
    } elseif (!$now && $was !== '') {
        $pcr = dbn_resync_result($v);
        $emb = dbn_e_resync_end($lang, $was, $pcr); $bad = $pcr['errors'] !== null && $pcr['errors'] > 0;
        $r = dbn_post($hook, [$emb], $bad ? dbn_ping_set() : '');
        if ($r[0] !== 'retry') { unset($st['misc']['resync']); dbn_log($st, 'parity', 'i'); if ($bad) { dbn_guard_event('parity_end', 'rd', $emb); } }
    }
}

if (json_encode($st) !== $st0) { dbn_write(DBN_STATE, $st); }
dbn_write(DBN_TMP, $tm);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD WEEKLY -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/weekly.php">
<INLINE><![CDATA[<?php
// Started by cron every hour: sends the weekly summary once, on the chosen day, from the chosen hour.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/discord.php';
require_once __DIR__ . '/alerts.php';

$cfg = db_cfg();
$hook = (string)$cfg['dc_hook'];
if (!dbn_hook_ok($hook) || !db_on($cfg['wk_on'])) { exit(0); }
if ((int)date('N') !== (int)$cfg['wk_day'] || (int)date('G') < (int)$cfg['wk_hour']) { exit(0); }
$lock = @fopen('/tmp/diskbox_weekly.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

$st = dbn_state();
$week = date('o-W');
if (($st['misc']['wk_last'] ?? '') === $week) { exit(0); }
$e = dbn_weekly_now($cfg);
if ($e === null) { exit(0); }
$r = dbn_post($hook, [$e]);
if ($r[0] === 'retry') { exit(0); }
$st['misc']['wk_last'] = $week;
dbn_write(DBN_STATE, $st);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DISCORD TEST -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/test.php">
<INLINE><![CDATA[<?php
// Test and sample messages for the Discord alerts. POST op=test|sample|weekly (uses the saved settings).
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/discord.php';
require_once __DIR__ . '/alerts.php';
require_once __DIR__ . '/i18n.php';
$dbx_T = mt_i18n_t(__DIR__ . '/lang');   // texts shown on the settings page (lang/en.json)
header('Content-Type: application/json');
header('Cache-Control: no-store');

function dbt_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra), JSON_UNESCAPED_UNICODE); exit; }

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); dbt_out(false, ['error' => 'method']); }
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); dbt_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); dbt_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}

$cfg = db_cfg();
$hook = (string)$cfg['dc_hook'];
if (!dbn_hook_ok($hook)) { dbt_out(false, ['error' => $dbx_T('test.no_hook')]); }
$lang = dbn_lang($cfg);
$op = (string)($_POST['op'] ?? 'test');

if ($op === 'weekly') {
    $e = dbn_weekly_now($cfg);
    if ($e === null) { dbt_out(false, ['error' => $dbx_T('test.no_data')]); }
    $r = dbn_post($hook, [$e]);
    dbt_out($r[0] === 'ok', $r[0] === 'ok' ? [] : ['error' => $r[1]]);
}

if ($op === 'sample') {
    $tag = '[' . dbn_t($lang, 'sample') . '] ';
    $pre = function ($e) use ($tag) { $e['title'] = $tag . $e['title']; return $e; };
    $attrs = [
        [5, 'Reallocated_Sector_Ct', true, 8, 0, 98, 98, 10, false],
        [197, 'Current_Pending_Sector', false, 2, null, 100, 100, 0, false],
        [199, 'UDMA_CRC_Error_Count', false, 14, 3, 200, 200, 0, false],
    ];
    $emb = [
        dbn_e_array($lang, 'emulated', ['DISK2'], 'alert'),
        dbn_e_temp($lang, 'DISK1', 52, 45, 55, 'a', 'alert', 'ST16000NM001G-2KK103_WL2XXXXX (sdb)'),
        dbn_e_fill($lang, 'DISK1', 95.4, 15.2e12, 16e12, 'rd', 'alert'),
        dbn_e_smart($lang, 'DISK3', 'WDC_WD30EFRX-68EUZN0_WD-WCCXXXXX (sdd)', $attrs, false, [], 'a'),
        dbn_e_smart($lang, 'DISK1', 'ST16000NT001-3LV101_ZR000000 (sde)', [[187, 'Reported_Uncorrect', false, 5, 2, 95, 95, 0, false]], false, [], 'rd', 'fast', ['`187` +3 ' . dbn_t($lang, 'within') . ' 1 d 4 h (' . dbn_t($lang, 'since_ack') . ')']),
        dbn_e_smart($lang, 'DISK1', 'ST16000NT001-3LV101_ZR000000 (sde)', [[187, 'Reported_Uncorrect', false, 3, 2, 97, 97, 0, false]], false, [], 'a', 'slow', ['`187` +1 ' . dbn_t($lang, 'within') . ' 412 d (' . dbn_t($lang, 'since_ack') . ')']),
        dbn_e_pool($lang, 'CACHE', 'DEGRADED', 'alert'),
        dbn_e_resync_end($lang, 'check', ['status' => 0, 'errors' => 0, 'duration' => 71505, 'speed' => '56.1 MB/s', 'date' => '']),
        dbn_e_array($lang, 'ok', [], 'resolved'),
    ];
    foreach ($emb as $e) {
        $r = dbn_post($hook, [$pre($e)]);
        if ($r[0] !== 'ok') { dbt_out(false, ['error' => $r[1]]); }
    }
    dbt_out(true);
}

$r = dbn_post($hook, [dbn_embed('i', '✅ ' . dbn_t($lang, 'test_t'), dbn_t($lang, 'test_d'))], dbn_ping_text($cfg['dc_ping']));
dbt_out($r[0] === 'ok', $r[0] === 'ok' ? [] : ['error' => $r[1]]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- ACKNOWLEDGE -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/ack.php">
<INLINE><![CDATA[<?php
// Acknowledge (or forget) the SMART warnings of one disk. POST name=<disk>&op=ack|forget
require_once __DIR__ . '/lib.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function dba_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra), JSON_UNESCAPED_UNICODE); exit; }

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); dba_out(false, ['error' => 'method']); }
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); dba_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); dba_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}

$name = (string)($_POST['name'] ?? '');
$op = (string)($_POST['op'] ?? '');
$disks = db_disks();
if (!preg_match('/^[A-Za-z0-9_]{1,32}$/', $name) || !isset($disks[$name])) { http_response_code(400); dba_out(false, ['error' => 'unknown disk']); }
$ack = db_ack();

if ($op === 'forget') {
    unset($ack[$name]);
    dba_out(db_ack_write($ack));
}
if ($op !== 'ack') { http_response_code(400); dba_out(false, ['error' => 'unknown action']); }

$s = db_smart()[$name] ?? null;
if (!is_array($s)) { dba_out(false, ['error' => 'no SMART data for this disk yet']); }
$raw = [];
foreach ($s['attrs'] ?? [] as $x) { $raw[(string)$x[0]] = (int)$x[3]; }
$ack[$name] = ['t' => time(), 'raw' => $raw, 'nvme' => [
    'warn' => (int)($s['nvme_warn'] ?? 0), 'media' => (int)($s['nvme_media'] ?? 0), 'used' => (int)($s['nvme_used'] ?? 0)]];
dba_out(db_ack_write($ack));
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- README -->
<!-- ========================================================= -->
<FILE Name="/usr/local/emhttp/plugins/Diskbox/README.md">
<INLINE><![CDATA[**Diskbox** replaces the Disk Viewer dashboard tile with a native-looking one: the array as a single card with its protection state, a parity row that turns amber during a parity check or rebuild and red when protection is lost or a disk is emulated, every data disk and pool with usage, temperature and SMART health, and a Needs attention list for full, hot or failing disks.

Settings: Settings, Utilities, Diskbox (or the gear icon on the tile).
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SHARED LANGUAGE SETTING -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/lang.php">
<INLINE><![CDATA[<?php
// Shared language setting of the media server tools (Sysbox, Diskbox, Seedbox, Streambox): one file on the
// flash drive that every plugin reads, so changing it on any settings page changes it for all of them.
//   ui      = auto (follow Unraid's language, Settings, Display Settings) | en | hu
//   discord = auto (follow Unraid) | en | hu
// A language the pages or Discord are not translated to falls back to English. Every plugin ships its own
// copy of this file; the guard keeps a second copy from being declared again in the same request.
if (!function_exists('mt_lang_cfg')) {

define('MT_LANG_FILE', '/boot/config/plugins/mediaserver-tools/lang.cfg');

function mt_lang_have($what) { return ['en', 'hu']; }

// Unraid's display language as a locale ('' = English, the built-in one)
function mt_lang_unraid() {
    $d = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true);
    return (is_array($d) && isset($d['display']) && is_array($d['display'])) ? trim((string)($d['display']['locale'] ?? '')) : '';
}
function mt_lang_code($locale) { $c = strtolower(substr((string)$locale, 0, 2)); return preg_match('/^[a-z]{2}$/', $c) ? $c : 'en'; }
function mt_lang_name($code) {
    $n = ['en' => 'English', 'hu' => 'Magyar', 'de' => 'Deutsch', 'fr' => 'Français', 'es' => 'Español', 'it' => 'Italiano', 'nl' => 'Nederlands',
          'pl' => 'Polski', 'pt' => 'Português', 'ru' => 'Русский', 'zh' => '中文', 'ja' => '日本語', 'ko' => '한국어', 'cs' => 'Čeština', 'sv' => 'Svenska'];
    return $n[$code] ?? $code;
}

// Before the shared setting existed every plugin had its own Discord language, Hungarian by default: a server
// that already sends Discord messages keeps the language it had; a new install starts in English.
function mt_lang_legacy() {
    $ini = function ($f) { $c = is_file($f) ? @parse_ini_file($f, false, INI_SCANNER_RAW) : false; return is_array($c) ? $c : null; };
    foreach (['/boot/config/plugins/sysbox/settings.cfg', '/boot/config/plugins/diskbox/settings.cfg'] as $f) {
        $c = $ini($f);
        if ($c === null) { continue; }
        if (isset($c['dc_lang'])) { return trim((string)$c['dc_lang'], "\"' ") === 'en' ? 'en' : 'hu'; }
        if (trim((string)($c['dc_hook'] ?? ''), "\"' ") !== '') { return 'hu'; }
    }
    $j = @json_decode((string)@file_get_contents('/boot/config/plugins/qbittorrent_widget/tools.json'), true);
    if (is_array($j)) {
        if (isset($j['dc_lang'])) { return $j['dc_lang'] === 'en' ? 'en' : 'hu'; }
        if (trim((string)($j['dc_hook'] ?? '')) !== '') { return 'hu'; }
    }
    $c = $ini('/boot/config/plugins/streambox/settings.cfg');
    if ($c !== null && (trim((string)($c['dc_movies'] ?? ''), "\"' ") !== '' || trim((string)($c['dc_series'] ?? ''), "\"' ") !== '')) { return 'hu'; }
    return 'en';
}

function mt_lang_cfg() {
    $c = ['ui' => 'auto', 'discord' => ''];
    $f = is_file(MT_LANG_FILE) ? @parse_ini_file(MT_LANG_FILE) : false;
    if (is_array($f)) {
        if (($f['ui'] ?? '') === 'auto' || in_array($f['ui'] ?? '', mt_lang_have('ui'), true)) { $c['ui'] = $f['ui']; }
        if (in_array($f['discord'] ?? '', ['auto', 'en', 'hu'], true)) { $c['discord'] = $f['discord']; }
    }
    if ($c['discord'] === '') { $c['discord'] = mt_lang_legacy(); }
    return $c;
}

// The language the pages and tiles ask for (the dictionaries of i18n.php fall back to English per text)
function mt_lang_ui_want() {
    $c = mt_lang_cfg();
    return $c['ui'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['ui'];
}
// The language the pages and tiles use, and the one Discord messages use (always one that exists)
function mt_lang_ui() {
    $c = mt_lang_cfg();
    $w = $c['ui'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['ui'];
    return in_array($w, mt_lang_have('ui'), true) ? $w : 'en';
}
function mt_lang_discord() {
    static $l = null;
    if ($l !== null) { return $l; }
    $c = mt_lang_cfg();
    $w = $c['discord'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['discord'];
    return $l = in_array($w, mt_lang_have('discord'), true) ? $w : 'en';
}

function mt_lang_save($ui, $discord) {
    if (($ui !== 'auto' && !in_array($ui, mt_lang_have('ui'), true)) || !in_array($discord, ['auto', 'en', 'hu'], true)) { return false; }
    @mkdir(dirname(MT_LANG_FILE), 0777, true);
    $tmp = MT_LANG_FILE . '.tmp';
    if (@file_put_contents($tmp, 'ui="' . $ui . "\"\ndiscord=\"" . $discord . "\"\n") === false) { return false; }
    return @rename($tmp, MT_LANG_FILE);
}

}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- LANGUAGE BLOCK OF THE SETTINGS PAGE -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/lang_block.php">
<INLINE><![CDATA[<?php
// The Language block of every settings page (Sysbox, Diskbox, Seedbox Tools, Streambox): the shared setting of
// lang.php. The page sets $mt_lang_post (this plugin's lang_save.php) and includes this file.
require_once __DIR__ . '/lang.php';
$mtl_c = mt_lang_cfg();
$mtl_u = mt_lang_code(mt_lang_unraid());
$mtl_var = @parse_ini_file('/var/local/emhttp/var.ini');
$mtl_tok = is_array($mtl_var) ? (string)($mtl_var['csrf_token'] ?? '') : '';
$mtl_ui_now = in_array($mtl_u, mt_lang_have('ui'), true) ? mt_lang_name($mtl_u) : mt_lang_name($mtl_u) . ', shown in English';
$mtl_dc_now = in_array($mtl_u, mt_lang_have('discord'), true) ? mt_lang_name($mtl_u) : mt_lang_name($mtl_u) . ', sent in English';
$mtl_h = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES); };
$mtl_sel = function ($a, $b) { return $a === $b ? ' selected' : ''; };
?>
<style>
#mtl{margin:28px 0 8px;max-width:1100px}
#mtl .mtl-band{display:flex;justify-content:space-between;align-items:center;gap:12px;background:rgba(0,0,0,.35);padding:10px 14px;text-transform:uppercase;letter-spacing:1.5px;font-size:12px}
#mtl .mtl-band b{font-weight:normal;text-transform:none;letter-spacing:0;opacity:.6}
#mtl .mtl-box{background:rgba(128,128,128,.08);border-radius:0 0 6px 6px}
#mtl .mtl-row{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px;padding:14px 16px;border-left:3px solid #8a8a8a;border-bottom:1px solid rgba(128,128,128,.15)}
#mtl .mtl-row label{padding-top:6px}
#mtl .mtl-row select{width:auto;min-width:260px;max-width:100%;margin:0}
#mtl .mtl-hint{display:block;opacity:.6;line-height:1.5;margin-top:6px;white-space:normal}
#mtl .mtl-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px}
#mtl .mtl-foot button{margin:0}
@media (max-width:700px){#mtl .mtl-row{grid-template-columns:1fr;gap:4px}}
</style>
<div id="mtl">
  <div class="mtl-band"><span>Language</span><b>shared by Sysbox, Diskbox, Seedbox and Streambox</b></div>
  <div class="mtl-box">
    <div class="mtl-row">
      <label for="mtl-ui">Pages and tiles:</label>
      <div>
        <select id="mtl-ui">
          <option value="auto"<?=$mtl_sel($mtl_c['ui'], 'auto')?>>Follow Unraid (now: <?=$mtl_h($mtl_ui_now)?>)</option>
          <option value="en"<?=$mtl_sel($mtl_c['ui'], 'en')?>>English</option>
          <option value="hu"<?=$mtl_sel($mtl_c['ui'], 'hu')?>>Magyar</option>
        </select>
        <span class="mtl-hint">Unraid's language is set under Settings, Display Settings. A language the plugins are not translated to yet shows in English. More languages come here as they are translated.</span>
      </div>
    </div>
    <div class="mtl-row">
      <label for="mtl-dc">Discord messages:</label>
      <div>
        <select id="mtl-dc">
          <option value="auto"<?=$mtl_sel($mtl_c['discord'], 'auto')?>>Follow Unraid (now: <?=$mtl_h($mtl_dc_now)?>)</option>
          <option value="en"<?=$mtl_sel($mtl_c['discord'], 'en')?>>English</option>
          <option value="hu"<?=$mtl_sel($mtl_c['discord'], 'hu')?>>Magyar</option>
        </select>
        <span class="mtl-hint">Every message of the four plugins: alerts, weekly summaries, new movies and series, the Discord bot. Movie and series titles stay as Jellyfin and Sonarr give them.</span>
      </div>
    </div>
    <div class="mtl-foot">
      <span id="mtl-msg" class="mtl-hint" style="margin:0">Saved for all plugins at once.</span>
      <button type="button" id="mtl-apply">Save language</button>
    </div>
  </div>
</div>
<script>
$(function () {
  // Unraid disables the Apply buttons of a page until its form changes: this block is outside every form, so it is a
  // button of its own name, enabled here (also after Unraid's own page scripts ran)
  var en = function () { $('#mtl-apply').prop('disabled', false).removeAttr('disabled'); };
  en(); setTimeout(en, 500); $('#mtl-ui, #mtl-dc').on('change', en);
  $('#mtl-apply').on('click', function () {
    var $b = $(this).prop('disabled', true), $m = $('#mtl-msg');
    $.post(<?=json_encode((string)$mt_lang_post)?>, { ui: $('#mtl-ui').val(), discord: $('#mtl-dc').val(), csrf_token: <?=json_encode($mtl_tok)?> }, null, 'json')
      .done(function (r) { $m.css({ color: r.ok ? '#3fa24a' : '#e5534b', opacity: 1 }).text(r.ok ? 'Saved for Sysbox, Diskbox, Seedbox and Streambox.' : (r.error || 'Not saved')); })
      .fail(function (x) { $m.css({ color: '#e5534b', opacity: 1 }).text((x.responseJSON && x.responseJSON.error) || 'Not saved'); })
      .always(function () { $b.prop('disabled', false); });
  });
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- LANGUAGE SAVE -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/lang_save.php">
<INLINE><![CDATA[<?php
// Saves the shared language setting (see lang.php). POST ui, discord, csrf_token.
require_once __DIR__ . '/lang.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function mt_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra)); exit; }
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); mt_out(false, ['error' => 'method']); }
$var = @parse_ini_file('/var/local/emhttp/var.ini');
$tok = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
// Unraid's own prepend checks the token of every POST and then removes it from $_POST: no token here means it was
// checked already, which is accepted for an AJAX request only (like the other endpoints of these plugins)
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); mt_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); mt_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}
if (!mt_lang_save((string)($_POST['ui'] ?? ''), (string)($_POST['discord'] ?? ''))) { mt_out(false, ['error' => 'could not save the language setting']); }
mt_out(true);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- DICTIONARIES -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/i18n.php">
<INLINE><![CDATA[<?php
// Dictionaries of the pages and tiles. Each plugin keeps its texts in <plugdir>/lang/<code>.json:
// en.json is the source (every key, with a note for the translator), <code>.json a translation of it.
// The language is the shared setting of lang.php (Follow Unraid or a chosen one); a missing file, key or
// form falls back to English, so a partial translation never breaks a page.
//   entry:        "key": {"text": "Hide", "note": "button ..."}
//   plural entry: "key": {"one": "{n} torrent", "other": "{n} torrents", "note": "..."}
//   placeholders: {name} in the text, filled from $vars / vars
// PHP: $T = mt_i18n_t('/usr/local/emhttp/plugins/<id>/lang'); echo $T('key', ['n' => 3]);
// JS:  echo mt_i18n_js($dir, 'mon'); then MTL.t('mon', 'key', {n: 3}) (pages wrap it as T('key'))
if (!function_exists('mt_i18n')) {

require_once __DIR__ . '/lang.php';

function mt_i18n($dir) {
    static $cache = [];
    if (isset($cache[$dir])) { return $cache[$dir]; }
    $read = function ($f) { $j = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null; return is_array($j) ? $j : []; };
    $en = $read($dir . '/en.json');
    $code = function_exists('mt_lang_ui_want') ? mt_lang_ui_want() : mt_lang_ui();   // an older lang.php of another plugin may have been loaded first
    $tr = $code !== 'en' && preg_match('/^[a-z]{2}$/', $code) ? $read($dir . '/' . $code . '.json') : [];
    $out = [];
    foreach ($en as $k => $v) {
        if ($k === '' || $k[0] === '_' || !is_array($v)) { continue; }
        $e = [];
        foreach (['text', 'one', 'other'] as $f) {
            if (!isset($v[$f])) { continue; }
            $t = $tr[$k][$f] ?? null;
            $e[$f] = (is_string($t) && trim($t) !== '') ? $t : (string)$v[$f];
        }
        $out[$k] = $e;
    }
    return $cache[$dir] = $out;
}

function mt_i18n_fmt($e, $vars) {
    if ($e === null) { return null; }
    if (isset($e['other'])) { $n = (float)($vars['n'] ?? 0); $s = (abs($n) == 1 && isset($e['one'])) ? $e['one'] : $e['other']; }
    else { $s = $e['text'] ?? ''; }
    return preg_replace_callback('/\{([a-z0-9_]+)\}/', function ($m) use ($vars) { return array_key_exists($m[1], $vars) ? (string)$vars[$m[1]] : $m[0]; }, $s);
}

// a translate function for one plugin's dictionary; an unknown key shows as itself (easy to spot)
function mt_i18n_t($dir) {
    $tab = mt_i18n($dir);
    return function ($key, $vars = []) use ($tab) { $s = mt_i18n_fmt($tab[$key] ?? null, (array)$vars); return $s === null ? $key : $s; };
}

// the same dictionary for the page's JavaScript: MTL.t(name, key, vars). $only limits it to some keys (a tile on the
// Dashboard or a header button does not need the texts of the tool pages): 'group.' takes every key that starts with
// it, anything else one exact key
function mt_i18n_js($dir, $name, $only = null) {
    $tab = mt_i18n($dir);
    if (is_array($only)) {
        $tab = array_filter($tab, function ($k) use ($only) {
            foreach ($only as $o) { if ($k === $o || (substr($o, -1) === '.' && strpos($k, $o) === 0)) { return true; } }
            return false;
        }, ARRAY_FILTER_USE_KEY);
    }
    return '<script>window.MTL=window.MTL||{d:{},t:function(n,k,v){var e=(this.d[n]||{})[k],s;if(!e){return k;}v=v||{};'
        . 'if(e.other!==undefined){var c=Math.abs(+v.n||0);s=(c===1&&e.one!==undefined)?e.one:e.other;}else{s=e.text||"";}'
        . 'return s.replace(/\{([a-z0-9_]+)\}/g,function(a,b){return v.hasOwnProperty(b)?String(v[b]):a;});}};'
        . 'MTL.d[' . json_encode((string)$name) . ']=' . json_encode((object)$tab, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP) . ';</script>';
}

}
]]></INLINE>
</FILE>

