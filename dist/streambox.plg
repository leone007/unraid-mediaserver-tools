  if (document.body) { start(); } else { document.addEventListener('DOMContentLoaded', start); }
})();
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/notify_lib.php">
<INLINE><![CDATA[<?php
// Discord notifier helpers (Streambox): Hungarian cards for new movies and seasons.

require_once __DIR__ . '/lang.php';
// Discord texts in the shared language (lang.php): Hungarian or English
function nf_t($hu, $en) { return mt_lang_discord() === 'en' ? $en : $hu; }
function nf_dec() { return mt_lang_discord() === 'en' ? '.' : ','; }
const NF_FIELDS = 'Overview,Genres,People,MediaStreams,MediaSources,DateCreated,OriginalTitle,ProductionYear,ProviderIds';
// what a movie or an episode is, independent of its file: a replaced file gets a new Jellyfin item, but the same key (2026-10-20)
function nf_key_movie($m) { $p = (array)($m['ProviderIds'] ?? []); foreach (['Tmdb', 'Imdb', 'Tvdb'] as $k) { if (!empty($p[$k])) { return 'm:' . strtolower($k) . ':' . $p[$k]; } } $n = strtolower(trim((string)($m['Name'] ?? ''))); return $n !== '' ? 'm:' . $n . ':' . (int)($m['ProductionYear'] ?? 0) : ''; }
function nf_key_ep($e) { if (!isset($e['IndexNumber']) || (string)($e['SeriesId'] ?? '') === '') { return ''; } return 'e:' . $e['SeriesId'] . ':' . (int)($e['ParentIndexNumber'] ?? 0) . ':' . (int)$e['IndexNumber'] . (isset($e['IndexNumberEnd']) ? '-' . (int)$e['IndexNumberEnd'] : ''); }

function nf_cfg() {
    $c = [
        'jf_host' => '127.0.0.1', 'jf_port' => '8096', 'jf_key' => '', 'jf_url' => '',
        'notify' => '0', 'dc_movies' => '', 'dc_series' => '', 'notify_settle' => '5', 'notify_wait' => '30',
        'weekly' => '0', 'dc_weekly' => '', 'weekly_day' => '5', 'weekly_hour' => '18',
    ];
    $f = '/boot/config/plugins/streambox/settings.cfg';
    if (is_file($f)) {
        $x = @parse_ini_file($f);
        if (is_array($x)) { $c = array_merge($c, $x); }
    }
    return $c;
}

function nf_on($v) { return in_array(strtolower(trim((string)$v)), ['1', 'yes', 'true', 'on'], true); }

function nf_hook($u) {
    $u = trim((string)$u);
    return preg_match('#^https://(?:discord|discordapp)\.com/api/webhooks/\d{15,25}/[A-Za-z0-9_\-]{20,120}$#', $u) ? $u : '';
}

function nf_log($m) {
    $f = '/tmp/streambox_notify.log';
    $lines = is_file($f) ? (array)@file($f, FILE_IGNORE_NEW_LINES) : [];
    $lines[] = date('Y-m-d H:i:s') . ' ' . $m;
    @file_put_contents($f, implode("\n", array_slice($lines, -100)) . "\n");
}

// ---- Jellyfin ---------------------------------------------------------------------------------
function nf_get($cfg, $path) {
    $ch = curl_init('http://' . $cfg['jf_host'] . ':' . (int)$cfg['jf_port'] . $path);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 3, CURLOPT_TIMEOUT => 25,
        CURLOPT_HTTPHEADER => ['Authorization: MediaBrowser Token="' . $cfg['jf_key'] . '"', 'Accept: */*'],
    ]);
    $b = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    return ($code === 200 && is_string($b)) ? $b : null;
}

function nf_json($cfg, $path) {
    $b = nf_get($cfg, $path);
    if ($b === null) { return null; }
    $d = json_decode($b, true);
    return is_array($d) ? $d : null;
}

function nf_item($cfg, $id) {
    if ($id === '' || !preg_match('/^[0-9a-fA-F\-]{32,36}$/', $id)) { return null; }
    $d = nf_json($cfg, '/Items?Ids=' . rawurlencode($id) . '&Fields=' . NF_FIELDS);
    return (is_array($d) && !empty($d['Items'][0])) ? $d['Items'][0] : null;
}

function nf_image($cfg, $id, $type, $w) {
    $p = '/Items/' . rawurlencode($id) . '/Images/' . $type . ($type === 'Backdrop' ? '/0' : '')
       . '?maxWidth=' . (int)$w . '&quality=90&format=Jpg';
    $b = nf_get($cfg, $p);
    return ($b !== null && strlen($b) > 500 && strlen($b) < 7000000) ? $b : null;
}

function nf_info($cfg) {
    static $info = null;
    if ($info === null) {
        $d = nf_json($cfg, '/System/Info/Public');
        $info = ['Version' => (string)($d['Version'] ?? ''), 'Id' => (string)($d['Id'] ?? '')];
    }
    return $info;
}

function nf_link($cfg, $id) {
    $base = rtrim(trim((string)$cfg['jf_url']), '/');
    if ($base === '') { return ''; }
    $info = nf_info($cfg);
    return $base . '/web/#/details?id=' . $id . ($info['Id'] !== '' ? '&serverId=' . $info['Id'] : '');
}

function nf_ts($iso) {
    $t = strtotime(preg_replace('/\.\d+/', '', (string)$iso));
    return $t === false ? 0 : (int)$t;
}

function nf_ready($item) {
    return $item !== null && trim((string)($item['Overview'] ?? '')) !== '' && !empty($item['ImageTags']['Primary']);
}

// ---- text helpers -----------------------------------------------------------------------------
function nf_trunc($s, $max) {
    $s = trim((string)preg_replace('/\s+/u', ' ', (string)$s));
    if (mb_strlen($s) <= $max) { return $s; }
    $c = mb_substr($s, 0, $max);
    $p = mb_strrpos($c, ' ');
    if ($p !== false && $p > $max * 0.6) { $c = mb_substr($c, 0, $p); }
    return rtrim($c, " \t,;:.-") . "\u{2026}";
}

function nf_md($s) { return preg_replace('/([\\\\*_~`|>])/u', '\\\\$1', (string)$s); }

function nf_runtime($ticks) {
    $min = (int)round(((float)$ticks) / 10000000 / 60);
    if ($min <= 0) { return ''; }
    $h = intdiv($min, 60);
    $m = $min % 60;
    if (mt_lang_discord() === 'en') { return $h > 0 ? $h . ' h' . ($m > 0 ? ' ' . $m . ' min' : '') : $m . ' min'; }
    if ($h > 0) { return $h . ' óra' . ($m > 0 ? ' ' . $m . ' perc' : ''); }
    return $m . ' perc';
}

function nf_size($bytes) {
    $b = (float)$bytes;
    if ($b <= 0) { return ''; }
    if ($b >= 1073741824) { return number_format($b / 1073741824, 1, nf_dec(), '') . ' GB'; }
    return number_format($b / 1048576, 0, nf_dec(), '') . ' MB';
}

function nf_genres($list, $max = 4) {
    static $map = [
        'Action' => 'Akció', 'Adventure' => 'Kaland', 'Animation' => 'Animáció', 'Comedy' => 'Vígjáték',
        'Crime' => 'Krimi', 'Documentary' => 'Dokumentum', 'Drama' => 'Dráma', 'Family' => 'Családi',
        'Fantasy' => 'Fantasy', 'History' => 'Történelmi', 'Horror' => 'Horror', 'Music' => 'Zenei',
        'Musical' => 'Musical', 'Mystery' => 'Misztikus', 'Romance' => 'Romantikus',
        'Science Fiction' => 'Sci-fi', 'Sci-Fi & Fantasy' => 'Sci-fi és fantasy', 'TV Movie' => 'TV-film',
        'Thriller' => 'Thriller', 'War' => 'Háborús', 'Western' => 'Western', 'Action & Adventure' => 'Akció és kaland',
        'Kids' => 'Gyerek', 'News' => 'Hírek', 'Reality' => 'Valóságshow', 'Soap' => 'Szappanopera',
        'Talk' => 'Beszélgetős', 'War & Politics' => 'Háború és politika', 'Biography' => 'Életrajzi',
        'Sport' => 'Sport', 'Anime' => 'Anime',
    ];
    $out = [];
    $en = mt_lang_discord() === 'en';   // Jellyfin's genre names are English already
    foreach ((array)$list as $g) { $g = (string)$g; $out[] = $en ? $g : ($map[$g] ?? $g); }
    return implode(', ', array_slice($out, 0, $max));
}

function nf_cast($item) {
    $n = [];
    foreach ((array)($item['People'] ?? []) as $p) {
        if (($p['Type'] ?? '') === 'Actor' && !empty($p['Name'])) { $n[] = (string)$p['Name']; }
        if (count($n) >= 5) { break; }
    }
    return implode(', ', $n);
}

function nf_lang($code) {
    static $map = [
        'eng' => 'angol', 'hun' => 'magyar', 'ger' => 'német', 'deu' => 'német', 'fre' => 'francia', 'fra' => 'francia',
        'spa' => 'spanyol', 'ita' => 'olasz', 'jpn' => 'japán', 'kor' => 'koreai', 'chi' => 'kínai', 'zho' => 'kínai',
        'rus' => 'orosz', 'por' => 'portugál', 'pol' => 'lengyel', 'cze' => 'cseh', 'ces' => 'cseh', 'dut' => 'holland',
        'nld' => 'holland', 'swe' => 'svéd', 'tur' => 'török', 'hin' => 'hindi', 'dan' => 'dán', 'nor' => 'norvég',
        'fin' => 'finn', 'rum' => 'román', 'ron' => 'román', 'slo' => 'szlovák', 'slk' => 'szlovák', 'hrv' => 'horvát',
        'srp' => 'szerb', 'ukr' => 'ukrán', 'ara' => 'arab', 'heb' => 'héber', 'gre' => 'görög', 'ell' => 'görög',
        'tha' => 'thai', 'vie' => 'vietnami', 'bul' => 'bolgár', 'slv' => 'szlovén', 'bos' => 'bosnyák',
        'mac' => 'macedón', 'mkd' => 'macedón', 'alb' => 'albán', 'sqi' => 'albán', 'lit' => 'litván', 'lav' => 'lett',
        'est' => 'észt', 'ice' => 'izlandi', 'isl' => 'izlandi', 'nob' => 'norvég', 'nno' => 'norvég', 'per' => 'perzsa',
        'fas' => 'perzsa', 'ind' => 'indonéz', 'may' => 'maláj', 'msa' => 'maláj', 'cat' => 'katalán', 'baq' => 'baszk',
        'eus' => 'baszk', 'glg' => 'galego', 'afr' => 'afrikaans', 'ben' => 'bengáli', 'tam' => 'tamil', 'tel' => 'telugu',
        'fil' => 'filippínó', 'tgl' => 'filippínó', 'urd' => 'urdu',
    ];
    static $en = ['eng' => 'English', 'hun' => 'Hungarian', 'ger' => 'German', 'deu' => 'German', 'fre' => 'French', 'fra' => 'French',
        'spa' => 'Spanish', 'ita' => 'Italian', 'jpn' => 'Japanese', 'kor' => 'Korean', 'chi' => 'Chinese', 'zho' => 'Chinese',
        'rus' => 'Russian', 'por' => 'Portuguese', 'pol' => 'Polish', 'cze' => 'Czech', 'ces' => 'Czech', 'dut' => 'Dutch',
        'nld' => 'Dutch', 'swe' => 'Swedish', 'tur' => 'Turkish', 'hin' => 'Hindi', 'dan' => 'Danish', 'nor' => 'Norwegian',
        'fin' => 'Finnish', 'rum' => 'Romanian', 'ron' => 'Romanian', 'slo' => 'Slovak', 'slk' => 'Slovak', 'hrv' => 'Croatian',
        'srp' => 'Serbian', 'ukr' => 'Ukrainian', 'ara' => 'Arabic', 'heb' => 'Hebrew', 'gre' => 'Greek', 'ell' => 'Greek',
        'tha' => 'Thai', 'vie' => 'Vietnamese', 'bul' => 'Bulgarian', 'slv' => 'Slovenian', 'bos' => 'Bosnian',
        'mac' => 'Macedonian', 'mkd' => 'Macedonian', 'alb' => 'Albanian', 'sqi' => 'Albanian', 'lit' => 'Lithuanian', 'lav' => 'Latvian',
        'est' => 'Estonian', 'ice' => 'Icelandic', 'isl' => 'Icelandic', 'nob' => 'Norwegian', 'nno' => 'Norwegian', 'per' => 'Persian',
        'fas' => 'Persian', 'ind' => 'Indonesian', 'may' => 'Malay', 'msa' => 'Malay', 'cat' => 'Catalan', 'baq' => 'Basque',
        'eus' => 'Basque', 'glg' => 'Galician', 'afr' => 'Afrikaans', 'ben' => 'Bengali', 'tam' => 'Tamil', 'tel' => 'Telugu',
        'fil' => 'Filipino', 'tgl' => 'Filipino', 'urd' => 'Urdu'];
    $c = strtolower(trim((string)$code));
    if (mt_lang_discord() === 'en') { return ($c === '' || $c === 'und') ? 'unknown' : ($en[$c] ?? $c); }
    if ($c === '' || $c === 'und') { return 'ismeretlen'; }
    return $map[$c] ?? $c;
}

function nf_acodec($s) {
    $c = strtolower((string)($s['Codec'] ?? ''));
    $prof = (string)($s['Profile'] ?? '');
    switch ($c) {
        case 'ac3': return 'DD';
        case 'eac3': return 'DD+';
        case 'truehd': return 'TrueHD';
        case 'dts':
            if (stripos($prof, 'MA') !== false) { return 'DTS-HD MA'; }
            if (stripos($prof, 'HRA') !== false) { return 'DTS-HD HRA'; }
            if (stripos($prof, 'DTS:X') !== false || stripos($prof, 'X') === 0) { return 'DTS:X'; }
            return 'DTS';
        case 'aac': return 'AAC';
        case 'flac': return 'FLAC';
        case 'opus': return 'Opus';
        case 'mp3': return 'MP3';
        case '': return '';
    }
    return strpos($c, 'pcm') === 0 ? 'PCM' : strtoupper($c);
}

function nf_ch($n) {
    $m = [1 => '1.0', 2 => '2.0', 3 => '2.1', 4 => '4.0', 5 => '5.0', 6 => '5.1', 7 => '6.1', 8 => '7.1'];
    return $m[(int)$n] ?? '';
}

// "angol · DD+ 5.1 Atmos" lines plus "felirat: magyar (kényszerített), angol"
function nf_audio_sub($item) {
    $aud = [];
    $subs = [];
    foreach ((array)($item['MediaStreams'] ?? []) as $s) {
        $t = $s['Type'] ?? '';
        if ($t === 'Audio') {
            $atmos = stripos((string)($s['DisplayTitle'] ?? '') . ' ' . (string)($s['Profile'] ?? ''), 'atmos') !== false;
            $lang = nf_lang($s['Language'] ?? '');
            $tech = trim(nf_acodec($s) . ' ' . nf_ch($s['Channels'] ?? 0) . ($atmos ? ' Atmos' : ''));
            $line = $lang . ($tech !== '' ? ' · ' . $tech : '');
            if (!in_array($line, $aud, true)) { $aud[] = $line; }
        } elseif ($t === 'Subtitle') {
            // forced (foreign-parts-only) subtitles are not announced
            $hay = (string)($s['Title'] ?? '') . ' ' . (string)($s['DisplayTitle'] ?? '');
            if (!empty($s['IsForced']) || stripos($hay, 'forced') !== false || stripos($hay, 'kényszer') !== false) { continue; }
            $subs[nf_lang($s['Language'] ?? '')] = true;
        }
    }
    $lines = array_slice($aud, 0, 3);
    if ($subs) {
        $labels = array_keys($subs);
        // the message's language first, the rest in file order
        $hu = nf_lang(mt_lang_discord() === 'en' ? 'eng' : 'hun');   // the message's own language first
        usort($labels, function ($a, $b) use ($hu) { return (($a === $hu) ? 0 : 1) <=> (($b === $hu) ? 0 : 1); });
        $lines[] = nf_t('felirat: ', 'subtitles: ') . implode(', ', array_slice($labels, 0, 6));
    }
    return $lines ? implode("\n", $lines) : '';
}

// "2160p · HEVC · Dolby Vision · 12,4 GB"
function nf_quality($item, $size = null) {
    $v = null;
    foreach ((array)($item['MediaStreams'] ?? []) as $s) { if (($s['Type'] ?? '') === 'Video') { $v = $s; break; } }
    $parts = [];
    if ($v) {
        $w = (int)($v['Width'] ?? 0);
        $h = (int)($v['Height'] ?? 0);
        if ($w >= 3200 || $h >= 2000) { $parts[] = '2160p'; }
        elseif ($w >= 1800 || $h >= 1000) { $parts[] = '1080p'; }
        elseif ($w >= 1200 || $h >= 700) { $parts[] = '720p'; }
        elseif ($h > 0) { $parts[] = 'SD'; }
        $codec = strtolower((string)($v['Codec'] ?? ''));
        $cm = ['hevc' => 'HEVC', 'h264' => 'H.264', 'av1' => 'AV1', 'vp9' => 'VP9', 'mpeg2video' => 'MPEG-2'];
        if ($codec !== '') { $parts[] = $cm[$codec] ?? strtoupper($codec); }
        $r = (string)($v['VideoRangeType'] ?? '');
        if (stripos($r, 'DOVI') === 0) { $parts[] = 'Dolby Vision' . (stripos($r, 'HDR10') !== false ? ' / HDR10' : ''); }
        elseif ($r === 'HDR10Plus') { $parts[] = 'HDR10+'; }
        elseif ($r === 'HDR10') { $parts[] = 'HDR10'; }
        elseif ($r === 'HLG') { $parts[] = 'HLG'; }
    }
    if ($size === null) { $size = (float)($item['MediaSources'][0]['Size'] ?? 0); }
    $sz = nf_size($size);
    if ($sz !== '') { $parts[] = $sz; }
    return implode(' · ', $parts);
}

function nf_field($name, $value, $inline) {
    $value = trim((string)$value);
    if ($value === '') { return null; }
    return ['name' => $name, 'value' => mb_substr($value, 0, 1000), 'inline' => (bool)$inline];
}

// ---- cards ------------------------------------------------------------------------------------
function nf_build($cfg, $o) {
    $desc = '';
    if ($o['orig'] !== '') { $desc .= '*' . nf_md($o['orig']) . "*\n"; }
    if ($o['overview'] !== '') { $desc .= nf_md(nf_trunc($o['overview'], 280)) . "\n"; }
    if ($o['url'] !== '') { $desc .= "\n[" . nf_t('Megnyitás a Jellyfinben', 'Open in Jellyfin') . "](" . $o['url'] . ')'; }
    $info = nf_info($cfg);
    $host = strtoupper((string)(gethostname() ?: 'SERVER'));
    $emb = [
        'author'      => ['name' => $o['author']],
        'title'       => mb_substr($o['title'], 0, 256),
        'description' => trim($desc),
        'color'       => 6967248,
        'fields'      => array_values(array_filter($o['fields'])),
        'footer'      => ['text' => $host . ($info['Version'] !== '' ? ' · Jellyfin ' . $info['Version'] : '')],
    ];
    if ($o['ts'] > 0) { $emb['timestamp'] = gmdate('c', $o['ts']); }
    if ($o['url'] !== '') { $emb['url'] = $o['url']; }
    return ['payload' => ['username' => 'Streambox', 'embeds' => [$emb]], 'poster' => $o['poster'], 'backdrop' => $o['backdrop']];
}

function nf_card_movie($cfg, $m, $preview = false) {
    $name = (string)($m['Name'] ?? '?');
    $orig = (string)($m['OriginalTitle'] ?? '');
    if ($orig !== '' && mb_strtolower($orig) === mb_strtolower($name)) { $orig = ''; }
    $id = (string)$m['Id'];
    return nf_build($cfg, [
        'author'   => ($preview ? nf_t('ELŐNÉZET · ', 'PREVIEW · ') : '') . nf_t('Új film', 'New movie'),
        'title'    => $name . (!empty($m['ProductionYear']) ? ' (' . (int)$m['ProductionYear'] . ')' : ''),
        'orig'     => $orig,
        'overview' => (string)($m['Overview'] ?? ''),
        'url'      => nf_link($cfg, $id),
        'ts'       => nf_ts($m['DateCreated'] ?? ''),
        'fields'   => [
            nf_field(nf_t('Hossz', 'Length'), nf_runtime($m['RunTimeTicks'] ?? 0), true),
            nf_field(nf_t('Minőség', 'Quality'), nf_quality($m), true),
            nf_field(nf_t('Műfaj', 'Genre'), nf_genres($m['Genres'] ?? []), true),
            nf_field(nf_t('Hang · felirat', 'Audio · subtitles'), nf_audio_sub($m), false),
            nf_field(nf_t('Szereplők', 'Cast'), nf_cast($m), false),
        ],
        'poster'   => nf_image($cfg, $id, 'Primary', 400),
        'backdrop' => !empty($m['BackdropImageTags']) ? nf_image($cfg, $id, 'Backdrop', 1280) : null,
    ]);
}

// "S01E01 – S01E08", or a list when the episodes are not consecutive
function nf_ep_range($eps) {
    $codes = [];
    $nums = [];
    foreach ($eps as $e) {
        $s = (int)($e['ParentIndexNumber'] ?? 0);
        $n = (int)($e['IndexNumber'] ?? 0);
        $codes[] = [$s, $n];
        $nums[] = $n;
    }
    usort($codes, function ($a, $b) { return [$a[0], $a[1]] <=> [$b[0], $b[1]]; });
    $fmt = function ($c) { return sprintf('S%02dE%02d', $c[0], $c[1]); };
    if (count($codes) === 1) { return $fmt($codes[0]); }
    $contig = true;
    for ($i = 1; $i < count($codes); $i++) {
        if ($codes[$i][0] !== $codes[$i - 1][0] || $codes[$i][1] !== $codes[$i - 1][1] + 1) { $contig = false; break; }
    }
    if ($contig) { return $fmt($codes[0]) . ' – ' . $fmt($codes[count($codes) - 1]); }
    $list = array_map($fmt, array_slice($codes, 0, 8));
    return implode(', ', $list) . (count($codes) > 8 ? ', …' : '');
}

// $eps: the new episodes of one season (full items, with streams)
function nf_card_season($cfg, $series, $season, $eps, $preview = false) {
    usort($eps, function ($a, $b) {
        return [(int)($a['ParentIndexNumber'] ?? 0), (int)($a['IndexNumber'] ?? 0)] <=> [(int)($b['ParentIndexNumber'] ?? 0), (int)($b['IndexNumber'] ?? 0)];
    });
    $first = $eps[0];
    $sn = (int)($first['ParentIndexNumber'] ?? 0);
    $name = (string)($series['Name'] ?? ($first['SeriesName'] ?? '?'));
    $orig = (string)($series['OriginalTitle'] ?? '');
    if ($orig !== '' && mb_strtolower($orig) === mb_strtolower($name)) { $orig = ''; }
    $sid = (string)($series['Id'] ?? ($first['SeriesId'] ?? ''));
    $seasonId = (string)($season['Id'] ?? '');

    $hasFirst = false;
    $total = 0.0;
    $ts = 0;
    foreach ($eps as $e) {
        if ((int)($e['IndexNumber'] ?? 0) === 1) { $hasFirst = true; }
        $total += (float)($e['MediaSources'][0]['Size'] ?? 0);
        $ts = max($ts, nf_ts($e['DateCreated'] ?? ''));
    }
    $count = count($eps);
    $label = $hasFirst ? nf_t('Új évad', 'New season') : nf_t('Új epizódok', 'New episodes');
    $seasonTxt = $sn === 0 ? nf_t('Különlegességek', 'Specials') : nf_t($sn . '. évad', 'Season ' . $sn);

    $overview = trim((string)($season['Overview'] ?? ''));
    if ($overview === '') { $overview = (string)($series['Overview'] ?? ''); }

    $posterId = ($season && !empty($season['ImageTags']['Primary'])) ? $seasonId : $sid;
    $rt = nf_runtime($first['RunTimeTicks'] ?? 0);
    $epTxt = $count . nf_t(' új epizód: ', $count === 1 ? ' new episode: ' : ' new episodes: ') . nf_ep_range($eps);
    $sz = nf_size($total);

    return nf_build($cfg, [
        'author'   => ($preview ? nf_t('ELŐNÉZET · ', 'PREVIEW · ') : '') . $label,
        'title'    => $name . (!empty($series['ProductionYear']) ? ' (' . (int)$series['ProductionYear'] . ')' : '') . ' · ' . $seasonTxt,
        'orig'     => $orig,
        'overview' => $overview,
        'url'      => nf_link($cfg, $seasonId !== '' ? $seasonId : $sid),
        'ts'       => $ts,
        'fields'   => [
            nf_field(nf_t('Epizódok', 'Episodes'), $epTxt, false),
            nf_field(nf_t('Hossz', 'Length'), $rt !== '' ? nf_t('epizódonként kb. ', 'about ') . $rt . nf_t('', ' per episode') : '', true),
            nf_field(nf_t('Minőség', 'Quality'), nf_quality($first, 0) . ($sz !== '' ? nf_t(' · összesen ', ' · in all ') . $sz : ''), true),
            nf_field(nf_t('Műfaj', 'Genre'), nf_genres($series['Genres'] ?? []), true),
            nf_field(nf_t('Hang · felirat', 'Audio · subtitles'), nf_audio_sub($first), false),
            nf_field(nf_t('Szereplők', 'Cast'), nf_cast($series), false),
        ],
        'poster'   => $posterId !== '' ? nf_image($cfg, $posterId, 'Primary', 400) : null,
        'backdrop' => ($sid !== '' && !empty($series['BackdropImageTags'])) ? nf_image($cfg, $sid, 'Backdrop', 1280) : null,
    ]);
}

// ---- weekly summary ---------------------------------------------------------------------------
// Use the server's time zone (Settings, Date and Time) for "Friday 18:00".
function nf_tz() {
    $v = @parse_ini_file('/var/local/emhttp/var.ini');
    $tz = is_array($v) ? (string)($v['timeZone'] ?? '') : '';
    if ($tz !== '' && in_array($tz, timezone_identifiers_list(), true)) { date_default_timezone_set($tz); }
}

function nf_hu_date($ts) {
    if (mt_lang_discord() === 'en') { return date('M j', $ts); }
    static $m = ['jan.', 'febr.', 'márc.', 'ápr.', 'máj.', 'jún.', 'júl.', 'aug.', 'szept.', 'okt.', 'nov.', 'dec.'];
    return $m[(int)date('n', $ts) - 1] . ' ' . (int)date('j', $ts) . '.';
}

// "2160p DV", "1080p", "2160p HDR"
function nf_res_short($item) {
    $parts = explode(' · ', nf_quality($item, 0));
    $out = [];
    if ($parts[0] !== '') { $out[] = $parts[0]; }
    foreach ($parts as $p) {
        if (strpos($p, 'Dolby Vision') === 0) { $out[] = 'DV'; break; }
        if (strpos($p, 'HDR') === 0 || $p === 'HLG') { $out[] = 'HDR'; break; }
    }
    return implode(' ', $out);
}

function nf_stars($item) {
    $r = (float)($item['CommunityRating'] ?? 0);
    return $r > 0 ? '★ ' . number_format($r, 1, nf_dec(), '') : '';
}

function nf_title_link($cfg, $name, $id) {
    $n = nf_md(str_replace(['[', ']'], ['(', ')'], (string)$name));
    $url = nf_link($cfg, $id);
    return $url !== '' ? '**[' . $n . '](' . $url . ')**' : '**' . $n . '**';
}

function nf_join_lines($lines, $budget) {
    $out = '';
    $n = 0;
    foreach ($lines as $l) {
        if (mb_strlen($out) + mb_strlen($l) + 40 > $budget) { return rtrim($out) . "\n…" . nf_t('és még ' . (count($lines) - $n) . ' további', 'and ' . (count($lines) - $n) . ' more'); }
        $out .= $l . "\n";
        $n++;
    }
    return rtrim($out);
}

// Message payload for everything added since $from; null = nothing new, false = Jellyfin could not be read
function nf_weekly($cfg, $from, $now, $preview = false) {
    $md = nf_json($cfg, '/Items?IncludeItemTypes=Movie&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=100&Fields=' . NF_FIELDS);
    $ed = nf_json($cfg, '/Items?IncludeItemTypes=Episode&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=600&Fields=DateCreated');
    if ($md === null && $ed === null) { return false; }

    $mlines = [];
    foreach ((array)($md['Items'] ?? []) as $m) {
        if (nf_ts($m['DateCreated'] ?? '') < $from) { continue; }
        $line = nf_title_link($cfg, $m['Name'] ?? '?', (string)($m['Id'] ?? ''));
        if (!empty($m['ProductionYear'])) { $line .= ' (' . (int)$m['ProductionYear'] . ')'; }
        $bits = array_filter([nf_runtime($m['RunTimeTicks'] ?? 0), nf_res_short($m), nf_genres($m['Genres'] ?? [], 3), nf_stars($m)]);
        $mlines[] = $line . ($bits ? ' · ' . implode(' · ', $bits) : '');
    }

    $groups = [];
    foreach ((array)($ed['Items'] ?? []) as $e) {
        $ts = nf_ts($e['DateCreated'] ?? '');
        if ($ts < $from || empty($e['SeriesId'])) { continue; }
        $k = (string)$e['SeriesId'] . '|' . (int)($e['ParentIndexNumber'] ?? 0);
        if (!isset($groups[$k])) { $groups[$k] = ['eps' => [], 'ts' => 0, 'sid' => (string)$e['SeriesId'], 'name' => (string)($e['SeriesName'] ?? '?')]; }
        $groups[$k]['eps'][] = $e;
        $groups[$k]['ts'] = max($groups[$k]['ts'], $ts);
    }
    uasort($groups, function ($a, $b) { return $b['ts'] <=> $a['ts']; });
    $slines = [];
    $cache = [];
    foreach (array_slice($groups, 0, 25) as $g) {
        if (!array_key_exists($g['sid'], $cache)) { $cache[$g['sid']] = nf_item($cfg, $g['sid']); }
        $ser = $cache[$g['sid']] ?: [];
        $sn = (int)($g['eps'][0]['ParentIndexNumber'] ?? 0);
        $line = nf_title_link($cfg, $ser['Name'] ?? $g['name'], $g['sid']);
        if (!empty($ser['ProductionYear'])) { $line .= ' (' . (int)$ser['ProductionYear'] . ')'; }
        $line .= ' · ' . ($sn === 0 ? nf_t('különlegességek', 'specials') : nf_t($sn . '. évad', 'season ' . $sn)) . ' · ' . count($g['eps']) . nf_t(' új epizód (', count($g['eps']) === 1 ? ' new episode (' : ' new episodes (') . nf_ep_range($g['eps']) . ')';
        $bits = array_filter([nf_genres($ser['Genres'] ?? [], 3), nf_stars($ser)]);
        $slines[] = $line . ($bits ? ' · ' . implode(' · ', $bits) : '');
    }

    $embeds = [];
    if ($mlines) { $embeds[] = ['title' => '🎬 ' . nf_t('Új filmek', 'New movies') . ' (' . count($mlines) . ')', 'description' => nf_join_lines($mlines, 2800), 'color' => 6967248]; }
    if ($slines) { $embeds[] = ['title' => '📺 ' . nf_t('Új sorozatok és évadok', 'New series and seasons') . ' (' . count($slines) . ')', 'description' => nf_join_lines($slines, 2800), 'color' => 6967248]; }
    if (!$embeds) { return null; }
    $info = nf_info($cfg);
    $host = strtoupper((string)(gethostname() ?: 'SERVER'));
    $embeds[count($embeds) - 1]['footer'] = ['text' => $host . ' · ' . nf_hu_date($from) . ' – ' . nf_hu_date($now)];
    return [
        'username' => 'Streambox',
        'content'  => ($preview ? nf_t('**ELŐNÉZET** · ', '**PREVIEW** · ') : '') . nf_t('🍿 **Hétvégi műsor** – ezek érkeztek a héten, jó szórakozást!', '🍿 **Weekend lineup** – this came in this week, enjoy!'),
        'embeds'   => $embeds,
    ];
}

// ---- Discord ----------------------------------------------------------------------------------
// Returns ['ok'|'retry'|'fail', message]
function nf_send($hook, $payload, $poster = null, $backdrop = null, $attempt = 0) {
    $payload['allowed_mentions'] = ['parse' => []];
    $tmp = [];
    $files = [];
    if ($poster !== null && isset($payload['embeds'][0])) {
        $payload['embeds'][0]['thumbnail'] = ['url' => 'attachment://poster.jpg'];
        $files['poster.jpg'] = $poster;
    }
    if ($backdrop !== null && isset($payload['embeds'][0])) {
        $payload['embeds'][0]['image'] = ['url' => 'attachment://backdrop.jpg'];
        $files['backdrop.jpg'] = $backdrop;
    }
    $json = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
    $ch = curl_init($hook);
    $opt = [CURLOPT_POST => true, CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 40];
    if ($files) {
        $fields = ['payload_json' => $json];
        $i = 0;
        foreach ($files as $fname => $data) {
            $p = tempnam('/tmp', 'sbn');
            file_put_contents($p, $data);
            $tmp[] = $p;
            $fields['files[' . $i . ']'] = new CURLFile($p, 'image/jpeg', $fname);
            $i++;
        }
        $opt[CURLOPT_POSTFIELDS] = $fields;
    } else {
        $opt[CURLOPT_POSTFIELDS] = $json;
        $opt[CURLOPT_HTTPHEADER] = ['Content-Type: application/json'];
    }
    curl_setopt_array($ch, $opt);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err = curl_errno($ch);
    curl_close($ch);
    foreach ($tmp as $p) { @unlink($p); }

    if ($err) { return ['retry', 'network error ' . $err]; }
    if ($code === 200 || $code === 204) { return ['ok', '']; }
    if ($code === 429) {
        $d = json_decode((string)$body, true);
        $wait = is_array($d) && isset($d['retry_after']) ? (float)$d['retry_after'] : 2.0;
        if ($attempt < 1 && $wait <= 5.0) {
            usleep((int)(($wait + 0.3) * 1000000));
            return nf_send($hook, $payload, $poster, $backdrop, $attempt + 1);
        }
        return ['retry', 'rate limited'];
    }
    if ($code >= 500 || $code === 0) { return ['retry', 'Discord HTTP ' . $code]; }
    $d = json_decode((string)$body, true);
    return ['fail', 'Discord HTTP ' . $code . (is_array($d) && !empty($d['message']) ? ' (' . $d['message'] . ')' : '')];
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/notify.php">
<INLINE><![CDATA[<?php
// Started by cron every minute: post a Discord card for each new movie and each new season.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/notify_lib.php';

$cfg = nf_cfg();
if (!nf_on($cfg['notify']) || (string)$cfg['jf_key'] === '') { exit(0); }
$hookMovies = nf_hook($cfg['dc_movies']);
$hookSeries = nf_hook($cfg['dc_series']);
if ($hookMovies === '' && $hookSeries === '') { exit(0); }
if (!preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['jf_host'])) { exit(0); }

$lock = @fopen('/tmp/streambox_notify.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

$sf  = '/boot/config/plugins/streambox/notify_state.json';
$st  = is_file($sf) ? json_decode((string)@file_get_contents($sf), true) : null;
$now = time();

function nf_save_state($sf, $st) {
    $tmp = $sf . '.tmp';
    $data = json_encode($st);
    if (@file_put_contents($tmp, $data) === false || !@rename($tmp, $sf)) { @file_put_contents($sf, $data); @unlink($tmp); }
}

if (!is_array($st) || !isset($st['since'])) {
    // first run: only things added from now on are announced
    nf_save_state($sf, ['since' => $now, 'done' => []]);
    nf_log('notifier started, announcing items added from now on');
    exit(0);
}

$since  = (int)$st['since'];
$done   = array_flip(array_map('strval', (array)($st['done'] ?? [])));
// the movies and episodes already announced or older than the notifier: a replaced file (Seedbox Replace, a Radarr or Sonarr
// upgrade) is a new Jellyfin item with the same key and is not announced again (owner, 2026-10-20)
$ann    = array_flip(array_map('strval', (array)($st['ann'] ?? [])));
$skipped = 0;
$settle = max(1, (int)$cfg['notify_settle']) * 60;
$wait   = max(1, (int)$cfg['notify_wait']) * 60;
$posted = 0;
$changed = false;
$stop = false;
$MAX_CARDS = 6;
$BULK = 20;

// ---- movies -----------------------------------------------------------------------------------
if ($hookMovies !== '') {
    $d = nf_json($cfg, '/Items?IncludeItemTypes=Movie&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=60&Fields=' . NF_FIELDS);
    $pending = [];
    foreach ((array)($d['Items'] ?? []) as $m) {
        $id = (string)($m['Id'] ?? ''); $mk = nf_key_movie($m);
        $ts = nf_ts($m['DateCreated'] ?? '');
        if ($id === '' || isset($done[$id]) || $ts <= $since) { if ($mk !== '' && !isset($ann[$mk])) { $ann[$mk] = 1; $changed = true; } continue; }
        if ($mk !== '' && isset($ann[$mk])) { $done[$id] = 1; $changed = true; $skipped++; nf_log('movie "' . ($m['Name'] ?? $id) . '": already announced, a replaced file is not announced again'); continue; }
        $m['_ts'] = $ts;
        $pending[] = $m;
    }
    usort($pending, function ($a, $b) { return $a['_ts'] <=> $b['_ts']; });
    if (count($pending) > $BULK) {
        foreach (array_slice($pending, 0, count($pending) - $BULK) as $m) { $done[(string)$m['Id']] = 1; }
        nf_log('bulk import: skipped ' . (count($pending) - $BULK) . ' older movies');
        $pending = array_slice($pending, -$BULK);
        $changed = true;
    }
    foreach ($pending as $m) {
        if ($posted >= $MAX_CARDS || $stop) { break; }
        $id = (string)$m['Id'];
        if (!nf_ready($m) && ($now - $m['_ts']) < $wait) { continue; }   // metadata and poster not in yet
        $card = nf_card_movie($cfg, $m);
        list($res, $msg) = nf_send($hookMovies, $card['payload'], $card['poster'], $card['backdrop']);
        if ($res === 'retry') { nf_log('movie "' . ($m['Name'] ?? $id) . '": ' . $msg . ', will retry'); $stop = true; break; }
        $done[$id] = 1; $mk = nf_key_movie($m); if ($mk !== '') { $ann[$mk] = 1; }
        $changed = true;
        $posted++;
        if ($res === 'fail') { nf_log('movie "' . ($m['Name'] ?? $id) . '" not sent: ' . $msg); }
        else { nf_log('movie card sent: ' . ($m['Name'] ?? $id)); }
    }
}

// ---- seasons ----------------------------------------------------------------------------------
if ($hookSeries !== '' && !$stop) {
    $d = nf_json($cfg, '/Items?IncludeItemTypes=Episode&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=300&Fields=' . NF_FIELDS);
    $groups = [];
    foreach ((array)($d['Items'] ?? []) as $e) {
        $id = (string)($e['Id'] ?? ''); $ek = nf_key_ep($e);
        $ts = nf_ts($e['DateCreated'] ?? '');
        if ($id === '' || isset($done[$id]) || $ts <= $since) { if ($ek !== '' && !isset($ann[$ek])) { $ann[$ek] = 1; $changed = true; } continue; }
        if ($ek !== '' && isset($ann[$ek])) { $done[$id] = 1; $changed = true; $skipped++; nf_log('episode "' . ($e['SeriesName'] ?? '?') . ' S' . sprintf('%02dE%02d', (int)($e['ParentIndexNumber'] ?? 0), (int)$e['IndexNumber']) . '": already announced, a replaced file is not announced again'); continue; }
        $e['_ts'] = $ts;
        $key = (string)($e['SeasonId'] ?? '') !== '' ? (string)$e['SeasonId'] : ((string)($e['SeriesId'] ?? '') . '-' . (int)($e['ParentIndexNumber'] ?? 0));
        $groups[$key][] = $e;
    }
    foreach ($groups as $k => $eps) {
        $min = PHP_INT_MAX; $max = 0;
        foreach ($eps as $e) { $min = min($min, $e['_ts']); $max = max($max, $e['_ts']); }
        $groups[$k] = ['eps' => $eps, 'min' => $min, 'max' => $max];
    }
    uasort($groups, function ($a, $b) { return $a['min'] <=> $b['min']; });
    if (count($groups) > 15) {
        $skip = array_slice($groups, 0, count($groups) - 15, true);
        foreach ($skip as $g) { foreach ($g['eps'] as $e) { $done[(string)$e['Id']] = 1; } }
        nf_log('bulk import: skipped ' . count($skip) . ' older seasons');
        $groups = array_slice($groups, -15, null, true);
        $changed = true;
    }
    foreach ($groups as $g) {
        if ($posted >= $MAX_CARDS || $stop) { break; }
        if (($now - $g['max']) < $settle) { continue; }   // more episodes may still be arriving
        $eps = $g['eps'];
        $series = nf_item($cfg, (string)($eps[0]['SeriesId'] ?? ''));
        if (!nf_ready($series) && ($now - $g['min']) < $wait) { continue; }
        $season = nf_item($cfg, (string)($eps[0]['SeasonId'] ?? ''));
        $card = nf_card_season($cfg, $series ?: [], $season ?: [], $eps);
        list($res, $msg) = nf_send($hookSeries, $card['payload'], $card['poster'], $card['backdrop']);
        $label = (string)($eps[0]['SeriesName'] ?? '?') . ' S' . sprintf('%02d', (int)($eps[0]['ParentIndexNumber'] ?? 0));
        if ($res === 'retry') { nf_log('season "' . $label . '": ' . $msg . ', will retry'); $stop = true; break; }
        foreach ($eps as $e) { $done[(string)$e['Id']] = 1; $ek = nf_key_ep($e); if ($ek !== '') { $ann[$ek] = 1; } }
        $changed = true;
        $posted++;
        if ($res === 'fail') { nf_log('season "' . $label . '" not sent: ' . $msg); }
        else { nf_log('season card sent: ' . $label . ' (' . count($eps) . ' episodes)'); }
    }
}

if ($changed) {
    nf_save_state($sf, ['since' => $since, 'done' => array_slice(array_keys($done), -400), 'ann' => array_slice(array_keys($ann), -5000)]);
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/notify_test.php">
<INLINE><![CDATA[<?php
// Settings page buttons: "Send test message" and "Send preview" (newest movie and season, nothing is marked as sent).
header('Content-Type: application/json');
header('Cache-Control: no-store');
require_once __DIR__ . '/notify_lib.php';
require_once __DIR__ . '/i18n.php';
$sbx_T = mt_i18n_t(__DIR__ . '/lang');   // texts shown on the tile and the settings page

function nt_out($ok, $msg) { echo json_encode(['ok' => $ok, 'message' => $msg], JSON_UNESCAPED_UNICODE); exit; }

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); nt_out(false, 'method'); }
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); nt_out(false, 'csrf token mismatch'); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); nt_out(false, 'csrf: token removed and request is not AJAX');
}

$cfg  = nf_cfg();
$hm   = nf_hook($cfg['dc_movies']);
$hs   = nf_hook($cfg['dc_series']);
$hw   = nf_hook($cfg['dc_weekly']);
$mode = (string)($_POST['mode'] ?? 'test');
if ($hm === '' && $hs === '' && $hw === '') { nt_out(false, $sbx_T('ntest.no_hook')); }

$report = [];
if ($mode === 'test') {
    foreach (['movies' => $hm, 'series' => $hs, 'weekly' => $hw] as $label => $h) {
        if ($h === '') { continue; }
        list($r, $m) = nf_send($h, ['username' => 'Streambox', 'content' => nf_t('✅ Streambox: tesztüzenet (' . $label . ' csatorna)', '✅ Streambox: test message (' . $label . ' channel)')]);
        $report[] = $sbx_T('ntest.ch_' . $label) . ': ' . ($r === 'ok' ? $sbx_T('ntest.sent') : $sbx_T('ntest.failed', ['e' => $m]));
    }
    nt_out(true, implode('; ', $report));
}

if ((string)$cfg['jf_key'] === '' || !preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['jf_host'])) { nt_out(false, $sbx_T('ntest.no_jf')); }

if ($mode === 'weekly') {
    if ($hw === '') { nt_out(false, $sbx_T('ntest.no_weekly')); }
    nf_tz();
    $p = nf_weekly($cfg, time() - 7 * 86400, time(), true);
    if ($p === false) { nt_out(false, $sbx_T('ntest.jf_down')); }
    if ($p === null) { nt_out(true, $sbx_T('ntest.nothing')); }
    list($r, $msg) = nf_send($hw, $p);
    nt_out($r === 'ok', $sbx_T('ntest.weekly') . ': ' . ($r === 'ok' ? $sbx_T('ntest.sent') : $sbx_T('ntest.failed', ['e' => $msg])));
}

if ($hm !== '') {
    $d = nf_json($cfg, '/Items?IncludeItemTypes=Movie&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=1&Fields=' . NF_FIELDS);
    $m = $d['Items'][0] ?? null;
    if ($m) {
        $c = nf_card_movie($cfg, $m, true);
        list($r, $msg) = nf_send($hm, $c['payload'], $c['poster'], $c['backdrop']);
        $report[] = $sbx_T('ntest.movie', ['t' => ($m['Name'] ?? '?')]) . ': ' . ($r === 'ok' ? $sbx_T('ntest.sent') : $sbx_T('ntest.failed', ['e' => $msg]));
    } else { $report[] = $sbx_T('ntest.no_movie'); }
}
if ($hs !== '') {
    $d = nf_json($cfg, '/Items?IncludeItemTypes=Episode&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=1&Fields=' . NF_FIELDS);
    $e = $d['Items'][0] ?? null;
    if ($e && !empty($e['SeasonId'])) {
        $all = nf_json($cfg, '/Items?ParentId=' . rawurlencode((string)$e['SeasonId']) . '&IncludeItemTypes=Episode&Fields=' . NF_FIELDS);
        $eps = (array)($all['Items'] ?? []);
        if (!$eps) { $eps = [$e]; }
        $series = nf_item($cfg, (string)($e['SeriesId'] ?? ''));
        $season = nf_item($cfg, (string)$e['SeasonId']);
        $c = nf_card_season($cfg, $series ?: [], $season ?: [], $eps, true);
        list($r, $msg) = nf_send($hs, $c['payload'], $c['poster'], $c['backdrop']);
        $report[] = $sbx_T('ntest.season', ['t' => ($e['SeriesName'] ?? '?')]) . ': ' . ($r === 'ok' ? $sbx_T('ntest.sent') : $sbx_T('ntest.failed', ['e' => $msg]));
    } else { $report[] = $sbx_T('ntest.no_episode'); }
}
nt_out(true, implode('; ', $report));
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/Streambox/README.md">
<INLINE><![CDATA[**Streambox** puts Jellyfin on the Unraid dashboard as a native-looking tile: who is watching right now (direct play, direct stream or transcode, with progress and live TV guide data), GPU and CPU load with the current power draw, optional smart-socket wall power and monthly kWh, and the recently added titles. It can also announce new movies and seasons in Discord with Hungarian cards.

Settings: Settings, Utilities, Streambox (or the gear icon on the tile). A Jellyfin API key is required.
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/weekly.php">
<INLINE><![CDATA[<?php
// Started by cron every hour: on the chosen day, from the chosen hour, post the weekly summary once.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/notify_lib.php';
nf_tz();

$cfg = nf_cfg();
if (!nf_on($cfg['weekly']) || (string)$cfg['jf_key'] === '') { exit(0); }
$hook = nf_hook($cfg['dc_weekly']);
if ($hook === '' || !preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['jf_host'])) { exit(0); }

$now = time();
if ((int)date('w', $now) !== (int)$cfg['weekly_day'] || (int)date('G', $now) < (int)$cfg['weekly_hour']) { exit(0); }

$sf = '/boot/config/plugins/streambox/weekly_state.json';
$st = is_file($sf) ? json_decode((string)@file_get_contents($sf), true) : [];
$today = date('Y-m-d', $now);
if (is_array($st) && ($st['last'] ?? '') === $today) { exit(0); }

$lock = @fopen('/tmp/streambox_weekly.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

function nf_mark_week($sf, $today) {
    $tmp = $sf . '.tmp';
    $data = json_encode(['last' => $today]);
    if (@file_put_contents($tmp, $data) === false || !@rename($tmp, $sf)) { @file_put_contents($sf, $data); @unlink($tmp); }
}

$payload = nf_weekly($cfg, $now - 7 * 86400, $now);
if ($payload === false) { nf_log('weekly summary: Jellyfin not reachable, will retry'); exit(0); }
if ($payload === null) { nf_log('weekly summary: nothing new this week'); nf_mark_week($sf, $today); exit(0); }

list($res, $msg) = nf_send($hook, $payload);
if ($res === 'retry') { nf_log('weekly summary: ' . $msg . ', will retry'); exit(0); }
nf_mark_week($sf, $today);
nf_log($res === 'ok' ? 'weekly summary sent' : 'weekly summary not sent: ' . $msg);
]]></INLINE>
</FILE>

<!-- Permissions + done -->
<FILE Name="/tmp/&name;_finish.sh" Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
DIR="/usr/local/emhttp/plugins/streambox"
chmod 644 "$DIR"/*.page "$DIR"/*.php "$DIR"/*.js "$DIR"/icon.png

# Smart-socket sampler: Unraid collects /boot/config/plugins/<name>/*.cron with update_cron.
PHPBIN="$(command -v php || echo /usr/bin/php)"
cat > /boot/config/plugins/streambox/streambox.cron <<CRON
# Streambox: remember the smart socket energy counter every 10 minutes (monthly consumption)
*/10 * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/sample.php >/dev/null 2>&1
# Streambox: Discord notifier, checks Jellyfin for new movies and seasons every minute
* * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/notify.php >/dev/null 2>&1
# Streambox: weekly summary, checked hourly (day and hour are settings)
0 * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/weekly.php >/dev/null 2>&1
# Streambox: this week's episodes, a Discord message for a late episode (only when switched on)
*/10 * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/week_late.php >/dev/null 2>&1
# Streambox: this week's episodes for the row on Jellyfin's home page (week.json, week.js)
*/2 * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/week_web.php >/dev/null 2>&1
CRON
# update_cron reads the plugin link in /var/log/plugins, which appears only after the install scripts
# have finished, so wait for it in the background.
nohup bash -c 'for i in $(seq 1 60); do [ -e /var/log/plugins/streambox.plg ] && break; sleep 1; done; /usr/local/sbin/update_cron' >/dev/null 2>&1 &


# Updates come from GitHub (pluginURL): stop the local update server of earlier versions
pkill -f "php -S 127.0.0.1:18182" 2>/dev/null
rm -f /usr/local/emhttp/plugins/streambox/repo.php
rm -f /tmp/streambox_setup.sh /tmp/streambox_finish.sh
echo ""
echo "----------------------------------------------------"
echo " Streambox installed."
echo " Settings: Settings -> Utilities -> Streambox"
echo " (or the gear icon on the dashboard tile)."
echo "----------------------------------------------------"
exit 0
]]></INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
rm -rf /usr/local/emhttp/plugins/streambox
rm -rf /usr/local/emhttp/plugins/Streambox
pkill -f "php -S 127.0.0.1:18182" 2>/dev/null
rm -f /tmp/streambox_*
rm -f /boot/config/plugins/streambox/streambox.cron
/usr/local/sbin/update_cron 2>/dev/null
# Settings and nicknames in /boot/config/plugins/streambox are kept intentionally.
echo "streambox removed."
exit 0
]]></INLINE>
</FILE>

