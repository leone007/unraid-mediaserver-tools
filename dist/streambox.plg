<p style="opacity:.6;font-size:12px;max-width:130ch">Discord cards: Unraid checks Jellyfin every minute. A movie is announced once its description (in Jellyfin's metadata language) and poster exist; episodes are grouped per season and announced when no new episode has arrived for the "wait for more episodes" time. The first time the notifier is switched on, only items added from then on are announced. The weekly summary lists everything added in the last 7 days at the chosen day and hour (server time zone); if the server was off at that hour it is sent when it is next up the same day. The buttons use the saved settings, so press Apply first. The Jellyfin link in the cards is left out when the Jellyfin link URL is empty. Create a webhook in Discord under channel settings, Integrations, Webhooks.</p>

<p style="opacity:.6;font-size:12px;max-width:130ch">The Jellyfin API key is created in Jellyfin under Dashboard, Advanced, API Keys. Streams that are idle (nothing playing) are not shown. GPU load is read with intel_gpu_top, CPU load from the system statistics. Leave the Jellyfin link URL empty to use this server's address with the Jellyfin port. Leave the smart socket address empty to hide the Socket reading. The monthly consumption is taken from the socket's own energy counter, which Unraid samples every 10 minutes, so the first month counts from the day the socket is set up.</p>

<script>
$(function () {
  var $msg = $('#sb-msg');
  $('#sb-save').on('click', function () {
    var $b = $(this).prop('disabled', true);
    $msg.css('color', '').text('Saving...');
    $.post('/plugins/streambox/save.php', $('#sb-form').serialize(), null, 'json')
      .done(function (r) {
        if (r && r.ok) {
          $msg.css('color', '#3fa24a').text('Saved. The dashboard picks it up within a few seconds.');
        } else {
          $msg.css('color', '#e5534b').text('Not saved: ' + ((r && r.error) ? r.error : 'unknown error'));
        }
      })
      .fail(function (x) {
        var e = (x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : 'HTTP ' + x.status;
        $msg.css('color', '#e5534b').text('Not saved: ' + e);
      })
      .always(function () { $b.prop('disabled', false); });
  });
  $('#sb-wtest').on('click', function () {
    var $b = $(this).prop('disabled', true), $m = $('#sb-wmsg').css('color', '').text('Asking Sonarr... (Apply first if you changed the connection)');
    $.getJSON('/plugins/streambox/week.php', { test: 1, _: Date.now() })
      .done(function (r) { $m.css('color', r && r.ok ? '#3fa24a' : '#e5534b').text((r && r.message) ? r.message : 'unknown answer'); })
      .fail(function (x) { $m.css('color', '#e5534b').text('HTTP ' + x.status); })
      .always(function () { $b.prop('disabled', false); });
  });
  var $nm = $('#sb-nmsg');
  $('#sb-ntest, #sb-nprev, #sb-nweek').on('click', function () {
    var mode = (this.id === 'sb-nprev') ? 'preview' : ((this.id === 'sb-nweek') ? 'weekly' : 'test');
    var $b = $('#sb-ntest, #sb-nprev, #sb-nweek').prop('disabled', true);
    $nm.css('color', '').text('Sending...');
    $.post('/plugins/streambox/notify_test.php', { mode: mode }, null, 'json')
      .done(function (r) { $nm.css('color', r && r.ok ? '#3fa24a' : '#e5534b').text((r && r.message) ? r.message : 'unknown answer'); })
      .fail(function (x) {
        var e = (x.responseJSON && x.responseJSON.message) ? x.responseJSON.message : 'HTTP ' + x.status;
        $nm.css('color', '#e5534b').text(e);
      })
      .always(function () { $b.prop('disabled', false); });
  });
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- JELLYFIN PROXY (sessions + recently added)                 -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/api_fetch.php">
<INLINE><![CDATA[<?php
header('Content-Type: application/json');
header('Cache-Control: no-store');

$cfg = [
    'jf_host' => '127.0.0.1', 'jf_port' => '8096', 'jf_key' => '', 'jf_url' => '',
    'streams_max' => '8', 'added_rows' => '5', 'show_load' => '1',
];
$file = '/boot/config/plugins/streambox/settings.cfg';
if (is_file($file)) {
    $c = @parse_ini_file($file);
    if (is_array($c)) { $cfg = array_merge($cfg, $c); }
}

function sb_flag($v) {
    return !in_array(strtolower(trim((string)$v)), ['0', 'no', 'false', 'off', ''], true);
}

$host = preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['jf_host']) ? $cfg['jf_host'] : '127.0.0.1';
$port = (int)$cfg['jf_port'];
if ($port < 1 || $port > 65535) { $port = 8096; }
$key       = (string)$cfg['jf_key'];
$maxStream = max(1, min(30, (int)$cfg['streams_max']));
$addedRows = max(0, min(20, (int)$cfg['added_rows']));
$link      = trim((string)$cfg['jf_url']);
if (!preg_match('#^https?://[^\s"<>]+$#i', $link)) { $link = ''; }
$base = "http://$host:$port";

$ui = ['port' => $port, 'url' => $link, 'load' => sb_flag($cfg['show_load']), 'added' => $addedRows];

function out($arr) {
    global $ui;
    $arr['ui'] = $ui;
    echo json_encode($arr, JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_UNICODE);
    exit;
}

if ($key === '') { out(['ok' => false, 'error' => 'nokey']); }

function sb_get($path) {
    global $base, $key;
    $ch = curl_init($base . $path);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_CONNECTTIMEOUT => 3,
        CURLOPT_TIMEOUT        => 4,
        CURLOPT_HTTPHEADER     => ['Authorization: MediaBrowser Token="' . $key . '"', 'Accept: application/json'],
    ]);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err  = curl_errno($ch);
    curl_close($ch);
    return [$body, $code, $err];
}

function sb_res($w, $h) {
    $w = (int)$w;
    $h = (int)$h;
    if ($w <= 0 && $h <= 0) { return ''; }
    if ($w >= 3200 || $h >= 1800) { return '2160p'; }
    if ($w >= 2400 || $h >= 1300) { return '1440p'; }
    if ($w >= 1800 || $h >= 1000) { return '1080p'; }
    if ($w >= 1200 || $h >= 700)  { return '720p'; }
    if ($w >= 700  || $h >= 460)  { return '480p'; }
    return 'SD';
}

function sb_vres($vs) {
    if (!is_array($vs)) { return ''; }
    $r = sb_res($vs['Width'] ?? 0, $vs['Height'] ?? 0);
    if ($r !== '' && !empty($vs['IsInterlaced']) && substr($r, -1) === 'p') { $r = substr($r, 0, -1) . 'i'; }
    return $r;
}

// "VideoCodecNotSupported" -> "Video codec"
function sb_reason($r) {
    $r = (string)preg_replace('/(NotSupported|ExceedsLimit)$/', '', (string)$r);
    $r = trim(strtolower((string)preg_replace('/(?<!^)(?=[A-Z])/', ' ', $r)));
    return ($r !== '') ? ucfirst($r) : '';
}

// Short human wording for a Jellyfin transcode reason
function sb_why($r) {
    $map = [
        'ContainerNotSupported'        => 'Container',
        'VideoCodecNotSupported'       => 'Video codec',
        'AudioCodecNotSupported'       => 'Audio codec',
        'SubtitleCodecNotSupported'    => 'Subtitles',
        'AudioChannelsNotSupported'    => 'Audio channels',
        'ContainerBitrateExceedsLimit' => 'Bitrate limit',
        'VideoBitrateNotSupported'     => 'Video bitrate',
        'AudioBitrateNotSupported'     => 'Audio bitrate',
        'InterlacedVideoNotSupported'  => 'Interlaced',
        'VideoResolutionNotSupported'  => 'Resolution',
        'VideoProfileNotSupported'     => 'Video profile',
        'VideoLevelNotSupported'       => 'Video level',
        'VideoRangeTypeNotSupported'   => 'HDR format',
    ];
    $r = (string)$r;
    return isset($map[$r]) ? $map[$r] : sb_reason($r);
}

function sb_audio($it) {
    $first = null;
    foreach ((array)($it['MediaStreams'] ?? []) as $ms) {
        if (!is_array($ms) || ($ms['Type'] ?? '') !== 'Audio') { continue; }
        if ($first === null) { $first = $ms; }
        if (!empty($ms['IsDefault'])) { return $ms; }
    }
    return $first;
}

function sb_short($name) {
    $name  = trim((string)$name);
    $parts = preg_split('/[\s._\-@]+/u', $name);
    $first = ($parts && $parts[0] !== '') ? $parts[0] : $name;
    $n = preg_match_all('/./us', $first);
    if ($n > 8) { return (preg_match('/^.{1,8}/us', $first, $m) ? $m[0] : substr($first, 0, 8)) . "\u{2026}"; }
    return $first;
}

function sb_dev($d) {
    $s = trim((string)preg_replace('/\s*\([^)]*\)\s*$/u', '', (string)$d));
    return ($s !== '') ? $s : (string)$d;
}

function sb_title($it) {
    $type = (string)($it['Type'] ?? '');
    $name = (string)($it['Name'] ?? '?');
    $dot  = " \u{00b7} ";
    if ($type === 'Episode') {
        $series = (string)($it['SeriesName'] ?? '');
        $s = $it['ParentIndexNumber'] ?? null;
        $e = $it['IndexNumber'] ?? null;
        $code = ($s !== null && $e !== null) ? sprintf('S%02dE%02d', (int)$s, (int)$e) : '';
        $tail = trim($code . ' ' . $name);
        return ($series !== '') ? $series . $dot . $tail : $tail;
    }
    if ($type === 'Season') {
        $series = (string)($it['SeriesName'] ?? '');
        return ($series !== '') ? $series . $dot . $name : $name;
    }
    if ($type === 'TvChannel' || $type === 'LiveTvChannel') {
        $cp = is_array($it['CurrentProgram'] ?? null) ? trim((string)($it['CurrentProgram']['Name'] ?? '')) : '';
        return ($cp !== '') ? $name . $dot . $cp : $name;
    }
    $y = $it['ProductionYear'] ?? null;
    return $name . ($y ? ' (' . (int)$y . ')' : '');
}

function sb_video($it) {
    foreach ((array)($it['MediaStreams'] ?? []) as $ms) {
        if (is_array($ms) && ($ms['Type'] ?? '') === 'Video') { return $ms; }
    }
    return null;
}

$nick = [];
$nf = '/boot/config/plugins/streambox/nicknames.json';
if (is_file($nf)) {
    $n = json_decode((string)@file_get_contents($nf), true);
    if (is_array($n)) { $nick = $n; }
}

// ---- Sessions -----------------------------------------------------------
list($b, $code, $err) = sb_get('/Sessions');
if ($err) { out(['ok' => false, 'error' => 'unreachable']); }
if ($code === 401 || $code === 403) { out(['ok' => false, 'error' => 'auth']); }
if ($code !== 200) { out(['ok' => false, 'error' => 'http_' . $code]); }
$sessions = json_decode((string)$b, true);
if (!is_array($sessions)) { out(['ok' => false, 'error' => 'bad_response']); }

$arrow   = " \u{2192} ";
$streams = [];
$users   = [];
$mbps    = 0.0;
$trans   = 0;

foreach ($sessions as $s) {
    $np = $s['NowPlayingItem'] ?? null;
    if (!is_array($np)) { continue; }   // idle client
    $ps = is_array($s['PlayState'] ?? null) ? $s['PlayState'] : [];
    $ti = is_array($s['TranscodingInfo'] ?? null) ? $s['TranscodingInfo'] : null;

    $uid   = (string)($s['UserId'] ?? '');
    $uname = (string)($s['UserName'] ?? '?');
    $short = ($uid !== '' && isset($nick[$uid]) && trim((string)$nick[$uid]) !== '') ? (string)$nick[$uid] : sb_short($uname);
    $users[$uname] = true;

    $vs       = sb_video($np);
    $srcRes   = sb_vres($vs);
    $srcCodec = $vs ? strtoupper((string)($vs['Codec'] ?? '')) : '';
    $srcBps   = $vs ? (int)($vs['BitRate'] ?? 0) : 0;
    $cparts   = explode(',', (string)($np['Container'] ?? ''));
    $srcCont  = strtoupper(trim((string)$cparts[0]));
    $as       = sb_audio($np);
    $srcAudio = $as ? strtoupper((string)($as['Codec'] ?? '')) : '';
    $srcCh    = $as ? (int)($as['Channels'] ?? 0) : 0;
    $rs       = ($ti !== null) ? array_values(array_map('strval', (array)($ti['TranscodeReasons'] ?? []))) : [];

    $mode = (string)($ps['PlayMethod'] ?? '');
    if (!in_array($mode, ['DirectPlay', 'DirectStream', 'Transcode'], true)) {
        if ($ti === null) { $mode = 'DirectPlay'; }
        else { $mode = !empty($ti['IsVideoDirect']) ? 'DirectStream' : 'Transcode'; }
    }

    // Only the audio is transcoded and the video stays untouched: treat it as a direct stream
    if ($mode === 'Transcode' && $ti !== null && !empty($ti['IsVideoDirect'])) { $mode = 'DirectStream'; }

    $resLine = $srcRes;
    if ($srcBps > 0) { $resLine .= (($resLine !== '') ? " \u{00b7} " : '') . number_format($srcBps / 1000000, 1) . ' Mbps'; }

    $detail = '';
    $bps    = $srcBps;
    if ($mode === 'Transcode' && $ti !== null) {
        $trans++;
        $audioCodec = strtoupper((string)($ti['AudioCodec'] ?? '?'));
        if (!empty($ti['IsVideoDirect'])) {
            $detail = 'Audio' . $arrow . $audioCodec;
        } else {
            $dstRes = sb_res($ti['Width'] ?? 0, $ti['Height'] ?? 0);
            $dstCodec = strtoupper((string)($ti['VideoCodec'] ?? ''));
            $rs = array_values(array_map('strval', (array)($ti['TranscodeReasons'] ?? [])));
            $interlaced = in_array('InterlacedVideoNotSupported', $rs, true) || ($vs && !empty($vs['IsInterlaced']));
            if ($dstRes !== '' && $srcRes !== '' && $dstRes !== $srcRes) { $detail = $srcRes . $arrow . $dstRes; }
            elseif ($srcCodec !== '' && $dstCodec !== '' && $srcCodec !== $dstCodec) { $detail = $srcCodec . $arrow . $dstCodec; }
            elseif ($interlaced && $dstRes !== '') { $detail = 'Deinterlace' . $arrow . $dstRes; }
            elseif ($dstRes !== '') { $detail = 'Video' . $arrow . $dstRes; }
            elseif ($rs && sb_reason($rs[0]) !== '') { $detail = sb_reason($rs[0]); }
            else { $detail = 'Video transcode'; }
            $detail .= ((string)($ti['HardwareAccelerationType'] ?? '') !== '') ? " \u{00b7} HW" : " \u{00b7} SW";
        }
        if (!empty($ti['Bitrate'])) { $bps = (int)$ti['Bitrate']; }
    } elseif ($mode === 'DirectStream') {
        // First line: why the stream is not a plain direct play. Second line: resolution and bitrate.
        $why = [];
        foreach ($rs as $r) {
            $t = sb_why($r);
            if ($t !== '' && !in_array($t, $why, true)) { $why[] = $t; }
        }
        $conv = '';
        if ($ti !== null) {
            $dstCont = strtoupper((string)($ti['Container'] ?? ''));
            if ($dstCont !== '' && $srcCont !== '' && $dstCont !== $srcCont) { $conv = $srcCont . $arrow . $dstCont; }
        }
        if ($ti !== null && empty($ti['IsAudioDirect']) && !empty($ti['AudioCodec'])) {
            $line1 = ($srcAudio !== '' ? $srcAudio : 'Audio') . $arrow . strtoupper((string)$ti['AudioCodec']);
        } elseif ($why || $conv) {
            $line1 = implode(" \u{00b7} ", array_filter([implode(', ', $why), $conv]));
        } else {
            // Jellyfin reports no reason: show what the file is made of, which usually explains it
            $line1 = implode(" \u{00b7} ", array_filter([$srcCont, $srcCodec, $srcAudio]));
        }
        $detail = trim($line1 . "\n" . $resLine);
    } else {
        // direct play
        $detail = $resLine;
    }

    // Hover text: everything Jellyfin tells us about this stream
    $methodName = ['DirectPlay' => 'Direct play', 'DirectStream' => 'Direct stream', 'Transcode' => 'Transcode'][$mode];
    $info   = ['Method: ' . $methodName];
    $srcBits = array_filter([
        $srcCont,
        trim($srcCodec . ($srcRes !== '' ? ' ' . $srcRes : '')),
        trim($srcAudio . ($srcCh > 0 ? ' ' . $srcCh . 'ch' : '')),
    ]);
    if ($srcBits) { $info[] = 'Source: ' . implode(" \u{00b7} ", $srcBits); }
    if ($ti !== null) {
        $names = [];
        foreach ($rs as $r) { $names[] = sb_why($r); }
        $info[] = 'Reasons: ' . ($names ? implode(', ', $names) : 'none reported');
    } else {
        $info[] = 'Jellyfin reported no transcoding details for this stream';
    }
    $info[] = 'Client: ' . trim((string)($s['Client'] ?? '') . ' ' . (string)($s['ApplicationVersion'] ?? ''));
    $mbps += $bps / 1000000;

    $pos = (int)($ps['PositionTicks'] ?? 0);
    $rt  = (int)($np['RunTimeTicks'] ?? 0);

    // Live TV has no length of its own; the current program from the guide (EPG) gives start and end
    $live = ($rt <= 0);
    $epg  = false;
    $pct  = ($rt > 0) ? max(0, min(1, $pos / $rt)) : 0;
    $left = ($rt > 0) ? max(0, ($rt - $pos) / 10000000) : 0;
    $cp   = is_array($np['CurrentProgram'] ?? null) ? $np['CurrentProgram'] : null;
    if ($live && $cp !== null && !empty($cp['StartDate']) && !empty($cp['EndDate'])) {
        $st = (int)strtotime((string)$cp['StartDate']);
        $en = (int)strtotime((string)$cp['EndDate']);
        if ($st > 0 && $en > $st) {
            $nowTs = time();
            $pct   = max(0, min(1, ($nowTs - $st) / ($en - $st)));
            $left  = max(0, $en - $nowTs);
            $epg   = true;
            $info[] = 'Program: ' . date('H:i', $st) . " \u{2013} " . date('H:i', $en);
        }
    }
    $dev = (string)($s['DeviceName'] ?? '?');

    $streams[] = [
        'title'       => sb_title($np),
        'type'        => (string)($np['Type'] ?? ''),
        'user'        => $short,
        'user_full'   => $uname,
        'device'      => sb_dev($dev),
        'device_full' => $dev . ' ' . "\u{00b7}" . ' ' . (string)($s['Client'] ?? ''),
        'mode'        => $mode,
        'detail'      => $detail,
        'info'        => implode("\n", $info),
        'pct'         => $pct,
        'left'        => $left,
        'paused'      => !empty($ps['IsPaused']),
        'live'        => $live,
        'epg'         => $epg,
    ];
}

usort($streams, function ($a, $b) {
    if ($a['paused'] !== $b['paused']) { return $a['paused'] ? 1 : -1; }
    return 0;
});
$total   = count($streams);
$more    = max(0, $total - $maxStream);
$streams = array_slice($streams, 0, $maxStream);

// ---- Recently added (cached for a minute) ----------------------------------
$added = [];
if ($addedRows > 0) {
    $cf  = '/tmp/streambox_added.json';
    $now = time();
    $c   = is_file($cf) ? json_decode((string)@file_get_contents($cf), true) : null;
    if (is_array($c) && ($now - (int)($c['t'] ?? 0)) < 60 && (int)($c['n'] ?? -1) === $addedRows && is_array($c['items'] ?? null)) {
        $added = $c['items'];
    } else {
        list($ab, $ac, $ae) = sb_get('/Items?SortBy=DateCreated&SortOrder=Descending&Recursive=true&IncludeItemTypes=Movie,Episode,Season&Limit=' . $addedRows . '&Fields=DateCreated,MediaStreams');
        if (!$ae && $ac === 200) {
            $r = json_decode((string)$ab, true);
            foreach ((array)($r['Items'] ?? []) as $it) {
                if (!is_array($it)) { continue; }
                $v = sb_video($it);
                $added[] = [
                    'title'   => sb_title($it),
                    'type'    => (string)($it['Type'] ?? ''),
                    'quality' => $v ? sb_vres($v) : '',
                    'added'   => isset($it['DateCreated']) ? (int)strtotime((string)$it['DateCreated']) : 0,
                ];
            }
            @file_put_contents($cf, json_encode(['t' => $now, 'n' => $addedRows, 'items' => $added], JSON_INVALID_UTF8_SUBSTITUTE));
        } elseif (is_array($c) && is_array($c['items'] ?? null)) {
            $added = $c['items'];   // Jellyfin hiccup: show the last known list
        }
    }
}

out([
    'ok'            => true,
    'streams'       => $streams,
    'streams_total' => $total,
    'more'          => $more,
    'users'         => count($users),
    'mbps'          => round($mbps, 1),
    'transcoding'   => $trans,
    'added'         => $added,
]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- GPU + CPU LOAD                                             -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/load.php">
<INLINE><![CDATA[<?php
header('Content-Type: application/json');
header('Cache-Control: no-store');

require_once __DIR__ . '/energy.php';

$sbCfg = ['socket_host' => '', 'socket_id' => '0'];
$sbCfgFile = '/boot/config/plugins/streambox/settings.cfg';
if (is_file($sbCfgFile)) {
    $sbRead = @parse_ini_file($sbCfgFile);
    if (is_array($sbRead)) { $sbCfg = array_merge($sbCfg, $sbRead); }
}

// ---- CPU: delta of /proc/stat between two readings --------------------------
function sb_cpu_read() {
    $l = @file('/proc/stat', FILE_IGNORE_NEW_LINES);
    if (!$l) { return null; }
    $p = preg_split('/\s+/', trim($l[0]));
    array_shift($p);
    $v = array_map('intval', array_slice($p, 0, 8));
    return [array_sum($v), (int)($v[3] ?? 0) + (int)($v[4] ?? 0)];
}

$cpu = null;
$cur = sb_cpu_read();
if ($cur !== null) {
    $cf   = '/tmp/streambox_cpu.json';
    $prev = is_file($cf) ? json_decode((string)@file_get_contents($cf), true) : null;
    if (!is_array($prev) || (microtime(true) - (float)($prev['t'] ?? 0)) > 60) {
        $prev = ['t' => microtime(true), 'total' => $cur[0], 'idle' => $cur[1]];
        usleep(300000);
        $cur = sb_cpu_read();
    }
    if ($cur !== null) {
        $dt = $cur[0] - (int)$prev['total'];
        $di = $cur[1] - (int)$prev['idle'];
        if ($dt > 0) { $cpu = max(0, min(100, (1 - $di / $dt) * 100)); }
        @file_put_contents($cf, json_encode(['t' => microtime(true), 'total' => $cur[0], 'idle' => $cur[1]]));
    }
}

// ---- GPU: intel_gpu_top, cached for 8 seconds so several tabs do not pile up --
$gpu     = null;
$gpuNote = '';
$gf      = '/tmp/streambox_gpu.json';
$gc      = is_file($gf) ? json_decode((string)@file_get_contents($gf), true) : null;
if (is_array($gc) && (time() - (int)($gc['t'] ?? 0)) < 8) {
    $gpu     = $gc['gpu'] ?? null;
    $gpuNote = (string)($gc['note'] ?? '');
} else {
    $bin = '';
    foreach (['/usr/bin/intel_gpu_top', '/usr/local/bin/intel_gpu_top', '/usr/sbin/intel_gpu_top'] as $cand) {
        if (is_executable($cand)) { $bin = $cand; break; }
    }
    $disabled = array_map('trim', explode(',', (string)ini_get('disable_functions')));
    if ($bin === '') {
        $gpuNote = 'intel_gpu_top not found';
    } elseif (!function_exists('shell_exec') || in_array('shell_exec', $disabled, true)) {
        $gpuNote = 'shell_exec is disabled in PHP';
    } else {
        $to = '';
        foreach (['/usr/bin/timeout', '/bin/timeout'] as $tb) {
            if (is_executable($tb)) { $to = $tb . ' 4 '; break; }
        }
        $errf = '/tmp/streambox_gpu.err';
        @unlink($errf);
        $raw = (string)@shell_exec($to . escapeshellarg($bin) . ' -J -s 400 -n 2 2>' . escapeshellarg($errf));
        // intel_gpu_top output is not always strict JSON (nan values, a cut-off last sample), so the
        // numbers are read straight from the last sample that contains engine data.
        $chunks = preg_split('/"period"\s*:/', $raw);
        array_shift($chunks);
        $pick = null;
        for ($i = count($chunks) - 1; $i >= 0; $i--) {
            if (preg_match('/"Render\/3D"\s*:\s*\{[^}]*?"busy"\s*:\s*([^,}\s]+)/', $chunks[$i])) { $pick = $chunks[$i]; break; }
        }
        if ($pick !== null) {
            $num = function ($pat) use ($pick) {
                return (preg_match($pat, $pick, $m) && is_numeric($m[1])) ? (float)$m[1] : 0.0;
            };
            $gpu = [
                'video'  => max($num('/"Video"\s*:\s*\{[^}]*?"busy"\s*:\s*([^,}\s]+)/'),
                                $num('/"VideoEnhance"\s*:\s*\{[^}]*?"busy"\s*:\s*([^,}\s]+)/')),
                'render' => $num('/"Render\/3D"\s*:\s*\{[^}]*?"busy"\s*:\s*([^,}\s]+)/'),
                'freq'   => $num('/"actual"\s*:\s*([^,}\s]+)/'),
                'power'  => $num('/"Package"\s*:\s*([^,}\s]+)/'),
            ];
        } else {
            $e = is_file($errf) ? trim((string)@file_get_contents($errf)) : '';
            if ($raw === '') { $gpuNote = 'intel_gpu_top printed nothing' . ($e !== '' ? ': ' . substr($e, 0, 160) : ''); }
            else { $gpuNote = 'no engine data in the output: ' . substr($raw, -200); }
        }
    }
    @file_put_contents($gf, json_encode(['t' => time(), 'gpu' => $gpu, 'note' => $gpuNote]));
}

// ---- Smart socket (power drawn at the wall + monthly energy), cached for 8 seconds ---------
$socket     = null;
$socketNote = '';
$sockHost   = trim((string)$sbCfg['socket_host']);
if ($sockHost !== '') {
    $skf = '/tmp/streambox_socket.json';
    $skc = is_file($skf) ? json_decode((string)@file_get_contents($skf), true) : null;
    if (is_array($skc) && (time() - (int)($skc['t'] ?? 0)) < 8 && (string)($skc['host'] ?? '') === $sockHost) {
        $socket     = $skc['socket'] ?? null;
        $socketNote = (string)($skc['note'] ?? '');
    } else {
        list($sd, $se) = sb_socket_fetch($sockHost, (int)$sbCfg['socket_id']);
        if ($sd !== null) {
            $monthKwh = ($sd['total_wh'] !== null) ? sb_energy_month_wh($sd['total_wh']) / 1000 : null;
            $socket = ['power' => $sd['power'], 'month_kwh' => $monthKwh, 'output' => $sd['output']];
        } else {
            $socketNote = $se;
        }
        @file_put_contents($skf, json_encode(['t' => time(), 'host' => $sockHost, 'socket' => $socket, 'note' => $socketNote]));
    }
}

echo json_encode(['ok' => true, 'gpu' => $gpu, 'cpu' => $cpu, 'gpu_note' => $gpuNote, 'socket' => $socket, 'socket_note' => $socketNote]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SETTINGS SAVE ENDPOINT                                     -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/save.php">
<INLINE><![CDATA[<?php
header('Content-Type: application/json');
header('Cache-Control: no-store');

function sb_out($ok, $extra = []) {
    echo json_encode(array_merge(['ok' => $ok], $extra), JSON_UNESCAPED_UNICODE);
    exit;
}

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); sb_out(false, ['error' => 'method']); }

// CSRF: Unraid's own prepend script validates csrf_token and removes it from $_POST;
// if a token is still present check it, otherwise require an AJAX request.
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); sb_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403);
    sb_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}

$dir   = '/boot/config/plugins/streambox';
$file  = $dir . '/settings.cfg';
$nfile = $dir . '/nicknames.json';

function sb_int($v, $min, $max, $def) { $i = (int)$v; return ($i < $min || $i > $max) ? $def : $i; }
function sb_bool($v) { return in_array(strtolower(trim((string)$v)), ['1', 'yes', 'true', 'on'], true) ? '1' : '0'; }

$host = trim((string)($_POST['jf_host'] ?? '127.0.0.1'));
if (!preg_match('/^[A-Za-z0-9.\-]+$/', $host)) { $host = '127.0.0.1'; }

// the page does not get the saved key and webhooks: empty keeps the saved value, - removes it
$old = is_file($file) ? @parse_ini_file($file, false, INI_SCANNER_RAW) : [];
if (!is_array($old)) { $old = []; }
function sb_keep($name, $old) { $v = trim((string)($_POST[$name] ?? '')); return $v === '' ? (string)($old[$name] ?? '') : ($v === '-' ? '' : $v); }
$key = sb_keep('jf_key', $old);
if (!preg_match('/^[A-Za-z0-9._\-]{0,128}$/', $key)) { sb_out(false, ['error' => 'the API key contains invalid characters']); }

$url = trim(str_replace(["\r", "\n", "\0"], '', (string)($_POST['jf_url'] ?? '')));
if ($url !== '' && !preg_match('#^https?://[^\s"<>]+$#i', $url)) { sb_out(false, ['error' => 'invalid Jellyfin link URL']); }

$sockHost = trim((string)($_POST['socket_host'] ?? ''));
if ($sockHost !== '' && !preg_match('/^[A-Za-z0-9.\-]+$/', $sockHost)) { sb_out(false, ['error' => 'invalid smart socket address']); }

$hookRe = '#^https://(?:discord|discordapp)\.com/api/webhooks/\d{15,25}/[A-Za-z0-9_\-]{20,120}$#';
$dcm = sb_keep('dc_movies', $old);
$dcs = sb_keep('dc_series', $old);
if ($dcm !== '' && !preg_match($hookRe, $dcm)) { sb_out(false, ['error' => 'the movies webhook is not a valid Discord webhook URL']); }
if ($dcs !== '' && !preg_match($hookRe, $dcs)) { sb_out(false, ['error' => 'the series webhook is not a valid Discord webhook URL']); }

$dcw = sb_keep('dc_weekly', $old);
if ($dcw !== '' && !preg_match($hookRe, $dcw)) { sb_out(false, ['error' => 'the weekly summary webhook is not a valid Discord webhook URL']); }

$sonKey = sb_keep('son_key', $old);
if (!preg_match('/^[A-Za-z0-9]{0,64}$/', $sonKey)) { sb_out(false, ['error' => 'the Sonarr API key contains invalid characters']); }
$sonUrl = rtrim(trim(str_replace(["\r", "\n", "\0", '"'], '', (string)($_POST['son_url'] ?? ''))), '/');
if ($sonUrl !== '' && !preg_match('#^https?://[A-Za-z0-9.\-]+(:\d{1,5})?(/[^\s"<>]*)?$#i', $sonUrl)) { sb_out(false, ['error' => 'invalid Sonarr address']); }
$wkWebDir = rtrim(trim((string)($_POST['wk_web_dir'] ?? '/mnt/cache/docker/streambox/web')), '/');
if (!preg_match('#^/mnt/[A-Za-z0-9._\-]+(/[A-Za-z0-9._\-]+)+$#', $wkWebDir)) { sb_out(false, ['error' => 'the folder for Jellyfin must be a path under /mnt (letters, digits, . _ - only)']); }
$wkDelay = (string)($_POST['wk_delay'] ?? 'series');
if (!in_array($wkDelay, ['series', 'idx', 'all'], true)) { $wkDelay = 'series'; }

$oldNotify = is_array($old) ? sb_bool($old['notify'] ?? '0') : '0';
$newNotify = sb_bool($_POST['notify'] ?? '0');

$new = [
    'jf_host'     => $host,
    'jf_port'     => (string)sb_int($_POST['jf_port'] ?? 8096, 1, 65535, 8096),
    'jf_key'      => $key,
    'jf_url'      => $url,
    'streams_max' => (string)sb_int($_POST['streams_max'] ?? 8, 1, 30, 8),
    'added_rows'  => (string)sb_int($_POST['added_rows'] ?? 5, 0, 20, 5),
    'show_load'   => sb_bool($_POST['show_load'] ?? '1'),
    'socket_host' => $sockHost,
    'socket_id'   => (string)sb_int($_POST['socket_id'] ?? 0, 0, 3, 0),
    'notify'        => $newNotify,
    'dc_movies'     => $dcm,
    'dc_series'     => $dcs,
    'notify_settle' => (string)sb_int($_POST['notify_settle'] ?? 5, 1, 60, 5),
    'notify_wait'   => (string)sb_int($_POST['notify_wait'] ?? 30, 1, 240, 30),
    'weekly'        => sb_bool($_POST['weekly'] ?? '0'),
    'dc_weekly'     => $dcw,
    'weekly_day'    => (string)sb_int($_POST['weekly_day'] ?? 5, 0, 6, 5),
    'weekly_hour'   => (string)sb_int($_POST['weekly_hour'] ?? 18, 0, 23, 18),
    'wk_show'       => (string)sb_int($_POST['wk_show'] ?? 1, 0, 2, 1),
    'wk_src'        => ((string)($_POST['wk_src'] ?? '') === 'own') ? 'own' : 'seedbox',
    'son_url'       => $sonUrl,
    'son_key'       => $sonKey,
    'wk_delay'      => $wkDelay,
    'wk_late'       => (string)sb_int($_POST['wk_late'] ?? 2, 1, 48, 2),
    'wk_dc'         => sb_bool($_POST['wk_dc'] ?? '0'),
    'wk_web'        => sb_bool($_POST['wk_web'] ?? '0'),
    'wk_web_dir'    => $wkWebDir,
    'wk_web_view'   => ((string)($_POST['wk_web_view'] ?? '') === 'row') ? 'row' : 'grid',
];

$text = '';
foreach ($new as $k => $v) { $text .= $k . '="' . $v . '"' . "\n"; }

// Nicknames: {userId: nickname}
$map = [];
$in  = $_POST['nick'] ?? [];
if (is_array($in)) {
    foreach ($in as $id => $v) {
        $id = (string)$id;
        if (!preg_match('/^[0-9a-fA-F\-]{32,36}$/', $id)) { continue; }
        $v = trim(preg_replace('/[\x00-\x1f"\\\\]/u', '', (string)$v));
        if ($v === '') { continue; }
        if (preg_match('/^.{1,24}/us', $v, $m)) { $v = $m[0]; }
        $map[$id] = $v;
    }
}

if (!is_dir($dir)) { @mkdir($dir, 0755, true); }

function sb_write($path, $data) {
    $tmp = $path . '.tmp';
    if (@file_put_contents($tmp, $data) === false) { return false; }
    @chmod($tmp, 0600);
    if (!@rename($tmp, $path)) {
        $ok = @file_put_contents($path, $data);
        @unlink($tmp);
        if ($ok === false) { return false; }
    }
    @chmod($path, 0600);
    return true;
}

if (!sb_write($file, $text)) { sb_out(false, ['error' => 'could not write the settings file']); }
// only touch the nickname list when the nickname fields were part of the form
if (isset($_POST['nick']) && !sb_write($nfile, json_encode((object)$map, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT))) {
    sb_out(false, ['error' => 'could not write the nickname file']);
}
@unlink('/tmp/streambox_added.json');
@unlink('/tmp/streambox_week.json');
@unlink('/tmp/streambox_delay.json');
// switched on again: start counting from now, do not announce what was added while it was off
if ($oldNotify !== '1' && $newNotify === '1') { @unlink($dir . '/notify_state.json'); }

$shown = $new;
unset($shown['jf_key'], $shown['son_key'], $shown['dc_movies'], $shown['dc_series'], $shown['dc_weekly']);
sb_out(true, ['saved' => $shown, 'nicknames' => count($map)]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SMART SOCKET (Shelly Gen2+) HELPERS + CRON SAMPLER         -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/energy.php">
<INLINE><![CDATA[<?php
// Smart socket (Shelly Gen2 and newer) helpers: wall power and a monthly energy total.

// Returns [array|null, error text]
function sb_socket_fetch($host, $id) {
    if (!preg_match('/^[A-Za-z0-9.\-]+$/', (string)$host)) { return [null, 'invalid socket address']; }
    $ch = curl_init('http://' . $host . '/rpc/Switch.GetStatus?id=' . (int)$id);
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 2, CURLOPT_TIMEOUT => 3]);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err  = curl_errno($ch);
    curl_close($ch);
    if ($err) { return [null, 'socket unreachable']; }
    if ($code === 401 || $code === 403) { return [null, 'the socket asks for a password (not supported)']; }
    if ($code !== 200) { return [null, 'socket answered HTTP ' . $code]; }
    $d = json_decode((string)$body, true);
    if (!is_array($d) || !isset($d['apower'])) { return [null, 'unexpected answer from the socket']; }
    $total = isset($d['aenergy']['total']) ? (float)$d['aenergy']['total'] : null;
    return [['power' => (float)$d['apower'], 'total_wh' => $total, 'output' => !empty($d['output'])], ''];
}

// Energy used since the 1st of the month, in Wh. The socket keeps a running counter; the counter value at
// the start of the month is remembered on the flash drive. It is written only when the month changes or
// the counter is reset, never on every reading.
function sb_energy_month_wh($total) {
    $sf    = '/boot/config/plugins/streambox/energy.json';
    $lf    = '/tmp/streambox_energy_last.json';
    $month = date('Y-m');
    $st    = is_file($sf) ? json_decode((string)@file_get_contents($sf), true) : null;
    $last  = is_file($lf) ? json_decode((string)@file_get_contents($lf), true) : null;
    $dirty = false;

    if (!is_array($st) || !isset($st['month']) || !isset($st['base'])) {
        $st = ['month' => $month, 'base' => $total, 'carry' => 0.0];
        $dirty = true;
    } elseif ((string)$st['month'] !== $month) {
        $st = ['month' => $month, 'base' => $total, 'carry' => 0.0];
        $dirty = true;
    }

    // The counter went backwards: it was reset (or the socket was replaced). Keep what was counted so far.
    $ref = (is_array($last) && isset($last['total'])) ? (float)$last['total'] : (float)$st['base'];
    if ($total < $ref - 0.001) {
        $st['carry'] = (float)($st['carry'] ?? 0) + max(0.0, $ref - (float)$st['base']);
        $st['base']  = 0.0;   // the counter restarted from zero
        $dirty = true;
    }

    if ($dirty) {
        $tmp = $sf . '.tmp';
        if (@file_put_contents($tmp, json_encode($st)) !== false) {
            if (!@rename($tmp, $sf)) { @file_put_contents($sf, json_encode($st)); @unlink($tmp); }
        }
    }
    @file_put_contents($lf, json_encode(['total' => $total, 't' => time()]));
    return max(0.0, (float)($st['carry'] ?? 0) + $total - (float)$st['base']);
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/sample.php">
<INLINE><![CDATA[<?php
// Started by cron every 10 minutes: remember the smart socket's energy counter, so the monthly
// consumption stays correct even when nobody has the dashboard open.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/energy.php';

$cfg = ['socket_host' => '', 'socket_id' => '0'];
$f = '/boot/config/plugins/streambox/settings.cfg';
if (is_file($f)) {
    $c = @parse_ini_file($f);
    if (is_array($c)) { $cfg = array_merge($cfg, $c); }
}
$host = trim((string)$cfg['socket_host']);
if ($host === '') { exit(0); }

list($s, $err) = sb_socket_fetch($host, (int)$cfg['socket_id']);
if ($s !== null && $s['total_wh'] !== null) { sb_energy_month_wh($s['total_wh']); }
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/week_lib.php">
<INLINE><![CDATA[<?php
// This week's episodes (item 55): the monitored episodes airing Monday to Sunday, from Sonarr's calendar, with the time the
// torrent usually shows up (air time + the median delay of earlier grabs in Sonarr's history) and where each one is now.
// Read-only: only GET requests to Sonarr and Jellyfin. Used by week.php (the tile) and week_late.php (cron, Discord).

const WK_CACHE = '/tmp/streambox_week.json';
const WK_DELAY = '/tmp/streambox_delay.json';

function wk_cfg() {
    $c = [
        'jf_host' => '127.0.0.1', 'jf_port' => '8096', 'jf_key' => '',
        'wk_show' => '1', 'wk_src' => 'seedbox', 'son_url' => '', 'son_key' => '',
        'wk_delay' => 'series', 'wk_late' => '2', 'wk_dc' => '0', 'dc_series' => '',
        'wk_web' => '1', 'wk_web_dir' => '/mnt/cache/docker/streambox/web', 'wk_web_view' => 'grid',
    ];
    $f = getenv('SB_CFG') ?: '/boot/config/plugins/streambox/settings.cfg';   // SB_CFG: tests only
    if (is_file($f)) {
        $x = @parse_ini_file($f, false, INI_SCANNER_RAW);
        if (is_array($x)) { $c = array_merge($c, $x); }
    }
    return $c;
}

// Sonarr address and key: Seedbox's (tools.json) or Streambox's own
function wk_sonarr($cfg) {
    if ((string)$cfg['wk_src'] === 'own') { return [rtrim(trim((string)$cfg['son_url']), '/'), trim((string)$cfg['son_key'])]; }
    $f = getenv('SB_SEEDBOX_TOOLS') ?: '/boot/config/plugins/qbittorrent_widget/tools.json';
    $j = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null;
    $s = is_array($j) && is_array($j['sonarr'] ?? null) ? $j['sonarr'] : [];
    return [rtrim(trim((string)($s['url'] ?? '')), '/'), trim((string)($s['key'] ?? ''))];
}

function wk_tz() {
    $v = @parse_ini_file('/var/local/emhttp/var.ini');
    $tz = is_array($v) ? (string)($v['timeZone'] ?? '') : '';
    if ($tz !== '' && in_array($tz, timezone_identifiers_list(), true)) { date_default_timezone_set($tz); }
}

function wk_http($url, $headers, $timeout = 8) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 3, CURLOPT_TIMEOUT => $timeout,
        CURLOPT_FOLLOWLOCATION => true, CURLOPT_HTTPHEADER => array_merge($headers, ['Accept: application/json'])]);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err = curl_errno($ch);
    curl_close($ch);
    if ($err) { return [null, 'unreachable']; }
    if ($code === 401 || $code === 403) { return [null, 'auth']; }
    if ($code !== 200) { return [null, 'HTTP ' . $code]; }
    $j = json_decode((string)$body, true);
    return is_array($j) ? [$j, ''] : [null, 'bad answer'];
}

function wk_son($son, $path, $timeout = 8) {
    if ($son[0] === '' || $son[1] === '') { return [null, 'nosonarr']; }
    return wk_http($son[0] . '/api/v3' . $path, ['X-Api-Key: ' . $son[1]], $timeout);
}

function wk_jf($cfg, $path) {
    if ((string)$cfg['jf_key'] === '' || !preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['jf_host'])) { return [null, 'nokey']; }
    return wk_http('http://' . $cfg['jf_host'] . ':' . (int)$cfg['jf_port'] . $path, ['Authorization: MediaBrowser Token="' . $cfg['jf_key'] . '"'], 6);
}

function wk_iso($ts) { return gmdate('Y-m-d\TH:i:s\Z', $ts); }
function wk_ts($iso) { $t = strtotime((string)$iso); return $t ? (int)$t : 0; }

// Monday 00:00 of this week (local time) and the next Monday 00:00
function wk_week($now) {
    $mon = strtotime('monday this week 00:00', $now);
    return [$mon, strtotime('+7 days', $mon)];
}

function wk_median($a) {
    sort($a);
    $n = count($a);
    if (!$n) { return null; }
    return ($n % 2) ? $a[intdiv($n, 2)] : (int)round(($a[$n / 2 - 1] + $a[$n / 2]) / 2);
}

// "nCore (Prowlarr)" -> "nCore"
function wk_idx($s) { $s = trim((string)preg_replace('/\s*\(Prowlarr\)\s*$/i', '', (string)$s)); return $s !== '' ? $s : '?'; }

// Grab delays of the last 60 days: [seriesId, indexer, seconds from air time to the first grab], cached for 6 hours
function wk_samples($son, $now) {
    $c = is_file(WK_DELAY) ? json_decode((string)@file_get_contents(WK_DELAY), true) : null;
    $sig = md5($son[0]);
    if (is_array($c) && ($c['sig'] ?? '') === $sig && ($now - (int)($c['t'] ?? 0)) < 6 * 3600 && is_array($c['s'] ?? null)) { return $c['s']; }
    [$h, $e] = wk_son($son, '/history/since?date=' . rawurlencode(wk_iso($now - 60 * 86400)) . '&eventType=1&includeEpisode=true', 20);
    if (!is_array($h)) { return is_array($c['s'] ?? null) ? $c['s'] : []; }
    $first = [];
    foreach ($h as $r) {
        if (!is_array($r)) { continue; }
        $air = wk_ts($r['episode']['airDateUtc'] ?? '');
        $at = wk_ts($r['date'] ?? '');
        $eid = (int)($r['episodeId'] ?? 0);
        if (!$air || !$at || !$eid) { continue; }
        $d = $at - $air;
        if ($d < 0 || $d > 3 * 86400) { continue; }   // grabbed before airing or a late backfill: not a release delay
        if (!isset($first[$eid]) || $d < $first[$eid][2]) { $first[$eid] = [(int)($r['seriesId'] ?? 0), wk_idx($r['data']['indexer'] ?? ''), $d]; }
    }
    $s = array_values($first);
    @file_put_contents(WK_DELAY, json_encode(['t' => $now, 'sig' => $sig, 's' => $s]));
    return $s;
}

// Usual delay for one series: [seconds or null, samples, basis 'series'|'all'|'none', per indexer [[name, seconds, samples]]]
function wk_delay($samples, $sid, $mode) {
    $ser = array_values(array_filter($samples, function ($r) use ($sid) { return $r[0] === $sid; }));
    if ($mode === 'all') {
        $all = array_column($samples, 2);
        return count($all) >= 3 ? [wk_median($all), count($all), 'all', []] : [null, count($all), 'none', []];
    }
    $base = count($ser) >= 3 ? [wk_median(array_column($ser, 2)), count($ser), 'series']
          : (count($samples) >= 3 ? [wk_median(array_column($samples, 2)), count($samples), 'all'] : [null, count($samples), 'none']);
    $idx = [];
    if ($mode === 'idx') {
        // only the indexers this series came from before (a new series: every indexer)
        $names = array_unique(array_column($ser ?: $samples, 1));
        foreach ($names as $n) {
            $s1 = array_column(array_filter($ser, function ($r) use ($n) { return $r[1] === $n; }), 2);
            $s2 = array_column(array_filter($samples, function ($r) use ($n) { return $r[1] === $n; }), 2);
            if (count($s1) >= 3) { $idx[] = [$n, wk_median($s1), count($s1)]; }
            elseif (count($s2) >= 3) { $idx[] = [$n, wk_median($s2), count($s2)]; }
        }
        usort($idx, function ($a, $b) { return $a[1] <=> $b[1]; });
        if ($idx) { $base[0] = $idx[0][1]; }   // the earliest indexer decides when it is expected
    }
    $base[] = $idx;
    return $base;
}

// Sonarr's poster of a series (its public artwork address), '' when it has none
function wk_poster($imgs) {
    foreach ((array)$imgs as $i) {
        $u = is_array($i) ? (string)($i['remoteUrl'] ?? '') : '';
        if (($i['coverType'] ?? '') === 'poster' && preg_match('#^https://[^\s"<>]+$#', $u)) { return $u; }
    }
    return '';
}

// Series Jellyfin lists: tvdb id and normalized name -> Jellyfin item id; null when Jellyfin cannot be asked
function wk_jf_series($cfg) {
    [$j] = wk_jf($cfg, '/Items?IncludeItemTypes=Series&Recursive=true&Fields=ProviderIds&EnableImages=false');
    if (!is_array($j)) { return null; }
    $m = [];
    foreach ((array)($j['Items'] ?? []) as $it) {
        if (!is_array($it) || empty($it['Id'])) { continue; }
        $tv = (string)($it['ProviderIds']['Tvdb'] ?? '');
        if ($tv !== '') { $m['t' . $tv] = (string)$it['Id']; }
        $m['n' . wk_norm($it['Name'] ?? '')] = (string)$it['Id'];
        $m['N' . $it['Id']] = (string)($it['Name'] ?? ''); // the name Jellyfin shows (its metadata language, e.g. Hungarian)
    }
    return $m;
}

function wk_norm($s) { return preg_replace('/[^a-z0-9]+/', '', strtolower((string)preg_replace('/\s*\(\d{4}\)\s*$/', '', (string)$s))); }

// Episodes Jellyfin already lists: tvdb ids and "series|S|E" keys (value: the Jellyfin item id); null when Jellyfin cannot be asked
function wk_jf_have($cfg, $from, $to) {
    $have = [];
    $ok = false;
    $paths = [
        '/Items?IncludeItemTypes=Episode&Recursive=true&MinPremiereDate=' . rawurlencode(wk_iso($from - 2 * 86400)) . '&MaxPremiereDate=' . rawurlencode(wk_iso($to + 86400)) . '&Fields=ProviderIds&EnableImages=false&Limit=500',
        '/Items?IncludeItemTypes=Episode&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Fields=ProviderIds&EnableImages=false&Limit=200',
    ];
    foreach ($paths as $p) {
        [$j, $e] = wk_jf($cfg, $p);
        if (!is_array($j)) { continue; }
        $ok = true;
        foreach ((array)($j['Items'] ?? []) as $it) {
            if (!is_array($it)) { continue; }
            $tv = (string)($it['ProviderIds']['Tvdb'] ?? '');
            $id = (string)($it['Id'] ?? '') ?: '1';
            if ($tv !== '') { $have['t' . $tv] = $id; }
            if (isset($it['ParentIndexNumber'], $it['IndexNumber'])) {
                $have[wk_norm($it['SeriesName'] ?? '') . '|' . (int)$it['ParentIndexNumber'] . '|' . (int)$it['IndexNumber']] = $id;
            }
        }
    }
    return $ok ? $have : null;
}

// The whole band: ['ok', 'error', 'week' => [from, to], 'days' => [...], 'counts' => [...]]
function wk_build($cfg, $now) {
    $son = wk_sonarr($cfg);
    [$from, $to] = wk_week($now);
    $out = ['ok' => false, 'error' => '', 'from' => $from, 'to' => $to, 'days' => [], 'counts' => ['jf' => 0, 'dl' => 0, 'late' => 0, 'all' => 0]];
    if ($son[0] === '' || $son[1] === '') { $out['error'] = 'nosonarr'; return $out; }
    [$cal, $e] = wk_son($son, '/calendar?start=' . rawurlencode(wk_iso($from)) . '&end=' . rawurlencode(wk_iso($to)) . '&unmonitored=false&includeSeries=true');
    if (!is_array($cal)) { $out['error'] = $e; return $out; }
    [$q] = wk_son($son, '/queue?page=1&pageSize=500&includeEpisode=false');
    $queue = [];
    foreach ((array)($q['records'] ?? []) as $r) {
        if (is_array($r) && !empty($r['episodeId'])) { $queue[(int)$r['episodeId']] = $r; }
    }
    $samples = wk_samples($son, $now);
    $have = null;
    foreach ($cal as $ep) { if (!empty($ep['hasFile'])) { $have = wk_jf_have($cfg, $from, $to); break; } }
    $late = max(0, (float)$cfg['wk_late']) * 3600;
    $mode = in_array((string)$cfg['wk_delay'], ['series', 'idx', 'all'], true) ? (string)$cfg['wk_delay'] : 'series';

    // A new series (its first episode airs this week): NEW badge on its rows. Sonarr's firstAired, or S01E01 in the week.
    $newSer = [];
    $d0 = date('Y-m-d', $from); $d1 = date('Y-m-d', $to);
    foreach ($cal as $ep) {
        if (!is_array($ep)) { continue; }
        $fa = substr((string)($ep['series']['firstAired'] ?? ''), 0, 10);
        $air = wk_ts($ep['airDateUtc'] ?? '');
        $first = (int)($ep['seasonNumber'] ?? 0) === 1 && (int)($ep['episodeNumber'] ?? 0) === 1 && $air >= $from && $air < $to;
        if ($first || ($fa !== '' && $fa >= $d0 && $fa < $d1)) { $newSer[(int)($ep['seriesId'] ?? 0)] = 1; }
    }

    $rows = [];
    foreach ($cal as $ep) {
        if (!is_array($ep) || empty($ep['monitored'])) { continue; }
        $air = wk_ts($ep['airDateUtc'] ?? '');
        if (!$air || $air < $from || $air >= $to) { continue; }
        $sid = (int)($ep['seriesId'] ?? 0);
        $ser = (string)($ep['series']['title'] ?? '?');
        $sn = (int)($ep['seasonNumber'] ?? 0); $en = (int)($ep['episodeNumber'] ?? 0);
        [$d, $n, $basis, $idx] = wk_delay($samples, $sid, $mode);
        $exp = $d === null ? null : $air + $d;
        $row = ['id' => (int)($ep['id'] ?? 0), 'series' => $ser, 'code' => sprintf('S%02dE%02d', $sn, $en), 'title' => (string)($ep['title'] ?? ''),
                'air' => $air, 'exp' => $exp, 'delay' => $d, 'n' => $n, 'basis' => $basis, 'idx' => [], 'st' => '', 'pct' => null, 'left' => null, 'new' => isset($newSer[$sid]),
                'tvdb' => (string)($ep['series']['tvdbId'] ?? ''), 'poster' => wk_poster($ep['series']['images'] ?? []), 'jfid' => ''];
        foreach ($idx as $i) { $row['idx'][] = [$i[0], $air + $i[1]]; }
        $qr = $queue[$row['id']] ?? null;
        if (!empty($ep['hasFile'])) {
            if ($have === null) { $row['st'] = 'file'; }
            else {
                $tv = (string)($ep['tvdbId'] ?? '');
                $in = ($tv !== '' && $tv !== '0' && isset($have['t' . $tv])) ? $have['t' . $tv] : ($have[wk_norm($ser) . '|' . $sn . '|' . $en] ?? '');
                $row['st'] = $in !== '' ? 'jf' : 'scan';   // imported, Jellyfin has not listed it yet
                $row['jfid'] = $in !== '1' ? $in : '';
            }
        } elseif ($qr !== null) {
            $ts = strtolower((string)($qr['trackedDownloadState'] ?? ''));
            $qs = strtolower((string)($qr['status'] ?? ''));
            $size = (float)($qr['size'] ?? 0);
            if ($ts === 'failed' || $ts === 'failedpending' || $qs === 'failed') { $row['st'] = 'fail'; }
            elseif (in_array($ts, ['importpending', 'importing', 'imported'], true) || $qs === 'completed') { $row['st'] = 'imp'; }
            elseif ($qs === 'paused') { $row['st'] = 'pause'; }
            elseif ($size > 0 && (float)($qr['sizeleft'] ?? $size) < $size) {
                $row['st'] = 'dl';
                $row['pct'] = round(100 * (1 - (float)$qr['sizeleft'] / $size));
                if (preg_match('/^(?:(\d+)\.)?(\d+):(\d+):(\d+)/', (string)($qr['timeleft'] ?? ''), $m)) { $row['left'] = (int)$m[1] * 86400 + (int)$m[2] * 3600 + (int)$m[3] * 60 + (int)$m[4]; }
            } else { $row['st'] = 'grab'; }
        } elseif ($air > $now) { $row['st'] = 'wait'; }
        elseif ($now > ($exp ?? $air) + $late) { $row['st'] = 'late'; }
        else { $row['st'] = 'aired'; }
        $rows[] = $row;
    }
    usort($rows, function ($a, $b) { return [$a['air'], $a['series']] <=> [$b['air'], $b['series']]; });

    foreach ($rows as $r) {
        $k = date('Y-m-d', $r['air']);
        if (!isset($out['days'][$k])) { $out['days'][$k] = ['label' => date('D j M', $r['air']), 'today' => $k === date('Y-m-d', $now), 'past' => $k < date('Y-m-d', $now), 'rows' => []]; }
        $out['days'][$k]['rows'][] = $r;
        $out['counts']['all']++;
        if ($r['st'] === 'jf' || $r['st'] === 'file') { $out['counts']['jf']++; }
        if ($r['st'] === 'dl' || $r['st'] === 'grab') { $out['counts']['dl']++; }
        if ($r['st'] === 'late') { $out['counts']['late']++; }
    }
    $out['days'] = array_values($out['days']);
    $out['samples'] = count($samples);
    $out['ok'] = true;
    return $out;
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/week.php">
<INLINE><![CDATA[<?php
// The tile's "This week's episodes" band (JSON, cached for a minute). ?test=1 from the settings page checks the Sonarr connection.
header('Content-Type: application/json');
header('Cache-Control: no-store');
require_once __DIR__ . '/week_lib.php';

wk_tz();
$cfg = wk_cfg();
$now = time();
$show = (int)$cfg['wk_show'];

if (!empty($_GET['test'])) {
    $son = wk_sonarr($cfg);
    if ($son[0] === '' || $son[1] === '') {
        echo json_encode(['ok' => false, 'message' => (string)$cfg['wk_src'] === 'own' ? 'Enter the Sonarr address and API key, then Apply.' : 'Seedbox has no Sonarr address and key (Seedbox Tools, Connections).']);
        exit;
    }
    [$st, $e] = wk_son($son, '/system/status');
    if (!is_array($st)) { echo json_encode(['ok' => false, 'message' => 'Sonarr: ' . ($e === 'auth' ? 'the API key was rejected' : $e)]); exit; }
    @unlink(WK_DELAY);
    $n = count(wk_samples($son, $now));
    echo json_encode(['ok' => true, 'message' => 'Sonarr ' . (string)($st['version'] ?? '?') . ' answers; the usual delay is learned from ' . $n . ' grab' . ($n === 1 ? '' : 's') . ' of the last 60 days.']);
    exit;
}

if ($show <= 0) { echo json_encode(['ok' => false, 'show' => 0]); exit; }

$c = is_file(WK_CACHE) ? json_decode((string)@file_get_contents(WK_CACHE), true) : null;
if (is_array($c) && ($now - (int)($c['t'] ?? 0)) < 60 && is_array($c['w'] ?? null) && $now < (int)($c['w']['to'] ?? 0)) {
    $w = $c['w'];
} else {
    $w = wk_build($cfg, $now);
    if ($w['ok']) { @file_put_contents(WK_CACHE, json_encode(['t' => $now, 'w' => $w], JSON_INVALID_UTF8_SUBSTITUTE)); }
    elseif (is_array($c['w'] ?? null) && $w['error'] !== 'nosonarr' && $now < (int)($c['w']['to'] ?? 0)) { $w = $c['w']; }   // Sonarr hiccup: last known list
}
$w['show'] = $show;
$w['now'] = $now;
echo json_encode($w, JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_UNICODE);
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/week_late.php">
<INLINE><![CDATA[<?php
// Started by cron every 10 minutes: one Discord message (series webhook) for each episode of this week that is late,
// i.e. no release a set number of hours after the usual time. Off unless switched on in the settings.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/week_lib.php';
require_once __DIR__ . '/notify_lib.php';

$cfg = wk_cfg();
if (!nf_on($cfg['wk_dc'])) { exit(0); }
$hook = nf_hook($cfg['dc_series']);
if ($hook === '') { exit(0); }
$lock = @fopen('/tmp/streambox_late.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

wk_tz();
$now = time();
$w = wk_build($cfg, $now);
if (!$w['ok']) { exit(0); }

$sf = '/boot/config/plugins/streambox/late_state.json';
$done = is_file($sf) ? json_decode((string)@file_get_contents($sf), true) : null;
$done = is_array($done) ? $done : [];
$days = ['vasárnap', 'hétfő', 'kedd', 'szerda', 'csütörtök', 'péntek', 'szombat'];
$changed = false;

foreach ($w['days'] as $day) {
    foreach ($day['rows'] as $r) {
        if ($r['st'] !== 'late' || isset($done[(string)$r['id']])) { continue; }
        $h = intdiv($now - $r['air'], 3600);
        $msg = '⏰ Késik: **' . nf_md($r['series']) . '** ' . $r['code']
             . ' · adás ' . $days[(int)date('w', $r['air'])] . ' ' . date('H:i', $r['air'])
             . ($r['exp'] !== null ? ', általában ~' . date('H:i', $r['exp']) . ' körül jön (' . $r['n'] . ' rész alapján)' : '')
             . '; az adás óta ' . $h . ' óra telt el, és még nincs kiadás.';
        list($res, $m) = nf_send($hook, ['username' => 'Streambox', 'content' => $msg]);
        if ($res === 'retry') { nf_log('late "' . $r['series'] . ' ' . $r['code'] . '": ' . $m . ', will retry'); break 2; }
        $done[(string)$r['id']] = $now;
        $changed = true;
        nf_log('late ' . ($res === 'ok' ? 'message sent' : 'message not sent (' . $m . ')') . ': ' . $r['series'] . ' ' . $r['code']);
    }
}
if ($changed) {
    $done = array_filter($done, function ($t) use ($now) { return $now - (int)$t < 21 * 86400; });
    @file_put_contents($sf . '.tmp', json_encode($done));
    @rename($sf . '.tmp', $sf);
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/week_web.php">
<INLINE><![CDATA[<?php
// Started by cron every 2 minutes: the "Ezen a héten" row on Jellyfin's home page (web client and Jellyfin Desktop only).
// Writes week.json (series, episode codes, times and states; no keys, no addresses) and the renderer week.js into a folder
// that the Jellyfin container serves read-only under /web/streambox/ (a path mapping). The JavaScript Injector plugin loads
// week.js. Read-only towards Sonarr and Jellyfin; writes only into that folder.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/week_lib.php';

$cfg = wk_cfg();
if ((string)$cfg['wk_web'] !== '1') { exit(0); }
$dir = rtrim(trim((string)$cfg['wk_web_dir']), '/');
if (!preg_match('#^/mnt/[A-Za-z0-9._\-]+(/[A-Za-z0-9._\-]+)+$#', $dir)) { exit(0); }
// The pool or share is mounted only while the array runs: never create its top folder (/mnt/cache) ourselves
$top = '/mnt/' . explode('/', substr($dir, 5))[0];
if (!is_dir($top)) { exit(0); }
if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
if (!is_dir($dir)) { exit(0); }
$lock = @fopen('/tmp/streambox_web.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

function ww_put($f, $data) {
    if (is_file($f) && (string)@file_get_contents($f) === $data) { return; }
    if (@file_put_contents($f . '.tmp', $data) === false) { return; }
    @chmod($f . '.tmp', 0644);
    @rename($f . '.tmp', $f);
}

// The renderer ships with the plugin; copy it when it changed
$js = (string)@file_get_contents(__DIR__ . '/week_web.js');
if ($js !== '') { ww_put($dir . '/week.js', $js); }

wk_tz();
$now = time();
$w = wk_build($cfg, $now);
$jf = $dir . '/week.json';
if (!$w['ok']) {
    // Sonarr hiccup: keep the last list while its week lasts, then say there is nothing to show
    $old = is_file($jf) ? json_decode((string)@file_get_contents($jf), true) : null;
    if (is_array($old) && !empty($old['ok']) && $now < (int)($old['to'] ?? 0)) { exit(0); }
    ww_put($jf, json_encode(['ok' => false, 'gen' => $now]));
    exit(0);
}

$ser = $w['counts']['all'] ? wk_jf_series($cfg) : null;
$eps = [];
foreach ($w['days'] as $day) {
    foreach ($day['rows'] as $r) {
        $sid = '';
        if (is_array($ser)) { $sid = $ser['t' . $r['tvdb']] ?? ($ser['n' . wk_norm($r['series'])] ?? ''); }
        $nm = $sid !== '' ? (string)($ser['N' . $sid] ?? '') : '';
        $eps[] = ['s' => $nm !== '' ? $nm : $r['series'], 'c' => $r['code'], 't' => $r['title'], 'air' => $r['air'], 'exp' => $r['exp'],
                  'st' => $r['st'], 'pct' => $r['pct'], 'new' => $r['new'], 'ep' => $r['jfid'], 'sid' => $sid,
                  'img' => $sid === '' ? $r['poster'] : ''];
    }
}
// Episode titles in Jellyfin's language for the episodes it already has (one request); the rest keep Sonarr's title
$ids = array_values(array_unique(array_filter(array_column($eps, 'ep'), function ($v) { return $v !== '' && $v !== '1'; })));
if ($ids) {
    [$j] = wk_jf($cfg, '/Items?Ids=' . implode(',', array_slice($ids, 0, 200)) . '&EnableImages=false');
    $tn = [];
    foreach ((array)($j['Items'] ?? []) as $it) { if (is_array($it) && !empty($it['Id'])) { $tn[(string)$it['Id']] = (string)($it['Name'] ?? ''); } }
    foreach ($eps as &$x) { if (($tn[$x['ep']] ?? '') !== '') { $x['t'] = $tn[$x['ep']]; } }
    unset($x);
}
$out = ['ok' => true, 'gen' => $now, 'view' => (string)$cfg['wk_web_view'] === 'row' ? 'row' : 'grid', 'from' => $w['from'], 'to' => $w['to'], 'late' => max(1, (float)$cfg['wk_late']) * 3600, 'eps' => $eps];
ww_put($jf, json_encode($out, JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/week_web.js">
<INLINE><![CDATA[/* Streambox: "Ezen a héten" row on Jellyfin's home page (web client and Jellyfin Desktop).
   Loaded by the JavaScript Injector plugin; reads week.json next to this file (written by the Streambox plugin every 2 minutes).
   Two views: calendar (seven day cards) and posters (one poster row with day separators); the default comes from the
   Streambox settings, each viewer can switch with the two icons next to the title (remembered in this browser).
   Read-only: it only shows the list and links to Jellyfin's own pages. */
(function () {
  'use strict';
  if (window.__sbWeek) { return; }
  window.__sbWeek = true;

  var BASE = 'streambox/';
  try { if (document.currentScript && document.currentScript.src) { BASE = new URL('.', document.currentScript.src).href; } } catch (e) { /* keep the default */ }
  var ROOT = new URL('../../', new URL(BASE, location.href)).href;   // the Jellyfin server root (/web/streambox/ -> /)
  var DAYS = ['Hétfő', 'Kedd', 'Szerda', 'Csütörtök', 'Péntek', 'Szombat', 'Vasárnap'];
  var MON = ['jan.', 'febr.', 'márc.', 'ápr.', 'máj.', 'jún.', 'júl.', 'aug.', 'szept.', 'okt.', 'nov.', 'dec.'];
  var KEY = 'streamboxWeekView';
  var data = null, lastFetch = 0, busy = false;

  var css = '' +
    '#sbWeek .sectionTitleContainer{display:flex;align-items:center;flex-wrap:wrap}' +
    '#sbWeek .sectionTitleContainer>*+*{margin-left:.8em}' +
    '#sbWeek button.sectionTitleTextButton{background:none;border:0;font:inherit;cursor:pointer;align-items:center}' +
    '.sbw-meta{opacity:.6;font-size:.9em}' +
    '.sbw-meta b{color:#f0a83a;font-weight:600}' +
    '#sbWeek .sectionTitleContainer>.sbw-views{display:flex;margin-left:auto}' +
    '.sbw-views button+button{margin-left:.2em}' +
    '.sbw-views button{background:none;border:0;color:inherit;opacity:.45;cursor:pointer;padding:.2em;border-radius:6px;line-height:0}' +
    '.sbw-views button.on{opacity:1;background:rgba(255,255,255,.1)}' +
    '.sbw-views button:hover,.sbw-views button:focus-visible{opacity:1;outline:none}' +
    '.sbw-scroll{overflow-x:auto;scrollbar-width:thin}' +
    /* both views: the picture is as high as Jellyfin's Continue watching / Next up cards (--sbw-h, measured), 2:3 like
       its posters; under it two text lines like Jellyfin's cards, so the whole row is as high as those rows */
    '.sbw-grid{display:flex;padding:.3em 0 .6em var(--sbw-x,0px)}' +
    '.sbw-grid>*+*{margin-left:1em}' +
    '.sbw-col{flex:none;width:calc(var(--sbw-h,12em) * 2 / 3);min-width:0}' +
    /* the day card's text scales with the card: four entries (3 lines each) fill its height, the text its width */
    '.sbw-box{height:var(--sbw-h,12em);font-size:calc(var(--sbw-h,12em) / 19.2);line-height:1.3;box-sizing:border-box;background:rgba(255,255,255,.06);border-radius:10px;padding:.35em;overflow-y:auto;overflow-x:hidden;scrollbar-width:none}' +
    '.sbw-box::-webkit-scrollbar{display:none}' +
    '.sbw-col.sbw-today .sbw-box{box-shadow:inset 0 0 0 1px rgba(255,255,255,.6)}' +
    '.sbw-col.sbw-past{opacity:.72}' +
    '.sbw-box>*+*{margin-top:.2em}' +
    '.sbw-ep{display:block;border-radius:.35em;padding:.25em .3em;color:inherit;text-decoration:none}' +
    'a.sbw-ep:hover,a.sbw-ep:focus-visible{background:rgba(255,255,255,.1);outline:none}' +
    '.sbw-n{font-weight:600;display:flex;align-items:center;min-width:0}' +
    '.sbw-n span:first-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}' +
    '.sbw-st{font-size:.9em;line-height:1.45;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}' +
    '.sbw-s{font-size:.9em;line-height:1.45;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}' +
    '.sbw-c{opacity:.6}' +
    '.sbw-new{flex:none;font-size:.72em;background:#b45ff0;color:#fff;border-radius:4px;padding:0 .35em;margin-left:.4em;font-weight:700}' +
    '.sbw-none{font-size:.9em;opacity:.45;padding:.25em .3em}' +
    /* posters view */
    '.sbw-row{display:flex;padding:.3em 0 .6em var(--sbw-x,0px);align-items:stretch}' +
    '.sbw-row>*+*{margin-left:1em}' +
    '.sbw-day{flex:none;writing-mode:vertical-rl;transform:rotate(180deg);font-size:.72em;letter-spacing:.14em;text-transform:uppercase;font-weight:600;opacity:.55;border-left:1px solid rgba(255,255,255,.18);padding-left:.5em;text-align:center}' +
    '.sbw-day.sbw-today{opacity:1;border-color:rgba(255,255,255,.7)}' +
    '.sbw-card{flex:none;width:calc(var(--sbw-h,12em) * 2 / 3);color:inherit;text-decoration:none;min-width:0}' +
    '.sbw-pos{position:relative;height:var(--sbw-h,12em);border-radius:10px;overflow:hidden;background:rgba(255,255,255,.08) center/cover no-repeat}' +
    'a.sbw-card:hover .sbw-pos,a.sbw-card:focus-visible .sbw-pos{box-shadow:0 0 0 2px rgba(255,255,255,.85)}' +
    'a.sbw-card{outline:none}' +
    '.sbw-when{position:absolute;top:.4em;left:.4em;background:rgba(0,0,0,.72);border-radius:6px;padding:.15em .4em;font-size:.68em;font-weight:600;font-variant-numeric:tabular-nums}' +
    '.sbw-pos .sbw-new{position:absolute;top:.4em;right:.4em;margin:0;font-size:.64em;padding:.15em .4em;border-radius:6px}' +
    '.sbw-chip{position:absolute;left:.35em;right:.35em;bottom:.35em;background:rgba(0,0,0,.78);border-radius:7px;padding:.25em .4em;font-size:.68em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600;font-variant-numeric:tabular-nums}' +
    '.sbw-t1{margin-top:.5em;font-weight:600;font-size:.9em;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}' +
    '.sbw-t2{font-size:.8em;line-height:1.35;opacity:.6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}' +
    '.sbw-ok{color:#3fbf7f}.sbw-dl{color:#4a9eff}.sbw-proc{color:#38c7c0}.sbw-late{color:#f0a83a}.sbw-fail{color:#ef5350}.sbw-wait{color:inherit;opacity:.75}' +
    '.sbw-chip.sbw-wait{opacity:1;color:#e6e6e6}';

  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) { e.className = cls; }
    if (text !== undefined) { e.textContent = text; }
    return e;
  }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function hm(ts) { var d = new Date(ts * 1000); return pad(d.getHours()) + ':' + pad(d.getMinutes()); }
  function dur(s) {
    s = Math.max(0, Math.round(s / 60));
    var d = Math.floor(s / 1440), h = Math.floor(s % 1440 / 60), m = s % 60;
    return d ? d + 'n ' + h + 'ó' : (h ? h + 'ó ' + m + 'p' : m + 'p');
  }
  function dayIdx(ts) { return (new Date(ts * 1000).getDay() + 6) % 7; }   // Monday 0 .. Sunday 6

  // Status text and its colour; the countdowns are recomputed in the browser
  function status(e, now) {
    var target = e.exp !== null ? e.exp : e.air;
    switch (e.st) {
      case 'jf': return ['Elérhető', 'sbw-ok'];
      case 'file': case 'scan': case 'imp': return ['Hamarosan elérhető', 'sbw-proc'];
      case 'dl': return ['Letöltés ' + (e.pct !== null ? e.pct + '%' : ''), 'sbw-dl'];
      case 'grab': return ['Letöltés indul', 'sbw-dl'];
      case 'pause': return ['Szünetel', 'sbw-wait'];
      case 'fail': return ['Letöltési hiba', 'sbw-fail'];
      case 'late': return ['Késik ' + dur(now - target), 'sbw-late'];
      default:
        if (target > now) { return [(e.exp !== null ? '' : 'Adás ') + dur(target - now) + ' múlva', 'sbw-wait']; }
        return ['Bármikor jöhet', 'sbw-wait'];
    }
  }

  function link(e) {
    var id = e.ep || e.sid;
    if (!id) { return ''; }
    var sv = '';
    try { sv = window.ApiClient && window.ApiClient.serverId ? window.ApiClient.serverId() : ''; } catch (x) { sv = ''; }
    return '#/details?id=' + encodeURIComponent(id) + (sv ? '&serverId=' + encodeURIComponent(sv) : '');
  }
  function thumb(e, h) {
    if (e.sid) { return ROOT + 'Items/' + encodeURIComponent(e.sid) + '/Images/Primary?fillHeight=' + h + '&quality=90'; }
    return e.img || '';
  }
  function bg(node, src) { if (src) { node.style.backgroundImage = 'url("' + src.replace(/"/g, '%22') + '")'; } }
  function tip(e) {
    return e.s + ' · ' + e.c + (e.t ? ' · ' + e.t : '') + '\nAdás: ' + DAYS[dayIdx(e.air)].toLowerCase() + ' ' + hm(e.air) +
      (e.exp !== null ? '\nVárható: ~' + hm(e.exp) : '');
  }
  function stNode(tag, cls, e, now, i) {
    var st = status(e, now);
    var n = el(tag, cls + ' ' + st[1], st[0]);
    n.setAttribute('data-sbw', i);
    n.setAttribute('data-base', cls);
    return n;
  }

  function view() {
    var v = '';
    try { v = localStorage.getItem(KEY) || ''; } catch (x) { v = ''; }
    if (v !== 'grid' && v !== 'row') { v = data && data.view === 'row' ? 'row' : 'grid'; }
    return v;
  }
  function setView(v) {
    try { localStorage.setItem(KEY, v); } catch (x) { /* this browser only */ }
    render(true);
  }

  function metaText(w) {
    var ready = 0, late = 0;
    w.eps.forEach(function (e) { if (e.st === 'jf') { ready++; } if (e.st === 'late') { late++; } });
    var f = new Date(w.from * 1000), t = new Date(f.getFullYear(), f.getMonth(), f.getDate() + 6);
    var range = MON[f.getMonth()] + ' ' + f.getDate() + '–' + (f.getMonth() !== t.getMonth() ? MON[t.getMonth()] + ' ' : '') + t.getDate() + '.';
    return [range + ' · ' + w.eps.length + ' epizód · ' + ready + ' elérhető', late];
  }

  function buildGrid(w, now) {
    var grid = el('div', 'sbw-grid');
    var today = dayIdx(now), thisWeek = now >= w.from && now < w.to;
    for (var d = 0; d < 7; d++) {
      var col = el('div', 'sbw-col' + (thisWeek && d === today ? ' sbw-today' : '') + (thisWeek && d < today ? ' sbw-past' : ''));
      var eps = [];
      w.eps.forEach(function (e, i) { if (dayIdx(e.air) === d) { eps.push([e, i]); } });
      var box = el('div', 'sbw-box');
      if (!eps.length) { box.appendChild(el('div', 'sbw-none', 'nincs epizód')); }
      eps.forEach(function (x) {
        var e = x[0], href = link(e);
        var row = el(href ? 'a' : 'div', 'sbw-ep');
        if (href) { row.href = href; }
        row.title = tip(e);
        var nm = el('div', 'sbw-n');
        nm.appendChild(el('span', '', e.s));
        if (e['new']) { nm.appendChild(el('span', 'sbw-new', 'ÚJ')); }
        row.appendChild(nm);
        row.appendChild(el('div', 'sbw-s sbw-c', e.c + ' · ' + hm(e.air)));
        row.appendChild(stNode('div', 'sbw-st', e, now, x[1]));
        box.appendChild(row);
      });
      col.appendChild(box);
      // under the card like Jellyfin's card titles: the day, then its date and how many are available
      var n = eps.filter(function (x) { return x[0].st === 'jf'; }).length, dt = new Date(w.from * 1000);
      dt = new Date(dt.getFullYear(), dt.getMonth(), dt.getDate() + d);
      col.appendChild(el('div', 'sbw-t1', thisWeek && d === today ? 'Ma · ' + DAYS[d] : DAYS[d]));
      col.appendChild(el('div', 'sbw-t2', MON[dt.getMonth()] + ' ' + dt.getDate() + '.' + (eps.length ? ' · ' + n + '/' + eps.length + ' elérhető' : '')));
      grid.appendChild(col);
    }
    return grid;
  }

  function buildRow(w, now) {
    var row = el('div', 'sbw-row');
    var today = dayIdx(now), thisWeek = now >= w.from && now < w.to, last = -1;
    w.eps.forEach(function (e, i) {
      var d = dayIdx(e.air);
      if (d !== last) {
        row.appendChild(el('div', 'sbw-day' + (thisWeek && d === today ? ' sbw-today' : ''), (thisWeek && d === today ? 'Ma · ' : '') + DAYS[d]));
        last = d;
      }
      var href = link(e);
      var c = el(href ? 'a' : 'div', 'sbw-card');
      if (href) { c.href = href; }
      c.title = tip(e);
      var p = el('div', 'sbw-pos');
      bg(p, thumb(e, 400));
      p.appendChild(el('span', 'sbw-when', hm(e.air)));
      if (e['new']) { p.appendChild(el('span', 'sbw-new', 'ÚJ')); }
      p.appendChild(stNode('span', 'sbw-chip', e, now, i));
      c.appendChild(p);
      c.appendChild(el('div', 'sbw-t1', e.s));
      c.appendChild(el('div', 'sbw-t2', e.c + (e.t ? ' · ' + e.t : '')));
      row.appendChild(c);
    });
    return row;
  }

  function build(w, v) {
    var now = Date.now() / 1000;
    var box = el('div', 'verticalSection sbw');
    box.id = 'sbWeek';
    var head = el('div', 'sectionTitleContainer sectionTitleContainer-cards padded-left padded-right');
    var h2 = el('h2', 'sectionTitle sectionTitle-cards', 'Ezen a héten');
    // like Jellyfin's own rows: the title with a chevron; here it switches between the calendar and the posters view
    var more = el('button', 'more button-flat button-flat-mini sectionTitleTextButton emby-button');
    more.type = 'button';
    more.title = v === 'row' ? 'Naptár nézet' : 'Poszter nézet';
    more.appendChild(h2);
    var ic = el('span', 'material-icons chevron_right');
    ic.setAttribute('aria-hidden', 'true');
    more.appendChild(ic);
    more.addEventListener('click', function () { setView(v === 'row' ? 'grid' : 'row'); });
    head.appendChild(more);
    var mt = metaText(w);
    var meta = el('span', 'sbw-meta', mt[0]);
    if (mt[1]) { meta.appendChild(document.createTextNode(' · ')); meta.appendChild(el('b', '', mt[1] + ' késik')); }
    head.appendChild(meta);
    var vs = el('span', 'sbw-views');
    [['grid', 'calendar_view_week', 'Naptár nézet'], ['row', 'view_carousel', 'Poszter nézet']].forEach(function (b) {
      var bt = el('button', b[0] === v ? 'on' : '');
      bt.type = 'button';
      bt.title = b[2];
      bt.setAttribute('aria-label', b[2]);
      bt.appendChild(el('span', 'material-icons', b[1]));
      bt.addEventListener('click', function () { setView(b[0]); });
      vs.appendChild(bt);
    });
    head.appendChild(vs);
    box.appendChild(head);
    var sc = el('div', 'sbw-scroll padded-left padded-right');
    sc.appendChild(v === 'row' ? buildRow(w, now) : buildGrid(w, now));
    box.appendChild(sc);
    return box;
  }

  // What the row shows apart from the countdowns: rebuild only when this changes (no flicker of the posters)
  function sig(w, v) {
    return v + '|' + w.from + '|' + new Date().toDateString() + '|' + JSON.stringify(w.eps.map(function (e) {
      return [e.s, e.c, e.t, e.air, e.exp, e.st, e.pct, e['new'], e.ep, e.sid, e.img];
    }));
  }

  function homeSections() {
    var pages = document.querySelectorAll('[id="indexPage"]');
    for (var i = 0; i < pages.length; i++) {
      var p = pages[i];
      if (p.classList.contains('hide') || p.hidden) { continue; }
      var tab = p.querySelector('#homeTab');
      var sec = tab && tab.querySelector('.sections');
      if (sec) { return sec; }
    }
    return null;
  }

  // Picture height of Jellyfin's own wide rows (Continue watching, Next up), so the row is as high as those on every
  // screen; without such a row: the portrait posters' width (Recently added) times the usual wide/portrait card ratio
  function cardHeight(sec) {
    var c = sec.querySelectorAll('.overflowBackdropCard .cardScalable'), i;
    for (i = 0; i < c.length; i++) { if (c[i].offsetHeight > 40) { return c[i].offsetHeight; } }
    c = sec.querySelectorAll('.overflowPortraitCard .cardScalable');
    for (i = 0; i < c.length; i++) { if (c[i].offsetWidth > 40) { return Math.round(c[i].offsetWidth * 1.08); } }
    return 0;
  }

  // Left edge of Jellyfin's card pictures within their row, so the week row starts in line with them on any skin
  function align(box, sec) {
    var j = sec.querySelector('.overflowBackdropCard .cardScalable') || sec.querySelector('.overflowPortraitCard .cardScalable');
    var sc = box.querySelector('.sbw-scroll'), first = sc && sc.firstChild && sc.firstChild.firstChild;
    if (!j || !first || !j.offsetWidth) { return; }
    var jv = j.closest('.verticalSection') || sec;
    var want = j.getBoundingClientRect().left - jv.getBoundingClientRect().left;
    var cur = parseFloat(box.style.getPropertyValue('--sbw-x')) || 0;
    var have = first.getBoundingClientRect().left + sc.scrollLeft - box.getBoundingClientRect().left - cur;
    var x = Math.max(0, Math.round(want - have));
    if (x !== cur) { box.style.setProperty('--sbw-x', x + 'px'); }
  }

  function render(force) {
    var sec = homeSections();
    if (!sec) { return; }
    var old = sec.querySelector('#sbWeek');
    var ch = cardHeight(sec);
    if (old && ch && old.style.getPropertyValue('--sbw-h') !== ch + 'px') { old.style.setProperty('--sbw-h', ch + 'px'); }
    var show = data && data.ok && data.eps && data.eps.length && Date.now() / 1000 < data.to + 3600;
    if (!show) { if (old) { old.remove(); } return; }
    var v = view(), s = sig(data, v);
    if (old && !force && old.getAttribute('data-sig') === s) {
      // same list: refresh the countdowns in place
      var now = Date.now() / 1000;
      Array.prototype.forEach.call(old.querySelectorAll('[data-sbw]'), function (n) {
        var e = data.eps[+n.getAttribute('data-sbw')];
        if (!e) { return; }
        var st = status(e, now);
        if (n.textContent !== st[0]) { n.textContent = st[0]; }
        var cls = n.getAttribute('data-base') + ' ' + st[1];
        if (n.className !== cls) { n.className = cls; }
      });
      align(old, sec);
      return;
    }
    var box = build(data, v);
    box.setAttribute('data-sig', s);
    if (ch) { box.style.setProperty('--sbw-h', ch + 'px'); }
    var x = old ? old.querySelector('.sbw-scroll').scrollLeft : -1;
    if (old) { box.style.setProperty('--sbw-x', old.style.getPropertyValue('--sbw-x')); old.replaceWith(box); } else { sec.insertBefore(box, sec.firstChild); }
    align(box, sec);
    var sc = box.querySelector('.sbw-scroll'), td = box.querySelector('.sbw-today');
    if (x >= 0 && !force) { sc.scrollLeft = x; }
    else if (td && sc.scrollWidth > sc.clientWidth) { sc.scrollLeft = Math.max(0, td.offsetLeft - sc.offsetLeft - 8); }   // today in sight
  }

  function load(force) {
    if (busy || (!force && Date.now() - lastFetch < 110000)) { return; }
    busy = true;
    fetch(BASE + 'week.json?_=' + Date.now(), { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) { if (j) { data = j; } lastFetch = Date.now(); render(false); })
      .catch(function () { lastFetch = Date.now(); })
      .then(function () { busy = false; });
  }

  // Jellyfin rebuilds the home page on navigation: put the row back when it is missing
  var queued = false;
  function check() {
    queued = false;
    var sec = homeSections();
    if (!sec) { return; }
    if (!sec.querySelector('#sbWeek')) { if (data) { render(false); } load(!data); }
    else if (data) { render(false); }   // Jellyfin's rows came in: the card height may follow them
  }
  function start() {
    var st = document.createElement('style');
    st.id = 'sbWeekCss';
    st.textContent = css;
    document.head.appendChild(st);
    new MutationObserver(function () { if (!queued) { queued = true; requestAnimationFrame(check); } })
      .observe(document.body, { childList: true, subtree: true });
    setInterval(function () { if (homeSections()) { load(false); render(false); } }, 30000);
    // Jellyfin sizes its cards to the window: measure again when the window changes
    window.addEventListener('resize', function () { if (!queued) { queued = true; requestAnimationFrame(check); } });
    load(true);
  }
  if (document.body) { start(); } else { document.addEventListener('DOMContentLoaded', start); }
})();
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/lang.php">
<INLINE><![CDATA[<?php
// Shared language setting of the media server tools (Sysbox, Diskbox, Seedbox, Streambox): one file on the
// flash drive that every plugin reads, so changing it on any settings page changes it for all of them.
//   ui      = auto (follow Unraid's language, Settings, Display Settings) | en
//   discord = auto (follow Unraid) | en | hu
// A language the pages or Discord are not translated to falls back to English. Every plugin ships its own
// copy of this file; the guard keeps a second copy from being declared again in the same request.
if (!function_exists('mt_lang_cfg')) {

define('MT_LANG_FILE', '/boot/config/plugins/mediaserver-tools/lang.cfg');

function mt_lang_have($what) { return $what === 'discord' ? ['en', 'hu'] : ['en']; }

// Unraid's display language as a locale ('' = English, the built-in one)
function mt_lang_unraid() {
    $d = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true);
    return (is_array($d) && isset($d['display']) && is_array($d['display'])) ? trim((string)($d['display']['locale'] ?? '')) : '';
}
function mt_lang_code($locale) { $c = strtolower(substr((string)$locale, 0, 2)); return preg_match('/^[a-z]{2}$/', $c) ? $c : 'en'; }
function mt_lang_name($code) {
    $n = ['en' => 'English', 'hu' => 'Magyar', 'de' => 'Deutsch', 'fr' => 'Français', 'es' => 'Español', 'it' => 'Italiano', 'nl' => 'Nederlands',
          'pl' => 'Polski', 'pt' => 'Português', 'ru' => 'Русский', 'zh' => '中文', 'ja' => '日本語', 'ko' => '한국어', 'cs' => 'Čeština', 'sv' => 'Svenska'];
    return $n[$code] ?? $code;
}

// Before the shared setting existed every plugin had its own Discord language, Hungarian by default: a server
// that already sends Discord messages keeps the language it had; a new install starts in English.
function mt_lang_legacy() {
    $ini = function ($f) { $c = is_file($f) ? @parse_ini_file($f, false, INI_SCANNER_RAW) : false; return is_array($c) ? $c : null; };
    foreach (['/boot/config/plugins/sysbox/settings.cfg', '/boot/config/plugins/diskbox/settings.cfg'] as $f) {
        $c = $ini($f);
        if ($c === null) { continue; }
        if (isset($c['dc_lang'])) { return trim((string)$c['dc_lang'], "\"' ") === 'en' ? 'en' : 'hu'; }
        if (trim((string)($c['dc_hook'] ?? ''), "\"' ") !== '') { return 'hu'; }
    }
    $j = @json_decode((string)@file_get_contents('/boot/config/plugins/qbittorrent_widget/tools.json'), true);
    if (is_array($j)) {
        if (isset($j['dc_lang'])) { return $j['dc_lang'] === 'en' ? 'en' : 'hu'; }
        if (trim((string)($j['dc_hook'] ?? '')) !== '') { return 'hu'; }
    }
    $c = $ini('/boot/config/plugins/streambox/settings.cfg');
    if ($c !== null && (trim((string)($c['dc_movies'] ?? ''), "\"' ") !== '' || trim((string)($c['dc_series'] ?? ''), "\"' ") !== '')) { return 'hu'; }
    return 'en';
}

function mt_lang_cfg() {
    $c = ['ui' => 'auto', 'discord' => ''];
    $f = is_file(MT_LANG_FILE) ? @parse_ini_file(MT_LANG_FILE) : false;
    if (is_array($f)) {
        if (in_array($f['ui'] ?? '', ['auto', 'en'], true)) { $c['ui'] = $f['ui']; }
        if (in_array($f['discord'] ?? '', ['auto', 'en', 'hu'], true)) { $c['discord'] = $f['discord']; }
    }
    if ($c['discord'] === '') { $c['discord'] = mt_lang_legacy(); }
    return $c;
}

// The language the pages and tiles use, and the one Discord messages use (always one that exists)
function mt_lang_ui() {
    $c = mt_lang_cfg();
    $w = $c['ui'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['ui'];
    return in_array($w, mt_lang_have('ui'), true) ? $w : 'en';
}
function mt_lang_discord() {
    static $l = null;
    if ($l !== null) { return $l; }
    $c = mt_lang_cfg();
    $w = $c['discord'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['discord'];
    return $l = in_array($w, mt_lang_have('discord'), true) ? $w : 'en';
}

function mt_lang_save($ui, $discord) {
    if (!in_array($ui, ['auto', 'en'], true) || !in_array($discord, ['auto', 'en', 'hu'], true)) { return false; }
    @mkdir(dirname(MT_LANG_FILE), 0777, true);
    $tmp = MT_LANG_FILE . '.tmp';
    if (@file_put_contents($tmp, 'ui="' . $ui . "\"\ndiscord=\"" . $discord . "\"\n") === false) { return false; }
    return @rename($tmp, MT_LANG_FILE);
}

}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/lang_block.php">
<INLINE><![CDATA[<?php
// The Language block of every settings page (Sysbox, Diskbox, Seedbox Tools, Streambox): the shared setting of
// lang.php. The page sets $mt_lang_post (this plugin's lang_save.php) and includes this file.
require_once __DIR__ . '/lang.php';
$mtl_c = mt_lang_cfg();
$mtl_u = mt_lang_code(mt_lang_unraid());
$mtl_var = @parse_ini_file('/var/local/emhttp/var.ini');
$mtl_tok = is_array($mtl_var) ? (string)($mtl_var['csrf_token'] ?? '') : '';
$mtl_ui_now = in_array($mtl_u, mt_lang_have('ui'), true) ? mt_lang_name($mtl_u) : mt_lang_name($mtl_u) . ', shown in English';
$mtl_dc_now = in_array($mtl_u, mt_lang_have('discord'), true) ? mt_lang_name($mtl_u) : mt_lang_name($mtl_u) . ', sent in English';
$mtl_h = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES); };
$mtl_sel = function ($a, $b) { return $a === $b ? ' selected' : ''; };
?>
<style>
#mtl{margin:28px 0 8px;max-width:1100px}
#mtl .mtl-band{display:flex;justify-content:space-between;align-items:center;gap:12px;background:rgba(0,0,0,.35);padding:10px 14px;text-transform:uppercase;letter-spacing:1.5px;font-size:12px}
#mtl .mtl-band b{font-weight:normal;text-transform:none;letter-spacing:0;opacity:.6}
#mtl .mtl-box{background:rgba(128,128,128,.08);border-radius:0 0 6px 6px}
#mtl .mtl-row{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px;padding:14px 16px;border-left:3px solid #8a8a8a;border-bottom:1px solid rgba(128,128,128,.15)}
#mtl .mtl-row label{padding-top:6px}
#mtl .mtl-row select{width:auto;min-width:260px;max-width:100%;margin:0}
#mtl .mtl-hint{display:block;opacity:.6;line-height:1.5;margin-top:6px;white-space:normal}
#mtl .mtl-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px}
#mtl .mtl-foot button{margin:0}
@media (max-width:700px){#mtl .mtl-row{grid-template-columns:1fr;gap:4px}}
</style>
<div id="mtl">
  <div class="mtl-band"><span>Language</span><b>shared by Sysbox, Diskbox, Seedbox and Streambox</b></div>
  <div class="mtl-box">
    <div class="mtl-row">
      <label for="mtl-ui">Pages and tiles:</label>
      <div>
        <select id="mtl-ui">
          <option value="auto"<?=$mtl_sel($mtl_c['ui'], 'auto')?>>Follow Unraid (now: <?=$mtl_h($mtl_ui_now)?>)</option>
          <option value="en"<?=$mtl_sel($mtl_c['ui'], 'en')?>>English</option>
        </select>
        <span class="mtl-hint">Unraid's language is set under Settings, Display Settings. A language the plugins are not translated to yet shows in English. More languages come here as they are translated.</span>
      </div>
    </div>
    <div class="mtl-row">
      <label for="mtl-dc">Discord messages:</label>
      <div>
        <select id="mtl-dc">
          <option value="auto"<?=$mtl_sel($mtl_c['discord'], 'auto')?>>Follow Unraid (now: <?=$mtl_h($mtl_dc_now)?>)</option>
          <option value="en"<?=$mtl_sel($mtl_c['discord'], 'en')?>>English</option>
          <option value="hu"<?=$mtl_sel($mtl_c['discord'], 'hu')?>>Magyar</option>
        </select>
        <span class="mtl-hint">Every message of the four plugins: alerts, weekly summaries, new movies and series, the Discord bot. Movie and series titles stay as Jellyfin and Sonarr give them.</span>
      </div>
    </div>
    <div class="mtl-foot">
      <span id="mtl-msg" class="mtl-hint" style="margin:0">Saved for all plugins at once.</span>
      <button type="button" id="mtl-apply">Save language</button>
    </div>
  </div>
</div>
<script>
$(function () {
  // Unraid disables the Apply buttons of a page until its form changes: this block is outside every form, so it is a
  // button of its own name, enabled here (also after Unraid's own page scripts ran)
  var en = function () { $('#mtl-apply').prop('disabled', false).removeAttr('disabled'); };
  en(); setTimeout(en, 500); $('#mtl-ui, #mtl-dc').on('change', en);
  $('#mtl-apply').on('click', function () {
    var $b = $(this).prop('disabled', true), $m = $('#mtl-msg');
    $.post(<?=json_encode((string)$mt_lang_post)?>, { ui: $('#mtl-ui').val(), discord: $('#mtl-dc').val(), csrf_token: <?=json_encode($mtl_tok)?> }, null, 'json')
      .done(function (r) { $m.css({ color: r.ok ? '#3fa24a' : '#e5534b', opacity: 1 }).text(r.ok ? 'Saved for Sysbox, Diskbox, Seedbox and Streambox.' : (r.error || 'Not saved')); })
      .fail(function (x) { $m.css({ color: '#e5534b', opacity: 1 }).text((x.responseJSON && x.responseJSON.error) || 'Not saved'); })
      .always(function () { $b.prop('disabled', false); });
  });
});
</script>
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/lang_save.php">
<INLINE><![CDATA[<?php
// Saves the shared language setting (see lang.php). POST ui, discord, csrf_token.
require_once __DIR__ . '/lang.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function mt_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra)); exit; }
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); mt_out(false, ['error' => 'method']); }
$var = @parse_ini_file('/var/local/emhttp/var.ini');
$tok = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
// Unraid's own prepend checks the token of every POST and then removes it from $_POST: no token here means it was
// checked already, which is accepted for an AJAX request only (like the other endpoints of these plugins)
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); mt_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); mt_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}
if (!mt_lang_save((string)($_POST['ui'] ?? ''), (string)($_POST['discord'] ?? ''))) { mt_out(false, ['error' => 'could not save the language setting']); }
mt_out(true);
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/notify_lib.php">
<INLINE><![CDATA[<?php
// Discord notifier helpers (Streambox): Hungarian cards for new movies and seasons.

require_once __DIR__ . '/lang.php';
// Discord texts in the shared language (lang.php): Hungarian or English
function nf_t($hu, $en) { return mt_lang_discord() === 'en' ? $en : $hu; }
function nf_dec() { return mt_lang_discord() === 'en' ? '.' : ','; }
const NF_FIELDS = 'Overview,Genres,People,MediaStreams,MediaSources,DateCreated,OriginalTitle,ProductionYear';

function nf_cfg() {
    $c = [
        'jf_host' => '127.0.0.1', 'jf_port' => '8096', 'jf_key' => '', 'jf_url' => '',
        'notify' => '0', 'dc_movies' => '', 'dc_series' => '', 'notify_settle' => '5', 'notify_wait' => '30',
        'weekly' => '0', 'dc_weekly' => '', 'weekly_day' => '5', 'weekly_hour' => '18',
    ];
    $f = '/boot/config/plugins/streambox/settings.cfg';
    if (is_file($f)) {
        $x = @parse_ini_file($f);
        if (is_array($x)) { $c = array_merge($c, $x); }
    }
    return $c;
}

function nf_on($v) { return in_array(strtolower(trim((string)$v)), ['1', 'yes', 'true', 'on'], true); }

function nf_hook($u) {
    $u = trim((string)$u);
    return preg_match('#^https://(?:discord|discordapp)\.com/api/webhooks/\d{15,25}/[A-Za-z0-9_\-]{20,120}$#', $u) ? $u : '';
}

function nf_log($m) {
    $f = '/tmp/streambox_notify.log';
    $lines = is_file($f) ? (array)@file($f, FILE_IGNORE_NEW_LINES) : [];
    $lines[] = date('Y-m-d H:i:s') . ' ' . $m;
    @file_put_contents($f, implode("\n", array_slice($lines, -100)) . "\n");
}

// ---- Jellyfin ---------------------------------------------------------------------------------
function nf_get($cfg, $path) {
    $ch = curl_init('http://' . $cfg['jf_host'] . ':' . (int)$cfg['jf_port'] . $path);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 3, CURLOPT_TIMEOUT => 25,
        CURLOPT_HTTPHEADER => ['Authorization: MediaBrowser Token="' . $cfg['jf_key'] . '"', 'Accept: */*'],
    ]);
    $b = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    return ($code === 200 && is_string($b)) ? $b : null;
}

function nf_json($cfg, $path) {
    $b = nf_get($cfg, $path);
    if ($b === null) { return null; }
    $d = json_decode($b, true);
    return is_array($d) ? $d : null;
}

function nf_item($cfg, $id) {
    if ($id === '' || !preg_match('/^[0-9a-fA-F\-]{32,36}$/', $id)) { return null; }
    $d = nf_json($cfg, '/Items?Ids=' . rawurlencode($id) . '&Fields=' . NF_FIELDS);
    return (is_array($d) && !empty($d['Items'][0])) ? $d['Items'][0] : null;
}

function nf_image($cfg, $id, $type, $w) {
    $p = '/Items/' . rawurlencode($id) . '/Images/' . $type . ($type === 'Backdrop' ? '/0' : '')
       . '?maxWidth=' . (int)$w . '&quality=90&format=Jpg';
    $b = nf_get($cfg, $p);
    return ($b !== null && strlen($b) > 500 && strlen($b) < 7000000) ? $b : null;
}

function nf_info($cfg) {
    static $info = null;
    if ($info === null) {
        $d = nf_json($cfg, '/System/Info/Public');
        $info = ['Version' => (string)($d['Version'] ?? ''), 'Id' => (string)($d['Id'] ?? '')];
    }
    return $info;
}

function nf_link($cfg, $id) {
    $base = rtrim(trim((string)$cfg['jf_url']), '/');
    if ($base === '') { return ''; }
    $info = nf_info($cfg);
    return $base . '/web/#/details?id=' . $id . ($info['Id'] !== '' ? '&serverId=' . $info['Id'] : '');
}

function nf_ts($iso) {
    $t = strtotime(preg_replace('/\.\d+/', '', (string)$iso));
    return $t === false ? 0 : (int)$t;
}

function nf_ready($item) {
    return $item !== null && trim((string)($item['Overview'] ?? '')) !== '' && !empty($item['ImageTags']['Primary']);
}

// ---- text helpers -----------------------------------------------------------------------------
function nf_trunc($s, $max) {
    $s = trim((string)preg_replace('/\s+/u', ' ', (string)$s));
    if (mb_strlen($s) <= $max) { return $s; }
    $c = mb_substr($s, 0, $max);
    $p = mb_strrpos($c, ' ');
    if ($p !== false && $p > $max * 0.6) { $c = mb_substr($c, 0, $p); }
    return rtrim($c, " \t,;:.-") . "\u{2026}";
}

function nf_md($s) { return preg_replace('/([\\\\*_~`|>])/u', '\\\\$1', (string)$s); }

function nf_runtime($ticks) {
    $min = (int)round(((float)$ticks) / 10000000 / 60);
    if ($min <= 0) { return ''; }
    $h = intdiv($min, 60);
    $m = $min % 60;
    if (mt_lang_discord() === 'en') { return $h > 0 ? $h . ' h' . ($m > 0 ? ' ' . $m . ' min' : '') : $m . ' min'; }
    if ($h > 0) { return $h . ' óra' . ($m > 0 ? ' ' . $m . ' perc' : ''); }
    return $m . ' perc';
}

function nf_size($bytes) {
    $b = (float)$bytes;
    if ($b <= 0) { return ''; }
    if ($b >= 1073741824) { return number_format($b / 1073741824, 1, nf_dec(), '') . ' GB'; }
    return number_format($b / 1048576, 0, nf_dec(), '') . ' MB';
}

function nf_genres($list, $max = 4) {
    static $map = [
        'Action' => 'Akció', 'Adventure' => 'Kaland', 'Animation' => 'Animáció', 'Comedy' => 'Vígjáték',
        'Crime' => 'Krimi', 'Documentary' => 'Dokumentum', 'Drama' => 'Dráma', 'Family' => 'Családi',
        'Fantasy' => 'Fantasy', 'History' => 'Történelmi', 'Horror' => 'Horror', 'Music' => 'Zenei',
        'Musical' => 'Musical', 'Mystery' => 'Misztikus', 'Romance' => 'Romantikus',
        'Science Fiction' => 'Sci-fi', 'Sci-Fi & Fantasy' => 'Sci-fi és fantasy', 'TV Movie' => 'TV-film',
        'Thriller' => 'Thriller', 'War' => 'Háborús', 'Western' => 'Western', 'Action & Adventure' => 'Akció és kaland',
        'Kids' => 'Gyerek', 'News' => 'Hírek', 'Reality' => 'Valóságshow', 'Soap' => 'Szappanopera',
        'Talk' => 'Beszélgetős', 'War & Politics' => 'Háború és politika', 'Biography' => 'Életrajzi',
        'Sport' => 'Sport', 'Anime' => 'Anime',
    ];
    $out = [];
    $en = mt_lang_discord() === 'en';   // Jellyfin's genre names are English already
    foreach ((array)$list as $g) { $g = (string)$g; $out[] = $en ? $g : ($map[$g] ?? $g); }
    return implode(', ', array_slice($out, 0, $max));
}

function nf_cast($item) {
    $n = [];
    foreach ((array)($item['People'] ?? []) as $p) {
        if (($p['Type'] ?? '') === 'Actor' && !empty($p['Name'])) { $n[] = (string)$p['Name']; }
        if (count($n) >= 5) { break; }
    }
    return implode(', ', $n);
}

function nf_lang($code) {
    static $map = [
        'eng' => 'angol', 'hun' => 'magyar', 'ger' => 'német', 'deu' => 'német', 'fre' => 'francia', 'fra' => 'francia',
        'spa' => 'spanyol', 'ita' => 'olasz', 'jpn' => 'japán', 'kor' => 'koreai', 'chi' => 'kínai', 'zho' => 'kínai',
        'rus' => 'orosz', 'por' => 'portugál', 'pol' => 'lengyel', 'cze' => 'cseh', 'ces' => 'cseh', 'dut' => 'holland',
        'nld' => 'holland', 'swe' => 'svéd', 'tur' => 'török', 'hin' => 'hindi', 'dan' => 'dán', 'nor' => 'norvég',
        'fin' => 'finn', 'rum' => 'román', 'ron' => 'román', 'slo' => 'szlovák', 'slk' => 'szlovák', 'hrv' => 'horvát',
        'srp' => 'szerb', 'ukr' => 'ukrán', 'ara' => 'arab', 'heb' => 'héber', 'gre' => 'görög', 'ell' => 'görög',
        'tha' => 'thai', 'vie' => 'vietnami', 'bul' => 'bolgár', 'slv' => 'szlovén', 'bos' => 'bosnyák',
        'mac' => 'macedón', 'mkd' => 'macedón', 'alb' => 'albán', 'sqi' => 'albán', 'lit' => 'litván', 'lav' => 'lett',
        'est' => 'észt', 'ice' => 'izlandi', 'isl' => 'izlandi', 'nob' => 'norvég', 'nno' => 'norvég', 'per' => 'perzsa',
        'fas' => 'perzsa', 'ind' => 'indonéz', 'may' => 'maláj', 'msa' => 'maláj', 'cat' => 'katalán', 'baq' => 'baszk',
        'eus' => 'baszk', 'glg' => 'galego', 'afr' => 'afrikaans', 'ben' => 'bengáli', 'tam' => 'tamil', 'tel' => 'telugu',
        'fil' => 'filippínó', 'tgl' => 'filippínó', 'urd' => 'urdu',
    ];
    static $en = ['eng' => 'English', 'hun' => 'Hungarian', 'ger' => 'German', 'deu' => 'German', 'fre' => 'French', 'fra' => 'French',
        'spa' => 'Spanish', 'ita' => 'Italian', 'jpn' => 'Japanese', 'kor' => 'Korean', 'chi' => 'Chinese', 'zho' => 'Chinese',
        'rus' => 'Russian', 'por' => 'Portuguese', 'pol' => 'Polish', 'cze' => 'Czech', 'ces' => 'Czech', 'dut' => 'Dutch',
        'nld' => 'Dutch', 'swe' => 'Swedish', 'tur' => 'Turkish', 'hin' => 'Hindi', 'dan' => 'Danish', 'nor' => 'Norwegian',
        'fin' => 'Finnish', 'rum' => 'Romanian', 'ron' => 'Romanian', 'slo' => 'Slovak', 'slk' => 'Slovak', 'hrv' => 'Croatian',
        'srp' => 'Serbian', 'ukr' => 'Ukrainian', 'ara' => 'Arabic', 'heb' => 'Hebrew', 'gre' => 'Greek', 'ell' => 'Greek',
        'tha' => 'Thai', 'vie' => 'Vietnamese', 'bul' => 'Bulgarian', 'slv' => 'Slovenian', 'bos' => 'Bosnian',
        'mac' => 'Macedonian', 'mkd' => 'Macedonian', 'alb' => 'Albanian', 'sqi' => 'Albanian', 'lit' => 'Lithuanian', 'lav' => 'Latvian',
        'est' => 'Estonian', 'ice' => 'Icelandic', 'isl' => 'Icelandic', 'nob' => 'Norwegian', 'nno' => 'Norwegian', 'per' => 'Persian',
        'fas' => 'Persian', 'ind' => 'Indonesian', 'may' => 'Malay', 'msa' => 'Malay', 'cat' => 'Catalan', 'baq' => 'Basque',
        'eus' => 'Basque', 'glg' => 'Galician', 'afr' => 'Afrikaans', 'ben' => 'Bengali', 'tam' => 'Tamil', 'tel' => 'Telugu',
        'fil' => 'Filipino', 'tgl' => 'Filipino', 'urd' => 'Urdu'];
    $c = strtolower(trim((string)$code));
    if (mt_lang_discord() === 'en') { return ($c === '' || $c === 'und') ? 'unknown' : ($en[$c] ?? $c); }
    if ($c === '' || $c === 'und') { return 'ismeretlen'; }
    return $map[$c] ?? $c;
}

function nf_acodec($s) {
    $c = strtolower((string)($s['Codec'] ?? ''));
    $prof = (string)($s['Profile'] ?? '');
    switch ($c) {
        case 'ac3': return 'DD';
        case 'eac3': return 'DD+';
        case 'truehd': return 'TrueHD';
        case 'dts':
            if (stripos($prof, 'MA') !== false) { return 'DTS-HD MA'; }
            if (stripos($prof, 'HRA') !== false) { return 'DTS-HD HRA'; }
            if (stripos($prof, 'DTS:X') !== false || stripos($prof, 'X') === 0) { return 'DTS:X'; }
            return 'DTS';
        case 'aac': return 'AAC';
        case 'flac': return 'FLAC';
        case 'opus': return 'Opus';
        case 'mp3': return 'MP3';
        case '': return '';
    }
    return strpos($c, 'pcm') === 0 ? 'PCM' : strtoupper($c);
}

function nf_ch($n) {
    $m = [1 => '1.0', 2 => '2.0', 3 => '2.1', 4 => '4.0', 5 => '5.0', 6 => '5.1', 7 => '6.1', 8 => '7.1'];
    return $m[(int)$n] ?? '';
}

// "angol · DD+ 5.1 Atmos" lines plus "felirat: magyar (kényszerített), angol"
function nf_audio_sub($item) {
    $aud = [];
    $subs = [];
    foreach ((array)($item['MediaStreams'] ?? []) as $s) {
        $t = $s['Type'] ?? '';
        if ($t === 'Audio') {
            $atmos = stripos((string)($s['DisplayTitle'] ?? '') . ' ' . (string)($s['Profile'] ?? ''), 'atmos') !== false;
            $lang = nf_lang($s['Language'] ?? '');
            $tech = trim(nf_acodec($s) . ' ' . nf_ch($s['Channels'] ?? 0) . ($atmos ? ' Atmos' : ''));
            $line = $lang . ($tech !== '' ? ' · ' . $tech : '');
            if (!in_array($line, $aud, true)) { $aud[] = $line; }
        } elseif ($t === 'Subtitle') {
            // forced (foreign-parts-only) subtitles are not announced
            $hay = (string)($s['Title'] ?? '') . ' ' . (string)($s['DisplayTitle'] ?? '');
            if (!empty($s['IsForced']) || stripos($hay, 'forced') !== false || stripos($hay, 'kényszer') !== false) { continue; }
            $subs[nf_lang($s['Language'] ?? '')] = true;
        }
    }
    $lines = array_slice($aud, 0, 3);
    if ($subs) {
        $labels = array_keys($subs);
        // the message's language first, the rest in file order
        $hu = nf_lang(mt_lang_discord() === 'en' ? 'eng' : 'hun');   // the message's own language first
        usort($labels, function ($a, $b) use ($hu) { return (($a === $hu) ? 0 : 1) <=> (($b === $hu) ? 0 : 1); });
        $lines[] = nf_t('felirat: ', 'subtitles: ') . implode(', ', array_slice($labels, 0, 6));
    }
    return $lines ? implode("\n", $lines) : '';
}

// "2160p · HEVC · Dolby Vision · 12,4 GB"
function nf_quality($item, $size = null) {
    $v = null;
    foreach ((array)($item['MediaStreams'] ?? []) as $s) { if (($s['Type'] ?? '') === 'Video') { $v = $s; break; } }
    $parts = [];
    if ($v) {
        $w = (int)($v['Width'] ?? 0);
        $h = (int)($v['Height'] ?? 0);
        if ($w >= 3200 || $h >= 2000) { $parts[] = '2160p'; }
        elseif ($w >= 1800 || $h >= 1000) { $parts[] = '1080p'; }
        elseif ($w >= 1200 || $h >= 700) { $parts[] = '720p'; }
        elseif ($h > 0) { $parts[] = 'SD'; }
        $codec = strtolower((string)($v['Codec'] ?? ''));
        $cm = ['hevc' => 'HEVC', 'h264' => 'H.264', 'av1' => 'AV1', 'vp9' => 'VP9', 'mpeg2video' => 'MPEG-2'];
        if ($codec !== '') { $parts[] = $cm[$codec] ?? strtoupper($codec); }
        $r = (string)($v['VideoRangeType'] ?? '');
        if (stripos($r, 'DOVI') === 0) { $parts[] = 'Dolby Vision' . (stripos($r, 'HDR10') !== false ? ' / HDR10' : ''); }
        elseif ($r === 'HDR10Plus') { $parts[] = 'HDR10+'; }
        elseif ($r === 'HDR10') { $parts[] = 'HDR10'; }
        elseif ($r === 'HLG') { $parts[] = 'HLG'; }
    }
    if ($size === null) { $size = (float)($item['MediaSources'][0]['Size'] ?? 0); }
    $sz = nf_size($size);
    if ($sz !== '') { $parts[] = $sz; }
    return implode(' · ', $parts);
}

function nf_field($name, $value, $inline) {
    $value = trim((string)$value);
    if ($value === '') { return null; }
    return ['name' => $name, 'value' => mb_substr($value, 0, 1000), 'inline' => (bool)$inline];
}

// ---- cards ------------------------------------------------------------------------------------
function nf_build($cfg, $o) {
    $desc = '';
    if ($o['orig'] !== '') { $desc .= '*' . nf_md($o['orig']) . "*\n"; }
    if ($o['overview'] !== '') { $desc .= nf_md(nf_trunc($o['overview'], 280)) . "\n"; }
    if ($o['url'] !== '') { $desc .= "\n[" . nf_t('Megnyitás a Jellyfinben', 'Open in Jellyfin') . "](" . $o['url'] . ')'; }
    $info = nf_info($cfg);
    $host = strtoupper((string)(gethostname() ?: 'SERVER'));
    $emb = [
        'author'      => ['name' => $o['author']],
        'title'       => mb_substr($o['title'], 0, 256),
        'description' => trim($desc),
        'color'       => 6967248,
        'fields'      => array_values(array_filter($o['fields'])),
        'footer'      => ['text' => $host . ($info['Version'] !== '' ? ' · Jellyfin ' . $info['Version'] : '')],
    ];
    if ($o['ts'] > 0) { $emb['timestamp'] = gmdate('c', $o['ts']); }
    if ($o['url'] !== '') { $emb['url'] = $o['url']; }
    return ['payload' => ['username' => 'Streambox', 'embeds' => [$emb]], 'poster' => $o['poster'], 'backdrop' => $o['backdrop']];
}

function nf_card_movie($cfg, $m, $preview = false) {
    $name = (string)($m['Name'] ?? '?');
    $orig = (string)($m['OriginalTitle'] ?? '');
    if ($orig !== '' && mb_strtolower($orig) === mb_strtolower($name)) { $orig = ''; }
    $id = (string)$m['Id'];
    return nf_build($cfg, [
        'author'   => ($preview ? nf_t('ELŐNÉZET · ', 'PREVIEW · ') : '') . nf_t('Új film', 'New movie'),
        'title'    => $name . (!empty($m['ProductionYear']) ? ' (' . (int)$m['ProductionYear'] . ')' : ''),
        'orig'     => $orig,
        'overview' => (string)($m['Overview'] ?? ''),
        'url'      => nf_link($cfg, $id),
        'ts'       => nf_ts($m['DateCreated'] ?? ''),
        'fields'   => [
            nf_field(nf_t('Hossz', 'Length'), nf_runtime($m['RunTimeTicks'] ?? 0), true),
            nf_field(nf_t('Minőség', 'Quality'), nf_quality($m), true),
            nf_field(nf_t('Műfaj', 'Genre'), nf_genres($m['Genres'] ?? []), true),
            nf_field(nf_t('Hang · felirat', 'Audio · subtitles'), nf_audio_sub($m), false),
            nf_field(nf_t('Szereplők', 'Cast'), nf_cast($m), false),
        ],
        'poster'   => nf_image($cfg, $id, 'Primary', 400),
        'backdrop' => !empty($m['BackdropImageTags']) ? nf_image($cfg, $id, 'Backdrop', 1280) : null,
    ]);
}

// "S01E01 – S01E08", or a list when the episodes are not consecutive
function nf_ep_range($eps) {
    $codes = [];
    $nums = [];
    foreach ($eps as $e) {
        $s = (int)($e['ParentIndexNumber'] ?? 0);
        $n = (int)($e['IndexNumber'] ?? 0);
        $codes[] = [$s, $n];
        $nums[] = $n;
    }
    usort($codes, function ($a, $b) { return [$a[0], $a[1]] <=> [$b[0], $b[1]]; });
    $fmt = function ($c) { return sprintf('S%02dE%02d', $c[0], $c[1]); };
    if (count($codes) === 1) { return $fmt($codes[0]); }
    $contig = true;
    for ($i = 1; $i < count($codes); $i++) {
        if ($codes[$i][0] !== $codes[$i - 1][0] || $codes[$i][1] !== $codes[$i - 1][1] + 1) { $contig = false; break; }
    }
    if ($contig) { return $fmt($codes[0]) . ' – ' . $fmt($codes[count($codes) - 1]); }
    $list = array_map($fmt, array_slice($codes, 0, 8));
    return implode(', ', $list) . (count($codes) > 8 ? ', …' : '');
}

// $eps: the new episodes of one season (full items, with streams)
function nf_card_season($cfg, $series, $season, $eps, $preview = false) {
    usort($eps, function ($a, $b) {
        return [(int)($a['ParentIndexNumber'] ?? 0), (int)($a['IndexNumber'] ?? 0)] <=> [(int)($b['ParentIndexNumber'] ?? 0), (int)($b['IndexNumber'] ?? 0)];
    });
    $first = $eps[0];
    $sn = (int)($first['ParentIndexNumber'] ?? 0);
    $name = (string)($series['Name'] ?? ($first['SeriesName'] ?? '?'));
    $orig = (string)($series['OriginalTitle'] ?? '');
    if ($orig !== '' && mb_strtolower($orig) === mb_strtolower($name)) { $orig = ''; }
    $sid = (string)($series['Id'] ?? ($first['SeriesId'] ?? ''));
    $seasonId = (string)($season['Id'] ?? '');

    $hasFirst = false;
    $total = 0.0;
    $ts = 0;
    foreach ($eps as $e) {
        if ((int)($e['IndexNumber'] ?? 0) === 1) { $hasFirst = true; }
        $total += (float)($e['MediaSources'][0]['Size'] ?? 0);
        $ts = max($ts, nf_ts($e['DateCreated'] ?? ''));
    }
    $count = count($eps);
    $label = $hasFirst ? nf_t('Új évad', 'New season') : nf_t('Új epizódok', 'New episodes');
    $seasonTxt = $sn === 0 ? nf_t('Különlegességek', 'Specials') : nf_t($sn . '. évad', 'Season ' . $sn);

    $overview = trim((string)($season['Overview'] ?? ''));
    if ($overview === '') { $overview = (string)($series['Overview'] ?? ''); }

    $posterId = ($season && !empty($season['ImageTags']['Primary'])) ? $seasonId : $sid;
    $rt = nf_runtime($first['RunTimeTicks'] ?? 0);
    $epTxt = $count . nf_t(' új epizód: ', $count === 1 ? ' new episode: ' : ' new episodes: ') . nf_ep_range($eps);
    $sz = nf_size($total);

    return nf_build($cfg, [
        'author'   => ($preview ? nf_t('ELŐNÉZET · ', 'PREVIEW · ') : '') . $label,
        'title'    => $name . (!empty($series['ProductionYear']) ? ' (' . (int)$series['ProductionYear'] . ')' : '') . ' · ' . $seasonTxt,
        'orig'     => $orig,
        'overview' => $overview,
        'url'      => nf_link($cfg, $seasonId !== '' ? $seasonId : $sid),
        'ts'       => $ts,
        'fields'   => [
            nf_field(nf_t('Epizódok', 'Episodes'), $epTxt, false),
            nf_field(nf_t('Hossz', 'Length'), $rt !== '' ? nf_t('epizódonként kb. ', 'about ') . $rt . nf_t('', ' per episode') : '', true),
            nf_field(nf_t('Minőség', 'Quality'), nf_quality($first, 0) . ($sz !== '' ? nf_t(' · összesen ', ' · in all ') . $sz : ''), true),
            nf_field(nf_t('Műfaj', 'Genre'), nf_genres($series['Genres'] ?? []), true),
            nf_field(nf_t('Hang · felirat', 'Audio · subtitles'), nf_audio_sub($first), false),
            nf_field(nf_t('Szereplők', 'Cast'), nf_cast($series), false),
        ],
        'poster'   => $posterId !== '' ? nf_image($cfg, $posterId, 'Primary', 400) : null,
        'backdrop' => ($sid !== '' && !empty($series['BackdropImageTags'])) ? nf_image($cfg, $sid, 'Backdrop', 1280) : null,
    ]);
}

// ---- weekly summary ---------------------------------------------------------------------------
// Use the server's time zone (Settings, Date and Time) for "Friday 18:00".
function nf_tz() {
    $v = @parse_ini_file('/var/local/emhttp/var.ini');
    $tz = is_array($v) ? (string)($v['timeZone'] ?? '') : '';
    if ($tz !== '' && in_array($tz, timezone_identifiers_list(), true)) { date_default_timezone_set($tz); }
}

function nf_hu_date($ts) {
    if (mt_lang_discord() === 'en') { return date('M j', $ts); }
    static $m = ['jan.', 'febr.', 'márc.', 'ápr.', 'máj.', 'jún.', 'júl.', 'aug.', 'szept.', 'okt.', 'nov.', 'dec.'];
    return $m[(int)date('n', $ts) - 1] . ' ' . (int)date('j', $ts) . '.';
}

// "2160p DV", "1080p", "2160p HDR"
function nf_res_short($item) {
    $parts = explode(' · ', nf_quality($item, 0));
    $out = [];
    if ($parts[0] !== '') { $out[] = $parts[0]; }
    foreach ($parts as $p) {
        if (strpos($p, 'Dolby Vision') === 0) { $out[] = 'DV'; break; }
        if (strpos($p, 'HDR') === 0 || $p === 'HLG') { $out[] = 'HDR'; break; }
    }
    return implode(' ', $out);
}

function nf_stars($item) {
    $r = (float)($item['CommunityRating'] ?? 0);
    return $r > 0 ? '★ ' . number_format($r, 1, nf_dec(), '') : '';
}

function nf_title_link($cfg, $name, $id) {
    $n = nf_md(str_replace(['[', ']'], ['(', ')'], (string)$name));
    $url = nf_link($cfg, $id);
    return $url !== '' ? '**[' . $n . '](' . $url . ')**' : '**' . $n . '**';
}

function nf_join_lines($lines, $budget) {
    $out = '';
    $n = 0;
    foreach ($lines as $l) {
        if (mb_strlen($out) + mb_strlen($l) + 40 > $budget) { return rtrim($out) . "\n…" . nf_t('és még ' . (count($lines) - $n) . ' további', 'and ' . (count($lines) - $n) . ' more'); }
        $out .= $l . "\n";
        $n++;
    }
    return rtrim($out);
}

// Message payload for everything added since $from; null = nothing new, false = Jellyfin could not be read
function nf_weekly($cfg, $from, $now, $preview = false) {
    $md = nf_json($cfg, '/Items?IncludeItemTypes=Movie&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=100&Fields=' . NF_FIELDS);
    $ed = nf_json($cfg, '/Items?IncludeItemTypes=Episode&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=600&Fields=DateCreated');
    if ($md === null && $ed === null) { return false; }

    $mlines = [];
    foreach ((array)($md['Items'] ?? []) as $m) {
        if (nf_ts($m['DateCreated'] ?? '') < $from) { continue; }
        $line = nf_title_link($cfg, $m['Name'] ?? '?', (string)($m['Id'] ?? ''));
        if (!empty($m['ProductionYear'])) { $line .= ' (' . (int)$m['ProductionYear'] . ')'; }
        $bits = array_filter([nf_runtime($m['RunTimeTicks'] ?? 0), nf_res_short($m), nf_genres($m['Genres'] ?? [], 3), nf_stars($m)]);
        $mlines[] = $line . ($bits ? ' · ' . implode(' · ', $bits) : '');
    }

    $groups = [];
    foreach ((array)($ed['Items'] ?? []) as $e) {
        $ts = nf_ts($e['DateCreated'] ?? '');
        if ($ts < $from || empty($e['SeriesId'])) { continue; }
        $k = (string)$e['SeriesId'] . '|' . (int)($e['ParentIndexNumber'] ?? 0);
        if (!isset($groups[$k])) { $groups[$k] = ['eps' => [], 'ts' => 0, 'sid' => (string)$e['SeriesId'], 'name' => (string)($e['SeriesName'] ?? '?')]; }
        $groups[$k]['eps'][] = $e;
        $groups[$k]['ts'] = max($groups[$k]['ts'], $ts);
    }
    uasort($groups, function ($a, $b) { return $b['ts'] <=> $a['ts']; });
    $slines = [];
    $cache = [];
    foreach (array_slice($groups, 0, 25) as $g) {
        if (!array_key_exists($g['sid'], $cache)) { $cache[$g['sid']] = nf_item($cfg, $g['sid']); }
        $ser = $cache[$g['sid']] ?: [];
        $sn = (int)($g['eps'][0]['ParentIndexNumber'] ?? 0);
        $line = nf_title_link($cfg, $ser['Name'] ?? $g['name'], $g['sid']);
        if (!empty($ser['ProductionYear'])) { $line .= ' (' . (int)$ser['ProductionYear'] . ')'; }
        $line .= ' · ' . ($sn === 0 ? nf_t('különlegességek', 'specials') : nf_t($sn . '. évad', 'season ' . $sn)) . ' · ' . count($g['eps']) . nf_t(' új epizód (', count($g['eps']) === 1 ? ' new episode (' : ' new episodes (') . nf_ep_range($g['eps']) . ')';
        $bits = array_filter([nf_genres($ser['Genres'] ?? [], 3), nf_stars($ser)]);
        $slines[] = $line . ($bits ? ' · ' . implode(' · ', $bits) : '');
    }

    $embeds = [];
    if ($mlines) { $embeds[] = ['title' => '🎬 ' . nf_t('Új filmek', 'New movies') . ' (' . count($mlines) . ')', 'description' => nf_join_lines($mlines, 2800), 'color' => 6967248]; }
    if ($slines) { $embeds[] = ['title' => '📺 ' . nf_t('Új sorozatok és évadok', 'New series and seasons') . ' (' . count($slines) . ')', 'description' => nf_join_lines($slines, 2800), 'color' => 6967248]; }
    if (!$embeds) { return null; }
    $info = nf_info($cfg);
    $host = strtoupper((string)(gethostname() ?: 'SERVER'));
    $embeds[count($embeds) - 1]['footer'] = ['text' => $host . ' · ' . nf_hu_date($from) . ' – ' . nf_hu_date($now)];
    return [
        'username' => 'Streambox',
        'content'  => ($preview ? nf_t('**ELŐNÉZET** · ', '**PREVIEW** · ') : '') . nf_t('🍿 **Hétvégi műsor** – ezek érkeztek a héten, jó szórakozást!', '🍿 **Weekend lineup** – this came in this week, enjoy!'),
        'embeds'   => $embeds,
    ];
}

// ---- Discord ----------------------------------------------------------------------------------
// Returns ['ok'|'retry'|'fail', message]
function nf_send($hook, $payload, $poster = null, $backdrop = null, $attempt = 0) {
    $payload['allowed_mentions'] = ['parse' => []];
    $tmp = [];
    $files = [];
    if ($poster !== null && isset($payload['embeds'][0])) {
        $payload['embeds'][0]['thumbnail'] = ['url' => 'attachment://poster.jpg'];
        $files['poster.jpg'] = $poster;
    }
    if ($backdrop !== null && isset($payload['embeds'][0])) {
        $payload['embeds'][0]['image'] = ['url' => 'attachment://backdrop.jpg'];
        $files['backdrop.jpg'] = $backdrop;
    }
    $json = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
    $ch = curl_init($hook);
    $opt = [CURLOPT_POST => true, CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 40];
    if ($files) {
        $fields = ['payload_json' => $json];
        $i = 0;
        foreach ($files as $fname => $data) {
            $p = tempnam('/tmp', 'sbn');
            file_put_contents($p, $data);
            $tmp[] = $p;
            $fields['files[' . $i . ']'] = new CURLFile($p, 'image/jpeg', $fname);
            $i++;
        }
        $opt[CURLOPT_POSTFIELDS] = $fields;
    } else {
        $opt[CURLOPT_POSTFIELDS] = $json;
        $opt[CURLOPT_HTTPHEADER] = ['Content-Type: application/json'];
    }
    curl_setopt_array($ch, $opt);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err = curl_errno($ch);
    curl_close($ch);
    foreach ($tmp as $p) { @unlink($p); }

    if ($err) { return ['retry', 'network error ' . $err]; }
    if ($code === 200 || $code === 204) { return ['ok', '']; }
    if ($code === 429) {
        $d = json_decode((string)$body, true);
        $wait = is_array($d) && isset($d['retry_after']) ? (float)$d['retry_after'] : 2.0;
        if ($attempt < 1 && $wait <= 5.0) {
            usleep((int)(($wait + 0.3) * 1000000));
            return nf_send($hook, $payload, $poster, $backdrop, $attempt + 1);
        }
        return ['retry', 'rate limited'];
    }
    if ($code >= 500 || $code === 0) { return ['retry', 'Discord HTTP ' . $code]; }
    $d = json_decode((string)$body, true);
    return ['fail', 'Discord HTTP ' . $code . (is_array($d) && !empty($d['message']) ? ' (' . $d['message'] . ')' : '')];
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/notify.php">
<INLINE><![CDATA[<?php
// Started by cron every minute: post a Discord card for each new movie and each new season.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/notify_lib.php';

$cfg = nf_cfg();
if (!nf_on($cfg['notify']) || (string)$cfg['jf_key'] === '') { exit(0); }
$hookMovies = nf_hook($cfg['dc_movies']);
$hookSeries = nf_hook($cfg['dc_series']);
if ($hookMovies === '' && $hookSeries === '') { exit(0); }
if (!preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['jf_host'])) { exit(0); }

$lock = @fopen('/tmp/streambox_notify.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

$sf  = '/boot/config/plugins/streambox/notify_state.json';
$st  = is_file($sf) ? json_decode((string)@file_get_contents($sf), true) : null;
$now = time();

function nf_save_state($sf, $st) {
    $tmp = $sf . '.tmp';
    $data = json_encode($st);
    if (@file_put_contents($tmp, $data) === false || !@rename($tmp, $sf)) { @file_put_contents($sf, $data); @unlink($tmp); }
}

if (!is_array($st) || !isset($st['since'])) {
    // first run: only things added from now on are announced
    nf_save_state($sf, ['since' => $now, 'done' => []]);
    nf_log('notifier started, announcing items added from now on');
    exit(0);
}

$since  = (int)$st['since'];
$done   = array_flip(array_map('strval', (array)($st['done'] ?? [])));
$settle = max(1, (int)$cfg['notify_settle']) * 60;
$wait   = max(1, (int)$cfg['notify_wait']) * 60;
$posted = 0;
$changed = false;
$stop = false;
$MAX_CARDS = 6;
$BULK = 20;

// ---- movies -----------------------------------------------------------------------------------
if ($hookMovies !== '') {
    $d = nf_json($cfg, '/Items?IncludeItemTypes=Movie&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=60&Fields=' . NF_FIELDS);
    $pending = [];
    foreach ((array)($d['Items'] ?? []) as $m) {
        $id = (string)($m['Id'] ?? '');
        if ($id === '' || isset($done[$id])) { continue; }
        $ts = nf_ts($m['DateCreated'] ?? '');
        if ($ts <= $since) { continue; }
        $m['_ts'] = $ts;
        $pending[] = $m;
    }
    usort($pending, function ($a, $b) { return $a['_ts'] <=> $b['_ts']; });
    if (count($pending) > $BULK) {
        foreach (array_slice($pending, 0, count($pending) - $BULK) as $m) { $done[(string)$m['Id']] = 1; }
        nf_log('bulk import: skipped ' . (count($pending) - $BULK) . ' older movies');
        $pending = array_slice($pending, -$BULK);
        $changed = true;
    }
    foreach ($pending as $m) {
        if ($posted >= $MAX_CARDS || $stop) { break; }
        $id = (string)$m['Id'];
        if (!nf_ready($m) && ($now - $m['_ts']) < $wait) { continue; }   // metadata and poster not in yet
        $card = nf_card_movie($cfg, $m);
        list($res, $msg) = nf_send($hookMovies, $card['payload'], $card['poster'], $card['backdrop']);
        if ($res === 'retry') { nf_log('movie "' . ($m['Name'] ?? $id) . '": ' . $msg . ', will retry'); $stop = true; break; }
        $done[$id] = 1;
        $changed = true;
        $posted++;
        if ($res === 'fail') { nf_log('movie "' . ($m['Name'] ?? $id) . '" not sent: ' . $msg); }
        else { nf_log('movie card sent: ' . ($m['Name'] ?? $id)); }
    }
}

// ---- seasons ----------------------------------------------------------------------------------
if ($hookSeries !== '' && !$stop) {
    $d = nf_json($cfg, '/Items?IncludeItemTypes=Episode&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=300&Fields=' . NF_FIELDS);
    $groups = [];
    foreach ((array)($d['Items'] ?? []) as $e) {
        $id = (string)($e['Id'] ?? '');
        if ($id === '' || isset($done[$id])) { continue; }
        $ts = nf_ts($e['DateCreated'] ?? '');
        if ($ts <= $since) { continue; }
        $e['_ts'] = $ts;
        $key = (string)($e['SeasonId'] ?? '') !== '' ? (string)$e['SeasonId'] : ((string)($e['SeriesId'] ?? '') . '-' . (int)($e['ParentIndexNumber'] ?? 0));
        $groups[$key][] = $e;
    }
    foreach ($groups as $k => $eps) {
        $min = PHP_INT_MAX; $max = 0;
        foreach ($eps as $e) { $min = min($min, $e['_ts']); $max = max($max, $e['_ts']); }
        $groups[$k] = ['eps' => $eps, 'min' => $min, 'max' => $max];
    }
    uasort($groups, function ($a, $b) { return $a['min'] <=> $b['min']; });
    if (count($groups) > 15) {
        $skip = array_slice($groups, 0, count($groups) - 15, true);
        foreach ($skip as $g) { foreach ($g['eps'] as $e) { $done[(string)$e['Id']] = 1; } }
        nf_log('bulk import: skipped ' . count($skip) . ' older seasons');
        $groups = array_slice($groups, -15, null, true);
        $changed = true;
    }
    foreach ($groups as $g) {
        if ($posted >= $MAX_CARDS || $stop) { break; }
        if (($now - $g['max']) < $settle) { continue; }   // more episodes may still be arriving
        $eps = $g['eps'];
        $series = nf_item($cfg, (string)($eps[0]['SeriesId'] ?? ''));
        if (!nf_ready($series) && ($now - $g['min']) < $wait) { continue; }
        $season = nf_item($cfg, (string)($eps[0]['SeasonId'] ?? ''));
        $card = nf_card_season($cfg, $series ?: [], $season ?: [], $eps);
        list($res, $msg) = nf_send($hookSeries, $card['payload'], $card['poster'], $card['backdrop']);
        $label = (string)($eps[0]['SeriesName'] ?? '?') . ' S' . sprintf('%02d', (int)($eps[0]['ParentIndexNumber'] ?? 0));
        if ($res === 'retry') { nf_log('season "' . $label . '": ' . $msg . ', will retry'); $stop = true; break; }
        foreach ($eps as $e) { $done[(string)$e['Id']] = 1; }
        $changed = true;
        $posted++;
        if ($res === 'fail') { nf_log('season "' . $label . '" not sent: ' . $msg); }
        else { nf_log('season card sent: ' . $label . ' (' . count($eps) . ' episodes)'); }
    }
}

if ($changed) {
    nf_save_state($sf, ['since' => $since, 'done' => array_slice(array_keys($done), -400)]);
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/notify_test.php">
<INLINE><![CDATA[<?php
// Settings page buttons: "Send test message" and "Send preview" (newest movie and season, nothing is marked as sent).
header('Content-Type: application/json');
header('Cache-Control: no-store');
require_once __DIR__ . '/notify_lib.php';

function nt_out($ok, $msg) { echo json_encode(['ok' => $ok, 'message' => $msg], JSON_UNESCAPED_UNICODE); exit; }

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); nt_out(false, 'method'); }
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); nt_out(false, 'csrf token mismatch'); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); nt_out(false, 'csrf: token removed and request is not AJAX');
}

$cfg  = nf_cfg();
$hm   = nf_hook($cfg['dc_movies']);
$hs   = nf_hook($cfg['dc_series']);
$hw   = nf_hook($cfg['dc_weekly']);
$mode = (string)($_POST['mode'] ?? 'test');
if ($hm === '' && $hs === '' && $hw === '') { nt_out(false, 'No valid Discord webhook is saved yet. Enter the webhook(s), press Apply, then try again.'); }

$report = [];
if ($mode === 'test') {
    foreach (['movies' => $hm, 'series' => $hs, 'weekly' => $hw] as $label => $h) {
        if ($h === '') { continue; }
        list($r, $m) = nf_send($h, ['username' => 'Streambox', 'content' => nf_t('✅ Streambox: tesztüzenet (' . $label . ' csatorna)', '✅ Streambox: test message (' . $label . ' channel)')]);
        $report[] = $label . ': ' . ($r === 'ok' ? 'sent' : 'failed (' . $m . ')');
    }
    nt_out(true, implode('; ', $report));
}

if ((string)$cfg['jf_key'] === '' || !preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['jf_host'])) { nt_out(false, 'The Jellyfin host and API key must be saved first.'); }

if ($mode === 'weekly') {
    if ($hw === '') { nt_out(false, 'No valid weekly summary webhook is saved yet.'); }
    nf_tz();
    $p = nf_weekly($cfg, time() - 7 * 86400, time(), true);
    if ($p === false) { nt_out(false, 'Jellyfin could not be read.'); }
    if ($p === null) { nt_out(true, 'Nothing was added in the last 7 days, so there is nothing to send.'); }
    list($r, $msg) = nf_send($hw, $p);
    nt_out($r === 'ok', 'weekly summary: ' . ($r === 'ok' ? 'sent' : 'failed (' . $msg . ')'));
}

if ($hm !== '') {
    $d = nf_json($cfg, '/Items?IncludeItemTypes=Movie&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=1&Fields=' . NF_FIELDS);
    $m = $d['Items'][0] ?? null;
    if ($m) {
        $c = nf_card_movie($cfg, $m, true);
        list($r, $msg) = nf_send($hm, $c['payload'], $c['poster'], $c['backdrop']);
        $report[] = 'movie "' . ($m['Name'] ?? '?') . '": ' . ($r === 'ok' ? 'sent' : 'failed (' . $msg . ')');
    } else { $report[] = 'no movie found'; }
}
if ($hs !== '') {
    $d = nf_json($cfg, '/Items?IncludeItemTypes=Episode&Recursive=true&SortBy=DateCreated&SortOrder=Descending&Limit=1&Fields=' . NF_FIELDS);
    $e = $d['Items'][0] ?? null;
    if ($e && !empty($e['SeasonId'])) {
        $all = nf_json($cfg, '/Items?ParentId=' . rawurlencode((string)$e['SeasonId']) . '&IncludeItemTypes=Episode&Fields=' . NF_FIELDS);
        $eps = (array)($all['Items'] ?? []);
        if (!$eps) { $eps = [$e]; }
        $series = nf_item($cfg, (string)($e['SeriesId'] ?? ''));
        $season = nf_item($cfg, (string)$e['SeasonId']);
        $c = nf_card_season($cfg, $series ?: [], $season ?: [], $eps, true);
        list($r, $msg) = nf_send($hs, $c['payload'], $c['poster'], $c['backdrop']);
        $report[] = 'season "' . ($e['SeriesName'] ?? '?') . '": ' . ($r === 'ok' ? 'sent' : 'failed (' . $msg . ')');
    } else { $report[] = 'no episode found'; }
}
nt_out(true, implode('; ', $report));
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/Streambox/README.md">
<INLINE><![CDATA[**Streambox** puts Jellyfin on the Unraid dashboard as a native-looking tile: who is watching right now (direct play, direct stream or transcode, with progress and live TV guide data), GPU and CPU load with the current power draw, optional smart-socket wall power and monthly kWh, and the recently added titles. It can also announce new movies and seasons in Discord with Hungarian cards.

Settings: Settings, Utilities, Streambox (or the gear icon on the tile). A Jellyfin API key is required.
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/weekly.php">
<INLINE><![CDATA[<?php
// Started by cron every hour: on the chosen day, from the chosen hour, post the weekly summary once.
if (PHP_SAPI !== 'cli') { exit(1); } // cron only, not a web page
require_once __DIR__ . '/notify_lib.php';
nf_tz();

$cfg = nf_cfg();
if (!nf_on($cfg['weekly']) || (string)$cfg['jf_key'] === '') { exit(0); }
$hook = nf_hook($cfg['dc_weekly']);
if ($hook === '' || !preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['jf_host'])) { exit(0); }

$now = time();
if ((int)date('w', $now) !== (int)$cfg['weekly_day'] || (int)date('G', $now) < (int)$cfg['weekly_hour']) { exit(0); }

$sf = '/boot/config/plugins/streambox/weekly_state.json';
$st = is_file($sf) ? json_decode((string)@file_get_contents($sf), true) : [];
$today = date('Y-m-d', $now);
if (is_array($st) && ($st['last'] ?? '') === $today) { exit(0); }

$lock = @fopen('/tmp/streambox_weekly.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }

function nf_mark_week($sf, $today) {
    $tmp = $sf . '.tmp';
    $data = json_encode(['last' => $today]);
    if (@file_put_contents($tmp, $data) === false || !@rename($tmp, $sf)) { @file_put_contents($sf, $data); @unlink($tmp); }
}

$payload = nf_weekly($cfg, $now - 7 * 86400, $now);
if ($payload === false) { nf_log('weekly summary: Jellyfin not reachable, will retry'); exit(0); }
if ($payload === null) { nf_log('weekly summary: nothing new this week'); nf_mark_week($sf, $today); exit(0); }

list($res, $msg) = nf_send($hook, $payload);
if ($res === 'retry') { nf_log('weekly summary: ' . $msg . ', will retry'); exit(0); }
nf_mark_week($sf, $today);
nf_log($res === 'ok' ? 'weekly summary sent' : 'weekly summary not sent: ' . $msg);
]]></INLINE>
</FILE>

<!-- Permissions + done -->
<FILE Name="/tmp/&name;_finish.sh" Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
DIR="/usr/local/emhttp/plugins/streambox"
chmod 644 "$DIR"/*.page "$DIR"/*.php "$DIR"/*.js "$DIR"/icon.png

# Smart-socket sampler: Unraid collects /boot/config/plugins/<name>/*.cron with update_cron.
PHPBIN="$(command -v php || echo /usr/bin/php)"
cat > /boot/config/plugins/streambox/streambox.cron <<CRON
# Streambox: remember the smart socket energy counter every 10 minutes (monthly consumption)
*/10 * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/sample.php >/dev/null 2>&1
# Streambox: Discord notifier, checks Jellyfin for new movies and seasons every minute
* * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/notify.php >/dev/null 2>&1
# Streambox: weekly summary, checked hourly (day and hour are settings)
0 * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/weekly.php >/dev/null 2>&1
# Streambox: this week's episodes, a Discord message for a late episode (only when switched on)
*/10 * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/week_late.php >/dev/null 2>&1
# Streambox: this week's episodes for the row on Jellyfin's home page (week.json, week.js)
*/2 * * * * $PHPBIN /usr/local/emhttp/plugins/streambox/week_web.php >/dev/null 2>&1
CRON
# update_cron reads the plugin link in /var/log/plugins, which appears only after the install scripts
# have finished, so wait for it in the background.
nohup bash -c 'for i in $(seq 1 60); do [ -e /var/log/plugins/streambox.plg ] && break; sleep 1; done; /usr/local/sbin/update_cron' >/dev/null 2>&1 &


# Updates come from GitHub (pluginURL): stop the local update server of earlier versions
pkill -f "php -S 127.0.0.1:18182" 2>/dev/null
rm -f /usr/local/emhttp/plugins/streambox/repo.php
rm -f /tmp/streambox_setup.sh /tmp/streambox_finish.sh
echo ""
echo "----------------------------------------------------"
echo " Streambox installed."
echo " Settings: Settings -> Utilities -> Streambox"
echo " (or the gear icon on the dashboard tile)."
echo "----------------------------------------------------"
exit 0
]]></INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
rm -rf /usr/local/emhttp/plugins/streambox
rm -rf /usr/local/emhttp/plugins/Streambox
pkill -f "php -S 127.0.0.1:18182" 2>/dev/null
rm -f /tmp/streambox_*
rm -f /boot/config/plugins/streambox/streambox.cron
/usr/local/sbin/update_cron 2>/dev/null
# Settings and nicknames in /boot/config/plugins/streambox are kept intentionally.
echo "streambox removed."
exit 0
]]></INLINE>
</FILE>

</PLUGIN>
