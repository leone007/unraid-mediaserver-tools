<label><input type="radio" name="wk_src" value="own" <?=(string)$sb['wk_src'] === 'own' ? 'checked' : ''?>> <?=$sbs_t('set.wk_src.own')?></label>
<input type="button" id="sb-wtest" value="<?=$sbs_t('set.btn.test_sonarr')?>"> <span id="sb-wmsg"></span>
<span class="uset-hint"><?=$sbs_t('set.wk_src_hint')?></span></dd>

<dt><?=$sbs_t('set.son_url')?></dt>
<dd><input type="text" name="son_url" placeholder="http://192.168.1.10:8989" value="<?=sb_h($sb['son_url'])?>"></dd>

<dt><?=$sbs_t('set.son_key')?></dt>
<dd><input type="password" name="son_key" class="narrow" autocomplete="new-password" value="" placeholder="<?=$sb['son_key'] !== '' ? $sbs_T('set.saved_keep') : ''?>"></dd>

<dt><?=$sbs_t('set.wk_delay')?></dt>
<dd><select name="wk_delay">
<?php foreach (['series' => $sbs_T('set.wk_delay.series'), 'idx' => $sbs_T('set.wk_delay.idx'), 'all' => $sbs_T('set.wk_delay.all')] as $sb_k => $sb_l): ?>
  <option value="<?=$sb_k?>" <?=((string)$sb['wk_delay'] === $sb_k) ? 'selected' : ''?>><?=sb_h($sb_l)?></option>
<?php endforeach; ?>
</select>
<span class="uset-hint"><?=$sbs_t('set.wk_delay_hint')?></span></dd>

<dt><?=$sbs_t('set.wk_late')?></dt>
<dd><input type="number" name="wk_late" min="1" max="48" class="narrow" value="<?=sb_h($sb['wk_late'])?>"></dd>

<dt><?=$sbs_t('set.wk_dc')?></dt>
<dd><input type="hidden" name="wk_dc" value="0"><input type="checkbox" name="wk_dc" value="1" <?=sb_chk($sb['wk_dc'])?>> <?=$sbs_t('set.wk_dc_hint')?></dd>

