 },
 "set.wk_show_hint": {
  "text": "The monitored episodes airing this week, by day: air time, when the torrent usually shows up, and where each one is now. A new week starts at midnight on Sunday.",
  "note": "hint under the Show on the Dashboard setting."
 },
 "set.wk_src.seedbox": {
  "text": "use Seedbox's Sonarr settings",
  "note": "radio button: take the Sonarr address and key from Seedbox."
 },
 "set.wk_src.own": {
  "text": "own",
  "note": "radio button: use the address and key entered below. Very short."
 },
 "set.btn.test_sonarr": {
  "text": "Test Sonarr",
  "note": "button: checks the Sonarr connection. Short."
 },
 "set.wk_src_hint": {
  "text": "Seedbox already has the Sonarr address and API key (Seedbox Tools, Connections). The fields below are used only with \"own\".",
  "note": "hint under the Sonarr connection setting; \"own\" is the radio button above."
 },
 "set.wk_delay.series": {
  "text": "per series",
  "note": "choice: the usual delay is counted per series."
 },
 "set.wk_delay.idx": {
  "text": "per series and indexer",
  "note": "choice: counted per series and per indexer (tracker)."
 },
 "set.wk_delay.all": {
  "text": "one value for all series",
  "note": "choice: one delay for every series."
 },
 "set.wk_delay_hint": {
  "text": "Median time from airing to the first grab, from the last 60 days of Sonarr history (grabs more than 3 days after airing are left out). Under 3 episodes of a series the median of all series is used. Per indexer: the earliest indexer decides, the others are listed under the title.",
  "note": "hint under the Usual delay setting (\"grab\" = Sonarr sent the episode to the download client)."
 },
 "set.wk_dc_hint": {
  "text": "once per episode, to the series webhook (below)",
  "note": "text next to the Post late episodes to Discord checkbox."
 },
 "set.wk_web_hint": {
  "text": "\"Ezen a héten\", web client and Jellyfin Desktop only",
  "note": "text next to the checkbox. \"Ezen a héten\" is the (Hungarian) title of the row on Jellyfin's home page: keep it as it is."
 },
 "set.wk_web_long": {
  "text": "Every 2 minutes Streambox writes week.json (series, episode codes, times; no keys) and week.js into the folder below. Map it read-only into the Jellyfin container as /usr/share/jellyfin/web/streambox, then add this script in Jellyfin (Dashboard, JS Injector, enabled): <code>var s=document.createElement('script');s.src='streambox/week.js?v='+Date.now();document.head.appendChild(s);</code> Anyone who can open the Jellyfin address can read week.json.",
  "note": "hint under the Jellyfin home page row setting. Keep the script in the code tags exactly as it is. May contain simple HTML tags: keep them."
 },
 "set.wk_view.grid": {
  "text": "calendar (seven day cards)",
  "note": "choice of the default view of the Jellyfin home page row."
 },
 "set.wk_view.row": {
  "text": "posters (one row)",
  "note": "choice of the default view."
 },
 "set.wk_view_hint": {
  "text": "Each viewer can switch with the two icons next to the title; the choice is remembered in that browser.",
  "note": "hint under the Default view setting."
 },
 "date.long.mon": {
  "text": "Monday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.tue": {
  "text": "Tuesday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.wed": {
  "text": "Wednesday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.thu": {
  "text": "Thursday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.fri": {
  "text": "Friday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.sat": {
  "text": "Saturday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "date.long.sun": {
  "text": "Sunday",
  "note": "full day name, a choice of the weekly summary day."
 },
 "set.btn.ntest": {
  "text": "Send test message",
  "note": "button: sends a short test message to every saved Discord webhook."
 },
 "set.btn.nprev": {
  "text": "Send preview (newest movie and season)",
  "note": "button: sends the cards of the newest movie and season, marked as a preview."
 },
 "set.btn.nweek": {
  "text": "Send weekly summary now",
  "note": "button: sends the weekly summary of the last 7 days now."
 },
 "set.nicks_none": {
  "text": "The user list could not be loaded. Enter the Jellyfin host, port and API key above, press Apply, then reload this page.",
  "note": "text in the User nicknames part when Jellyfin cannot be read."
 },
 "set.nicks_hint": {
  "text": "Nicknames are shown instead of the long user names on the dashboard tile. Leave a field empty to use the automatic short name (shown as a hint).",
  "note": "text above the nickname fields (one per Jellyfin user)."
 },
 "set.btn.apply": {
  "text": "Apply",
  "note": "button: saves the settings (Unraid's usual word). Short."
 },
 "set.btn.done": {
  "text": "Done",
  "note": "button: leaves the settings page (Unraid's usual word). Short."
 },
 "set.log": {
  "text": "Notifier log (latest entries):",
  "note": "small grey title above the last lines of the Discord notifier log."
 },
 "set.help_discord": {
  "text": "Discord cards: Unraid checks Jellyfin every minute. A movie is announced once its description (in Jellyfin's metadata language) and poster exist; episodes are grouped per season and announced when no new episode has arrived for the \"wait for more episodes\" time. The first time the notifier is switched on, only items added from then on are announced. The weekly summary lists everything added in the last 7 days at the chosen day and hour (server time zone); if the server was off at that hour it is sent when it is next up the same day. The buttons use the saved settings, so press Apply first. The Jellyfin link in the cards is left out when the Jellyfin link URL is empty. Create a webhook in Discord under channel settings, Integrations, Webhooks.",
  "note": "grey paragraph at the bottom of the page about the Discord cards. \"wait for more episodes\" names the setting above."
 },
 "set.help_general": {
  "text": "The Jellyfin API key is created in Jellyfin under Dashboard, Advanced, API Keys. Streams that are idle (nothing playing) are not shown. GPU load is read with intel_gpu_top, CPU load from the system statistics. Leave the Jellyfin link URL empty to use this server's address with the Jellyfin port. Leave the smart socket address empty to hide the Socket reading. The monthly consumption is taken from the socket's own energy counter, which Unraid samples every 10 minutes, so the first month counts from the day the socket is set up.",
  "note": "grey paragraph at the bottom of the page. Menu names of Jellyfin (Dashboard, Advanced, API Keys) should match Jellyfin's own words in your language."
 },
 "set.saving": {
  "text": "Saving...",
  "note": "message next to Apply while saving."
 },
 "set.saved": {
  "text": "Saved. The dashboard picks it up within a few seconds.",
  "note": "message next to Apply after saving."
 },
 "set.not_saved": {
  "text": "Not saved: {e}",
  "note": "message next to Apply when saving failed; {e} is the reason."
 },
 "set.unknown_error": {
  "text": "unknown error",
  "note": "reason when none is known."
 },
 "set.asking_sonarr": {
  "text": "Asking Sonarr... (Apply first if you changed the connection)",
  "note": "message next to Test Sonarr while it runs."
 },
 "set.unknown_answer": {
  "text": "unknown answer",
  "note": "message when a test gets an answer it cannot read."
 },
 "set.sending": {
  "text": "Sending...",
  "note": "message next to the Discord test buttons while sending."
 },
 "date.day_short": {
  "text": "{dow} {d}",
  "note": "the first day of the week on the This week's episodes band when both days are in the same month, for example the \"Mon 12\" of \"Mon 12 – Sun 18 Oct\". Same order as date.day, without the month."
 },
 "set.jx_on": {
  "text": "IMDb and Watched in Jellyfin:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "set.jx_on_hint": {
  "text": "IMDb rating on every movie, series and episode, a Watched menu and a \"Watched too\" switch on the home page",
  "note": "text next to the checkbox (web client and Jellyfin Desktop). \"Watched too\" is the name of the switch: use the same words as jx.watched_too."
 },
 "set.jx_on_long": {
  "text": "Uses the folder and the JS Injector script of the row above (week.js loads extras.js), so the row setting may be off. Once a day Streambox downloads IMDb's public ratings file (title.ratings.tsv.gz, about 9 MB, for personal and non-commercial use) and keeps only the titles of this Jellyfin library in imdb.json. Anyone who can open the Jellyfin address can read imdb.json (Jellyfin item ids, IMDb ids and ratings).",
  "note": "hint under the IMDb and Watched setting. May contain simple HTML tags: keep them."
 },
 "jx.watched_too": {
  "text": "Watched too",
  "note": "switch on Jellyfin's home page, in the header of the first poster row. On (default): rows also show what the user has already watched; off: those are hidden. Short."
 },
 "jx.watched_too_tip": {
  "text": "Off: the Recently added rows leave out what you have already watched. It is Jellyfin's own setting of your account (Settings, Home), so it works in the Jellyfin apps too; the page reloads.",
  "note": "tooltip of the Watched too switch."
 },
 "jx.menu": {
  "text": "Watched",
  "note": "menu entry in Jellyfin (next to Movies, Shows...) and the title of its page: the movies and series the user has watched. One short word."
 },
 "jx.tab.movies": {
  "text": "Movies · {n}",
  "note": "tab on the Watched page; {n} = number of watched movies."
 },
 "jx.tab.series": {
  "text": "Shows · {n}",
  "note": "tab on the Watched page; {n} = number of series with at least one watched episode."
 },
 "jx.sort": {
  "text": "Sort:",
  "note": "label before the sort list on the Watched page."
 },
 "jx.sort.date": {
  "text": "Last watched",
  "note": "sort option on the Watched page (newest first)."
 },
 "jx.sort.name": {
  "text": "Title",
  "note": "sort option on the Watched page (A to Z)."
 },
 "jx.sort.imdb": {
  "text": "IMDb rating",
  "note": "sort option on the Watched page (best first)."
 },
 "jx.when": {
  "text": "watched {date}",
  "note": "green line under a poster on the Watched page; {date} = day and month in the browser's format, e.g. 'Oct 18'."
 },
 "jx.done": {
  "text": "Finished",
  "note": "tooltip of the check mark on a series poster on the Watched page: every episode watched."
 },
 "jx.empty_movies": {
  "text": "No watched movies yet.",
  "note": "Watched page, Movies tab, when the list is empty."
 },
 "jx.empty_series": {
  "text": "No watched shows yet.",
  "note": "Watched page, Shows tab, when the list is empty."
 },
 "jx.loading": {
  "text": "Loading…",
  "note": "Watched page while the list comes from Jellyfin."
 },
 "jx.error": {
  "text": "Jellyfin did not send the list. Close this page and open it again.",
  "note": "Watched page when the request to Jellyfin failed."
 },
 "jx.close": {
  "text": "Close",
  "note": "tooltip of the × button on the Watched page."
 },
 "jx.imdb_open": {
  "text": "Open on IMDb (rate it there)",
  "note": "tooltip of the yellow IMDb badge (cards and detail page); the click opens the title's IMDb page in a new tab."
 },
 "jx.votes": {
  "one": "{v} vote",
  "other": "{v} votes",
  "note": "IMDb vote count, in the IMDb badge tooltip and next to the rating on the detail page; {v} = the number with thousands separators, {n} = the plain number for the plural form."
 },
 "jx.eps": {
  "one": "{n} episode",
  "other": "{n} episodes",
  "note": "under a series poster on the Watched page: how many of its episodes the user has watched."
 },
 "set.jx_badge": {
  "text": "IMDb badge on the cards:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "set.jx_badge.title": {
  "text": "next to the title",
  "note": "option of the IMDb badge setting: under the poster, after the title."
 },
 "set.jx_badge.poster": {
  "text": "on the poster (top left)",
  "note": "option of the IMDb badge setting: on the picture's top left corner."
 },
 "jx.season_avg": {
  "one": "Average IMDb rating of the {n} rated episode of this season",
  "other": "Average IMDb rating of the {n} rated episodes of this season",
  "note": "tooltip of the IMDb average badge on a season's poster (IMDb rates episodes, not seasons); {n} = episodes with an IMDb rating."
 },
 "ww.title": {
  "text": "This week",
  "note": "Jellyfin home page, This week row: the row title."
 },
 "ww.view_cal": {
  "text": "Calendar view",
  "note": "Jellyfin home page, This week row: tooltip of the view switch (seven day cards)."
 },
 "ww.view_poster": {
  "text": "Poster view",
  "note": "Jellyfin home page, This week row: tooltip of the view switch (one poster row)."
 },
 "ww.n_eps": {
  "one": "{n} episode",
  "other": "{n} episodes",
  "note": "Jellyfin home page, This week row: number of episodes (season card, header)."
 },
 "ww.n_ok": {
  "text": "{n} available",
  "note": "Jellyfin home page, This week row: header: episodes already in Jellyfin."
 },
 "ww.n_of_ok": {
  "text": "{n}/{m} available",
  "note": "Jellyfin home page, This week row: {n} of {m} episodes are in Jellyfin (day or season card)."
 },
 "ww.n_late": {
  "text": "{n} late",
  "note": "Jellyfin home page, This week row: header: episodes later than expected."
 },
 "ww.day_only": {
  "text": "{d}",
  "note": "Jellyfin home page, This week row: end of the week range when the month is the same (Oct 20–{d}); Hungarian adds a dot."
 },
 "ww.today": {
  "text": "Today · {d}",
  "note": "Jellyfin home page, This week row: day heading of today; {d} the day name."
 },
 "ww.none": {
  "text": "no episodes",
  "note": "Jellyfin home page, This week row: an empty day card."
 },
 "ww.new": {
  "text": "NEW",
  "note": "Jellyfin home page, This week row: badge of a season premiere or a new series (short, upper case)."
 },
 "ww.st_ok": {
  "text": "Available",
  "note": "Jellyfin home page, This week row: status: in Jellyfin."
 },
 "ww.st_soon": {
  "text": "Available soon",
  "note": "Jellyfin home page, This week row: status: downloaded, being imported."
 },
 "ww.st_dl": {
  "text": "Downloading",
  "note": "Jellyfin home page, This week row: status without a percentage."
 },
 "ww.st_dl_p": {
  "text": "Downloading {p}%",
  "note": "Jellyfin home page, This week row: status; {p} percent done."
 },
 "ww.st_grab": {
  "text": "Download starting",
  "note": "Jellyfin home page, This week row: status: grabbed, not downloading yet."
 },
 "ww.st_pause": {
  "text": "Paused",
  "note": "Jellyfin home page, This week row: status: the download is paused."
 },
 "ww.st_fail": {
  "text": "Download error",
  "note": "Jellyfin home page, This week row: status."
 },
 "ww.st_late": {
  "text": "Late {d}",
  "note": "Jellyfin home page, This week row: status; {d} how late (e.g. 2h 5m)."
 },
 "ww.st_in": {
  "text": "in {d}",
  "note": "Jellyfin home page, This week row: status: expected in {d} (the usual delay after airing included)."
 },
 "ww.st_air_in": {
  "text": "Airs in {d}",
  "note": "Jellyfin home page, This week row: status: the episode airs in {d}."
 },
 "ww.st_any": {
  "text": "Any time now",
  "note": "Jellyfin home page, This week row: status: aired, the usual delay has not passed yet."
 },
 "ww.tip_air": {
  "text": "Airs: {d} {t}",
  "note": "Jellyfin home page, This week row: tooltip line; {d} day name, {t} time."
 },
 "ww.tip_exp": {
  "text": "Expected: ~{t}",
  "note": "Jellyfin home page, This week row: tooltip line; {t} the expected time."
 },
 "ww.dur_dh": {
  "text": "{d}d {h}h",
  "note": "Jellyfin home page, This week row: a duration in days and hours (short)."
 },
 "ww.dur_hm": {
  "text": "{h}h {m}m",
  "note": "Jellyfin home page, This week row: a duration in hours and minutes (short)."
 },
 "ww.dur_m": {
  "text": "{m}m",
  "note": "Jellyfin home page, This week row: a duration in minutes (short)."
 },
 "ww.program": {
  "text": "Program: {t}",
  "note": "Dashboard tile, Live TV stream tooltip: the programme time."
 },
 "now.srv_down": {
  "text": "{s}: not reachable",
  "note": "row at the end of the Now playing list when one media server ({s} = Jellyfin, Emby or Plex) does not answer; the other servers' streams are still shown."
 },
 "now.srv_auth": {
  "text": "{s}: API key rejected, check Settings",
  "note": "row at the end of the Now playing list when a media server ({s}) refuses the saved API key."
 },
 "now.srv_err": {
  "text": "{s}: error ({e})",
  "note": "row at the end of the Now playing list; {e} is a short technical code such as http_500."
 },
 "set.h.emby": {
  "text": "Emby",
  "note": "band title of the Emby settings block (product name)."
 },
 "set.h.emby_sub": {
  "text": "Now playing from a second media server",
  "note": "small grey text on the right of the Emby band."
 },
 "set.em_on": {
  "text": "Show Emby streams:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "set.em_on_hint": {
  "text": "the tile lists Emby's streams next to Jellyfin's, with a server badge on each row",
  "note": "hint next to the checkbox."
 },
 "set.em_host": {
  "text": "Emby host and port:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "set.em_host_hint": {
  "text": "as seen from Unraid; the Emby container usually maps its 8096 to 8097 on the host, because Jellyfin uses 8096",
  "note": "hint line under the host and port fields."
 },
 "set.em_key": {
  "text": "Emby API key:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "set.em_key_hint": {
  "text": "Emby: Settings, Advanced, API Keys, New API Key. Apply before you press Test.",
  "note": "hint line under the API key field and the Test button."
 },
 "set.btn.test_emby": {
  "text": "Test Emby",
  "note": "button that asks Emby with the saved settings."
 },
 "set.asking_emby": {
  "text": "Asking Emby…",
  "note": "text next to the Test Emby button while waiting."
 },
 "set.em_test_ok": {
  "text": "Emby answers, its streams will show on the tile",
  "note": "result of the Emby test, success."
 },
 "set.em_test_auth": {
  "text": "Emby refuses this API key",
  "note": "result of the Emby test when the key is wrong."
 },
 "set.em_test_fail": {
  "text": "Emby does not answer ({e})",
  "note": "result of the Emby test; {e} is a short code such as unreachable or http_404."
 },
 "set.em_test_off": {
  "text": "Emby is off or has no saved API key: tick Show Emby streams, enter the key, Apply",
  "note": "result of the Emby test when Emby is not set up."
 },
 "save.err_em_key": {
  "text": "The Emby API key may only contain letters, digits, dots, dashes and underscores.",
  "note": "error text when saving the settings."
 }
}
]]></INLINE>
</FILE>

