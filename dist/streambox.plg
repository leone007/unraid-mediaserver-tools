<!-- ========================================================= -->
<!-- DASHBOARD TILE                                             -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/&name;.page">
<INLINE><![CDATA[Menu="Dashboard:0"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>')"
Markdown="false"
---
<?PHP
$pluginname = "streambox";
// texts from the dictionary (lang/en.json and its translations, see i18n.php)
require_once '/usr/local/emhttp/plugins/streambox/i18n.php';
$sbx_lang = '/usr/local/emhttp/plugins/streambox/lang';
$sbx_T = mt_i18n_t($sbx_lang);
$sbx_h = function ($k) use ($sbx_T) { return htmlspecialchars($sbx_T($k), ENT_QUOTES); };
$sbx_t = ['conn' => $sbx_h('tile.connecting'), 'load' => $sbx_h('tile.loading'), 'open' => $sbx_h('tile.open_jellyfin'), 'set' => $sbx_h('tile.settings')];

$mytiles[$pluginname]['column2'] =
<<<EOT
<tbody title="_(Streambox)_">
<tr><td>
  <span class="tile-header">
    <span class="tile-header-left">
      <i class="f32 sb-ic"></i>
      <div class="section">
        <h3 class="tile-header-main sb-ttl">Streambox</h3>
        <span id="sb-summary" class="sb-sum">{$sbx_t['conn']}</span>
      </div>
    </span>
    <span class="tile-header-right">
      <span class="tile-header-right-controls">
        <a id="sb-home" href="#" target="_blank" rel="noopener" title="{$sbx_t['open']}"><i class="fa fa-fw fa-home control"></i></a>
        <a href="/Settings/StreamboxSettings" title="{$sbx_t['set']}"><i class="fa fa-fw fa-cog control"></i></a>
      </span>
    </span>
  </span>
</td></tr>
<tr><td>
  <div class="sb-tile">
    <div id="sb-status"></div>
    <div id="sb-now"><div class="sb-note">{$sbx_t['load']}</div></div>
    <div id="sb-week"></div>
    <div id="sb-load"></div>
    <div id="sb-added"></div>
  </div>
</td></tr>
</tbody>
EOT;
echo mt_i18n_js($sbx_lang, 'sb', ['tile.', 'mode.', 'time.', 'pill.', 'sum.', 'now.', 'col.', 'type.', 'added.', 'load.', 'date.', 'week.']);
?>
<style>
i.f32.sb-ic{display:inline-block!important;width:30px!important;height:30px!important;font-size:0!important;background:url(/plugins/streambox/icon.png) center/contain no-repeat!important}
i.f32.sb-ic.sb-inv{filter:invert(1)}
.sb-ttl{margin-bottom:2px!important}
.sb-sum{display:block;margin:0!important;line-height:1.3}
.sb-tile{width:100%;font-size:12px;white-space:normal}
.sb-tile a{text-decoration:none}
#sb-status{display:flex;justify-content:flex-end;margin:0 0 4px}
.sb-pill{display:inline-flex;border:1px solid rgba(128,128,128,.35);border-radius:6px;overflow:hidden}
.sb-pill span{padding:3px 10px}
.sb-pill span+span{border-left:1px solid rgba(128,128,128,.35)}
.sb-num{text-align:right;white-space:nowrap;font-family:bitstream,monospace}
.sb-nm{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3;word-break:break-word}
.sb-el{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sb-u{opacity:.6}
.sb-sm{font-size:11px}
.sb-pl{display:flex;align-items:center;gap:8px;margin-top:5px;font-family:bitstream,monospace;white-space:nowrap}
.sb-pb{height:4px;border-radius:2px;background:rgba(128,128,128,.3);overflow:hidden;flex:1;min-width:30px}
.sb-pb i{display:block;height:100%}
.sb-bd{display:inline-block;font-size:11px;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:4px}
.sb-play{background:rgba(63,162,74,.22);color:#3fa24a}
.sb-stream{background:rgba(74,144,226,.22);color:#4a90e2}
.sb-trans{background:rgba(224,160,48,.22);color:#d9921f}
.sb-t-blue{background:rgba(74,144,226,.22);color:#4a90e2}
.sb-t-purple{background:rgba(150,120,230,.22);color:#9a7de6}
.sb-rs{margin-top:4px;font-size:11px;line-height:1.3;overflow-wrap:anywhere;opacity:.75;white-space:pre-line}
.sb-rs.sb-warn{color:#d9921f;opacity:1}
.sb-note{padding:8px 10px;text-align:center;font-style:italic;opacity:.6}
.sb-more{display:block;text-align:center;padding:10px 0 2px;color:#4a90e2}
/* Shared tile look (the Sysbox / Diskbox style): dark section bands, the content in a box under them, colored left stripes on rows.
   Used by Seedbox and Streambox; the build copies this block into each plugin's page where the marker below stands. */
.mt-band{display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(0,0,0,.25);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:7px 10px;margin-top:14px}
.mt-band.mt-first{margin-top:6px}
.mt-band span{opacity:.75}
.mt-band b{font-weight:400;opacity:.5;text-transform:none;letter-spacing:0;text-align:right}
.mt-band.mt-red span{color:#e5534b;opacity:1}
.mt-box{background:rgba(128,128,128,.12);margin-top:8px}
.mt-cols{display:grid;gap:8px;align-items:center;padding:6px 10px 4px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid rgba(128,128,128,.2)}
.mt-cols>div{opacity:.6}
.mt-r{display:grid;gap:8px;align-items:center;padding:8px 10px;border-top:1px solid rgba(128,128,128,.2)}
.mt-box>.mt-r:first-child,.mt-cols+.mt-r{border-top:0}
.mt-s-orange{background:rgba(245,165,36,.10);box-shadow:inset 3px 0 0 #f5a524}
.mt-s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
.mt-s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
.mt-s-red{background:rgba(229,83,75,.14);box-shadow:inset 3px 0 0 #e5534b}
.mt-s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
.mt-s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
.mt-s-grey{background:rgba(128,128,128,.08);box-shadow:inset 3px 0 0 #8a8a8a}
.mt-box .mt-n{background:none}
.mt-note{padding:8px 10px;text-align:center;font-style:italic;opacity:.6}
.sb-cards{display:grid;gap:8px}
.sb-card{background:rgba(128,128,128,.10);border:1px solid rgba(128,128,128,.25);border-radius:6px;padding:10px}
.sb-k{font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.65}
.sb-day{display:flex;justify-content:space-between;gap:8px;padding:6px 10px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.65;background:rgba(0,0,0,.15);border-top:1px solid rgba(128,128,128,.2)}
.sb-day:first-child{border-top:0}
.sb-day.sb-today{opacity:1}
.sb-day+.mt-r{border-top:0}
.sb-wsub{font-size:11px;opacity:.6;margin-top:2px;line-height:1.3;overflow-wrap:anywhere}
.sb-day+.mt-r .sb-bd,#sb-week .sb-bd{white-space:nowrap}
.sb-new{display:inline-block;vertical-align:1px;font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:1px 6px;border-radius:4px;background:#f5a524;color:#1c1b1b}
.sb-t-green{background:rgba(63,162,74,.22);color:#3fa24a}
.sb-t-amber{background:rgba(224,160,48,.22);color:#d9921f}
.sb-t-red{background:rgba(229,83,75,.22);color:#e5534b}
.sb-t-grey{background:rgba(128,128,128,.2);color:inherit;opacity:.8}
.sb-sv{display:inline-block;vertical-align:1px;font-size:10px;font-weight:600;letter-spacing:.06em;padding:0 5px;border-radius:3px;border:1px solid currentColor;line-height:1.5;margin-right:5px;white-space:nowrap}
.sb-sv-jf{color:#b57de0}.sb-sv-em{color:#5cc451}.sb-sv-px{color:#e5b40d}
.sb-pill i.sb-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:4px;vertical-align:1px}
.sb-v{font-family:bitstream,monospace;font-size:18px;margin:4px 0 6px}
</style>
<script>
$(function () {
  var T = function (k, v) { return MTL.t('sb', k, v); };
  var API = '/plugins/streambox/api_fetch.php';
  var LOAD = '/plugins/streambox/load.php';
  var busy = false, loadBusy = false, loadTimer = null, themed = false;
  var DEF_UI = { port: 8096, url: '', load: true, added: 5 };
  var COLOR = { red: '#e5534b', amber: '#d9921f', green: '#3fa24a', blue: '#4a90e2', grey: '#8a8a8a', orange: '#f5a524' };
  var TYPE_ICON = { Movie: 'fa-film', Episode: 'fa-television', Season: 'fa-television', Audio: 'fa-music',
    TvChannel: 'fa-video-camera', LiveTvChannel: 'fa-video-camera', Program: 'fa-video-camera', Recording: 'fa-video-camera' };
  // media servers (item 92): the badge text is the product name, not translated
  var SRV = { jf: ['sb-sv-jf', 'JELLYFIN', 'Jellyfin'], em: ['sb-sv-em', 'EMBY', 'Emby'], px: ['sb-sv-px', 'PLEX', 'Plex'] };
  function multi(r) { return !!(r && r.servers && r.servers.length > 1); }
  function chip(id) { var s = SRV[id] || ['', String(id).toUpperCase(), id]; return $('<span class="sb-sv">').addClass(s[0]).text(s[1]); }
  function srvErr(x) {
    var n = (SRV[x.id] || [0, 0, x.id])[2];
    return x.error === 'auth' ? T('now.srv_auth', { s: n }) : (x.error === 'unreachable' ? T('now.srv_down', { s: n }) : T('now.srv_err', { s: n, e: x.error }));
  }
  var MODE = {
    DirectPlay:   ['sb-play', T('mode.direct_play')],
    DirectStream: ['sb-stream', T('mode.direct_stream')],
    Transcode:    ['sb-trans', T('mode.transcode')]
  };

  // The embedded icon is light; invert it when the page background is light
  function applyTheme() {
    if (themed) { return; }
    themed = true;
    var el = document.getElementById('sb-now');
    while (el) {
      var m = /rgba?\(([^)]+)\)/.exec(getComputedStyle(el).backgroundColor || '');
      if (m) {
        var p = m[1].split(',');
        var a = p.length > 3 ? parseFloat(p[3]) : 1;
        if (a > 0.5) {
          if ((0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2]) > 150) { $('i.sb-ic').addClass('sb-inv'); }
          return;
        }
      }
      el = el.parentElement;
    }
  }

  function leftTxt(s) {
    s = Math.max(0, Math.floor(s));
    var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
    if (h > 0) { return T('time.left_hm', { h: h, m: (m < 10 ? '0' : '') + m }); }
    if (m > 0) { return T('time.left_m', { m: m }); }
    return T('time.left_s', { s: s });
  }
  function agoTxt(ts) {
    var d = Math.max(0, Math.floor(Date.now() / 1000) - ts);
    if (d < 60) { return T('time.just_now'); }
    if (d < 3600) { return T('time.ago_m', { m: Math.floor(d / 60) }); }
    if (d < 86400) { return T('time.ago_h', { h: Math.floor(d / 3600) }); }
    return T('time.ago_d', { d: Math.floor(d / 86400) });
  }
  function band(text, meta, first) {
    var $b = $('<div class="mt-band">').toggleClass('mt-first', !!first).append($('<span>').text(text));
    if (meta) { $b.append($('<b>').text(meta)); }
    return $b;
  }
  function mnote(t) { return $('<div class="mt-note">').text(t); }
  function note(t) { return $('<div class="sb-note">').text(t); }
  function moreLink(href, text) {
    return $('<a class="sb-more" target="_blank" rel="noopener">').attr('href', href)
      .append(document.createTextNode(text + ' ')).append($('<i class="fa fa-external-link">'));
  }
  function icon(cls, color) { return $('<i class="fa fa-fw">').addClass(cls).css('color', color); }

  function renderPill(r) {
    var $p = $('<div class="sb-pill">');
    var ok = r && r.ok;
    var st = ok ? [COLOR.green, 'fa-server', T('pill.online')]
         : (r && r.error === 'auth') ? [COLOR.amber, 'fa-key', T('pill.api_key')]
         : [COLOR.red, 'fa-chain-broken', T('pill.offline')];
    if (multi(r)) {
      // one dot per server instead of the single online state
      var $s = $('<span>');
      $.each(r.servers, function (i, x) {
        $s.append($('<i class="sb-dot">').css('background', x.ok ? COLOR.green : (x.error === 'auth' ? COLOR.amber : COLOR.red)))
          .append(document.createTextNode((SRV[x.id] || [0, x.id])[1] + ' '));
        if (!x.ok) { $s.attr('title', ($s.attr('title') ? $s.attr('title') + '\n' : '') + srvErr(x)); }
      });
      $p.append($s);
    } else {
      $p.append($('<span>').css('color', st[0]).append($('<i class="fa">').addClass(st[1])).append(document.createTextNode(' ' + st[2])));
    }
    if (ok) {
      var n = r.streams_total || 0;
      if (n > 0) {
        $p.append($('<span>').css('color', COLOR.green).append($('<i class="fa fa-play">')).append(document.createTextNode(' ' + T('pill.streaming', { n: n }))));
      }
      if (r.transcoding > 0) {
        $p.append($('<span>').css('color', COLOR.amber).append($('<i class="fa fa-bolt">')).append(document.createTextNode(' ' + T('pill.transcoding', { n: r.transcoding }))));
      }
    }
    $('#sb-status').empty().append($p);
  }

  function renderSummary(r) {
    var $s = $('#sb-summary');
    if (!r || !r.ok) { $s.text(T('sum.unavailable')); return; }
    if (!r.streams_total) { $s.text(T('sum.no_streams')); return; }
    $s.text(T('sum.streams', { n: r.streams_total }) + ' \u00B7 ' + T('sum.users', { n: r.users })
      + (r.mbps > 0 ? ' \u00B7 ' + r.mbps.toFixed(1) + ' Mbps' : ''));
  }

  function renderNow(r) {
    var $n = $('#sb-now').empty();
    if (!r || !r.ok) {
      var msg = (r && r.error === 'auth') ? T('now.err_auth')
              : (r && r.error === 'nokey') ? T('now.err_nokey')
              : T('now.err_down');
      $n.append(note(msg));
      return;
    }
    var t = '18px minmax(0,1fr) 64px 84px 120px';
    $n.append(band(T('now.title') + ' \u00B7 ' + r.streams_total, '', true));
    var $box = $('<div class="mt-box">').appendTo($n);
    // a server that does not answer gets a quiet row at the end of the list; the other servers' streams stay
    function downRows() {
      if (!multi(r)) { return; }
      $.each(r.servers, function (i, x) {
        if (x.ok) { return; }
        $box.append($('<div class="mt-r">').addClass(x.error === 'auth' ? 'mt-s-amber' : 'mt-s-red').css('grid-template-columns', 'auto minmax(0,1fr)')
          .append(chip(x.id)).append($('<div>').css('color', x.error === 'auth' ? COLOR.amber : COLOR.red).text(srvErr(x))));
      });
    }
    if (!r.streams.length) { $box.append(mnote(T('sum.no_streams'))); downRows(); return; }
    $box.append($('<div class="mt-cols">').css('grid-template-columns', t)
      .append($('<div>')).append($('<div>').text(T('col.title'))).append($('<div>').text(T('col.user'))).append($('<div>').text(T('col.device')))
      .append($('<div>').css('color', COLOR.orange).text(T('col.mode'))));

    $.each(r.streams, function (i, x) {
      var m = MODE[x.mode] || MODE.DirectPlay;
      var $row = $('<div class="mt-r">').css('grid-template-columns', t).addClass('mt-n').addClass(x.paused ? 'mt-s-grey' : (x.mode === 'Transcode' ? 'mt-s-amber' : (x.mode === 'DirectStream' ? 'mt-s-blue' : 'mt-s-green')));
      $row.append(x.paused ? icon('fa-pause', COLOR.grey) : icon(TYPE_ICON[x.type] || 'fa-play-circle', '#9fb4c8'));

      var pct = Math.max(0, Math.min(100, x.pct * 100));
      var col = x.paused ? COLOR.grey : (x.mode === 'Transcode' ? COLOR.orange : COLOR.green);
      var $pl;
      if (x.live) {
        // live TV has no length: a label instead of a progress bar
        $pl = $('<div class="sb-pl">').append($('<span>').css('color', x.paused ? COLOR.grey : COLOR.red)
          .text(x.paused ? T('now.paused') : '\u25CF ' + T('now.live')));
        if (x.epg) {
          $pl.append($('<div class="sb-pb">').append($('<i>').css({ width: pct + '%', background: col })));
          if (x.left > 0) { $pl.append($('<span class="sb-u">').text(leftTxt(x.left))); }
        }
      } else {
        $pl = $('<div class="sb-pl">')
          .append($('<div class="sb-pb">').append($('<i>').css({ width: pct + '%', background: col })))
          .append($('<span>').css('color', col).text(x.paused ? T('now.paused') : Math.round(pct) + '%'));
        if (x.paused) { $pl.append($('<span class="sb-u">').text(Math.round(pct) + '%')); }
        else if (x.left > 0) { $pl.append($('<span class="sb-u">').text(leftTxt(x.left))); }
      }
      var $nm = $('<div class="sb-nm">').attr('title', x.title);
      if (multi(r)) { $nm.append(chip(x.srv)); }
      $row.append($('<div>').append($nm.append(document.createTextNode(x.title))).append($pl));

      $row.append($('<div class="sb-el">').attr('title', x.user_full).text(x.user));
      $row.append($('<div class="sb-el">').attr('title', x.device_full).text(x.device));
      $row.append($('<div>').attr('title', x.info || '').append($('<span class="sb-bd">').addClass(m[0]).text(m[1]))
        .append($('<div class="sb-rs">').addClass(x.mode === 'Transcode' ? 'sb-warn' : '').text(x.detail)));
      $box.append($row);
    });
    downRows();
  }

  function renderAdded(r, href) {
    var $a = $('#sb-added').empty();
    if (!r || !r.ok || !r.added || !r.added.length) { return; }
    var t = '18px minmax(0,1fr) 74px 52px 62px';
    $a.append(band(T('added.title') + ' \u00B7 ' + r.added.length, T('added.meta')));
    var $box = $('<div class="mt-box">').appendTo($a);
    $box.append($('<div class="mt-cols">').css('grid-template-columns', t)
      .append($('<div>')).append($('<div>').text(T('col.title'))).append($('<div>').text(T('col.type'))).append($('<div>').text(T('col.quality')))
      .append($('<div class="sb-num">').text(T('col.added'))));
    $.each(r.added, function (i, x) {
      var $row = $('<div class="mt-r">').css('grid-template-columns', t).addClass('mt-n').addClass(x.type === 'Movie' ? 'mt-s-blue' : 'mt-s-purple');
      $row.append(icon(TYPE_ICON[x.type] || 'fa-play-circle', '#9fb4c8'));
      $row.append($('<div class="sb-nm">').attr('title', x.title).text(x.title));
      $row.append($('<div>').append($('<span class="sb-bd">').addClass(x.type === 'Movie' ? 'sb-t-blue' : 'sb-t-purple').text(x.type === 'Movie' ? T('type.movie') : (x.type === 'Episode' ? T('type.episode') : x.type))));
      $row.append($('<div class="sb-num">').css('text-align', 'left').text(x.quality || '\u2014'));
      $row.append($('<div class="sb-num sb-u">').text(x.added ? agoTxt(x.added) : '\u2014'));
      $box.append($row);
    });
    $a.append(moreLink(href, T('tile.open_jellyfin')));
  }

  function card(label, pct, sub) {
    var col = pct >= 85 ? COLOR.red : (pct >= 60 ? COLOR.amber : COLOR.green);
    return $('<div class="sb-card">')
      .append($('<div class="sb-k">').text(label))
      .append($('<div class="sb-v">').text(Math.round(pct) + '%'))
      .append($('<div class="sb-pb">').append($('<i>').css({ width: Math.min(100, pct) + '%', background: col })))
      .append($('<div class="sb-u sb-sm">').css('margin-top', '4px').text(sub));
  }

  function fmtW(w) { return (w >= 100 ? w.toFixed(0) : w.toFixed(1)) + ' W'; }

  function renderLoad(d) {
    var $l = $('#sb-load').empty();
    if (!d || !d.ok) { return; }
    var cards = [];
    if (d.gpu) {
      cards.push(card('GPU \u00B7 ' + T('load.video'), d.gpu.video, 'Quick Sync'));
      cards.push(card('GPU \u00B7 ' + T('load.render'), d.gpu.render, d.gpu.freq > 0 ? Math.round(d.gpu.freq) + ' MHz' : T('load.idle')));
    }
    if (d.cpu !== null && d.cpu !== undefined) { cards.push(card('CPU', d.cpu, T('load.all_cores'))); }
    var sock = d.socket;
    if (!cards.length && !sock && !d.socket_note) { return; }

    var watts = (d.gpu && d.gpu.power > 0) ? d.gpu.power : 0;
    var $sec = band(cards.length ? T('load.title') + (watts > 0 ? ' \u00B7 ' + watts.toFixed(1) + ' W' : '') : T('load.socket'), '');
    if (cards.length) { $sec.find('span').attr('title', watts > 0 ? T('load.power_tip') : ''); }
    if (sock) {
      var month = (sock.month_kwh !== null && sock.month_kwh !== undefined) ? ' \u00B7 ' + T('load.kwh_month', { kwh: sock.month_kwh.toFixed(1) }) : '';
      $sec.append($('<b>').text(T('load.socket') + ' \u00B7 ' + fmtW(sock.power) + month)
        .attr('title', T('load.socket_tip')));
    } else if (d.socket_note) {
      $sec.append($('<b>').css('color', COLOR.amber).text(T('load.socket') + ' \u00B7 ' + T('load.na')).attr('title', d.socket_note));
    }
    $l.append($sec);

    if (cards.length) {
      var $g = $('<div class="sb-cards">').css('margin-top', '8px').css('grid-template-columns', 'repeat(' + cards.length + ',1fr)');
      $.each(cards, function (i, c) { $g.append(c); });
      $l.append($g);
    }
  }

  function pollLoad() {
    if (loadBusy) { return; }
    loadBusy = true;
    $.getJSON(LOAD, { _: Date.now() }).done(renderLoad).always(function () { loadBusy = false; });
  }

  function render(r) {
    applyTheme();
    var ui = (r && r.ui) ? r.ui : DEF_UI;
    var href = ui.url ? ui.url : 'http://' + location.hostname + ':' + ui.port;
    $('#sb-home').attr('href', href);
    renderPill(r);
    renderSummary(r);
    renderNow(r);
    renderAdded(r, href);
    if (r && r.ok && ui.load) {
      if (!loadTimer) { pollLoad(); loadTimer = setInterval(pollLoad, 10000); }
    } else {
      if (loadTimer) { clearInterval(loadTimer); loadTimer = null; }
      $('#sb-load').empty();
    }
  }

  function poll() {
    if (busy) { return; }
    busy = true;
    $.getJSON(API, { _: Date.now() })
      .done(render)
      .fail(function () { render({ ok: false, error: 'unreachable' }); })
      .always(function () { busy = false; });
  }

  poll();
  setInterval(poll, 5000);

  // ---- This week's episodes (week.php, Sonarr calendar + usual delay) ----
  var WEEK = '/plugins/streambox/week.php';
  var weekBusy = false;
  function hm(ts) { var d = new Date(ts * 1000); return (d.getHours() < 10 ? '0' : '') + d.getHours() + ':' + (d.getMinutes() < 10 ? '0' : '') + d.getMinutes(); }
  function durTxt(s) {
    s = Math.max(0, Math.floor(s / 60));
    var h = Math.floor(s / 60), m = s % 60;
    return h > 0 ? h + 'h' + (m ? ' ' + (m < 10 ? '0' : '') + m + 'm' : '') : m + 'm';
  }
  function cdTxt(s) {   // 1d 12h (minutes only under a day: 12h 46m)
    s = Math.max(0, Math.floor(s / 60));
    var d = Math.floor(s / 1440), h = Math.floor((s % 1440) / 60), m = s % 60, o = [];
    if (d) { o.push(d + 'd'); }
    if (d || h) { o.push(h + 'h'); }
    if (!d) { o.push((o.length && m < 10 ? '0' : '') + m + 'm'); }
    return o.join(' ');
  }
  var DOW = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'], MON = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
  function dhm(ts) { return T('date.dow.' + DOW[new Date(ts * 1000).getDay()]) + ' ' + hm(ts); }
  function dayLabel(ts) { var d = new Date(ts * 1000); return T('date.day', { dow: T('date.dow.' + DOW[d.getDay()]), d: d.getDate(), mon: T('date.mon.' + MON[d.getMonth()]) }); }
  var WST = {
    jf:    ['mt-s-green', 'sb-t-green', T('week.st.jf')],
    file:  ['mt-s-green', 'sb-t-green', T('week.st.file')],
    imp:   ['mt-s-blue', 'sb-t-blue', T('week.st.imp')],
    scan:  ['mt-s-blue', 'sb-t-blue', T('week.st.scan')],
    dl:    ['mt-s-blue', 'sb-t-blue', T('week.st.dl')],
    grab:  ['mt-s-blue', 'sb-t-blue', T('week.st.grab')],
    pause: ['mt-s-grey', 'sb-t-grey', T('week.st.pause')],
    fail:  ['mt-s-red', 'sb-t-red', T('week.st.fail')],
    late:  ['mt-s-amber', 'sb-t-amber', T('week.st.late')],
    aired: ['mt-s-grey', 'sb-t-grey', T('week.st.aired')],
    wait:  ['mt-s-grey', 'sb-t-grey', T('week.st.wait')]
  };
  // A season that comes out at once (2 or more episodes of one season on one day) is one row with one status:
  // the most urgent state of the episodes not yet in Jellyfin (all in Jellyfin: green), as in the Jellyfin week row
  var WORD = ['fail', 'dl', 'grab', 'imp', 'scan', 'pause', 'late', 'aired', 'wait'];
  function weekItems(rows) {
    var by = {}, order = [];
    $.each(rows, function (i, r) {
      var k = r.series + '|' + r.code.slice(0, 3);
      if (!by[k]) { by[k] = []; order.push(k); }
      by[k].push(r);
    });
    var out = [];
    $.each(order, function (i, k) {
      var g = by[k];
      if (g.length < 2) { out.push(g[0]); return; }
      g = g.slice().sort(function (a, b) { return a.code < b.code ? -1 : (a.code > b.code ? 1 : 0); });
      var f = g[0], l = g[g.length - 1], run = +l.code.slice(4) - +f.code.slice(4) + 1 === g.length;
      var jf = $.grep(g, function (r) { return r.st === 'jf' || r.st === 'file'; }).length, m = null;
      for (var j = 0; j < WORD.length && !m; j++) {
        var x = $.grep(g, function (r) { return r.st === WORD[j]; });
        if (x.length) { m = WORD[j] === 'dl' ? x.sort(function (a, b) { return (a.pct || 0) - (b.pct || 0); })[0] : x[0]; }
      }
      m = m || f;
      out.push($.extend({}, m, { code: run ? f.code + '–' + l.code.slice(3) : f.code.slice(0, 3), title: '', grp: g, jf: jf,
        st: jf === g.length ? 'jf' : m.st, idx: [], 'new': $.grep(g, function (r) { return r['new']; }).length > 0 }));
    });
    return out;
  }
  function renderWeek(w) {
    var $w = $('#sb-week').empty();
    if (!w || !w.show) { return; }
    var f = new Date(w.from * 1000), t = new Date((w.to - 1) * 1000);
    var range = T('date.range', { from: f.getMonth() !== t.getMonth() ? dayLabel(w.from) : T('date.day_short', { dow: T('date.dow.' + DOW[f.getDay()]), d: f.getDate() }), to: dayLabel(w.to - 1) });
    if (!w.ok) {
      if (w.show < 2) { return; }
      $w.append(band(T('week.title'), range));
      var why = w.error === 'nosonarr' ? T('week.err_nosonarr') : (w.error === 'auth' ? T('week.err_auth') : T('week.err_down'));
      $w.append($('<div class="mt-box">').append(mnote(why)));
      return;
    }
    if (!w.counts.all && w.show < 2) { return; }
    var meta = [range];
    if (w.counts.jf) { meta.push(T('week.n_jf', { n: w.counts.jf })); }
    if (w.counts.dl) { meta.push(T('week.n_dl', { n: w.counts.dl })); }
    if (w.counts.late) { meta.push(T('week.n_late', { n: w.counts.late })); }
    var $b = band(T('week.title') + ' \u00B7 ' + w.counts.all, meta.join(' \u00B7 '));
    if (w.counts.late) { $b.find('b').css({ color: COLOR.amber, opacity: 1 }); }
    $w.append($b);
    var $box = $('<div class="mt-box">').appendTo($w);
    if (!w.counts.all) { $box.append(mnote(T('week.none'))); return; }
    var t3 = '18px minmax(0,1fr) 108px 104px';
    $.each(w.days, function (i, d) {
      var ready = 0;
      $.each(d.rows, function (j, r) { if (r.st === 'jf' || r.st === 'file') { ready++; } });
      $box.append($('<div class="sb-day">').toggleClass('sb-today', !!d.today)
        .append($('<span>').text((d.today ? T('week.today') + ' \u00B7 ' : '') + (d.ts ? dayLabel(d.ts) : d.label)))
        .append($('<span>').text(ready ? T('week.n_jf', { n: ready }) : '')));
      $.each(weekItems(d.rows), function (j, r) {
        var s = WST[r.st] || WST.wait;
        var $row = $('<div class="mt-r mt-n">').addClass(s[0]).css('grid-template-columns', t3);
        $row.append(icon('fa-television', '#9fb4c8'));
        var ttl = r.grp ? $.map(r.grp, function (x) { return x.code + (x.title ? ' \u00B7 ' + x.title : '') + ' \u00B7 ' + (WST[x.st] || WST.wait)[2]; }).join('\n')
          : (r.title ? r.code + ' \u00B7 ' + r.title : r.code);
        var $t = $('<div class="sb-nm">').attr('title', ttl).text(r.series + ' \u00B7 ' + r.code);
        if (r['new']) { $t.append(' ').append($('<span class="sb-new">').attr('title', T('week.new_tip')).text(T('week.new'))); }
        var $nm = $('<div>').append($t);
        var sub = '';
        if (r.st === 'late') { sub = r.delay !== null ? T('week.late_usual', { usual: durTxt(r.delay), now: durTxt(w.now - r.air) }) : T('week.late_ago', { t: durTxt(w.now - r.air) }); }
        else if (r.idx && r.idx.length > 1 && (r.st === 'wait' || r.st === 'aired')) { sub = $.map(r.idx, function (x) { return x[0] + ' ~' + hm(x[1]); }).join(' \u00B7 '); }
        if (r.grp) { sub = T('week.eps', { n: r.grp.length }) + (r.jf && r.jf < r.grp.length ? ' \u00B7 ' + T('week.eps_jf', { n: r.jf }) : '') + (sub ? ' \u00B7 ' + sub : ''); }
        if (sub) { $nm.append($('<div class="sb-wsub">').text(sub)); }
        if (r.st === 'dl' && r.pct !== null) { $nm.append($('<div class="sb-pb">').css('margin-top', '5px').append($('<i>').css({ width: r.pct + '%', background: COLOR.blue }))); }
        $row.append($nm);
        // countdown to the expected time (to the air time when the delay is unknown); after it: overdue
        var nowS = Math.floor(Date.now() / 1000), target = r.exp !== null ? r.exp : r.air, when;
        if (r.st === 'wait' || r.st === 'aired' || r.st === 'late') {
          when = target > nowS ? T(r.exp === null ? 'week.airs_in' : 'week.in', { t: cdTxt(target - nowS) }) : (nowS - target < 60 ? T('week.due_now') : T('week.overdue', { t: cdTxt(nowS - target) }));
        } else { when = T('week.aired_at', { t: hm(r.air) }); }
        var tip = T('week.tip_airs', { t: dhm(r.air) }) + (r.exp !== null ? ' \u00b7 ' + T('week.tip_expected', { t: dhm(r.exp) }) : '') + '\n'
          + (r.exp === null ? T('week.tip_nohist')
            : T(r.basis === 'series' ? 'week.tip_delay_series' : 'week.tip_delay_all', { t: durTxt(r.delay), n: r.n }));
        $row.append($('<div class="sb-num sb-u">').css({ 'text-align': 'left', overflow: 'hidden', 'text-overflow': 'ellipsis' }).attr('title', when + '\n' + tip).text(when));
        var lab = s[2];
        if (r.st === 'dl' && r.pct !== null) { lab = r.pct + '%' + (r.left ? ' \u00B7 ' + durTxt(r.left) : ''); }
        $row.append($('<div>').append($('<span class="sb-bd">').addClass(s[1]).text(lab)
          .attr('title', r.st === 'scan' ? T('week.scan_tip') : '')));
        $box.append($row);
      });
    });
  }
  function pollWeek() {
    if (weekBusy) { return; }
    weekBusy = true;
    $.getJSON(WEEK, { _: Date.now() }).done(renderWeek).always(function () { weekBusy = false; });
  }
  pollWeek();
  setInterval(pollWeek, 60000);
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SETTINGS PAGE  (Settings -> Utilities -> Streambox)        -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/StreamboxSettings.page">
<INLINE><![CDATA[Menu="Utilities"
Type="xmenu"
Title="Streambox"
Icon="streambox.png"
Markdown="false"
---
<?PHP
// texts from the dictionary (lang/en.json and its translations, see i18n.php); $sbs_t escapes, $sbs_T is raw (texts with HTML)
require_once '/usr/local/emhttp/plugins/streambox/i18n.php';
$sbs_lang = '/usr/local/emhttp/plugins/streambox/lang';
$sbs_T = mt_i18n_t($sbs_lang);
$sbs_t = function ($k, $v = []) use ($sbs_T) { return htmlspecialchars($sbs_T($k, $v), ENT_QUOTES); };
$sb_file = '/boot/config/plugins/streambox/settings.cfg';
$sb = [
  'jf_host' => '127.0.0.1', 'jf_port' => '8096', 'jf_key' => '', 'jf_url' => '',
  'em_on' => '0', 'em_host' => '127.0.0.1', 'em_port' => '8097', 'em_key' => '',
  'streams_max' => '8', 'added_rows' => '5', 'show_load' => '1',
  'socket_host' => '', 'socket_id' => '0',
  'notify' => '0', 'dc_movies' => '', 'dc_series' => '', 'notify_settle' => '5', 'notify_wait' => '30',
  'weekly' => '0', 'dc_weekly' => '', 'weekly_day' => '5', 'weekly_hour' => '18',
  'wk_show' => '1', 'wk_src' => 'seedbox', 'son_url' => '', 'son_key' => '', 'wk_delay' => 'series', 'wk_late' => '2', 'wk_dc' => '0', 'wk_web' => '1', 'wk_web_dir' => '/mnt/cache/docker/streambox/web', 'wk_web_view' => 'grid', 'jx_on' => '1', 'jx_badge' => 'title',
];
$sb_log = is_file('/tmp/streambox_notify.log') ? implode("\n", array_slice((array)@file('/tmp/streambox_notify.log', FILE_IGNORE_NEW_LINES), -6)) : '';
if (is_file($sb_file)) {
  $sb_c = @parse_ini_file($sb_file);
  if (is_array($sb_c)) { $sb = array_merge($sb, $sb_c); }
}
$sb_nicks = [];
$sb_nf = '/boot/config/plugins/streambox/nicknames.json';
if (is_file($sb_nf)) {
  $sb_n = json_decode((string)@file_get_contents($sb_nf), true);
  if (is_array($sb_n)) { $sb_nicks = $sb_n; }
}
$sb_var = @parse_ini_file('/var/local/emhttp/var.ini');
$sb_tok = is_array($sb_var) ? (string)($sb_var['csrf_token'] ?? '') : '';

// Jellyfin users, for the nickname table
$sb_users = null;
if ((string)$sb['jf_key'] !== '' && preg_match('/^[A-Za-z0-9.\-]+$/', (string)$sb['jf_host'])) {
  $sb_ch = curl_init('http://' . $sb['jf_host'] . ':' . (int)$sb['jf_port'] . '/Users');
  curl_setopt_array($sb_ch, [
    CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 3, CURLOPT_TIMEOUT => 4,
    CURLOPT_HTTPHEADER => ['Authorization: MediaBrowser Token="' . $sb['jf_key'] . '"', 'Accept: application/json'],
  ]);
  $sb_body = curl_exec($sb_ch);
  $sb_code = (int)curl_getinfo($sb_ch, CURLINFO_HTTP_CODE);
  curl_close($sb_ch);
  if ($sb_code === 200) {
    $sb_list = json_decode((string)$sb_body, true);
    if (is_array($sb_list)) {
      $sb_users = [];
      foreach ($sb_list as $sb_u) {
        if (!empty($sb_u['Id'])) { $sb_users[] = ['id' => (string)$sb_u['Id'], 'name' => (string)($sb_u['Name'] ?? '?')]; }
      }
      usort($sb_users, function ($a, $b) { return strcasecmp($a['name'], $b['name']); });
    }
  }
}
if (!function_exists('sb_h')) {
  function sb_h($v) { return htmlspecialchars((string)$v, ENT_QUOTES); }
}
if (!function_exists('sb_chk')) {
  function sb_chk($v) { return in_array(strtolower(trim((string)$v)), ['0', 'no', 'false', 'off', ''], true) ? '' : 'checked'; }
}
if (!function_exists('sb_auto')) {
  function sb_auto($name) {
    $parts = preg_split('/[\s._\-@]+/u', trim((string)$name));
    $first = ($parts && $parts[0] !== '') ? $parts[0] : trim((string)$name);
    $n = preg_match_all('/./us', $first);
    if ($n > 8) { return (preg_match('/^.{1,8}/us', $first, $m) ? $m[0] : substr($first, 0, 8)) . "\u{2026}"; }
    return $first;
  }
}
?>
<style>
/* Shared settings-page look (the owner's design rule, 2026-10-10): a dark band per part (the h3), the rows in a box, the label on the
   left, the controls of one setting on one line, the explanation as a quiet line under them. Scoped to a form with class "uset".
   The builds copy this block into each settings page where the marker below stands. Unraid 7 lays every dd out as a flex column:
   overridden here for these forms only. */
.uset h3{display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(0,0,0,.25);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:9px 12px;margin:26px 0 8px;line-height:1.4}
.uset h3:first-child{margin-top:6px}
.uset h3 small{font-weight:400;opacity:.55;text-transform:none;letter-spacing:0}
.uset dl{display:grid;grid-template-columns:minmax(200px,300px) minmax(0,1fr);gap:0;margin:0;padding:0;background:rgba(128,128,128,.12)}
.uset dl dt,.uset dl dd{float:none;width:auto;margin:0;padding:9px 12px;border-top:1px solid rgba(128,128,128,.22);text-align:left;line-height:1.5}
.uset dl dt{opacity:.75;font-weight:normal}
.uset dl dt:first-child,.uset dl dt:first-child+dd{border-top:0}
.uset dl dd{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px 12px}
.uset dl dd>[class*="-mut"],.uset dl dd>.uset-hint,.uset dl dd>.uset-brk,.uset dl dd>div,.uset dl dd>p{flex:1 1 100%;margin:0}
.uset dl dd>[class*="-mut"],.uset dl dd>.uset-hint{opacity:.55;font-size:12px;max-width:120ch}
.uset dl dd>.uset-brk{height:0}
.uset dd input,.uset dd select,.uset dd textarea{margin:0;max-width:100%}
.uset dd select{width:auto!important;min-width:110px}
.uset dd input.narrow{width:110px!important;min-width:0}
.uset dd input[type=checkbox]{width:auto!important;margin:0 4px 0 0}
.uset dd label{display:inline-flex;align-items:center;gap:4px}
.uset dd input[type=button]{margin:0}
.uset dl.uset-save{background:none;margin-top:14px}
.uset dl.uset-save dt,.uset dl.uset-save dd{border-top:0}
.uset .uset-ok{color:#3fa24a}.uset .uset-er{color:#e5534b}
@media (max-width:760px){.uset dl{grid-template-columns:1fr}.uset dl dd{border-top:0;padding-top:0}}
</style>
<form id="sb-form" class="uset" method="POST" action="/plugins/streambox/save.php" onsubmit="return false;">
<input type="hidden" name="csrf_token" value="<?=sb_h($sb_tok)?>">
<h3><?=$sbs_t('set.h.jellyfin')?></h3>
<dl>
<dt><?=$sbs_t('set.jf_host')?></dt>
<dd><input type="text" name="jf_host" class="narrow" value="<?=sb_h($sb['jf_host'])?>"></dd>

<dt><?=$sbs_t('set.jf_port')?></dt>
<dd><input type="number" name="jf_port" min="1" max="65535" class="narrow" value="<?=sb_h($sb['jf_port'])?>"></dd>

<dt><?=$sbs_t('set.jf_key')?></dt>
<dd><input type="password" name="jf_key" class="narrow" autocomplete="new-password" value="" placeholder="<?=$sb['jf_key'] !== '' ? $sbs_T('set.saved_keep') : ''?>"> <span style="opacity:.6"><?=$sbs_t('set.key_hint')?></span></dd>

<dt><?=$sbs_t('set.jf_url')?></dt>
<dd><input type="text" name="jf_url" placeholder="https://media.example.com" value="<?=sb_h($sb['jf_url'])?>"></dd>

<dt><?=$sbs_t('set.streams_max')?></dt>
<dd><input type="number" name="streams_max" min="1" max="30" class="narrow" value="<?=sb_h($sb['streams_max'])?>"></dd>

<dt><?=$sbs_t('set.added_rows')?></dt>
<dd><input type="number" name="added_rows" min="0" max="20" class="narrow" value="<?=sb_h($sb['added_rows'])?>"></dd>

<dt><?=$sbs_t('set.show_load')?></dt>
<dd><input type="hidden" name="show_load" value="0"><input type="checkbox" name="show_load" value="1" <?=sb_chk($sb['show_load'])?>> <?=$sbs_t('set.show_load_hint')?></dd>

<dt><?=$sbs_t('set.socket_host')?></dt>
<dd><input type="text" name="socket_host" class="narrow" placeholder="192.168.1.50" value="<?=sb_h($sb['socket_host'])?>"></dd>

<dt><?=$sbs_t('set.socket_id')?></dt>
<dd><input type="number" name="socket_id" min="0" max="3" class="narrow" value="<?=sb_h($sb['socket_id'])?>"></dd>
</dl>

<h3><?=$sbs_t('set.h.emby')?> <small><?=$sbs_t('set.h.emby_sub')?></small></h3>
<dl>
<dt><?=$sbs_t('set.em_on')?></dt>
<dd><input type="hidden" name="em_on" value="0"><input type="checkbox" name="em_on" value="1" <?=sb_chk($sb['em_on'])?>> <?=$sbs_t('set.em_on_hint')?></dd>

<dt><?=$sbs_t('set.em_host')?></dt>
<dd><input type="text" name="em_host" class="narrow" value="<?=sb_h($sb['em_host'])?>"> <input type="number" name="em_port" min="1" max="65535" class="narrow" value="<?=sb_h($sb['em_port'])?>"> <span class="uset-hint"><?=$sbs_t('set.em_host_hint')?></span></dd>

<dt><?=$sbs_t('set.em_key')?></dt>
<dd><input type="password" name="em_key" class="narrow" autocomplete="new-password" value="" placeholder="<?=$sb['em_key'] !== '' ? $sbs_T('set.saved_keep') : ''?>"> <input type="button" id="sb-etest" value="<?=$sbs_t('set.btn.test_emby')?>"> <span id="sb-emsg"></span> <span class="uset-hint"><?=$sbs_t('set.em_key_hint')?></span></dd>
</dl>

<h3><?=$sbs_t('week.title')?> <small><?=$sbs_t('set.h.week_sub')?></small></h3>
<dl>
<dt><?=$sbs_t('set.wk_show')?></dt>
<dd><select name="wk_show">
<?php foreach (['2' => $sbs_T('set.wk_show.always'), '1' => $sbs_T('set.wk_show.airs'), '0' => $sbs_T('set.wk_show.never')] as $sb_k => $sb_l): ?>
  <option value="<?=$sb_k?>" <?=((string)$sb['wk_show'] === (string)$sb_k) ? 'selected' : ''?>><?=sb_h($sb_l)?></option>
<?php endforeach; ?>
</select>
<span class="uset-hint"><?=$sbs_t('set.wk_show_hint')?></span></dd>

<dt><?=$sbs_t('set.wk_src')?></dt>
