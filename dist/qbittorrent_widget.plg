    $('#stt-n-upd').text(T('u.n_offers', { n: off }) + (nm ? ' \u00b7 ' + T('u.n_must', { n: nm }) : ''));
    h = esc(T('u.searched', { d: BG.done, n: BG.total })) + (BG.running ? (BG.cur ? ' &middot; ' + esc(T('u.now', { t: BG.cur })) : '') : (BG.done < BG.total ? (BG.state === 'stopped' ? ' &middot; ' + esc(T('u.stopped')) : '') : ' &middot; ' + esc(T('u.done')))) +
        ' &middot; ' + T('u.with_offer', { n: '<b>' + off + '</b>' }) + (off ? ' (' + esc($.map(['save', 'hdr', 'res'], function (k) { return n[k] ? n[k] + ' ' + CATL[k] : null; }).join(', ')) + ')' : '');
    // the balance: the first (best listed) saving release of each torrent frees, the first upgrade takes; a torrent with both counts in both lines
    var fr = 0, nf = 0, tk = 0, nt = 0;
    $.each(u.items || [], function (i, it) {
      var rr = RES[it.hash], cur = +(it.cur_size || it.size), s1 = null, u1 = null;
      if (!rr || rr.state !== 'ready' || !cur) { return; }
      $.each(rr.rows || [], function (j, r) {
        var c = r.cats || [];
        if (!s1 && UCAT.save && c.indexOf('save') >= 0) { s1 = r; }
        if (!u1 && ((UCAT.hdr && c.indexOf('hdr') >= 0) || (UCAT.res && c.indexOf('res') >= 0))) { u1 = r; }
      });
      if (s1) { fr += cur - s1.size; nf++; }
      if (u1) { tk += u1.size - cur; nt++; }
    });
    if (nf || nt) {
      h += '<br>' + (nf ? T('u.free', { n: nf, s: '<b>' + fb(Math.max(0, fr)) + '</b>' }) : '') + (nf && nt ? '; ' : '') +
           (nt ? T(tk >= 0 ? 'u.take_more' : 'u.take_less', { n: nt, s: '<b>' + fb(Math.abs(tk)) + '</b>' }) : '') +
           ' <span title="' + esc(T('u.approx_tip')) + '">(' + esc(T('u.approx')) + ')</span>';
    }
    if (BG.running) { h += ' <input type="button" class="stt-btn stt-sm stt-ghost" id="stt-ubgstop" value="' + esc(T('u.stop_search')) + '">'; }
    else if (BG.done < BG.total) { h += ' <input type="button" class="stt-btn stt-sm" id="stt-ubggo" value="' + esc(T('u.search_rest')) + '">'; }
    if (BG.done > 0) { h += ' <input type="button" class="stt-btn stt-sm stt-ghost" id="stt-uforget" value="' + esc(T('u.forget')) + '" title="' + esc(T('u.forget_tip')) + '">'; }
    $('#stt-ubg').html(h);
