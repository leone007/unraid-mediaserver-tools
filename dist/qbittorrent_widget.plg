<FILE Name="&plugdir;/bot.php">
<INLINE><![CDATA[<?php
// Shared Discord bot setting of the media server tools (Seedbox, Sysbox; item 95): one file on the flash drive with the
// bot token and the owner's Discord user id, so the bot is set once and every plugin's messages can get reactions.
//   token = the bot token (Discord Developer Portal, your app, Bot, Reset Token); never sent to a page
//   user  = the owner's user id: only this user's reactions count
// Before this file existed the bot lived in the Seedbox settings (tools.json bot_token, bot_user): while the file is
// missing those are used, and the first save writes the file (from then on an empty token in it means none).
// The bot has no gateway connection: messages go out through the plugin's webhook with ?wait=true, the bot adds the
// reactions and reads them back over REST, so it needs only View Channel, Add Reactions and Read Message History.
// Every plugin ships its own copy of this file; the guard keeps a second copy from being declared again.
if (!function_exists('mt_bot_cfg')) {

require_once __DIR__ . '/lang.php';

function mt_bot_file() { return getenv('MT_BOT_FILE') ?: '/boot/config/plugins/mediaserver-tools/discord_bot.cfg'; }

function mt_bot_cfg() {
    $f = mt_bot_file();
    if (is_file($f)) {
        $c = @parse_ini_file($f, false, INI_SCANNER_RAW);
        $c = is_array($c) ? $c : [];
        return ['token' => trim((string)($c['token'] ?? ''), "\"' "), 'user' => trim((string)($c['user'] ?? ''), "\"' "), 'src' => 'shared'];
    }
    $j = @json_decode((string)@file_get_contents(getenv('MT_BOT_SEEDBOX') ?: '/boot/config/plugins/qbittorrent_widget/tools.json'), true);
    $j = is_array($j) ? $j : [];
    return ['token' => trim((string)($j['bot_token'] ?? '')), 'user' => trim((string)($j['bot_user'] ?? '')), 'src' => 'seedbox'];
}
function mt_bot_ready() { $c = mt_bot_cfg(); return $c['token'] !== '' && preg_match('/^\d{15,25}$/', $c['user']) === 1; }

// $token: empty keeps the saved one, - removes it. Returns '' or the dictionary key of the error.
function mt_bot_save($token, $user) {
    $old = mt_bot_cfg();
    $token = trim((string)$token); $user = trim((string)$user);
    if ($token === '-') { $token = ''; }
    elseif ($token === '') { $token = $old['token']; }
    elseif (!preg_match('/^[A-Za-z0-9_\-.]{50,100}$/', $token)) { return 'bot.e.token'; }
    if ($user !== '' && !preg_match('/^\d{15,25}$/', $user)) { return 'bot.e.user'; }
    $f = mt_bot_file();
    @mkdir(dirname($f), 0777, true);
    if (@file_put_contents($f . '.tmp', 'token="' . $token . "\"\nuser=\"" . $user . "\"\n") === false || !@rename($f . '.tmp', $f)) { return 'bot.e.write'; }
    @chmod($f, 0600);
    return '';
}

// the texts of this file (Discord messages in the Discord language, page messages in the page language)
function mt_bot_dir() { return is_dir(__DIR__ . '/mtlang') ? __DIR__ . '/mtlang' : __DIR__ . '/lang'; }
function mt_bot_t($key, $vars = [], $discord = false) {
    static $tabs = [];
    $code = $discord ? mt_lang_discord() : mt_lang_ui();
    if (!isset($tabs[$code])) {
        $rd = function ($f) { $j = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null; return is_array($j) ? $j : []; };
        $en = $rd(mt_bot_dir() . '/en.json'); $tr = $code !== 'en' ? $rd(mt_bot_dir() . '/' . $code . '.json') : [];
        $tabs[$code] = [];
        foreach ($en as $k => $v) { if (is_array($v) && isset($v['text'])) { $t = $tr[$k]['text'] ?? ''; $tabs[$code][$k] = is_string($t) && trim($t) !== '' ? $t : (string)$v['text']; } }
    }
    $s = $tabs[$code][$key] ?? $key;
    return preg_replace_callback('/\{([a-z0-9_]+)\}/', function ($m) use ($vars) { return array_key_exists($m[1], $vars) ? (string)$vars[$m[1]] : $m[0]; }, $s);
}

// the Discord webhook of the plugin this copy belongs to (the bot reacts under that plugin's messages)
function mt_bot_hook() {
    if (getenv('MT_BOT_HOOK') !== false) { return (string)getenv('MT_BOT_HOOK'); }
    $p = basename(__DIR__);
    if ($p === 'qbittorrent_widget') {
        $j = @json_decode((string)@file_get_contents('/boot/config/plugins/qbittorrent_widget/tools.json'), true);
        return is_array($j) ? trim((string)($j['dc_hook'] ?? '')) : '';
    }
    $c = @parse_ini_file('/boot/config/plugins/' . $p . '/settings.cfg', false, INI_SCANNER_RAW);
    return is_array($c) ? trim((string)($c['dc_hook'] ?? ''), "\"' ") : '';
}

// one HTTP request: [code, body, error]
function mt_bot_http($method, $url, $headers, $body = null) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [CURLOPT_CUSTOMREQUEST => $method, CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 15, CURLOPT_CONNECTTIMEOUT => 8, CURLOPT_HTTPHEADER => $headers]);
    if ($body !== null) { curl_setopt($ch, CURLOPT_POSTFIELDS, $body); }
    $b = curl_exec($ch); $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE); $err = $b === false ? curl_error($ch) : '';
    curl_close($ch);
    return [$code, (string)$b, $err];
}
// Discord REST as the bot: [code, json, error]; one wait on a rate limit
function mt_bot_api($method, $path, $body = null) {
    $base = getenv('MT_BOT_API') ?: 'https://discord.com/api/v10';
    $tok = mt_bot_cfg()['token'];
    for ($try = 0; $try < 2; $try++) {
        $h = ['Authorization: Bot ' . $tok, 'User-Agent: DiscordBot (mediaserver-tools, 1)', 'Content-Type: application/json'];
        [$code, $b, $err] = mt_bot_http($method, $base . $path, $h, $body !== null ? json_encode($body, JSON_UNESCAPED_UNICODE) : ($method === 'PUT' ? '' : null));
        if ($err !== '') { return [0, null, $err]; }
        $j = json_decode($b, true);
        if ($code === 429 && $try === 0) { $w = is_array($j) ? (float)($j['retry_after'] ?? 1) : 1.0; if ($w <= 5) { usleep((int)(($w + 0.2) * 1e6)); continue; } }
        if ($code >= 400) { return [$code, $j, 'Discord HTTP ' . $code . (is_array($j) && !empty($j['message']) ? ': ' . $j['message'] : '')]; }
        return [$code, $j, ''];
    }
    return [429, null, 'Discord rate limit'];
}

// The Test button of the block: the token works, a message goes out with this plugin's webhook, the bot reacts under it
// and reads the reaction back (the three permissions). Nothing waits for the owner. Returns [ok, page text].
function mt_bot_test($plugin) {
    $c = mt_bot_cfg();
    if ($c['token'] === '') { return [false, mt_bot_t('bot.t.no_token')]; }
    [$code, $me, $e] = mt_bot_api('GET', '/users/@me');
    if ($e !== '') { return [false, mt_bot_t('bot.t.token', ['e' => $e])]; }
    $name = (string)($me['username'] ?? 'bot');
    $hook = mt_bot_hook();
    if ($hook === '') { return [false, mt_bot_t('bot.t.no_hook', ['p' => $plugin])]; }
    $emb = ['title' => mt_bot_t('bot.d.title', ['p' => $plugin], true), 'description' => mt_bot_t('bot.d.desc', ['bot' => $name], true), 'color' => 0x9A7DE6];
    [$hc, $hb, $he] = mt_bot_http('POST', $hook . (strpos($hook, '?') === false ? '?' : '&') . 'wait=true', ['Content-Type: application/json'], json_encode(['embeds' => [$emb]], JSON_UNESCAPED_UNICODE));
    $msg = json_decode($hb, true);
    if ($he !== '' || $hc >= 400 || !is_array($msg) || empty($msg['id'])) { return [false, mt_bot_t('bot.t.hook', ['e' => $he !== '' ? $he : 'HTTP ' . $hc])]; }
    $path = '/channels/' . (string)($msg['channel_id'] ?? '') . '/messages/' . $msg['id'] . '/reactions/' . rawurlencode("\u{2705}");
    [$rc, $rj, $re] = mt_bot_api('PUT', $path . '/@me');
    if ($re !== '') { return [false, mt_bot_t('bot.t.react', ['e' => $re])]; }
    [$gc, $gj, $ge] = mt_bot_api('GET', $path . '?limit=10');
    if ($ge !== '' || !is_array($gj)) { return [false, mt_bot_t('bot.t.read', ['e' => $ge !== '' ? $ge : 'HTTP ' . $gc])]; }
    return [true, trim(mt_bot_t('bot.t.ok', ['bot' => $name]) . ($c['user'] === '' ? ' ' . mt_bot_t('bot.t.no_user') : ''))];
}

}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/bot_block.php">
<INLINE><![CDATA[<?php
// The Discord bot block (Seedbox Tools settings, Sysbox Claude Guard; item 95): the shared setting of bot.php. The page
// sets $mt_bot_post (this plugin's bot_save.php) and includes this file. The token never goes into the page.
require_once __DIR__ . '/bot.php';
$mtb_c = mt_bot_cfg();
$mtb_var = @parse_ini_file('/var/local/emhttp/var.ini');
$mtb_tok = is_array($mtb_var) ? (string)($mtb_var['csrf_token'] ?? '') : '';
$mtb_h = function ($k, $v = []) { return htmlspecialchars(mt_bot_t($k, $v), ENT_QUOTES); };
$mtb_state = $mtb_c['token'] === '' ? mt_bot_t('bot.st.off') : ($mtb_c['user'] === '' ? mt_bot_t('bot.st.no_user') : mt_bot_t('bot.st.on'));
?>
<style>
#mtb{margin:28px 0 8px;max-width:1100px}
#mtb .mtb-band{display:flex;justify-content:space-between;align-items:center;gap:12px;background:rgba(0,0,0,.35);padding:10px 14px;text-transform:uppercase;letter-spacing:1.5px;font-size:12px}
#mtb .mtb-band b{font-weight:normal;text-transform:none;letter-spacing:0;opacity:.6}
#mtb .mtb-box{background:rgba(128,128,128,.08);border-radius:0 0 6px 6px}
#mtb .mtb-row{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px;padding:14px 16px;border-left:3px solid #8a8a8a;border-bottom:1px solid rgba(128,128,128,.15)}
#mtb .mtb-row.on{border-left-color:#3fa24a}
#mtb .mtb-row label{padding-top:6px}
#mtb .mtb-row input[type=password],#mtb .mtb-row input[type=text]{width:320px;max-width:100%;margin:0}
#mtb .mtb-hint{display:block;opacity:.6;line-height:1.5;margin-top:6px;white-space:normal}
#mtb .mtb-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px;flex-wrap:wrap}
#mtb .mtb-foot button{margin:0 0 0 8px}
#mtb .mtb-foot .mtb-ghost{background:transparent;border:1px solid rgba(128,128,128,.5)}
@media (max-width:700px){#mtb .mtb-row{grid-template-columns:1fr;gap:4px}}
</style>
<div id="mtb">
  <div class="mtb-band"><span><?=$mtb_h('bot.h.band')?></span><b id="mtb-state"><?=htmlspecialchars($mtb_state, ENT_QUOTES)?></b></div>
  <div class="mtb-box">
    <div class="mtb-row<?=$mtb_c['token'] !== '' ? ' on' : ''?>">
      <label for="mtb-token"><?=$mtb_h('bot.l.token')?></label>
      <div>
        <input type="password" id="mtb-token" autocomplete="new-password" placeholder="<?=$mtb_h($mtb_c['token'] !== '' ? 'bot.ph.saved' : 'bot.ph.token')?>">
        <span class="mtb-hint"><?=$mtb_h('bot.hint.token')?></span>
      </div>
    </div>
    <div class="mtb-row<?=$mtb_c['user'] !== '' ? ' on' : ''?>">
      <label for="mtb-user"><?=$mtb_h('bot.l.user')?></label>
      <div>
        <input type="text" id="mtb-user" inputmode="numeric" value="<?=htmlspecialchars($mtb_c['user'], ENT_QUOTES)?>" placeholder="<?=$mtb_h('bot.ph.user')?>">
        <span class="mtb-hint"><?=$mtb_h('bot.hint.user')?></span>
      </div>
    </div>
    <div class="mtb-foot">
      <span id="mtb-msg" class="mtb-hint" style="margin:0"><?=$mtb_h('bot.hint.foot')?></span>
      <span><button type="button" id="mtb-test" class="mtb-ghost"><?=$mtb_h('bot.btn.test')?></button><button type="button" id="mtb-apply"><?=$mtb_h('bot.btn.save')?></button></span>
    </div>
  </div>
</div>
<script>
$(function () {
  // outside every form: Unraid's Apply-disabling does not apply, enable the buttons after Unraid's scripts ran (like the Language block)
  var en = function () { $('#mtb-apply, #mtb-test').prop('disabled', false).removeAttr('disabled'); };
  en(); setTimeout(en, 500);
  var URL = <?=json_encode((string)$mt_bot_post)?>, TOK = <?=json_encode($mtb_tok)?>;
  var TX = <?=json_encode(['wait' => mt_bot_t('bot.wait'), 'fail' => mt_bot_t('bot.fail'), 'saved_ph' => mt_bot_t('bot.ph.saved'), 'ph' => mt_bot_t('bot.ph.token'), 'on' => mt_bot_t('bot.st.on'), 'off' => mt_bot_t('bot.st.off'), 'no_user' => mt_bot_t('bot.st.no_user')], JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP)?>;
  var show = function (ok, t) { $('#mtb-msg').css({ color: ok ? '#3fa24a' : '#e5534b', opacity: 1 }).text(t); };
  var call = function ($b, data, done) {
    $b.prop('disabled', true); $('#mtb-msg').css({ color: '', opacity: .6 }).text(TX.wait);
    $.post(URL, $.extend({ csrf_token: TOK }, data), null, 'json')
      .done(function (r) { show(r.ok, r.ok ? r.msg : (r.error || TX.fail)); if (r.ok && done) { done(r); } })
      .fail(function (x) { show(false, (x.responseJSON && x.responseJSON.error) || TX.fail); })
      .always(function () { $b.prop('disabled', false); });
  };
  $('#mtb-apply').on('click', function () {
    var u = $.trim($('#mtb-user').val());
    call($(this), { op: 'save', token: $.trim($('#mtb-token').val()), user: u }, function (r) {
      $('#mtb-token').val('').attr('placeholder', r.token_set ? TX.saved_ph : TX.ph);
      $('#mtb-token').closest('.mtb-row').toggleClass('on', r.token_set); $('#mtb-user').closest('.mtb-row').toggleClass('on', u !== '');
      $('#mtb-state').text(!r.token_set ? TX.off : (u === '' ? TX.no_user : TX.on));
    });
  });
  $('#mtb-test').on('click', function () { call($(this), { op: 'test' }); });
});
</script>
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/bot_save.php">
<INLINE><![CDATA[<?php
// Saves or tests the shared Discord bot setting (see bot.php). POST op=save (token, user) | test, csrf_token.
require_once __DIR__ . '/bot.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function mt_bot_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra)); exit; }
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); mt_bot_out(false, ['error' => 'method']); }
$var = @parse_ini_file('/var/local/emhttp/var.ini');
$tok = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
// Unraid's own prepend checks the token of every POST and then removes it from $_POST (like lang_save.php)
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); mt_bot_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); mt_bot_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}
$op = (string)($_POST['op'] ?? '');
if ($op === 'save') {
    $e = mt_bot_save((string)($_POST['token'] ?? ''), (string)($_POST['user'] ?? ''));
    if ($e !== '') { mt_bot_out(false, ['error' => mt_bot_t($e)]); }
    $c = mt_bot_cfg();
    mt_bot_out(true, ['msg' => mt_bot_t($c['token'] === '' ? 'bot.saved_off' : 'bot.saved'), 'token_set' => $c['token'] !== '']);
}
if ($op === 'test') {
    $p = basename(__DIR__) === 'qbittorrent_widget' ? 'Seedbox' : ucfirst(basename(__DIR__));
    [$ok, $m] = mt_bot_test($p);
    mt_bot_out($ok, $ok ? ['msg' => $m] : ['error' => $m]);
}
mt_bot_out(false, ['error' => 'op']);
]]></INLINE>
</FILE>

