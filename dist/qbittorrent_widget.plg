          (it.skip === 'hidden' ? '<input type="button" class="stt-uhide stt-btn stt-sm" data-hash="' + it.hash + '" data-on="0" value="' + esc(T('u.show_again')) + '">' : '') + '</td></tr>');
      });
      $o.append($d.append($tb).prop('open', !!wasOpen));
    }
  }
  $(document).on('click', '.stt-utg', function (e) {
    e.preventDefault(); var h = String($(this).data('hash')); UOPEN[h] = !UOPEN[h];
    $(this).html(UOPEN[h] ? '&minus;' : '+').closest('.stt-box').find('.stt-ures').toggle(UOPEN[h]);
  });
  $(document).on('click', '#stt-uforget', function () {
    if (!window.confirm(T('u.forget_confirm', { n: BG.total || 0, h: Math.max(1, Math.round((BG.total || 0) * 1.6 / 60)) }))) { return; }
    var $b = $(this).prop('disabled', true);
    api('upd_forget').done(function (r) { if (!r.ok) { window.alert(r.error); $b.prop('disabled', false); return; } RES = {}; setTimeout(pollUpd, 1500); }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-umore', function () { var g = $(this).data('g'); ULIMG[g] = (ULIMG[g] || 25) + 50; drawUpd(); });
  $(document).on('click', '.stt-gbar:not(.empty)', function () {
    var g = String($(this).data('g')); UGOPEN[g] = !UGOPEN[g];
    $(this).find('.pm').html(UGOPEN[g] ? '&minus;' : '+'); $('#stt-uitems .stt-ugrp[data-g="' + g + '"]').toggle(UGOPEN[g]);
