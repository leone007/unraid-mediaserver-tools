#stt .stt-pbar{height:6px;border-radius:3px;background:rgba(128,128,128,.22);margin:5px 0 2px;overflow:hidden}#stt .stt-pbar i{display:block;height:100%;background:#3d8bd9}#stt .stt-pbar.am i{background:#d9921f}#stt .stt-pbar.gr i{background:#8b8f97}#stt .stt-pbar.ok i{background:#3fa24a}
