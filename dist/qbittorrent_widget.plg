  function folderRoles() { var o = {}; $('#stt-folders .stt-frole').each(function () { o[$(this).closest('.stt-fr').data('n')] = $(this).val(); }); return JSON.stringify(o); }
  function fillCfg(c) {
    cfg = c; var f = $('#stt-form');
    $.each(['prowlarr', 'radarr', 'sonarr', 'lidarr', 'autobrr'], function (i, k) { f.find('[name=' + k + '_url]').val(c[k].url); f.find('[name=' + k + '_key]').val('').attr('placeholder', c[k].key_set ? '(saved, leave empty to keep)' : 'API key'); });
    f.find('[name=map_qb]').val(c.map_qb); f.find('[name=map_host]').val(c.map_host); f.find('[name=dl_base]').val(c.dl_base || ''); drawFolders(c.folder_list || {});
    $.each(['upd_min_gb', 'upd_min_age', 'upd_saving', 'dv_all', 'upd_upg_growth', 'find_tol', 'find_accept', 'repl_max_growth', 'find_missing_files', 'trash_days', 'dc_lang', 'auto_freq', 'auto_day', 'auto_hour'], function (i, k) { f.find('[name=' + k + ']').val(c[k]); });
