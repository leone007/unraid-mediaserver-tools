 },
 "ws.help": {
  "text": "Stalled torrents are ignored: an idle seed that nobody downloads from is normal in qBittorrent. Errors, missing files, paused or stopped and queued torrents are listed under Needs attention; torrents that are moving, checking or allocating appear under In transfer. When the client is firewalled or disconnected, a single connection row is shown.",
  "note": "grey paragraph at the bottom of the page."
 },
