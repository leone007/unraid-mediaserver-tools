  "text": " "
 },
 "tp.hint.0_delete_at_once": {
  "text": "0 = azonnali törlés. A régi mappa a letöltési mappáján belüli <code>.seedbox_trash</code> mappába kerül, és ennyi nap után törlődik"
 },
 "tp.hint.0_no_limit_a": {
  "text": "(0 = nincs korlát). Egy release sosem kisebb felbontású vagy gyengébb HDR-formátumú annál, ami neked van"
 },
 "tp.hint.a_dolby_vision_only": {
  "text": "a csak Dolby Vision release (DV HDR10 nélkül, többnyire webes release-ek) lila-zöld képet ad DV nélküli tévén. Ha nem minden tévé ilyen, az ilyen release sosem upgrade, és meg van jelölve; a DV HDR10-zel (DV+HDR) a legjobb. A váltás után: Shape up, Találatok elfelejtése, keresés újra"
 },
 "tp.hint.a_replacement_may_be": {
  "text": "egy csere legfeljebb ennyivel lehet nagyobb annál, ami neked van (0 = nincs korlát). Az azonos felbontás és HDR-formátum, a méretben legközelebbi jön előre"
 },
 "tp.hint.a_torrent_may_be": {
  "text": "egy torrent ennyivel lehet nagyobb a mappánál (extra fájlok, például .nfo)"
 },
 "tp.hint.after_the_check_a": {
  "text": "az ellenőrzés után az a torrent indul el, amelyik legalább ennyiben egyezik a fájljaiddal; a hiányzó maradékot a qBittorrent letölti (például egy .nfo fájlt). Ez alatt a torrent újra törlődik"
 },
 "tp.hint.every_5_minutes_the": {
  "text": "5 percenként a Sonarrral ellenőrzi azokat a release-eket, amelyeket az autobrr szűrőid átengednek. Egy figyelt évad csomagja, amelynek legalább egy epizódja megvan neked, nem kisebb felbontású (és magyar, ha az epizódjaid azok), a Season repackerben Az autobrr-ből alatt jelenik meg, és Discordon jelentve lesz (ezzel a kapcsolóval akkor is, ha a lenti üzenetek ki vannak kapcsolva). Semmi sem indul el magától"
 },
 "tp.hint.every_folder_directly_inside": {
  "text": "minden benne lévő közvetlen almappa lent látszik egy szereppel. Egy új mappa magától Egyéb szereppel jelenik meg (új jelöléssel): a Find my torrent látja, a Shape up és a Season repacker békén hagyja, amíg meg nem változtatod. Változtatás után ments."
 },
 "tp.hint.if_everything_else_matches": {
  "text": "ha minden más egyezik, és a torrentből legfeljebb ennyi fájl hiányzik a mappádból, a torrent elindul, és a qBittorrent letölti ezeket a fájlokat"
 },
 "tp.hint.off_by_default_replacement": {
  "text": "alapból ki. Csere elindult, importálva, elakadt, régi fájlok eltávolítva."
 },
 "tp.hint.off_by_default_season": {
  "text": "alapból ki. Évadcsomag-csere elindult, kész (az importált és kukába tett fájlokkal) vagy elakadt."
 },
 "tp.hint.off_by_default_the": {
  "text": "alapból ki. A heti ellenőrzés eredménye (a tracker által eltávolított torrentekről mentett webhook esetén mindig jön üzenet), és ami egy cserével történik: elindult, importálva, elakadt, régi fájlok eltávolítva."
 },
 "tp.hint.one_webhook_for_all": {
  "text": "egy webhook minden eszköznek; lent minden eszköznek saját kapcsolója van az üzenetküldéshez. Egy - beírásával törölheted a mentett webhookot"
 },
 "tp.hint.optional_for_the_music": {
  "text": "nem kötelező, a Zene mappákhoz (az eszközök még nem használják)"
 },
 "tp.hint.optional_only_for_the": {
  "text": "nem kötelező, csak a Season repacker évadcsomag-üzeneteihez (autobrr, Settings, API keys)"
 },
 "tp.hint.optional_the_seedbox_message": {
  "text": "opcionális. A Seedbox-üzenet alá a botod 1️⃣ 2️⃣ 3️⃣ 👎 reakciót tesz; egy szám elindítja azt a cserét (ugyanazokkal az ellenőrzésekkel, mint az itteni gomb), a 👎 elveti. Csak a te reakcióid számítanak, 24 óráig; a bot percenként néz rá. A bot token és a felhasználói azonosítód lent, a Discord-bot blokkban van (közös a Sysboxszal). Reakció próbája: koppints egy reakcióra, és egy percen belül zöld lesz az üzenet"
 },
 "tp.hint.relevant_a_season_that": {
  "text": "Releváns: csomagolható évad, futó csomagolás vagy keresés, még sosem volt keresés. A hibás vagy elakadt sor minden módban látszik, kivéve a sosem módot. Ha nem marad sor, a csempe eszközrésze elrejtődik."
 },
 "tp.hint.relevant_an_offer_a": {
  "text": "Releváns: ajánlat, futó keresés vagy háttérkeresés, még sosem volt keresés. A hibás vagy elakadt sor minden módban látszik, kivéve a sosem módot. Ha nem marad sor, a csempe eszközrésze elrejtődik."
 },
 "tp.hint.relevant_something_to_fix": {
  "text": "Releváns: van javítanivaló, futó keresés, még sosem volt keresés. A hibás vagy elakadt sor minden módban látszik, kivéve a sosem módot. Ha nem marad sor, a csempe eszközrésze elrejtődik."
 },
 "tp.hint.tests_the_saved_settings": {
  "text": "a mentett beállításokat teszteli (változtatás után előbb ments): qBittorrent, mappamegfeleltetés, Discord (tesztüzenetet küld), Prowlarr, Radarr, Sonarr, Lidarr, autobrr"
 },
 "tp.hint.the_category_set_in": {
  "text": "a Radarr (filmek) vagy a Sonarr (sorozatok) qBittorrent letöltőkliensében beállított kategória, alapból radarr, illetve sonarr; a Radarrban vagy a Sonarrban a letöltőkliens beállításainál módosíthatod. Az egyik címhez sem illő torrentek azt a kategóriát kapják, amelyik az ugyanabban a mappában lévő torrentek többségéé"
 },
 "tp.hint.the_line_under_the": {
  "text": "a sor az eszköz neve alatt a Dashboard csempén; üresen hagyva az alapértelmezett"
 },
 "tp.hint.the_ticked_tools_scan": {
  "text": "a kipipált eszközök abban az időpontban egymás után keresnek. Magától csak keresés fut, semmi sem kerül hozzáadásra, cserére vagy törlésre a kattintásod nélkül. A tracker által eltávolított torrenteket Discordon jelenti (ha van mentett webhook, akkor is, ha a többi üzenet ki van kapcsolva), és a Seedbox csempén <i>figyelmet igényel</i> jelölést kapnak"
 },
 "tp.hint.tick_the_filters_whose": {
  "text": "pipáld ki a szűrőket, amelyek release-eit ellenőrizze; ha egy sincs kipipálva, mind. Utána Mentés"
 },
 "tp.hint.titles_at_least_this": {
  "text": "az ennél nem kisebb és nem fiatalabb címek listázódnak, és a háttérben keresi őket; egy release akkor számít megtakarításnak, ha legalább ennyivel kisebb"
 },
