    f.find('[name=ab_filters]').val((c.ab_filters || []).join('\n')); drawAbf(null);
    f.find('[name=dc_hook]').val('').attr('placeholder', c.dc_hook_set ? '(saved, leave empty to keep)' : 'https://discord.com/api/webhooks/...');
    f.find('[name=bot_token]').val('').attr('placeholder', c.bot_token_set ? '(saved, leave empty to keep)' : 'bot token'); f.find('[name=bot_user]').val(c.bot_user || '');
    $.each(['bot_rep', 'bot_find'], function (i, k) { f.find('[name=' + k + ']').prop('checked', !!+c[k]); });
