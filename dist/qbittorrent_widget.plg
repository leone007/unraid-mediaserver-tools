    else if (BG.done < BG.total) { h += ' <input type="button" class="stt-btn stt-sm" id="stt-ubggo" value="Search the rest">'; }
    if (BG.done > 0) { h += ' <input type="button" class="stt-btn stt-sm stt-ghost" id="stt-uforget" value="Forget results, search again" title="Forget every search result of this list and search all torrents again in the background (for example after you changed the saving, the offers or the size limit)">'; }
    $('#stt-ubg').html(h);
