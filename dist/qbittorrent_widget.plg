 "tp.dt.widget_tagline": {
  "text": "Widget tagline:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "tp.dt.x": {
  "text": " ",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "tp.hint.0_delete_at_once": {
  "text": "0 = delete at once. The old folder is moved to <code>.seedbox_trash</code> inside its downloads folder and deleted after this many days",
  "note": "grey hint next to or under a setting. May contain simple HTML tags: keep them."
 },
 "tp.hint.0_no_limit_a": {
  "text": "(0 = no limit). A release is never of a lower resolution or HDR format than what you have",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.a_dolby_vision_only": {
  "text": "a Dolby Vision only release (DV without HDR10, mostly web releases) gives a purple and green picture on a TV without DV. With not every TV, such a release is never an upgrade and is marked; DV with HDR10 (DV+HDR) is the best. Changing it: Shape up, Forget results, search again",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.a_replacement_may_be": {
  "text": "a replacement may be at most this much bigger than what you have (0 = no limit). The same resolution and HDR format, closest in size, come first",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.a_torrent_may_be": {
  "text": "a torrent may be this much bigger than the folder (extra files such as .nfo)",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.after_the_check_a": {
  "text": "after the check, a torrent that matches at least this much of your files is started; qBittorrent downloads the missing rest (for example an .nfo file). Below it the torrent is removed again",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.every_5_minutes_the": {
  "text": "every 5 minutes the releases that your autobrr filters let through are checked with Sonarr. A season pack of a monitored season that you have at least one episode of, not of a lower resolution (and Hungarian if your episodes are), is listed in the Season repacker under From autobrr and reported on Discord (with this switch, even when the messages below are off). Nothing is started",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.every_folder_directly_inside": {
  "text": "every folder directly inside it is listed below with a role. A new folder shows up by itself as Other (marked new): Find my torrent sees it, Shape up and the Season repacker leave it alone until you change it. Save after a change.",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.if_everything_else_matches": {
  "text": "if everything else matches and at most this many files of the torrent are missing from your folder, the torrent is started and qBittorrent downloads those files",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.off_by_default_replacement": {
  "text": "off by default. Replacement started, imported, stuck, old files removed.",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.off_by_default_season": {
  "text": "off by default. Season pack replacement started, done (with what was imported and trashed) or stuck.",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.off_by_default_the": {
  "text": "off by default. The weekly check result (torrents removed by a tracker are always reported when a webhook is saved), and what happens to a replacement: started, imported, stuck, old files removed.",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.one_webhook_for_all": {
  "text": "one webhook for all tools; each tool below has its own switch for sending messages. Type - to remove the saved webhook",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.optional_for_the_music": {
  "text": "optional, for the Music folders (not used by the tools yet)",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.optional_only_for_the": {
  "text": "optional, only for the season pack messages of the Season repacker (autobrr, Settings, API keys)",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.optional_the_seedbox_message": {
  "text": "optional. The Seedbox message gets 1️⃣ 2️⃣ 3️⃣ 👎 reactions from your bot; a number starts that replacement (with the same checks as the button here), 👎 dismisses it. Only your reactions count, for 24 hours; the bot looks once a minute. The bot token and your user ID are in the Discord bot block below (shared with Sysbox). Try a reaction: tap a reaction and the message turns green within a minute",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.relevant_a_season_that": {
  "text": "Relevant: a season that can be repacked, a repack or a scan running, never scanned. A failed or stuck row shows in every mode but never. When no row is left, the tools part of the tile is hidden.",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.relevant_an_offer_a": {
  "text": "Relevant: an offer, a scan or the background search running, never scanned. A failed or stuck row shows in every mode but never. When no row is left, the tools part of the tile is hidden.",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.relevant_something_to_fix": {
  "text": "Relevant: something to fix, a scan running, never scanned. A failed or stuck row shows in every mode but never. When no row is left, the tools part of the tile is hidden.",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.tests_the_saved_settings": {
  "text": "tests the saved settings (Save first after a change): qBittorrent, the folder mapping, Discord (sends a test message), Prowlarr, Radarr, Sonarr, Lidarr, autobrr",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.the_category_set_in": {
  "text": "the category set in the qBittorrent download client of Radarr (movies) or Sonarr (series), by default it is radarr and sonarr respectively, you can change it in your Radarr or Sonarr instance under the download client setting. Torrents that match nothing will get the category most torrents in the same folder have",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.the_line_under_the": {
  "text": "the line under the tool name on the Dashboard tile; leave empty for the default",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.the_ticked_tools_scan": {
  "text": "the ticked tools scan one after the other at that time. Only scans run by themselves, nothing is added, replaced or deleted without your click. Torrents that a tracker removed are reported on Discord (if a webhook is saved, even when the other messages are off) and flagged in the Seedbox tile as <i>need attention</i>",
  "note": "grey hint next to or under a setting. May contain simple HTML tags: keep them."
 },
 "tp.hint.tick_the_filters_whose": {
  "text": "tick the filters whose releases are checked; none ticked = all filters. Then Save",
  "note": "grey hint next to or under a setting."
 },
 "tp.hint.titles_at_least_this": {
  "text": "titles at least this big and old are listed and searched in the background; a release counts as a saving if it is at least this much smaller",
  "note": "grey hint next to or under a setting."
 },
