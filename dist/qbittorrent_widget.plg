    }).fail(function (x) { $('#stt-tests').text(err(x)); }).always(function () { $b.prop('disabled', false); });
  });

  // a release that is smaller and better at the same time (Shape up, Must do), within the ticked offer kinds
  function hdrLbl(n) { return ((cfg && +cfg.dv_all) ? {1: 'SDR', 2: 'HDR', 3: 'DV', 4: 'DV+HDR'} : {0: 'DV only', 1: 'SDR', 2: 'HDR', 3: 'DV+HDR'})[n] || ''; }
  function hdrTxt(h) { return h === 'DV only' ? '<span class="stt-badge rd" title="Dolby Vision without an HDR10 base layer: a purple and green picture on a TV without DV" style="margin-left:0">DV only</span>' : esc(h); }
  function mustSorted(rows) { return $.grep(rows, mustRow).sort(function (a, b) { return a.size - b.size; }); } // the smallest (the biggest saving) first
  function mustRow(r) { var c = r.cats || []; return UCAT.save && c.indexOf('save') >= 0 && ((UCAT.hdr && c.indexOf('hdr') >= 0) || (UCAT.res && c.indexOf('res') >= 0)); }
  function resBlock(key, label, mode, it, mustFirst) {
    var rr = RES[key], h = '';
    if (!rr) { return ''; }
    if (rr.state === 'running') { return '<div class="stt-mut">Searching in Radarr/Sonarr... this can take a minute.</div>'; }
    if (rr.state === 'error') { return '<div class="stt-er">' + esc(rr.msg) + '</div>'; }
    if (!rr.rows.length) { return '<div class="stt-mut">' + esc(rr.msg) + '</div>'; }
    h = '<table class="stt"><thead><tr><th>Release</th><th class="stt-r">Size</th><th class="stt-r">Size vs. current</th><th>Quality</th><th class="stt-r">Seeders</th><th>Indexer</th><th></th></tr></thead><tbody>';
    var rows = rr.rows;
    if (mustFirst) { rows = mustSorted(rr.rows).concat($.grep(rr.rows, function (r) { return !mustRow(r); })); } // the must releases first, the smallest (biggest saving) on top
    $.each(rows, function (j, r) {
      var sv = r.saving > 0 ? '-' + r.saving + '%' : '+' + Math.abs(r.saving) + '%', mu = mustFirst && mustRow(r);
      h += '<tr' + (mu ? ' class="stt-must"' : '') + '><td>' + (mu ? '<span class="stt-badge gold" style="margin:0 6px 0 0">must</span>' : '') + esc(r.title) + (r.hun ? '<span class="stt-badge g">HUN</span>' : '') + $.map(r.cats || [], function (c) { return '<span class="stt-badge">' + CATL[c] + '</span>'; }).join('') + (r.rejected ? '<div class="stt-am">' + esc(r.rejections.join(' / ') || 'rejected') + '</div>' : '') + '</td><td class="stt-r">' + fb(r.size) + '</td><td class="stt-r">' + sv + '</td><td>' + r.res + 'p ' + hdrTxt(r.hdr) + '</td><td class="stt-r">' + r.seeders + '</td><td>' + esc(r.indexer) + '</td><td><input type="button" class="stt-grab stt-btn" data-key="' + key + '" data-mode="' + mode + '" data-guid="' + esc(r.guid) + '" value="' + label + '"></td></tr>';
    });
    return h + '</tbody></table>';
  }

  function drawQueue(r) {
    var n = 0, f = r.find || {}; $.each(f.items || [], function (i, it) { if (!it.busy && !it.fail && it.searched) { var g = false; $.each(it.cands || [], function (j, c) { if (c.name_eq && c.size_ok) { g = true; } }); if (g) { n++; } } });
    var h = '';
    if (!(r.queue > 0) && n > 0) { h += '<input type="button" id="stt-qall" class="stt-btn" value="Add all matching (' + n + ')"> <span class="stt-mut">adds every folder that has an identical torrent, one check at a time</span>'; }
    $('#stt-queue').html(h);
    LAST.q = r.queue || 0; drawActivity();
  }
  $(document).on('click', '#stt-qall', function () {
    if (!window.confirm('Add every listed torrent that has the same name and size as your folder?\n\nThey are added one after the other, with one file check at a time. Each is started only if it matches your files (see the settings); otherwise it is removed again and your files stay untouched. You can stop the queue at any time.')) { return; }
    var $b = $(this).prop('disabled', true);
    api('find_queue_all').done(function (r) { setTimeout(pollFind, 1500); }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '#stt-qstop', function () { $(this).prop('disabled', true); api('find_queue_stop').done(function () { pollFind(); }); });

  $(document).on('click', 'th.stt-so', function () { var k = $(this).data('k'); SORT = SORT.k === k ? {k: k, d: -SORT.d} : {k: k, d: k === 'name' ? 1 : -1}; if (LASTF) { drawFind(LASTF); } });
  // ---- find my torrent: one table, one group of rows per folder ----
  var SORT = {k: 'size', d: -1}, LASTF = null;
  function drawFind(f) {
    LASTF = f;
    var $o = $('#stt-fitems').empty();
    if (!f || f.state === 'none') { return; }
    if (f.state === 'error') { $('#stt-fmsg').css('color', '#e5534b').text(f.msg); return; }
    if (f.state === 'running') { $('#stt-fmsg').css('color', '').text(f.msg || 'Working...'); } else { $('#stt-fmsg').css('color', '').text(''); }
    var nf = (f.items || []).length;
    $('#stt-n-find').text(f.state === 'ready' ? nf : ''); $('#stt-fband').text(f.t ? 'scanned ' + ago(f.t) + ' ago' + (f.state === 'ready' ? ' \u00b7 ' + nf + ' folder' + (nf === 1 ? '' : 's') + ' not seeded' : '') : '');
    if (!nf) { if (f.state === 'ready') { $o.append('<p class="stt-ok" style="margin:0;padding:10px 12px">Every file in the downloads folders is seeded.</p>'); } return; }
    var LB = {name: 'Folder / release', size: 'Size', seeders: 'Seeders'};
    function sa(k) { return LB[k] + (SORT.k === k ? (SORT.d > 0 ? ' &#9650;' : ' &#9660;') : ''); }
    var h = '<table class="stt stt-fx"><colgroup><col><col style="width:78px"><col style="width:64px"><col style="width:110px"><col style="width:130px"><col style="width:270px"></colgroup>' +
            '<thead><tr><th class="stt-so" data-k="name">' + sa('name') + '</th><th class="stt-so stt-r" data-k="size">' + sa('size') + '</th><th class="stt-so stt-r" data-k="seeders">' + sa('seeders') + '</th><th>Indexer</th><th>Match / quality</th><th></th></tr></thead>';
    // matches first (green, then amber), then name-only, then what has no torrent and needs a replacement
    var G = {4: 'In progress', 3: 'Same name and size: add the torrent', 2.7: 'The tracker rejects the passkey: update the tracker URL in qBittorrent', 2.5: 'Removed from the tracker: replace the content', 2: 'Different release, similar size: replace the content', 1: 'Only the name is similar: replace the content', 0: 'No torrent found: replace the content'}, lastG = -1, catNo = 0;
    function grade(it) { if (it.busy) { return 4; } var g = it.searched ? 0 : -1; $.each(it.cands || [], function (j, c) { g = Math.max(g, c.name_eq && c.size_ok ? 3 : c.size_ok ? 2 : 1); }); if (it.pass && it.searched) { g = 2.7; } else if (it.old && g >= 0 && g < 3) { g = 2.5; } return g; }
    var list = $.map($.grep(f.items, function (it) { return !it.busy; }), function (it, i) { return {it: it, g: grade(it), i: i}; }).sort(function (x, y) {
      if (y.g !== x.g) { return y.g - x.g; }
      function v(e) { var it = e.it; if (SORT.k === 'name') { return (it.name || '').toLowerCase(); } if (SORT.k === 'seeders') { var m = -1; $.each(it.cands || [], function (j, c) { if (c.name_eq && c.size_ok) { m = Math.max(m, +c.seeders || 0); } }); return m; } return +it.size || 0; }
      var a = v(x), b = v(y); if (a < b) { return -SORT.d; } if (a > b) { return SORT.d; } return x.i - y.i;
    });
    // the categories are always shown, folded when the page loads (GOPEN keeps what you opened while the page is open);
    // the passkey and the waiting rows only when there are some
    var ORD = [3, 2.7, 2.5, 2, 1, 0, -1], cntG = {}, done = {}, inBody = false;
    $.each(list, function (x, y) { cntG[y.g] = (cntG[y.g] || 0) + 1; });
    function head(g) {
      var cnt = cntG[g] || 0, op = !!GOPEN[g] && cnt > 0;
      if (inBody) { h += '</tbody>'; inBody = false; }
      h += '<tbody><tr class="stt-gh"><td colspan="6"><div class="stt-gb ' + (g === 2.5 ? 'gd' : g === 2.7 ? 'gp' : 'g' + g) + (cnt ? ' stt-gtg" data-g="' + g + '" title="Show or hide this category" style="cursor:pointer' : '" style="opacity:.55') + '"><span>' + (cnt ? '<span style="display:inline-block;width:16px">' + (op ? '&minus;' : '+') + '</span>' : '<span style="display:inline-block;width:16px"></span>') + esc(g < 0 ? 'Waiting for the search...' : (++catNo) + '. ' + G[g]) + '</span><small>' + cnt + ' folder' + (cnt === 1 ? '' : 's') + (cnt ? (g === 3 ? ' &middot; Add torrent' : g === 2.7 ? ' &middot; fix in qBittorrent' : g >= 0 ? ' &middot; Replace' : '') : '') + '</small></div></td></tr></tbody>';
      if (cnt) { h += '<tbody class="stt-gbody" data-g="' + g + '"' + (op ? '' : ' style="display:none"') + '>'; inBody = true; }
    }
    function heads(upto) { $.each(ORD, function (i, g) { if (done[g] || (upto !== null && g < upto)) { return; } if (g === upto || cntG[g] || [3, 2.5, 2, 1, 0].indexOf(g) >= 0) { done[g] = 1; head(g); } }); }
    $.each(list, function (n, e) {
      var it = e.it, rrf = RES[it.key], seen = {}, rows = '', note = '';
      if (e.g !== lastG) { lastG = e.g; heads(e.g); }
      if (it.busy) { h += '<tr class="stt-grp"><td class="stt-ell" title="' + esc(it.name) + '"><b>' + esc(it.name) + '</b><span class="stt-mut"> ' + esc(it.root) + '</span></td><td class="stt-r">' + fb(it.size) + '</td><td colspan="4" class="stt-ok">' + esc(it.busy) + '</td></tr>'; return; }
      var gi = -1; $.each(it.cands || [], function (j, c) { if (gi < 0 && c.name_eq && c.size_ok) { gi = j; } });
      var gc = gi >= 0 ? it.cands[gi] : null, one = !it.error && it.searched && !it.fail && gc;
      h += '<tr class="stt-grp"><td class="stt-ell" title="' + esc(it.root + ' / ' + it.name) + '">' + (rrf && rrf.state !== 'running' ? '<a href="#" class="stt-tg" data-key="' + it.key + '" title="Show or hide the search results" style="display:inline-block;width:16px;text-align:center;text-decoration:none">' + (COLL[it.key] !== false ? '+' : '&minus;') + '</a> ' : '') + '<b>' + esc(it.name) + '</b><span class="stt-mut"> ' + esc(it.root) + '</span>' + (it.pass ? ' <span class="stt-badge a" title="The tracker answers unregistered torrent pass: the passkey in the announce URL is not valid (changed or reset), the torrent itself is probably still there">passkey rejected</span>' : it.old ? ' <span class="stt-badge rd" title="The tracker no longer knows this torrent">removed from tracker</span>' : '') + '</td><td class="stt-r">' + fb(it.size) + '</td>';
      if (one) { h += '<td class="stt-r">' + gc.seeders + '</td><td class="stt-ell">' + esc(gc.indexer) + '</td><td><span class="stt-badge g">found original</span></td>'; }
      else {
        h += '<td colspan="3">';
        if (it.pass) { h += '<span class="stt-am">the tracker rejects the torrent pass: update the tracker URL in qBittorrent</span>'; }
        else if (it.error) { h += '<span class="stt-er">' + esc(it.error) + '</span>'; }
        else if (!it.searched) { h += '<span class="stt-mut">waiting for the search...</span>'; }
        else if (it.fail) { h += '<span class="stt-am stt-ell" style="display:block" title="' + esc(it.fail) + '">last try failed, see below</span>'; }
        else { h += '<span class="stt-am">' + (e.g === 2.5 ? 'the tracker removed this torrent' : e.g > 0 ? 'no identical torrent' : 'no torrent found') + ': replace the content instead &rarr;</span>'; }
        h += '</td>';
      }
      h += '<td class="stt-r">';
      if (one) { h += '<input type="button" class="stt-add stt-btn stt-sm" data-id="' + it.id + '" data-idx="' + gi + '" title="' + esc(gc.title) + '" value="Add torrent">'; }
      if (it.searched && !it.pass && inLib(it.root)) { h += '<input type="button" class="stt-rsearch stt-btn stt-sm" data-id="' + it.id + '" data-key="' + it.key + '" title="Search an equal or better release in Radarr/Sonarr; the old files are removed after the new one is imported" value="' + (rrf ? 'Replace again' : 'Replace...') + '"' + (rrf && rrf.state === 'running' ? ' disabled' : '') + '>'; }
      h += '<input type="button" class="stt-ign stt-btn stt-sm stt-ghost" data-id="' + it.id + '" value="Ignore"> <input type="button" class="stt-del stt-btn stt-sm" data-id="' + it.id + '" value="Delete" title="Move the folder to the trash (or delete it at once when the trash days are 0)">';
      h += '</td></tr>';
      if (!one && !it.error && it.searched && it.fail) { h += '<tr class="stt-sub"><td colspan="6" class="stt-am" style="white-space:normal">&#8627; last try failed: ' + esc(it.fail) + '</td></tr>'; }
      var hid = rrf && COLL[it.key] !== false && rrf.state !== 'running' ? ' style="display:none"' : '';
      if (rrf) {
        if (rrf.state === 'running') { h += '<tr class="stt-sub stt-rs"' + hid + '><td colspan="6" class="stt-mut">&#8627; searching in Radarr/Sonarr... this can take a minute</td></tr>'; }
        else if (rrf.state === 'error') { h += '<tr class="stt-sub stt-rs"' + hid + '><td colspan="6" class="stt-er">&#8627; ' + esc(rrf.msg) + '</td></tr>'; }
        else if (!(rrf.rows || []).length) { h += '<tr class="stt-sub stt-rs"' + hid + '><td colspan="6" class="stt-mut">&#8627; ' + esc(rrf.msg || 'no equal or better release with seeders found') + '</td></tr>'; }
        else { if (rrf.info) { h += '<tr class="stt-sub stt-rs"' + hid + '><td colspan="6" class="stt-mut">&#8627; ' + esc(rrf.info) + '</td></tr>'; }
          $.each(rrf.rows, function (j, r) {
