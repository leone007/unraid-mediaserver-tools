  function drawUpd() {
    var u = UPD, wasOpen = $('#stt-uitems details.stt-uskip').prop('open'), restOpen = $('#stt-uitems details.stt-urest').prop('open'), $o = $('#stt-uitems').empty();
    drawBg();
