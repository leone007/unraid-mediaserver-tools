      if (it.searched && !it.pass && inLib(it.root)) { h += '<input type="button" class="stt-rsearch stt-btn stt-sm" data-id="' + it.id + '" data-key="' + it.key + '" title="' + esc(T('f.replace_tip')) + '" value="' + esc(rrf ? T('f.replace_again') : T('f.replace')) + '"' + (rrf && rrf.state === 'running' ? ' disabled' : '') + '>'; }
      h += '<input type="button" class="stt-ign stt-btn stt-sm stt-ghost" data-id="' + it.id + '" value="' + esc(T('f.ignore')) + '"> <input type="button" class="stt-del stt-btn stt-sm" data-id="' + it.id + '" value="' + esc(T('f.delete')) + '" title="' + esc(T('f.delete_tip')) + '">';
      h += '</td></tr>';
