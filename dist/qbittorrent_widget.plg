      var done = {done: 1, failed: 1}[j.stage], c = j.dismissed ? 'stt-mut' : j.cancelled ? 'stt-am' : ({done: 'stt-ok', blocked: 'stt-am', failed: 'stt-er'}[j.stage] || '');
      // Cancel (item 87): only while the pack downloads, before any old file is touched
      var cx = {grabbed: 1, downloading: 1}[j.stage] ? '<input type="button" class="stt-spcx stt-btn stt-sm stt-ghost" data-id="' + esc(j.id) + '" data-n="' + spName(j) + '" value="' + esc(T('act.cancel')) + '" title="' + esc(T('act.cancel_tip')) + '">' : '';
