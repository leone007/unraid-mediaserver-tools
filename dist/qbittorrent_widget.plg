<?php $mt_bot_post = '/plugins/qbittorrent_widget/bot_save.php'; include '/usr/local/emhttp/plugins/qbittorrent_widget/bot_block.php'; ?>
<?php $mt_lang_post = '/plugins/qbittorrent_widget/lang_save.php'; include '/usr/local/emhttp/plugins/qbittorrent_widget/lang_block.php'; ?>

</div>

<?=mt_i18n_js($tp_lang, 'tp')?>
<script>
$(function () {
  var T = function (k, v) { return MTL.t('tp', k, v); };
  var lastSig = '', URL_ = '/plugins/qbittorrent_widget/tools.php', cfg = null, fT = null, uT = null, resT = {}, UPD = null, RES = {};
  function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html().replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }   // quotes too: esc() also fills attributes
  function fb(b) { b = +b; if (b >= 1e12) return (b / 1e12).toFixed(2) + ' TB'; if (b >= 1e9) return (b / 1e9).toFixed(b >= 1e11 ? 0 : 1) + ' GB'; return (b / 1e6).toFixed(0) + ' MB'; }
  function api(op, d) { return $.post(URL_, $.extend({op: op}, d || {}), null, 'json'); }
  function err(x) { return (x && x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : (x && x.error) ? x.error : 'HTTP ' + (x && x.status); }
  function ago(t) { var s = Math.max(0, Math.floor(Date.now() / 1000) - t); return s >= 86400 ? T('ago.d', { n: Math.floor(s / 86400) }) : s >= 3600 ? T('ago.hs', { n: Math.floor(s / 3600) }) : T('ago.m', { n: Math.max(1, Math.floor(s / 60)) }); }

  // folder roles (Movies, Series, Music: the media library; Other: only Find my torrent; Not watched)
  var ROLES = [['movies', T('fo.movies'), 's-green'], ['series', T('fo.series'), 's-blue'], ['music', T('fo.music'), 's-purple'], ['other', T('fo.other'), 's-grey'], ['off', T('fo.off'), 's-off']];
  var RNOTE = {movies: esc(T('fo.n_movies')), series: esc(T('fo.n_series')), music: esc(T('fo.n_music')), other: esc(T('fo.n_other')), off: esc(T('fo.n_off'))};
  function roleTools(r) { return [r !== 'off', r === 'movies' || r === 'series', r === 'series']; }
  function folderRow(n, f) {
    var o = ''; $.each(ROLES, function (i, x) { o += '<option value="' + x[0] + '"' + (x[0] === f.role ? ' selected' : '') + '>' + esc(x[1]) + '</option>'; });
    return '<div class="stt-fr" data-n="' + esc(n) + '"><span><b>' + esc(n) + '</b>' + (f['new'] ? '<span class="stt-badge a">' + esc(T('fo.new')) + '</span>' : '') + '<small class="stt-fnote"></small></span><span><select class="stt-frole" aria-label="' + esc(T('fo.role_of', { n: n })) + '">' + o + '</select></span><span class="stt-ft"></span><span class="stt-ft"></span><span class="stt-ft"></span></div>';
  }
  function folderPaint() {
    var w = 0, lib = 0, nw = $('#stt-folders .stt-badge').length;
    $('#stt-folders .stt-fr[data-n]').each(function () {
      var r = $(this).find('.stt-frole').val(), t = roleTools(r), cls = $.grep(ROLES, function (x) { return x[0] === r; })[0][2];
      $(this).removeClass('s-green s-blue s-purple s-grey s-off s-amber').addClass($(this).find('.stt-badge').length ? 's-amber' : cls);
      $(this).find('.stt-fnote').html(RNOTE[r]);
      $(this).find('.stt-ft').each(function (i) { $(this).toggleClass('y', t[i]).html(t[i] ? '&#10003;' : '&ndash;'); });
      if (r !== 'off') { w++; } if (r === 'movies' || r === 'series' || r === 'music') { lib++; }
    });
    $('#stt-foldband').text(T('fo.band', { w: w, l: lib }) + (nw ? ' · ' + T('fo.n_new', { n: nw }) : ''));
  }
  function drawFolders(list) {
    var h = '<div class="stt-fr stt-fh"><span>' + esc(T('fo.col_folder')) + '</span><span>' + esc(T('fo.col_role')) + '</span><span>Find my torrent</span><span>Shape up</span><span>Season repacker</span></div>', n = 0;
    // most tools first: Series, Movies, Music, Other, Not watched; by name inside a role (sorted when drawn, not while you change a role)
    var RK = {series: 0, movies: 1, music: 2, other: 3, off: 4};
    $.each(Object.keys(list).sort(function (a, b) { return (RK[list[a].role] - RK[list[b].role]) || a.localeCompare(b, undefined, {sensitivity: 'base', numeric: true}); }), function (i, k) { h += folderRow(k, list[k]); n++; });
    if (!n) { h += '<div class="stt-fr"><span class="stt-mut">' + esc(T('fo.none')) + '</span></div>'; }
    $('#stt-folders').html(h); folderPaint();
  }
  $(document).on('change', '.stt-frole', function () { $(this).closest('.stt-fr').find('.stt-badge').remove(); folderPaint(); });
  $(document).on('click', '#stt-fread', function () {
    var $b = $(this).prop('disabled', true);
    api('folders', {dl_base: $('#stt-form [name=dl_base]').val()}).done(function (r) { if (r.ok) { drawFolders(r.folder_list || {}); } else { window.alert(r.error); } })
      .fail(function (x) { window.alert(err(x)); }).always(function () { $b.prop('disabled', false); });
  });
  // Replace (through Radarr / Sonarr) only for folders of the movies and series library; an Other folder (ratio torrents) is only reported
  function inLib(root) { var f = cfg && cfg.folder_list ? cfg.folder_list[root] : null; return !f || f.role === 'movies' || f.role === 'series'; }
  function folderRoles() { var o = {}; $('#stt-folders .stt-frole').each(function () { o[$(this).closest('.stt-fr').data('n')] = $(this).val(); }); return JSON.stringify(o); }
  function fillCfg(c) {
    cfg = c; var f = $('#stt-form');
    $.each(['prowlarr', 'radarr', 'sonarr', 'lidarr', 'autobrr'], function (i, k) { f.find('[name=' + k + '_url]').val(c[k].url); f.find('[name=' + k + '_key]').val('').attr('placeholder', c[k].key_set ? T('cfg.saved_keep') : T('tp.ph.api_key')); });
    f.find('[name=map_qb]').val(c.map_qb); f.find('[name=map_host]').val(c.map_host); f.find('[name=dl_base]').val(c.dl_base || ''); drawFolders(c.folder_list || {});
    $.each(['upd_min_gb', 'upd_min_age', 'upd_saving', 'dv_all', 'upd_upg_growth', 'find_tol', 'find_accept', 'repl_max_growth', 'find_missing_files', 'trash_days', 'dc_lang', 'auto_freq', 'auto_day', 'auto_hour'], function (i, k) { f.find('[name=' + k + ']').val(c[k]); });
    $.each(['tag_find', 'tag_upd', 'tag_rep'], function (i, k) { f.find('[name=' + k + ']').val(c[k] || ''); });
    $.each(['find', 'upd', 'rep'], function (i, k) { f.find('[name=show_' + k + ']').val(c['show_' + k] || 'relevant'); f.find('[name=show_' + k + '_days]').val(c['show_' + k + '_days'] || 3); });
    showDays();
    $.each(['dc_find', 'dc_upd', 'dc_rep'], function (i, k) { f.find('[name=' + k + ']').prop('checked', !!+c[k]); }); f.find('[name=find_cat]').prop('checked', !!+c.find_cat); $.each(['auto_scan', 'auto_upd', 'auto_rep', 'ab_on', 'upd_cat_save', 'upd_cat_hdr', 'upd_cat_res'], function (i, k) { f.find('[name=' + k + ']').prop('checked', !!+c[k]); });
    f.find('[name=ab_filters]').val((c.ab_filters || []).join('\n')); drawAbf(null);
    f.find('[name=dc_hook]').val('').attr('placeholder', c.dc_hook_set ? T('cfg.saved_keep') : 'https://discord.com/api/webhooks/...');
    $.each(['bot_rep', 'bot_find'], function (i, k) { f.find('[name=' + k + ']').prop('checked', !!+c[k]); });
  }
  $('#stt-bottest').on('click', function () {
    var $b = $(this).prop('disabled', true); $('#stt-botmsg').css('color', '').text(T('cfg.sending'));
    api('bot_test').done(function (r) { $('#stt-botmsg').css('color', r.ok ? '#3fa24a' : '#e5534b').text(r.ok ? T('cfg.bot_ok', { m: r.msg }) : r.error); })
      .fail(function (x) { $('#stt-botmsg').css('color', '#e5534b').text(err(x)); }).always(function () { $b.prop('disabled', false); });
  });
  // the filter list: from autobrr after Load filters, else the saved names
  function drawAbf(list) {
    var $h = $('#stt-form [name=ab_filters]'), sel = $h.val() ? $h.val().split('\n') : [], h = '';
    if (!list) { $('#stt-abf').text(sel.length ? T('ab.using', { l: sel.join(', ') }) : T('ab.using_all')); return; }
    if (!list.length) { $('#stt-abf').text(T('ab.no_filters')); return; }
    $.each(list, function (i, x) { h += ' <label style="margin-right:10px"><input type="checkbox" class="stt-abf-cb" value="' + esc(x.name).replace(/"/g, '&quot;') + '"' + (sel.indexOf(x.name) >= 0 ? ' checked' : '') + '> ' + esc(x.name) + (x.enabled ? '' : ' <i>(' + esc(T('ab.disabled')) + ')</i>') + '</label>'; });
    $.each(sel, function (i, n) { if (!list.some(function (x) { return x.name === n; })) { h += ' <label style="margin-right:10px"><input type="checkbox" class="stt-abf-cb" value="' + esc(n).replace(/"/g, '&quot;') + '" checked> ' + esc(n) + ' <i>(' + esc(T('ab.gone')) + ')</i></label>'; } });
    $('#stt-abf').html(h);
  }
  $(document).on('change', '.stt-abf-cb', function () { $('#stt-form [name=ab_filters]').val($('.stt-abf-cb:checked').map(function () { return this.value; }).get().join('\n')); });
  $('#stt-abf-load').on('click', function () {
    var $b = $(this).prop('disabled', true), f = $('#stt-form'); $('#stt-abf').css('color', '').text(T('cfg.loading'));
    api('ab_filters', {url: f.find('[name=autobrr_url]').val(), key: f.find('[name=autobrr_key]').val()}).done(function (r) {
      if (r.ok) { drawAbf(r.filters); } else { $('#stt-abf').css('color', '#e5534b').text(r.error); }
    }).fail(function (x) { $('#stt-abf').text(err(x)); }).always(function () { $b.prop('disabled', false); });
  });
  function drawAb(a) {
    var h = '';
    if (a.t) { h += esc(T('ab.last_check', { t: ago(a.t) })) + (a.skipped ? ', ' + esc(T('ab.skipped', { n: a.skipped })) : '') + (a.since ? ', ' + esc(T('ab.since', { t: new Date(a.since * 1000).toLocaleString() })) : '') + (a.err ? ' &middot; <span style="color:#e5534b">' + esc(a.err) + '</span>' : ''); }
    $.each((a.recent || []).slice(-5).reverse(), function (i, x) { h += '<br>' + esc(T('ab.ago', { t: ago(x.t) })) + ': ' + (x.go ? '<b>' : '') + esc(x.why) + (x.go ? '</b>' : '') + ' <span style="opacity:.7">' + esc(x.name) + '</span>'; });
    $('#stt-ab').html(h);
    $('#stt-rband').text(a.t ? T('ab.band', { t: ago(a.t) }) : '');
    var r0 = (a.recent || []).slice(-1)[0];
    $('#stt-abst').html(a.t ? '<span class="stt-mut">autobrr</span> ' + (a.err ? '<span class="stt-er">' + esc(a.err) + '</span>' : esc(a.skipped ? T('ab.skipped', { n: a.skipped }) : T('ab.watching'))) + (r0 ? ' &middot; <span class="stt-mut">' + esc(T('ab.last')) + '</span> ' + esc(r0.why) : '') : '');
  }
  function loadState() {
    return api('state').done(function (r) {
      fillCfg(r.cfg); if (r.packjobs) { SPJ = r.packjobs; } LAST.dl = r.dl; drawPending(r.pending); drawJobs(r.jobs); drawAb(r.ab || {});
      if (r.find_running) { pollFind(); }
      if (r.upd_running) { pollUpd(); }
    });
  }
  $('#stt-save').on('click', function () {
    var $b = $(this).prop('disabled', true), $m = $('#stt-cmsg').css('color', '').text(T('cfg.saving'));
    api('saveconfig', $.extend($('#stt-form').serializeArray().reduce(function (o, x) { o[x.name] = x.value; return o; }, {}), {folders: folderRoles()})).done(function (r) {
      if (r.ok) { $m.css('color', '#3fa24a').text(T('cfg.saved')); loadState(); } else { $m.css('color', '#e5534b').text(r.error); }
    }).fail(function (x) { $m.css('color', '#e5534b').text(err(x)); }).always(function () { $b.prop('disabled', false); });
  });
  // the trash: what it holds, and the button that empties it now (with a confirm)
  function trashInfo(r) { $('#stt-trinfo').text(r && r.items ? '(' + T('tr.items', { n: r.items, s: fb(r.bytes) }) + ')' : '(' + T('tr.empty') + ')'); $('#stt-trempty').prop('disabled', !(r && r.items)); }
  api('trash_info').done(trashInfo);
  $('#stt-trempty').on('click', function () {
    var $b = $(this);
    if (!window.confirm(T('tr.confirm', { info: $('#stt-trinfo').text() }))) { return; }
    $b.prop('disabled', true);
    api('trash_empty').done(function (r) { trashInfo(r); if (!r.ok) { window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $('#stt-test').on('click', function () {
    var $b = $(this).prop('disabled', true); $('#stt-tests').text(T('cfg.testing'));
    api('test').done(function (r) {
      var h = ''; $.each(r.tests, function (k, v) { h += esc(k) + ': ' + esc(v) + '<br>'; }); $('#stt-tests').html(h);
    }).fail(function (x) { $('#stt-tests').text(err(x)); }).always(function () { $b.prop('disabled', false); });
  });

  // a release that is smaller and better at the same time (Shape up, Must do), within the ticked offer kinds
  function hdrLbl(n) { return ((cfg && +cfg.dv_all) ? {1: 'SDR', 2: 'HDR', 3: 'DV', 4: 'DV+HDR'} : {0: T('q.dv_only'), 1: 'SDR', 2: 'HDR', 3: 'DV+HDR'})[n] || ''; }
  function hdrTxt(h) { return h === 'DV only' ? '<span class="stt-badge rd" title="' + esc(T('q.dv_only_tip')) + '" style="margin-left:0">' + esc(T('q.dv_only')) + '</span>' : esc(h); }
  function mustSorted(rows) { return $.grep(rows, mustRow).sort(function (a, b) { return a.size - b.size; }); } // the smallest (the biggest saving) first
  function mustRow(r) { var c = r.cats || []; return UCAT.save && c.indexOf('save') >= 0 && ((UCAT.hdr && c.indexOf('hdr') >= 0) || (UCAT.res && c.indexOf('res') >= 0)); }
  function resBlock(key, label, mode, it, mustFirst) {
    var rr = RES[key], h = '';
    if (!rr) { return ''; }
    if (rr.state === 'running') { return '<div class="stt-mut">' + esc(T('rs.searching')) + '</div>'; }
    if (rr.state === 'error') { return '<div class="stt-er">' + esc(rr.msg) + '</div>'; }
    if (!rr.rows.length) { return '<div class="stt-mut">' + esc(rr.msg) + '</div>'; }
    h = '<table class="stt"><thead><tr><th>' + esc(T('col.release')) + '</th><th class="stt-r">' + esc(T('col.size')) + '</th><th class="stt-r">' + esc(T('col.size_vs')) + '</th><th>' + esc(T('col.quality')) + '</th><th class="stt-r">' + esc(T('col.seeders')) + '</th><th>' + esc(T('col.indexer')) + '</th><th></th></tr></thead><tbody>';
    var rows = rr.rows;
    if (mustFirst) { rows = mustSorted(rr.rows).concat($.grep(rr.rows, function (r) { return !mustRow(r); })); } // the must releases first, the smallest (biggest saving) on top
    $.each(rows, function (j, r) {
      var sv = r.saving > 0 ? '-' + r.saving + '%' : '+' + Math.abs(r.saving) + '%', mu = mustFirst && mustRow(r);
      h += '<tr' + (mu ? ' class="stt-must"' : '') + '><td>' + (mu ? '<span class="stt-badge gold" style="margin:0 6px 0 0">' + esc(T('q.must')) + '</span>' : '') + esc(r.title) + (r.hun ? '<span class="stt-badge g">HUN</span>' : '') + $.map(r.cats || [], function (c) { return '<span class="stt-badge">' + esc(CATL[c]) + '</span>'; }).join('') + (r.rejected ? '<div class="stt-am">' + esc(r.rejections.join(' / ') || T('q.rejected')) + '</div>' : '') + '</td><td class="stt-r">' + fb(r.size) + '</td><td class="stt-r">' + sv + '</td><td>' + r.res + 'p ' + hdrTxt(r.hdr) + '</td><td class="stt-r">' + r.seeders + '</td><td>' + esc(r.indexer) + '</td><td><input type="button" class="stt-grab stt-btn" data-key="' + key + '" data-mode="' + mode + '" data-guid="' + esc(r.guid) + '" value="' + esc(label) + '"></td></tr>';
    });
    return h + '</tbody></table>';
  }

  function drawQueue(r) {
