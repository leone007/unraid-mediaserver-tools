  "note": "grey example text in an empty field."
 },
 "tp.settings": {
  "text": "Settings",
  "note": "link in the page navigation and the title of the settings part."
 },
 "tp.sub": {
  "text": "Only scans run by themselves. Nothing is added, replaced or deleted without your click.",
  "note": "grey line next to the page title."
 },
 "tp.upd_foot": {
  "text": "The scan matches the file sizes of your torrents with the files in Radarr and Sonarr; a torrent with several seasons is listed but not supported yet. Radarr and Sonarr decide whether a chosen release is an upgrade: if it waits with “Not an upgrade”, import it by hand in Activity, Queue. After the import the old torrent and its files can be removed here with one more click.",
  "note": "grey note under Shape up. \"Not an upgrade\" is Radarr's message; Activity, Queue are Radarr/Sonarr menu names."
 },
 "tp.upg_growth": {
  "text": "upgrades may be bigger by at most",
  "note": "words before the size limit of upgrades (\"... by at most 300 %\")."
 },
 "tp.weekly_on": {
  "text": "weekly: on",
  "note": "text before the day choice of the scheduled scan (\"(weekly: on Monday)\")."
 },
 "tr.confirm": {
  "text": "Empty the trash now?\n\nEverything in the .seedbox_trash folders is deleted at once {info}. This cannot be undone. Space is freed only for files that have no other hardlink (for example in the media folder).",
  "note": "confirmation box. Keep .seedbox_trash and the line breaks."
 },
 "tr.empty": {
  "text": "empty",
  "note": "the trash is empty (in brackets)."
 },
 "tr.items": {
