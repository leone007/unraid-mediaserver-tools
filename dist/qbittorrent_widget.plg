 "tp.p.every_listed_torrent_is": {
  "text": "Every listed torrent is searched in the background, one about every 90 seconds, a result is kept for 10 days. Offered: a release smaller by the saving, a better HDR format (SDR, HDR, DV) or a higher resolution, never a lower one. Hungarian audio comes first but is not required.",
  "note": "lead line of a part of the page."
 },
 "tp.p.folders_in_the_downloads": {
  "text": "Folders in the downloads folders that no torrent seeds: the original torrent is looked up on the trackers, or the content can be replaced.",
  "note": "lead line of a part of the page."
 },
 "tp.p.seasons_downloaded_episode_by": {
  "text": "Seasons downloaded episode by episode, replaced with the season pack through Sonarr; monitored series and seasons only, same or higher resolution, DV / HDR first. Nothing is deleted before the pack is complete and holds every episode you have; missing episodes (often the finale) come from the pack. With autobrr watched, new packs are listed here by themselves; the library scan tidies up what is already here.",
  "note": "lead line of a part of the page."
 },
 "tp.ph.api_key": {
  "text": "API key",
  "note": "grey example text in an empty field."
 },
 "tp.ph.filter_by_name": {
  "text": "filter by name",
  "note": "grey example text in an empty field."
 },
