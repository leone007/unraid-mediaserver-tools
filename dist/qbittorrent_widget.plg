      if (n > lim) { $g.append('<p><input type="button" class="stt-btn stt-sm stt-ghost stt-umore" data-g="' + g + '" value="Show ' + Math.min(50, n - lim) + ' more (' + (n - lim) + ' left)"></p>'); }
      $o.append($g);
