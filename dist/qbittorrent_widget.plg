    h += '<tr><td><b>' + spName(it) + '</b><div class="stt-mut">now: ' + esc(it.cur_quality) + ' ' + it.cur_res + 'p ' + hdrLbl(it.cur_hdr) + ', ' + it.files.length + ' episodes, ' + fb(it.cur_size) + '</div>' +
      (miss.length ? '<span class="stt-badge g" style="margin-left:0" title="Missing here; Sonarr imports them from the pack">brings ' + epl(miss.slice(0, 6)) + (miss.length > 6 ? ' &hellip;' : '') + '</span>' : '') +
      (ab ? '<span class="stt-badge" style="background:rgba(150,120,230,.25);color:#b9a6f0' + (miss.length ? '' : ';margin-left:0') + '">autobrr &middot; ' + ago(it.t) + ' ago</span>' : '') + '</td>' +
      '<td>' + esc(b.title) + '<span class="stt-badge ' + (b.hdr_rank > 1 ? 'g' : '') + '">' + b.res + 'p ' + b.hdr + '</span>' + (b.hun ? '<span class="stt-badge g">HUN</span>' : '') +
      '<div class="stt-mut">' + esc(b.indexer) + (ab && !it.ab_match ? ' &middot; Sonarr does not list the release autobrr saw (' + esc(it.ab_name) + '); this is the best pack it found' : '') + (it.packs.length > 1 ? ', ' + (it.packs.length - 1) + ' other pack(s): <a href="#" class="stt-spo" data-key="' + it.key + '">show</a>' : '') + '</div></td>' +
      '<td class="stt-r">' + fb(b.size) + '</td><td class="stt-r">' + b.seeders + '</td><td class="stt-r">' + it.files.length + ' files<div class="stt-mut">' + it.old.length + ' torrent(s)</div></td>' +
      '<td class="stt-r"><input type="button" class="stt-spgo stt-btn stt-sm" data-key="' + it.key + '" data-guid="" value="Replace with pack">' + (ab ? ' <input type="button" class="stt-spdis stt-btn stt-sm stt-ghost" data-key="' + it.key + '" value="Dismiss">' : '') + '</td></tr>';
    $.each(it.packs.slice(1), function (j, p) {
      h += '<tr class="stt-sp-' + it.key + '" style="display:none"><td></td><td>&#8627; ' + esc(p.title) + '<span class="stt-badge ' + (p.hdr_rank > 1 ? 'g' : '') + '">' + p.res + 'p ' + p.hdr + '</span>' + (p.hun ? '<span class="stt-badge g">HUN</span>' : '') + '</td><td class="stt-r">' + fb(p.size) + '</td><td class="stt-r">' + p.seeders + '</td><td></td><td class="stt-r"><input type="button" class="stt-spgo stt-btn stt-sm" data-key="' + it.key + '" data-guid="' + esc(p.guid) + '" value="Use this pack"></td></tr>';
    });
    if (it.old.length) {
      h += '<tr><td></td><td colspan="5" class="stt-mut" style="white-space:normal">Single-episode torrents that go to the trash after the import (' + it.old.length + ', ' + fb(it.old_size || 0) + ' on disk, the pack is ' + fb(b.size) + '):<br>' +
        $.map(it.old, function (o) { return 'E' + ('0' + o.ep).slice(-2) + ' &middot; ' + esc(o.name) + ' <span class="stt-mut">(' + fb(o.size) + ')</span>'; }).join('<br>') + '</td></tr>';
    }
    return h;
  }
  function loadSeries() {
    api('sp_series').done(function (r) {
      if (r.ok) { $('#stt-splist').html($.map(r.titles || [], function (t) { return '<option value="' + esc(t) + '">'; }).join('')); }
    });
  }
  function pollSp() {
    clearTimeout(spT);
    api('sp_get').done(function (r) {
      SP = r.sp; SPJ = r.jobs || []; SPAB = r.ab || []; SPABQ = r.ab_queue || 0; drawSp();
      var busy = r.running || (SP && SP.state === 'running');
      if (busy) { spT = setTimeout(pollSp, 2500); } else { $('#stt-spscan').prop('disabled', false); }
    });
  }
  $('#stt-spscan').on('click', function () {
    $(this).prop('disabled', true); $('#stt-spmsg').css('color', '').text('Starting...'); SPOPEN = true;
    api('sp_scan', {q: $('#stt-spq').val()}).done(function () { setTimeout(pollSp, 800); }).fail(function (x) { $('#stt-spscan').prop('disabled', false); $('#stt-spmsg').css('color', '#e5534b').text(err(x)); });
  });
  $(document).on('click', '.stt-spo', function (e) { e.preventDefault(); $('.stt-sp-' + $(this).data('key')).toggle(); });
  $(document).on('click', '.stt-spfold', function (e) { e.preventDefault(); SPOPEN = !SPOPEN; drawSp(); });
  $(document).on('click', '.stt-spdis', function () {
    var $b = $(this).prop('disabled', true);
    api('sp_ab_dismiss', {key: $b.data('key')}).done(pollSp).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-spclr', function (e) { e.preventDefault(); api('sp_clear').done(pollSp); });
  $(document).on('click', '.stt-spgo', function () {
    var $b = $(this);
    if (!window.confirm('Replace the single episodes of this season with the season pack?\n\n1. Sonarr downloads the pack (the episodes stay as they are meanwhile).\n2. When it is 100% done and holds every episode you have, the season is unmonitored and its files are DELETED in Sonarr.\n3. Sonarr imports the pack; then monitoring is restored and the single-episode torrents are moved to the trash folder.\n\nIt runs in the background; if something goes wrong before step 2 nothing is changed.')) { return; }
    $b.prop('disabled', true);
    api('sp_start', {key: $b.data('key'), guid: $b.data('guid')}).done(function (r) { if (r.ok) { pollSp(); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });

  loadState().done(function () { pollFind(); pollUpd(); pollSp(); loadSeries(); });
  // the autobrr rows can arrive while the page is open: redraw the season list only when it changed (an opened pack list stays open)
  var spSig = '';
  setInterval(function () { api('sp_get').done(function (r) { var g = JSON.stringify([r.ab, r.ab_queue, r.sp && r.sp.t]); if (g === spSig) { return; } spSig = g; SPAB = r.ab || []; SPABQ = r.ab_queue || 0; SP = r.sp; SPJ = r.jobs || SPJ; drawSp(); }); }, 30000);
  setInterval(function () { api('state').done(function (r) { LAST.dl = r.dl; drawPending(r.pending); drawJobs(r.jobs); if (r.packjobs) { SPJ = r.packjobs; drawSp(); } }); api('find_get').done(function (r) { if (!r.find || r.find.state !== 'ready') { return; } drawQueue(r); var sig = JSON.stringify([r.find.items, r.res]); if (sig === lastSig) { return; } lastSig = sig; RES = r.res || RES; drawFind(r.find); }); }, 15000);
});
</script>
]]></INLINE>
</FILE>

