      var $r = $('<details class="stt-urest"><summary class="stt-mut">' + rest.length + ' torrent' + (rest.length === 1 ? '' : 's') + ' without an offer' + (nn ? ' (' + nn + ' not searched yet)' : '') + '</summary></details>');
