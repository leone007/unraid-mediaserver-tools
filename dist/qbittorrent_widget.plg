<FILE Name="&plugdir;/tools_lib.php">
<INLINE><![CDATA[<?php
// Seedbox tools: findmytorrent (torrents for files that are not seeded) and updateme (smaller, better
// alternatives for big seeded titles, through Radarr and Sonarr). Used by tools.php (web) and tools_run.php.
const ST_DIR   = '/boot/config/plugins/qbittorrent_widget';
const ST_CFG   = ST_DIR . '/tools.json';
const ST_STATE = ST_DIR . '/tools_state.json';
const ST_FIND  = '/tmp/qbt_tools_find.json';
const ST_UPD   = '/tmp/qbt_tools_upd.json';
const ST_RES   = '/tmp/qbt_tools_res.json';
const ST_JAR   = '/tmp/qbt_tools_cookie.txt';

require_once __DIR__ . '/moveprog.php';
function st_dir() { $d = getenv('DBX_ST_DIR'); return ($d !== false && $d !== '') ? $d : ST_DIR; }

function st_json_read($f, $def = []) {
    if (!is_file($f)) { return $def; }
    $j = json_decode((string)@file_get_contents($f), true);
    return is_array($j) ? $j : $def;
}
function st_json_write($f, $data, $mode = 0644) {
    $dir = dirname($f);
    if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
    $tmp = $f . '.tmp' . getmypid();
    if (@file_put_contents($tmp, json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE)) === false) { return false; }
    if (!@rename($tmp, $f)) { @unlink($tmp); return false; }
    @chmod($f, $mode);
    return true;
}
// one search result in /tmp/qbt_tools_res.json, under a lock (the page, the searches and the background check all write it)
function st_res_set($key, $val) {
    $lk = @fopen('/tmp/qbt_tools_res.lock', 'c'); if ($lk) { flock($lk, LOCK_EX); }
    $res = st_json_read(ST_RES, []); $res[$key] = $val; st_json_write(ST_RES, $res);
    if ($lk) { flock($lk, LOCK_UN); fclose($lk); }
}
function st_cfg_file() { return st_dir() . '/tools.json'; }
function st_state_file() { return st_dir() . '/tools_state.json'; }

function st_cfg() {
    $c = ['prowlarr' => ['url' => '', 'key' => ''], 'radarr' => ['url' => '', 'key' => ''], 'sonarr' => ['url' => '', 'key' => ''], 'lidarr' => ['url' => '', 'key' => ''], 'autobrr' => ['url' => '', 'key' => ''], 'ab_on' => 0, 'ab_filters' => [],
          'map_qb' => '/data', 'map_host' => '/mnt/user/data',
          'roots' => ['/mnt/user/data/downloads/FILM', '/mnt/user/data/downloads/SOROZAT'], 'dl_base' => '', 'folders' => null,
          'upd_min_gb' => 40, 'upd_min_age' => 90, 'upd_saving' => 30, 'dv_all' => 0, 'upd_upg_growth' => 100, 'upd_cat_save' => 1, 'upd_cat_hdr' => 1, 'upd_cat_res' => 1, 'find_tol' => 1, 'find_accept' => 99, 'repl_max_growth' => 100, 'find_missing_files' => 1, 'trash_days' => 3, 'dc_hook' => '', 'dc_lang' => 'hu', 'dc_on' => 0, 'bot_token' => '', 'bot_user' => '', 'bot_rep' => 1, 'bot_find' => 1, 'tag_find' => '', 'tag_upd' => '', 'tag_rep' => '', 'show_find' => 'relevant', 'show_upd' => 'relevant', 'show_rep' => 'relevant', 'show_find_days' => 3, 'show_upd_days' => 3, 'show_rep_days' => 3, 'dc_find' => 0, 'dc_upd' => 0, 'dc_rep' => 0, 'find_cat' => 1, 'auto_scan' => 1, 'auto_upd' => 0, 'auto_rep' => 0, 'auto_freq' => 'weekly', 'auto_day' => 1, 'auto_hour' => 8];
    $x = st_json_read(st_cfg_file(), []);
    foreach (['prowlarr', 'radarr', 'sonarr', 'lidarr', 'autobrr'] as $k) { if (isset($x[$k]) && is_array($x[$k])) { $c[$k] = array_merge($c[$k], $x[$k]); } }
    foreach (['ab_on', 'ab_filters', 'map_qb', 'map_host', 'roots', 'dl_base', 'folders', 'upd_min_gb', 'upd_min_age', 'upd_saving', 'dv_all', 'upd_upg_growth', 'upd_cat_save', 'upd_cat_hdr', 'upd_cat_res', 'find_tol', 'find_accept', 'repl_max_growth', 'find_missing_files', 'trash_days', 'dc_hook', 'dc_lang', 'dc_on', 'bot_token', 'bot_user', 'bot_rep', 'bot_find', 'tag_find', 'tag_upd', 'tag_rep', 'show_find', 'show_upd', 'show_rep', 'show_find_days', 'show_upd_days', 'show_rep_days', 'dc_find', 'dc_upd', 'dc_rep', 'find_cat', 'auto_scan', 'auto_upd', 'auto_rep', 'auto_freq', 'auto_day', 'auto_hour'] as $k) { if (isset($x[$k])) { $c[$k] = $x[$k]; } }
    foreach (['dc_find', 'dc_upd', 'dc_rep'] as $k) { if (!isset($x[$k])) { $c[$k] = !empty($c['dc_on']) ? 1 : 0; } } // the old single switch decides until the new ones are saved
    return st_cfg_folders($c);
}

// ---- folder roles (item 42) -----------------------------------------------------------------------------
// Every folder directly inside the downloads folder (dl_base) has a role: movies, series, music (the media library), other
// (seeding only, e.g. ratio torrents) or off (not watched). Find my torrent watches every folder but off; Shape up and the
// Season repacker only movies and series. Before the first save the roles come from the names; a folder that appears after
// a save is other and marked new. st_cfg() derives 'roots' (Find my torrent), 'lib' (movies + series) and 'series_dirs'.
const ST_ROLES = ['movies', 'series', 'music', 'other', 'off'];
function st_role_guess($name) {
    $n = strtolower($name);
    if (preg_match('/film|movie|mozi/', $n)) { return 'movies'; }
    if (preg_match('/sorozat|series|show|^tv/', $n)) { return 'series'; }
    if (preg_match('/muzzik|music|muzik|zene/', $n)) { return 'music'; }
    return 'other';
}
function st_folder_names($base) {
    $out = [];
    if ($base === '' || !is_dir($base)) { return $out; }
    foreach ((array)@scandir($base) as $e) {
        if ($e === '' || $e[0] === '.' || !is_dir($base . '/' . $e)) { continue; } // hidden folders and .seedbox_trash are never listed
        $out[] = $e;
    }
    return $out;
}
// [name => ['role' =>, 'new' => bool, 'path' =>]] for $base with the saved roles ($saved null = never saved)
function st_folder_list($base, $saved) {
    $names = st_folder_names($base);
    if (!$names && is_array($saved)) { $names = array_map('strval', array_keys($saved)); } // the share cannot be read (array stopped): keep the saved folders
    natcasesort($names); $out = [];
    foreach ($names as $n) {
        $has = is_array($saved) && isset($saved[$n]) && in_array($saved[$n], ST_ROLES, true);
        $out[$n] = ['role' => $has ? $saved[$n] : (is_array($saved) ? 'other' : st_role_guess($n)), 'new' => is_array($saved) && !$has, 'path' => $base . '/' . $n];
    }
    return $out;
}
function st_cfg_folders($c) {
    $base = rtrim((string)$c['dl_base'], '/');
    if ($base === '') { $r0 = (string)(((array)$c['roots'])[0] ?? ''); $base = $r0 !== '' ? dirname($r0) : '/mnt/user/data/downloads'; } // before the first save: the parent of the old list
    $c['dl_base'] = $base;
    $list = st_folder_list($base, is_array($c['folders']) ? $c['folders'] : null);
    $c['folder_list'] = $list; $c['roots'] = []; $c['lib'] = []; $c['series_dirs'] = [];
    foreach ($list as $f) {
        if ($f['role'] !== 'off') { $c['roots'][] = $f['path']; }
        if ($f['role'] === 'movies' || $f['role'] === 'series') { $c['lib'][] = $f['path']; }
        if ($f['role'] === 'series') { $c['series_dirs'][] = $f['path']; }
    }
    return $c;
}
function st_upd_hidden_file() { return dirname(st_state_file()) . '/upd_hidden.json'; }
function st_upd_hidden_read() { $a = st_json_read(st_upd_hidden_file(), []); return is_array($a) ? array_values($a) : []; }
function st_upd_hidden_set($hash, $on) {
    $lk = @fopen(st_upd_hidden_file() . '.lock', 'c');
    if ($lk) { @flock($lk, LOCK_EX); }
    $a = array_values(array_diff(st_upd_hidden_read(), [$hash]));
    if ($on) { $a[] = $hash; }
    st_json_write(st_upd_hidden_file(), $a, 0600);
    if ($lk) { @flock($lk, LOCK_UN); fclose($lk); }
}
function st_ignored_file() { return dirname(st_state_file()) . '/ignored.json'; }
function st_ignored_read() { $a = st_json_read(st_ignored_file(), []); return is_array($a) ? array_values($a) : []; }
function st_ignored_add($path) {
    $lk = @fopen(st_ignored_file() . '.lock', 'c');
    if ($lk) { @flock($lk, LOCK_EX); }
    $a = st_ignored_read();
    if (!in_array($path, $a, true)) { $a[] = $path; st_json_write(st_ignored_file(), $a, 0600); }
    if ($lk) { @flock($lk, LOCK_UN); fclose($lk); }
}
// The state lives in two copies: a live one in /tmp (written on every change) and the one on the flash drive, which is
// written only when something lasting changes (a stage, a new or removed entry, the queue), or once an hour: the
// progress messages ("downloading 45%") would otherwise rewrite the flash drive every minute. After a reboot the
// flash copy is read.
function st_state_live_file() { $d = getenv('DBX_ST_DIR'); return ($d !== false && $d !== '') ? $d . '/tools_state_live.json' : '/tmp/qbt_tools_state.json'; }
function st_state_lock_file() { $d = getenv('DBX_ST_DIR'); return ($d !== false && $d !== '') ? $d . '/tools_state.lock' : '/tmp/qbt_tools_state.lock'; }
function st_state() {
    $l = st_state_live_file();
    $s = st_json_read(is_file($l) ? $l : st_state_file(), []);
    $s = array_merge(['pending' => [], 'jobs' => [], 'packjobs' => [], 'queue' => [], 'qstat' => null], $s);
    $leg = isset($s['ignored']) && is_array($s['ignored']) ? $s['ignored'] : [];
    $s['ignored'] = array_values(array_unique(array_merge($leg, st_ignored_read())));
    return $s;
}
// what must reach the flash drive: everything except the messages of the entries that are still under way
function st_state_sig($s) {
    foreach (['pending', 'jobs', 'packjobs'] as $k) {
        foreach ((array)($s[$k] ?? []) as $i => $e) {
            if (in_array($e['stage'] ?? '', ['added', 'checking', 'grabbed', 'downloading', 'importing', 'blocked'], true)) { unset($s[$k][$i]['msg']); }
        }
    }
    return md5(json_encode($s));
}
// Writes the state. Call it only inside st_state_update (or with nothing else running), else changes can be lost.
function st_state_write($s) {
    if (!empty($s['ignored'])) { foreach ($s['ignored'] as $p) { st_ignored_add($p); } }
    unset($s['ignored']);
    $f = st_state_file();
    if (!st_json_write(st_state_live_file(), $s, 0600)) { return st_json_write($f, $s, 0600); }
    $old = is_file($f) ? st_json_read($f, null) : null;
    if (!is_array($old) || st_state_sig($old) !== st_state_sig($s) || time() - (int)@filemtime($f) >= 3600) { return st_json_write($f, $s, 0600); }
    return true;
}
// Read, change and write the state under one lock, so the minute tick and the buttons of the page cannot overwrite
// each other. $fn gets the state by reference; when it returns false nothing is written. Returns what $fn returned.
// Keep $fn short: no HTTP calls inside.
function st_state_update(callable $fn) {
    static $depth = 0;
    $lk = null;
    if ($depth === 0) { $lk = @fopen(st_state_lock_file(), 'c'); if ($lk) { @flock($lk, LOCK_EX); } }
    $depth++;
    try {
        $s = st_state();
        $r = $fn($s);
        if ($r !== false) { st_state_write($s); }
    } finally {
        $depth--;
        if ($lk) { @flock($lk, LOCK_UN); fclose($lk); }
    }
    return $r;
}
// One replacement start or removal at a time (a double click must not grab or delete twice). Returns the lock handle or null.
function st_action_lock() {
    $d = getenv('DBX_ST_DIR');
    $f = @fopen(($d !== false && $d !== '') ? $d . '/tools_action.lock' : '/tmp/qbt_tools_action.lock', 'c');
    if (!$f) { return null; }
    if (!flock($f, LOCK_EX | LOCK_NB)) { fclose($f); return null; }
    return $f;
}
function st_action_unlock($f) { if ($f) { @flock($f, LOCK_UN); fclose($f); } }
// key of a list entry (jobs and season pack jobs have an id; older check entries do not)
function st_entry_key($e) { return isset($e['id']) ? 'i' . $e['id'] : 'p' . ($e['hash'] ?? '') . '|' . ($e['path'] ?? '') . '|' . ($e['name'] ?? ''); }
// The tick worked on a copy ($orig -> $new) for minutes; put its changes onto the current state: an entry the page
// changed or added meanwhile keeps the page's version, an entry the tick dropped (old, finished) goes.
function st_merge_list($orig, $new, $cur) {
    $ob = []; foreach ((array)$orig as $e) { $ob[st_entry_key($e)] = $e; }
    $nb = []; foreach ((array)$new as $e) { $nb[st_entry_key($e)] = $e; }
    $out = [];
    foreach ((array)$cur as $e) {
        $k = st_entry_key($e);
        if (!isset($ob[$k]) || json_encode($e) !== json_encode($ob[$k])) { $out[] = $e; continue; }
        if (isset($nb[$k])) { $out[] = $nb[$k]; }
    }
    return $out;
}

function st_qbcfg() {
    $c = ['host' => '127.0.0.1', 'port' => '8080', 'user' => '', 'pass' => ''];
    $f = st_dir() . '/settings.cfg';
    if (is_file($f)) { $x = @parse_ini_file($f, false, INI_SCANNER_RAW); if (is_array($x)) { $c = array_merge($c, $x); } }
    return $c;
}

// ---- HTTP ---------------------------------------------------------------------------------------------
// opts: headers[], post (array|string), file (field => path), timeout, follow (bool), jar (path)
function st_http($method, $url, $opts = []) {
    $ch = curl_init($url);
    $h = $opts['headers'] ?? [];
    $o = [CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => $opts['timeout'] ?? 30,
          CURLOPT_FOLLOWLOCATION => !empty($opts['follow']), CURLOPT_MAXREDIRS => 5, CURLOPT_HEADER => true];
    if (!empty($opts['jar'])) { $o[CURLOPT_COOKIEJAR] = $opts['jar']; $o[CURLOPT_COOKIEFILE] = $opts['jar']; }
    if ($method === 'POST') {
        $o[CURLOPT_POST] = true;
        $post = $opts['post'] ?? '';
        if (!empty($opts['file'])) {
            $post = is_array($post) ? $post : [];
            foreach ($opts['file'] as $field => $path) { $post[$field] = new CURLFile($path, 'application/x-bittorrent', 'file.torrent'); }
        } elseif (is_array($post)) { $post = http_build_query($post); }
        $o[CURLOPT_POSTFIELDS] = $post;
    } elseif ($method !== 'GET') { $o[CURLOPT_CUSTOMREQUEST] = $method; if (isset($opts['post'])) { $o[CURLOPT_POSTFIELDS] = $opts['post']; } }
    $o[CURLOPT_HTTPHEADER] = $h;
    curl_setopt_array($ch, $o);
    $raw = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $hs = (int)curl_getinfo($ch, CURLINFO_HEADER_SIZE);
    $err = curl_errno($ch) ? curl_error($ch) : '';
    curl_close($ch);
    if ($raw === false) { return [0, '', $err ?: 'request failed', '']; }
    return [$code, substr($raw, $hs), $err, substr($raw, 0, $hs)];
}

// ---- qBittorrent ---------------------------------------------------------------------------------------
function st_qb_base() { $c = st_qbcfg(); return 'http://' . $c['host'] . ':' . (int)$c['port']; }

function st_qb_login() {
    $c = st_qbcfg(); $base = st_qb_base();
    [$code, $body, $err] = st_http('POST', $base . '/api/v2/auth/login', ['post' => ['username' => $c['user'], 'password' => $c['pass']],
        'headers' => ['Referer: ' . $base, 'Origin: ' . $base], 'jar' => ST_JAR, 'timeout' => 10]);
    @chmod(ST_JAR, 0600);
    return $code === 200 && trim($body) === 'Ok.';
}
// returns [code, body, err]; logs in on 401/403 and retries once
function st_qb($path, $post = null, $files = null) {
    $base = st_qb_base();
    $do = function () use ($base, $path, $post, $files) {
        $o = ['headers' => ['Referer: ' . $base, 'Origin: ' . $base], 'jar' => ST_JAR, 'timeout' => 30];
        if ($post !== null || $files) { $o['post'] = $post ?? []; if ($files) { $o['file'] = $files; } return st_http('POST', $base . $path, $o); }
        return st_http('GET', $base . $path, $o);
    };
    $r = $do();
    if ($r[0] === 401 || $r[0] === 403) { if (!st_qb_login()) { return [403, '', 'qBittorrent login failed']; } $r = $do(); }
    return $r;
}
function st_qb_json($path) {
    [$c, $b, $e] = st_qb($path);
    if ($c !== 200) { return null; }
    $j = json_decode($b, true);
    return is_array($j) ? $j : null;
}
function st_qb_torrents() { $j = st_qb_json('/api/v2/torrents/info'); return $j === null ? null : $j; }

// ---- path mapping ---------------------------------------------------------------------------------------
function st_to_host($p, $cfg) {
    $q = rtrim($cfg['map_qb'], '/'); $h = rtrim($cfg['map_host'], '/');
    if ($q !== '' && ($p === $q || strpos($p, $q . '/') === 0)) { return $h . substr($p, strlen($q)); }
    return $p;
}
function st_to_qb($p, $cfg) {
    $q = rtrim($cfg['map_qb'], '/'); $h = rtrim($cfg['map_host'], '/');
    if ($h !== '' && ($p === $h || strpos($p, $h . '/') === 0)) { return $q . substr($p, strlen($h)); }
    return $p;
}

// Shape up and the Season repacker look only at torrents inside a movies or series folder (st_cfg 'lib'). Returns '' for
// those, else the place the torrent is in (its folder, e.g. TL, or its own path when it is outside every folder).
function st_lib_out($t, $cfg) {
    $p = st_to_host(rtrim((string)($t['content_path'] ?? $t['save_path'] ?? ''), '/'), $cfg);
    foreach ((array)($cfg['lib'] ?? []) as $r) { $r = rtrim((string)$r, '/'); if ($r !== '' && $p !== '' && ($p === $r || strpos($p, $r . '/') === 0)) { return ''; } }
    $base = rtrim((string)($cfg['dl_base'] ?? ''), '/');
    if ($base !== '' && strpos($p, $base . '/') === 0) { return explode('/', substr($p, strlen($base) + 1))[0]; }
    return $p === '' ? '?' : dirname($p);
}
function st_lib_in($tor, $cfg) { return $tor === null ? null : array_values(array_filter((array)$tor, function ($t) use ($cfg) { return st_lib_out($t, $cfg) === ''; })); }
function st_norm($s) { return preg_replace('/[^a-z0-9]+/', '', strtolower((string)$s)); }
function st_fmt($b) {
    $b = (float)$b;
    if ($b >= 1e12) { return number_format($b / 1e12, 2) . ' TB'; }
    if ($b >= 1e9) { return number_format($b / 1e9, $b >= 1e11 ? 0 : 1) . ' GB'; }
    return number_format($b / 1e6, 0) . ' MB';
}

// ---- release name helpers -------------------------------------------------------------------------------
// 3 = Dolby Vision, 2 = HDR, 1 = SDR / unknown
// HDR format of a release name or of Radarr / Sonarr's videoDynamicRangeType ('DV HDR10', 'DV', 'HDR10', 'HLG'):
// dvhdr = Dolby Vision with an HDR10 base layer (plays as HDR10 on a TV without DV), dv = Dolby Vision only (no fallback: a purple
// and green picture on a TV without DV), hdr, sdr
function st_hdr_kind($t) {
    $t = (string)$t;
    $dv = (bool)preg_match('/dolby[ .\-_]?vision|\bdovi\b|\bdv\b/i', $t);
    $hdr = (bool)preg_match('/hdr10\+?|hdr10plus|\bhdr\b|\bhlg\b|\bpq\b/i', $t);
    // a remux or a full disc keeps the HDR10 base layer of the UHD Blu-ray under DV (profile 7 or 8.1); an encode (x265, single layer)
    // may be profile 5 = DV only, so for an encode only an HDR / HDR10 in the name counts (the owner found a DV only BluRay encode)
    $disc = (bool)preg_match('/remux|\bbd(?:25|50|66|100)\b|\buhd[ .\-_]?bd\b|complete[ .\-_]?uhd/i', $t);
    return $dv ? (($hdr || $disc) ? 'dvhdr' : 'dv') : ($hdr ? 'hdr' : 'sdr');
}
// does every TV play Dolby Vision (setting dv_all)? If not, a DV-only release ranks below SDR: it is never an upgrade
function st_dv_all() { static $v = null; if ($v === null) { $v = (int)(st_cfg()['dv_all'] ?? 0); } return $v; }
function st_hdr_rank($t) {
    $k = st_hdr_kind($t);
    return st_dv_all() ? ['sdr' => 1, 'hdr' => 2, 'dv' => 3, 'dvhdr' => 4][$k] : ['dv' => 0, 'sdr' => 1, 'hdr' => 2, 'dvhdr' => 3][$k];
}
function st_hdr_label($r) { return (st_dv_all() ? [1 => 'SDR', 2 => 'HDR', 3 => 'DV', 4 => 'DV+HDR'] : [0 => 'DV only', 1 => 'SDR', 2 => 'HDR', 3 => 'DV+HDR'])[$r] ?? 'SDR'; }
function st_res_of($t) {
    $t = (string)$t;
    if (preg_match('/2160p/i', $t)) { return 2160; }
    if (preg_match('/1080[pi]/i', $t)) { return 1080; } // an explicit 1080p wins over UHD in the name (1080p UHD BluRay hybrids)
    if (preg_match('/720p/i', $t)) { return 720; }
    if (preg_match('/480p|576p/i', $t)) { return 480; }
    if (preg_match('/\b4k\b|\buhd\b/i', $t)) { return 2160; }
    if (preg_match('/\bBD(25|50|66|100)\b/i', $t)) { return 1080; } // a Blu-ray disc image without a resolution in the name
    return 0;
}

// ---- Prowlarr -------------------------------------------------------------------------------------------
function st_arr($which, $path, $method = 'GET', $json = null, $timeout = 60) {
    $c = st_cfg()[$which] ?? ['url' => '', 'key' => ''];
    $url = rtrim((string)$c['url'], '/');
    if ($url === '' || $c['key'] === '') { return [0, null, $which . ' is not configured']; }
    $api = ($which === 'prowlarr' || $which === 'lidarr') ? '/api/v1' : '/api/v3';
    $h = ['X-Api-Key: ' . $c['key'], 'Accept: application/json'];
    $o = ['headers' => $h, 'timeout' => $timeout, 'follow' => true];
    if ($json !== null) { $o['headers'][] = 'Content-Type: application/json'; $o['post'] = json_encode($json); }
    [$code, $body, $err] = st_http($method, $url . $api . $path, $o);
    if ($err) { return [0, null, $err]; }
    $j = json_decode($body, true);
    if ($code >= 400) { return [$code, $j, 'HTTP ' . $code . (is_array($j) && !empty($j['message']) ? ': ' . $j['message'] : '')]; }
    return [$code, $j, ''];
}

function st_prowlarr_search($q) {
    [$c, $j, $e] = st_arr('prowlarr', '/search?type=search&limit=100&query=' . rawurlencode($q), 'GET', null, 90);
    if ($e || !is_array($j)) { return [null, $e ?: 'bad response']; }
    $out = [];
    foreach ($j as $r) {
        if (!is_array($r) || strtolower((string)($r['protocol'] ?? 'torrent')) !== 'torrent') { continue; }
        $out[] = ['title' => (string)($r['title'] ?? ''), 'size' => (float)($r['size'] ?? 0), 'seeders' => (int)($r['seeders'] ?? 0),
                  'indexer' => (string)($r['indexer'] ?? ''), 'dl' => (string)($r['downloadUrl'] ?? ($r['magnetUrl'] ?? '')), 'info' => (string)($r['infoUrl'] ?? ''),
                  'date' => (string)($r['publishDate'] ?? '')];
    }
    return [$out, ''];
}

// ---- bencode (only to read the info hash of a .torrent) ---------------------------------------------------
function st_bdec($s, &$i) {
    $c = $s[$i] ?? '';
    if ($c === 'i') { $e = strpos($s, 'e', $i); $v = (int)substr($s, $i + 1, $e - $i - 1); $i = $e + 1; return $v; }
    if ($c === 'l') { $i++; $a = []; while (($s[$i] ?? 'e') !== 'e') { $a[] = st_bdec($s, $i); } $i++; return $a; }
    if ($c === 'd') {
        $i++; $a = [];
        while (($s[$i] ?? 'e') !== 'e') {
            $k = st_bdec($s, $i);
            $start = $i;
            $v = st_bdec($s, $i);
            if ($k === 'info') { $a['__info_raw'] = substr($s, $start, $i - $start); }
            $a[$k] = $v;
        }
        $i++; return $a;
    }
    $col = strpos($s, ':', $i);
    if ($col === false) { throw new Exception('bad bencode'); }
    $len = (int)substr($s, $i, $col - $i);
    $v = substr($s, $col + 1, $len); $i = $col + 1 + $len;
    return $v;
}
function st_torrent_hash($bytes) {
    try { $i = 0; $d = st_bdec($bytes, $i); } catch (Throwable $e) { return ''; }
    return (is_array($d) && isset($d['__info_raw'])) ? sha1($d['__info_raw']) : '';
}
function st_magnet_hash($m) {
    if (!preg_match('/xt=urn:btih:([A-Za-z0-9]+)/', $m, $x)) { return ''; }
    $h = $x[1];
    if (strlen($h) === 40) { return strtolower($h); }
    if (strlen($h) === 32) {
        $al = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'; $bits = '';
        foreach (str_split(strtoupper($h)) as $ch) { $p = strpos($al, $ch); if ($p === false) { return ''; } $bits .= str_pad(decbin($p), 5, '0', STR_PAD_LEFT); }
        $out = ''; foreach (str_split($bits, 8) as $b) { if (strlen($b) === 8) { $out .= sprintf('%02x', bindec($b)); } }
        return $out;
    }
    return '';
}

// ---- local downloads folders ------------------------------------------------------------------------------
function st_dir_size($p) {
    if (is_file($p)) { return (float)@filesize($p); }
    $o = (string)@shell_exec('find ' . escapeshellarg($p) . ' -type f -printf ' . escapeshellarg('%s\n') . ' 2>/dev/null');
    $t = 0.0; foreach (explode("\n", $o) as $l) { if ($l !== '') { $t += (float)$l; } }
    return $t;
}
function st_units($roots) {
    $u = [];
    foreach ($roots as $r) {
        $r = rtrim((string)$r, '/');
        if ($r === '' || !is_dir($r)) { continue; }
        foreach (scandir($r) as $n) {
            if ($n === '.' || $n === '..' || $n[0] === '.' || $n === '@eaDir' || $n === '#recycle' || $n === '.recycle') { continue; }
            $p = $r . '/' . $n;
            $u[] = ['path' => $p, 'name' => $n, 'root' => basename($r), 'isdir' => is_dir($p), 'size' => st_dir_size($p)];
        }
    }
    return $u;
}

// Does the file or folder contain a video file? (artwork, .nfo and similar leftovers are not content)
function st_has_video($p) {
    $re = '/\.(mkv|mp4|avi|m4v|ts|mov|wmv|iso)$/i';
    if (is_file($p)) { return (bool)preg_match($re, $p); }
    $o = (string)@shell_exec('find ' . escapeshellarg($p) . ' -type f \\( -iname "*.mkv" -o -iname "*.mp4" -o -iname "*.avi" -o -iname "*.m4v" -o -iname "*.ts" -o -iname "*.mov" -o -iname "*.wmv" -o -iname "*.iso" \\) -print -quit 2>/dev/null');
    return trim($o) !== '';
}

// ---- Discord summaries: what happened and why --------------------------------------------------------------
function st_dc_hook_ok($u) { return (bool)preg_match('#^https://(?:discord|discordapp)\.com/api/webhooks/\d{15,25}/[A-Za-z0-9_\-]{20,120}$#', (string)$u); }
// Hungarian or English text, by the setting
require_once __DIR__ . '/lang.php';
// Discord texts: the language is shared by all the plugins (lang.php)
function st_l($hu, $en) { return mt_lang_discord() === 'en' ? $en : $hu; }
// $level: rd red, a amber, g green, i blue. $fields: [[name, value, inline?], ...]. Returns [ok, error]. Never throws.
// which tool a job belongs to: replacements of unseeded content are Find my torrent, the rest is Update me
function st_ntool($j) { return (($j['mode'] ?? '') === 'repl') ? 'find' : 'upd'; }
// $opts: 'wait' => true returns the message Discord stored as the third element (its id and channel_id, for BoxBot);
// 'color' => an embed colour instead of the level's
function st_notify($level, $title, $desc = '', $fields = [], $force = false, $tool = '', $opts = []) {
    $cfg = st_cfg(); $hook = (string)($cfg['dc_hook'] ?? '');
    $on = $tool !== '' ? !empty($cfg['dc_' . $tool]) : (!empty($cfg['dc_find']) || !empty($cfg['dc_upd']) || !empty($cfg['dc_rep']));
    if (!$force && !$on) { return [false, 'Discord messages are switched off for this tool']; }
    if (getenv('DBX_ST_DC')) { $hook = getenv('DBX_ST_DC'); } // test hook
    elseif (!st_dc_hook_ok($hook)) { return [false, 'no Discord webhook set']; }
    $col = ['rd' => 0xE5534B, 'a' => 0xD9921F, 'g' => 0x3FA24A, 'i' => 0x4A90E2];
    $host = @gethostname();
    $e = ['title' => mb_substr($title, 0, 250), 'color' => $opts['color'] ?? ($col[$level] ?? $col['i']), 'timestamp' => gmdate('c'), 'footer' => ['text' => trim(($host ? $host . ' · ' : '') . 'Seedbox')]];
    if ($desc !== '') { $e['description'] = mb_substr($desc, 0, 3900); }
    $f = [];
    foreach ($fields as $x) { if ($x[1] === '' || $x[1] === null) { continue; } $f[] = ['name' => mb_substr((string)$x[0], 0, 250), 'value' => mb_substr((string)$x[1], 0, 1000), 'inline' => !empty($x[2])]; }
    if ($f) { $e['fields'] = array_slice($f, 0, 24); }
    $json = json_encode(['embeds' => [$e], 'allowed_mentions' => ['parse' => []]], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
    for ($try = 0; $try < 2; $try++) {
        $ch = curl_init($hook . (!empty($opts['wait']) ? '?wait=true' : ''));
        curl_setopt_array($ch, [CURLOPT_POST => true, CURLOPT_RETURNTRANSFER => true, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 15, CURLOPT_POSTFIELDS => $json, CURLOPT_HTTPHEADER => ['Content-Type: application/json']]);
        $body = curl_exec($ch); $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE); $er = curl_errno($ch); curl_close($ch);
        if ($code === 200 || $code === 204) { $m = json_decode((string)$body, true); return [true, '', is_array($m) ? $m : null, $e]; }
        if ($code === 429) { $d = json_decode((string)$body, true); $w = is_array($d) && isset($d['retry_after']) ? (float)$d['retry_after'] : 2.0; if ($try === 0 && $w <= 5.0) { usleep((int)(($w + 0.3) * 1000000)); continue; } }
        return [false, $er ? 'network error ' . $er : 'Discord HTTP ' . $code];
    }
    return [false, 'Discord did not accept the message'];
}
function st_missing_files($hash) { $r = []; foreach ((array)st_qb_json('/api/v2/torrents/files?hash=' . rawurlencode($hash)) as $f) { if ((float)($f['progress'] ?? 1) < 0.999) { $r[] = (float)$f['size'] * (1 - (float)$f['progress']); } } return $r; }
function st_missing_txt($inc) { return count($inc) . ' file' . (count($inc) === 1 ? '' : 's') . ' (' . st_sz(array_sum($inc)) . ')'; }
function st_sz($b) { $b = (float)$b; return $b >= 1e6 ? st_gb($b) : max(1, round($b / 1e3)) . ' KB'; }
function st_gb($b) { $b = (float)$b; return $b >= 1e9 ? round($b / 1e9, 1) . ' GB' : round($b / 1e6) . ' MB'; }
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- TOOLS OPERATIONS -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/moveprog.php">
<INLINE><![CDATA[<?php
// Progress of a qBittorrent "Moving" torrent. qBittorrent reports no percentage for a move, so the size of the files that have arrived
// at the destination (on any disk or pool under /mnt, the share path is the same on all of them) is compared with the torrent size.
// Two or more samples (at least 25 s apart) give the speed and with it the time left.
// Returns [fraction 0..0.99, seconds left or -1, waiting]. waiting is true when qBittorrent still reports the content at the place it would move
// to (a queued move has not started: the size there is the size of the source, which must not be shown as progress).
function st_move_dirsize($p) {
    // allocated bytes (blocks), not the file size: a move creates every target file at its full size at once and then fills it
    $al = function ($f) { $st = @stat($f); return $st ? (float)$st['blocks'] * 512 : 0.0; };
    if (is_file($p)) { return $al($p); }
    if (!is_dir($p)) { return 0.0; }
    $s = 0.0;
    try { foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($p, FilesystemIterator::SKIP_DOTS)) as $f) { if ($f->isFile()) { $s += $al($f->getPathname()); } } } catch (Throwable $e) {}
    return $s;
}
function st_move_info($t) {
    $dir = getenv('DBX_ST_DIR'); $dir = ($dir !== false && $dir !== '') ? $dir : '/boot/config/plugins/qbittorrent_widget';
    $c = is_file($dir . '/tools.json') ? json_decode((string)@file_get_contents($dir . '/tools.json'), true) : [];
    $mq = (string)($c['map_qb'] ?? '/data'); $mh = (string)($c['map_host'] ?? '/mnt/user/data');
    // while it moves, qBittorrent reports the SOURCE as content_path (for example /incomplete/...): the destination is save_path + name
    $cp = (string)($t['content_path'] ?? ''); $total = (float)($t['size'] ?? 0);
    if (!empty($t['save_path']) && !empty($t['name'])) { $cp = rtrim((string)$t['save_path'], '/') . '/' . $t['name']; }
    if ($cp === '' || $total <= 0) { return [0.0, -1, false]; }
    $same = rtrim((string)($t['content_path'] ?? ''), '/') === rtrim($cp, '/');
    if ($same) { return [0.0, -1, true]; }
    $host = ($mq !== '' && strpos($cp, $mq . '/') === 0) ? $mh . substr($cp, strlen($mq)) : $cp;
    $f = '/tmp/qbt_move_' . md5((string)($t['hash'] ?? $cp)) . '.json'; $now = time();
    $st = is_file($f) ? json_decode((string)@file_get_contents($f), true) : []; if (!is_array($st)) { $st = []; }
    if (!empty($st['r']) && $now - $st['r'][0] < 30) { return [$st['r'][1], $st['r'][2], false]; } // measured at most every 30 s
    $rel = strpos($host, '/mnt/user/') === 0 ? substr($host, 10) : '';
    $have = 0.0;
    if ($rel !== '') {
        foreach ((array)glob('/mnt/*', GLOB_ONLYDIR) as $root) {
            if (in_array(basename($root), ['user', 'user0', 'disks', 'remotes', 'addons'], true)) { continue; }
            $have += st_move_dirsize($root . '/' . $rel);
        }
    } else { $have = st_move_dirsize($host); }
    $frac = max(0.0, min(0.99, $have / $total));
    $h = (array)($st['s'] ?? []);
    $h = array_values(array_filter($h, function ($s) use ($now) { return $now - $s[0] < 900; }));
    if (!$h || $now - end($h)[0] >= 25) { $h[] = [$now, $have]; }
    $eta = -1; // speed over the last five minutes: steady, and it follows a change
    foreach ($h as $s) {
        if ($now - $s[0] >= 25 && $now - $s[0] <= 300 && $have > $s[1]) { $rate = ($have - $s[1]) / ($now - $s[0]); if ($rate > 0) { $eta = (int)round(max(0, $total - $have) / $rate); } break; }
    }
    @file_put_contents($f, json_encode(['s' => $h, 'r' => [$now, $frac, $eta]]));
    return [$frac, $eta, false];
}
function st_move_eta_txt($s) { if ($s < 0) { return ''; } $h = intdiv($s, 3600); $m = intdiv($s % 3600, 60); return $h > 0 ? $h . 'h ' . str_pad((string)$m, 2, '0', STR_PAD_LEFT) . 'm' : max(1, $m) . 'm'; }
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/tools_packs.php">
<INLINE><![CDATA[<?php
// Season packs: replaces the individually downloaded episodes of a season with the season pack.
// Scan (read-only) -> list; one click on "Replace with pack" starts a job that the tick advances:
//   grabbed -> downloading -> (pack 100 % and checked) -> importing (season files deleted in Sonarr, pack imported) -> cleaned
// Nothing is deleted before the pack is fully downloaded and its file list covers every episode you have.
const ST_SP = '/tmp/qbt_tools_sp.json';

function st_sp_ep($s, $e) { return 'S' . str_pad((string)(int)$s, 2, '0', STR_PAD_LEFT) . 'E' . str_pad((string)(int)$e, 2, '0', STR_PAD_LEFT); }

// episode numbers (of the given season) that appear in a list of file names
function st_sp_epnums($names, $season) {
    $r = [];
    foreach ($names as $n) {
        if (!st_video_ext($n)) { continue; }
        if (preg_match('/S(\d{1,2})E(\d{1,3})(?:[-_.]?E(\d{1,3}))?/i', $n, $m) && (int)$m[1] === (int)$season) {
            $r[(int)$m[2]] = true; if (!empty($m[3]) && (int)$m[3] > (int)$m[2] && (int)$m[3] - (int)$m[2] < 5) { for ($k = (int)$m[2]; $k <= (int)$m[3]; $k++) { $r[$k] = true; } }
        }
    }
    return array_keys($r);
}

// ranks the season packs Sonarr found: resolution not lower than the current one, the same resolution first, then HDR (DV, HDR, SDR), then seeders
function st_sp_rank($rel, $cur_res, $need_hun, $season = 0) {
    $rows = []; $drop = [];
    foreach ((array)$rel as $r) {
        if (!is_array($r) || strtolower((string)($r['protocol'] ?? 'torrent')) !== 'torrent') { continue; }
        if (empty($r['fullSeason'])) { continue; }
        $title = (string)($r['title'] ?? ''); $size = (float)($r['size'] ?? 0);
        if ($size <= 0) { continue; }
        // the pack must be of this season (Sonarr may list packs of other seasons): its own season field, else the S01 in the name; multi-season packs are not used
        if ($season > 0) {
            $rs = (int)($r['seasonNumber'] ?? 0);
            if ($rs > 0 && $rs !== (int)$season) { $drop['other season'] = ($drop['other season'] ?? 0) + 1; continue; }
            if (preg_match_all('/(?<![A-Za-z0-9])S(\d{1,2})(?![0-9]|E\d)/i', $title, $mm)) {
                $ss = array_unique(array_map('intval', $mm[1]));
                if (count($ss) !== 1 || $ss[0] !== (int)$season) { $drop['other season'] = ($drop['other season'] ?? 0) + 1; continue; }
            }
        }
        $res = (int)($r['quality']['quality']['resolution'] ?? 0) ?: st_res_of($title);
        if ($cur_res > 0 && $res > 0 && $res < $cur_res) { $drop['lower resolution'] = ($drop['lower resolution'] ?? 0) + 1; continue; }
        if ((int)($r['seeders'] ?? 0) < 1) { $drop['no seeders'] = ($drop['no seeders'] ?? 0) + 1; continue; }
        $langs = []; foreach ((array)($r['languages'] ?? []) as $l) { $langs[] = (string)($l['name'] ?? ''); }
        $hun = (bool)(preg_grep('/hungar/i', $langs) || preg_match('/\b(hun|hundub|magyar)\b/i', $title));
        if ($need_hun && !$hun) { $drop['not Hungarian'] = ($drop['not Hungarian'] ?? 0) + 1; continue; }
        $hdr = st_hdr_rank($title);
        $rows[] = ['guid' => (string)$r['guid'], 'indexer_id' => (int)($r['indexerId'] ?? 0), 'title' => $title, 'size' => $size, 'res' => $res, 'hdr' => st_hdr_label($hdr), 'hdr_rank' => $hdr,
                   'hun' => $hun, 'seeders' => (int)($r['seeders'] ?? 0), 'indexer' => (string)($r['indexer'] ?? '')];
    }
    usort($rows, function ($a, $b) use ($cur_res) {
        $ea = ($cur_res > 0 && $a['res'] === $cur_res) ? 0 : 1; $eb = ($cur_res > 0 && $b['res'] === $cur_res) ? 0 : 1;
        return [$ea, -$a['hdr_rank'], -$a['seeders']] <=> [$eb, -$b['hdr_rank'], -$b['seeders']];
    });
    return [array_slice($rows, 0, 6), $drop];
}

// qBittorrent torrents that hold single episodes of this season of this series (by name)
function st_sp_old_torrents($title, $season, $epnums, $tor) {
    $sn = st_norm(preg_replace('/\s*\(\d{4}\)\s*$/', '', $title)); $out = [];
    if ($sn === '') { return $out; }
    foreach ((array)$tor as $t) {
        $name = (string)($t['name'] ?? '');
        if (strpos(st_norm($name), $sn) !== 0) { continue; }
        if (!preg_match('/S(\d{1,2})E(\d{1,3})/i', $name, $m) || (int)$m[1] !== (int)$season || !in_array((int)$m[2], $epnums, true)) { continue; }
        if (preg_match('/S\d{1,2}E\d{1,3}[-_.]?E\d{1,3}/i', $name)) { continue; } // multi-episode: not handled
        $out[] = ['hash' => strtolower((string)$t['hash']), 'name' => $name, 'size' => (float)($t['size'] ?? 0), 'ep' => (int)$m[2], 'path' => (string)($t['content_path'] ?? ''), 'state' => (string)($t['state'] ?? '')];
    }
    usort($out, function ($a, $b) { return [$a['ep'], $a['name']] <=> [$b['ep'], $b['name']]; });
    return $out;
}

// is a season of this series seeded as one torrent already? A torrent counts when its name starts with the series (no single episode) and its file list
// holds at least 80 % of the episode numbers we have
function st_sp_seeded_pack($title, $season, $epnums, $tor) {
    $sn = st_norm(preg_replace('/\s*\(\d{4}\)\s*$/', '', $title)); if ($sn === '' || !$tor) { return ''; }
    $need = max(2, (int)ceil(count($epnums) * 0.8)); $n = 0;
    foreach ((array)$tor as $t) {
        $name = (string)($t['name'] ?? '');
        if (strpos(st_norm($name), $sn) !== 0) { continue; }
        if (preg_match('/S\d{1,2}E\d{1,3}/i', $name) && !preg_match('/S\d{1,2}E\d{1,3}[-_.]?E\d{1,3}/i', $name)) { continue; } // a single episode
        if (++$n > 12) { break; }
        // the name may not name the season (a whole-series torrent like "The Shield 1080p"): the file list decides; fetched once per torrent
        $hk = strtolower((string)$t['hash']);
        if (!isset($GLOBALS['st_sp_fc'][$hk])) { $GLOBALS['st_sp_fc'][$hk] = st_qb_json('/api/v2/torrents/files?hash=' . rawurlencode($hk)); }
        $fl = $GLOBALS['st_sp_fc'][$hk];
        if (!is_array($fl)) { continue; }
        $have = array_intersect(st_sp_epnums(array_map(function ($f) { return (string)($f['name'] ?? ''); }, $fl), $season), $epnums);
        if (count($have) >= $need) { return $name; }
    }
    return '';
}

function st_sp_put($state, $msg, $items, $extra = []) {
    st_json_write(ST_SP, array_merge(['state' => $state, 't' => time(), 'msg' => $msg, 'items' => $items], $extra));
}

// One season of a series -> [item, ''] when it is kept as single episodes and Sonarr finds a season pack for it, else [null, reason]
// ('' = not counted). $s: the Sonarr series, $list: its episodes of this season, $fby: its episode files by id, $min: episodes you need.
// An incomplete season counts too (item 6, 2026-10-16: on nCore the season finale often comes only in the pack): the pack must hold
// every episode you have (checked again after the download), the missing ones are imported from it by Sonarr.
function st_sp_item($s, $sn, $list, $fby, $tor, $min = 2) {
    $now = time();
    $have = array_values(array_filter($list, function ($x) use ($fby) { return !empty($x['hasFile']) && isset($fby[(int)($x['episodeFileId'] ?? 0)]); }));
    if (count($have) < $min) { return [null, '']; }
    $future = false; $missing = [];
    foreach ($list as $x) {
        $ts = !empty($x['airDateUtc']) ? strtotime($x['airDateUtc']) : 0;
        if ($ts === 0 || $ts > $now) { $future = true; }
        elseif (empty($x['hasFile']) && !empty($x['monitored'])) { $missing[] = (int)$x['episodeNumber']; }
    }
    if ($future) { return [null, 'airing']; }
    sort($missing);
    // already imported from one download? then it is a pack (or at least seeded as one torrent)
    [$c3, $hist] = st_arr('sonarr', '/history/series?seriesId=' . (int)$s['id'] . '&seasonNumber=' . (int)$sn . '&eventType=3', 'GET', null, 60);
    if (is_array($hist) && $hist) {
        $by = []; foreach ($hist as $h) { if (!empty($h['downloadId'])) { $by[$h['downloadId']][(int)($h['episodeId'] ?? 0)] = 1; } }
        $mx = 0; foreach ($by as $v) { $mx = max($mx, count($v)); }
        if ($mx >= max(2, (int)ceil(count($have) * 0.8))) { return [null, 'already a pack']; }
    }
    $nums0 = array_map(function ($x) { return (int)$x['episodeNumber']; }, $have);
    if (st_sp_seeded_pack((string)$s['title'], $sn, $nums0, $tor) !== '') { return [null, 'already a pack']; }
    $first = $fby[(int)$have[0]['episodeFileId']];
    $cur_res = (int)($first['quality']['quality']['resolution'] ?? 0);
    $langs = []; foreach ((array)($first['languages'] ?? []) as $l) { $langs[] = (string)($l['name'] ?? ''); }
    $need_hun = (bool)preg_grep('/hungar/i', $langs);
    $ef = []; $nums = []; $tot = 0; $hdr = 1;
    foreach ($have as $x) {
        $f = $fby[(int)$x['episodeFileId']];
        $ef[] = ['file' => (int)$f['id'], 'ep_id' => (int)$x['id'], 'ep' => (int)$x['episodeNumber'], 'path' => (string)($f['path'] ?? ''), 'size' => (float)($f['size'] ?? 0), 'monitored' => !empty($x['monitored'])];
        $nums[] = (int)$x['episodeNumber']; $tot += (float)($f['size'] ?? 0);
        $hdr = max($hdr, st_hdr_rank($f['mediaInfo']['videoDynamicRangeType'] ?? ''));
    }
    [$c4, $rel, $re] = st_arr('sonarr', '/release?seriesId=' . (int)$s['id'] . '&seasonNumber=' . (int)$sn, 'GET', null, 240);
    if ($re !== '' || !is_array($rel)) { return [null, 'search failed']; }
    [$packs, $drop] = st_sp_rank($rel, $cur_res, $need_hun, (int)$sn);
    if (!$packs) { return [null, 'no pack']; }
    $old = st_sp_old_torrents((string)$s['title'], $sn, $nums, $tor);
    return [['key' => 'sp' . substr(md5($s['id'] . ':' . $sn), 0, 10), 'series_id' => (int)$s['id'], 'title' => (string)$s['title'], 'season' => (int)$sn,
             'cur_res' => $cur_res, 'cur_quality' => (string)($first['quality']['quality']['name'] ?? ''), 'cur_hdr' => $hdr, 'cur_size' => $tot, 'need_hun' => $need_hun,
             'files' => $ef, 'missing' => $missing, 'old' => $old, 'old_size' => array_sum(array_column($old, 'size')), 'packs' => $packs, 'dropped' => $drop], ''];
}

function st_sp_scan($filter = '') {
    $GLOBALS['st_sp_fc'] = [];
    $filter = trim((string)$filter); $fn = st_norm($filter); $items = [];
    st_sp_put('running', 'Reading Sonarr...', []);
    [$c, $series, $e] = st_arr('sonarr', '/series', 'GET', null, 120);
    if ($e !== '' || !is_array($series)) { st_sp_put('error', 'Sonarr: ' . ($e ?: 'bad response'), []); return; }
    $tor = st_lib_in(st_qb_torrents(), st_cfg()); $now = time(); $n = 0; $total = count($series); $skipped = ['airing' => 0, 'already a pack' => 0, 'no pack' => 0];
    foreach ($series as $s) {
        $n++;
        if (empty($s['monitored'])) { continue; } // finished series you keep (unmonitored) are left alone
        $smon = []; foreach ((array)($s['seasons'] ?? []) as $ss) { $smon[(int)$ss['seasonNumber']] = !empty($ss['monitored']); }
        if ($fn !== '' && strpos(st_norm($s['title'] ?? ''), $fn) === false) { continue; }
        st_sp_put('running', $n . '/' . $total . ' ' . ($s['title'] ?? '') . ' (' . count($items) . ' found)', $items, ['skipped' => $skipped]);
        [$c1, $files] = st_arr('sonarr', '/episodefile?seriesId=' . (int)$s['id'], 'GET', null, 60);
        [$c2, $eps] = st_arr('sonarr', '/episode?seriesId=' . (int)$s['id'], 'GET', null, 60);
        if (!is_array($files) || !is_array($eps)) { continue; }
        $fby = []; foreach ($files as $f) { $fby[(int)$f['id']] = $f; }
        $bySeason = [];
        foreach ($eps as $ep) { if ((int)$ep['seasonNumber'] > 0) { $bySeason[(int)$ep['seasonNumber']][] = $ep; } }
        foreach ($bySeason as $sn => $list) {
            if (isset($smon[$sn]) && !$smon[$sn]) { continue; } // unmonitored season
            [$it, $why] = st_sp_item($s, (int)$sn, $list, $fby, $tor);
            if ($it) { $items[] = $it; } elseif ($why !== '') { $skipped[$why] = ($skipped[$why] ?? 0) + 1; }
        }
    }
    st_sp_put('ready', '', $items, ['skipped' => $skipped, 'filter' => $filter]);
    if ($filter === '') { st_sum_set('rep', ['n' => count($items)]); }
}

// ---- the job --------------------------------------------------------------------------------------------------
function st_sp_start($key, $guid = '') {
    $sp = st_json_read(ST_SP, []); $it = null;
    foreach ((array)($sp['items'] ?? []) as $x) { if ($x['key'] === $key) { $it = $x; } }
    foreach (st_sp_ab_list() as $x) { if ($x['key'] === $key) { $it = $x; } } // a pack from autobrr is the newer find
    if (!$it) { return [false, 'unknown season (scan again)']; }
    $pack = null; foreach ($it['packs'] as $p) { if ($guid === '' ? $pack === null : $p['guid'] === $guid) { $pack = $p; if ($guid === '') { break; } } }
    if (!$pack) { return [false, 'unknown pack (scan again)']; }
    $lk = st_action_lock(); if (!$lk) { return [false, 'another replacement is being started right now; try again in a minute']; }
    try { return st_sp_start_do($key, $it, $pack); } finally { st_action_unlock($lk); }
}
function st_sp_start_do($key, $it, $pack) {
    $state = st_state();
    foreach ((array)($state['packjobs'] ?? []) as $j) { if ($j['key'] === $key && !in_array($j['stage'], ['done', 'failed', 'blocked'], true)) { return [false, 'this season is already being replaced']; } }
    [$code, $r, $err] = st_arr('sonarr', '/release', 'POST', ['guid' => $pack['guid'], 'indexerId' => $pack['indexer_id']], 60);
    if ($err !== '' && stripos($err, 'cache') !== false) {
        // the search result expired in Sonarr: search again and use the same release
        [$c4, $rel] = st_arr('sonarr', '/release?seriesId=' . (int)$it['series_id'] . '&seasonNumber=' . (int)$it['season'], 'GET', null, 240);
        $g2 = ''; foreach ((array)$rel as $x) { if (is_array($x) && ($x['guid'] ?? '') === $pack['guid'] || (($x['title'] ?? '') === $pack['title'] && !empty($x['fullSeason']))) { $g2 = (string)$x['guid']; $pack['indexer_id'] = (int)($x['indexerId'] ?? $pack['indexer_id']); } }
        if ($g2 === '') { return [false, 'Sonarr no longer offers this pack (scan again)']; }
        [$code, $r, $err] = st_arr('sonarr', '/release', 'POST', ['guid' => $g2, 'indexerId' => $pack['indexer_id']], 60);
    }
    if ($err !== '') { return [false, 'Sonarr refused the release: ' . $err]; }
    $job = ['id' => substr(md5($key . microtime()), 0, 10), 'key' => $key, 'series_id' => $it['series_id'], 'title' => $it['title'], 'season' => $it['season'],
        'pack' => $pack['title'], 'pack_size' => $pack['size'], 'files' => $it['files'], 'old' => $it['old'], 'cur_res' => $it['cur_res'], 'stage' => 'grabbed', 'msg' => 'sent to Sonarr, waiting for the download to start',
        't' => time(), 'gt' => time(), 'hash' => ''];
    st_state_update(function (&$s) use ($job) { $s['packjobs'][] = $job; });
    st_notify('i', st_l('Seedbox: évadpakk csere elindítva', 'Seedbox: season pack replacement started'), st_l('A pakk letöltése után, ellenőrzéssel cserélem az epizódokat; addig semmi nem törlődik.', 'The episodes are replaced after the pack is downloaded and checked; nothing is deleted before that.'),
        [[st_l('Sorozat', 'Series'), $it['title'] . ' ' . 'S' . str_pad((string)$it['season'], 2, '0', STR_PAD_LEFT)], [st_l('Pakk', 'Pack'), $pack['title'] . ' (' . st_gb($pack['size']) . ', ' . $pack['seeders'] . ' seeder)']], false, 'rep');
    return [true, ''];
}

// episode ids -> monitored on/off (Sonarr bulk call)
function st_sp_monitor($ids, $on) {
    if (!$ids) { return ''; }
    [$c, $r, $e] = st_arr('sonarr', '/episode/monitor', 'PUT', ['episodeIds' => array_values($ids), 'monitored' => (bool)$on], 60);
    return $e;
}
function st_sp_fail(&$j, $msg) {
    $j['stage'] = 'blocked'; $j['msg'] = $msg; $j['t'] = time();
    st_notify('a', st_l('Seedbox: az évadpakk csere elakadt', 'Seedbox: season pack replacement is stuck'), $msg,
        [[st_l('Sorozat', 'Series'), $j['title'] . ' S' . str_pad((string)$j['season'], 2, '0', STR_PAD_LEFT)], [st_l('Pakk', 'Pack'), $j['pack']]], false, 'rep');
}

// advances one job; returns true when it changed
function st_sp_step(&$j, $tor) {
    $stage = $j['stage']; $cfg = st_cfg();
    if (in_array($stage, ['done', 'failed', 'blocked'], true)) { return false; }
    $by = []; foreach ((array)$tor as $t) { $by[strtolower((string)$t['hash'])] = $t; }
    $pt = null;
    if (!empty($j['hash'])) { $pt = $by[$j['hash']] ?? null; }
    else {
        foreach ((array)$tor as $t) { if (st_norm($t['name'] ?? '') === st_norm($j['pack']) && (int)($t['added_on'] ?? 0) >= (int)$j['gt'] - 600) { $pt = $t; $j['hash'] = strtolower((string)$t['hash']); st_qb('/api/v2/torrents/addTags', ['hashes' => $t['hash'], 'tags' => 'seasonrepacker']); break; } }
    }
    if ($stage === 'grabbed' || $stage === 'downloading') {
        if (!$pt) {
            if (time() - (int)$j['gt'] > 1800) { st_sp_fail($j, 'the pack did not show up in qBittorrent within 30 minutes: check Sonarr, Activity, Queue. Nothing was deleted.'); return true; }
            return false;
        }
        $prog = (float)$pt['progress'];
        if ($prog < 0.99999) { $m = 'downloading ' . number_format($prog * 100, 1, '.', '') . '%'; if ($j['stage'] !== 'downloading' || $m !== $j['msg']) { $j['stage'] = 'downloading'; $j['msg'] = $m; return true; } return false; }
        if (preg_match('/^(checking|allocating|moving|metaDL)/', (string)$pt['state'])) {
            $m = 'downloaded, ' . (string)$pt['state'];
            if ((string)$pt['state'] === 'moving') { [$fr, $eta] = st_move_info($pt); $m = 'moving ' . number_format($fr * 100, 1, '.', '') . '%' . ($eta >= 0 ? ', about ' . st_move_eta_txt($eta) . ' left' : ''); }
            if ($m !== $j['msg']) { $j['msg'] = $m; return true; }
            return false;
        }
        // downloaded: does its file list cover every episode we have?
        $fl = st_qb_json('/api/v2/torrents/files?hash=' . rawurlencode($j['hash']));
        if (!is_array($fl) || !$fl) { return false; }
        $names = array_map(function ($f) { return (string)($f['name'] ?? ''); }, $fl);
        $packEps = st_sp_epnums($names, $j['season']);
        $want = array_map(function ($f) { return (int)$f['ep']; }, $j['files']);
        $miss = array_values(array_diff($want, $packEps));
        if ($miss) { st_sp_fail($j, 'the pack does not contain episode(s) ' . implode(', ', $miss) . ' that you have; nothing was deleted or changed.'); return true; }
        if (count($packEps) < count($want)) { st_sp_fail($j, 'the pack has fewer episodes than you have; nothing was deleted or changed.'); return true; }
        // Sonarr may have imported the pack by itself already (an upgrade it accepts): then there is nothing to delete
        [$cE, $curEps] = st_arr('sonarr', '/episode?seriesId=' . (int)$j['series_id'] . '&seasonNumber=' . (int)$j['season']);
        if (!is_array($curEps)) { return false; }
        $oldIds = array_map(function ($f) { return (int)$f['file']; }, $j['files']); $live = [];
        $got = 0; foreach ($curEps as $ep) {
            $fid = (int)($ep['episodeFileId'] ?? 0);
            if (in_array((int)$ep['episodeNumber'], $want, true) && $fid > 0 && !in_array($fid, $oldIds, true)) { $got++; }
            if ($fid > 0 && in_array($fid, $oldIds, true)) { $live[] = $fid; }
        }
        if ($got >= count($want)) { $j['packeps'] = count($packEps); $j['stage'] = 'imported'; $j['msg'] = 'Sonarr already imported the pack (' . $got . ' episodes)'; $j['t'] = time(); return true; }
        // the old files are already gone (a restart between the delete and the saved state): go on waiting for the import
        if (!$live) { $j['packeps'] = count($packEps); $j['stage'] = 'importing'; $j['msg'] = 'season files deleted in Sonarr, waiting for the import of the pack'; $j['t'] = time(); $j['dt'] = time(); return true; }
        // go: remember monitoring, unmonitor the episodes (no other release may be grabbed meanwhile), delete the season files in Sonarr
        $j['packeps'] = count($packEps); $j['pack_path'] = (string)($pt['content_path'] ?? '');
        $e = st_sp_monitor(array_map(function ($f) { return (int)$f['ep_id']; }, $j['files']), false);
        if ($e !== '') { st_sp_fail($j, 'could not unmonitor the episodes in Sonarr: ' . $e . '. Nothing was deleted.'); return true; }
        [$c, $r, $e] = st_arr('sonarr', '/episodefile/bulk', 'DELETE', ['episodeFileIds' => array_values($live)], 120);
        if ($e !== '') {
            st_sp_monitor(array_map(function ($f) { return (int)$f['ep_id']; }, array_filter($j['files'], function ($f) { return !empty($f['monitored']); })), true);
            st_sp_fail($j, 'Sonarr refused to delete the season files: ' . $e . '. Nothing was changed.'); return true;
        }
        $j['stage'] = 'importing'; $j['msg'] = 'season files deleted in Sonarr, waiting for the import of the pack'; $j['t'] = time(); $j['dt'] = time();
        return true;
    }
    if ($stage === 'importing') {
        [$c, $eps] = st_arr('sonarr', '/episode?seriesId=' . (int)$j['series_id'] . '&seasonNumber=' . (int)$j['season']);
        if (!is_array($eps)) { return false; }
        $oldIds = array_map(function ($f) { return (int)$f['file']; }, $j['files']); $want = array_map(function ($f) { return (int)$f['ep']; }, $j['files']);
        $got = 0; foreach ($eps as $ep) { if (in_array((int)$ep['episodeNumber'], $want, true) && (int)($ep['episodeFileId'] ?? 0) > 0 && !in_array((int)$ep['episodeFileId'], $oldIds, true)) { $got++; } }
        if ($got >= count($want)) { $j['stage'] = 'imported'; $j['msg'] = 'Sonarr imported ' . $got . ' episodes from the pack'; $j['t'] = time(); return true; }
        $age = time() - (int)$j['dt'];
        $m = 'waiting for the import: ' . $got . '/' . count($want) . ' episodes';
        if ($age > 120 && empty($j['scanned'])) {
            // Sonarr did not pick it up by itself: ask it to scan the finished download
            $did = ''; [$cq, $q] = st_arr('sonarr', '/queue?page=1&pageSize=200');
            foreach ((array)($q['records'] ?? []) as $r) { if ((int)($r['seriesId'] ?? 0) === (int)$j['series_id'] && !empty($r['downloadId'])) { $did = (string)$r['downloadId']; } }
            $path = (string)($j['pack_path'] ?? '');
            $cmd = ['name' => 'DownloadedEpisodesScan', 'path' => $path, 'importMode' => 'auto'];
            if ($did !== '') { $cmd['downloadClientId'] = $did; }
            if ($path !== '') { [$cc, $rr, $ee] = st_arr('sonarr', '/command', 'POST', $cmd, 60); $j['scanned'] = 1; $m .= $ee !== '' ? ' (scan request failed: ' . $ee . ')' : ' (asked Sonarr to scan the download)'; }
        }
        if ($age > 900) {
            st_sp_monitor(array_map(function ($f) { return (int)$f['ep_id']; }, array_filter($j['files'], function ($f) { return !empty($f['monitored']); })), true);
            st_sp_fail($j, 'Sonarr did not import the pack within 15 minutes (' . $got . '/' . count($want) . ' episodes). The files of the old episodes are still in the downloads folder and the pack is seeding: import the pack by hand in Sonarr, Activity, Queue.'); return true;
        }
        if ($m !== $j['msg']) { $j['msg'] = $m; return true; }
        return false;
    }
    if ($stage === 'imported') {
        // monitoring back as it was, then the single-episode torrents go to the trash folder
        $e = st_sp_monitor(array_map(function ($f) { return (int)$f['ep_id']; }, array_filter($j['files'], function ($f) { return !empty($f['monitored']); })), true);
        $notes = [];
        if ($e !== '') { $notes[] = 'monitoring could not be restored: ' . $e; }
        $cl = 0; $paths = [];
        // first take every single-episode torrent out of qBittorrent (files kept), then move each folder once: two torrents can share a folder
        foreach ((array)$j['old'] as $o) {
            if (!empty($j['hash']) && strtolower($o['hash']) === $j['hash']) { continue; }
            st_qb('/api/v2/torrents/delete', ['hashes' => $o['hash'], 'deleteFiles' => 'false']); st_watch_forget($o['hash']);
            $paths[st_to_host((string)$o['path'], $cfg)] = $o['name'];
        }
        foreach ($paths as $hp => $nm) {
            [$ok, $m] = st_cleanup_old(['hash' => '', 'old_path' => $hp, 'media_paths' => []]);
            if ($ok) { $cl++; } elseif (strpos($m, 'is not inside') === false && !file_exists($hp)) { $cl++; } else { $notes[] = $nm . ': ' . $m; }
        }
        st_find_prune();
        $j['stage'] = 'done'; $j['t'] = time();
        $j['msg'] = 'done: ' . count($j['files']) . ' episodes now come from the pack, ' . $cl . ' single-episode folder(s) moved to the trash' . ($notes ? '; ' . implode('; ', array_slice($notes, 0, 3)) : '');
        st_notify($notes ? 'a' : 'g', st_l('Seedbox: évadpakk csere kész', 'Seedbox: season pack replacement done'), st_l('Az epizódok a pakkból vannak importálva, az egyedi torrentek a kukába kerültek.', 'The episodes are imported from the pack; the single-episode torrents went to the trash.') . ($notes ? "\n" . implode("\n", array_slice($notes, 0, 3)) : ''),
            [[st_l('Sorozat', 'Series'), $j['title'] . ' S' . str_pad((string)$j['season'], 2, '0', STR_PAD_LEFT)], [st_l('Pakk', 'Pack'), $j['pack']]], false, 'rep');
        return true;
    }
    return false;
}

function st_sp_tick(&$state, $tor) {
    $ch = false;
    foreach ($state['packjobs'] as &$j) { if (st_sp_step($j, $tor)) { $ch = true; } }
    unset($j);
    $keep = [];
    foreach ($state['packjobs'] as $j) { if (in_array($j['stage'], ['done', 'failed'], true) && time() - (int)$j['t'] > 7 * 86400) { $ch = true; continue; } $keep[] = $j; }
    $state['packjobs'] = $keep;
    return $ch;
}
function st_sp_active($state) {
    foreach ((array)($state['packjobs'] ?? []) as $j) { if (!in_array($j['stage'], ['done', 'failed', 'blocked'], true)) { return true; } }
    return false;
}
function st_sp_clear() {
    st_state_update(function (&$s) { $s['packjobs'] = array_values(array_filter((array)($s['packjobs'] ?? []), function ($j) { return !in_array($j['stage'], ['done', 'failed', 'blocked'], true); })); });
}

// ---- autobrr watch (phase 1: only a Discord message) ---------------------------------------------------------
// The tick asks autobrr every 5 minutes (GET) for the releases its filters let through. A new season pack of a monitored series is
// checked with Sonarr (GET /parse, episodes, files): at least one episode of the season is here, the pack is not of a lower
// resolution, Hungarian when the episodes are, and the season is not one torrent already. Then one Discord message. Nothing is started.
const ST_AB = '/tmp/qbt_tools_ab.json';
function st_ab_seen_file() { return dirname(st_state_file()) . '/ab_seen.json'; }

function st_ab_get($path, $timeout = 20) {
    $c = $GLOBALS['st_ab_override'] ?? (st_cfg()['autobrr'] ?? ['url' => '', 'key' => '']); // override: the Load filters button before Save
    $url = rtrim((string)$c['url'], '/');
    if ($url === '' || $c['key'] === '') { return [0, null, 'autobrr is not configured']; }
    [$code, $body, $err] = st_http('GET', $url . '/api' . $path, ['headers' => ['X-API-Token: ' . $c['key'], 'Accept: application/json'], 'timeout' => $timeout, 'follow' => true]);
    if ($err) { return [0, null, $err]; }
    $j = json_decode($body, true);
    if ($code >= 400) { return [$code, $j, 'HTTP ' . $code]; }
    return [$code, $j, ''];
}

// the releases autobrr stored (newest first in autobrr), as [id, name, size, indexer, filter]; the field names differ a little between versions
function st_ab_releases($limit = 100) {
    [$c, $j, $e] = st_ab_get('/release?limit=' . (int)$limit . '&offset=0');
    if ($e !== '') { return [null, $e]; }
    $rows = is_array($j) ? ($j['data'] ?? (isset($j[0]) ? $j : null)) : null;
    if (!is_array($rows)) { return [null, 'unexpected answer from autobrr']; }
    $out = [];
    foreach ($rows as $r) {
        if (!is_array($r) || (int)($r['id'] ?? 0) <= 0) { continue; }
        $ix = $r['indexer'] ?? '';
        $ix = is_array($ix) ? (string)($ix['name'] ?? ($ix['identifier'] ?? '')) : (string)$ix;
        $name = (string)($r['name'] ?? ($r['torrent_name'] ?? ($r['title'] ?? '')));
        if ($name === '') { continue; }
        $fl = $r['filter'] ?? ($r['filter_name'] ?? '');
        $out[] = ['id' => (int)$r['id'], 'name' => $name, 'size' => (float)($r['size'] ?? 0), 'indexer' => $ix, 'filter' => is_array($fl) ? (string)($fl['name'] ?? '') : (string)$fl];
    }
    usort($out, function ($a, $b) { return $a['id'] <=> $b['id']; });
    return [$out, ''];
}

// the filters of autobrr: [[name, enabled], ...]
function st_ab_filters() {
    [$c, $j, $e] = st_ab_get('/filters');
    if ($e !== '') { return [null, $e]; }
    $rows = is_array($j) ? ($j['data'] ?? $j) : null;
    if (!is_array($rows)) { return [null, 'unexpected answer from autobrr']; }
    $out = [];
    foreach ($rows as $f) { if (is_array($f) && ($f['name'] ?? '') !== '') { $out[] = ['name' => (string)$f['name'], 'enabled' => !empty($f['enabled'])]; } }
    usort($out, function ($a, $b) { return strnatcasecmp($a['name'], $b['name']); });
    return [$out, ''];
}

// cheap checks on the name alone, before Sonarr is asked: one episode (S02E01, S02E01-E03), or not a filter that was chosen
function st_ab_quick($rel, $filters) {
    if ($filters && !in_array($rel['filter'], $filters, true)) { return 'from filter ' . ($rel['filter'] !== '' ? $rel['filter'] : '(none)') . ', not chosen'; }
    if (preg_match('/(?<![A-Za-z0-9])S\d{1,2}[ ._-]?E\d{1,4}/i', $rel['name'])) { return 'one episode'; }
    return '';
}

// free space where the series are downloaded: the root with SOROZAT or TV in its name, else the first one
function st_ab_free() {
    $c = st_cfg(); $p = ((array)$c['series_dirs'])[0] ?? (((array)$c['roots'])[0] ?? '');
    $f = $p !== '' ? @disk_free_space($p) : false;
    return $f === false ? -1 : (float)$f;
}

// one release -> ['go' => bool, 'why' => text, ...]; 'retry' => true when Sonarr could not answer (ask again at the next poll)
function st_ab_eval($rel, &$tor) {
    [$c, $p, $e] = st_arr('sonarr', '/parse?title=' . rawurlencode($rel['name']), 'GET', null, 30);
    if ($e !== '' || !is_array($p)) { return ['go' => false, 'retry' => true, 'why' => 'Sonarr: ' . ($e ?: 'bad response')]; }
    $pe = (array)($p['parsedEpisodeInfo'] ?? []);
    if (empty($pe['fullSeason'])) { return ['go' => false, 'why' => 'not a season pack']; }
    if (!empty($pe['isMultiSeason'])) { return ['go' => false, 'why' => 'more than one season']; }
    $sn = (int)($pe['seasonNumber'] ?? 0); if ($sn < 1) { return ['go' => false, 'why' => 'specials']; }
    $ser = (array)($p['series'] ?? []); $sid = (int)($ser['id'] ?? 0);
    if ($sid <= 0) { return ['go' => false, 'why' => 'the series is not in Sonarr']; }
    $title = (string)($ser['title'] ?? $rel['name']); $tag = $title . ' S' . str_pad((string)$sn, 2, '0', STR_PAD_LEFT);
    if (empty($ser['monitored'])) { return ['go' => false, 'why' => $tag . ': the series is not monitored']; }
    foreach ((array)($ser['seasons'] ?? []) as $ss) { if ((int)($ss['seasonNumber'] ?? -1) === $sn && empty($ss['monitored'])) { return ['go' => false, 'why' => $tag . ': the season is not monitored']; } }
    foreach ((array)(st_state()['packjobs'] ?? []) as $j) { if ((int)$j['series_id'] === $sid && (int)$j['season'] === $sn && !in_array($j['stage'], ['done', 'failed', 'blocked'], true)) { return ['go' => false, 'why' => $tag . ': a pack replacement of this season is under way']; } }
    [$c1, $eps, $e1] = st_arr('sonarr', '/episode?seriesId=' . $sid . '&seasonNumber=' . $sn, 'GET', null, 60);
    [$c2, $files, $e2] = st_arr('sonarr', '/episodefile?seriesId=' . $sid, 'GET', null, 60);
    if (!is_array($eps) || !is_array($files)) { return ['go' => false, 'retry' => true, 'why' => 'Sonarr: ' . ($e1 ?: ($e2 ?: 'bad response'))]; }
    $fby = []; foreach ($files as $f) { $fby[(int)$f['id']] = $f; }
    $have = []; $aired = 0; $missing = []; $now = time();
    foreach ($eps as $x) {
        if ((int)($x['seasonNumber'] ?? -1) !== $sn) { continue; }
        $ts = !empty($x['airDateUtc']) ? strtotime($x['airDateUtc']) : 0;
        if ($ts > 0 && $ts <= $now) { $aired++; }
        if (!empty($x['hasFile']) && isset($fby[(int)($x['episodeFileId'] ?? 0)])) { $have[] = $x; }
        elseif ($ts > 0 && $ts <= $now && !empty($x['monitored'])) { $missing[] = (int)$x['episodeNumber']; }
    }
    if (!$have) { return ['go' => false, 'why' => $tag . ': no episode of this season yet (that is the job of Sonarr)']; }
    $first = $fby[(int)$have[0]['episodeFileId']];
    $cur_res = (int)($first['quality']['quality']['resolution'] ?? 0);
    $langs = []; foreach ((array)($first['languages'] ?? []) as $l) { $langs[] = (string)($l['name'] ?? ''); }
    $need_hun = (bool)preg_grep('/hungar/i', $langs);
    $res = (int)($pe['quality']['quality']['resolution'] ?? 0) ?: st_res_of($rel['name']);
    if ($cur_res > 0 && $res > 0 && $res < $cur_res) { return ['go' => false, 'why' => $tag . ': lower resolution (' . $res . 'p, you have ' . $cur_res . 'p)']; }
    $pl = []; foreach ((array)($p['languages'] ?? ($pe['languages'] ?? [])) as $l) { $pl[] = is_array($l) ? (string)($l['name'] ?? '') : (string)$l; }
    $hun = (bool)(preg_grep('/hungar/i', $pl) || preg_match('/\b(hun|hundub|magyar)\b/i', $rel['name']));
    if ($need_hun && !$hun) { return ['go' => false, 'why' => $tag . ': not Hungarian (your episodes are)']; }
    $nums = array_map(function ($x) { return (int)$x['episodeNumber']; }, $have);
    [$c3, $hist] = st_arr('sonarr', '/history/series?seriesId=' . $sid . '&seasonNumber=' . $sn . '&eventType=3', 'GET', null, 60);
    if (is_array($hist) && $hist) {
        $by = []; foreach ($hist as $h) { if (!empty($h['downloadId'])) { $by[$h['downloadId']][(int)($h['episodeId'] ?? 0)] = 1; } }
        $mx = 0; foreach ($by as $v) { $mx = max($mx, count($v)); }
        if ($mx >= max(2, (int)ceil(count($have) * 0.8))) { return ['go' => false, 'why' => $tag . ': already imported from one pack']; }
    }
    if ($tor === null) { $tor = st_qb_torrents() ?? []; }
    $tor = st_lib_in($tor, st_cfg()); // a ratio torrent (downloads/TL) is not the library's pack
    if (count($have) >= 2 && st_sp_seeded_pack($title, $sn, $nums, $tor) !== '') { return ['go' => false, 'why' => $tag . ': already seeded as one torrent']; }
    $cur_size = 0; foreach ($have as $x) { $cur_size += (float)($fby[(int)$x['episodeFileId']]['size'] ?? 0); }
    return ['go' => true, 'why' => $tag . ': new season pack', 'series_id' => $sid, 'title' => $title, 'season' => $sn, 'tag' => $tag, 'res' => $res, 'hun' => $hun,
            'cur_res' => $cur_res, 'cur_quality' => (string)($first['quality']['quality']['name'] ?? ''), 'cur_size' => $cur_size, 'have' => count($have), 'aired' => $aired, 'missing' => $missing];
}

function st_ab_message($rel, $v) {
    $free = st_ab_free();
    $miss = $v['missing'] ? implode(', ', array_map(function ($n) { return 'E' . str_pad((string)$n, 2, '0', STR_PAD_LEFT); }, array_slice($v['missing'], 0, 15))) . (count($v['missing']) > 15 ? ' ...' : '') : '';
    $packTxt = $rel['name'] . "\n" . ($rel['size'] > 0 ? st_gb($rel['size']) . ', ' : '') . ($v['res'] > 0 ? $v['res'] . 'p' : '?') . ($v['hun'] ? ', HUN' : '') . ($rel['indexer'] !== '' ? ', ' . $rel['indexer'] : '');
    $haveTxt = $v['have'] . '/' . max($v['have'], $v['aired']) . st_l(' epizód', ' episodes') . ', ' . ($v['cur_quality'] !== '' ? $v['cur_quality'] : ($v['cur_res'] . 'p')) . ', ' . st_gb($v['cur_size']);
    $desc = st_l('Az autobrr új évadpakkot látott egy figyelt évadhoz. Nem indítottam semmit.', 'autobrr saw a new season pack of a monitored season. Nothing was started.') . "\n"
          . st_l('Csere: Seedbox Tools, Season repacker, From autobrr, Replace with pack (a sor pár perc múlva ott van).', 'To replace: Seedbox Tools, Season repacker, From autobrr, Replace with pack (the row is there in a few minutes).')
          . ($v['missing'] ? "\n" . st_l('Az évad hiányos nálad: a hiányzó részeket (gyakran az évadzárót) a pakkból hozza.', 'The season is incomplete here: the missing episodes (often the finale) come from the pack.') : '');
    return st_notify('i', st_l('Seedbox: évadpakk érkezett', 'Seedbox: a season pack arrived') . ' · ' . $v['tag'], $desc,
        [[st_l('Pakk', 'Pack'), $packTxt], [st_l('Nálad', 'You have'), $haveTxt], [st_l('Hiányzik', 'Missing'), $miss],
         [st_l('Szabad hely', 'Free space'), $free >= 0 ? st_gb($free) . ($rel['size'] > 0 && $free < $rel['size'] * 1.1 ? st_l(' (KEVÉS)', ' (NOT ENOUGH)') : '') : '']], true, 'rep');
}

// called by the tick; $force skips the 5 minute wait (Test button)
function st_ab_poll($force = false) {
    $cfg = st_cfg();
    if (empty($cfg['ab_on']) || ($cfg['autobrr']['url'] ?? '') === '' || ($cfg['autobrr']['key'] ?? '') === '') { return; }
    $w = st_json_read(ST_AB, []);
    if (!$force && time() - (int)($w['t'] ?? 0) < 300) { return; }
    $w['t'] = time();
    [$rels, $e] = st_ab_releases(100);
    if ($rels === null) { $w['err'] = $e; st_json_write(ST_AB, $w); return; }
    $w['err'] = '';
    $max = 0; foreach ($rels as $r) { $max = max($max, $r['id']); }
    if (!isset($w['last_id'])) { $w['last_id'] = $max; $w['since'] = time(); $w['recent'] = []; st_json_write(ST_AB, $w); return; } // first run: only what comes from now on
    if ($max < (int)$w['last_id']) { $w['last_id'] = $max; } // autobrr's list was cleared
    $seen = st_json_read(st_ab_seen_file(), []); $seenCh = false; $tor = null; $n = 0; $abq = [];
    foreach ($seen as $k => $t) { if (time() - (int)$t > 30 * 86400) { unset($seen[$k]); $seenCh = true; } }
    $recent = (array)($w['recent'] ?? []);
    foreach ($rels as $r) {
        if ($r['id'] <= (int)$w['last_id']) { continue; }
        $q = st_ab_quick($r, (array)($cfg['ab_filters'] ?? []));
        if ($q !== '') { $w['last_id'] = $r['id']; $w['skipped'] = (int)($w['skipped'] ?? 0) + 1; continue; } // not listed: most of the feed is single episodes
        if (++$n > 20) { break; } // the rest at the next poll
        $v = st_ab_eval($r, $tor);
        if (!empty($v['retry'])) {
            // Sonarr did not answer: try this release again at the next poll, three times at most
            $w['err'] = $v['why']; $w['fail_n'] = (($w['fail_id'] ?? 0) === $r['id']) ? (int)($w['fail_n'] ?? 0) + 1 : 1; $w['fail_id'] = $r['id'];
            if ($w['fail_n'] < 3) { break; }
        }
        $w['last_id'] = $r['id'];
        if ($v['go']) {
            $key = $v['series_id'] . ':' . $v['season'] . ':' . st_norm($r['name']);
            if (isset($seen[$key])) { $v['why'] .= ' (already reported)'; }
            else {
                $bot = st_bot_on('sp');
                $abq[] = ['series_id' => $v['series_id'], 'season' => $v['season'], 'name' => $r['name'], 'indexer' => $r['indexer'], 'size' => $r['size'], 't' => time(), 'tries' => 0] + ($bot ? ['rel' => $r, 'v' => $v] : []);
                if ($bot) { $ok = true; $v['why'] .= ', the Discord message with the choices follows when Sonarr lists the pack'; }
                else { [$ok, $er] = st_ab_message($r, $v); $v['why'] .= $ok ? ', reported on Discord' : ', Discord: ' . $er; }
                $seen[$key] = time(); $seenCh = true;
            }
        }
        $recent[] = ['t' => time(), 'name' => $r['name'], 'why' => $v['why'], 'go' => $v['go'] ? 1 : 0];
    }
    $w['recent'] = array_slice($recent, -15);
    if ($seenCh) { st_json_write(st_ab_seen_file(), $seen); }
    st_json_write(ST_AB, $w);
    if ($abq) { st_sp_ab_update(function (&$d) use ($abq) { foreach ($abq as $q) { $d['queue'][] = $q; } }); }
    if ($abq || st_sp_ab_due()) { st_sp_ab_spawn(); }
}

// ---- autobrr finds as Season repacker rows (item 6, 2026-10-16) ------------------------------------------------------
// A pack the watch reported is queued; a background worker (tools_run.php spab) builds the same row as the library scan
// (st_sp_item: Sonarr search of the season, the autobrr release first when Sonarr lists it) into sp_ab.json next to the state.
// The row leaves the list when it is started (its job shows in Activity; it comes back if the job fails), dismissed, or 7 days old.
// Nothing is started by itself.
function st_sp_ab_file() { return dirname(st_state_file()) . '/sp_ab.json'; }
function st_sp_ab_update($fn) {
    $f = st_sp_ab_file(); $lk = @fopen($f . '.lock', 'c'); if ($lk) { flock($lk, LOCK_EX); }
    $d = st_json_read($f, []); $d += ['items' => [], 'queue' => []]; $o = json_encode($d);
    $fn($d);
    if (json_encode($d) !== $o) { st_json_write($f, $d); }
    if ($lk) { flock($lk, LOCK_UN); fclose($lk); }
    return $d;
}
// the rows to show: not dismissed, younger than 7 days, not being replaced right now
function st_sp_ab_list() {
    $d = st_json_read(st_sp_ab_file(), []); $busy = [];
    foreach ((array)(st_state()['packjobs'] ?? []) as $j) { if (($j['stage'] ?? '') !== 'failed') { $busy[$j['key']] = 1; } }
    return array_values(array_filter((array)($d['items'] ?? []), function ($x) use ($busy) {
        return empty($x['dismissed']) && time() - (int)($x['t'] ?? 0) < 7 * 86400 && !isset($busy[$x['key']]);
    }));
}
function st_sp_ab_due() {
    $d = st_json_read(st_sp_ab_file(), []);
    foreach ((array)($d['queue'] ?? []) as $q) { if (time() >= (int)($q['next'] ?? 0)) { return true; } }
    return false;
}
function st_sp_ab_spawn() {
    $php = '/usr/bin/php'; foreach (['/usr/bin/php', '/usr/local/bin/php'] as $p) { if (is_executable($p)) { $php = $p; break; } }
    @exec('setsid nohup ' . escapeshellarg($php) . ' ' . escapeshellarg(__DIR__ . '/tools_run.php') . ' spab >/dev/null 2>&1 &');
}
// the BoxBot message of a new row: the first three packs as choices
function st_sp_ab_bot($it, $q) {
    $v = (array)$q['v']; $miss = (array)($it['missing'] ?? []);
    $have = count($it['files']) . '/' . (count($it['files']) + count($miss)) . st_l(' epizód', ' episodes') . ', ' . ($it['cur_quality'] !== '' ? $it['cur_quality'] : $it['cur_res'] . 'p') . ', ' . st_gb($it['cur_size']) . ', ' . count($it['old']) . ' torrent';
    $cands = array_map(function ($p) use ($it) { return $p + ['note' => !empty($it['ab_match']) && st_norm($p['title']) === st_norm($it['ab_name']) ? st_l('ezt látta az autobrr', 'the one autobrr saw') : '']; }, $it['packs']);
    $free = st_ab_free();
    $info = [[st_l('Nálad', 'You have'), $have, true]];
    if ($miss) { $info[] = [st_l('A pakkból jön', 'Comes from the pack'), implode(', ', array_map(function ($n) { return 'E' . str_pad((string)$n, 2, '0', STR_PAD_LEFT); }, array_slice($miss, 0, 15))), true]; }
    $info[] = [st_l('Szabad hely', 'Free space'), $free >= 0 ? st_gb($free) : '?', true];
    return st_bot_post('sp', $it['key'], st_l('📦 Évadpakk érkezett · ', '📦 Season pack arrived · ') . $it['title'] . ' S' . str_pad((string)$it['season'], 2, '0', STR_PAD_LEFT),
        st_l('Válassz egy pakkot: a régi epizódok a kukába kerülnek, ha a pakk megvan és minden nálad lévő részt tartalmaz.', 'Choose a pack: the old episodes go to the trash once the pack is here and holds every episode you have.'), $info, $cands);
}
function st_sp_ab_dismiss($key) {
    st_sp_ab_update(function (&$d) use ($key) { foreach ($d['items'] as &$x) { if ($x['key'] === $key) { $x['dismissed'] = time(); } } unset($x); });
}
// the worker: one queued find at a time; Sonarr may not list a pack in the first minutes, so a find without a pack is tried
// again 5, 10, 20, 40 minutes later, then given up
function st_sp_ab_run() {
    for ($guard = 0; $guard < 20; $guard++) {
        $d = st_json_read(st_sp_ab_file(), []); $q = null;
        foreach ((array)($d['queue'] ?? []) as $x) { if (time() >= (int)($x['next'] ?? 0)) { $q = $x; break; } }
        if (!$q) { return; }
        $sid = (int)$q['series_id']; $sn = (int)$q['season'];
        [$c0, $ser, $e0] = st_arr('sonarr', '/series/' . $sid, 'GET', null, 60);
        [$c1, $files] = st_arr('sonarr', '/episodefile?seriesId=' . $sid, 'GET', null, 60);
        [$c2, $eps] = st_arr('sonarr', '/episode?seriesId=' . $sid . '&seasonNumber=' . $sn, 'GET', null, 60);
        $it = null; $why = 'Sonarr did not answer';
        if (is_array($ser) && is_array($files) && is_array($eps)) {
            $fby = []; foreach ($files as $f) { $fby[(int)$f['id']] = $f; }
            $list = array_values(array_filter($eps, function ($x) use ($sn) { return (int)($x['seasonNumber'] ?? -1) === $sn; }));
            [$it, $why] = st_sp_item($ser, $sn, $list, $fby, st_lib_in(st_qb_torrents(), st_cfg()), 1); // autobrr: one episode is enough (the rest, often the finale, comes from the pack)
        }
        if ($it) {
            // the release autobrr saw first, when Sonarr lists it; else the best pack Sonarr found
            $n = st_norm($q['name']); $hit = null;
            foreach ($it['packs'] as $i => $p) { if (st_norm($p['title']) === $n) { $hit = $i; } }
            if ($hit !== null) { $p = $it['packs'][$hit]; array_splice($it['packs'], $hit, 1); array_unshift($it['packs'], $p); }
            $it += ['src' => 'ab', 't' => (int)$q['t'], 'ab_name' => (string)$q['name'], 'ab_match' => $hit !== null, 'ab_indexer' => (string)$q['indexer']];
        }
        $retry = !$it && in_array($why, ['no pack', 'search failed', 'Sonarr did not answer'], true) && (int)$q['tries'] < 4;
        if (!empty($q['rel'])) {
            if ($it) { st_sp_ab_bot($it, $q); }
            elseif (!$retry) { st_ab_message($q['rel'], $q['v']); } // no row: the message without choices, as before
        }
        st_sp_ab_update(function (&$d) use ($q, $it, $retry, $why) {
            $d['queue'] = array_values(array_filter($d['queue'], function ($x) use ($q) { return !($x['name'] === $q['name'] && (int)$x['t'] === (int)$q['t']); }));
            if ($retry) { $q['tries'] = (int)$q['tries'] + 1; $q['next'] = time() + 300 * (2 ** ((int)$q['tries'] - 1)); $d['queue'][] = $q; }
            if ($it) {
                $d['items'] = array_values(array_filter($d['items'], function ($x) use ($it) { return $x['key'] !== $it['key']; }));
                $d['items'][] = $it;
            }
            $d['items'] = array_values(array_filter($d['items'], function ($x) { return time() - (int)($x['t'] ?? 0) < 14 * 86400; }));
            $d['last'] = ['t' => time(), 'name' => $q['name'], 'why' => $it ? 'listed' : ($retry ? 'Sonarr does not list a pack yet, trying again later' : 'not listed: ' . ($why !== '' ? $why : 'nothing to replace'))];
        });
    }
}

// ---- BoxBot: start a replacement from Discord with a reaction (item 6 phase 2 and item 72, 2026-10-16) -------------------
// The Seedbox webhook sends the message as before (with ?wait=true, which returns its id and channel); the bot (token and the
// owner's user id in the settings) adds 1️⃣ 2️⃣ 3️⃣ 👎 under it. The tick asks Discord once a minute (REST, no gateway, nothing
// listens on the server) who reacted: only the owner counts, for 24 hours. A number starts the same thing as the page button
// (st_sp_start / st_replace_grab, with their own checks), 👎 dismisses; the bottom of the message follows the job.
const ST_BOT_EMO = ["1\u{FE0F}\u{20E3}", "2\u{FE0F}\u{20E3}", "3\u{FE0F}\u{20E3}"];
const ST_BOT_NO = "\u{1F44E}";
function st_bot_file() { return dirname(st_state_file()) . '/bot_msgs.json'; }
function st_bot_on($kind = '') {
    $c = st_cfg();
    if ((string)$c['bot_token'] === '' || !preg_match('/^\d{15,25}$/', (string)$c['bot_user'])) { return false; }
    if ($kind === 'sp') { return !empty($c['bot_rep']); }
    if ($kind === 'find') { return !empty($c['bot_find']); }
    return true;
}
function st_bot_update($fn) {
    $f = st_bot_file(); $lk = @fopen($f . '.lock', 'c'); if ($lk) { flock($lk, LOCK_EX); }
    $d = st_json_read($f, []); $d += ['msgs' => []]; $o = json_encode($d);
    $r = $fn($d);
    if (json_encode($d) !== $o) { st_json_write($f, $d); }
    if ($lk) { flock($lk, LOCK_UN); fclose($lk); }
    return $r;
}
// Discord REST as the bot: [code, json, error]; one wait on a rate limit
function st_bot_api($method, $path, $body = null) {
    $base = getenv('DBX_ST_DCAPI') ?: 'https://discord.com/api/v10';
    $tok = (string)st_cfg()['bot_token'];
    for ($try = 0; $try < 2; $try++) {
        $o = ['headers' => ['Authorization: Bot ' . $tok, 'User-Agent: DiscordBot (seedbox, 1)', 'Content-Type: application/json'], 'timeout' => 15];
        if ($body !== null) { $o['post'] = json_encode($body, JSON_UNESCAPED_UNICODE); } elseif ($method === 'PUT') { $o['post'] = ''; }
        [$code, $b, $err] = st_http($method, $base . $path, $o);
        if ($err) { return [0, null, $err]; }
        $j = json_decode((string)$b, true);
        if ($code === 429 && $try === 0) { $w = is_array($j) ? (float)($j['retry_after'] ?? 1) : 1.0; if ($w <= 5) { usleep((int)(($w + 0.2) * 1e6)); continue; } }
        if ($code >= 400) { return [$code, $j, 'Discord HTTP ' . $code . (is_array($j) && !empty($j['message']) ? ': ' . $j['message'] : '')]; }
        return [$code, $j, ''];
    }
    return [429, null, 'Discord rate limit'];
}
// edits the webhook message: the stored embed with its colour and the status field
function st_bot_edit($m, $status, $color) {
    $hook = getenv('DBX_ST_DC') ?: (string)st_cfg()['dc_hook'];
    if ($hook === '' || empty($m['mid'])) { return; }
    $e = (array)$m['embed']; $e['color'] = $color;
    $f = array_values(array_filter((array)($e['fields'] ?? []), function ($x) { return ($x['name'] ?? '') !== st_l('Állapot', 'Status'); }));
    $f[] = ['name' => st_l('Állapot', 'Status'), 'value' => mb_substr($status, 0, 1000)];
    $e['fields'] = array_slice($f, 0, 25);
    st_http('PATCH', $hook . '/messages/' . $m['mid'], ['headers' => ['Content-Type: application/json'], 'post' => json_encode(['embeds' => [$e]], JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE), 'timeout' => 15]);
}
function st_bot_cand_line($c) {
    return implode(' · ', array_filter([(float)$c['size'] > 0 ? st_gb((float)$c['size']) : '', trim(((int)$c['res'] > 0 ? $c['res'] . 'p ' : '') . (string)($c['hdr'] ?? '')), !empty($c['hun']) ? 'HUN' : '',
        (int)$c['seeders'] > 0 ? (int)$c['seeders'] . ' seeder' : '', (string)($c['indexer'] ?? ''), (string)($c['note'] ?? '')])) ?: '-';
}
// sends a message with candidates and the reactions. $kind: sp | find | test; $cands: [[guid, title, size, res, hdr, hun, seeders, indexer, note], ...]
function st_bot_post($kind, $key, $title, $desc, $info, $cands, $extra = []) {
    $cands = array_slice(array_values($cands), 0, 3);
    $fields = [];
    foreach ($cands as $i => $c) { $fields[] = [ST_BOT_EMO[$i] . ' ' . mb_substr((string)$c['title'], 0, 200), st_bot_cand_line($c)]; }
    foreach ($info as $x) { $fields[] = $x; }
    $until = date('m-d H:i', time() + 86400);
    $fields[] = [st_l('Állapot', 'Status'), st_l('Koppints egy számra a cseréhez, 👎 = elvetés. Érvényes eddig: ', 'Tap a number to replace, 👎 = dismiss. Valid until ') . $until];
    [$ok, $er, $msg, $emb] = array_pad(st_notify('i', $title, $desc, $fields, true, '', ['wait' => true, 'color' => 0x9A7DE6]), 4, null);
    if (!$ok || !is_array($msg) || empty($msg['id'])) { return [false, $ok ? 'Discord did not return the message' : $er]; }
    $rec = ['mid' => (string)$msg['id'], 'ch' => (string)($msg['channel_id'] ?? ''), 'kind' => $kind, 'key' => $key, 't' => time(), 'state' => 'wait',
            'cands' => array_map(function ($c) { return ['guid' => (string)$c['guid'], 'title' => (string)$c['title']]; }, $cands), 'embed' => $emb] + $extra;
    $err = '';
    foreach (array_merge(array_slice(ST_BOT_EMO, 0, count($cands)), [ST_BOT_NO]) as $em) {
        [$c, $j, $e] = st_bot_api('PUT', '/channels/' . $rec['ch'] . '/messages/' . $rec['mid'] . '/reactions/' . rawurlencode($em) . '/@me');
        if ($e !== '') { $err = $e; break; }
        usleep(350000);
    }
    if ($err !== '') { $rec['err'] = $err; }
    st_bot_update(function (&$d) use ($rec) { $d['msgs'][] = $rec; $d['msgs'] = array_slice($d['msgs'], -60); });
    return [$err === '', $err];
}
// who reacted with $em (user ids)
function st_bot_who($m, $em) {
    [$c, $j, $e] = st_bot_api('GET', '/channels/' . $m['ch'] . '/messages/' . $m['mid'] . '/reactions/' . rawurlencode($em) . '?limit=100');
    if ($e !== '' || !is_array($j)) { return null; }
    return array_map(function ($u) { return (string)($u['id'] ?? ''); }, $j);
}
// the tick, once a minute: read the reactions of the waiting messages, follow the started ones
function st_bot_poll() {
    if (!st_bot_on()) { return; }
    $msgs = (array)(st_json_read(st_bot_file(), [])['msgs'] ?? []);
    if (!$msgs) { return; }
    $me = (string)st_cfg()['bot_user'];
    $st = st_state();
    foreach ($msgs as $m) {
        $ch = null; // ['state' => .., 'status' => .., 'color' => ..]
        if ($m['state'] === 'wait') {
            if (time() - (int)$m['t'] > 86400) {
                $ch = ['state' => 'expired', 'status' => st_l('⌛ Lejárt (24 óra). Az oldalon még elindíthatod.', '⌛ Expired (24 hours). You can still start it on the page.'), 'color' => 0x8A8A8A];
            } else {
                $pick = null; $no = false;
                $who = st_bot_who($m, ST_BOT_NO); if ($who === null) { continue; } if (in_array($me, $who, true)) { $no = true; }
                if (!$no) { foreach ($m['cands'] as $i => $c) { $w = st_bot_who($m, ST_BOT_EMO[$i]); if ($w !== null && in_array($me, $w, true)) { $pick = $i; break; } } }
                if ($no) {
                    if ($m['kind'] === 'sp') { st_sp_ab_dismiss($m['key']); }
                    $ch = ['state' => 'no', 'status' => $m['kind'] === 'test' ? st_l('✅ A teszt rendben: a BoxBot látja a reakciódat.', '✅ Test passed: BoxBot sees your reaction.') : st_l('👎 Elvetve.', '👎 Dismissed.'), 'color' => $m['kind'] === 'test' ? 0x3FA24A : 0x8A8A8A];
                } elseif ($pick !== null) {
                    $g = $m['cands'][$pick]['guid'];
                    if ($m['kind'] === 'test') { [$ok, $e] = [true, '']; }
                    elseif ($m['kind'] === 'sp') { [$ok, $e] = st_sp_start($m['key'], $g); }
                    else { [$ok, $e] = st_replace_grab($m['key'], $g); }
                    $lab = ST_BOT_EMO[$pick] . ' ' . $m['cands'][$pick]['title'];
                    if ($m['kind'] === 'test') { $ch = ['state' => 'done', 'status' => st_l('✅ A teszt rendben: a BoxBot látja a reakciódat.', '✅ Test passed: BoxBot sees your reaction.'), 'color' => 0x3FA24A]; }
                    elseif ($ok) { $ch = ['state' => 'run', 'pick' => $pick, 'status' => st_l('▶ Csere elindult: ', '▶ Replacement started: ') . $lab, 'color' => 0x4A90E2]; }
                    else { $ch = ['state' => 'fail', 'status' => st_l('⛔ Nem indult: ', '⛔ Not started: ') . $e . st_l(' Semmi nem változott; az oldalon választhatsz másikat.', ' Nothing changed; you can choose another one on the page.'), 'color' => 0xE5534B]; }
                }
            }
        } elseif ($m['state'] === 'run') {
            // follow the job of this key: the newest one started after the reaction
            $job = null;
            foreach ((array)($m['kind'] === 'sp' ? ($st['packjobs'] ?? []) : ($st['jobs'] ?? [])) as $j) { if (($j['key'] ?? '') === $m['key'] && (int)($j['gt'] ?? $j['t'] ?? 0) >= (int)($m['rt'] ?? 0) - 120) { $job = $j; } }
            if (!$job) { continue; }
            $done = $m['kind'] === 'sp' ? $job['stage'] === 'done' : in_array($job['stage'], ['cleaned', 'removed'], true);
            if ($done) { $ch = ['state' => 'done', 'status' => '✅ ' . st_l('Kész: ', 'Done: ') . (string)$job['msg'], 'color' => 0x3FA24A]; }
            elseif (in_array($job['stage'], ['failed', 'blocked'], true)) { $ch = ['state' => 'fail', 'status' => '⛔ ' . (string)$job['msg'], 'color' => 0xE5534B]; }
            elseif ((string)$job['msg'] !== (string)($m['last'] ?? '') && time() - (int)($m['et'] ?? 0) > 600) {
                // progress, at most every 10 minutes (Discord edits are cheap but the message should not flicker)
                $ch = ['state' => 'run', 'status' => '▶ ' . (string)$job['msg'], 'color' => 0x4A90E2, 'last' => (string)$job['msg']];
            }
        }
        if (!$ch) { continue; }
        st_bot_edit($m, $ch['status'], $ch['color']);
        st_bot_update(function (&$d) use ($m, $ch) {
            foreach ($d['msgs'] as &$x) {
                if ($x['mid'] !== $m['mid']) { continue; }
                if ($x['state'] === 'wait' && $ch['state'] === 'run') { $x['rt'] = time(); }
                $x['state'] = $ch['state']; $x['et'] = time(); if (isset($ch['last'])) { $x['last'] = $ch['last']; } if (isset($ch['pick'])) { $x['pick'] = $ch['pick']; }
            }
            unset($x);
            $d['msgs'] = array_values(array_filter($d['msgs'], function ($x) { return time() - (int)$x['t'] < 8 * 86400; }));
        });
    }
}
// Settings, Test the bot: a message with 1️⃣ and 👎; a reaction of the owner turns it green within a minute
function st_bot_test() {
    if (!st_bot_on()) { return [false, 'save the bot token and your user id first']; }
    [$c, $me, $e] = st_bot_api('GET', '/users/@me');
    if ($e !== '') { return [false, 'the bot token does not work: ' . $e]; }
    [$ok, $er] = st_bot_post('test', 'test', st_l('Seedbox: BoxBot teszt', 'Seedbox: BoxBot test'), st_l('Koppints az 1️⃣-re vagy a 👎-ra; egy percen belül zöld lesz.', 'Tap 1️⃣ or 👎; it turns green within a minute.'), [],
        [['guid' => 'test', 'title' => st_l('Próba', 'Test'), 'size' => 0, 'res' => 0, 'hdr' => '', 'hun' => false, 'seeders' => 0, 'indexer' => '']]);
    return [$ok, $ok ? 'sent as ' . (string)($me['username'] ?? 'the bot') : $er];
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/tools_ops.php">
<INLINE><![CDATA[<?php
// Operations of the Seedbox tools (run in the background by tools_run.php, or from tools.php for quick actions).
require_once __DIR__ . '/tools_lib.php';
require_once __DIR__ . '/tools_packs.php';

// 'pass': the tracker rejects the passkey in the announce URL (the torrent itself still exists); 'dead': it no longer knows the torrent
function st_dead_kind($msg) {
    $msg = (string)$msg;
    if (preg_match('/pass\s?key|torrent pass|invalid pass|bad pass/i', $msg)) { return 'pass'; }
    return preg_match(ST_DEAD_RE, $msg) ? 'dead' : '';
}
const ST_DEAD_RE = '/unregistered|not registered|(?<!host )not found|torrent (has been )?(deleted|removed)|nuked|does not exist|info.?hash.*(not|unknown)/i';

function st_progress($file, $state, $msg, $extra = []) {
    $cur = st_json_read($file, []);
    st_json_write($file, array_merge($cur, ['state' => $state, 't' => time(), 'msg' => $msg], $extra));
}

// =============================================================================================================
// findmytorrent
// =============================================================================================================
function st_find_query_variants($name) {
    $base = preg_replace('/\.(mkv|mp4|avi|m4v|ts)$/i', '', $name);
    $v = [trim(preg_replace('/[._]+/', ' ', $base))];
    if (preg_match('/^(.*?)[ .(]((?:19|20)\d\d)(?=[ .)\-_]|$)/', $base, $m)) { $v[] = trim(preg_replace('/[._]+/', ' ', $m[1])) . ' ' . $m[2]; }
    elseif (preg_match('/^(.*?)[ ._]S(\d{1,2})(?:E\d+)?(?=[ ._\-]|$)/i', $base, $m)) { $v[] = trim(preg_replace('/[._]+/', ' ', $m[1])) . ' S' . str_pad($m[2], 2, '0', STR_PAD_LEFT); }
    return array_values(array_unique($v));
}

function st_find_rank($cands, $unit, $tol) {
    $nn = st_norm($unit['name']);
    $out = [];
    foreach ($cands as $c) {
        $size = $c['size'];
        $diff = $unit['size'] > 0 ? ($size - $unit['size']) / $unit['size'] : 1;
        $sizeOk = $unit['size'] > 0 && $diff <= $tol / 100 && $diff >= -0.02;
        $nameEq = st_norm($c['title']) === $nn;
        if (!$sizeOk && !$nameEq) { continue; }
        $c['name_eq'] = $nameEq; $c['size_ok'] = $sizeOk; $c['diff'] = round($diff * 100, 2);
        $c['score'] = ($nameEq && $sizeOk ? 3 : ($sizeOk ? 2 : 1));
        $out[] = $c;
    }
    usort($out, function ($a, $b) { return [$b['score'], $b['seeders']] <=> [$a['score'], $a['seeders']]; });
    return array_slice($out, 0, 5);
}

// Scans the downloads folders; the units that no torrent in qBittorrent covers (and the torrents whose tracker
// removed them) get candidates from Prowlarr.
function st_find_scan($auto = false) {
    $cfg = st_cfg(); $state = st_state();
    st_progress(ST_FIND, 'running', 'Reading qBittorrent...', ['items' => []]);
    { // a new scan forgets the earlier replacement searches of this tool (the Update me results use other keys)
        $old = st_json_read(ST_RES, []); foreach (array_keys((array)$old) as $k) { if (preg_match('/^f[0-9a-f]{12}$/', (string)$k)) { unset($old[$k]); } }
        st_json_write(ST_RES, $old);
    }
    $tor = st_qb_torrents();
    if ($tor === null) { st_progress(ST_FIND, 'error', 'Cannot read the torrent list from qBittorrent (check the Seedbox settings).'); return; }
    $content = [];
    foreach ($tor as $t) { $p = st_to_host((string)($t['content_path'] ?? ''), $cfg); if ($p !== '') { $content[] = rtrim($p, '/'); } }
    st_progress(ST_FIND, 'running', 'Reading the downloads folders...');
    $units = st_units($cfg['roots']);
    $items = [];
    $ign = array_flip($state['ignored']);
    foreach ($units as $u) {
        $seeded = false;
        foreach ($content as $cp) { if ($cp === $u['path'] || strpos($cp, $u['path'] . '/') === 0) { $seeded = true; break; } }
        if ($seeded || isset($ign[$u['path']]) || (float)$u['size'] < 1e6 || !st_has_video($u['path'])) { continue; }
        $items[] = ['id' => 'f' . count($items), 'key' => 'f' . substr(md5($u['path']), 0, 12), 'path' => $u['path'], 'name' => $u['name'], 'root' => $u['root'], 'size' => $u['size'], 'why' => 'not seeded', 'old' => '', 'cands' => [], 'searched' => false];
    }
    // torrents whose tracker no longer knows them
    st_progress(ST_FIND, 'running', 'Checking the trackers...');
    $n = 0; $tot = count($tor);
    foreach ($tor as $t) {
        if ((float)($t['progress'] ?? 0) < 1) { continue; }
        if ((++$n) % 40 === 0) { st_progress(ST_FIND, 'running', 'Checking the trackers (' . $n . ' of ' . $tot . ')...'); }
        $tr = st_qb_json('/api/v2/torrents/trackers?hash=' . rawurlencode((string)$t['hash']));
        // dead = a tracker answers "unregistered" (qBittorrent 5: status 4 not working or 5 tracker error) and none works
        $dead = false; $msg = ''; $works = false; $passOnly = true;
        foreach ((array)$tr as $x) {
            $s = (int)($x['status'] ?? 0);
            if ($s === 2) { $works = true; }
            $k = ($s === 4 || $s === 5) ? st_dead_kind($x['msg'] ?? '') : '';
            if ($k !== '') { $dead = true; $msg = (string)$x['msg']; if ($k !== 'pass') { $passOnly = false; } }
        }
        if (!$dead || $works) { continue; }
        $p = rtrim(st_to_host((string)$t['content_path'], $cfg), '/');
        if (isset($ign[$p])) { continue; }
        $items[] = ['id' => 'f' . count($items), 'key' => 'f' . substr(md5($p), 0, 12), 'path' => $p, 'name' => (string)$t['name'], 'root' => basename(dirname($p)), 'size' => (float)$t['size'], 'why' => $passOnly ? 'passkey rejected' : 'tracker removed it', 'pass' => $passOnly, 'old' => (string)$t['hash'], 'dead_msg' => $msg, 'cands' => [], 'searched' => false];
    }
    st_json_write(ST_FIND, ['state' => 'running', 't' => time(), 'msg' => 'Searching...', 'items' => $items, 'done' => 0, 'total' => count($items)]);
    foreach ($items as $i => &$it) {
        $found = [];
        $err = '';
        foreach (!empty($it['pass']) ? [] : st_find_query_variants($it['name']) as $q) {
            [$res, $e] = st_prowlarr_search($q);
            if ($res === null) { $err = $e; break; }
            $found = array_merge($found, $res);
            $rank = st_find_rank($found, $it, (float)$cfg['find_tol']);
            if ($rank && $rank[0]['score'] === 3) { break; }
        }
        if ($err !== '') { $it['error'] = $err; }
        // the same release can appear on several indexers: keep every one, they differ in seeders
        $it['cands'] = st_find_rank($found, $it, (float)$cfg['find_tol']);
        $it['searched'] = true;
        $cur = st_json_read(ST_FIND, []);
        $cur['items'] = $items; $cur['done'] = $i + 1; $cur['t'] = time(); $cur['msg'] = 'Searching ' . ($i + 1) . ' of ' . count($items) . '...';
        st_json_write(ST_FIND, $cur);
        if ($err !== '' && strpos($err, 'not configured') !== false) { break; }
    }
    unset($it);
    // the scan takes minutes: torrents added meanwhile (a replacement that Radarr / Sonarr just grabbed, an Add torrent) now seed some of the folders
    $tor2 = st_qb_torrents();
    if (is_array($tor2) && $tor2) {
        $content2 = [];
        foreach ($tor2 as $t) { $p = st_to_host((string)($t['content_path'] ?? ''), $cfg); if ($p !== '') { $content2[] = rtrim($p, '/'); } }
        $items = array_values(array_filter($items, function ($u) use ($content2) {
            if (($u['why'] ?? '') !== 'not seeded') { return true; }
            foreach ($content2 as $cp) { if ($cp === $u['path'] || strpos($cp, $u['path'] . '/') === 0) { return false; } }
            return true;
        }));
    }
    {
        // every folder without an identical torrent gets its replacement options from Radarr / Sonarr now, so the rows are ready to open
        $todo = [];
        foreach ($items as $it) {
            $best = 0; foreach ((array)($it['cands'] ?? []) as $c) { $best = max($best, !empty($c['name_eq']) && !empty($c['size_ok']) ? 3 : (!empty($c['size_ok']) ? 2 : 1)); }
            if ($best < 3 && empty($it['error']) && empty($it['pass'])) { $todo[] = $it; }
        }
        $index = $todo ? st_arr_index(true) : null;
        foreach ($todo as $k => $u) {
            $cur = st_json_read(ST_FIND, []); $cur['msg'] = 'Looking up replacement releases ' . ($k + 1) . ' of ' . count($todo) . '...'; $cur['t'] = time(); st_json_write(ST_FIND, $cur);
            st_find_repl_unit($u, $index, true);
        }
    }
    st_json_write(ST_FIND, ['state' => 'ready', 't' => time(), 'msg' => '', 'items' => $items, 'done' => count($items), 'total' => count($items)]);
    $n = count($items); $green = 0; $amber = 0; $nameonly = 0; $dead = 0; $bytes = 0;
    foreach ($items as $it) {
        $best = 0; foreach ((array)($it['cands'] ?? []) as $c) { $best = max($best, !empty($c['name_eq']) && !empty($c['size_ok']) ? 3 : (!empty($c['size_ok']) ? 2 : 1)); }
        if ($best === 3) { $green++; } elseif ($best === 2) { $amber++; } elseif ($best === 1) { $nameonly++; }
        if (!empty($it['old']) && empty($it['pass'])) { $dead++; } $bytes += (float)$it['size'];
    }
    $with = $green + $amber + $nameonly;
    // remember which torrents the tracker removed: the Seedbox tile shows them as "need attention"
    $gone = []; foreach ($items as $it) { if (!empty($it['old']) && empty($it['pass'])) { $gone[] = ['hash' => (string)$it['old'], 'name' => (string)$it['name']]; } }
    st_state_update(function (&$ws) use ($gone, $n) { $ws['watch'] = array_merge((array)($ws['watch'] ?? []), ['t' => time(), 'removed' => $gone, 'unseeded' => $n]); });
    $nsd = 0; $npw = 0; foreach ($items as $it) { if (!empty($it['pass'])) { $npw++; } elseif (empty($it['old'])) { $nsd++; } }
    st_sum_set('find', ['removed' => count($gone), 'nosd' => $nsd, 'pass' => $npw]);
    if ($auto && $dead > 0 && st_bot_on('find')) { st_find_bot($items); }
    if ($auto && $dead > 0) {
        $names = array_slice(array_map(function ($g) { return $g['name']; }, $gone), 0, 8);
        st_notify('a', st_l('Seedbox: a tracker törölt torrenteket', 'Seedbox: the tracker removed torrents'),
            st_l('A heti ellenőrzés ' . $dead . ' torrentet talált, amelyet a tracker már nem ismer, ezek nem seedelnek. A Seedbox Tools oldalon (Beállítások, Eszközök) cserélheted őket.',
                 'The weekly check found ' . $dead . ' torrent(s) that the tracker no longer knows, so they do not seed. You can replace them in Seedbox Tools (Settings, Utilities).'),
            [[st_l('Példák', 'Examples'), implode("\n", $names) . ($dead > 8 ? "\n+" . ($dead - 8) : '')], [st_l('Seedeletlen összesen', 'Unseeded in total'), (string)$n, true]], true, 'find');
        return;
    }
    if ($auto) {
        // nothing removed by a tracker: say that the weekly check ran
        st_notify('g', st_l('Seedbox: a heti torrent health check lefutott', 'Seedbox: the weekly torrent health check ran'),
            st_l('Nem találtam olyan torrentet, amelyet a tracker törölt.', 'No torrent was found that a tracker removed.') . ($n > 0 ? ' ' . st_l($n . ' mappához (' . st_gb($bytes) . ') nem tartozik seedelt torrent, ezek a Seedbox Tools oldalon vannak.', $n . ' folder(s) (' . st_gb($bytes) . ') have no seeded torrent, see Seedbox Tools.') : ' ' . st_l('Minden fájl seedelve van.', 'Every file is seeded.')),
            [], true, 'find');
        return;
    }
    if ($n === 0) { st_notify('g', st_l('Seedbox: minden fájl seedelve', 'Seedbox: every file is seeded'), st_l('A letöltési mappák átvizsgálva, nincs seedeletlen tartalom.', 'The downloads folders were scanned, nothing is unseeded.'), [], false, 'find'); }
    else {
        st_notify('a', st_l('Seedbox: seedeletlen tartalom találva', 'Seedbox: unseeded content found'),
            st_l('A letöltési mappákban ' . $n . ' elemhez (' . st_gb($bytes) . ') nem tartozik seedelt torrent. Oka: a torrent nincs a qBittorrentben, vagy a tracker törölte.',
                 $n . ' item(s) (' . st_gb($bytes) . ') in the downloads folders have no seeded torrent. Cause: the torrent is not in qBittorrent, or the tracker removed it.'),
            [[st_l('Egyező torrent (név és méret)', 'Matching torrent (name and size)'), (string)$green, true], [st_l('Méret egyezik', 'Size matches'), (string)$amber, true], [st_l('Csak a név hasonlít', 'Name only'), (string)$nameonly, true], [st_l('Nincs torrent, csere kell', 'No torrent, replacement needed'), (string)($n - $with), true], [st_l('Ebből a tracker törölte', 'Of these removed by tracker'), (string)$dead, true]], false, 'find');
    }
}

// BoxBot (item 72): one message with choices per torrent the tracker removed, when the replacement search found releases;
// at most 5 per scan, and a torrent is offered again only after 7 days
function st_find_bot($items) {
    $res = st_json_read(ST_RES, []); $sent = 0;
    $old = []; foreach ((array)(st_json_read(st_bot_file(), [])['msgs'] ?? []) as $m) { if ($m['kind'] === 'find' && time() - (int)$m['t'] < 7 * 86400) { $old[$m['key'] . ':' . ($m['old'] ?? '')] = 1; } }
    foreach ($items as $it) {
        if (empty($it['old']) || !empty($it['pass']) || $sent >= 5) { continue; }
        $r = $res[$it['key']] ?? null;
        if (!is_array($r) || ($r['state'] ?? '') !== 'ready' || empty($r['rows']) || isset($old[$it['key'] . ':' . $it['old']])) { continue; }
        $ri = (array)($r['item'] ?? []);
        $now = trim(((int)($ri['cur_res'] ?? 0) > 0 ? $ri['cur_res'] . 'p ' : '') . st_hdr_label((int)($ri['cur_hdr'] ?? 1))) . ', ' . st_gb((float)$it['size']);
        [$ok] = st_bot_post('find', $it['key'], st_l('🗑️ Lekerült a trackerről · ', '🗑️ Removed from the tracker · ') . (string)($ri['title'] ?? $it['name']),
            st_l('A torrent már nem seedel. Csere-jelöltek a ' . ucfirst((string)($ri['kind'] ?? 'arr')) . ' keresése szerint; a régi mappa a csere után a kukába kerül.', 'The torrent no longer seeds. Replacement releases from the ' . ucfirst((string)($ri['kind'] ?? 'arr')) . ' search; the old folder goes to the trash after the replacement.'),
            [[st_l('Most', 'Now'), (string)$it['name'] . "
" . $now]], $r['rows'], ['old' => (string)$it['old']]);
        if ($ok) { $sent++; }
    }
}

// Adds a candidate to qBittorrent: stopped, with a recheck; tick finishes it (starts it only when it is 100%).
// The qBittorrent category Radarr (movies) or Sonarr (series) uses for its downloads, read from its download client
function st_arr_category($kind) {
    [$code, $j] = st_arr($kind, '/downloadclient', 'GET', null, 20);
    if ($code !== 200 || !is_array($j)) { return ''; }
    $want = $kind === 'radarr' ? 'movieCategory' : 'tvCategory';
    foreach ($j as $dc) {
        if (stripos((string)($dc['implementation'] ?? '') . ' ' . (string)($dc['name'] ?? ''), 'qbittorrent') === false || empty($dc['enable'])) { continue; }
        foreach ((array)($dc['fields'] ?? []) as $f) { if (($f['name'] ?? '') === $want && trim((string)($f['value'] ?? '')) !== '') { return trim((string)$f['value']); } }
    }
    return '';
}
function st_category_for($path, $name) {
    if (!(int)st_cfg()['find_cat']) { return ''; }
    $vids = [];
    $out = (string)@shell_exec('find ' . escapeshellarg($path) . ' -type f -printf ' . escapeshellarg('%s\t%p\n') . ' 2>/dev/null');
    foreach (explode("\n", $out) as $l) { $p = explode("\t", $l, 2); if (count($p) === 2 && st_main_video($p[1])) { $vids[] = (float)$p[0]; } }
    $m = st_arr_match($vids, $name, st_arr_index());
    return $m['kind'] !== '' ? st_arr_category($m['kind']) : '';
}

function st_find_add($itemId, $idx) {
    $cfg = st_cfg(); $find = st_json_read(ST_FIND, []);
    $item = null;
    foreach ((array)($find['items'] ?? []) as $it) { if ($it['id'] === $itemId) { $item = $it; } }
    if (!$item || !isset($item['cands'][$idx])) { return [false, 'unknown item or candidate']; }
    $c = $item['cands'][$idx];
    $dl = (string)$c['dl'];
    if ($dl === '') { return [false, 'the result has no download link']; }
    $hash = ''; $urls = ''; $file = '';
    if (stripos($dl, 'magnet:') === 0) { $urls = $dl; $hash = st_magnet_hash($dl); }
    else {
        [$code, $body, $err, $hdr] = st_http('GET', $dl, ['timeout' => 60, 'follow' => false]);
        if (in_array($code, [301, 302, 303, 307, 308], true) && preg_match('/^location:\s*(magnet:[^\r\n]+)/im', $hdr, $m)) { $urls = trim($m[1]); $hash = st_magnet_hash($urls); }
        else {
            if ($code >= 300 && $code < 400 && preg_match('/^location:\s*(\S+)/im', $hdr, $m)) { [$code, $body, $err, $hdr] = st_http('GET', trim($m[1]), ['timeout' => 60, 'follow' => true]); }
            if ($code !== 200 || $body === '' || $body[0] !== 'd') { return [false, 'could not download the .torrent file (' . ($err ?: 'HTTP ' . $code) . ')']; }
            $hash = st_torrent_hash($body);
            $file = tempnam('/tmp', 'qbtt'); file_put_contents($file, $body);
        }
    }
    if ($hash === '') { if ($file) { @unlink($file); } return [false, 'could not read the torrent hash']; }
    $exists = null;
    foreach ((array)st_qb_torrents() as $t) { if (strtolower((string)$t['hash']) === $hash) { $exists = $t; } }
    if ($exists) { if ($file) { @unlink($file); } return [false, 'this torrent is already in qBittorrent (' . $exists['name'] . ')']; }
    $save = st_to_qb(dirname($item['path']), $cfg);
    $post = ['savepath' => $save, 'paused' => 'true', 'stopped' => 'true', 'skip_checking' => 'false', 'autoTMM' => 'false', 'useDownloadPath' => 'false', 'tags' => 'findmytorrent']; // useDownloadPath=false: never move the files to qBittorrent's incomplete folder (that would break hardlinks)
    $cat = st_category_for($item['path'], $item['name']);
    if ($cat === '' && (int)$cfg['find_cat']) {
        // not in Radarr/Sonarr (or another size): use the category most torrents in the same folder already have
        $cnt = [];
        foreach ((array)st_qb_torrents() as $t) { if (rtrim((string)$t['save_path'], '/') === rtrim($save, '/') && (string)$t['category'] !== '') { $cnt[(string)$t['category']] = ($cnt[(string)$t['category']] ?? 0) + 1; } }
        if ($cnt) { arsort($cnt); $cat = (string)key($cnt); }
    }
    if ($cat !== '') { $post['category'] = $cat; }
    if ($urls !== '') { $post['urls'] = $urls; }
    [$code, $b, $e] = st_qb('/api/v2/torrents/add', $post, $file !== '' ? ['torrents' => $file] : null);
    if ($file) { @unlink($file); }
    if ($code !== 200) { return [false, 'qBittorrent refused it (' . ($e ?: 'HTTP ' . $code) . ')']; }
    st_state_update(function (&$state) use ($hash, $c, $item) {
        $state['pending'][] = ['id' => substr(md5($hash . microtime()), 0, 10), 'hash' => $hash, 'name' => $c['title'], 'item' => $item['name'], 'path' => $item['path'], 'replaces' => (string)($item['old'] ?? ''),
                               't' => time(), 'stage' => 'added', 'rechecked' => 0, 'msg' => 'checking the existing files'];
    });
    sleep(1);
    st_qb('/api/v2/torrents/recheck', ['hashes' => $hash]);
    return [true, ''];
}

// The best identical release of an item: same name and size, most seeders. Returns its index or -1.
function st_best_green($item) {
    $best = -1; $seed = -1;
    foreach ((array)($item['cands'] ?? []) as $j => $c) { if (!empty($c['name_eq']) && !empty($c['size_ok']) && (int)$c['seeders'] > $seed) { $best = $j; $seed = (int)$c['seeders']; } }
    return $best;
}
// Add all matching: puts every identical-release item in the queue (by folder path). Returns the number queued.
function st_queue_all() {
    $find = st_json_read(ST_FIND, []);
    return (int)st_state_update(function (&$s) use ($find) {
        $have = array_flip(array_column($s['queue'], 'path')); $n = 0;
        $busy = []; foreach ($s['pending'] as $p) { if (in_array($p['stage'], ['added', 'checking', 'done'], true) || ($p['stage'] === 'failed' && time() - $p['t'] < 7 * 86400)) { $busy[$p['path']] = 1; } }
        foreach ((array)($find['items'] ?? []) as $it) {
            if (isset($have[$it['path']]) || isset($busy[$it['path']]) || st_best_green($it) < 0) { continue; }
            $s['queue'][] = ['path' => $it['path'], 'name' => $it['name']]; $n++;
        }
        if (!$n) { return false; }
        if (!$s['qstat']) { $s['qstat'] = ['t' => time(), 'total' => $n]; } else { $s['qstat']['total'] += $n; }
        return $n;
    });
}
function st_queue_stop() { st_state_update(function (&$s) { $s['queue'] = []; }); st_queue_feed(); }
// One check at a time: when nothing is being checked, add the next queued item. At the end, one Discord summary.
function st_queue_feed() {
    $act = st_state_update(function (&$s) {
        if (!$s['queue'] && !$s['qstat']) { return false; }
        foreach ($s['pending'] as $p) { if (in_array($p['stage'], ['added', 'checking'], true)) { return false; } }
        if (!$s['queue']) {
            $t0 = (int)$s['qstat']['t']; $ok = 0; $bad = []; $partial = 0;
            foreach ($s['pending'] as $p) { if ((int)$p['t'] < $t0) { continue; } if ($p['stage'] === 'done') { $ok++; if (strpos($p['msg'], 'downloads the missing') !== false) { $partial++; } } elseif ($p['stage'] === 'failed') { $bad[] = $p['item'] . ': ' . $p['msg']; } }
            $s['qstat'] = null;
            return ['sum', $ok, $partial, $bad];
        }
        return ['next', array_shift($s['queue'])];
    });
    if (!$act) { return; }
    if ($act[0] === 'sum') {
        [, $ok, $partial, $bad] = $act;
        st_notify(count($bad) ? 'a' : 'g', st_l('Seedbox: Add all matching kész', 'Seedbox: Add all matching finished'),
            st_l($ok . ' torrent seedel újra' . ($partial ? ' (ebből ' . $partial . '-nál a qBittorrent letölti a hiányzó részt)' : '') . ', ' . count($bad) . ' nem egyezett.', $ok . ' torrent(s) seeding again' . ($partial ? ' (' . $partial . ' of them will download the missing part)' : '') . ', ' . count($bad) . ' did not match.'),
            [[st_l('Nem egyezett', 'Did not match'), implode("\n", array_slice($bad, 0, 10))]], false, 'find');
        return;
    }
    $q = $act[1];
    $find = st_json_read(ST_FIND, []); $item = null;
    foreach ((array)($find['items'] ?? []) as $it) { if ($it['path'] === $q['path']) { $item = $it; } }
    $idx = $item ? st_best_green($item) : -1;
    if ($idx < 0) { st_queue_feed(); return; } // the list changed since: skip
    [$ok, $e] = st_find_add($item['id'], $idx);
    if (!$ok) {
        st_state_update(function (&$s) use ($item, $idx, $e) { $s['pending'][] = ['id' => substr(md5($item['path'] . microtime()), 0, 10), 'hash' => '', 'name' => $item['cands'][$idx]['title'], 'item' => $item['name'], 'path' => $item['path'], 'replaces' => '', 't' => time(), 'stage' => 'failed', 'rechecked' => 1, 'msg' => $e]; });
        st_queue_feed();
    }
}

function st_find_ignore($path) { st_ignored_add($path); }

// Delete button of the Find my torrent list: the folder goes to the trash folder of its downloads folder (or is deleted at once when
// trash_days is 0), and the torrent the tracker removed is taken out of qBittorrent. A folder that another torrent seeds is never touched.
function st_find_delete($id) {
    $find = st_json_read(ST_FIND, []); $cfg = st_cfg(); $hit = null;
    foreach ((array)($find['items'] ?? []) as $it) { if (($it['id'] ?? '') === $id) { $hit = $it; } }
    if (!$hit) { return [false, 'unknown item']; }
    $p = (string)$hit['path'];
    if ($p === '' || !file_exists($p)) { return [false, 'the folder is already gone']; }
    $root = st_under_roots($p, $cfg);
    if ($root === false) { return [false, 'not deleting ' . $p . ': it is not inside a configured downloads folder']; }
    $rp = realpath($p); $old = strtolower((string)($hit['old'] ?? ''));
    $tors = st_qb_torrents();
    if ($tors === null) { return [false, 'qBittorrent did not answer; nothing was deleted']; }
    foreach ($tors as $t) {
        $cp = rtrim(st_to_host((string)($t['content_path'] ?? ''), $cfg), '/');
        if ($cp !== '' && ($cp === $rp || strpos($cp, $rp . '/') === 0) && strtolower((string)$t['hash']) !== $old) { return [false, 'not deleting ' . $p . ': torrent "' . $t['name'] . '" seeds it']; }
    }
    if ($old !== '') { st_qb('/api/v2/torrents/delete', ['hashes' => $old, 'deleteFiles' => 'false']); st_watch_forget($old); }
    $days = (int)($cfg['trash_days'] ?? 0);
    if ($days > 0) {
        $tr = $root . '/' . ST_TRASH; @mkdir($tr, 0777, true);
        if (!@rename($rp, $tr . '/' . date('YmdHis') . '_' . basename($rp))) { return [false, 'could not move ' . $p . ' to the trash folder']; }
    } elseif (!st_rm_tree($rp)) { return [false, 'could not delete ' . $p]; }
    st_find_prune();
    return [true, ''];
}

// drops the Find my torrent entries whose folder is gone (for example moved to the trash by the Season repacker); returns how many
function st_find_prune() {
    $find = st_json_read(ST_FIND, []); if (empty($find['items']) || !is_array($find['items'])) { return 0; }
    $keep = []; foreach ($find['items'] as $it) { if (isset($it['path']) && !file_exists((string)$it['path'])) { continue; } $keep[] = $it; }
    $n = count($find['items']) - count($keep);
    if ($n > 0) { $find['items'] = $keep; st_json_write(ST_FIND, $find); }
    return $n;
}
// a torrent that a tool removed no longer counts as "removed from tracker" on the widget
// last-scan summary of a tool (kept across reboots; the widget shows it)
function st_sum_set($k, $v) { st_state_update(function (&$s) use ($k, $v) { $s['sum'][$k] = array_merge(['t' => time()], $v); }); }
function st_watch_forget($hash) {
    $hash = strtolower((string)$hash); if ($hash === '') { return; }
    st_state_update(function (&$s) use ($hash) {
        $r = (array)($s['watch']['removed'] ?? []); if (!$r) { return false; }
        $k = array_values(array_filter($r, function ($g) use ($hash) { return strtolower((string)($g['hash'] ?? '')) !== $hash; }));
        if (count($k) === count($r)) { return false; }
        $s['watch']['removed'] = $k;
    });
}

// ---- finishing pending adds and watching the replacement jobs (cron, every minute) -----------------------
function st_qb_start($hash) {
    [$c] = st_qb('/api/v2/torrents/start', ['hashes' => $hash]);
    if ($c === 404 || $c === 405) { st_qb('/api/v2/torrents/resume', ['hashes' => $hash]); }
}
// Scheduled scan (daily or weekly, at the chosen hour): the most recent slot that has passed and was not scanned yet.
// Only scans run by themselves, one after the other, for the tools that are ticked; nothing is added, replaced or deleted.
function st_auto_due() {
    $c = st_cfg();
    $tools = [];
    if ((int)$c['auto_scan']) { $tools[] = 'find auto'; }
    if ((int)$c['auto_upd']) { $tools[] = 'upd'; }
    if ((int)$c['auto_rep']) { $tools[] = 'sp'; }
    if (!$tools) { return; }
    $now = time(); $slot = mktime((int)$c['auto_hour'], 0, 0);
    if (($c['auto_freq'] ?? 'weekly') === 'daily') { if ($slot > $now) { $slot -= 86400; } }
    else { $slot -= (((int)date('N') - (int)$c['auto_day'] + 7) % 7) * 86400; if ($slot > $now) { $slot -= 7 * 86400; } }
    $go = st_state_update(function (&$s) use ($now, $slot) {
        $w = (array)($s['watch'] ?? []);
        if (!isset($w['auto_t'])) { $w['auto_t'] = $now; $s['watch'] = $w; return 'first'; } // first run: wait for the next slot
        if ((int)$w['auto_t'] >= $slot) { return false; }
        $w['auto_t'] = $now; $s['watch'] = $w; return 'go';
    });
    if ($go !== 'go') { return; }
    $php = '/usr/bin/php'; foreach (['/usr/bin/php', '/usr/local/bin/php'] as $p) { if (is_executable($p)) { $php = $p; break; } }
    $cmd = [];
    foreach ($tools as $t) { $cmd[] = escapeshellarg($php) . ' ' . escapeshellarg(__DIR__ . '/tools_run.php') . ' ' . $t; }
    @exec('setsid nohup sh -c ' . escapeshellarg(implode('; ', $cmd)) . ' >/dev/null 2>&1 &');
}

function st_tick() {
    st_trash_purge();
    st_auto_due();
    try { st_ab_poll(); } catch (Throwable $e) { $w = st_json_read(ST_AB, []); $w['t'] = time(); $w['err'] = 'unexpected error: ' . $e->getMessage(); st_json_write(ST_AB, $w); }
    try { st_bot_poll(); } catch (Throwable $e) { /* Discord unreachable: the next minute tries again */ }
    st_upd_prune(st_qb_torrents()); // only touches a finished (ready) Shape up list
    $state = st_state(); $orig = $state; $changed = false;
    $active = false;
    foreach ($state['pending'] as $p) { if (in_array($p['stage'], ['added', 'checking'], true)) { $active = true; } }
    foreach ($state['jobs'] as $j) { if (!in_array($j['stage'], ['imported', 'removed', 'failed', 'cleaned'], true) || (empty($j['tag']) && $j['stage'] !== 'failed' && time() - (int)($j['gt'] ?? $j['t']) < 86400)) { $active = true; } }
    if ($state['queue']) { $active = true; }
    if (st_sp_active($state)) { $active = true; }
    if (!$active) { return; }
    $tor = st_qb_torrents();
    if ($tor !== null) {
        $by = []; foreach ($tor as $t) { $by[strtolower((string)$t['hash'])] = $t; }
        foreach ($state['pending'] as &$p) {
            if (!in_array($p['stage'], ['added', 'checking'], true)) { continue; }
            $t = $by[$p['hash']] ?? null;
            if (!$t) { if (time() - $p['t'] > 600) { $p['stage'] = 'failed'; $p['msg'] = 'the torrent disappeared from qBittorrent'; $changed = true; } continue; }
            $st = (string)$t['state'];
            if (preg_match('/^(checking|allocating|moving|metaDL|forcedMetaDL)/', $st)) { $p['stage'] = 'checking'; $p['msg'] = 'checking ' . round(((float)$t['progress']) * 100) . '%'; $changed = true; continue; }
            if (!$p['rechecked'] && (float)$t['progress'] < 1) {
                // the first check may not have run on a stopped torrent: ask once more, then judge
                $p['rechecked'] = 1; $p['t'] = time(); st_qb('/api/v2/torrents/recheck', ['hashes' => $p['hash']]); $changed = true; continue;
            }
            $acc = max(0.9, min(1.0, (float)st_cfg()['find_accept'] / 100));
            $okMatch = (float)$t['progress'] >= min(0.99999, $acc); $missing = '';
            if (!$okMatch && (float)$t['progress'] >= 0.5 && (int)st_cfg()['find_missing_files'] > 0) {
                // only a few whole files missing (an episode, an extra): the rest is there, so keep it and download just those
                $inc = st_missing_files($p['hash']);
                if ($inc && count($inc) <= (int)st_cfg()['find_missing_files']) { $okMatch = true; $missing = st_missing_txt($inc); }
            }
            if ($okMatch) {
                st_qb_start($p['hash']);
                $full = (float)$t['progress'] >= 0.99999; $lack = (1 - (float)$t['progress']) * (float)$t['size'];
                if (!$full && $missing === '') {
                    // 99.9x %: show which file is really missing; qBittorrent still fetches whole pieces, so the byte count is bigger
                    $inc = st_missing_files($p['hash']);
                    if ($inc && count($inc) <= 20) { $missing = st_missing_txt($inc); }
                }
                $p['stage'] = 'done'; $p['msg'] = $full ? 'all files matched, seeding started' : round(((float)$t['progress']) * 100, 2) . '% matched, seeding started; qBittorrent downloads the missing ' . ($missing !== '' ? $missing : st_gb($lack)); $p['t'] = time();
                if ($p['replaces'] !== '') { st_qb('/api/v2/torrents/delete', ['hashes' => $p['replaces'], 'deleteFiles' => 'false']); $p['msg'] .= '; the old torrent was removed (files kept)'; }
                $pc = round(((float)$t['progress']) * 100, 2);
                $hu = $full ? 'A hozzáadott torrent minden fájlja egyezett a letöltött fájlokkal, a seedelés elindult.' : $pc . '%-ban egyezett a torrent a fájlokkal, a seedelés elindult, a hiányzó részt a qBittorrent letölti: ' . ($missing !== '' ? str_replace(' files', ' fájl', str_replace(' file ', ' fájl ', $missing)) : st_gb($lack)) . '.';
                $en = $full ? 'Every file of the added torrent matched the downloaded files, so seeding started.' : $pc . '% of the torrent matched the files, seeding started; qBittorrent downloads the missing ' . ($missing !== '' ? $missing : st_gb($lack)) . '.';
                if ($p['replaces'] !== '') { $hu .= ' A tracker által törölt régi torrent bejegyzése eltávolítva (a fájlok megmaradtak).'; $en .= ' The old torrent the tracker had removed was taken out of qBittorrent (files kept).'; }
                empty($state['qstat']) && st_notify('g', st_l('Seedbox: a tartalom újra seedelve', 'Seedbox: content is seeded again'), st_l($hu, $en),
                    [[st_l('Mappa', 'Folder'), $p['item']], [st_l('Torrent', 'Torrent'), $p['name']]], false, 'find');
            } else {
                st_qb('/api/v2/torrents/delete', ['hashes' => $p['hash'], 'deleteFiles' => 'false']);
                $p['stage'] = 'failed'; $p['msg'] = 'the files did not match (' . round(((float)$t['progress']) * 100, 1) . '% found); the torrent was removed, your files are untouched'; $p['t'] = time();
                empty($state['qstat']) && st_notify('a', st_l('Seedbox: a torrent nem egyezik a fájlokkal', 'Seedbox: the torrent does not match the files'),
                    st_l('A hozzáadott torrent csak ' . round(((float)$t['progress']) * 100, 1) . '%-ban egyezett a letöltött fájlokkal, ezért töröltem a qBittorrentből. A fájlokhoz nem nyúltam.',
                         'The added torrent matched the downloaded files only ' . round(((float)$t['progress']) * 100, 1) . '%, so it was removed from qBittorrent. The files were not touched.'),
                    [[st_l('Mappa', 'Folder'), $p['item']], [st_l('Torrent', 'Torrent'), $p['name']]], false, 'find');
            }
            $changed = true;
        }
        unset($p);
    }
    if ($tor !== null && st_sp_tick($state, $tor)) { $changed = true; }
    // replacement jobs: look at the Radarr / Sonarr queue and at the files
    foreach ($state['jobs'] as &$j) {
        if (empty($j['tag']) && $j['stage'] !== 'failed' && $tor !== null && st_job_tag($j, $tor)) { $j['tag'] = 1; $changed = true; }
        if (in_array($j['stage'], ['imported', 'removed', 'failed', 'cleaned'], true)) { continue; }
        $new = st_job_status($j);
        if ($new !== null && ($new['stage'] !== $j['stage'] || $new['msg'] !== $j['msg'])) {
            $prev = $j['stage'];
            $j['stage'] = $new['stage']; $j['msg'] = $new['msg']; $changed = true;
            // content nobody seeded: once the replacement is imported the old files go (to the trash, see trash_days)
            if ($j['stage'] === 'imported' && ($j['mode'] ?? '') === 'repl') {
                [$ok, $m, $mL] = st_cleanup_old($j); $mL = $mL ?? $m;
                if ($ok) { $j['stage'] = 'cleaned'; $j['msg'] = $m; $j['t'] = time(); } else { $j['msg'] .= '; the old files were not removed: ' . $m; }
                st_notify($ok ? 'g' : 'a', $ok ? st_l('Seedbox: csere kész, régi fájlok eltávolítva', 'Seedbox: replacement done, old files removed') : st_l('Seedbox: a csere kész, de a régi fájlokat nem tudtam eltávolítani', 'Seedbox: replaced, but the old files could not be removed'),
                    st_l('A ' . ucfirst($j['kind']) . ' beimportálta az új kiadást.', ucfirst($j['kind']) . ' imported the new release.') . ' ' . $mL,
                    [[st_l('Cím', 'Title'), $j['title']], [st_l('Új', 'New'), $j['new']], [st_l('Régi', 'Old'), $j['old_name']]], false, st_ntool($j));
            } elseif ($j['stage'] === 'imported') {
                st_notify('g', st_l('Seedbox: az új kiadás importálva', 'Seedbox: the new release is imported'), st_l('A ' . ucfirst($j['kind']) . ' beimportálta; a régi torrent és fájljai a jóváhagyásodra várnak az oldalon (Remove).', ucfirst($j['kind']) . ' imported it; the old torrent and files wait for your click on the page (Remove).'),
                    [[st_l('Cím', 'Title'), $j['title']], [st_l('Új', 'New'), $j['new']]], false, st_ntool($j));
            } elseif ($j['stage'] === 'blocked' && $prev !== 'blocked') {
                st_notify('a', st_l('Seedbox: a csere elakadt', 'Seedbox: the replacement is stuck'), st_l('A ' . ucfirst($j['kind']) . ' nem importálja az új kiadást: ', ucfirst($j['kind']) . ' does not import the new release: ') . $j['msg'] . "\n" . st_l('Nézd meg a ' . ucfirst($j['kind']) . ' Activity, Queue oldalát, és importáld kézzel.', 'Open Activity, Queue in ' . ucfirst($j['kind']) . ' and import it by hand.'),
                    [[st_l('Cím', 'Title'), $j['title']], [st_l('Új', 'New'), $j['new']]], false, st_ntool($j));
            }
        }
    }
    unset($j);
    // forget old finished entries
    $keep = [];
    foreach ($state['pending'] as $p) { if (in_array($p['stage'], ['done', 'failed'], true) && time() - $p['t'] > 7 * 86400) { $changed = true; continue; } $keep[] = $p; }
    $state['pending'] = $keep;
    $kj = [];
    foreach ($state['jobs'] as $j) { if (in_array($j['stage'], ['removed', 'failed', 'cleaned'], true) && time() - (int)$j['t'] > 7 * 86400) { $changed = true; continue; } $kj[] = $j; }
    $state['jobs'] = $kj;
    if ($changed) {
        // put the changes onto the current state: the page may have added or changed entries during this tick
        st_state_update(function (&$cur) use ($orig, $state) { foreach (['pending', 'jobs', 'packjobs'] as $k) { $cur[$k] = st_merge_list($orig[$k] ?? [], $state[$k] ?? [], $cur[$k] ?? []); } });
    }
    st_queue_feed();
}

// =============================================================================================================
// updateme
// =============================================================================================================
function st_video_ext($n) { return (bool)preg_match('/\.(mkv|mp4|avi|m4v|ts|mov|wmv|iso)$/i', $n); }
// a video that counts for matching: sample clips (Sample/Minta folder or sample/minta in the file name) and bonus material
// (a folder named Extras, Featurettes, Trailers, ...) are not part of the content
function st_main_video($n) {
    $n = (string)$n;
    if (!st_video_ext($n) || preg_match('/(^|[^a-z0-9])(samples?|minta)([^a-z0-9]|$)/i', $n)) { return false; }
    return !preg_match('#(^|/)(extras?|featurettes?|trailers?|behind[ ._-]the[ ._-]scenes|deleted[ ._-]scenes|interviews?|bonus)/#i', $n);
}

const ST_ARR = '/tmp/qbt_tools_arr.json';

// Radarr movie files and Sonarr episode files by byte size, cached for ten minutes (Sonarr needs one call per series)
function st_arr_index($force = false) {
    $c = st_json_read(ST_ARR, []);
    if (!$force && !empty($c['t']) && time() - $c['t'] < 600) { return $c; }
    $cfg = st_cfg(); $movies = []; $eps = []; $byname = []; $sname = [];
    if (($cfg['radarr']['url'] ?? '') !== '') {
        [$code, $j] = st_arr('radarr', '/movie', 'GET', null, 120);
        foreach ((array)$j as $m) {
            if (empty($m['movieFile']['size'])) { continue; }
            $mf = $m['movieFile']; $q = $mf['quality']['quality'] ?? [];
            $ent = ['id' => (int)$m['id'], 'title' => $m['title'] . ' (' . ($m['year'] ?? '') . ')', 'file' => (int)$mf['id'], 'size' => (float)$mf['size'],
                'path' => (string)($mf['path'] ?? ''), 'res' => (int)($q['resolution'] ?? 0), 'q' => (string)($q['name'] ?? ''), 'hdr' => st_hdr_rank($mf['mediaInfo']['videoDynamicRangeType'] ?? '')];
            $movies[(string)(int)$mf['size']][] = $ent;
            $byname[st_norm($m['title']) . (int)($m['year'] ?? 0)][] = $ent;
        }
    }
    if (($cfg['sonarr']['url'] ?? '') !== '') {
        [$code, $series] = st_arr('sonarr', '/series', 'GET', null, 120);
        foreach ((array)$series as $s) {
            $names = [(string)($s['title'] ?? '')]; foreach ((array)($s['alternateTitles'] ?? []) as $at) { $names[] = (string)($at['title'] ?? ''); }
            foreach ($names as $nm) { if ($nm === '') { continue; } $sname[st_norm($nm)][(int)$s['id']] = ['id' => (int)$s['id'], 'title' => (string)$s['title'], 'year' => (int)($s['year'] ?? 0)]; }
            [$c2, $files] = st_arr('sonarr', '/episodefile?seriesId=' . (int)$s['id'], 'GET', null, 60);
            foreach ((array)$files as $f) {
                if (empty($f['size'])) { continue; }
                $q = $f['quality']['quality'] ?? [];
                $eps[(string)(int)$f['size']][] = ['id' => (int)$s['id'], 'title' => (string)$s['title'], 'file' => (int)$f['id'], 'season' => (int)$f['seasonNumber'], 'size' => (float)$f['size'],
                    'path' => (string)($f['path'] ?? ''), 'res' => (int)($q['resolution'] ?? 0), 'q' => (string)($q['name'] ?? ''), 'hdr' => st_hdr_rank($f['mediaInfo']['videoDynamicRangeType'] ?? '')];
            }
        }
    }
    $c = ['t' => time(), 'movies' => $movies, 'eps' => $eps, 'byname' => $byname, 'sname' => $sname];
    st_json_write(ST_ARR, $c);
    return $c;
}

// Matches the video file sizes of a torrent or folder with one Radarr movie or one Sonarr season
function st_arr_match($vids, $name, $index) {
    if (count($vids) === 1 && isset($index['movies'][(string)(int)$vids[0]])) {
        $m = $index['movies'][(string)(int)$vids[0]][0];
        return ['kind' => 'radarr', 'arr_id' => $m['id'], 'title' => $m['title'], 'season' => 0, 'file_ids' => [$m['file']], 'cur_size' => $m['size'],
                'cur_res' => $m['res'] ?: st_res_of($name), 'cur_hdr' => max($m['hdr'], st_hdr_rank($name)), 'cur_quality' => $m['q'], 'media_paths' => [$m['path']]];
    }
    $seasons = []; $hit = 0;
    foreach ($vids as $sz) { foreach ($index['eps'][(string)(int)$sz] ?? [] as $h) { $seasons[$h['id'] . ':' . $h['season']][] = $h; $hit++; break; } }
    // the files of one season are the great majority: a few stray matches of other seasons (equal sizes) do not count
    if (count($seasons) > 1) {
        uasort($seasons, function ($x, $y) { return count($y) <=> count($x); });
        $top = reset($seasons);
        if (count($top) >= max(1, (int)floor(count($vids) * 0.8))) { $seasons = [key($seasons) => $top]; $hit = count($top); }
    }
    if (count($seasons) === 1 && $hit >= max(1, (int)floor(count($vids) * 0.8))) {
        $list = reset($seasons); $f0 = $list[0];
        $tot = 0; foreach ($list as $h) { $tot += $h['size']; }
        return ['kind' => 'sonarr', 'arr_id' => $f0['id'], 'title' => $f0['title'] . ' S' . str_pad((string)$f0['season'], 2, '0', STR_PAD_LEFT), 'season' => $f0['season'],
                'file_ids' => array_map(function ($h) { return $h['file']; }, $list), 'cur_size' => $tot, 'cur_res' => $f0['res'] ?: st_res_of($name),
                'cur_hdr' => max($f0['hdr'], st_hdr_rank($name)), 'cur_quality' => $f0['q'], 'media_paths' => array_map(function ($h) { return $h['path']; }, $list)];
    }
    if (count($seasons) > 1) {
        $det = []; foreach ($seasons as $k => $l) { $det[] = $l[0]['title'] . ' S' . str_pad((string)$l[0]['season'], 2, '0', STR_PAD_LEFT) . ': ' . count($l) . ' file(s)'; }
        return ['kind' => '', 'skip' => 'several seasons', 'note' => 'several seasons in one place: not supported yet (' . count($vids) . ' video file(s) here; matches: ' . implode(', ', $det) . ')'];
    }
    return $vids ? ['kind' => '', 'note' => 'no matching movie or series in Radarr/Sonarr'] : ['kind' => '', 'skip' => 'no video', 'note' => 'no video file'];
}

function st_upd_scan() {
    $cfg = st_cfg();
    st_progress(ST_UPD, 'running', 'Reading qBittorrent...', ['items' => []]);
    $tor = st_qb_torrents();
    if ($tor === null) { st_progress(ST_UPD, 'error', 'Cannot read the torrent list from qBittorrent (check the Seedbox settings).'); return; }
    $minB = (float)$cfg['upd_min_gb'] * 1e9; $minAge = (int)$cfg['upd_min_age'] * 86400;
    $cand = [];
    $out = [];
    foreach ($tor as $t) {
        if ((float)($t['progress'] ?? 0) < 1) { continue; }
        $lo = st_lib_out($t, $cfg);
        if ($lo !== '') { // not part of the library: no tracker check, no matching; listed folded with the reason when big and old
            if ((float)$t['size'] >= (float)$cfg['upd_min_gb'] * 1e9 && (time() - (int)($t['added_on'] ?? time())) >= (int)$cfg['upd_min_age'] * 86400) {
                $out[] = ['hash' => (string)$t['hash'], 'name' => (string)$t['name'], 'size' => (float)$t['size'], 'added' => (int)($t['added_on'] ?? 0), 'dead' => false, 'dead_msg' => '', 'kind' => '', 'note' => '', 'skip' => 'outside the library: ' . $lo];
            }
            continue;
        }
        $dead = false; $dmsg = '';
        $tr = st_qb_json('/api/v2/torrents/trackers?hash=' . rawurlencode((string)$t['hash'])); $works = false;
        foreach ((array)$tr as $x) {
            $s = (int)($x['status'] ?? 0);
            if ($s === 2) { $works = true; }
            if (($s === 4 || $s === 5) && st_dead_kind($x['msg'] ?? '') === 'dead') { $dead = true; $dmsg = (string)$x['msg']; }
        }
        if ($works) { $dead = false; }
        $big = (float)$t['size'] >= $minB && (time() - (int)($t['added_on'] ?? time())) >= $minAge;
        if (!$big && !$dead) { continue; }
        $cand[] = ['t' => $t, 'dead' => $dead, 'dead_msg' => $dmsg];
    }
    st_progress(ST_UPD, 'running', 'Matching with Radarr and Sonarr...', ['total' => count($cand)]);
    $index = $cand ? st_arr_index(true) : ['movies' => [], 'eps' => []];
    $items = [];
    foreach ($cand as $x) {
        $t = $x['t'];
        $files = st_qb_json('/api/v2/torrents/files?hash=' . rawurlencode((string)$t['hash'])) ?: [];
        $vids = [];
        foreach ($files as $f) { if (st_main_video((string)$f['name'])) { $vids[] = (float)$f['size']; } }
        $it = ['hash' => (string)$t['hash'], 'name' => (string)$t['name'], 'size' => (float)$t['size'], 'added' => (int)($t['added_on'] ?? 0),
               'dead' => $x['dead'], 'dead_msg' => $x['dead_msg'], 'kind' => '', 'note' => ''];
        $m = st_arr_match($vids, (string)$t['name'], $index);
        if ($m['kind'] === 'sonarr') { $m['cur_size'] = (float)$t['size']; }
        $items[] = array_merge($it, $m);
    }
    usort($items, function ($a, $b) { return [$b['dead'], $b['size']] <=> [$a['dead'], $a['size']]; });
    // not listed: torrents without a video, packs of several seasons, and the ones the user hid (shown in a folded list)
    [$items, $skipped] = st_upd_split(array_merge($items, $out));
    st_json_write(ST_UPD, ['state' => 'ready', 't' => time(), 'msg' => '', 'items' => $items, 'skipped' => $skipped]);
    st_sum_set('upd', ['n' => count($items)]);
    st_upd_bg_spawn();
}

// Splits the Update me rows into the listed ones and the not listed ones (skip reason, or hidden by the user)
function st_upd_split($rows) {
    $hid = array_flip(st_upd_hidden_read()); $items = []; $skipped = [];
    foreach ($rows as $it) {
        if (isset($hid[$it['hash']])) { $it['skip'] = 'hidden'; }
        if (!empty($it['skip'])) { $skipped[] = $it; } else { unset($it['skip']); $items[] = $it; }
    }
    return [$items, $skipped];
}

// The old torrent of a Shape up replacement was deleted: drop it from the last scan's list too, so it does not come back
// when the finished job is forgotten (7 days) before the next scan. A scan in progress reads qBittorrent anyway.
function st_upd_drop($hash) {
    $u = st_json_read(ST_UPD, []);
    if (($u['state'] ?? '') !== 'ready' || $hash === '') { return; }
    $keep = function ($x) use ($hash) { return strtolower((string)($x['hash'] ?? '')) !== strtolower($hash); };
    $u['items'] = array_values(array_filter((array)($u['items'] ?? []), $keep));
    $u['skipped'] = array_values(array_filter((array)($u['skipped'] ?? []), $keep));
    st_json_write(ST_UPD, $u);
    st_sum_set('upd', ['n' => count($u['items'])]);
}

// Shape up list: drop the torrents that are no longer in qBittorrent (removed by a replacement, by hand, or by Radarr),
// so the list and its counts match what seeds now. Runs from the minute tick; an empty answer (qB starting) changes nothing.
function st_upd_prune($tor) {
    if (!is_array($tor) || !$tor) { return; }
    $u = st_json_read(ST_UPD, []);
    if (($u['state'] ?? '') !== 'ready') { return; }
    $have = []; foreach ($tor as $t) { $have[strtolower((string)($t['hash'] ?? ''))] = 1; }
    $keep = function ($x) use ($have) { return isset($have[strtolower((string)($x['hash'] ?? ''))]); };
    $it = array_values(array_filter((array)($u['items'] ?? []), $keep)); $sk = array_values(array_filter((array)($u['skipped'] ?? []), $keep));
    if (count($it) === count((array)($u['items'] ?? [])) && count($sk) === count((array)($u['skipped'] ?? []))) { return; }
    $u['items'] = $it; $u['skipped'] = $sk;
    st_json_write(ST_UPD, $u);
    st_sum_set('upd', ['n' => count($it)]);
}

// Hide (or show again) one Update me row: only the list changes, nothing in qBittorrent or on the disk
function st_upd_hide($hash, $on) {
    st_upd_hidden_set($hash, $on);
    $u = st_json_read(ST_UPD, []);
    if (($u['state'] ?? '') !== 'ready') { return; }
    $all = array_merge((array)($u['items'] ?? []), (array)($u['skipped'] ?? []));
    foreach ($all as &$it) { if (($it['skip'] ?? '') === 'hidden') { unset($it['skip']); } }
    unset($it);
    usort($all, function ($a, $b) { return [$b['dead'], $b['size']] <=> [$a['dead'], $a['size']]; });
    [$u['items'], $u['skipped']] = st_upd_split($all);
    st_json_write(ST_UPD, $u);
    st_sum_set('upd', ['n' => count($u['items'])]);
}

// Interactive search in Radarr / Sonarr and the filter. $mode 'upd': same or higher resolution, same HDR format or
// better, at least the chosen saving. 'repl' (a replacement for content nobody seeds, or a dead tracker): same or higher
// resolution and HDR, any size, and it must have seeders.
function st_search_item($key, $it, $mode) {
    $cfg = st_cfg();
    $info = ''; $dropped = [];
    $put = function ($state, $msg, $rows = [], $item = null) use ($key, &$info, &$dropped, $mode) {
        st_res_set($key, ['state' => $state, 't' => time(), 'rows' => $rows, 'msg' => $msg, 'item' => $item, 'info' => $info, 'dropped' => $dropped, 'mode' => $mode]);
    };
    $put('running', 'Searching...');
    if (empty($it['kind'])) { $put('error', $it['note'] ?? 'This is not matched to Radarr or Sonarr'); return; }
    $q = $it['kind'] === 'radarr' ? '/release?movieId=' . $it['arr_id'] : '/release?seriesId=' . $it['arr_id'] . '&seasonNumber=' . $it['season'];
    // a single episode in the library: look for single-episode releases of that episode (a season pack would import the whole season)
    $epMode = false; $epInfo = ''; $epNum = 0;
    if ($it['kind'] === 'sonarr' && (count((array)($it['file_ids'] ?? [])) === 1 || (preg_match('/S\d{1,2}E\d{1,3}/i', (string)($it['name'] ?? '')) && !preg_match('/S\d{1,2}E\d{1,3}[-_.]?E\d{1,3}/i', (string)($it['name'] ?? ''))))) {
        $ep1 = null;
        if (!empty($it['file_ids'][0])) {
            [$ce, $eps1] = st_arr('sonarr', '/episode?seriesId=' . (int)$it['arr_id'] . '&episodeFileId=' . (int)$it['file_ids'][0]);
            if (is_array($eps1) && count($eps1) === 1 && !empty($eps1[0]['id'])) { $ep1 = $eps1[0]; }
        }
        if (!$ep1 && preg_match('/S(\d{1,2})E(\d{1,3})/i', (string)($it['name'] ?? ''), $mm)) {
            [$ce, $eps2] = st_arr('sonarr', '/episode?seriesId=' . (int)$it['arr_id'] . '&seasonNumber=' . (int)$mm[1]);
            foreach ((array)$eps2 as $e2) { if ((int)($e2['episodeNumber'] ?? -1) === (int)$mm[2] && !empty($e2['id'])) { $ep1 = $e2; } }
        }
        if ($ep1) {
            $epMode = true; $it['ep_id'] = (int)$ep1['id']; $q = '/release?episodeId=' . $it['ep_id'];
            $epNum = (int)($ep1['episodeNumber'] ?? 0);
            $epInfo = ' (single episode S' . str_pad((string)$it['season'], 2, '0', STR_PAD_LEFT) . 'E' . str_pad((string)(int)($ep1['episodeNumber'] ?? 0), 2, '0', STR_PAD_LEFT) . ')';
        } else { $epInfo = ' (episode lookup failed, searching the season)'; }
    }
    $t0 = microtime(true);
    [$code, $j, $err] = st_arr($it['kind'], $q, 'GET', null, 240);
    if ($err !== '' || !is_array($j)) { $put('error', $err ?: 'bad response'); return; }
    // what Radarr/Sonarr judged with: the profile of this title (diagnostics for the rejections)
    $info = ucfirst($it['kind']) . ' returned ' . count($j) . ' releases' . $epInfo . ' in ' . round(microtime(true) - $t0, 1) . ' s';
    [$c1, $mv] = st_arr($it['kind'], ($it['kind'] === 'radarr' ? '/movie/' : '/series/') . (int)$it['arr_id']);
    if (is_array($mv) && isset($mv['qualityProfileId'])) {
        [$c2, $pf] = st_arr($it['kind'], '/qualityprofile/' . (int)$mv['qualityProfileId']);
        if (is_array($pf)) { $info .= '. Profile of this title: ' . ($pf['name'] ?? '?') . (isset($pf['language']['name']) ? ', language: ' . $pf['language']['name'] : '') . (isset($pf['upgradeAllowed']) ? ', upgrades ' . ($pf['upgradeAllowed'] ? 'allowed' : 'NOT allowed') : ''); }
    }
    if (is_array($mv) && !empty($mv['originalLanguage']['name'])) { $info .= '. Original language of the title: ' . $mv['originalLanguage']['name']; }
    $saving = (float)$cfg['upd_saving'] / 100;
    $rows = []; $drop = [];
    $dr = function ($k, $r) use (&$drop, &$dropped) { $drop[$k] = ($drop[$k] ?? 0) + 1; if (count($dropped) < 12) { $dropped[] = ['title' => (string)($r['title'] ?? ''), 'why' => $k, 'size' => (float)($r['size'] ?? 0), 'seeders' => (int)($r['seeders'] ?? 0)]; } };
    foreach ($j as $r) {
        if (!is_array($r) || strtolower((string)($r['protocol'] ?? 'torrent')) !== 'torrent') { continue; }
        if ($it['kind'] === 'sonarr') {
            if ($epMode) {
                if (!empty($r['fullSeason']) || count((array)($r['episodeNumbers'] ?? [])) > 1) { $dr('season pack or multi-episode', $r); continue; }
                // Sonarr also lists the single-episode releases of the other episodes of the season: only this episode counts
                $rt = (string)($r['title'] ?? ''); $rs = (int)($r['seasonNumber'] ?? 0); $re = (array)($r['episodeNumbers'] ?? []);
                if ($epNum > 0) {
                    $okEp = $re ? in_array($epNum, array_map('intval', $re), true) : null;
                    if ($okEp === null && preg_match('/S(\d{1,2})E(\d{1,3})/i', $rt, $mq)) { $okEp = ((int)$mq[2] === $epNum && ((int)$it['season'] <= 0 || (int)$mq[1] === (int)$it['season'])); }
                    if ($okEp === false || ($rs > 0 && (int)$it['season'] > 0 && $rs !== (int)$it['season'])) { $dr('another episode', $r); continue; }
                }
            } elseif (empty($r['fullSeason'])) { $dr('not a season pack', $r); continue; }
            else {
                // a season pack of this season only (Sonarr may list packs of other seasons)
                $rt = (string)($r['title'] ?? ''); $rs = (int)($r['seasonNumber'] ?? 0);
                if ((int)$it['season'] > 0 && $rs > 0 && $rs !== (int)$it['season']) { $dr('another season', $r); continue; }
                if ((int)$it['season'] > 0 && preg_match_all('/(?<![A-Za-z0-9])S(\d{1,2})(?![0-9]|E\d)/i', $rt, $mm2)) {
                    $ss = array_unique(array_map('intval', $mm2[1]));
                    if (count($ss) !== 1 || $ss[0] !== (int)$it['season']) { $dr('another season', $r); continue; }
                }
            }
        }
        $title = (string)($r['title'] ?? ''); $size = (float)($r['size'] ?? 0);
        if ($size <= 0 || st_norm($title) === st_norm($it['name'])) { continue; }
        $res_ = preg_match('/(2160|1080|720|480|576)[pi]/i', $title) ? st_res_of($title) : max((int)($r['quality']['quality']['resolution'] ?? 0), st_res_of($title)); // Radarr / Sonarr sometimes misjudge names without a resolution (BD25 and the like)
        $hdr = st_hdr_rank($title);
        if ($it['cur_res'] > 0 && $res_ > 0 && $res_ < $it['cur_res']) { $dr('lower resolution', $r); continue; }
        if ($mode === 'upd' && $it['cur_res'] > 0 && $res_ <= 0) { $dr('resolution unknown', $r); continue; } // a name Radarr / Sonarr cannot read (Az ötödik elem, 837 MB) is no offer
        if ($mode !== 'repl' && $hdr < $it['cur_hdr']) { $dr(!st_dv_all() && st_hdr_kind($title) === 'dv' ? 'DV only: no HDR10 fallback for a TV without DV' : 'lower HDR format', $r); continue; } // replacing unseeded content: any HDR format is fine, the same one is listed first
        $save = $it['cur_size'] > 0 ? 1 - $size / $it['cur_size'] : 0;
        $cats = [];
        if ($mode === 'upd') {
            // what the release offers: smaller by the saving, a better HDR format, a higher resolution (upgrades may grow by upd_upg_growth %)
            $fits = (float)$cfg['upd_upg_growth'] <= 0 || $it['cur_size'] <= 0 || $size <= $it['cur_size'] * (1 + (float)$cfg['upd_upg_growth'] / 100);
            if (!empty($cfg['upd_cat_save']) && $save >= $saving - 1e-9) { $cats[] = 'save'; } // 1e-9: exactly the saving counts (float rounding)
            if (!empty($cfg['upd_cat_hdr']) && $hdr > (int)$it['cur_hdr'] && $fits) { $cats[] = 'hdr'; }
            if (!empty($cfg['upd_cat_res']) && (int)$it['cur_res'] > 0 && $res_ > (int)$it['cur_res'] && $fits) { $cats[] = 'res'; }
            if (!$cats && empty($it['dead'])) { $dr(($hdr > (int)$it['cur_hdr'] || $res_ > (int)$it['cur_res']) && !$fits ? 'upgrade, but too big' : 'not small enough, no upgrade', $r); continue; }
        }
        if ($mode === 'repl' && (int)($r['seeders'] ?? 0) < 1) { $dr('no seeders', $r); continue; }
        if ($mode === 'repl' && (float)$cfg['repl_max_growth'] > 0 && $it['cur_size'] > 0 && $size > $it['cur_size'] * (1 + (float)$cfg['repl_max_growth'] / 100)) { $dr('too big', $r); continue; }
        $langs = []; foreach ((array)($r['languages'] ?? []) as $l) { $langs[] = (string)($l['name'] ?? ''); }
        $isHun = (bool)(preg_grep('/hungar/i', $langs) || preg_match('/\b(hun|hundub|magyar)\b/i', $title));
        $rows[] = ['guid' => (string)$r['guid'], 'indexer_id' => (int)($r['indexerId'] ?? 0), 'title' => $title, 'size' => $size, 'saving' => round($save * 100, 1),
                   'res' => $res_, 'hdr' => st_hdr_label($hdr), 'hdr_rank' => $hdr, 'hun' => $isHun,
                   'seeders' => (int)($r['seeders'] ?? 0), 'indexer' => (string)($r['indexer'] ?? ''), 'quality' => (string)($r['quality']['quality']['name'] ?? ''),
                   'rejected' => !empty($r['rejected']), 'rejections' => array_slice(array_map('strval', (array)($r['rejections'] ?? [])), 0, 3), 'cats' => $cats];
    }
    if ($mode === 'repl') {
        // equal or better: the closest size first keeps what you have
        $cur = (float)$it['cur_size'];
        $cr = (int)$it['cur_res']; $ch = (int)$it['cur_hdr'];
        $cat = function ($r) use ($cr, $ch) { return ($r['res'] === $cr && $r['hdr_rank'] === $ch) ? 0 : 1; }; // 0: the same resolution and HDR format
        // better HDR (DV first), then higher resolution, then the size closest to the current file
        usort($rows, function ($a, $b) use ($cur) { return [$b['hdr_rank'], $b['res'], abs($a['size'] - $cur)] <=> [$a['hdr_rank'], $a['res'], abs($b['size'] - $cur)]; });
    } else {
        // Hungarian audio first (not required: English audio with Hungarian subtitles is fine), then the better HDR format and resolution,
        // then the biggest release, which keeps the most quality
        usort($rows, function ($a, $b) { return [$b['hun'], $b['hdr_rank'], $b['res'], $b['size']] <=> [$a['hun'], $a['hdr_rank'], $a['res'], $a['size']]; });
    }
    $rows = array_slice($rows, 0, 10);
    $it['mode'] = $mode;
    $why = ''; if ($drop && count($rows)) { arsort($drop); $parts = []; foreach ($drop as $k => $v) { $parts[] = $v . ' ' . $k; } $info .= '. Filtered out: ' . implode(', ', $parts); }
    if ($drop) { arsort($drop); $parts = []; foreach ($drop as $k => $v) { $parts[] = $v . ' ' . $k; } $why = ' Filtered out: ' . implode(', ', $parts) . '.'; }
    $put('ready', count($rows) ? '' : 'No release meets the conditions. ' . $info . '.' . $why, $rows, $it);
}

// ---- background check: after a scan every listed torrent is searched, one every ~90 seconds (the trackers must not see a burst),
// a result is kept for ST_UPD_FRESH; the page then lists the torrents with an offer first
const ST_UPDBG = '/tmp/qbt_tools_updbg.json';
const ST_UPD_FRESH = 10 * 86400;
function st_upd_bg_fresh($rr) { return is_array($rr) && in_array($rr['state'] ?? '', ['ready', 'error'], true) && ($rr['mode'] ?? 'upd') === 'upd' && time() - (int)($rr['t'] ?? 0) < (($rr['state'] ?? '') === 'error' ? 86400 : ST_UPD_FRESH); }
function st_upd_bg_count($upd, $res) {
    $tot = 0; $done = 0;
    foreach ((array)($upd['items'] ?? []) as $x) { if (empty($x['kind'])) { continue; } $tot++; if (st_upd_bg_fresh($res[$x['hash']] ?? null)) { $done++; } }
    return [$done, $tot];
}
function st_upd_bg($gap = 90) {
    @unlink('/tmp/qbt_tools_updbg.stop');
    while (true) {
        if (is_file('/tmp/qbt_tools_updbg.stop')) { @unlink('/tmp/qbt_tools_updbg.stop'); $w = st_json_read(ST_UPDBG, []); $w['state'] = 'stopped'; $w['t'] = time(); st_json_write(ST_UPDBG, $w); return; }
        $upd = st_json_read(ST_UPD, []); $res = st_json_read(ST_RES, []);
        if (($upd['state'] ?? '') === 'running') { sleep(10); continue; } // a new scan is running: wait for its list
        if (($upd['state'] ?? '') !== 'ready') { return; } // no list (the plugin was updated, /tmp cleared): the next scan starts a new search
        [$done, $tot] = st_upd_bg_count($upd, $res);
        $next = null;
        foreach ((array)$upd['items'] as $x) { if (!empty($x['kind']) && !st_upd_bg_fresh($res[$x['hash']] ?? null) && !(($res[$x['hash']]['state'] ?? '') === 'running' && time() - (int)($res[$x['hash']]['t'] ?? 0) < 900)) { $next = $x; break; } } // a search you started is not repeated
        if (!$next) { st_json_write(ST_UPDBG, ['state' => 'done', 't' => time(), 'done' => $done, 'total' => $tot]); return; }
        st_json_write(ST_UPDBG, ['state' => 'running', 't' => time(), 'done' => $done, 'total' => $tot, 'cur' => $next['name']]);
        $next['old_hash'] = $next['hash']; $next['old_path'] = '';
        st_search_item($next['hash'], $next, 'upd');
        for ($i = 0; $i < $gap; $i += 5) { if (is_file('/tmp/qbt_tools_updbg.stop')) { break; } sleep(5); }
    }
}

function st_upd_bg_spawn() {
    $php = '/usr/bin/php'; foreach (['/usr/bin/php', '/usr/local/bin/php'] as $p) { if (is_executable($p)) { $php = $p; break; } }
    if (getenv('DBX_ST_DIR')) { return; } // tests call st_upd_bg() themselves
    @exec('setsid nohup ' . escapeshellarg($php) . ' ' . escapeshellarg(__DIR__ . '/tools_run.php') . ' updbg >/dev/null 2>&1 &');
}

function st_upd_search($hash) {
    $upd = st_json_read(ST_UPD, []);
    foreach ((array)($upd['items'] ?? []) as $x) { if ($x['hash'] === $hash) { $x['old_hash'] = $hash; $x['old_path'] = ''; st_search_item($hash, $x, 'upd'); return; } }
    st_search_item($hash, ['kind' => '', 'note' => 'This torrent is not in the last scan'], 'upd');
}

// Replacement for a folder or file that nobody seeds (or whose tracker removed the torrent)
function st_find_repl_search($itemId) {
    $find = st_json_read(ST_FIND, []);
    $unit = null; foreach ((array)($find['items'] ?? []) as $x) { if ($x['id'] === $itemId) { $unit = $x; } }
    if (!$unit) { st_search_item('f' . substr(md5($itemId), 0, 12), ['kind' => '', 'note' => 'unknown item'], 'repl'); return; }
    st_find_repl_unit($unit, st_arr_index());
}
function st_find_repl_unit($unit, $index, $quiet = false) {
    $key = 'f' . substr(md5($unit['path']), 0, 12);
    $vids = [];
    $out = (string)@shell_exec('find ' . escapeshellarg($unit['path']) . ' -type f -printf ' . escapeshellarg('%s\t%p\n') . ' 2>/dev/null');
    foreach (explode("\n", $out) as $l) { $p = explode("\t", $l, 2); if (count($p) === 2 && st_main_video($p[1])) { $vids[] = (float)$p[0]; } }
    $m = st_arr_match($vids, $unit['name'], $index);
    if (empty($m['kind']) && preg_match('/^(.+?)[. _(\[]((?:19|20)\d\d)(?=[. _)\]])/', (string)$unit['name'], $mm)) {
        // sizes differ from the library (another release is imported): match the movie by title and year
        $hits = (array)($index['byname'][st_norm($mm[1]) . (int)$mm[2]] ?? []);
        if (count($hits) === 1) {
            $h = $hits[0];
            $m = ['kind' => 'radarr', 'arr_id' => $h['id'], 'title' => $h['title'], 'season' => 0, 'file_ids' => [$h['file']], 'cur_size' => (float)$unit['size'],
                  'cur_res' => $h['res'] ?: st_res_of($unit['name']), 'cur_hdr' => max($h['hdr'], st_hdr_rank($unit['name'])), 'cur_quality' => $h['q'], 'media_paths' => [$h['path']]];
        }
    }
    if (empty($m['kind']) && preg_match('/^(.+?)[. _]+((?:19|20)\d\d)?[. _]*S(\d{1,2})E(\d{1,3})(?!\d)/i', (string)$unit['name'], $ms)) {
        // an episode whose library file is another release: match the series by name (and year when the folder name has one)
        $key2 = st_norm(preg_replace('/[. _]+(19|20)\d\d$/', '', $ms[1]));
        $cand = array_values((array)($index['sname'][$key2] ?? []));
        if ($ms[2] !== '') { $by = array_values(array_filter($cand, function ($c) use ($ms) { return !$c['year'] || (int)$c['year'] === (int)$ms[2]; })); if ($by) { $cand = $by; } }
        if (count($cand) === 1) {
            $sr = $cand[0]; $fid = 0;
            [$ce, $eps3] = st_arr('sonarr', '/episode?seriesId=' . (int)$sr['id'] . '&seasonNumber=' . (int)$ms[3]);
            foreach ((array)$eps3 as $e3) { if ((int)($e3['episodeNumber'] ?? -1) === (int)$ms[4]) { $fid = (int)($e3['episodeFileId'] ?? 0); } }
            $m = ['kind' => 'sonarr', 'arr_id' => $sr['id'], 'title' => $sr['title'] . ' S' . str_pad((string)(int)$ms[3], 2, '0', STR_PAD_LEFT), 'season' => (int)$ms[3], 'file_ids' => $fid ? [$fid] : [],
                  'cur_size' => (float)$unit['size'], 'cur_res' => st_res_of($unit['name']), 'cur_hdr' => st_hdr_rank($unit['name']), 'cur_quality' => '', 'media_paths' => []];
        }
    }
    if ($quiet && empty($m['kind'])) { return; } // not in Radarr/Sonarr: the row keeps its Replace button, the reason shows when it is pressed
    $it = array_merge(['name' => $unit['name'], 'size' => $unit['size'], 'dead' => false, 'old_hash' => (string)($unit['old'] ?? ''), 'old_path' => $unit['path'], 'why' => (string)($unit['why'] ?? '')], $m);
    if ($m['kind'] === 'sonarr') { $it['cur_size'] = $unit['size']; }
    st_search_item($key, $it, 'repl');
}

// Why a title is being replaced, in one sentence (for Discord)
function st_job_reason($j) {
    if (($j['mode'] ?? '') === 'repl') {
        if (!empty($j['dead']) || ($j['why'] ?? '') === 'tracker removed it') { return st_l('Ok: a tracker törölte a torrentet, így a tartalom már nem seedelhető; helyette egyenértékű vagy jobb kiadás kerül be.', 'Cause: the tracker removed the torrent, so the content can no longer be seeded; an equal or better release replaces it.'); }
        return st_l('Ok: ehhez a mappához nem volt seedelt torrent és Prowlarr sem talált hozzá egyezőt; helyette egyenértékű vagy jobb kiadás kerül be.', 'Cause: no torrent seeded this folder and Prowlarr found no match; an equal or better release replaces it.');
    }
    return st_l('Ok: nagy és régi cím, az új kiadás ' . abs((int)($j['saving'] ?? 0)) . '%-kal kisebb, felbontás és DV/HDR nem romlik.', 'Cause: big and old title; the new release is ' . abs((int)($j['saving'] ?? 0)) . '% smaller with no loss of resolution or DV/HDR.');
}

// Sends a release to Radarr/Sonarr. The item (what is being replaced) comes from the stored search.
function st_replace_grab($key, $guid) {
    $res = st_json_read(ST_RES, []);
    $it = $res[$key]['item'] ?? null; $mode = $it['mode'] ?? '';
    $row = null; foreach ((array)($res[$key]['rows'] ?? []) as $r) { if ($r['guid'] === $guid) { $row = $r; } }
    if (!$it || !$row) { return [false, 'unknown item or release (search again)']; }
    $lk = st_action_lock(); if (!$lk) { return [false, 'another replacement is being started or removed right now; try again in a minute']; }
    try { return st_replace_grab_do($key, $it, $mode, $row); } finally { st_action_unlock($lk); }
}
function st_replace_grab_do($key, $it, $mode, $row) {
    $state = st_state();
    foreach ($state['jobs'] as $j) { if ($j['key'] === $key && !in_array($j['stage'], ['removed', 'failed', 'cleaned'], true)) { return [false, 'this title already has a replacement in progress']; } }
    [$code, $j, $err] = st_arr($it['kind'], '/release', 'POST', ['guid' => $row['guid'], 'indexerId' => $row['indexer_id']], 60);
    if ($err !== '' && stripos($err, 'cache') !== false) {
        // Radarr/Sonarr keep a search result only for a short while: search again with the same settings and retry once
        st_search_item($key, $it, $mode);
        $res = st_json_read(ST_RES, []);
        $row2 = null; foreach ((array)($res[$key]['rows'] ?? []) as $r) { if ($r['guid'] === $row['guid'] || $r['title'] === $row['title']) { $row2 = $r; break; } }
        if (!$row2) { return [false, 'the release is no longer offered by ' . $it['kind'] . ' (search again)']; }
        $row = $row2;
        [$code, $j, $err] = st_arr($it['kind'], '/release', 'POST', ['guid' => $row['guid'], 'indexerId' => $row['indexer_id']], 60);
    }
    if ($err !== '') { return [false, $it['kind'] . ' refused the release: ' . $err]; }
    $cfg = st_cfg();
    $media = [];
    foreach ((array)($it['media_paths'] ?? []) as $p) { if ($p !== '') { $media[] = st_to_host($p, $cfg); } }
    $job = ['id' => substr(md5($key . microtime()), 0, 10), 'key' => $key, 'mode' => $mode === 'repl' ? 'repl' : 'upd', 'hash' => (string)($it['old_hash'] ?? ''), 'old_path' => (string)($it['old_path'] ?? ''),
                        'kind' => $it['kind'], 'arr_id' => $it['arr_id'], 'season' => $it['season'], 'ep_id' => (int)($it['ep_id'] ?? 0), 'title' => $it['title'], 'old_name' => $it['name'], 'old_size' => $it['size'],
                        'file_ids' => $it['file_ids'], 'media_paths' => $media, 'new' => $row['title'], 'new_size' => $row['size'], 't' => time(), 'gt' => time(), 'stage' => 'grabbed', 'msg' => 'sent to ' . $it['kind'],
                        'why' => (string)($it['why'] ?? ''), 'dead' => !empty($it['dead']), 'saving' => $row['saving'] ?? 0, 'seeders' => $row['seeders'] ?? 0, 'q' => ($row['res'] ?? '') . 'p ' . ($row['hdr'] ?? '')];
    st_state_update(function (&$s) use ($job) { $s['jobs'][] = $job; });
    $j = $job;
    st_notify('i', st_l('Seedbox: csere elindítva', 'Seedbox: replacement started'), st_job_reason($j) . ' ' . st_l('Elküldtem a ' . ucfirst($j['kind']) . 'nak, az import után takarítok.', 'Sent to ' . ucfirst($j['kind']) . '; the old files are cleaned up after the import.'),
        [[st_l('Cím', 'Title'), $j['title']], [st_l('Régi', 'Old'), $j['old_name'] . ' (' . st_gb($j['old_size']) . ')'], [st_l('Új', 'New'), $j['new'] . ' (' . st_gb($j['new_size']) . ', ' . $j['q'] . ', ' . $j['seeders'] . ' seeder)']], false, st_ntool($j));
    return [true, ''];
}

// Tags the torrent that Radarr / Sonarr grabbed for a replacement job in qBittorrent: findmytorrent for a replacement of unseeded content,
// updateme for a smaller release. The torrent is recognised by its name (the release title) and by being added after the job started.
function st_job_tag($j, $tor) {
    $want = st_norm($j['new'] ?? ''); if ($want === '') { return false; }
    foreach ($tor as $t) {
        if (st_norm($t['name'] ?? '') !== $want || (int)($t['added_on'] ?? 0) < (int)($j['gt'] ?? $j['t']) - 600) { continue; }
        [$c] = st_qb('/api/v2/torrents/addTags', ['hashes' => $t['hash'], 'tags' => (($j['mode'] ?? '') === 'repl') ? 'findmytorrent' : 'updateme']);
        if ($c === 200) { return true; } // qBittorrent busy or unreachable: not tagged yet, the next check tries again
        continue;
    }
    return false;
}

// Activity summary of the replacements still downloading: bytes left of their torrents and qBittorrent's total download
// speed (the torrents share the line, so one ETA for all of them). Read-only: two GETs, only while something downloads.
// Radarr/Sonarr time left ('16.07:31:53' = 16 days 7 hours) in a readable form: '16 d 7 h', '1 h 17 m', '9 m'
function st_fmt_left($tl) {
    if (!preg_match('/^(?:(\d+)\.)?(\d+):(\d+):(\d+)/', $tl, $m)) { return $tl; }
    $d = (int)$m[1]; $h = (int)$m[2]; $mi = (int)$m[3];
    if ($d) { return $d . ' d ' . $h . ' h'; }
    if ($h) { return $h . ' h ' . $mi . ' m'; }
    return max(1, $mi) . ' m';
}
function st_dl_summary($s) {
    $want = []; $hashes = [];
    foreach ((array)($s['jobs'] ?? []) as $j) { if (in_array($j['stage'] ?? '', ['grabbed', 'downloading'], true)) { $want[st_norm($j['new'] ?? '')] = (string)($j['id'] ?? ''); } }
    foreach ((array)($s['packjobs'] ?? []) as $j) {
        if (!in_array($j['stage'] ?? '', ['grabbed', 'downloading'], true)) { continue; }
        if (!empty($j['hash'])) { $hashes[strtolower((string)$j['hash'])] = (string)($j['id'] ?? ''); } else { $want[st_norm($j['pack'] ?? '')] = (string)($j['id'] ?? ''); }
    }
    unset($want['']);
    $n = count($want) + count($hashes);
    if (!$n) { return null; }
    $tor = st_qb_json('/api/v2/torrents/info'); // all: a finished download may be moving or waiting for the import
    $ti = st_qb_json('/api/v2/transfer/info');
    if ($tor === null || $ti === null) { return ['jobs' => $n, 'err' => 'qBittorrent did not answer']; }
    $left = 0; $found = 0; $stalled = 0; $seeds = 0; $swarm = 0; $stall = []; $per = [];
    $mv = 0.0; $mrate = 0; $last = 0.0; $lastEta = -1; // bytes still to move to the array, the measured move speed, the download that ends last
    $dl = array_flip(['downloading', 'metaDL', 'forcedMetaDL', 'stalledDL', 'checkingDL', 'pausedDL', 'stoppedDL', 'queuedDL', 'forcedDL', 'allocating']);
    foreach ($tor as $t) {
        $id = $hashes[strtolower((string)($t['hash'] ?? ''))] ?? $want[st_norm($t['name'] ?? '')] ?? null;
        if ($id === null) { continue; }
        // per job (its own Activity row): progress, bytes, speed and time left; a move gets its own measured progress
        $st = (string)($t['state'] ?? ''); $size = (float)($t['size'] ?? 0); $eta = (int)($t['eta'] ?? -1);
        if ($id !== '') {
            if ($st === 'moving') {
                [$mf, $me, $mw] = st_move_info($t);
                $per[$id] = ['st' => $mw ? 'movewait' : 'moving', 'p' => $mf, 'size' => $size, 'speed' => ($me > 0 ? (int)((1 - $mf) * $size / $me) : 0), 'eta' => $me];
                $mv += $mw ? $size : (1 - $mf) * $size;
                if ($per[$id]['speed'] > 0) { $mrate = max($mrate, $per[$id]['speed']); }
            } else {
                $per[$id] = ['st' => isset($dl[$st]) ? 'dl' : 'done', 'p' => (float)($t['progress'] ?? 0), 'size' => $size, 'done' => max(0, $size - (float)($t['amount_left'] ?? 0)),
                             'speed' => (int)($t['dlspeed'] ?? 0), 'eta' => ($eta > 0 && $eta < 8640000) ? $eta : -1];
            }
        }
        if (!isset($dl[$st])) { continue; } // the summary line counts what still downloads
        $found++; $left += (float)($t['amount_left'] ?? 0);
        // it downloads to an incomplete folder (cache): qBittorrent moves it to the save path when it is done, one torrent at a time
        $dp = rtrim((string)($t['download_path'] ?? ''), '/');
        if ($dp !== '' && $dp !== rtrim((string)($t['save_path'] ?? ''), '/')) {
            $mv += $size;
            if ($eta > $lastEta || ($eta < 0 && $lastEta >= 0)) { $lastEta = $eta < 0 ? PHP_INT_MAX : $eta; $last = $size; }
        }
        // per job: why this one does not move (shown on its own Activity row)
        if ((string)($t['state'] ?? '') === 'stalledDL') { $stalled++; if ($id !== '') { $stall[$id] = ['seeds' => max(0, (int)($t['num_seeds'] ?? 0)), 'swarm' => max(0, (int)($t['num_complete'] ?? 0))]; } }
        $seeds += max(0, (int)($t['num_seeds'] ?? 0)); $swarm += max(0, (int)($t['num_complete'] ?? 0));
    }
    // the move speed: measured now, otherwise the last measurement (kept a week; a guess is never shown)
    $rf = '/tmp/qbt_move_rate.json';
    if ($mrate > 0) { @file_put_contents($rf, json_encode(['t' => time(), 'r' => $mrate])); }
    elseif (is_file($rf)) { $r = json_decode((string)@file_get_contents($rf), true); if (is_array($r) && time() - (int)($r['t'] ?? 0) < 7 * 86400) { $mrate = (int)($r['r'] ?? 0); } }
    // stalled: qBittorrent's own state; seeds = seeders connected now, swarm = seeders the tracker lists
    return ['jobs' => $n, 'found' => $found, 'left' => $left, 'speed' => (int)($ti['dl_info_speed'] ?? 0), 'stalled' => $stalled, 'seeds' => $seeds, 'swarm' => $swarm, 'stall' => $stall, 'per' => $per,
            'mv' => $mv, 'mrate' => $mrate, 'mlast' => $last];
}

// Where is a replacement job: downloading / blocked (the *arr says why) / imported (the old file is gone)
function st_job_status($j) {
    $kind = $j['kind'];
    if ($kind === 'radarr') {
        [$c, $m] = st_arr('radarr', '/movie/' . (int)$j['arr_id']);
        if (!is_array($m)) { return null; }
        $fid = (int)($m['movieFile']['id'] ?? 0);
        if ($fid > 0 && !in_array($fid, $j['file_ids'], true)) { return ['stage' => 'imported', 'msg' => 'imported by Radarr; the old file was replaced']; }
        $key = 'movieId';
    } else {
        $cur = [];
        if (!empty($j['ep_id'])) {
            [$c, $ep] = st_arr('sonarr', '/episode/' . (int)$j['ep_id']);
            if (!is_array($ep)) { return null; }
            if ((int)($ep['episodeFileId'] ?? 0) > 0) { $cur[] = (int)$ep['episodeFileId']; }
        } else {
            [$c, $files] = st_arr('sonarr', '/episodefile?seriesId=' . (int)$j['arr_id']);
            if (!is_array($files)) { return null; }
            foreach ($files as $f) { if ((int)$f['seasonNumber'] === (int)$j['season']) { $cur[] = (int)$f['id']; } }
        }
        if ($cur && !array_intersect($cur, $j['file_ids'])) { return ['stage' => 'imported', 'msg' => 'imported by Sonarr; the old files were replaced']; }
        $key = 'seriesId';
    }
    [$c, $q] = st_arr($kind, '/queue?page=1&pageSize=200');
    foreach ((array)($q['records'] ?? []) as $r) {
        if ((int)($r[$key] ?? 0) !== (int)$j['arr_id']) { continue; }
        if ($kind === 'sonarr' && isset($r['seasonNumber']) && (int)$r['seasonNumber'] !== (int)$j['season']) { continue; }
        if ($kind === 'sonarr' && !empty($j['ep_id']) && isset($r['episodeId']) && (int)$r['episodeId'] !== (int)$j['ep_id']) { continue; }
        $tds = (string)($r['trackedDownloadState'] ?? ''); $tdst = (string)($r['trackedDownloadStatus'] ?? '');
        if ($tds === 'importBlocked' || $tdst === 'error' || $tdst === 'warning') {
            $msgs = [];
            foreach ((array)($r['statusMessages'] ?? []) as $sm) { foreach ((array)($sm['messages'] ?? []) as $mm) { $msgs[] = (string)$mm; } if (!empty($sm['title']) && !$msgs) { $msgs[] = (string)$sm['title']; } }
            return ['stage' => 'blocked', 'msg' => 'waiting: ' . ($msgs ? implode(' / ', array_slice($msgs, 0, 2)) : ($tds ?: $tdst))];
        }
        $left = (float)($r['sizeleft'] ?? 0); $size = (float)($r['size'] ?? 0);
        $p = $size > 0 ? ($left > 0 ? min(99, (int)floor((1 - $left / $size) * 100)) : 100) : 0;
        return ['stage' => 'downloading', 'msg' => 'downloading ' . $p . '%' . (!empty($r['timeleft']) ? ', ' . st_fmt_left((string)$r['timeleft']) . ' left' : '')];
    }
    if (time() - (int)$j['t'] > 1800) { return ['stage' => 'blocked', 'msg' => 'not in the queue and not imported: check ' . $kind]; }
    return null;
}

// ---- removing what was replaced ---------------------------------------------------------------------------------
const ST_TRASH = '.seedbox_trash';

function st_under_roots($path, $cfg) {
    $rp = realpath($path);
    if ($rp === false) { return false; }
    foreach ((array)$cfg['roots'] as $r) {
        $rr = realpath($r);
        if ($rr !== false && $rp !== $rr && strpos($rp, $rr . '/') === 0 && strpos($rp, '/' . ST_TRASH . '/') === false) { return $rr; }
    }
    return false;
}
function st_rm_tree($p) {
    if (is_link($p) || is_file($p)) { return @unlink($p); }
    if (!is_dir($p)) { return true; }
    foreach (scandir($p) as $n) { if ($n !== '.' && $n !== '..') { st_rm_tree($p . '/' . $n); } }
    return @rmdir($p);
}

// After a replacement of unseeded content: the old folder or file goes to a trash folder inside its downloads folder
// (or is deleted at once when trash_days is 0), and so does the old hardlink in the media folder if the *arr left it.
// Returns [ok, message].
function st_cleanup_old($j) {
    $cfg = st_cfg(); $msg = []; $msgL = []; $oldIno = [];
    $add = function ($hu, $en) use (&$msg, &$msgL) { $msg[] = $en; $msgL[] = st_l($hu, $en); }; // $msg: English for the page, $msgL: the Discord language
    if ($j['hash'] !== '') { st_qb('/api/v2/torrents/delete', ['hashes' => $j['hash'], 'deleteFiles' => 'false']); st_watch_forget($j['hash']); $add('a régi torrent kikerült a qBittorrentből (a fájlok megmaradtak)', 'old torrent removed from qBittorrent (files kept)'); }
    $p = (string)$j['old_path'];
    if ($p !== '' && file_exists($p)) {
        $root = st_under_roots($p, $cfg);
        if ($root === false) { return [false, 'not removing ' . $p . ': it is not inside a configured downloads folder']; }
        // never remove what a torrent seeds
        $rp = realpath($p);
        foreach ((array)st_qb_torrents() as $t) {
            if ($j['hash'] !== '' && strtolower((string)$t['hash']) === strtolower((string)$j['hash'])) { continue; } // the old torrent itself (just deleted, qBittorrent may still list it)
            $cp = rtrim(st_to_host((string)($t['content_path'] ?? ''), $cfg), '/');
            if ($cp !== '' && ($cp === $rp || strpos($cp, $rp . '/') === 0)) { return [false, 'not removing ' . $p . ': torrent "' . $t['name'] . '" seeds it']; }
        }
        // inodes of the old files: a media link is only removed if it still points at one of them (never the freshly imported file)
        if (is_file($rp)) { $oldIno[(int)@fileinode($rp)] = true; } else { foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($rp, FilesystemIterator::SKIP_DOTS)) as $f) { if ($f->isFile()) { $oldIno[(int)$f->getInode()] = true; } } }
        $days = (int)($cfg['trash_days'] ?? 0);
        if ($days > 0) {
            $tr = $root . '/' . ST_TRASH; @mkdir($tr, 0777, true);
            $dest = $tr . '/' . date('YmdHis') . '_' . basename($rp);
            if (!@rename($rp, $dest)) { return [false, 'could not move ' . $p . ' to the trash folder']; }
            $add('a régi fájlok a ' . ST_TRASH . ' mappába kerültek (' . $days . ' nap után törlődnek)', 'old files moved to ' . ST_TRASH . ' (deleted after ' . $days . ' days)');
        } else {
            if (!st_rm_tree($rp)) { return [false, 'could not delete ' . $p]; }
            $add('a régi fájlok törölve', 'old files deleted');
        }
    }
    // the old hardlink in the media folder (Radarr/Sonarr normally removes it when it upgrades)
    $gone = 0;
    foreach ((array)($j['media_paths'] ?? []) as $mp) {
        if ($mp !== '' && is_file($mp) && strpos(realpath($mp), rtrim($cfg['map_host'], '/') . '/') === 0 && isset($oldIno[(int)@fileinode($mp)])) { if (@unlink($mp)) { $gone++; } }
    }
    if ($gone) { $add($gone . ' régi hardlink törölve a média mappából', $gone . ' old media link(s) removed'); }
    return [true, implode('; ', $msg), implode('; ', $msgL)];
}

// deletes trash entries older than trash_days (called from tick, at most once an hour)
// Every .seedbox_trash folder: in the watched roots and in each folder of the downloads base (a folder whose role changed
// to Not watched may still hold one)
function st_trash_dirs() {
    $cfg = st_cfg(); $out = [];
    $cand = (array)$cfg['roots'];
    $base = rtrim((string)($cfg['dl_base'] ?? ''), '/');
    if ($base !== '' && is_dir($base)) { foreach ((array)@scandir($base) as $n) { if ($n !== '.' && $n !== '..' && is_dir($base . '/' . $n)) { $cand[] = $base . '/' . $n; } } }
    foreach ($cand as $r) { $tr = rtrim($r, '/') . '/' . ST_TRASH; $rp = realpath($tr); if ($rp !== false && is_dir($rp) && basename($rp) === ST_TRASH) { $out[$rp] = true; } }
    return array_keys($out);
}
// what the trash holds now: items (moved folders or files) and bytes
function st_trash_info() {
    $n = 0; $b = 0.0;
    foreach (st_trash_dirs() as $tr) { foreach ((array)@scandir($tr) as $x) { if ($x === '.' || $x === '..') { continue; } $n++; $b += st_dir_size($tr . '/' . $x); } }
    return ['items' => $n, 'bytes' => $b];
}
// Empty the trash now (the owner's button, with a confirm on the page): everything inside the .seedbox_trash folders goes
function st_trash_empty() {
    $n = 0; $fail = [];
    foreach (st_trash_dirs() as $tr) {
        foreach ((array)@scandir($tr) as $x) {
            if ($x === '.' || $x === '..') { continue; }
            if (st_rm_tree($tr . '/' . $x)) { $n++; } else { $fail[] = $x; }
        }
    }
    if ($n) { st_notify('i', st_l('Seedbox: kuka kiürítve', 'Seedbox: trash emptied'), st_l($n . ' elem véglegesen törölve a .seedbox_trash mappákból (kézi ürítés).', $n . ' item(s) deleted from the .seedbox_trash folders (emptied by hand).'), [], false, ''); }
    return [$n, $fail];
}

function st_trash_purge() {
    $mark = '/tmp/qbt_tools_purge';
    if (is_file($mark) && time() - (int)@filemtime($mark) < 3600) { return; }
    @touch($mark);
    $cfg = st_cfg(); $days = (int)($cfg['trash_days'] ?? 0);
    if ($days < 1) { return; }
    $purged = [];
    foreach ((array)$cfg['roots'] as $r) {
        $tr = rtrim($r, '/') . '/' . ST_TRASH;
        if (!is_dir($tr)) { continue; }
        foreach (scandir($tr) as $n) {
            if (!preg_match('/^(\d{14})_/', $n, $m)) { continue; }
            $t = DateTime::createFromFormat('YmdHis', $m[1]);
            if ($t && time() - $t->getTimestamp() > $days * 86400) { st_rm_tree($tr . '/' . $n); $purged[] = preg_replace('/^\d{14}_/', '', $n); }
        }
    }
    if ($purged) {
        st_notify('i', st_l('Seedbox: kuka kiürítve', 'Seedbox: trash emptied'), st_l($days . ' napnál régebbi elem véglegesen törölve a .seedbox_trash mappából (csere utáni régi fájlok).', 'Items older than ' . $days . ' days were permanently deleted from .seedbox_trash (old files left over from replacements).'),
            [[st_l('Törölve', 'Deleted'), implode("\n", array_slice($purged, 0, 10)) . (count($purged) > 10 ? "\n+" . (count($purged) - 10) : '')]], false, '');
    }
}

// Radarr refuses an import it does not see as an upgrade ("Not an upgrade"), which an equal replacement never is.
// This asks Radarr to import the finished download anyway (the ManualImport command); Radarr then replaces the old file.
function st_force_import($id) {
    $s = st_state(); $job = null; foreach ($s['jobs'] as $j) { if ($j['id'] === $id) { $job = $j; } }
    if (!$job) { return [false, 'unknown job']; }
    if ($job['kind'] !== 'radarr') { return [false, 'forcing the import is only supported for Radarr (movies) so far: import it by hand in Sonarr, Activity, Queue']; }
    if ($job['stage'] !== 'blocked') { return [false, 'this replacement is not blocked']; }
    [$c, $q, $e] = st_arr('radarr', '/queue?page=1&pageSize=200');
    $did = '';
    foreach ((array)($q['records'] ?? []) as $r) { if ((int)($r['movieId'] ?? 0) === (int)$job['arr_id'] && !empty($r['downloadId'])) { $did = (string)$r['downloadId']; } }
    if ($did === '') { return [false, 'the download is not in the Radarr queue (it may still be downloading, or already imported)']; }
    [$c, $list, $e] = st_arr('radarr', '/manualimport?downloadId=' . rawurlencode($did) . '&filterExistingFiles=false', 'GET', null, 120);
    if ($e !== '' || !is_array($list)) { return [false, 'Radarr could not list the downloaded files: ' . ($e ?: 'bad response')]; }
    $files = [];
    foreach ($list as $m) {
        if (empty($m['path']) || !st_main_video((string)$m['path'])) { continue; }
        $files[] = ['path' => $m['path'], 'movieId' => (int)$job['arr_id'], 'quality' => $m['quality'] ?? null, 'languages' => $m['languages'] ?? [], 'releaseGroup' => (string)($m['releaseGroup'] ?? ''), 'downloadId' => $did];
    }
    if (count($files) !== 1) { return [false, 'expected one video file in the download, found ' . count($files) . ': import it by hand in Radarr']; }
    [$c, $r, $e] = st_arr('radarr', '/command', 'POST', ['name' => 'ManualImport', 'files' => $files, 'importMode' => 'auto'], 60);
    if ($e !== '') { return [false, 'Radarr refused the import: ' . $e]; }
    st_state_update(function (&$s) use ($id) { foreach ($s['jobs'] as &$j) { if ($j['id'] === $id) { $j['msg'] = 'import requested from Radarr, waiting for it'; $j['t'] = time(); } } unset($j); });
    return [true, ''];
}

// Name of another torrent whose content is the same as, inside, or around the content of torrent $hash ('' when none).
function st_shared_by($hash, $tors) {
    $hash = strtolower((string)$hash); $mine = '';
    foreach ($tors as $t) { if (strtolower((string)$t['hash']) === $hash) { $mine = rtrim((string)($t['content_path'] ?? ''), '/'); } }
    if ($mine === '') { return ''; }
    foreach ($tors as $t) {
        if (strtolower((string)$t['hash']) === $hash) { continue; }
        $cp = rtrim((string)($t['content_path'] ?? ''), '/');
        if ($cp !== '' && ($cp === $mine || strpos($cp, $mine . '/') === 0 || strpos($mine, $cp . '/') === 0)) { return (string)$t['name']; }
    }
    return '';
}

function st_job_remove_old($id) {
    $lk = st_action_lock(); if (!$lk) { return [false, 'another replacement is being started or removed right now; try again in a minute']; }
    try { return st_job_remove_old_do($id); } finally { st_action_unlock($lk); }
}
function st_job_remove_old_do($id) {
    $j = null; foreach (st_state()['jobs'] as $x) { if ($x['id'] === $id) { $j = $x; } }
    if (!$j) { return [false, 'unknown job']; }
    if (in_array($j['stage'], ['removed', 'cleaned'], true)) { return [false, 'the old files are already removed']; }
    if ($j['stage'] !== 'imported') { return [false, 'the replacement is not imported yet']; }
    $set = function ($stage, $msg) use ($id) { st_state_update(function (&$s) use ($id, $stage, $msg) { foreach ($s['jobs'] as &$x) { if ($x['id'] === $id) { $x['stage'] = $stage; $x['msg'] = $msg; $x['t'] = time(); } } unset($x); }); };
    if ($j['mode'] === 'repl') {
        [$ok, $m, $mL] = st_cleanup_old($j); if (!$ok) { return [false, $m]; }
        $set('cleaned', $m);
        st_notify('g', st_l('Seedbox: régi fájlok eltávolítva', 'Seedbox: old files removed'), $mL, [[st_l('Cím', 'Title'), $j['title']], [st_l('Régi', 'Old'), $j['old_name']]], false, st_ntool($j));
        return [true, ''];
    }
    // another torrent may seed the same files (cross-seed on a second tracker): then only the old torrent goes, the files stay
    $tors = st_qb_torrents();
    if ($tors === null) { return [false, 'qBittorrent did not answer; nothing was deleted']; }
    $share = st_shared_by($j['hash'], $tors);
    // nothing else seeds it: the whole folder of the old torrent goes (torrent files and what came with them: nfo, images,
    // subtitles), to the trash like Find my torrent replacements (owner's decision 2026-10-11)
    $cp = '';
    foreach ($tors as $t) { if (strtolower((string)$t['hash']) === strtolower((string)$j['hash'])) { $cp = rtrim(st_to_host((string)($t['content_path'] ?? ''), st_cfg()), '/'); } }
    if ($share === '' && $cp !== '' && file_exists($cp) && st_under_roots($cp, st_cfg()) !== false) {
        $j2 = $j; $j2['old_path'] = $cp; $j2['media_paths'] = [];
        [$ok, $m, $mL] = st_cleanup_old($j2);
        if (!$ok) { return [false, $m]; }
        $m = str_replace(' (files kept)', '', $m); $mL = str_replace(' (a fájlok megmaradtak)', '', $mL); // the folder went to the trash right after
        st_upd_drop((string)$j['hash']);
        $set('removed', $m);
        st_notify('g', st_l('Seedbox: a régi torrent és fájljai törölve', 'Seedbox: the old torrent and its files were deleted'), $mL,
            [[st_l('Cím', 'Title'), $j['title']], [st_l('Régi', 'Old'), $j['old_name'] . ' (' . st_gb($j['old_size']) . ')'], [st_l('Új', 'New'), $j['new']]], false, st_ntool($j));
        return [true, ''];
    }
    [$c, $b, $e] = st_qb('/api/v2/torrents/delete', ['hashes' => $j['hash'], 'deleteFiles' => $share === '' ? 'true' : 'false']);
    if ($c !== 200) { return [false, 'qBittorrent refused: ' . ($e ?: 'HTTP ' . $c)]; }
    st_upd_drop((string)$j['hash']);
    $set('removed', $share === '' ? 'the old torrent and its files were removed' : 'the old torrent was removed; its files were kept because torrent "' . $share . '" seeds them too');
    st_notify('g', $share === '' ? st_l('Seedbox: a régi torrent és fájljai törölve', 'Seedbox: the old torrent and its files were deleted') : st_l('Seedbox: a régi torrent törölve, a fájlok maradtak', 'Seedbox: the old torrent was deleted, the files stay'), st_l('A jóváhagyásod után, mert az új kiadás már importálva van.', 'After your approval, because the new release is already imported.') . ($share === '' ? '' : ' ' . st_l('A fájlokat egy másik torrent is seedeli: ' . $share, 'Another torrent seeds the same files: ' . $share)),
        [[st_l('Cím', 'Title'), $j['title']], [st_l('Régi', 'Old'), $j['old_name'] . ' (' . st_gb($j['old_size']) . ')'], [st_l('Új', 'New'), $j['new']]], false, st_ntool($j));
    return [true, ''];
}

// Forget every finished entry in the Results list (running jobs and pending checks stay).
function st_clear_results() {
    st_state_update(function (&$s) {
        $s['pending'] = array_values(array_filter($s['pending'], function ($p) { return !in_array($p['stage'], ['done', 'failed'], true); }));
        $s['jobs'] = array_values(array_filter($s['jobs'], function ($j) { return !in_array($j['stage'], ['removed', 'failed', 'cleaned'], true); }));
    });
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- TOOLS BACKGROUND WORKER -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/tools_run.php">
<INLINE><![CDATA[<?php
// Background worker: php tools_run.php find | upd | updbg | search <hash> | fsearch <id> | sp [series] | spab | tick
if (PHP_SAPI !== 'cli') { exit(1); }
require_once __DIR__ . '/tools_ops.php';
@set_time_limit(0);
@ini_set('memory_limit', '512M');
$mode = $argv[1] ?? '';
if (!in_array($mode, ['find', 'upd', 'updbg', 'search', 'fsearch', 'sp', 'spab', 'tick'], true)) { exit(1); }
$lockName = ($mode === 'search' || $mode === 'fsearch') ? 'search_' . md5((string)($argv[2] ?? '')) : $mode;
$lock = @fopen('/tmp/qbt_tools_' . $lockName . '.lock', 'c');
if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) { exit(0); }
try {
    if ($mode === 'find') { st_find_scan(($argv[2] ?? '') === 'auto'); }
    elseif ($mode === 'upd') { st_upd_scan(); }
    elseif ($mode === 'updbg') { st_upd_bg(); }
    elseif ($mode === 'search') { st_upd_search((string)($argv[2] ?? '')); }
    elseif ($mode === 'sp') { st_sp_scan((string)($argv[2] ?? '')); }
    elseif ($mode === 'spab') { st_sp_ab_run(); }
    elseif ($mode === 'fsearch') { st_find_repl_search((string)($argv[2] ?? '')); }
    else { st_tick(); }
} catch (Throwable $e) {
    if ($mode === 'sp') { st_json_write(ST_SP, ['state' => 'error', 't' => time(), 'msg' => 'Unexpected error: ' . $e->getMessage(), 'items' => []]); }
    elseif ($mode === 'find') { st_progress(ST_FIND, 'error', 'Unexpected error: ' . $e->getMessage()); }
    elseif ($mode === 'upd') { st_progress(ST_UPD, 'error', 'Unexpected error: ' . $e->getMessage()); }
    elseif ($mode === 'search') {
        $r = st_json_read(ST_RES, []); $r[(string)($argv[2] ?? '')] = ['state' => 'error', 't' => time(), 'rows' => [], 'msg' => 'Unexpected error: ' . $e->getMessage()]; st_json_write(ST_RES, $r);
    }
}
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- TOOLS ENDPOINT -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/tools.php">
<INLINE><![CDATA[<?php
// Web endpoint of the Seedbox tools. POST op=state|saveconfig|test|find_scan|find_get|find_add|find_ignore|upd_scan|upd_get|upd_hide|upd_search|upd_res|upd_grab|upd_remove
require_once __DIR__ . '/tools_ops.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function st_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra), JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE); exit; }

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); st_out(false, ['error' => 'method']); }
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) { http_response_code(403); st_out(false, ['error' => 'csrf token mismatch']); }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403); st_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}

function st_spawn($args) {
    $php = '/usr/bin/php';
    foreach (['/usr/bin/php', '/usr/local/bin/php'] as $p) { if (is_executable($p)) { $php = $p; break; } }
    @exec('setsid nohup ' . escapeshellarg($php) . ' ' . escapeshellarg(__DIR__ . '/tools_run.php') . ' ' . $args . ' >/dev/null 2>&1 &');
}
function st_locked($name) {
    $f = @fopen('/tmp/qbt_tools_' . $name . '.lock', 'c');
    if (!$f) { return false; }
    if (flock($f, LOCK_EX | LOCK_NB)) { flock($f, LOCK_UN); fclose($f); return false; }
    fclose($f); return true;
}
function st_http_url($v) { $v = trim((string)$v); return ($v === '' || preg_match('#^https?://[^\s"<>]+$#i', $v)) ? rtrim($v, '/') : false; }

$op = (string)($_POST['op'] ?? 'state');

if ($op === 'state') {
    $c = st_cfg();
    foreach (['prowlarr', 'radarr', 'sonarr', 'lidarr', 'autobrr'] as $k) { $c[$k]['key_set'] = $c[$k]['key'] !== ''; $c[$k]['key'] = ''; }
    $c['dc_hook_set'] = $c['dc_hook'] !== ''; $c['dc_hook'] = '';
    $c['bot_token_set'] = $c['bot_token'] !== ''; $c['bot_token'] = '';
    $s = st_state();
    st_out(true, ['cfg' => $c, 'ab' => st_json_read(ST_AB, []), 'pending' => array_slice(array_reverse($s['pending']), 0, 20), 'jobs' => array_reverse($s['jobs']),
                  'find_running' => st_locked('find'), 'upd_running' => st_locked('upd'), 'packjobs' => array_reverse((array)$s['packjobs']), 'dl' => st_dl_summary($s)]);
}

if ($op === 'saveconfig') {
    $old = st_cfg(); $new = $old;
    foreach (['prowlarr', 'radarr', 'sonarr', 'lidarr', 'autobrr'] as $k) {
        $u = st_http_url($_POST[$k . '_url'] ?? '');
        if ($u === false) { st_out(false, ['error' => 'the ' . $k . ' address must start with http:// or https://']); }
        $key = trim((string)($_POST[$k . '_key'] ?? ''));
        if ($key !== '' && !preg_match('/^[A-Za-z0-9_\-]{8,128}$/', $key)) { st_out(false, ['error' => 'the ' . $k . ' API key looks wrong']); }
        $new[$k] = ['url' => $u, 'key' => $key !== '' ? $key : $old[$k]['key']];
        if ($u === '') { $new[$k]['key'] = $key !== '' ? $key : ''; }
    }
    $mq = '/' . trim((string)($_POST['map_qb'] ?? '/data'), " /"); $mh = '/' . trim((string)($_POST['map_host'] ?? '/mnt/user/data'), " /");
    if (preg_match('/[\x00-\x1f"\\\\]|\.\./', $mq . $mh)) { st_out(false, ['error' => 'invalid folder mapping']); }
    $new['map_qb'] = $mq === '/' ? '' : $mq; $new['map_host'] = $mh === '/' ? '' : $mh;
    $base = rtrim(trim((string)($_POST['dl_base'] ?? '')), '/');
    if ($base === '' || $base[0] !== '/' || preg_match('/[\x00-\x1f"\\\\]|\.\./', $base) || !preg_match('#^/mnt/#', $base)) { st_out(false, ['error' => 'the downloads folder must be a path under /mnt/ (for example /mnt/user/data/downloads)']); }
    $fr = json_decode((string)($_POST['folders'] ?? ''), true);
    if (!is_array($fr)) { st_out(false, ['error' => 'the folder roles are missing (reload the page)']); }
    $roles = [];
    foreach ($fr as $n => $r) {
        $n = (string)$n;
        if ($n === '' || $n[0] === '.' || strpos($n, '/') !== false || preg_match('/[\x00-\x1f]/', $n) || !in_array($r, ST_ROLES, true)) { continue; }
        $roles[$n] = $r;
    }
    $chk = st_cfg_folders(array_merge($old, ['dl_base' => $base, 'folders' => $roles]));
    if (!$chk['roots']) { st_out(false, ['error' => 'no folder is watched: give at least one folder a role other than Not watched']); }
    $new['dl_base'] = $base; $new['folders'] = $roles; $new['roots'] = $chk['roots'];
    $td = (int)($_POST['trash_days'] ?? 3); if ($td < 0 || $td > 60) { st_out(false, ['error' => 'the trash days must be between 0 and 60']); }
    $hk = trim((string)($_POST['dc_hook'] ?? ''));
    if ($hk === '-') { $new['dc_hook'] = ''; } elseif ($hk !== '') { if (!st_dc_hook_ok($hk)) { st_out(false, ['error' => 'the Discord webhook address looks wrong']); } $new['dc_hook'] = $hk; }
    // BoxBot (item 72): the token like an API key (empty keeps the saved one, - removes it), the owner's user id
    $bt = trim((string)($_POST['bot_token'] ?? ''));
    if ($bt === '-') { $new['bot_token'] = ''; } elseif ($bt !== '') { if (!preg_match('/^[A-Za-z0-9_\-.]{50,100}$/', $bt)) { st_out(false, ['error' => 'the bot token looks wrong (Developer Portal, Bot, Reset Token)']); } $new['bot_token'] = $bt; }
    $bu = trim((string)($_POST['bot_user'] ?? ''));
    if ($bu !== '' && !preg_match('/^\d{15,25}$/', $bu)) { st_out(false, ['error' => 'the Discord user id is a number of 17-20 digits (Developer Mode, right-click your name, Copy User ID)']); }
    $new['bot_user'] = $bu;
    foreach (['bot_rep', 'bot_find'] as $k) { $new[$k] = !empty($_POST[$k]) && $_POST[$k] !== '0' ? 1 : 0; }
    if ($new['bot_token'] !== '' && $bu !== '' && $new['dc_hook'] === '') { st_out(false, ['error' => 'the bot reacts under the Seedbox messages: save a Discord webhook too']); }
    $new['auto_scan'] = !empty($_POST['auto_scan']) && $_POST['auto_scan'] !== '0' ? 1 : 0;
    $new['auto_upd'] = !empty($_POST['auto_upd']) && $_POST['auto_upd'] !== '0' ? 1 : 0;
    $new['auto_rep'] = !empty($_POST['auto_rep']) && $_POST['auto_rep'] !== '0' ? 1 : 0;
    $af = [];
    foreach (preg_split('/\n/', (string)($_POST['ab_filters'] ?? '')) as $x) { $x = trim(preg_replace('/[\x00-\x1f]/', '', $x)); if ($x !== '' && strlen($x) <= 120 && count($af) < 50) { $af[] = $x; } }
    $new['ab_filters'] = array_values(array_unique($af));
    $new['ab_on'] = !empty($_POST['ab_on']) && $_POST['ab_on'] !== '0' ? 1 : 0;
    if ($new['ab_on'] && ($new['autobrr']['url'] === '' || $new['autobrr']['key'] === '' || $new['sonarr']['url'] === '')) { st_out(false, ['error' => 'watching autobrr needs the autobrr and Sonarr addresses and keys']); }
    $new['auto_freq'] = (($_POST['auto_freq'] ?? '') === 'daily') ? 'daily' : 'weekly';
    $ad = (int)($_POST['auto_day'] ?? 1); $ah = (int)($_POST['auto_hour'] ?? 8);
    if ($ad < 1 || $ad > 7 || $ah < 0 || $ah > 23) { st_out(false, ['error' => 'the scheduled scan needs a weekday and an hour (0-23)']); }
    $new['auto_day'] = $ad; $new['auto_hour'] = $ah;
    $new['find_cat'] = !empty($_POST['find_cat']) && $_POST['find_cat'] !== '0' ? 1 : 0;
    foreach (['find', 'upd', 'rep'] as $k) { // which widget rows show (item 54)
        $m = (string)($_POST['show_' . $k] ?? 'relevant'); $new['show_' . $k] = in_array($m, ['always', 'relevant', 'days', 'never'], true) ? $m : 'relevant';
        $new['show_' . $k . '_days'] = max(1, min(60, (int)($_POST['show_' . $k . '_days'] ?? 3)));
    }
    foreach (['tag_find', 'tag_upd', 'tag_rep'] as $k) { $v = trim(preg_replace('/[\x00-\x1f<>]/u', '', (string)($_POST[$k] ?? ''))); $new[$k] = mb_substr($v, 0, 60); } // the line under the tool name on the widget, empty = the default
    foreach (['dc_find', 'dc_upd', 'dc_rep'] as $k) { $new[$k] = !empty($_POST[$k]) && $_POST[$k] !== '0' ? 1 : 0; }
    $new['dc_on'] = ($new['dc_find'] || $new['dc_upd'] || $new['dc_rep']) ? 1 : 0;
    $new['dc_lang'] = (($_POST['dc_lang'] ?? 'hu') === 'en') ? 'en' : 'hu';
    $acc = (float)($_POST['find_accept'] ?? 99); if ($acc < 90 || $acc > 100) { st_out(false, ['error' => 'the accepted match must be between 90 and 100 percent']); }
    $new['find_accept'] = $acc;
    $rg = (float)($_POST['repl_max_growth'] ?? 100); if ($rg < 0 || $rg > 1000) { st_out(false, ['error' => 'the maximum size increase must be between 0 and 1000 percent']); }
    $new['repl_max_growth'] = $rg;
    $mf = (int)($_POST['find_missing_files'] ?? 1); if ($mf < 0 || $mf > 20) { st_out(false, ['error' => 'the number of missing files must be between 0 and 20']); }
    $new['find_missing_files'] = $mf;
    $gb = (float)($_POST['upd_min_gb'] ?? 40); $age = (int)($_POST['upd_min_age'] ?? 90); $sv = (int)($_POST['upd_saving'] ?? 30); $tol = (float)($_POST['find_tol'] ?? 1);
    if ($gb < 1 || $gb > 1000 || $age < 0 || $age > 5000 || $sv < 5 || $sv > 90 || $tol < 0 || $tol > 10) { st_out(false, ['error' => 'a threshold is out of range']); }
    $ug = (int)($_POST['upd_upg_growth'] ?? 100); if ($ug < 0 || $ug > 1000) { st_out(false, ['error' => 'the upgrade size increase must be between 0 and 1000 percent']); }
    $new['upd_upg_growth'] = $ug;
    $new['dv_all'] = (($_POST['dv_all'] ?? '0') === '1') ? 1 : 0;
    foreach (['upd_cat_save', 'upd_cat_hdr', 'upd_cat_res'] as $k) { $new[$k] = !empty($_POST[$k]) && $_POST[$k] !== '0' ? 1 : 0; }
    if (!$new['upd_cat_save'] && !$new['upd_cat_hdr'] && !$new['upd_cat_res']) { st_out(false, ['error' => 'Shape up needs at least one of saving, HDR / DV upgrade, resolution upgrade']); }
    $new['upd_min_gb'] = $gb; $new['upd_min_age'] = $age; $new['upd_saving'] = $sv; $new['find_tol'] = $tol; $new['trash_days'] = $td;
    unset($new['folder_list'], $new['lib'], $new['series_dirs']); // worked out by st_cfg() on every read
    if (!st_json_write(st_cfg_file(), $new, 0600)) { st_out(false, ['error' => 'could not write the settings']); }
    st_out(true);
}

// the folders inside a downloads folder typed on the page (Read the folders again), with the saved roles; reads only
if ($op === 'folders') {
    $base = rtrim(trim((string)($_POST['dl_base'] ?? '')), '/');
    if ($base === '' || $base[0] !== '/' || preg_match('/[\x00-\x1f"\\\\]|\.\./', $base) || !preg_match('#^/mnt/#', $base)) { st_out(false, ['error' => 'the downloads folder must be a path under /mnt/']); }
    if (!is_dir($base)) { st_out(false, ['error' => 'no such folder: ' . $base]); }
    $c = st_cfg();
    st_out(true, ['folder_list' => st_folder_list($base, is_array($c['folders']) ? $c['folders'] : null)]);
}

if ($op === 'test') {
    $r = [];
    $t = st_qb_torrents();
    $r['qbittorrent'] = $t === null ? 'cannot connect or log in' : ('ok, ' . count($t) . ' torrents');
    $cfg = st_cfg();
    if ($t) {
        $hit = 0; $miss = 0;
        foreach (array_slice($t, 0, 30) as $x) { $p = st_to_host((string)($x['content_path'] ?? ''), $cfg); if ($p !== '' && file_exists($p)) { $hit++; } else { $miss++; } }
        $r['path_mapping'] = $hit . ' of ' . ($hit + $miss) . ' sampled torrents found on this server' . ($miss > $hit ? ' (check the folder mapping)' : '');
    }
    if ($cfg['dc_hook'] === '') { $r['discord'] = 'no webhook set'; }
    else { [$ok, $e] = st_notify('i', st_l('Seedbox: teszt', 'Seedbox: test'), st_l('A Discord kapcsolat működik.', 'The Discord connection works.'), [], true); $r['discord'] = $ok ? 'ok, a test message was sent' . (!($cfg['dc_find'] || $cfg['dc_upd'] || $cfg['dc_rep']) ? ' (messages are switched off for every tool)' : '') : $e; }
    foreach (['prowlarr' => '/system/status', 'radarr' => '/system/status', 'sonarr' => '/system/status', 'lidarr' => '/system/status'] as $k => $path) {
        if (($cfg[$k]['url'] ?? '') === '') { $r[$k] = 'not configured'; continue; }
        [$c, $j, $e] = st_arr($k, $path, 'GET', null, 15);
        $r[$k] = $e !== '' ? $e : ('ok, version ' . ($j['version'] ?? '?'));
    }
    if (($cfg['autobrr']['url'] ?? '') === '') { $r['autobrr'] = 'not configured'; }
    else { [$fl, $e] = st_ab_filters(); $r['autobrr'] = $fl === null ? $e : 'ok, ' . count($fl) . ' filter(s): ' . implode(', ', array_column($fl, 'name')) . (empty($cfg['ab_on']) ? ' (watching is off)' : ''); }
    st_out(true, ['tests' => $r]);
}

if ($op === 'ab_filters') {
    // the autobrr filters, with the address and key typed on the page (not saved yet) or the saved ones
    $u = st_http_url($_POST['url'] ?? ''); $k = trim((string)($_POST['key'] ?? ''));
    if ($u === false || ($k !== '' && !preg_match('/^[A-Za-z0-9_\-]{8,128}$/', $k))) { st_out(false, ['error' => 'the autobrr address or key looks wrong']); }
    if ($u !== '' || $k !== '') {
        $c = st_cfg(); $GLOBALS['st_ab_override'] = ['url' => $u !== '' ? $u : $c['autobrr']['url'], 'key' => $k !== '' ? $k : $c['autobrr']['key']];
    }
    [$fl, $e] = st_ab_filters();
    st_out($fl !== null, $fl !== null ? ['filters' => $fl] : ['error' => 'autobrr: ' . $e]);
}

if ($op === 'find_scan') {
    if (st_locked('find')) { st_out(true); }
    st_json_write(ST_FIND, ['state' => 'running', 't' => time(), 'msg' => 'Starting...', 'items' => []]);
    st_spawn('find');
    st_out(true);
}
if ($op === 'find_get') {
    // the list is a snapshot of the last scan: what has been dealt with since drops out, what is under way is marked
    st_find_prune();
    $find = st_json_read(ST_FIND, ['state' => 'none']); $s = st_state(); $keep = [];
    foreach ((array)($find['items'] ?? []) as $it) {
        $drop = false; $busy = '';
        foreach ($s['pending'] as $p) {
            if ($p['path'] !== $it['path']) { continue; }
            if ($p['stage'] === 'done') { $drop = true; } elseif (in_array($p['stage'], ['added', 'checking'], true)) { $busy = 'torrent added, checking the files: ' . $p['msg']; } elseif ($p['stage'] === 'failed' && time() - $p['t'] < 7 * 86400) { $it['fail'] = $p['msg']; }
        }
        foreach ($s['jobs'] as $j) {
            if (($j['key'] ?? '') !== ($it['key'] ?? '-') && ($j['old_path'] ?? '-') !== $it['path']) { continue; }
            if (in_array($j['stage'], ['cleaned', 'removed'], true)) { $drop = true; }
            elseif ($j['stage'] !== 'failed') { $busy = 'replacement: ' . $j['msg']; }
        }
        if ($drop) { continue; }
        if ($busy !== '') { $it['busy'] = $busy; }
        elseif (in_array($it['path'], array_column($s['queue'], 'path'), true)) { $it['busy'] = 'waiting in the queue'; }
        $keep[] = $it;
    }
    if (isset($find['items'])) { $find['items'] = $keep; }
    st_out(true, ['find' => $find, 'running' => st_locked('find'), 'res' => st_json_read(ST_RES, []), 'queue' => count($s['queue'])]);
}
if ($op === 'find_queue_all') { $n = st_queue_all(); if ($n) { st_spawn('tick'); } st_out(true, ['queued' => $n]); }
if ($op === 'clear_results') { st_clear_results(); st_out(true); }
if ($op === 'find_queue_stop') { st_queue_stop(); st_out(true); }
if ($op === 'find_add') {
    [$ok, $e] = st_find_add((string)($_POST['id'] ?? ''), (int)($_POST['idx'] ?? 0));
    st_out($ok, $ok ? [] : ['error' => $e]);
}
if ($op === 'find_delete') {
    [$ok, $e] = st_find_delete((string)($_POST['id'] ?? ''));
    st_out($ok, $ok ? [] : ['error' => $e]);
}
if ($op === 'find_ignore') {
    $find = st_json_read(ST_FIND, []);
    foreach ((array)($find['items'] ?? []) as $it) { if ($it['id'] === (string)($_POST['id'] ?? '')) { st_find_ignore($it['path']); st_out(true); } }
    st_out(false, ['error' => 'unknown item']);
}

if ($op === 'upd_scan') {
    if (st_locked('upd')) { st_out(true); }
    st_json_write(ST_UPD, ['state' => 'running', 't' => time(), 'msg' => 'Starting...', 'items' => []]);
    st_spawn('upd');
    st_out(true);
}
if ($op === 'upd_get') {
    $upd = st_json_read(ST_UPD, ['state' => 'none']); $res = st_json_read(ST_RES, []); $bg = st_json_read(ST_UPDBG, []);
    [$bg['done'], $bg['total']] = st_upd_bg_count($upd, $res); $bg['running'] = st_locked('updbg');
    st_out(true, ['upd' => $upd, 'res' => $res, 'bg' => $bg]);
}
if ($op === 'trash_info') { st_out(true, st_trash_info()); }
if ($op === 'trash_empty') {
    [$n, $fail] = st_trash_empty();
    st_out(!$fail, ['emptied' => $n, 'error' => $fail ? 'could not delete: ' . implode(', ', array_slice($fail, 0, 5)) : ''] + st_trash_info());
}
if ($op === 'upd_forget') {
    // forget every Update me search result and search the whole list again (after a change of the thresholds, for example)
    if (st_locked('upd')) { st_out(false, ['error' => 'a scan is running; try again when it has finished']); }
    @exec('pkill -f ' . escapeshellarg('qbittorrent_widget/tools_run.php updbg') . ' 2>/dev/null');
    for ($i = 0; $i < 20 && st_locked('updbg'); $i++) { usleep(100000); }
    $lk = @fopen('/tmp/qbt_tools_res.lock', 'c'); if ($lk) { flock($lk, LOCK_EX); }
    $res = st_json_read(ST_RES, []); $n = 0;
    foreach (array_keys($res) as $k) { if (preg_match('/^[0-9a-f]{40}$/', (string)$k)) { unset($res[$k]); $n++; } } // Update me keys are torrent hashes; Find my torrent keys start with f
    st_json_write(ST_RES, $res);
    if ($lk) { flock($lk, LOCK_UN); fclose($lk); }
    @unlink(ST_UPDBG); @unlink('/tmp/qbt_tools_updbg.stop');
    st_spawn('updbg');
    st_out(true, ['forgot' => $n]);
}
if ($op === 'upd_bg') {
    // stop or go on with the background check
    if (!empty($_POST['stop'])) { @touch('/tmp/qbt_tools_updbg.stop'); st_out(true); }
    if (st_locked('upd')) { st_out(false, ['error' => 'a scan is running; the check starts by itself after it']); }
    @unlink('/tmp/qbt_tools_updbg.stop'); if (!st_locked('updbg')) { st_spawn('updbg'); }
    st_out(true);
}
if ($op === 'upd_hide') {
    $h = strtolower((string)($_POST['hash'] ?? ''));
    if (!preg_match('/^[0-9a-f]{40}$/', $h)) { st_out(false, ['error' => 'bad hash']); }
    if (st_locked('upd')) { st_out(false, ['error' => 'a scan is running, try again when it has finished']); }
    st_upd_hide($h, !empty($_POST['on']));
    st_out(true, ['upd' => st_json_read(ST_UPD, ['state' => 'none'])]);
}
if ($op === 'upd_search') {
    $h = strtolower((string)($_POST['hash'] ?? ''));
    if (!preg_match('/^[0-9a-f]{40}$/', $h)) { st_out(false, ['error' => 'bad hash']); }
    st_spawn('search ' . escapeshellarg($h));
    st_res_set($h, ['state' => 'running', 't' => time(), 'rows' => [], 'msg' => 'Searching...', 'mode' => 'upd']);
    st_out(true);
}
if ($op === 'repl_search') {
    $id = (string)($_POST['id'] ?? '');
    if (!preg_match('/^f\d{1,6}$/', $id)) { st_out(false, ['error' => 'bad id']); }
    $find = st_json_read(ST_FIND, []); $key = '';
    foreach ((array)($find['items'] ?? []) as $it) { if ($it['id'] === $id) { $key = 'f' . substr(md5($it['path']), 0, 12); } }
    if ($key === '') { st_out(false, ['error' => 'unknown item']); }
    st_spawn('fsearch ' . escapeshellarg($id));
    st_res_set($key, ['state' => 'running', 't' => time(), 'rows' => [], 'msg' => 'Searching...', 'mode' => 'repl']);
    st_out(true, ['key' => $key]);
}
if ($op === 'upd_grab' || $op === 'repl_grab') {
    $key = (string)($_POST['key'] ?? ($_POST['hash'] ?? ''));
    if (!preg_match('/^[0-9a-f]{40}$|^f[0-9a-f]{12}$/', $key)) { st_out(false, ['error' => 'bad key']); }
    [$ok, $e] = st_replace_grab($key, (string)($_POST['guid'] ?? ''));
    st_out($ok, $ok ? [] : ['error' => $e]);
}
if ($op === 'sp_scan') {
    if (st_locked('sp')) { st_out(true); }
    $q = trim((string)($_POST['q'] ?? ''));
    if (strlen($q) > 80 || preg_match('/[\x00-\x1f]/', $q)) { st_out(false, ['error' => 'bad series name']); }
    st_json_write(ST_SP, ['state' => 'running', 't' => time(), 'msg' => 'Starting...', 'items' => []]);
    st_spawn('sp ' . escapeshellarg($q));
    st_out(true);
}
if ($op === 'sp_series') {
    // titles of the series that are monitored in Sonarr (for the suggestion list), cached for ten minutes
    $f = '/tmp/qbt_tools_series.json'; $c = st_json_read($f, []);
    if (empty($c['t']) || time() - $c['t'] > 600) {
        [$cd, $ser, $er] = st_arr('sonarr', '/series', 'GET', null, 60);
        if ($er !== '' || !is_array($ser)) { st_out(false, ['error' => 'Sonarr: ' . ($er ?: 'bad response')]); }
        $t = []; foreach ($ser as $x) {
            if (empty($x['monitored']) || empty($x['title'])) { continue; }
            // only series with a season of at least two episode files (VisionQuest, not out yet, is of no use here)
            if (isset($x['seasons'])) { $okS = false; foreach ((array)$x['seasons'] as $ss) { if ((int)($ss['seasonNumber'] ?? 0) > 0 && (int)($ss['statistics']['episodeFileCount'] ?? 0) >= 2) { $okS = true; } } if (!$okS) { continue; } }
            $t[] = (string)$x['title'];
        }
        sort($t, SORT_NATURAL | SORT_FLAG_CASE); $c = ['t' => time(), 'titles' => $t]; st_json_write($f, $c);
    }
    st_out(true, ['titles' => $c['titles']]);
}
if ($op === 'sp_get') {
    $s = st_state(); $abd = st_json_read(st_sp_ab_file(), []);
    st_out(true, ['sp' => st_json_read(ST_SP, ['state' => 'none']), 'jobs' => array_reverse((array)$s['packjobs']), 'running' => st_locked('sp'),
                  'ab' => st_sp_ab_list(), 'ab_queue' => count((array)($abd['queue'] ?? [])), 'ab_last' => $abd['last'] ?? null]);
}
if ($op === 'bot_test') { [$ok, $m] = st_bot_test(); st_out($ok, $ok ? ['msg' => $m] : ['error' => $m]); }
if ($op === 'sp_ab_dismiss') {
    $k = (string)($_POST['key'] ?? ''); if (!preg_match('/^sp[0-9a-f]{10}$/', $k)) { st_out(false, ['error' => 'bad key']); }
    st_sp_ab_dismiss($k); st_out(true);
}
if ($op === 'sp_start') {
    $k = (string)($_POST['key'] ?? ''); if (!preg_match('/^sp[0-9a-f]{10}$/', $k)) { st_out(false, ['error' => 'bad key']); }
    [$ok, $e] = st_sp_start($k, (string)($_POST['guid'] ?? ''));
    if ($ok) { st_spawn('tick'); }
    st_out($ok, $ok ? [] : ['error' => $e]);
}
if ($op === 'sp_clear') { st_sp_clear(); st_out(true); }
if ($op === 'job_force') { [$ok, $e] = st_force_import((string)($_POST['id'] ?? '')); st_out($ok, $ok ? [] : ['error' => $e]); }
if ($op === 'job_dismiss') {
    $id = (string)($_POST['id'] ?? '');
    $hit = st_state_update(function (&$s) use ($id) {
        $hit = false;
        foreach ($s['jobs'] as &$j) { if ($j['id'] === $id && $j['stage'] === 'imported') { $j['stage'] = 'removed'; $j['msg'] = 'dismissed; the old files were left where they are'; $j['t'] = time(); $hit = true; } }
        unset($j);
        return $hit;
    });
    if (!$hit) { st_out(false, ['error' => 'this job cannot be dismissed']); }
    st_out(true);
}
if ($op === 'upd_remove') {
    [$ok, $e] = st_job_remove_old((string)($_POST['id'] ?? ''));
    st_out($ok, $ok ? [] : ['error' => $e]);
}
http_response_code(400);
st_out(false, ['error' => 'unknown action']);
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/Seedbox/README.md">
<INLINE><![CDATA[**Seedbox** puts qBittorrent on the Unraid dashboard as a native-looking tile: the connection state (connected, firewalled or disconnected), torrents that need attention, and what is in transfer right now with speeds, ETA and progress bars, plus a link to the Web UI. Idle seeds are never listed, so the tile stays short even with hundreds of torrents.

Settings: Settings, Utilities, Seedbox (or the gear icon on the tile). The qBittorrent Web UI must be enabled.
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/lang.php">
<INLINE><![CDATA[<?php
// Shared language setting of the media server tools (Sysbox, Diskbox, Seedbox, Streambox): one file on the
// flash drive that every plugin reads, so changing it on any settings page changes it for all of them.
//   ui      = auto (follow Unraid's language, Settings, Display Settings) | en
//   discord = auto (follow Unraid) | en | hu
// A language the pages or Discord are not translated to falls back to English. Every plugin ships its own
// copy of this file; the guard keeps a second copy from being declared again in the same request.
if (!function_exists('mt_lang_cfg')) {

define('MT_LANG_FILE', '/boot/config/plugins/mediaserver-tools/lang.cfg');

function mt_lang_have($what) { return $what === 'discord' ? ['en', 'hu'] : ['en']; }

// Unraid's display language as a locale ('' = English, the built-in one)
function mt_lang_unraid() {
    $d = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true);
    return (is_array($d) && isset($d['display']) && is_array($d['display'])) ? trim((string)($d['display']['locale'] ?? '')) : '';
}
function mt_lang_code($locale) { $c = strtolower(substr((string)$locale, 0, 2)); return preg_match('/^[a-z]{2}$/', $c) ? $c : 'en'; }
function mt_lang_name($code) {
    $n = ['en' => 'English', 'hu' => 'Magyar', 'de' => 'Deutsch', 'fr' => 'Français', 'es' => 'Español', 'it' => 'Italiano', 'nl' => 'Nederlands',
          'pl' => 'Polski', 'pt' => 'Português', 'ru' => 'Русский', 'zh' => '中文', 'ja' => '日本語', 'ko' => '한국어', 'cs' => 'Čeština', 'sv' => 'Svenska'];
    return $n[$code] ?? $code;
}

// Before the shared setting existed every plugin had its own Discord language, Hungarian by default: a server
// that already sends Discord messages keeps the language it had; a new install starts in English.
function mt_lang_legacy() {
    $ini = function ($f) { $c = is_file($f) ? @parse_ini_file($f, false, INI_SCANNER_RAW) : false; return is_array($c) ? $c : null; };
    foreach (['/boot/config/plugins/sysbox/settings.cfg', '/boot/config/plugins/diskbox/settings.cfg'] as $f) {
        $c = $ini($f);
        if ($c === null) { continue; }
        if (isset($c['dc_lang'])) { return trim((string)$c['dc_lang'], "\"' ") === 'en' ? 'en' : 'hu'; }
        if (trim((string)($c['dc_hook'] ?? ''), "\"' ") !== '') { return 'hu'; }
    }
    $j = @json_decode((string)@file_get_contents('/boot/config/plugins/qbittorrent_widget/tools.json'), true);
    if (is_array($j)) {
        if (isset($j['dc_lang'])) { return $j['dc_lang'] === 'en' ? 'en' : 'hu'; }
        if (trim((string)($j['dc_hook'] ?? '')) !== '') { return 'hu'; }
    }
    $c = $ini('/boot/config/plugins/streambox/settings.cfg');
    if ($c !== null && (trim((string)($c['dc_movies'] ?? ''), "\"' ") !== '' || trim((string)($c['dc_series'] ?? ''), "\"' ") !== '')) { return 'hu'; }
    return 'en';
}

function mt_lang_cfg() {
    $c = ['ui' => 'auto', 'discord' => ''];
    $f = is_file(MT_LANG_FILE) ? @parse_ini_file(MT_LANG_FILE) : false;
    if (is_array($f)) {
        if (in_array($f['ui'] ?? '', ['auto', 'en'], true)) { $c['ui'] = $f['ui']; }
        if (in_array($f['discord'] ?? '', ['auto', 'en', 'hu'], true)) { $c['discord'] = $f['discord']; }
    }
    if ($c['discord'] === '') { $c['discord'] = mt_lang_legacy(); }
    return $c;
}

// The language the pages and tiles use, and the one Discord messages use (always one that exists)
function mt_lang_ui() {
    $c = mt_lang_cfg();
    $w = $c['ui'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['ui'];
    return in_array($w, mt_lang_have('ui'), true) ? $w : 'en';
}
function mt_lang_discord() {
    static $l = null;
    if ($l !== null) { return $l; }
    $c = mt_lang_cfg();
    $w = $c['discord'] === 'auto' ? mt_lang_code(mt_lang_unraid()) : $c['discord'];
    return $l = in_array($w, mt_lang_have('discord'), true) ? $w : 'en';
}

function mt_lang_save($ui, $discord) {
    if (!in_array($ui, ['auto', 'en'], true) || !in_array($discord, ['auto', 'en', 'hu'], true)) { return false; }
    @mkdir(dirname(MT_LANG_FILE), 0777, true);
    $tmp = MT_LANG_FILE . '.tmp';
    if (@file_put_contents($tmp, 'ui="' . $ui . "\"\ndiscord=\"" . $discord . "\"\n") === false) { return false; }
    return @rename($tmp, MT_LANG_FILE);
}

}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/lang_block.php">
<INLINE><![CDATA[<?php
// The Language block of every settings page (Sysbox, Diskbox, Seedbox Tools, Streambox): the shared setting of
// lang.php. The page sets $mt_lang_post (this plugin's lang_save.php) and includes this file.
require_once __DIR__ . '/lang.php';
$mtl_c = mt_lang_cfg();
$mtl_u = mt_lang_code(mt_lang_unraid());
$mtl_var = @parse_ini_file('/var/local/emhttp/var.ini');
$mtl_tok = is_array($mtl_var) ? (string)($mtl_var['csrf_token'] ?? '') : '';
$mtl_ui_now = in_array($mtl_u, mt_lang_have('ui'), true) ? mt_lang_name($mtl_u) : mt_lang_name($mtl_u) . ', shown in English';
$mtl_dc_now = in_array($mtl_u, mt_lang_have('discord'), true) ? mt_lang_name($mtl_u) : mt_lang_name($mtl_u) . ', sent in English';
$mtl_h = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES); };
$mtl_sel = function ($a, $b) { return $a === $b ? ' selected' : ''; };
?>
<style>
#mtl{margin:28px 0 8px;max-width:1100px}
#mtl .mtl-band{display:flex;justify-content:space-between;align-items:center;gap:12px;background:rgba(0,0,0,.35);padding:10px 14px;text-transform:uppercase;letter-spacing:1.5px;font-size:12px}
#mtl .mtl-band b{font-weight:normal;text-transform:none;letter-spacing:0;opacity:.6}
#mtl .mtl-box{background:rgba(128,128,128,.08);border-radius:0 0 6px 6px}
#mtl .mtl-row{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px;padding:14px 16px;border-left:3px solid #8a8a8a;border-bottom:1px solid rgba(128,128,128,.15)}
#mtl .mtl-row label{padding-top:6px}
#mtl .mtl-row select{width:auto;min-width:260px;max-width:100%;margin:0}
#mtl .mtl-hint{display:block;opacity:.6;line-height:1.5;margin-top:6px;white-space:normal}
#mtl .mtl-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px}
#mtl .mtl-foot button{margin:0}
@media (max-width:700px){#mtl .mtl-row{grid-template-columns:1fr;gap:4px}}
</style>
<div id="mtl">
  <div class="mtl-band"><span>Language</span><b>shared by Sysbox, Diskbox, Seedbox and Streambox</b></div>
  <div class="mtl-box">
    <div class="mtl-row">
      <label for="mtl-ui">Pages and tiles:</label>
      <div>
        <select id="mtl-ui">
          <option value="auto"<?=$mtl_sel($mtl_c['ui'], 'auto')?>>Follow Unraid (now: <?=$mtl_h($mtl_ui_now)?>)</option>
          <option value="en"<?=$mtl_sel($mtl_c['ui'], 'en')?>>English</option>
        </select>
        <span class="mtl-hint">Unraid's language is set under Settings, Display Settings. A language the plugins are not translated to yet shows in English. More languages come here as they are translated.</span>
      </div>
    </div>
    <div class="mtl-row">
      <label for="mtl-dc">Discord messages:</label>
      <div>
        <select id="mtl-dc">
          <option value="auto"<?=$mtl_sel($mtl_c['discord'], 'auto')?>>Follow Unraid (now: <?=$mtl_h($mtl_dc_now)?>)</option>
          <option value="en"<?=$mtl_sel($mtl_c['discord'], 'en')?>>English</option>
          <option value="hu"<?=$mtl_sel($mtl_c['discord'], 'hu')?>>Magyar</option>
        </select>
        <span class="mtl-hint">Every message of the four plugins: alerts, weekly summaries, new movies and series, the Discord bot. Movie and series titles stay as Jellyfin and Sonarr give them.</span>
      </div>
    </div>
    <div class="mtl-foot">
      <span id="mtl-msg" class="mtl-hint" style="margin:0">Saved for all plugins at once.</span>
      <button type="button" id="mtl-apply">Save language</button>
    </div>
  </div>
</div>
<script>
$(function () {
  // Unraid disables the Apply buttons of a page until its form changes: this block is outside every form, so it is a
  // button of its own name, enabled here (also after Unraid's own page scripts ran)
  var en = function () { $('#mtl-apply').prop('disabled', false).removeAttr('disabled'); };
  en(); setTimeout(en, 500); $('#mtl-ui, #mtl-dc').on('change', en);
  $('#mtl-apply').on('click', function () {
    var $b = $(this).prop('disabled', true), $m = $('#mtl-msg');
    $.post(<?=json_encode((string)$mt_lang_post)?>, { ui: $('#mtl-ui').val(), discord: $('#mtl-dc').val(), csrf_token: <?=json_encode($mtl_tok)?> }, null, 'json')
      .done(function (r) { $m.css({ color: r.ok ? '#3fa24a' : '#e5534b', opacity: 1 }).text(r.ok ? 'Saved for Sysbox, Diskbox, Seedbox and Streambox.' : (r.error || 'Not saved')); })
      .fail(function (x) { $m.css({ color: '#e5534b', opacity: 1 }).text((x.responseJSON && x.responseJSON.error) || 'Not saved'); })
      .always(function () { $b.prop('disabled', false); });
  });
});
</script>
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/lang_save.php">
<INLINE><![CDATA[<?php
// Saves the shared language setting (see lang.php). POST ui, discord, csrf_token.
require_once __DIR__ . '/lang.php';
header('Content-Type: application/json');
header('Cache-Control: no-store');
function mt_out($ok, $extra = []) { echo json_encode(array_merge(['ok' => $ok], $extra)); exit; }
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); mt_out(false, ['error' => 'method']); }
$var = @parse_ini_file('/var/local/emhttp/var.ini');
$tok = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
if ($tok === '' || !hash_equals($tok, (string)($_POST['csrf_token'] ?? ''))) { http_response_code(403); mt_out(false, ['error' => 'csrf token mismatch']); }
if (!mt_lang_save((string)($_POST['ui'] ?? ''), (string)($_POST['discord'] ?? ''))) { mt_out(false, ['error' => 'could not save the language setting']); }
mt_out(true);
]]></INLINE>
</FILE>

<!-- Permissions + done -->
<FILE Name="/tmp/&name;_finish.sh" Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
DIR="/usr/local/emhttp/plugins/qbittorrent_widget"
chmod 644 "$DIR"/*.page "$DIR"/*.php "$DIR"/icon.png

# Seedbox tools: finishes added torrents and watches replacements (checked every minute; it returns at once when nothing is pending)
PHPBIN0="$(command -v php || echo /usr/bin/php)"
cat > /boot/config/plugins/qbittorrent_widget/qbittorrent_widget.cron <<CRON
# Seedbox tools: finish torrents added by Find my torrent, follow Radarr/Sonarr replacements
* * * * * $PHPBIN0 /usr/local/emhttp/plugins/qbittorrent_widget/tools_run.php tick >/dev/null 2>&1
CRON
# update_cron reads the plugin link in /var/log/plugins, which appears only after the install scripts have finished
nohup bash -c 'for i in $(seq 1 60); do [ -e /var/log/plugins/qbittorrent_widget.plg ] && break; sleep 1; done; /usr/local/sbin/update_cron' >/dev/null 2>&1 &

# Updates come from GitHub (pluginURL): stop the local update server of earlier versions
pkill -f "php -S 127.0.0.1:18181" 2>/dev/null
rm -f /usr/local/emhttp/plugins/qbittorrent_widget/repo.php
rm -f /tmp/qbittorrent_widget_setup.sh /tmp/qbittorrent_widget_finish.sh
echo ""
echo "----------------------------------------------------"
echo " Seedbox installed."
echo " Settings: Settings -> Utilities -> Seedbox"
echo " (or the gear icon on the dashboard tile)."
echo "----------------------------------------------------"
exit 0
]]></INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
rm -rf /usr/local/emhttp/plugins/Seedbox
pkill -f "php -S 127.0.0.1:18181" 2>/dev/null
pkill -f "qbittorrent_widget/tools_run.php updbg" 2>/dev/null
rm -rf /usr/local/emhttp/plugins/qbittorrent_widget
rm -f /tmp/qbt_widget_* /tmp/qbt_tools_*
rm -f /boot/config/plugins/qbittorrent_widget/qbittorrent_widget.cron
/usr/local/sbin/update_cron 2>/dev/null
# Settings in /boot/config/plugins/qbittorrent_widget are kept intentionally.
echo "qbittorrent_widget removed."
exit 0
]]></INLINE>
</FILE>

</PLUGIN>
