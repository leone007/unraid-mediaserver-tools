    }
    $o.append('<table class="stt"><thead><tr><th>Season</th><th>Pack</th><th class="stt-r">Size</th><th class="stt-r">Seeders</th><th class="stt-r">Replaces</th><th></th></tr></thead><tbody>' + $.map(items, function (it) { return spRows(it, false); }).join('') + '</tbody></table>');
  }
  // the rows of one season: the best pack, the other packs (hidden), the torrents that go to the trash
  function spRows(it, ab) {
    var b = it.packs[0], miss = it.missing || [], h = '';
