    if (!list.length) { $('#stt-abf').text('autobrr has no filters'); return; }
    $.each(list, function (i, x) { h += ' <label style="margin-right:10px"><input type="checkbox" class="stt-abf-cb" value="' + esc(x.name).replace(/"/g, '&quot;') + '"' + (sel.indexOf(x.name) >= 0 ? ' checked' : '') + '> ' + esc(x.name) + (x.enabled ? '' : ' <i>(disabled)</i>') + '</label>'; });
    $.each(sel, function (i, n) { if (!list.some(function (x) { return x.name === n; })) { h += ' <label style="margin-right:10px"><input type="checkbox" class="stt-abf-cb" value="' + esc(n).replace(/"/g, '&quot;') + '" checked> ' + esc(n) + ' <i>(not in autobrr any more)</i></label>'; } });
    $('#stt-abf').html(h);
