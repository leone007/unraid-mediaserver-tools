    $.each(['dead', 'must', 'save', 'hdr', 'res'], function (i, g) {
      if (g === 'dead' ? !G.dead.length : g === 'must' ? !mustOn : ((cfg && !+cfg['upd_cat_' + g]) || !UCAT[g])) { return; }
      var n = G[g].length, op = !!UGOPEN[g] && n > 0, lim = ULIMG[g] || 25;
      $o.append('<button type="button" class="stt-gbar ' + GS[g] + (n ? '' : ' empty') + '" data-g="' + g + '"' + (n ? '' : ' disabled') + '><span class="pm">' + (n ? (op ? '&minus;' : '+') : '') + '</span><span class="t">' + GL[g] + '</span><span class="c">' + esc(T('u.n_torrents', { n: n })) + '</span></button>');
      if (!n) { return; }
      var $g = $('<div class="stt-ugrp" data-g="' + g + '">').toggle(op);
      $.each(G[g].slice(0, lim), function (j, it) { $g.append(uBox(it, GS[g], g)); });
      if (n > lim) { $g.append('<p><input type="button" class="stt-btn stt-sm stt-ghost stt-umore" data-g="' + g + '" value="' + esc(T('u.more', { m: Math.min(50, n - lim), n: n - lim })) + '"></p>'); }
      $o.append($g);
    });
    if (rest.length) {
      var nn = 0; $.each(rest, function (i, it) { if (!RES[it.hash]) { nn++; } });
      var $r = $('<details class="stt-urest"><summary class="stt-mut">' + esc(T('u.rest', { n: rest.length }) + (nn ? ' (' + T('u.not_searched_n', { n: nn }) + ')' : '')) + '</summary></details>');
      var $tr = $('<table class="stt stt-act"><tbody></tbody></table>');
      $.each(rest, function (i, it) {
        var rr = RES[it.hash], st = !it.kind ? (it.note || T('u.not_matched')) : !rr ? T('u.not_searched') : rr.state === 'running' ? T('u.searching_now') : rr.state === 'error' ? T('u.search_failed', { e: rr.msg }) : T('u.nothing_better');
        $tr.find('tbody').append('<tr><td>' + esc(it.name) + '</td><td class="stt-r">' + fb(it.size) + '</td><td class="stt-mut" style="white-space:normal">' + esc(st) + '</td><td class="stt-r">' +
          (it.kind ? '<input type="button" class="stt-find stt-btn stt-sm" data-hash="' + it.hash + '" value="' + esc(rr ? T('u.search_again') : T('u.search_now')) + '"> ' : '') +
          '<input type="button" class="stt-uhide stt-btn stt-sm stt-ghost" data-hash="' + it.hash + '" data-on="1" value="' + esc(T('u.hide')) + '"></td></tr>');
      });
