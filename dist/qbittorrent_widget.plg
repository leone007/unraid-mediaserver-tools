  $(document).on('click', 'th.stt-so', function () { var k = $(this).data('k'); SORT = SORT.k === k ? {k: k, d: -SORT.d} : {k: k, d: k === 'name' ? 1 : -1}; if (LASTF) { drawFind(LASTF); } });
  // ---- find my torrent: one table, one group of rows per folder ----
