    }).fail(function (x) { $('#stt-abf').text(err(x)); }).always(function () { $b.prop('disabled', false); });
  });
  function drawAb(a) {
    var h = '';
    if (a.t) { h += 'last check ' + ago(a.t) + ' ago' + (a.skipped ? ', ' + a.skipped + ' single episodes passed over' : '') + (a.since ? ', watching since ' + new Date(a.since * 1000).toLocaleString() : '') + (a.err ? ' &middot; <span style="color:#e5534b">' + esc(a.err) + '</span>' : ''); }
    $.each((a.recent || []).slice(-5).reverse(), function (i, x) { h += '<br>' + ago(x.t) + ' ago: ' + (x.go ? '<b>' : '') + esc(x.why) + (x.go ? '</b>' : '') + ' <span style="opacity:.7">' + esc(x.name) + '</span>'; });
    $('#stt-ab').html(h);
    $('#stt-rband').text(a.t ? 'autobrr watched \u00b7 last check ' + ago(a.t) + ' ago' : '');
    var r0 = (a.recent || []).slice(-1)[0];
    $('#stt-abst').html(a.t ? '<span class="stt-mut">autobrr</span> ' + (a.err ? '<span class="stt-er">' + esc(a.err) + '</span>' : (a.skipped ? a.skipped + ' single episodes passed over' : 'watching')) + (r0 ? ' &middot; <span class="stt-mut">last:</span> ' + esc(r0.why) : '') : '');
  }
  function loadState() {
    return api('state').done(function (r) {
