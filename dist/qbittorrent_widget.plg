    if (!$('#stt-ucats').children().length || $('#stt-ucats').data('sig') !== JSON.stringify(cfg ? [cfg.upd_cat_save, cfg.upd_cat_hdr, cfg.upd_cat_res] : [])) {
      $('#stt-ucats').data('sig', JSON.stringify(cfg ? [cfg.upd_cat_save, cfg.upd_cat_hdr, cfg.upd_cat_res] : [])).html($.map(['save', 'hdr', 'res'], function (k) { return (!cfg || +cfg['upd_cat_' + k]) ? '<label style="margin-left:10px"><input type="checkbox" class="stt-ucat" value="' + k + '"' + (UCAT[k] ? ' checked' : '') + '> ' + CATL[k] + '</label>' : null; }).join(''));
    }
