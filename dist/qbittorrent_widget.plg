    var h = '';
    if (!(r.queue > 0) && n > 0) { h += '<input type="button" id="stt-qall" class="stt-btn" value="' + esc(T('fq.add_all', { n: n })) + '"> <span class="stt-mut">' + esc(T('fq.add_all_hint')) + '</span>'; }
    $('#stt-queue').html(h);
