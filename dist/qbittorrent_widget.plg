  "text": "Address and Web UI port:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "ws.host_hint": {
  "text": "as seen from Unraid; 127.0.0.1 when qBittorrent runs in a container on this server with its port published",
  "note": "hint under the address field."
 },
 "ws.not_saved": {
  "text": "Not saved: {e}",
  "note": "message when saving failed."
 },
 "ws.pass_hint": {
  "text": "the saved password is not sent to the page: leave it empty to keep it, type - to remove it; no double quotes",
  "note": "hint under the password field."
 },
 "ws.password": {
  "text": "password",
  "note": "grey text in the empty password field."
 },
 "ws.rows": {
  "text": "Most rows shown:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "ws.rows_hint": {
  "text": "more rows are counted in the band title",
  "note": "hint under the rows fields."
 },
 "ws.saved": {
  "text": "(saved)",
  "note": "grey text in the empty password field: a password is saved."
 },
 "ws.saved_msg": {
  "text": "Saved. The dashboard picks it up within a few seconds.",
  "note": "message next to Apply."
 },
 "ws.saving": {
  "text": "Saving...",
  "note": "message next to Apply."
 },
 "ws.test_hint": {
  "text": "tests the saved settings (Apply first after a change)",
  "note": "hint next to the test button."
 },
 "ws.test_ok": {
  "one": "ok, {n} torrent, {s}",
  "other": "ok, {n} torrents, {s}",
  "note": "result of a working connection test."
 },
 "ws.testing": {
  "text": "Testing...",
  "note": "message next to the test button."
 },
 "ws.tools_line": {
  "text": "find torrents for files that are not seeded, replace content and big titles with better or smaller releases through Radarr and Sonarr, and repack seasons.",
  "note": "text after the \"Seedbox Tools\" link at the bottom of the page."
 },
 "ws.unknown_error": {
  "text": "unknown error",
  "note": "reason when none is known."
 },
 "ws.url": {
  "text": "Web UI link (optional):",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "ws.url_hint": {
  "text": "the home icon of the tile opens this; empty = this server's address with the Web UI port",
  "note": "hint under the Web UI link field."
 },
 "ws.user": {
  "text": "Username and password:",
  "note": "label of a setting (left column, ends with a colon)."
 },
 "wse.replace": {
  "text": "could not replace the settings file",
  "note": "reason after \"Not saved:\" on the Seedbox settings page."
 },
 "wse.url": {
  "text": "invalid Web UI link URL",
  "note": "reason after \"Not saved:\" on the Seedbox settings page."
 },
 "wse.write": {
  "text": "could not write the settings file",
  "note": "reason after \"Not saved:\" on the Seedbox settings page."
 },
