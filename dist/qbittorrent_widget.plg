#stt .stt-lead{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;padding:10px 12px}
#stt .stt-lead p{margin:0;opacity:.65;max-width:95ch;flex:1 1 420px}
#stt .stt-leadact{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
#stt .stt-leadact input[type=text]{width:220px}
#stt .stt-status{display:flex;flex-wrap:wrap;gap:4px 18px;align-items:center;padding:0 12px}
#stt .stt-status>*:not(:empty){padding:8px 0}
#stt .stt-status:not(:empty){border-top:1px solid var(--stt-line)}
#stt .stt-status #stt-ubg{flex:1 1 100%;opacity:1}
#stt .stt-filter{display:flex;flex-wrap:wrap;gap:8px 4px;align-items:center;padding:8px 12px;border-top:1px solid var(--stt-line)}
#stt .stt-filter input[type=text]{width:220px}
#stt .stt-foot{opacity:.55;font-size:12px;margin:8px 2px 0;max-width:140ch}
#stt .stt-sethead{margin:36px 0 0;font-size:18px;font-weight:600}
/* activity + job blocks */
#stt .stt-sec{border:0;background:var(--stt-box);margin:8px 0 0}
#stt .stt-sh{font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:400;padding:7px 12px;background:rgba(0,0,0,.18);border:0}
#stt .stt-sh .stt-mut{text-transform:none;letter-spacing:0}
#stt table.stt-act{font-size:13px}
#stt table.stt-act td{border-bottom:0;border-top:1px solid var(--stt-line);padding:8px 12px}
#stt table.stt tr.s-green td{background:rgba(63,162,74,.10)}#stt table.stt tr.s-green td:first-child{box-shadow:inset 3px 0 0 #3fa24a}
#stt table.stt tr.s-blue td{background:rgba(74,144,226,.10)}#stt table.stt tr.s-blue td:first-child{box-shadow:inset 3px 0 0 #4a90e2}
#stt table.stt tr.s-amber td{background:rgba(224,160,48,.12)}#stt table.stt tr.s-amber td:first-child{box-shadow:inset 3px 0 0 #d9921f}
#stt table.stt tr.s-red td{background:rgba(229,83,75,.13)}#stt table.stt tr.s-red td:first-child{box-shadow:inset 3px 0 0 #e5534b}
#stt table.stt tr.s-grey td:first-child{box-shadow:inset 3px 0 0 #8a8a8a}
/* tables: quieter heads and lines */
#stt table.stt{margin:0}
#stt table.stt th{font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:400;opacity:.65;border-bottom:1px solid var(--stt-line);padding:7px 8px}
#stt table.stt td{border-bottom:0;border-top:1px solid var(--stt-line)}
/* Find my torrent: the category bars and folder rows */
#stt .stt-flist table.stt-fx{font-size:13px;margin:0}
#stt .stt-flist table.stt-fx thead th{padding:7px 8px}
#stt table.stt-fx tr.stt-gh .stt-gb{margin:0;border-left:0;box-shadow:inset 3px 0 0 #8a8a8a;padding:10px 12px;font-size:13px;font-weight:600;border-top:1px solid var(--stt-line)}
#stt table.stt-fx tr.stt-gh .stt-gb.g3{box-shadow:inset 3px 0 0 #3fa24a}#stt table.stt-fx tr.stt-gh .stt-gb.gp{box-shadow:inset 3px 0 0 #c9a227}
#stt table.stt-fx tr.stt-gh .stt-gb.gd{box-shadow:inset 3px 0 0 #e5534b}#stt table.stt-fx tr.stt-gh .stt-gb.g2{box-shadow:inset 3px 0 0 #d9921f}
#stt table.stt-fx tr.stt-gh .stt-gb.g1{box-shadow:inset 3px 0 0 #f5a524}#stt table.stt-fx tr.stt-gh .stt-gb.g0{box-shadow:inset 3px 0 0 #8a8a8a;background:rgba(128,128,128,.10)}
#stt table.stt-fx tr.stt-grp td{background:none;border-top:1px solid var(--stt-line);padding:8px}
#stt table.stt-fx tr.stt-sub td{border-top:0;padding-top:4px;padding-bottom:4px}
#stt table.stt-fx tr.stt-sub td:first-child{padding-left:34px}
/* Update me rows */
#stt .stt-ulist .stt-box{border:0;margin:0;padding:9px 12px;border-top:1px solid var(--stt-line)}
#stt .stt-ulist .stt-box:first-child{border-top:0}
#stt .stt-box.s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
#stt .stt-box.s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
#stt .stt-box.s-red{background:rgba(229,83,75,.13);box-shadow:inset 3px 0 0 #e5534b}
#stt .stt-box.s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
#stt .stt-box .stt-ures{margin:6px 0 4px 22px}
#stt .stt-ulist details{border-top:1px solid var(--stt-line);margin:0}
#stt .stt-ulist details>summary{cursor:pointer;padding:10px 12px;font-weight:600;box-shadow:inset 3px 0 0 #8a8a8a;background:rgba(128,128,128,.08);opacity:1}
#stt .stt-ulist details>table{margin:0}
#stt .stt-ulist p{margin:0;padding:10px 12px}
#stt .stt-gbar{display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:8px;align-items:center;width:100%;text-align:left;font:inherit;font-weight:600;color:inherit;border:0;border-top:1px solid var(--stt-line);margin:0;padding:10px 12px;cursor:pointer;letter-spacing:0;text-transform:none;min-width:0;border-radius:0;white-space:normal;font-size:13px;background-color:rgba(128,128,128,.08)}
#stt .stt-gbar:first-child{border-top:0}
#stt .stt-gbar .c{font-weight:400;font-size:12px;opacity:.7}
#stt .stt-gbar.empty{cursor:default;opacity:.5}
#stt .stt-badge.gold{background:rgba(230,190,40,.3);color:#e6be28}
#stt table.stt tr.stt-must td{background:rgba(230,190,40,.08)}
#stt .stt-gbar.s-gold{background:rgba(230,190,40,.16);box-shadow:inset 3px 0 0 #e6be28}
#stt .stt-gbar.s-green{background:rgba(63,162,74,.12);box-shadow:inset 3px 0 0 #3fa24a}
#stt .stt-gbar.s-purple{background:rgba(150,120,230,.12);box-shadow:inset 3px 0 0 #9a7de6}
#stt .stt-gbar.s-blue{background:rgba(74,144,226,.12);box-shadow:inset 3px 0 0 #4a90e2}
#stt .stt-gbar.s-red{background:rgba(229,83,75,.14);box-shadow:inset 3px 0 0 #e5534b}
#stt .stt-ugrp .stt-box{padding-left:34px}
/* Season repacker list */
#stt .stt-splist table.stt td{padding:8px}
#stt #stt-spjobs .stt-sec{margin-top:8px}
/* secondary buttons: quieter, so the main action stands out */
#stt input.stt-ghost{color:inherit!important;opacity:.7;border-color:rgba(128,128,128,.45)!important}
#stt input.stt-ghost:hover{opacity:1}
/* folder roles: one row per downloads folder */
#stt-folders{background:var(--stt-box);margin-top:1px;overflow-x:auto}
#stt .stt-fr{display:grid;grid-template-columns:minmax(220px,1fr) 160px repeat(3,110px);gap:10px;align-items:center;padding:8px 12px;border-top:1px solid var(--stt-line);min-width:700px}
#stt .stt-fr:first-child{border-top:0}
#stt .stt-fh{font-size:11px;letter-spacing:.06em;text-transform:uppercase;opacity:.6;padding-block:6px}
#stt .stt-fr b{font-family:monospace;font-weight:600}
#stt .stt-fr small{display:block;opacity:.6;font-size:12px}
#stt .stt-fr>span:nth-child(n+3){text-align:center}
#stt .stt-ft{opacity:.35;font-family:monospace}#stt .stt-ft.y{opacity:1;color:#3fa24a}
#stt .stt-fr select{margin:0}
#stt .stt-fr.s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
#stt .stt-fr.s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
#stt .stt-fr.s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
#stt .stt-fr.s-grey{background:rgba(128,128,128,.07);box-shadow:inset 3px 0 0 #8a8a8a}
#stt .stt-fr.s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
#stt .stt-fr.s-off{background:repeating-linear-gradient(135deg,rgba(128,128,128,.06) 0 8px,transparent 8px 16px);box-shadow:inset 3px 0 0 rgba(138,138,138,.5);opacity:.75}
/* settings: label left, control right, the explanation as a quiet line under it */
#stt-form dl{display:grid;grid-template-columns:minmax(200px,300px) minmax(0,1fr);margin:8px 0 0;background:var(--stt-box)}
#stt-form dl dt,#stt-form dl dd{float:none;width:auto;margin:0;padding:9px 12px;border-top:1px solid var(--stt-line);text-align:left;line-height:1.5}
#stt-form dl dt{opacity:.75;font-weight:normal}
#stt-form dl dt:first-child,#stt-form dl dt:first-child+dd{border-top:0}
/* Unraid 7 lays every dd out as a flex column (default-base.css, dl > dd): here one setting = one wrapping row */
#stt-form dl dd{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px 8px}
#stt-form dl dd>.stt-hint,#stt-form dl dd>.stt-brk,#stt-form dl dd>div{flex:1 1 100%}
#stt-form dl dd>.stt-brk{height:0}
#stt-form dd input,#stt-form dd select,#stt-form dd textarea{margin:0;max-width:100%}
#stt-form dd select{width:auto!important;min-width:110px}
#stt-form dd input.narrow{width:80px!important;min-width:0}
#stt-form dd input[type=checkbox]{width:auto!important;margin:0 4px 0 0}
#stt-form dd label{display:inline-flex;align-items:center;margin-right:12px}
#stt .stt-lead .stt-leadact{flex:1 1 100%}
#stt .stt-hint{display:block;opacity:.55;font-size:12px;margin-top:3px;max-width:110ch}
@media (max-width:760px){#stt-form dl{grid-template-columns:1fr}#stt-form dl dd{border-top:0;padding-top:0}}
</style>
<div id="stt">
<div class="stt-title"><h2>Seedbox Tools</h2><span class="stt-mut"><?=$tp_t('tp.sub')?></span></div>
<nav class="stt-nav"><a href="#stt-t-find">Find my torrent <i id="stt-n-find"></i></a><a href="#stt-t-upd">Shape up <i id="stt-n-upd"></i></a><a href="#stt-t-rep">Season repacker <i id="stt-n-rep"></i></a><a href="#stt-t-set"><?=$tp_t('tp.settings')?></a></nav>
<details class="stt-about"><summary class="stt-mut"><?=$tp_t('tp.about.what_do_the_tools')?></summary>
<p><?=$tp_T('tp.about.a_seedbox_or_a')?></p>
<p><?=$tp_T('tp.about.find_my_torrent_looks')?></p>
</details>

<div class="mt-band"><span><?=$tp_t('tp.band.activity')?></span><b><?=$tp_t('tp.bandb.replacements_and_added_torrents')?></b></div>
<div class="stt-sec stt-s-proc" id="stt-proc" style="display:none"></div>
<div class="stt-sec stt-s-res" id="stt-results"><div class="stt-sh"><?=$tp_t('act.results')?></div><p class="stt-mut" style="margin:8px 10px"><?=$tp_t('act.nothing_fin')?></p></div>

<div class="mt-band" id="stt-t-find"><span><?=$tp_t('tp.band.find_my_torrent')?></span><b id="stt-fband"></b></div>
<div class="mt-box">
<div class="stt-lead"><p><?=$tp_t('tp.p.folders_in_the_downloads')?></p><input type="button" id="stt-fscan" value="<?=$tp_t('tp.btn.scan_the_downloads_folders')?>"></div>
<div class="stt-status" id="stt-fstat"><span id="stt-fmsg"></span><span id="stt-queue"></span></div>
</div>
<div class="mt-box stt-flist"><div id="stt-fitems"></div></div>

<div class="mt-band" id="stt-t-upd"><span><?=$tp_t('tp.band.shape_up')?></span><b id="stt-uband"></b></div>
<div class="mt-box">
<div class="stt-lead"><p><?=$tp_t('tp.p.every_listed_torrent_is')?></p><input type="button" id="stt-uscan" value="<?=$tp_t('tp.btn.scan_the_seeded_torrents')?>"></div>
<div class="stt-status"><span id="stt-umsg"></span><div id="stt-ubg"></div></div>
<div class="stt-filter" id="stt-ubar" style="display:none"><input type="text" id="stt-uq" placeholder="<?=$tp_t('tp.ph.filter_by_name')?>" autocomplete="off"> <span id="stt-ucats"></span></div>
</div>
<div class="mt-box stt-ulist"><div id="stt-uitems"></div></div>
<p class="stt-foot"><?=$tp_T('tp.upd_foot')?></p>

<div class="mt-band" id="stt-t-rep"><span><?=$tp_t('tp.band.season_repacker')?></span><b id="stt-rband"></b></div>
<div class="mt-box">
<div class="stt-lead"><p><?=$tp_t('tp.p.seasons_downloaded_episode_by')?></p><span class="stt-leadact"><input type="text" id="stt-spq" list="stt-splist" autocomplete="off" placeholder="<?=$tp_t('tp.ph.series_name_empty_all')?>"> <input type="button" id="stt-spscan" value="<?=$tp_t('tp.btn.scan_for_season_packs')?>"></span></div>
<div class="stt-status"><span id="stt-spmsg"></span><span id="stt-abst"></span></div>
</div>
<datalist id="stt-splist"></datalist>
<div id="stt-spjobs"></div>
<div class="mt-box stt-splist"><div id="stt-spab"></div><div id="stt-spitems"></div></div>

<div class="stt-sethead" id="stt-t-set"><?=$tp_t('tp.settings')?></div>
<form id="stt-form" onsubmit="return false;">
<div class="mt-band"><span><?=$tp_t('tp.band.connections')?></span><b><?=$tp_t('tp.bandb.shared_by_the_three')?></b></div>
<dl>
<dt><?=$tp_t('tp.dt.prowlarr_address_and_api')?></dt>
<dd><input type="text" name="prowlarr_url" placeholder="<?=$tp_t('tp.ph.http_192_168_1')?>" style="width:260px"> <input type="password" name="prowlarr_key" autocomplete="new-password" placeholder="<?=$tp_t('tp.ph.api_key')?>" style="width:260px"></dd>
<dt><?=$tp_t('tp.dt.radarr_address_and_api')?></dt>
<dd><input type="text" name="radarr_url" placeholder="<?=$tp_t('tp.ph.http_192_168_12')?>" style="width:260px"> <input type="password" name="radarr_key" autocomplete="new-password" placeholder="<?=$tp_t('tp.ph.api_key')?>" style="width:260px"></dd>
<dt><?=$tp_t('tp.dt.sonarr_address_and_api')?></dt>
<dd><input type="text" name="sonarr_url" placeholder="<?=$tp_t('tp.ph.http_192_168_13')?>" style="width:260px"> <input type="password" name="sonarr_key" autocomplete="new-password" placeholder="<?=$tp_t('tp.ph.api_key')?>" style="width:260px"></dd>
<dt><?=$tp_t('tp.dt.lidarr_address_and_api')?></dt>
<dd><input type="text" name="lidarr_url" placeholder="<?=$tp_t('tp.ph.http_192_168_14')?>" style="width:260px"> <input type="password" name="lidarr_key" autocomplete="new-password" placeholder="<?=$tp_t('tp.ph.api_key')?>" style="width:260px"> <span class="stt-hint"><?=$tp_t('tp.hint.optional_for_the_music')?></span></dd>
<dt><?=$tp_t('tp.dt.autobrr_address_and_api')?></dt>
<dd><input type="text" name="autobrr_url" placeholder="<?=$tp_t('tp.ph.http_192_168_15')?>" style="width:260px"> <input type="password" name="autobrr_key" autocomplete="new-password" placeholder="<?=$tp_t('tp.ph.api_key')?>" style="width:260px"> <span class="stt-hint"><?=$tp_t('tp.hint.optional_only_for_the')?></span></dd>
<dt><?=$tp_t('tp.dt.discord_webhook')?></dt>
<dd><input type="password" name="dc_hook" autocomplete="new-password" placeholder="<?=$tp_t('tp.ph.https_discord_com_api')?>" style="width:420px"> <span class="stt-hint"><?=$tp_t('tp.hint.one_webhook_for_all')?></span></dd>
<dt><?=$tp_t('tp.dt.discord_bot_reactions')?></dt>
<dd><label><input type="checkbox" name="bot_rep" value="1"> <?=$tp_t('tp.lbl.season_packs_from_autobrr')?></label> &nbsp; <label><input type="checkbox" name="bot_find" value="1"> <?=$tp_t('tp.lbl.torrents_removed_from_the')?></label> &nbsp; <input type="button" id="stt-bottest" value="<?=$tp_t('tp.btn.test_the_bot')?>" class="stt-ghost"> <span id="stt-botmsg" class="stt-mut"></span>
<span class="stt-hint"><?=$tp_t('tp.hint.optional_the_seedbox_message')?></span></dd>
<dt><?=$tp_t('tp.dt.check_the_connections')?></dt>
<dd><input type="button" id="stt-test" value="<?=$tp_t('tp.btn.test_the_connections')?>"> <span class="stt-hint"><?=$tp_t('tp.hint.tests_the_saved_settings')?></span><div id="stt-tests" class="stt-mut"></div></dd>
<dt><?=$tp_t('tp.dt.data_folder_as_qbittorrent')?></dt>
<dd><input type="text" name="map_qb" placeholder="/data" style="width:160px"> <input type="text" name="map_host" placeholder="/mnt/user/data" style="width:260px"></dd>
</dl>
<div class="mt-band"><span><?=$tp_t('tp.band.folders')?></span><b id="stt-foldband"></b></div>
<dl>
<dt><?=$tp_t('tp.dt.downloads_folder_on_this')?></dt>
<dd><input type="text" name="dl_base" placeholder="/mnt/user/data/downloads" style="width:320px;font-family:monospace"> <input type="button" id="stt-fread" class="stt-ghost" value="<?=$tp_t('tp.btn.read_the_folders_again')?>"><span class="stt-hint"><?=$tp_t('tp.hint.every_folder_directly_inside')?></span></dd>
</dl>
<div id="stt-folders"></div>
<div class="mt-band"><span><?=$tp_t('tp.band.scans_and_trash')?></span><b><?=$tp_t('tp.bandb.shared_by_the_three')?></b></div>
<dl>
<dt><?=$tp_t('tp.dt.scheduled_scan')?></dt>
<dd><select name="auto_freq"><option value="daily"><?=$tp_t('tp.opt.every_day')?></option><option value="weekly"><?=$tp_t('tp.opt.every_week')?></option></select> <span class="stt-mut">(<?=$tp_t('tp.weekly_on')?></span> <select name="auto_day"><option value="1"><?=$tp_t('tp.opt.monday')?></option><option value="2"><?=$tp_t('tp.opt.tuesday')?></option><option value="3"><?=$tp_t('tp.opt.wednesday')?></option><option value="4"><?=$tp_t('tp.opt.thursday')?></option><option value="5"><?=$tp_t('tp.opt.friday')?></option><option value="6"><?=$tp_t('tp.opt.saturday')?></option><option value="7"><?=$tp_t('tp.opt.sunday')?></option></select><span class="stt-mut">)</span> <?=$tp_t('tp.at')?> <input type="number" name="auto_hour" min="0" max="23" class="narrow"> :00
<span class="stt-brk"></span><label><input type="checkbox" name="auto_scan" value="1"> <?=$tp_t('tp.lbl.find_my_torrent')?></label> &nbsp; <label><input type="checkbox" name="auto_upd" value="1"> <?=$tp_t('tp.lbl.shape_up')?></label> &nbsp; <label><input type="checkbox" name="auto_rep" value="1"> <?=$tp_t('tp.lbl.season_repacker')?></label>
<span class="stt-brk"></span><span class="stt-hint"><?=$tp_T('tp.hint.the_ticked_tools_scan')?></span></dd>
<dt><?=$tp_t('tp.dt.replaced_files_stay_in')?></dt>
<dd><input type="number" name="trash_days" min="0" max="60" class="narrow"> <input type="button" id="stt-trempty" class="stt-ghost" value="<?=$tp_t('tp.btn.empty_the_trash_now')?>"> <span id="stt-trinfo" class="stt-mut"></span> <span class="stt-hint"><?=$tp_T('tp.hint.0_delete_at_once')?></span></dd>
<dt><?=$tp_t('tp.dt.dolby_vision_on_your')?></dt>
<dd><select name="dv_all"><option value="0"><?=$tp_t('tp.opt.not_every_tv_plays')?></option><option value="1"><?=$tp_t('tp.opt.every_tv_plays_it')?></option></select> <span class="stt-hint"><?=$tp_t('tp.hint.a_dolby_vision_only')?></span></dd>
</dl>
<div class="mt-band"><span><?=$tp_t('tp.band.find_my_torrent')?></span><b></b></div>
<dl>
<dt><?=$tp_t('tp.dt.find_my_torrent_accepted')?></dt>
<dd><input type="number" name="find_accept" min="90" max="100" step="0.5" class="narrow"> <span class="stt-hint"><?=$tp_t('tp.hint.after_the_check_a')?></span></dd>
<dt><?=$tp_t('tp.dt.find_my_torrent_files')?></dt>
<dd><input type="number" name="find_missing_files" min="0" max="20" class="narrow"> <span class="stt-hint"><?=$tp_t('tp.hint.if_everything_else_matches')?></span></dd>
<dt><?=$tp_t('tp.dt.find_my_torrent_size')?></dt>
<dd><input type="number" name="find_tol" min="0" max="10" step="0.5" class="narrow"> <span class="stt-hint"><?=$tp_t('tp.hint.a_torrent_may_be')?></span></dd>
<dt><?=$tp_t('tp.dt.replace_unseeded_content_maximum')?></dt>
<dd><input type="number" name="repl_max_growth" min="0" max="1000" class="narrow"> <span class="stt-hint"><?=$tp_t('tp.hint.a_replacement_may_be')?></span></dd>
<dt><?=$tp_t('tp.dt.find_my_torrent_category')?></dt>
<dd><label><input type="checkbox" name="find_cat" value="1"> <?=$tp_t('tp.lbl.give_added_torrents_the')?></label> <span class="stt-hint"><?=$tp_t('tp.hint.the_category_set_in')?></span></dd>
<dt><?=$tp_t('tp.dt.widget_tagline')?></dt>
<dd><input type="text" name="tag_find" maxlength="60" placeholder="<?=$tp_t('tp.ph.keeps_your_seed_healthy')?>" style="width:320px"> <span class="stt-hint"><?=$tp_t('tp.hint.the_line_under_the')?></span></dd>
