    $.each(list, function (x, y) { cntG[y.g] = (cntG[y.g] || 0) + 1; });
    function head(g) {
      var cnt = cntG[g] || 0, op = !!GOPEN[g] && cnt > 0;
      if (inBody) { h += '</tbody>'; inBody = false; }
      h += '<tbody><tr class="stt-gh"><td colspan="6"><div class="stt-gb ' + (g === 2.5 ? 'gd' : g === 2.7 ? 'gp' : 'g' + g) + (cnt ? ' stt-gtg" data-g="' + g + '" title="' + esc(T('f.toggle_cat')) + '" style="cursor:pointer' : '" style="opacity:.55') + '"><span>' + (cnt ? '<span style="display:inline-block;width:16px">' + (op ? '&minus;' : '+') + '</span>' : '<span style="display:inline-block;width:16px"></span>') + esc(g < 0 ? T('f.waiting_search') : (++catNo) + '. ' + G[g]) + '</span><small>' + esc(T('f.n_folders', { n: cnt })) + (cnt ? (g === 3 ? ' &middot; ' + esc(T('f.do_add')) : g === 2.7 ? ' &middot; ' + esc(T('f.do_fix')) : g >= 0 ? ' &middot; ' + esc(T('f.do_replace')) : '') : '') + '</small></div></td></tr></tbody>';
      if (cnt) { h += '<tbody class="stt-gbody" data-g="' + g + '"' + (op ? '' : ' style="display:none"') + '>'; inBody = true; }
    }
    function heads(upto) { $.each(ORD, function (i, g) { if (done[g] || (upto !== null && g < upto)) { return; } if (g === upto || cntG[g] || [3, 2.5, 2, 1, 0].indexOf(g) >= 0) { done[g] = 1; head(g); } }); }
