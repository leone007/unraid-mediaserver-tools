<dt><?=$tp_t('tp.dt.offer')?></dt>
<dd><label><input type="checkbox" name="upd_cat_save" value="1"> <?=$tp_t('tp.lbl.saving')?></label> &nbsp; <label><input type="checkbox" name="upd_cat_hdr" value="1"> <?=$tp_t('tp.lbl.hdr_dv_upgrade')?></label> &nbsp; <label><input type="checkbox" name="upd_cat_res" value="1"> <?=$tp_t('tp.lbl.resolution_upgrade')?></label> &nbsp; <?=$tp_t('tp.upg_growth')?> <input type="number" name="upd_upg_growth" min="0" max="1000" class="narrow"> % <span class="stt-hint"><?=$tp_t('tp.hint.0_no_limit_a')?></span></dd>
<dt><?=$tp_t('tp.dt.widget_tagline')?></dt>
