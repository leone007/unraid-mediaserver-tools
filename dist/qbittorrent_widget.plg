      if (j.stage === 'blocked') { cx = '<input type="button" class="stt-spdis stt-btn stt-sm stt-ghost" data-id="' + esc(j.id) + '" value="' + esc(T('act.dismiss')) + '" title="' + esc(T('act.sp_dismiss_tip')) + '">'; }
      (done ? R : P).push({t: j.t, s: !!stallTxt(j.id), h: actRow({badge: esc(T('act.b_pack')), bc: 'a', title: j.title + ' S' + ('0' + j.season).slice(-2), l1: '', l2: esc(j.pack) + ' (' + fb(j.pack_size) + ')', msg: j.msg, c: c, btn: cx, t: j.t, id: j.id, live: {grabbed: 1, downloading: 1}[j.stage]})});
    });
