    var t2 = '<div class="stt-sh">' + esc(T('act.results')) + ' <span class="stt-mut">' + esc(T('act.finished')) + '</span>' + (R.length > 6 ? ' <a href="#" class="stt-more">' + esc(showAll ? T('act.fewer') : T('act.all', { n: R.length })) + '</a>' : '') + (R.length ? ' <a href="#" class="stt-clr" style="margin-left:10px" title="' + esc(T('act.clear_tip')) + '">' + esc(T('act.clear')) + '</a>' : '') + '</div>';
    t2 += R.length ? '<table class="stt stt-act"><tbody>' + $.map(R.slice(0, lim), function (x) { return x.h; }).join('') + '</tbody></table>' : '<p class="stt-mut" style="margin:8px 10px">' + esc(T('act.nothing_fin')) + '</p>';
    $('#stt-results').html(t2);
