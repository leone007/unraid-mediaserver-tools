  $(document).on('click', '.stt-gtg', function () {
    var g = String($(this).data('g')); GOPEN[g] = !GOPEN[g];
    $(this).find('span span').first().html(GOPEN[g] ? '&minus;' : '+');
    $('#stt-fitems tbody.stt-gbody').filter(function () { return String($(this).data('g')) === g; }).toggle(GOPEN[g]);
  });
  $(document).on('click', '.stt-add', function () {
    var $b = $(this);
    if (!window.confirm(T('f.add_confirm'))) { return; }
    $b.prop('disabled', true).val(T('f.adding'));
    api('find_add', {id: $b.data('id'), idx: $b.data('idx')}).done(function (r) {
      if (r.ok) { $b.val(T('f.added')); loadState(); setTimeout(pollFind, 1500); } else { $b.prop('disabled', false).val(T('f.btn_add')); window.alert(r.error); }
    }).fail(function (x) { $b.prop('disabled', false).val('Add'); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-del', function () {
    var $b = $(this), td = cfg && +cfg.trash_days > 0;
    if (!window.confirm(td ? T('f.trash_confirm', { n: cfg.trash_days }) : T('f.del_confirm'))) { return; }
    $b.prop('disabled', true);
    api('find_delete', {id: $b.data('id')}).done(function (r) { if (r.ok) { $b.closest('tr').nextUntil('.stt-grp').addBack().remove(); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-ign', function () { var $b = $(this).prop('disabled', true); api('find_ignore', {id: $b.data('id')}).done(function () { $b.closest('tr').nextUntil('.stt-grp').addBack().remove(); }); });
  $(document).on('click', '.stt-tg', function (e) {
    e.preventDefault(); var k = String($(this).data('key')); COLL[k] = COLL[k] === false;
    $(this).html(COLL[k] ? '+' : '&minus;').closest('tr').nextUntil('.stt-grp,.stt-gh').filter('.stt-rs').toggle(!COLL[k]);
  });
  $(document).on('click', '.stt-clr', function (e) { e.preventDefault(); $.when(api('clear_results'), api('sp_clear')).done(function () { loadState(); pollSp(); }); });
  function pollFind() {
    clearTimeout(fT);
    api('find_get').done(function (r) {
      RES = r.res || RES; drawFind(r.find); drawQueue(r);
      var busy = r.running || r.find.state === 'running';
      $.each(RES, function (k, x) { if (x.state === 'running') { busy = true; } });
      if (busy) { fT = setTimeout(pollFind, 2500); } else { $('#stt-fscan').prop('disabled', false); }
    });
  }
  $(document).on('click', '.stt-rsearch', function () {
    COLL[String($(this).data('key'))] = false; var $b = $(this).prop('disabled', true).val(T('f.searching'));
    api('repl_search', {id: $b.data('id')}).done(function (r) { if (r.ok) { setTimeout(pollFind, 600); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $('#stt-fscan').on('click', function () {
    $(this).prop('disabled', true); $('#stt-fmsg').css('color', '').text(T('f.starting'));
    api('find_scan').done(function () { setTimeout(pollFind, 800); }).fail(function (x) { $('#stt-fscan').prop('disabled', false); $('#stt-fmsg').css('color', '#e5534b').text(err(x)); });
  });
  var COLL = {}, GOPEN = {}, showAll = false, LAST = {p: null, j: null, q: 0};
  $(document).on('click', '.stt-more', function (e) { e.preventDefault(); showAll = !showAll; drawActivity(); });
  // a speed: one decimal under 10 MB/s
  function fsp(b) { b = +b || 0; return b >= 1e9 ? (b / 1e9).toFixed(1) + ' GB/s' : b >= 1e6 ? (b / 1e6).toFixed(b < 1e7 ? 1 : 0) + ' MB/s' : b >= 1e3 ? Math.round(b / 1e3) + ' KB/s' : b + ' B/s'; }
  // time left in seconds, readable: 16 d 7 h, 1 h 17 m, 9 m
  function fmtEta(e) { if (!(e > 0)) { return ''; } var d = Math.floor(e / 86400), h = Math.floor(e % 86400 / 3600), m = Math.ceil(e % 3600 / 60); if (m === 60) { h++; m = 0; } return d ? T('dur.dh', { d: d, h: h }) : h ? T('dur.hm', { h: h, m: m }) : T('dur.m', { m: Math.max(1, m) }); }
  // a running job's own progress (qBittorrent): numbers on one line, a bar under them; the bar takes the row's state color
  function progHtml(id, stalled) {
    var x = id && LAST.dl && LAST.dl.per ? LAST.dl.per[id] : null;
    if (!x) { return null; }
    var pc = Math.floor((+x.p || 0) * 100), bar = function (cls, w) { return '<div class="stt-pbar ' + cls + '"><i style="width:' + Math.max(1, Math.min(100, w)) + '%"></i></div>'; };
    if (x.st === 'moving') { return {g: 1, h: '<div class="stt-pst"><b>' + esc(T('pr.moving', { p: pc })) + '</b>' + (x.speed > 0 ? '<span>&rarr; ' + fsp(x.speed) + '</span>' : '') + (x.eta > 0 ? '<span>' + esc(T('pr.left', { t: fmtEta(x.eta) })) + '</span>' : '') + '</div>' + bar('gr', pc)}; }
    if (x.st === 'movewait') { return {g: 1, h: '<div class="stt-pst"><b>' + esc(T('pr.movewait')) + '</b></div>' + bar('gr', 0)}; }
    if (x.st === 'done') { return {h: '<div class="stt-pst"><b>' + esc(T('pr.downloaded')) + '</b><span>' + fb(x.size) + '</span><span class="stt-mut">' + esc(T('pr.wait_import')) + '</span></div>' + bar('', 100)}; }
    return {h: '<div class="stt-pst"><b>' + esc(T('pr.downloading', { p: pc })) + '</b><span>' + fb(x.done) + ' / ' + fb(x.size) + '</span><span>&darr; ' + fsp(x.speed) + '</span><span>' + esc(x.eta > 0 ? T('pr.left', { t: fmtEta(x.eta) }) : T('pr.no_eta')) + '</span></div>' + bar(stalled ? 'am' : '', pc)};
  }
  function actRow(o) {
    var sc = {'stt-ok': 's-green', 'stt-am': 's-amber', 'stt-er': 's-red', 'stt-mut': 's-grey'}[o.c] || 's-blue', st = stallTxt(o.id);
    var pr = o.live ? progHtml(o.id, !!st) : null;
    if (pr && pr.g) { sc = 's-grey'; } // moving: grey row
    if (st) { sc = 's-amber'; } // stalled: amber row (stuck) and a badge of its own
    return '<tr class="' + sc + '"><td><span class="stt-badge ' + o.bc + '">' + o.badge + '</span>' + (st ? '<span class="stt-badge a">' + esc(T('pr.stalled_b')) + '</span>' : '') + '<b>' + esc(o.title) + '</b>' + (o.l1 ? '<div class="stt-mut">' + o.l1 + '</div>' : '') + (o.l2 ? '<div class="stt-mut">&rarr; ' + o.l2 + '</div>' : '') + '</td>' +
      '<td class="' + o.c + '" style="width:36%">' + (pr ? pr.h : esc(o.msg) + (o.okbar ? '<div class="stt-pbar ok"><i style="width:100%"></i></div>' : '')) + st + '</td><td class="stt-r">' + (o.btn || '') + '<div class="stt-mut">' + esc(T('ab.ago', { t: ago(o.t) })) + '</div></td></tr>';
  }
  // a stalled download on its own row: seeders connected now and what the tracker lists
  function stallTxt(id) {
    var x = id && LAST.dl && LAST.dl.stall ? LAST.dl.stall[id] : null;
    if (!x) { return ''; }
    return '<div class="stt-am">' + esc(T('pr.stalled', { why: x.seeds ? T('pr.seeds_none', { n: x.seeds }) : T('pr.no_seeder') + (x.swarm ? ' ' + T('pr.swarm', { n: x.swarm }) : '') })) + '</div>';
  }
  // the replacements still downloading together: bytes left and one ETA at qBittorrent's total download speed;
  // then the moves to the array (one torrent at a time, at the measured move speed): the end is the later of
  // 'downloads done + the last one moved' and 'every move one after the other'
  // the N days field shows only with 'for N days after a scan'
  function showDays() { $('#stt-form select[name^=show_]').each(function () { $(this).siblings('.stt-showd').toggle($(this).val() === 'days'); }); }
  $(document).on('change', '#stt-form select[name^=show_]', showDays);
  function dlSum(d) {
    if (!d || !d.jobs) { return ''; }
    if (d.err) { return ' &middot; ' + esc(d.err); }
    var mv = +d.mv || 0, mr = +d.mrate || 0, mvT = mv > 0 && mr > 0 ? mv / mr : -1;
    var mvTxt = esc(mv > 0 ? (mvT > 0 ? T('pr.to_move_at', { s: fb(mv), r: fsp(mr) }) : T('pr.to_move', { s: fb(mv) })) : '');
    if (!d.found) { return mv > 0 ? ' &middot; ' + mvTxt + (mvT > 0 ? ' &middot; ' + esc(T('pr.about', { t: fmtEta(mvT) })) : '') : ''; }
    var r = ' &middot; ' + esc(T('pr.n_dl', { n: d.found })) + ' &middot; ' + esc(T('pr.left', { t: fb(d.left) }));
    if (d.stalled && d.stalled === d.found) { return r + ' &middot; <span class="stt-am">' + esc(T('pr.stalled', { why: d.seeds ? T('pr.seeds_none', { n: d.seeds }) : T('pr.no_seeder') + (d.swarm ? ' ' + T('pr.swarm', { n: d.swarm }) : '') })) + '</span>'; }
    if (d.speed < 1e5) { return r + ' &middot; ' + (d.stalled ? esc(T('pr.n_stalled', { n: d.stalled })) + ' &middot; ' : '') + esc(T('pr.hardly', { s: (d.speed / 1e3).toFixed(0) })); }
    var e = d.left / d.speed;
    r += ' &middot; ' + esc(T('pr.about_at', { t: fmtEta(e), r: fsp(d.speed) }));
