      $o.append('<button type="button" class="stt-gbar ' + GS[g] + (n ? '' : ' empty') + '" data-g="' + g + '"' + (n ? '' : ' disabled') + '><span class="pm">' + (n ? (op ? '&minus;' : '+') : '') + '</span><span class="t">' + GL[g] + '</span><span class="c">' + n + ' torrent' + (n === 1 ? '' : 's') + '</span></button>');
