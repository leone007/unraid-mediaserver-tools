  "note": "in brackets after the balance line."
 },
 "u.approx_tip": {
  "text": "Counted with the first release listed for each torrent. Hardlinked files (imported into Radarr or Sonarr) free their space only when every link is gone.",
  "note": "tooltip of (approx.)."
 },
 "u.band": {
