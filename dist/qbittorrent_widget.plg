  api('trash_info').done(trashInfo);
  $('#stt-trempty').on('click', function () {
    var $b = $(this);
    if (!window.confirm('Empty the trash now?\n\nEverything in the .seedbox_trash folders is deleted at once ' + $('#stt-trinfo').text() + '. This cannot be undone. Space is freed only for files that have no other hardlink (for example in the media folder).')) { return; }
    $b.prop('disabled', true);
