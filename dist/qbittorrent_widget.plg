$tp_lang = '/usr/local/emhttp/plugins/qbittorrent_widget/lang';
$tp_T = mt_i18n_t($tp_lang);
$tp_t = function ($k, $v = []) use ($tp_T) { return htmlspecialchars($tp_T($k, $v), ENT_QUOTES); };
$stt_var = @parse_ini_file('/var/local/emhttp/var.ini');
$stt_tok = is_array($stt_var) ? (string)($stt_var['csrf_token'] ?? '') : '';
?>
<style>
