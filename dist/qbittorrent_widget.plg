<!-- ========================================================= -->
<!-- DASHBOARD TILE                                             -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/&name;.page">
<INLINE><![CDATA[Menu="Dashboard:0"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>')"
Markdown="false"
---
<?PHP
$pluginname = "qbittorrent_widget";

$mytiles[$pluginname]['column2'] =
<<<EOT
<tbody title="_(Seedbox)_">
<tr><td>
  <span class="tile-header">
    <span class="tile-header-left">
      <i class="f32 qbt-ic"></i>
      <div class="section">
        <h3 class="tile-header-main qbt-ttl">Seedbox</h3>
        <span id="qbt-summary" class="qbt-sum">Connecting&hellip;</span>
      </div>
    </span>
    <span class="tile-header-right">
      <span class="tile-header-right-controls">
        <a id="qbt-home" href="#" target="_blank" rel="noopener" title="_(Open qBittorrent Web UI)_"><i class="fa fa-fw fa-home control"></i></a>
        <a href="/Settings/QbtWidgetSettings" title="_(Seedbox settings)_"><i class="fa fa-fw fa-cog control"></i></a>
      </span>
    </span>
  </span>
</td></tr>
<tr><td>
  <div class="qbt-tile">
    <div id="qbt-status"></div>
    <div id="qbt-tools"></div>
    <div id="qbt-attn"></div>
    <div id="qbt-xfer"><div class="qbt-note">Loading&hellip;</div></div>
  </div>
</td></tr>
</tbody>
EOT;
?>
<style>
i.f32.qbt-ic{display:inline-block!important;width:30px!important;height:30px!important;font-size:0!important;background:url(/plugins/qbittorrent_widget/icon.png) center/contain no-repeat!important}
i.f32.qbt-ic.qbt-inv{filter:invert(1)}
.qbt-ttl{margin-bottom:2px!important}
.qbt-sum{display:block;margin:0!important;line-height:1.3}
.qbt-tile{width:100%;font-size:12px;white-space:normal}
.qbt-tile a{text-decoration:none}
#qbt-status{display:flex;justify-content:flex-end;margin:0 0 4px}
.qbt-pill{display:inline-flex;border:1px solid rgba(128,128,128,.35);border-radius:6px;overflow:hidden}
.qbt-pill span{padding:3px 10px}
.qbt-pill span+span{border-left:1px solid rgba(128,128,128,.35)}
.qbt-num{text-align:right;white-space:nowrap;font-family:bitstream,monospace}
.qbt-nm{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3;word-break:break-word}
.qbt-u{opacity:.6}
.qbt-pl{display:flex;align-items:center;gap:8px;margin-top:5px;font-family:bitstream,monospace;white-space:nowrap}
.qbt-pb{height:4px;border-radius:2px;background:rgba(128,128,128,.3);overflow:hidden;flex:1;min-width:30px}
.qbt-pb i{display:block;height:100%}
.qbt-bd{display:inline-block;font-size:11px;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:4px}
.qbt-bd.qbt-red{background:rgba(229,83,75,.22);color:#e5534b}
.qbt-bd.qbt-amber{background:rgba(224,160,48,.22);color:#d9921f}
.qbt-rs{margin-top:4px;font-size:11px;line-height:1.3;overflow-wrap:anywhere}
.qbt-rs.qbt-red{color:#e5534b}
.qbt-rs.qbt-amber{color:#d9921f}
.qbt-note{padding:8px 10px;text-align:center;font-style:italic;opacity:.6}
.qbt-more{display:block;text-align:center;padding:10px 0 2px;color:#4a90e2}
/* Shared tile look (the Sysbox / Diskbox style): dark section bands, the content in a box under them, colored left stripes on rows.
   Used by Seedbox and Streambox; the build copies this block into each plugin's page where the marker below stands. */
.mt-band{display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(0,0,0,.25);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:7px 10px;margin-top:14px}
.mt-band.mt-first{margin-top:6px}
.mt-band span{opacity:.75}
.mt-band b{font-weight:400;opacity:.5;text-transform:none;letter-spacing:0;text-align:right}
.mt-band.mt-red span{color:#e5534b;opacity:1}
.mt-box{background:rgba(128,128,128,.12);margin-top:8px}
.mt-cols{display:grid;gap:8px;align-items:center;padding:6px 10px 4px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid rgba(128,128,128,.2)}
.mt-cols>div{opacity:.6}
.mt-r{display:grid;gap:8px;align-items:center;padding:8px 10px;border-top:1px solid rgba(128,128,128,.2)}
.mt-box>.mt-r:first-child,.mt-cols+.mt-r{border-top:0}
.mt-s-orange{background:rgba(245,165,36,.10);box-shadow:inset 3px 0 0 #f5a524}
.mt-s-blue{background:rgba(74,144,226,.10);box-shadow:inset 3px 0 0 #4a90e2}
.mt-s-green{background:rgba(63,162,74,.10);box-shadow:inset 3px 0 0 #3fa24a}
.mt-s-red{background:rgba(229,83,75,.14);box-shadow:inset 3px 0 0 #e5534b}
.mt-s-amber{background:rgba(224,160,48,.12);box-shadow:inset 3px 0 0 #d9921f}
.mt-s-purple{background:rgba(150,120,230,.10);box-shadow:inset 3px 0 0 #9a7de6}
.mt-s-grey{background:rgba(128,128,128,.08);box-shadow:inset 3px 0 0 #8a8a8a}
.mt-box .mt-n{background:none}
.mt-note{padding:8px 10px;text-align:center;font-style:italic;opacity:.6}
</style>
<script>
$(function () {
  // Optional hook; stock Unraid has no addWidget(), so this is a harmless no-op.
  if (typeof addWidget === 'function') { addWidget('db-qbittorrent', true); }

  var API = '/plugins/qbittorrent_widget/api_fetch.php';
  var busy = false;
  var themed = false;
  var DEF_UI = { cols: { dl: true, ul: true, eta: true }, bar: true, port: 8080, url: '' };
  var ICON = {
    error: 'fa-times-circle', missing: 'fa-exclamation-circle', paused: 'fa-pause',
    queued: 'fa-clock-o', checking: 'fa-refresh', stalled: 'fa-exclamation-triangle',
    idle: 'fa-exclamation-triangle', moving: 'fa-exchange', unknown: 'fa-question-circle',
    conn: 'fa-globe', disc: 'fa-chain-broken', tools: 'fa-chain-broken'
  };
  var COLOR = { red: '#e5534b', amber: '#d9921f', green: '#3fa24a', blue: '#4a90e2', grey: '#8a8a8a', orange: '#f5a524' };

  // The embedded icon is light; invert it when the page background is light
  function applyTheme() {
    if (themed) { return; }
    themed = true;
    var el = document.getElementById('qbt-xfer');
    while (el) {
      var m = /rgba?\(([^)]+)\)/.exec(getComputedStyle(el).backgroundColor || '');
      if (m) {
        var p = m[1].split(',');
        var a = p.length > 3 ? parseFloat(p[3]) : 1;
        if (a > 0.5) {
          if ((0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2]) > 150) { $('i.qbt-ic').addClass('qbt-inv'); }
          return;
        }
      }
      el = el.parentElement;
    }
  }

  function rate(b) {
    if (!(b >= 50)) { return null; }
    var v = b / 1024, u = ['kB/s', 'MB/s', 'GB/s'], i = 0;
    while (v >= 1024 && i < 2) { v /= 1024; i++; }
    return { n: v >= 100 ? v.toFixed(0) : (v >= 10 ? v.toFixed(1) : v.toFixed(2)), u: u[i] };
  }
  function rateTxt(b) { var r = rate(b); return r ? r.n + ' ' + r.u : '0 kB/s'; }
  function size(b) {
    var u = ['B', 'kB', 'MB', 'GB', 'TB'], i = 0, v = b;
    while (v >= 1024 && i < 4) { v /= 1024; i++; }
    return (i >= 3 ? v.toFixed(1) : v.toFixed(0)) + ' ' + u[i];
  }
  function fmtEta(s, p) {
    if (p >= 1) { return '\u2014'; }
    if (s < 0 || s >= 8640000) { return '\u221E'; }
    var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
    if (d > 0) { return d + 'd ' + h + 'h'; }
    if (h > 0) { return h + 'h ' + (m < 10 ? '0' : '') + m + 'm'; }
    if (m > 0) { return m + 'm'; }
    return Math.floor(s) + 's';
  }

  function pretty(n) {
    if (/\s/.test(n)) { return n; }
    var t = n.replace(/(^|[^\d])(\d)\.(\d)(?!\d)/g, '$1$2\u0001$3').replace(/\b([Hh])\.(26[45])\b/g, '$1\u0001$2');
    t = t.replace(/[._]+/g, ' ').replace(/\u0001/g, '.');
    return t.replace(/\s+/g, ' ').trim();
  }

  function speedCell(b) {
    var r = rate(b), $c = $('<div class="qbt-num">');
    if (!r) { return $c.addClass('qbt-u').text('\u2014'); }
    return $c.append(document.createTextNode(r.n)).append($('<span class="qbt-u">').text(' ' + r.u));
  }

  function moreLink(href, text) {
    return $('<a class="qbt-more" target="_blank" rel="noopener">').attr('href', href)
      .append(document.createTextNode(text + ' ')).append($('<i class="fa fa-external-link">'));
  }

  function renderPill(r) {
    var map = {
      connected:    [COLOR.green, 'fa-globe', 'Connected'],
      firewalled:   [COLOR.amber, 'fa-globe', 'Firewalled'],
      disconnected: [COLOR.red, 'fa-chain-broken', 'Disconnected']
    };
    var g = (r && r.conn && map[r.conn]) ? map[r.conn] : [COLOR.grey, 'fa-chain-broken', (r && r.ok) ? 'Unknown' : 'Offline'];
    var $p = $('<div class="qbt-pill">');
    $p.append($('<span>').css('color', g[0]).append($('<i class="fa">').addClass(g[1])).append(document.createTextNode(' ' + g[2])));
    if (r && r.ok) {
      if (r.attention_total > 0) {
        $p.append($('<span>').css('color', COLOR.red).append($('<i class="fa fa-exclamation-triangle">'))
          .append(document.createTextNode(' ' + r.attention_total + ' need attention')));
      } else {
        $p.append($('<span>').css('color', COLOR.green).append($('<i class="fa fa-check-circle">'))
          .append(document.createTextNode(' All healthy')));
      }
    }
    $('#qbt-status').empty().append($p);
  }

  function renderSummary(r) {
    var $s = $('#qbt-summary');
    if (!r || !r.ok) { $s.text('Unavailable'); return; }
    var c = r.counts || { seeding: 0, downloading: 0, busy: 0 };
    var g = r.global || { dl: 0, ul: 0 };
    var speeds = '\u2193 ' + rateTxt(g.dl) + '\u00A0\u00A0\u2191 ' + rateTxt(g.ul);
    // folders that no torrent seeds (Find my torrent): the header counts them too, so 'All seeding' is said only when there are none
    var ns = +r.not_seeded > 0 ? +r.not_seeded : 0;
    $s.attr('title', ns ? ns + ' folder' + (ns === 1 ? '' : 's') + ' in the downloads folders that no torrent seeds (last Find my torrent scan)' : '');
    if (ns && r.attention_total === 0 && c.downloading === 0 && !c.busy) { $s.text(c.seeding + ' of ' + (c.seeding + ns) + ' seeded \u00B7 ' + ns + ' not seeded \u00B7 ' + speeds); }
    else if (r.attention_total === 0 && c.downloading === 0 && !c.busy) { $s.text('All ' + c.seeding + ' seeding \u00B7 ' + speeds); }
    else {
      $s.text(c.seeding + ' seeding' + (ns ? ' \u00B7 ' + ns + ' not seeded' : '') + (c.downloading ? ' \u00B7 ' + c.downloading + ' downloading' : '')
        + (c.busy ? ' \u00B7 ' + c.busy + ' busy' : '') + ' \u00B7 ' + speeds);
    }
  }

  function band(text, meta, first, red) {
    var $b = $('<div class="mt-band">').toggleClass('mt-first', !!first).toggleClass('mt-red', !!red).append($('<span>').text(text));
    if (meta) { $b.append($('<b>').text(meta)); }
    return $b;
  }
  var STRIPE = { amber: 'amber', orange: 'orange', blue: 'blue', green: 'green', red: 'red', grey: 'grey' };

  function renderTools(r) {
    var $t = $('#qbt-tools').empty();
    if (!r || !r.ok || !r.tools || !r.tools.length) { return; }
    var g = '18px minmax(0,1fr) 190px', BG = { amber: 'rgba(224,160,48,.22)', orange: 'rgba(245,165,36,.22)', blue: 'rgba(74,144,226,.22)', green: 'rgba(63,162,74,.22)', red: 'rgba(229,83,75,.22)', grey: 'rgba(185,185,185,.2)' };
    var TC = { amber: '#d9921f', orange: COLOR.orange, blue: COLOR.blue, green: COLOR.green, red: COLOR.red, grey: '#b9b9b9' };
    $t.append(band('Seedbox tools', 'Action', true));
    var $box = $('<div class="mt-box">').appendTo($t);
    $.each(r.tools, function (i, x) {
      var c = x.col || 'grey';
      var $row = $('<div class="mt-r">').addClass('mt-n mt-s-' + (STRIPE[c] || 'grey')).css('grid-template-columns', g);
      $row.append($('<i class="fa fa-fw">').addClass(x.name === 'Find my torrent' ? 'fa-chain-broken' : (x.name === 'Shape up' ? 'fa-arrow-circle-up' : 'fa-refresh')).css('color', TC[c]));
      if (x.tip) { $row.attr('title', x.tip); }
      var $n = $('<div class="qbt-nm">').css('display', 'block').append($('<a>').attr('href', x.href).css({ color: 'inherit', textDecoration: 'none', fontWeight: 'bold' }).text(x.name));
      if (x.tag) { $n.append($('<div class="qbt-rs">').css({ color: '#8a8a8a', marginTop: '2px' }).attr('title', x.tagtip || '').text(x.tag)); }
      $row.append($n);
      var $a = $('<div>').append($('<span class="qbt-bd">').css({ background: BG[c], color: TC[c] }).text(x.badge));
      if (x.reason) { $a.append($('<div class="qbt-rs">').css('color', TC[c]).text(x.reason)); }
      if (x.when) { $a.append($('<div class="qbt-rs">').css({ color: '#8a8a8a', marginTop: '2px' }).text(x.when)); }
      $row.append($a);
      $box.append($row);
    });
  }

  function renderAttention(r, href) {
    var $a = $('#qbt-attn').empty();
    if (!r || !r.ok || !r.attention || !r.attention.length) { return; }
    var t = '18px minmax(0,1fr) 170px';
    $a.append(band('Needs attention \u00B7 ' + r.attention_total, 'Torrent \u00B7 Issue', false, true));
    var $box = $('<div class="mt-box">').appendTo($a);
    $.each(r.attention, function (i, x) {
      var col = (x.sev === 'red') ? 'red' : 'amber';
      var $row = $('<div class="mt-r">').addClass('mt-s-' + col).css('grid-template-columns', t);
      $row.append($('<i class="fa fa-fw">').addClass(ICON[x.kind] || 'fa-exclamation-triangle').css('color', COLOR[col]));
      if (x.tip) { $row.attr('title', x.tip); }
      if (x.href) { $row.append($('<div class="qbt-nm">').attr('title', x.tip || x.name).append($('<a>').attr('href', x.href).css('color', 'inherit').text(x.name))); }
      else { $row.append($('<div class="qbt-nm">').attr('title', x.name).text(pretty(x.name))); }
      $row.append($('<div>')
        .append($('<span class="qbt-bd">').addClass('qbt-' + col).text(x.badge))
        .append($('<div class="qbt-rs">').addClass('qbt-' + col).text(x.reason)));
      $box.append($row);
    });
    if (r.attention_more > 0) { $a.append(moreLink(href, '+' + r.attention_more + ' more flagged')); }
  }

  function renderTransfer(r, ui, href) {
    var $x = $('#qbt-xfer').empty();
    if (!r || !r.ok) {
      var msg = (r && r.error === 'auth') ? 'Authentication failed (check Seedbox settings)' : 'qBittorrent unreachable';
      $x.append($('<div class="qbt-note">').text(msg));
      return;
    }
    var gl = r.global || { dl: 0, ul: 0 };
    $x.append(band('In transfer \u00B7 ' + r.transfer_total, '\u2193 ' + rateTxt(gl.dl) + '\u00A0\u00A0\u2191 ' + rateTxt(gl.ul), false));
    var $box = $('<div class="mt-box">').appendTo($x);

    var t = ['18px', 'minmax(0,1fr)'], hd = $('<div class="mt-cols">');
    hd.append($('<div>')).append($('<div>').text('Torrent'));
    if (ui.cols.dl)  { t.push('76px'); hd.append($('<div class="qbt-num">').css('color', COLOR.orange).text('Down')); }
    if (ui.cols.ul)  { t.push('76px'); hd.append($('<div class="qbt-num">').text('Up')); }
    if (ui.cols.eta) { t.push('50px'); hd.append($('<div class="qbt-num">').text('ETA')); }
    var tpl = t.join(' ');
    $box.append(hd.css('grid-template-columns', tpl));
    if (!r.transfer.length) { $box.append($('<div class="mt-note">').text('Nothing transferring right now')); return; }

    var nCols = (ui.cols.dl ? 1 : 0) + (ui.cols.ul ? 1 : 0) + (ui.cols.eta ? 1 : 0);
    var BUSY = { Moving: 'fa-exchange', Checking: 'fa-refresh', Allocating: 'fa-hdd-o' }, LIGHT = '#b9b9b9';
    $.each(r.transfer, function (i, x) {
      var isDown = (x.dir === 'down'), isBusy = (x.dir === 'busy');
      var $row = $('<div class="mt-r">').css('grid-template-columns', tpl).addClass(isBusy ? 'mt-s-grey' : (isDown ? 'mt-s-orange' : 'mt-s-blue'));
      var icon = isBusy ? (BUSY[x.label] || 'fa-refresh') : (isDown ? 'fa-arrow-down' : 'fa-arrow-up');
      $row.append($('<i class="fa fa-fw">').addClass(icon)
        .css('color', isBusy ? COLOR.grey : (isDown ? COLOR.green : COLOR.blue)));

      var $nm = $('<div>').append($('<div class="qbt-nm">').attr('title', x.name).text(pretty(x.name)));
      if (ui.bar) {
        var done = x.progress >= 1;
        var pct = Math.max(0, Math.min(100, x.progress * 100));
        var mv = isBusy && x.label === 'Moving', wt = mv && x.wait;
        var col = mv ? LIGHT : (isBusy ? COLOR.grey : (done ? COLOR.green : COLOR.orange));
        var $pl = $('<div class="qbt-pl">')
          .append($('<div class="qbt-pb">').append($('<i>').css({ width: (wt ? 0 : pct) + '%', background: col })))
          .append($('<span>').css('color', col).text(wt ? 'waiting' : (mv ? pct.toFixed(1) + '%' : (done ? '100%' : pct.toFixed(1) + '%'))));
        if (!isBusy) { $pl.append($('<span class="qbt-u">').text(done ? size(x.size) : size(x.completed) + ' / ' + size(x.size))); }
        $nm.append($pl);
      }
      $row.append($nm);

      if (isBusy) {
        if (nCols > 0) {
          var lbl = x.label + (x.label === 'Checking' ? ' ' + (x.progress * 100).toFixed(1) + '%' : '');
          if (x.label === 'Moving' && ui.cols.eta) {
            if (nCols > 1) { $row.append($('<div class="qbt-num qbt-u">').css('grid-column', 'span ' + (nCols - 1)).text(lbl)); }
            $row.append($('<div class="qbt-num">').text(x.eta > 0 && x.eta < 8640000 ? fmtEta(x.eta, 0) : '\u2014'));
          } else {
            $row.append($('<div class="qbt-num qbt-u">').css('grid-column', 'span ' + nCols).text(lbl));
          }
        }
      } else {
        if (ui.cols.dl)  { $row.append(speedCell(x.dl)); }
        if (ui.cols.ul)  { $row.append(speedCell(x.ul)); }
        if (ui.cols.eta) { $row.append($('<div class="qbt-num">').text(isDown ? fmtEta(x.eta, x.progress) : '\u2014')); }
      }
      $box.append($row);
    });
    if (r.more > 0) { $x.append(moreLink(href, '+' + r.more + ' more in transfer')); }
  }

  function render(r) {
    applyTheme();
    var ui = (r && r.ui) ? r.ui : DEF_UI;
    var href = ui.url ? ui.url : 'http://' + location.hostname + ':' + ui.port;
    $('#qbt-home').attr('href', href);
    renderPill(r);
    renderSummary(r);
    renderTools(r);
    renderAttention(r, href);
    renderTransfer(r, ui, href);
  }

  function poll() {
    if (busy) { return; }
    busy = true;
    $.getJSON(API, { _: Date.now() })
      .done(render)
      .fail(function () { render({ ok: false, error: 'unreachable' }); })
      .always(function () { busy = false; });
  }

  poll();
  setInterval(poll, 5000);
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SETTINGS PAGE  (Settings -> Utilities -> Seedbox)          -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/QbtWidgetSettings.page">
<INLINE><![CDATA[Menu="Utilities"
Type="xmenu"
Title="Seedbox"
Icon="seedbox.png"
Markdown="false"
---
<?PHP
$qbt_file = '/boot/config/plugins/qbittorrent_widget/settings.cfg';
$qbt = [
  'host' => '127.0.0.1', 'port' => '8080', 'user' => '', 'pass' => '', 'webui_url' => '',
  'rows' => '6', 'max_attention' => '15', 'show_bar' => '1',
  'col_dl' => '1', 'col_ul' => '1', 'col_eta' => '1',
];
if (is_file($qbt_file)) {
  $qbt_c = @parse_ini_file($qbt_file, false, INI_SCANNER_RAW);
  if (is_array($qbt_c)) { $qbt = array_merge($qbt, $qbt_c); }
}
$qbt_var = @parse_ini_file('/var/local/emhttp/var.ini');
$qbt_tok = is_array($qbt_var) ? (string)($qbt_var['csrf_token'] ?? '') : '';
if (!function_exists('qbt_h')) {
  function qbt_h($v) { return htmlspecialchars((string)$v, ENT_QUOTES); }
}
if (!function_exists('qbt_chk')) {
  function qbt_chk($v) { return in_array(strtolower(trim((string)$v)), ['0', 'no', 'false', 'off', ''], true) ? '' : 'checked'; }
}
?>
<style>
/* Shared settings-page look (the owner's design rule, 2026-10-10): a dark band per part (the h3), the rows in a box, the label on the
   left, the controls of one setting on one line, the explanation as a quiet line under them. Scoped to a form with class "uset".
   The builds copy this block into each settings page where the marker below stands. Unraid 7 lays every dd out as a flex column:
   overridden here for these forms only. */
.uset h3{display:flex;justify-content:space-between;align-items:center;gap:10px;background:rgba(0,0,0,.25);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:9px 12px;margin:26px 0 8px;line-height:1.4}
.uset h3:first-child{margin-top:6px}
.uset h3 small{font-weight:400;opacity:.55;text-transform:none;letter-spacing:0}
.uset dl{display:grid;grid-template-columns:minmax(200px,300px) minmax(0,1fr);gap:0;margin:0;padding:0;background:rgba(128,128,128,.12)}
.uset dl dt,.uset dl dd{float:none;width:auto;margin:0;padding:9px 12px;border-top:1px solid rgba(128,128,128,.22);text-align:left;line-height:1.5}
.uset dl dt{opacity:.75;font-weight:normal}
.uset dl dt:first-child,.uset dl dt:first-child+dd{border-top:0}
.uset dl dd{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px 12px}
.uset dl dd>[class*="-mut"],.uset dl dd>.uset-hint,.uset dl dd>.uset-brk,.uset dl dd>div,.uset dl dd>p{flex:1 1 100%;margin:0}
.uset dl dd>[class*="-mut"],.uset dl dd>.uset-hint{opacity:.55;font-size:12px;max-width:120ch}
.uset dl dd>.uset-brk{height:0}
.uset dd input,.uset dd select,.uset dd textarea{margin:0;max-width:100%}
.uset dd select{width:auto!important;min-width:110px}
.uset dd input.narrow{width:110px!important;min-width:0}
.uset dd input[type=checkbox]{width:auto!important;margin:0 4px 0 0}
.uset dd label{display:inline-flex;align-items:center;gap:4px}
.uset dd input[type=button]{margin:0}
.uset dl.uset-save{background:none;margin-top:14px}
.uset dl.uset-save dt,.uset dl.uset-save dd{border-top:0}
.uset .uset-ok{color:#3fa24a}.uset .uset-er{color:#e5534b}
@media (max-width:760px){.uset dl{grid-template-columns:1fr}.uset dl dd{border-top:0;padding-top:0}}
</style>
<form id="qbt-form" class="uset" method="POST" action="/plugins/qbittorrent_widget/save.php" onsubmit="return false;">
<input type="hidden" name="csrf_token" value="<?=qbt_h($qbt_tok)?>">
<h3><span>qBittorrent connection</span><small id="qbt-conn"></small></h3>
<dl>
<dt>Address and Web UI port:</dt>
<dd><input type="text" name="host" class="narrow" value="<?=qbt_h($qbt['host'])?>"> <input type="number" name="port" min="1" max="65535" class="narrow" value="<?=qbt_h($qbt['port'])?>"><span class="uset-hint">as seen from Unraid; 127.0.0.1 when qBittorrent runs in a container on this server with its port published</span></dd>

<dt>Username and password:</dt>
<dd><input type="text" name="user" class="narrow" autocomplete="off" value="<?=qbt_h($qbt['user'])?>"> <input type="password" name="pass" class="narrow" autocomplete="new-password" value="" placeholder="<?=$qbt['pass'] !== '' ? '(saved)' : 'password'?>"><span class="uset-hint">the saved password is not sent to the page: leave it empty to keep it, type - to remove it; no double quotes</span></dd>

<dt>Web UI link (optional):</dt>
<dd><input type="text" name="webui_url" placeholder="http://192.168.1.10:8080" value="<?=qbt_h($qbt['webui_url'])?>" style="width:320px"><span class="uset-hint">the home icon of the tile opens this; empty = this server's address with the Web UI port</span></dd>

<dt>Check:</dt>
<dd><input type="button" id="qbt-test" value="Test the connection"> <span id="qbt-tmsg"></span><span class="uset-hint">tests the saved settings (Apply first after a change)</span></dd>
</dl>

<h3><span>Tile rows</span><small>In transfer and Needs attention</small></h3>
<dl>
<dt>Most rows shown:</dt>
<dd>In transfer <input type="number" name="rows" min="1" max="50" class="narrow" value="<?=qbt_h($qbt['rows'])?>"> Needs attention <input type="number" name="max_attention" min="1" max="50" class="narrow" value="<?=qbt_h($qbt['max_attention'])?>"><span class="uset-hint">more rows are counted in the band title</span></dd>

<dt>Columns:</dt>
<dd><input type="hidden" name="show_bar" value="0"><label><input type="checkbox" name="show_bar" value="1" <?=qbt_chk($qbt['show_bar'])?>> progress bar under the name</label>
<input type="hidden" name="col_dl" value="0"><label><input type="checkbox" name="col_dl" value="1" <?=qbt_chk($qbt['col_dl'])?>> Down</label>
<input type="hidden" name="col_ul" value="0"><label><input type="checkbox" name="col_ul" value="1" <?=qbt_chk($qbt['col_ul'])?>> Up</label>
<input type="hidden" name="col_eta" value="0"><label><input type="checkbox" name="col_eta" value="1" <?=qbt_chk($qbt['col_eta'])?>> ETA</label><span class="uset-hint">the torrent name column is always shown</span></dd>
</dl>

<dl class="uset-save">
<dt>&nbsp;</dt>
<dd>
  <input type="button" id="qbt-save" value="Apply">
  <input type="button" value="Done" onclick="if (typeof done === 'function') { done(); } else { history.back(); }">
  <span id="qbt-msg"></span>
</dd>
</dl>
</form>

<p><a href="/Settings/SeedboxTools">Seedbox Tools</a>: find torrents for files that are not seeded, and replace big titles with smaller releases through Radarr and Sonarr.</p>

<p style="opacity:.55;font-size:12px;max-width:130ch">Stalled torrents are ignored: an idle seed that nobody downloads from is normal in qBittorrent. Errors, missing files, paused or stopped and queued torrents are listed under Needs attention; torrents that are moving, checking or allocating appear under In transfer. When the client is firewalled or disconnected, a single connection row is shown.</p>

<script>
$(function () {
  var $msg = $('#qbt-msg');
  function qbtCheck(show) {
    var $t = $('#qbt-tmsg'); if (show) { $t.attr('class', '').text('Testing...'); }
    $.getJSON('/plugins/qbittorrent_widget/api_fetch.php', {_: Date.now()}).done(function (r) {
      var why = {unreachable: 'cannot reach qBittorrent (address or port)', auth: 'the username or password is wrong', bad_response: 'unexpected answer'};
      if (r && r.ok) {
        var n = r.counts ? r.counts.total || 0 : 0, t = (r.conn || 'connected') + ' \u00b7 ' + n + ' torrents';
        $('#qbt-conn').attr('class', 'uset-ok').text(t); if (show) { $t.attr('class', 'uset-ok').text('ok, ' + n + ' torrents, ' + (r.conn || 'connected')); }
      } else {
        var e = r && r.error ? (why[r.error] || r.error) : 'no answer';
        $('#qbt-conn').attr('class', 'uset-er').text(e); if (show) { $t.attr('class', 'uset-er').text(e); }
      }
    }).fail(function (x) { if (show) { $t.attr('class', 'uset-er').text('HTTP ' + x.status); } });
  }
  $('#qbt-test').on('click', function () { qbtCheck(true); });
  qbtCheck(false);
  $('#qbt-save').on('click', function () {
    var $b = $(this).prop('disabled', true);
    $msg.css('color', '').text('Saving...');
    $.post('/plugins/qbittorrent_widget/save.php', $('#qbt-form').serialize(), null, 'json')
      .done(function (r) {
        if (r && r.ok) {
          $msg.css('color', '#3fa24a').text('Saved. The dashboard picks it up within a few seconds.'); qbtCheck(false);
        } else {
          var e = (r && r.error) ? r.error : 'unknown error';
          if (e === 'quote_not_allowed') { e = 'double quotes are not allowed in the username or password'; }
          $msg.css('color', '#e5534b').text('Not saved: ' + e);
        }
      })
      .fail(function (x) {
        var e = (x.responseJSON && x.responseJSON.error) ? x.responseJSON.error : 'HTTP ' + x.status;
        $msg.css('color', '#e5534b').text('Not saved: ' + e);
      })
      .always(function () { $b.prop('disabled', false); });
  });
});
</script>
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- LOCALHOST API REVERSE PROXY                                -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/api_fetch.php">
<INLINE><![CDATA[<?php
header('Content-Type: application/json');
header('Cache-Control: no-store');

$cfg = [
    'host' => '127.0.0.1', 'port' => '8080', 'user' => '', 'pass' => '', 'webui_url' => '',
    'rows' => '6', 'max_attention' => '15', 'show_bar' => '1',
    'col_dl' => '1', 'col_ul' => '1', 'col_eta' => '1',
];
$file = '/boot/config/plugins/qbittorrent_widget/settings.cfg';
if (is_file($file)) {
    $c = @parse_ini_file($file, false, INI_SCANNER_RAW); // RAW: a password may hold ${...} or backslashes; the normal mode would expand them
    if (is_array($c)) { $cfg = array_merge($cfg, $c); }
}

function qbt_flag($v) {
    return !in_array(strtolower(trim((string)$v)), ['0', 'no', 'false', 'off', ''], true);
}

function qbt_dur($s) {
    $s = max(0, (int)$s);
    $d = intdiv($s, 86400);
    $h = intdiv($s % 86400, 3600);
    $m = intdiv($s % 3600, 60);
    if ($d > 0) { return $d . 'd ' . $h . 'h'; }
    if ($h > 0) { return $h . 'h ' . str_pad((string)$m, 2, '0', STR_PAD_LEFT) . 'm'; }
    if ($m > 0) { return $m . 'm'; }
    return $s . 's';
}

$host = preg_match('/^[A-Za-z0-9.\-]+$/', (string)$cfg['host']) ? $cfg['host'] : '127.0.0.1';
$port = (int)$cfg['port'];
if ($port < 1 || $port > 65535) { $port = 8080; }
$rows     = max(1, min(50, (int)$cfg['rows']));
$maxAtt   = max(1, min(50, (int)$cfg['max_attention']));
$webui    = trim((string)$cfg['webui_url']);
if (!preg_match('#^https?://[^\s"<>]+$#i', $webui)) { $webui = ''; }

$base = "http://$host:$port";
require_once __DIR__ . '/moveprog.php';
$jar  = '/tmp/qbt_widget_cookie.txt';

// UI preferences are returned with every response, even errors
$ui = [
    'cols' => [
        'dl'  => qbt_flag($cfg['col_dl']),
        'ul'  => qbt_flag($cfg['col_ul']),
        'eta' => qbt_flag($cfg['col_eta']),
    ],
    'bar'  => qbt_flag($cfg['show_bar']),
    'port' => $port,
    'url'  => $webui,
];

function out($arr) {
    global $ui;
    $arr['ui'] = $ui;
    echo json_encode($arr, JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_UNICODE);
    exit;
}

function qbt($url, $base, $jar, $post = null) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_CONNECTTIMEOUT => 3,
        CURLOPT_TIMEOUT        => 3,
        CURLOPT_COOKIEJAR      => $jar,
        CURLOPT_COOKIEFILE     => $jar,
        CURLOPT_HTTPHEADER     => ['Referer: ' . $base, 'Origin: ' . $base],
    ]);
    if ($post !== null) {
        curl_setopt($ch, CURLOPT_POST, true);
        curl_setopt($ch, CURLOPT_POSTFIELDS, $post);
    }
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err  = curl_errno($ch);
    curl_close($ch);
    @chmod($jar, 0600);
    return [$body, $code, $err];
}

$did_login = false;

// GET an API path; logs in on 401/403 and retries once. After a failed login it backs
// off for 5 minutes, because qBittorrent bans clients after repeated failed logins.
function qbt_api($path) {
    global $base, $jar, $cfg, $did_login;
    $mark = '/tmp/qbt_widget_authfail';
    $sig  = md5($cfg['user'] . '|' . $cfg['pass'] . '|' . $base);

    list($b, $c, $e) = qbt($base . $path, $base, $jar);
    if ($e || ($c !== 401 && $c !== 403)) { return [$b, $c, $e]; }
    if ($cfg['user'] === '') { return ['', 403, 0]; }
    if (is_file($mark) && trim((string)@file_get_contents($mark)) === $sig && (time() - (int)@filemtime($mark)) < 300) {
        return ['', 403, 0];
    }
    if ($did_login) { return ['', 403, 0]; }
    $did_login = true;

    list($lb, $lc, $le) = qbt($base . '/api/v2/auth/login', $base, $jar,
        http_build_query(['username' => $cfg['user'], 'password' => $cfg['pass']]));
    if ($le) { return ['', 0, $le]; }
    if ($lc !== 200 || trim((string)$lb) !== 'Ok.') {
        @file_put_contents($mark, $sig);
        @chmod($mark, 0600);
        return ['', 403, 0];
    }
    @unlink($mark);
    return qbt($base . $path, $base, $jar);
}

// ---- Fetch ------------------------------------------------------------
list($body, $code, $err) = qbt_api('/api/v2/torrents/info');
if ($err) { out(['ok' => false, 'error' => 'unreachable']); }
if ($code === 401 || $code === 403) { out(['ok' => false, 'error' => 'auth']); }
if ($code !== 200) { out(['ok' => false, 'error' => 'http_' . $code]); }

$data = json_decode((string)$body, true);
if (!is_array($data)) { out(['ok' => false, 'error' => 'bad_response']); }

// Connection status + global speeds (ignore failures)
$conn = null;
$global = null;
list($gb, $gc, $ge) = qbt_api('/api/v2/transfer/info');
if (!$ge && $gc === 200) {
    $g = json_decode((string)$gb, true);
    if (is_array($g)) {
        $conn   = isset($g['connection_status']) ? (string)$g['connection_status'] : null;
        $global = ['dl' => (int)($g['dl_info_speed'] ?? 0), 'ul' => (int)($g['up_info_speed'] ?? 0)];
    }
}
// ---- Classify ---------------------------------------------------------
$now = time();
$att = [];
$xfer = [];
$counts = ['total' => 0, 'seeding' => 0, 'downloading' => 0, 'busy' => 0];

foreach ($data as $t) {
    $state = (string)($t['state'] ?? '');
    $name  = (string)($t['name'] ?? '?');
    $hash  = (string)($t['hash'] ?? '');
    $prog  = (float)($t['progress'] ?? 0);
    $dl    = (int)($t['dlspeed'] ?? 0);
    $up    = (int)($t['upspeed'] ?? 0);
    if ($dl < 50) { $dl = 0; }   // a few bytes per second is protocol chatter, not a transfer
    if ($up < 50) { $up = 0; }
    $counts['total']++;

    $issue = null;   // [severity, kind, badge, reason]
    switch ($state) {
        case 'error':
            $issue = ['red', 'error', 'Error', 'Torrent is in an error state'];
            break;
        case 'missingFiles':
            $issue = ['red', 'missing', 'Missing', 'Files missing on disk'];
            break;
        case 'pausedUP':
        case 'stoppedUP':
            $issue = ['red', 'paused', ($state === 'pausedUP') ? 'Paused' : 'Stopped', 'Not seeding'];
            break;
        case 'pausedDL':
        case 'stoppedDL':
            $issue = ['red', 'paused', ($state === 'pausedDL') ? 'Paused' : 'Stopped', 'Download not running'];
            break;
        case 'queuedDL':
        case 'queuedUP':
            $issue = ['amber', 'queued', 'Queued', 'Waiting for a slot'];
            break;
        case 'unknown':
            $issue = ['red', 'unknown', 'Unknown', 'Unknown state'];
            break;
    }

    if ($issue !== null) {
        $att[] = ['name' => $name, 'sev' => $issue[0], 'kind' => $issue[1], 'badge' => $issue[2],
                  'reason' => $issue[3], 'hash' => $hash];
        continue;
    }

    // Healthy: counted, and listed only while actually moving data
    if (in_array($state, ['uploading', 'stalledUP', 'forcedUP'], true)) { $counts['seeding']++; }
    if (in_array($state, ['downloading', 'forcedDL', 'metaDL', 'forcedMetaDL', 'stalledDL'], true)) { $counts['downloading']++; }

    $busyLabel = null;
    if (in_array($state, ['checkingDL', 'checkingUP', 'checkingResumeData'], true)) { $busyLabel = 'Checking'; }
    elseif ($state === 'moving') { $busyLabel = 'Moving'; }
    elseif ($state === 'allocating') { $busyLabel = 'Allocating'; }
    if ($busyLabel !== null) {
        $counts['busy']++;
        $bp = $prog; $be = 8640000; $bw = false;
        if ($state === 'moving') { [$bp, $be, $bw] = st_move_info($t); if ($be < 0) { $be = 8640000; } } // a move has no percentage of its own: measured at the destination
        $xfer[] = [
            'name'      => $name,
            'progress'  => $bp,
            'dl'        => 0,
            'ul'        => 0,
            'eta'       => $be,
            'size'      => (int)($t['size'] ?? 0),
            'completed' => (int)($t['completed'] ?? 0),
            'dir'       => 'busy',
            'label'     => $busyLabel,
            'wait'      => $bw,
        ];
        continue;
    }

    if ($dl > 0 || $up > 0) {
        $xfer[] = [
            'name'      => $name,
            'progress'  => $prog,
            'dl'        => $dl,
            'ul'        => $up,
            'eta'       => (int)($t['eta'] ?? 8640000),
            'size'      => (int)($t['size'] ?? 0),
            'completed' => (int)($t['completed'] ?? 0),
            'dir'       => ($dl > 0) ? 'down' : 'up',
        ];
    }
}

$tools = []; $rep = [];
// Season Repacker: seasons being replaced by a season pack (a row while it runs, and for 15 minutes after it is done)
$wd0 = getenv('DBX_ST_DIR'); $wd0 = ($wd0 !== false && $wd0 !== '') ? $wd0 : '/boot/config/plugins/qbittorrent_widget';
$sf0 = getenv('DBX_ST_DIR') ? $wd0 . '/tools_state_live.json' : '/tmp/qbt_tools_state.json'; if (!is_file($sf0)) { $sf0 = $wd0 . '/tools_state.json'; } // the live copy has the fresh progress; the flash copy after a reboot
$ws0 = is_file($sf0) ? json_decode((string)@file_get_contents($sf0), true) : null;
if (is_array($ws0)) {
    $byh = []; foreach ($data as $t) { $byh[strtolower((string)($t['hash'] ?? ''))] = $t; }
    $lbl = ['grabbed' => 'Queued', 'downloading' => 'Downloading', 'importing' => 'Importing', 'imported' => 'Finishing', 'done' => 'Repacked', 'blocked' => 'Stuck'];
    foreach (array_reverse((array)($ws0['packjobs'] ?? [])) as $pj) {
        $st = (string)($pj['stage'] ?? ''); $fin = in_array($st, ['done', 'failed'], true);
        if ($fin && ($st === 'failed' || time() - (int)($pj['t'] ?? 0) > 900)) { continue; }
        $nm = $pj['title'] . ' S' . str_pad((string)(int)$pj['season'], 2, '0', STR_PAD_LEFT);
        $pt = $byh[strtolower((string)($pj['hash'] ?? ''))] ?? null;
        $pp = $st === 'done' || $st === 'imported' || $st === 'importing' ? 1.0 : ($pt ? (float)$pt['progress'] : 0.0);
        $pw = false; if ($pt && (string)$pt['state'] === 'moving') { [$pp, $pe, $pw] = st_move_info($pt); }
        $badge = $lbl[$st] ?? $st; $col = ['grabbed' => 'grey', 'downloading' => 'orange', 'importing' => 'blue', 'imported' => 'blue', 'done' => 'green', 'blocked' => 'red'][$st] ?? 'grey';
        if ($pt && (string)$pt['state'] === 'moving' && in_array($st, ['grabbed', 'downloading'], true)) { $badge = 'Moving'; $col = 'grey'; }
        $why = $nm;
        if ($pt && in_array($st, ['grabbed', 'downloading'], true)) { $why .= $pw ? ' · waiting to move' : ' · ' . number_format($pp * 100, 1, '.', '') . '%'; }
        elseif ($st === 'importing') { $why .= ': season files deleted, waiting for Sonarr'; }
        elseif ($st === 'blocked') { $why .= ': ' . (string)($pj['msg'] ?? ''); }
        $rep[] = ['name' => 'Season Repacker', 'col' => $col, 'badge' => $badge, 'reason' => $why,
            'tip' => $fin ? $nm . ' is repacked by Season Repacker' : $nm . ' is being repacked by Season Repacker', 'href' => '/Settings/SeedboxTools#stt-t-rep'];
    }
}

// ---- Needs attention: sort, connection row, cap ------------------------
usort($att, function ($a, $b) {
    if ($a['sev'] !== $b['sev']) { return ($a['sev'] === 'red') ? -1 : 1; }
    return strcasecmp($a['name'], $b['name']);
});

// Hash is not needed by the browser
foreach ($att as $i => $a) { unset($att[$i]['hash']); }

usort($att, function ($a, $b) {
    if ($a['sev'] !== $b['sev']) { return ($a['sev'] === 'red') ? -1 : 1; }
    return 0;
});

if ($conn === 'firewalled') {
    array_unshift($att, ['name' => 'qBittorrent connection', 'sev' => 'amber', 'kind' => 'conn',
        'badge' => 'Firewalled', 'reason' => 'Incoming port not reachable, check port forwarding']);
} elseif ($conn === 'disconnected') {
    array_unshift($att, ['name' => 'qBittorrent connection', 'sev' => 'red', 'kind' => 'disc',
        'badge' => 'Disconnected', 'reason' => 'No connection to the network']);
}

// ---- Seedbox tools block: three permanent rows (Find my torrent, Shape up (was Update me), Season Repacker) -----------------------
$wdir = getenv('DBX_ST_DIR'); $wdir = ($wdir !== false && $wdir !== '') ? $wdir : '/boot/config/plugins/qbittorrent_widget';
$wst = is_file($sf0) ? json_decode((string)@file_get_contents($sf0), true) : null;
if (!is_array($wst)) { $wst = []; }
$tcfg = is_file($wdir . '/tools.json') ? json_decode((string)@file_get_contents($wdir . '/tools.json'), true) : null; if (!is_array($tcfg)) { $tcfg = []; }
$tagOf = function ($k, $def) use ($tcfg) { $v = trim((string)($tcfg[$k] ?? '')); return $v !== '' ? mb_substr($v, 0, 60) : $def; };
$jr = function ($f) { $x = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null; return is_array($x) ? $x : []; };
$ago = function ($t) {
    $d = time() - (int)$t; if ($t <= 0) { return ''; }
    if ($d < 90) { return 'just now'; } if ($d < 5400) { return round($d / 60) . ' min ago'; }
    if ($d < 129600) { return round($d / 3600) . ' h ago'; } return round($d / 86400) . ' days ago';
};
$locked = function ($n) { $f = @fopen('/tmp/qbt_tools_' . $n . '.lock', 'c'); if (!$f) { return false; } $l = !flock($f, LOCK_EX | LOCK_NB); if (!$l) { flock($f, LOCK_UN); } fclose($f); return $l; };
$running = function ($f) { return (($f['state'] ?? '') === 'running' && time() - (int)($f['t'] ?? 0) < 1800) ? (string)($f['msg'] ?? '') : null; };
$have = []; foreach ($data as $t) { $have[strtolower((string)($t['hash'] ?? ''))] = true; }
// Find my torrent: problems of the last scan (live from the result list when it is still there, else the saved summary)
$fnd = $jr('/tmp/qbt_tools_find.json'); $fs = (array)($wst['sum']['find'] ?? []); $ft = (int)($fs['t'] ?? ($wst['watch']['t'] ?? 0));
$fr = 0; $fn = 0; $fp = 0; $fknown = false;
if (($fnd['state'] ?? '') === 'ready' && isset($fnd['items']) && is_array($fnd['items'])) {
    $fknown = true; $ft = max($ft, (int)($fnd['t'] ?? 0));
    foreach ($fnd['items'] as $it) {
        if (isset($it['path']) && !file_exists((string)$it['path'])) { continue; }
        if (!empty($it['pass'])) { $fp++; }
        elseif (!empty($it['old'])) { if (isset($have[strtolower((string)$it['old'])])) { $fr++; } }
        else { $fn++; }
    }
} elseif ($fs || !empty($wst['watch']['t'])) {
    $fknown = true;
    foreach ((array)($wst['watch']['removed'] ?? []) as $g) { if (isset($have[strtolower((string)($g['hash'] ?? ''))])) { $fr++; } }
    $fn = (int)($fs['nosd'] ?? 0); $fp = (int)($fs['pass'] ?? 0);
}
$ftot = $fr + $fn + $fp; $parts = [];
if ($fr) { $parts[] = $fr . ' removed from tracker'; } if ($fn) { $parts[] = $fn . ' not seeded'; } if ($fp) { $parts[] = $fp . ' passkey'; }
if (($rm = $running($fnd)) !== null) { $fb = ['Scanning', 'orange', $rm, '']; }
elseif (!$fknown) { $fb = ['Not scanned yet', 'grey', '']; }
elseif ($ftot > 0) { $fb = [$ftot . ' to fix', 'amber', implode(' · ', $parts), 'scanned ' . $ago($ft)]; }
else { $fb = ['All seeded', 'grey', 'scanned ' . $ago($ft)]; }
$tools[] = ['_k' => 'find', '_rel' => $fb[1] !== 'grey' || !$fknown, '_t' => $ft, 'name' => 'Find my torrent', 'tag' => $tagOf('tag_find', 'keeps your seed healthy 😉'), 'tagtip' => 'keeps every file seeding · no file left unseeded',
    'col' => $fb[1], 'badge' => $fb[0], 'reason' => $fb[2], 'when' => $fb[3] ?? '', 'tip' => 'Open Seedbox Tools, Find my torrent', 'href' => '/Settings/SeedboxTools#stt-t-find'];
// Update me
$ucol = 'grey'; $uwhen = '';
$ud = $jr('/tmp/qbt_tools_upd.json'); $us = (array)($wst['sum']['upd'] ?? []);
if (($ud['state'] ?? '') === 'ready' && isset($ud['items']) && is_array($ud['items'])) { $un = count($ud['items']); $ut = max((int)($us['t'] ?? 0), (int)($ud['t'] ?? 0)); }
elseif ($us) { $un = (int)($us['n'] ?? 0); $ut = (int)($us['t'] ?? 0); } else { $un = -1; $ut = 0; }
if (($rm = $running($ud)) !== null) { $ub = ['Scanning', $rm]; $ucol = 'orange'; }
elseif ($un < 0) { $ub = ['Not scanned yet', '']; }
elseif ($un > 0) {
    // the offers come from the background search: torrents of the list with a release that is smaller, a better HDR format or a higher resolution
    $ures = $jr('/tmp/qbt_tools_res.json'); $uoff = 0; $udone = 0;
    foreach ((array)($ud['items'] ?? []) as $ux) {
        $rr = $ures[$ux['hash'] ?? ''] ?? null;
        if (!is_array($rr) || ($rr['state'] ?? '') !== 'ready') { continue; }
        $udone++;
        foreach ((array)($rr['rows'] ?? []) as $rw) { if (!empty($rw['cats']) && ((int)($rw['res'] ?? 0) > 0 || (int)($ux['cur_res'] ?? 0) <= 0)) { $uoff++; break; } }
    }
    $ub = $udone > 0 ? [$uoff . ' offer' . ($uoff === 1 ? '' : 's'), 'searched ' . $udone . ' of ' . $un] : [$un . ' to search', 'scanned ' . $ago($ut)];
    if ($udone > 0 && $ut > 0) { $uwhen = 'scanned ' . $ago($ut); } // the reason line shows the search, the scan time goes under it
    if ($uoff > 0) { $ucol = 'green'; }
    elseif ($udone < $un && $locked('updbg')) { $ub = ['Scanning', 'searched ' . $udone . ' of ' . $un]; $ucol = 'orange'; } // the background search is running
}
else { $ub = ['Nothing to shape up', 'scanned ' . $ago($ut)]; }
$tools[] = ['_k' => 'upd', '_rel' => $ucol !== 'grey' || $un < 0, '_t' => $ut, 'name' => 'Shape up', 'tag' => $tagOf('tag_upd', 'slimmer or stronger, in better shape'), 'tagtip' => 'smaller, better HDR or higher resolution · never a lower quality',
    'col' => $ucol ?? 'grey', 'badge' => $ub[0], 'reason' => $ub[1], 'when' => $uwhen, 'tip' => 'Open Seedbox Tools, Shape up', 'href' => '/Settings/SeedboxTools#stt-t-upd'];
// Season Repacker: the running / finished jobs, or the idle line
if ($rep) { $rep[0]['tag'] = $tagOf('tag_rep', 'keeps your data tidy'); $rep[0]['tagtip'] = 'one torrent per season · keeps seasons in one piece'; foreach ($rep as $r) { $tools[] = array_merge(['_k' => 'rep', '_rel' => true, '_t' => time()], $r); } }
else {
    $sp = $jr('/tmp/qbt_tools_sp.json'); $rs = (array)($wst['sum']['rep'] ?? []);
    if (($sp['state'] ?? '') === 'ready' && empty($sp['filter']) && isset($sp['items']) && is_array($sp['items'])) { $rn = count($sp['items']); $rt = max((int)($rs['t'] ?? 0), (int)($sp['t'] ?? 0)); }
    elseif ($rs) { $rn = (int)($rs['n'] ?? 0); $rt = (int)($rs['t'] ?? 0); } else { $rn = -1; $rt = 0; }
    // packs from autobrr waiting for a click (item 6): rows of sp_ab.json not dismissed, younger than 7 days, not being replaced
    $abBusy = []; foreach ((array)($wst['packjobs'] ?? []) as $pj) { if (($pj['stage'] ?? '') !== 'failed') { $abBusy[$pj['key'] ?? ''] = 1; } }
    $abIt = array_values(array_filter((array)($jr($wdir . '/sp_ab.json')['items'] ?? []), function ($x) use ($abBusy) { return empty($x['dismissed']) && time() - (int)($x['t'] ?? 0) < 7 * 86400 && !isset($abBusy[$x['key'] ?? '']); }));
    usort($abIt, function ($a, $b) { return (int)$b['t'] <=> (int)$a['t']; });
    $abN = count($abIt); $abNames = array_map(function ($x) { return $x['title'] . ' S' . str_pad((string)$x['season'], 2, '0', STR_PAD_LEFT); }, array_slice($abIt, 0, 2));
    if (($rm = $running($sp)) !== null) { $rb = ['Scanning', 'orange', $rm]; }
    elseif ($abN > 0) { $rb = [$abN . ' pack' . ($abN === 1 ? '' : 's') . ' from autobrr', 'green', implode(' · ', $abNames) . ($abN > 2 ? ' · +' . ($abN - 2) : ''), 'latest ' . $ago((int)$abIt[0]['t'])]; }
    elseif ($rn < 0) { $rb = ['Not scanned yet', 'grey', '']; } elseif ($rn > 0) { $rb = [$rn . ' season' . ($rn === 1 ? '' : 's') . ' can be repacked', 'grey', 'scanned ' . $ago($rt)]; } else { $rb = ['Nothing to repack', 'grey', 'scanned ' . $ago($rt)]; }
    $tools[] = ['_k' => 'rep', '_rel' => $rb[1] !== 'grey' || $rn != 0, '_t' => $rt, 'name' => 'Season Repacker', 'tag' => $tagOf('tag_rep', 'keeps your data tidy'), 'tagtip' => 'one torrent per season · keeps seasons in one piece',
        'col' => $rb[1], 'badge' => $rb[0], 'reason' => $rb[2], 'when' => $rb[3] ?? '', 'tip' => 'Open Seedbox Tools, Season repacker', 'href' => '/Settings/SeedboxTools#stt-t-rep'];
}

// which rows show (item 54, Seedbox Tools settings 'Show on the Dashboard'): always / only when relevant (something to do,
// a scan running, never scanned) / for N days after a scan (or when relevant) / never. A red or amber row shows in every mode but never.
$tools = array_values(array_filter($tools, function ($x) use ($tcfg) {
    $k = $x['_k'] ?? ''; $m = (string)($tcfg['show_' . $k] ?? 'relevant');
    if ($m === 'never') { return false; }
    if ($m === 'always' || !empty($x['_rel']) || in_array($x['col'] ?? '', ['red', 'amber'], true)) { return true; }
    return $m === 'days' && time() - (int)($x['_t'] ?? 0) < 86400 * max(1, (int)($tcfg['show_' . $k . '_days'] ?? 3));
}));
foreach ($tools as &$x) { unset($x['_k'], $x['_rel'], $x['_t']); } unset($x);

$attTotal = count($att);
$attMore  = max(0, $attTotal - $maxAtt);
$att      = array_slice($att, 0, $maxAtt);

// ---- In transfer: downloads first, then busiest uploads -----------------
$rank = ['down' => 0, 'busy' => 1, 'up' => 2];
usort($xfer, function ($a, $b) use ($rank) {
    if ($a['dir'] !== $b['dir']) { return $rank[$a['dir']] <=> $rank[$b['dir']]; }
    return ($b['dl'] + $b['ul']) <=> ($a['dl'] + $a['ul']);
});
$sumDl = 0;
$sumUl = 0;
foreach ($xfer as $xr) { $sumDl += $xr['dl']; $sumUl += $xr['ul']; }
$global = [
    'dl' => max($sumDl, (int)($global['dl'] ?? 0)),
    'ul' => max($sumUl, (int)($global['ul'] ?? 0)),
];
$xferTotal = count($xfer);
$more      = max(0, $xferTotal - $rows);
$xfer      = array_slice($xfer, 0, $rows);

out([
    'ok'              => true,
    'conn'            => $conn,
    'global'          => $global,
    'counts'          => $counts,
    'attention'       => $att,
    'attention_total' => $attTotal,
    'attention_more'  => $attMore,
    'transfer'        => $xfer,
    'tools'           => $tools,
    'not_seeded'      => $fknown ? $fn : -1,   // folders in the downloads folders that no torrent seeds (last Find my torrent scan)
    'transfer_total'  => $xferTotal,
    'more'            => $more,
]);
]]></INLINE>
</FILE>

<!-- ========================================================= -->
<!-- SETTINGS SAVE ENDPOINT                                     -->
<!-- ========================================================= -->
<FILE Name="&plugdir;/save.php">
<INLINE><![CDATA[<?php
header('Content-Type: application/json');
header('Cache-Control: no-store');

function qbt_out($ok, $extra = []) {
    echo json_encode(array_merge(['ok' => $ok], $extra));
    exit;
}

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { http_response_code(405); qbt_out(false, ['error' => 'method']); }

// CSRF: Unraid's own prepend script already validates the csrf_token of every POST and then removes it
// from $_POST. If a token is still present, check it; otherwise require an AJAX request, which a
// cross-site form post cannot fake.
$var  = @parse_ini_file('/var/local/emhttp/var.ini');
$tok  = is_array($var) ? (string)($var['csrf_token'] ?? '') : '';
$sent = (string)($_POST['csrf_token'] ?? '');
if ($sent !== '') {
    if ($tok === '' || !hash_equals($tok, $sent)) {
        http_response_code(403);
        qbt_out(false, ['error' => 'csrf token mismatch (var.ini token ' . ($tok !== '' ? 'present' : 'missing') . ')']);
    }
} elseif (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') {
    http_response_code(403);
    qbt_out(false, ['error' => 'csrf: token removed and request is not AJAX']);
}

$dir  = '/boot/config/plugins/qbittorrent_widget';
$file = $dir . '/settings.cfg';
$old  = is_file($file) ? @parse_ini_file($file, false, INI_SCANNER_RAW) : [];
if (!is_array($old)) { $old = []; }

function qbt_int($v, $min, $max, $def) { $i = (int)$v; return ($i < $min || $i > $max) ? $def : $i; }
function qbt_bool($v) { return in_array(strtolower(trim((string)$v)), ['1', 'yes', 'true', 'on'], true) ? '1' : '0'; }
function qbt_clean($v) { return substr(str_replace(["\r", "\n", "\0"], '', (string)$v), 0, 200); }

$user = qbt_clean($_POST['user'] ?? '');
$pass = qbt_clean($_POST['pass'] ?? '');
// the page does not get the saved password: empty keeps it, - removes it
if ($pass === '') { $pass = (string)(is_array($old) ? ($old['pass'] ?? '') : ''); } elseif ($pass === '-') { $pass = ''; }
if (strpos($user, '"') !== false || strpos($pass, '"') !== false) { qbt_out(false, ['error' => 'quote_not_allowed']); }

$host = trim((string)($_POST['host'] ?? '127.0.0.1'));
if (!preg_match('/^[A-Za-z0-9.\-]+$/', $host)) { $host = '127.0.0.1'; }

$url = trim(qbt_clean($_POST['webui_url'] ?? ''));
if ($url !== '' && !preg_match('#^https?://[^\s"<>]+$#i', $url)) { qbt_out(false, ['error' => 'invalid Web UI link URL']); }

$new = [
    'host'          => $host,
    'port'          => (string)qbt_int($_POST['port'] ?? 8080, 1, 65535, 8080),
    'user'          => $user,
    'pass'          => $pass,
    'webui_url'     => $url,
    'rows'          => (string)qbt_int($_POST['rows'] ?? 6, 1, 50, 6),
    'max_attention' => (string)qbt_int($_POST['max_attention'] ?? 15, 1, 50, 15),
    'show_bar'      => qbt_bool($_POST['show_bar'] ?? '1'),
    'col_dl'        => qbt_bool($_POST['col_dl'] ?? '1'),
    'col_ul'        => qbt_bool($_POST['col_ul'] ?? '1'),
    'col_eta'       => qbt_bool($_POST['col_eta'] ?? '1'),
];

$text = '';
foreach ($new as $k => $v) { $text .= $k . '="' . $v . '"' . "\n"; }

if (!is_dir($dir)) { @mkdir($dir, 0755, true); }
$tmp = $file . '.tmp';
if (@file_put_contents($tmp, $text) === false) { qbt_out(false, ['error' => 'could not write the settings file']); }
@chmod($tmp, 0600);
if (!@rename($tmp, $file)) {
    // some filesystems refuse to replace an existing file: write in place instead
    $ok = @file_put_contents($file, $text);
    @unlink($tmp);
    if ($ok === false) { qbt_out(false, ['error' => 'could not replace the settings file']); }
}
@chmod($file, 0600);
@unlink('/tmp/qbt_widget_authfail');   // credentials may have changed: allow a fresh login attempt

$shown = $new;
unset($shown['pass']);
qbt_out(true, ['saved' => $shown]);
]]></INLINE>
</FILE>

