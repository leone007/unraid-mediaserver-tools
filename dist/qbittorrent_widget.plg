        else if (rrf.state === 'error') { h += '<tr class="stt-sub stt-rs"' + hid + '><td colspan="6" class="stt-er">&#8627; ' + esc(rrf.msg) + '</td></tr>'; }
        else if (!(rrf.rows || []).length) { h += '<tr class="stt-sub stt-rs"' + hid + '><td colspan="6" class="stt-mut">&#8627; ' + esc(rrf.msg || T('rs.none')) + '</td></tr>'; }
        else { if (rrf.info) { h += '<tr class="stt-sub stt-rs"' + hid + '><td colspan="6" class="stt-mut">&#8627; ' + esc(rrf.info) + '</td></tr>'; }
          $.each(rrf.rows, function (j, r) {
          var sv = r.saving > 0 ? '-' + r.saving + '%' : '+' + Math.abs(r.saving) + '%';
          h += '<tr class="stt-sub stt-rep stt-rs"' + hid + '><td class="stt-ell" title="' + esc(r.title + (r.rejected ? ' (' + r.rejections.join(' / ') + ')' : '')) + '">&#8627; ' + esc(r.title) + (r.hun ? '<span class="stt-badge g">HUN</span>' : '') + (r.rejected ? (rrf.item && rrf.item.kind === 'radarr' && r.rejections.length && $.grep(r.rejections, function (x) { return /cutoff|upgrade/i.test(x); }).length === r.rejections.length ? '<span class="stt-badge a" title="' + esc(r.rejections.join(' / ')) + '">' + esc(T('rs.do_radarr')) + '</span>' : '<span class="stt-badge a" title="' + esc(r.rejections.join(' / ')) + '">' + esc(T('q.rejected')) + '</span> <span class="stt-am">' + esc(r.rejections[0] || '') + '</span>') : '') + '</td><td class="stt-r">' + fb(r.size) + '</td><td class="stt-r">' + r.seeders + '</td><td class="stt-ell">' + esc(r.indexer) + '</td><td>' + r.res + 'p ' + hdrTxt(r.hdr) + ' <span class="stt-mut">' + sv + '</span></td><td class="stt-r"><input type="button" class="stt-grab stt-btn stt-sm" data-key="' + it.key + '" data-mode="repl" data-guid="' + esc(r.guid) + '" value="' + esc(T('rs.replace_this')) + '"></td></tr>';
        }); }
