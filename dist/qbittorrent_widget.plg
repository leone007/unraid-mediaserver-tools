    if (u.state === 'error') { $('#stt-umsg').css('color', '#e5534b').text(u.msg); return; }
    $('#stt-umsg').css('color', '').text(u.state === 'running' ? (u.msg || 'Working...') : '');
    if (!(u.items || []).length && u.state === 'ready') { $o.append('<p class="stt-mut">' + ((u.skipped || []).length ? 'Nothing to list.' : 'No torrent is big and old enough (see the thresholds above).') + '</p>'); }
    // the filter bar: name and the ticked offer kinds
