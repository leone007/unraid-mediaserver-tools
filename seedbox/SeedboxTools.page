          (it.skip === 'hidden' ? '<input type="button" class="stt-uhide stt-btn stt-sm" data-hash="' + it.hash + '" data-on="0" value="Show again">' : '') + '</td></tr>');
      });
      $o.append($d.append($tb).prop('open', !!wasOpen));
    }
  }
  $(document).on('click', '.stt-utg', function (e) {
    e.preventDefault(); var h = String($(this).data('hash')); UOPEN[h] = !UOPEN[h];
    $(this).html(UOPEN[h] ? '&minus;' : '+').closest('.stt-box').find('.stt-ures').toggle(UOPEN[h]);
  });
  $(document).on('click', '#stt-uforget', function () {
    if (!window.confirm('Forget every Shape up search result and search the whole list again?\n\nThe ' + (BG.total || 0) + ' torrents are searched again in the background, one about every 90 seconds (about ' + Math.max(1, Math.round((BG.total || 0) * 1.6 / 60)) + ' hours). Nothing is changed in qBittorrent, Radarr or Sonarr.')) { return; }
    var $b = $(this).prop('disabled', true);
    api('upd_forget').done(function (r) { if (!r.ok) { window.alert(r.error); $b.prop('disabled', false); return; } RES = {}; setTimeout(pollUpd, 1500); }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-umore', function () { var g = $(this).data('g'); ULIMG[g] = (ULIMG[g] || 25) + 50; drawUpd(); });
  $(document).on('click', '.stt-gbar:not(.empty)', function () {
    var g = String($(this).data('g')); UGOPEN[g] = !UGOPEN[g];
    $(this).find('.pm').html(UGOPEN[g] ? '&minus;' : '+'); $('#stt-uitems .stt-ugrp[data-g="' + g + '"]').toggle(UGOPEN[g]);
  });
  $(document).on('input', '#stt-uq', function () { ULIMG = {}; drawUpd(); });
  $(document).on('change', '.stt-ucat', function () { UCAT[this.value] = this.checked ? 1 : 0; ULIMG = {}; drawUpd(); });
  $(document).on('click', '#stt-ubgstop, #stt-ubggo', function () {
    var stop = this.id === 'stt-ubgstop'; $(this).prop('disabled', true);
    api('upd_bg', stop ? {stop: 1} : {}).done(function (r) { if (!r.ok) { window.alert(r.error); } setTimeout(pollUpd, 1500); }).fail(function (x) { window.alert(err(x)); });
  });
  $(document).on('click', '.stt-uhide', function () {
    var $b = $(this).prop('disabled', true);
    api('upd_hide', {hash: $b.data('hash'), on: $b.data('on')}).done(function (r) {
      if (!r.ok) { $b.prop('disabled', false); window.alert(r.error); return; }
      UPD = r.upd; drawUpd();
    }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  function pollUpd() {
    clearTimeout(uT);
    api('upd_get').done(function (r) {
      UPD = r.upd; RES = r.res || {}; BG = r.bg || {};
      // results saved by versions before 99h may hold releases of unknown resolution (0p): not an offer
      $.each(RES, function (h, x) { if (x && x.rows && x.item && +x.item.cur_res > 0) { x.rows = $.grep(x.rows, function (q) { return +q.res > 0; }); } });
      drawUpd(); var busy = UPD.state === 'running';
      $.each(RES, function (h, x) { if (x.state === 'running' && Date.now() / 1000 - x.t < 900) { busy = true; } });
      // the background search starts a moment after the scan has finished: keep looking while it runs or is about to start
      var soon = UPD.state === 'ready' && BG.total > BG.done && BG.state !== 'stopped' && Date.now() / 1000 - (UPD.t || 0) < 180;
      if (busy) { uT = setTimeout(pollUpd, 2500); } else { $('#stt-uscan').prop('disabled', false); if (BG.running || soon) { uT = setTimeout(pollUpd, BG.running ? 15000 : 4000); } }
    });
  }
  $('#stt-uscan').on('click', function () {
    $(this).prop('disabled', true); $('#stt-umsg').css('color', '').text('Starting...');
    api('upd_scan').done(function () { setTimeout(pollUpd, 800); }).fail(function (x) { $('#stt-uscan').prop('disabled', false); $('#stt-umsg').css('color', '#e5534b').text(err(x)); });
  });
  $(document).on('click', '.stt-find', function () {
    var $b = $(this).prop('disabled', true).val('Searching...'); UOPEN[String($b.data('hash'))] = true;
    api('upd_search', {hash: $b.data('hash')}).done(function () { setTimeout(pollUpd, 600); }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-grab', function () {
    var $b = $(this), repl = $b.data('mode') === 'repl';
    if (!window.confirm(repl ? 'Replace this content with the selected release?\n\nRadarr/Sonarr downloads and imports it. When the import is done, the OLD files (the folder in the downloads folder and its media link) are moved to the trash folder, or deleted if the trash is set to 0 days, and the old torrent is removed from qBittorrent (its files are not deleted by qBittorrent).' : 'Send this release to Radarr/Sonarr?\n\nIt is downloaded and imported as a replacement. Your current files are replaced only when the import happens; the old torrent stays until you remove it here.')) { return; }
    $b.prop('disabled', true);
    api('repl_grab', {key: $b.data('key'), guid: $b.data('guid')}).done(function (r) { if (r.ok) { loadState(); setTimeout(pollFind, 1500); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-force', function () {
    var $b = $(this);
    if (!window.confirm('Ask Radarr to import the downloaded file now?\n\nRadarr replaces the old file in the media folder with the new one. Use it when the job waits with "Not an upgrade". Afterwards the old files are cleaned up as usual.')) { return; }
    $b.prop('disabled', true);
    api('job_force', {id: $b.data('id')}).done(function (r) { if (r.ok) { loadState(); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-dis', function () {
    var $b = $(this); $b.prop('disabled', true);
    api('job_dismiss', {id: $b.data('id')}).done(function (r) { if (r.ok) { loadState(); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-rm', function () {
    var $b = $(this);
    if (!window.confirm('Remove the OLD torrent from qBittorrent and its whole folder?\n\nThe folder (video and everything with it: nfo, images, subtitles) goes to the trash folder and is deleted after the trash days (at once if they are 0). If another torrent seeds the same files, only the old torrent is removed. Do it only after you checked that the new version plays.')) { return; }
    $b.prop('disabled', true);
    api('upd_remove', {id: $b.data('id')}).done(function (r) { if (r.ok) { loadState(); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });

  // ---- season packs ----
  var SP = null, SPJ = [], spT = null, SPAB = [], SPABQ = 0, SPOPEN = false;
  function spName(x) { return esc(x.title) + ' S' + ('0' + x.season).slice(-2); }
  function drawSp() {
    var $o = $('#stt-spitems').empty(), $j = $('#stt-spjobs').empty(), sp = SP;
    var jh = '', busyKeys = {};
    $.each(SPJ, function (i, j) {
      var fin = {done: 1, failed: 1, blocked: 1}[j.stage], c = {done: 'stt-ok', blocked: 'stt-am', failed: 'stt-er'}[j.stage] || '';
      if (!fin) { busyKeys[j.key] = 1; }
      jh += '<tr class="' + ({done: 's-green', blocked: 's-amber', failed: 's-red'}[j.stage] || 's-blue') + '"><td><span class="stt-badge a">season pack</span><b>' + spName(j) + '</b><div class="stt-mut">&rarr; ' + esc(j.pack) + ' (' + fb(j.pack_size) + ')</div></td><td class="' + c + '" style="width:40%">' + esc(j.msg) + '</td><td class="stt-r"><div class="stt-mut">' + ago(j.t) + ' ago</div></td></tr>';
    });
    drawActivity(); // the jobs are listed in Activity at the top
    var nact = 0; $.each(SPJ, function (i, j) { if (!{done: 1, failed: 1, blocked: 1}[j.stage]) { nact++; } });
    var abk = {}, nab = 0; $.each(SPAB, function (i, it) { if (!busyKeys[it.key]) { abk[it.key] = 1; nab++; } });
    var nsc = sp && sp.state === 'ready' ? $.grep(sp.items || [], function (it) { return !busyKeys[it.key] && !abk[it.key]; }).length : -1;
    $('#stt-n-rep').text(nsc >= 0 || nab ? (Math.max(0, nsc) + nab) + (nact ? ' \u00b7 ' + nact + ' running' : '') : (nact ? nact + ' running' : ''));
    // packs from autobrr (item 6, 2026-10-16): open, above the library scan; started ones are in Activity
    var ab = $.grep(SPAB, function (it) { return !busyKeys[it.key]; }), $ab = $('#stt-spab').empty();
    if (ab.length || SPABQ) {
      var ah = '<div class="stt-sh" style="box-shadow:inset 3px 0 0 #3fa24a">From autobrr <span class="stt-mut">&middot; ' + ab.length + ' season' + (ab.length === 1 ? '' : 's') + (SPABQ ? ' &middot; ' + SPABQ + ' being checked with Sonarr' : '') + '</span></div>';
      if (ab.length) { ah += '<table class="stt"><thead><tr><th>Season</th><th>Pack</th><th class="stt-r">Size</th><th class="stt-r">Seeders</th><th class="stt-r">Replaces</th><th></th></tr></thead><tbody>' + $.map(ab, function (it) { return spRows(it, true); }).join('') + '</tbody></table>'; }
      $ab.html(ah);
    }
    if (!sp || sp.state === 'none') { return; }
    if (sp.state === 'error') { $('#stt-spmsg').css('color', '#e5534b').text(sp.msg); return; }
    $('#stt-spmsg').css('color', '').text(sp.state === 'running' ? (sp.msg || 'Working...') : '');
    var abKeys = {}; $.each(ab, function (i, it) { abKeys[it.key] = 1; });
    var items = $.grep(sp.items || [], function (it) { return !busyKeys[it.key] && !abKeys[it.key]; }); // started: in Activity (owner rule 2026-10-11); also from autobrr: listed there
    var open = SPOPEN || sp.state === 'running';
    $o.append('<div class="stt-sh" style="box-shadow:inset 3px 0 0 #8a8a8a"><a href="#" class="stt-spfold" style="color:inherit;text-decoration:none">' + (open ? '&minus;' : '+') + ' From the library scan</a> <span class="stt-mut">&middot; ' +
      (sp.state === 'ready' ? items.length + ' season' + (items.length === 1 ? '' : 's') + (sp.t ? ' &middot; scanned ' + ago(sp.t) + ' ago' : '') + (sp.filter ? ' &middot; only &ldquo;' + esc(sp.filter) + '&rdquo;' : '') : 'scanning') + '</span></div>');
    if (!open) { return; }
    if (!items.length) {
      if (sp.state === 'ready') { var k = sp.skipped || {}; $o.append('<p class="stt-mut" style="margin:0;padding:10px 12px">No season to replace was found' + (sp.filter ? ' for &ldquo;' + esc(sp.filter) + '&rdquo;' : '') + '. Skipped: ' + $.map(k, function (v, n) { return v + ' ' + n; }).join(', ') + '.</p>'); }
      return;
    }
    $o.append('<table class="stt"><thead><tr><th>Season</th><th>Pack</th><th class="stt-r">Size</th><th class="stt-r">Seeders</th><th class="stt-r">Replaces</th><th></th></tr></thead><tbody>' + $.map(items, function (it) { return spRows(it, false); }).join('') + '</tbody></table>');
  }
  // the rows of one season: the best pack, the other packs (hidden), the torrents that go to the trash
  function spRows(it, ab) {
    var b = it.packs[0], miss = it.missing || [], h = '';
    var epl = function (a) { return $.map(a, function (n) { return 'E' + ('0' + n).slice(-2); }).join(', '); };
    h += '<tr><td><b>' + spName(it) + '</b><div class="stt-mut">now: ' + esc(it.cur_quality) + ' ' + it.cur_res + 'p ' + hdrLbl(it.cur_hdr) + ', ' + it.files.length + ' episodes, ' + fb(it.cur_size) + '</div>' +
      (miss.length ? '<span class="stt-badge g" style="margin-left:0" title="Missing here; Sonarr imports them from the pack">brings ' + epl(miss.slice(0, 6)) + (miss.length > 6 ? ' &hellip;' : '') + '</span>' : '') +
      (ab ? '<span class="stt-badge" style="background:rgba(150,120,230,.25);color:#b9a6f0' + (miss.length ? '' : ';margin-left:0') + '">autobrr &middot; ' + ago(it.t) + ' ago</span>' : '') + '</td>' +
      '<td>' + esc(b.title) + '<span class="stt-badge ' + (b.hdr_rank > 1 ? 'g' : '') + '">' + b.res + 'p ' + b.hdr + '</span>' + (b.hun ? '<span class="stt-badge g">HUN</span>' : '') +
      '<div class="stt-mut">' + esc(b.indexer) + (ab && !it.ab_match ? ' &middot; Sonarr does not list the release autobrr saw (' + esc(it.ab_name) + '); this is the best pack it found' : '') + (it.packs.length > 1 ? ', ' + (it.packs.length - 1) + ' other pack(s): <a href="#" class="stt-spo" data-key="' + it.key + '">show</a>' : '') + '</div></td>' +
      '<td class="stt-r">' + fb(b.size) + '</td><td class="stt-r">' + b.seeders + '</td><td class="stt-r">' + it.files.length + ' files<div class="stt-mut">' + it.old.length + ' torrent(s)</div></td>' +
      '<td class="stt-r"><input type="button" class="stt-spgo stt-btn stt-sm" data-key="' + it.key + '" data-guid="" value="Replace with pack">' + (ab ? ' <input type="button" class="stt-spdis stt-btn stt-sm stt-ghost" data-key="' + it.key + '" value="Dismiss">' : '') + '</td></tr>';
    $.each(it.packs.slice(1), function (j, p) {
      h += '<tr class="stt-sp-' + it.key + '" style="display:none"><td></td><td>&#8627; ' + esc(p.title) + '<span class="stt-badge ' + (p.hdr_rank > 1 ? 'g' : '') + '">' + p.res + 'p ' + p.hdr + '</span>' + (p.hun ? '<span class="stt-badge g">HUN</span>' : '') + '</td><td class="stt-r">' + fb(p.size) + '</td><td class="stt-r">' + p.seeders + '</td><td></td><td class="stt-r"><input type="button" class="stt-spgo stt-btn stt-sm" data-key="' + it.key + '" data-guid="' + esc(p.guid) + '" value="Use this pack"></td></tr>';
    });
    if (it.old.length) {
      h += '<tr><td></td><td colspan="5" class="stt-mut" style="white-space:normal">Single-episode torrents that go to the trash after the import (' + it.old.length + ', ' + fb(it.old_size || 0) + ' on disk, the pack is ' + fb(b.size) + '):<br>' +
        $.map(it.old, function (o) { return 'E' + ('0' + o.ep).slice(-2) + ' &middot; ' + esc(o.name) + ' <span class="stt-mut">(' + fb(o.size) + ')</span>'; }).join('<br>') + '</td></tr>';
    }
    return h;
  }
  function loadSeries() {
    api('sp_series').done(function (r) {
      if (r.ok) { $('#stt-splist').html($.map(r.titles || [], function (t) { return '<option value="' + esc(t) + '">'; }).join('')); }
    });
  }
  function pollSp() {
    clearTimeout(spT);
    api('sp_get').done(function (r) {
      SP = r.sp; SPJ = r.jobs || []; SPAB = r.ab || []; SPABQ = r.ab_queue || 0; drawSp();
      var busy = r.running || (SP && SP.state === 'running');
      if (busy) { spT = setTimeout(pollSp, 2500); } else { $('#stt-spscan').prop('disabled', false); }
    });
  }
  $('#stt-spscan').on('click', function () {
    $(this).prop('disabled', true); $('#stt-spmsg').css('color', '').text('Starting...'); SPOPEN = true;
    api('sp_scan', {q: $('#stt-spq').val()}).done(function () { setTimeout(pollSp, 800); }).fail(function (x) { $('#stt-spscan').prop('disabled', false); $('#stt-spmsg').css('color', '#e5534b').text(err(x)); });
  });
  $(document).on('click', '.stt-spo', function (e) { e.preventDefault(); $('.stt-sp-' + $(this).data('key')).toggle(); });
  $(document).on('click', '.stt-spfold', function (e) { e.preventDefault(); SPOPEN = !SPOPEN; drawSp(); });
  $(document).on('click', '.stt-spdis', function () {
    var $b = $(this).prop('disabled', true);
    api('sp_ab_dismiss', {key: $b.data('key')}).done(pollSp).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });
  $(document).on('click', '.stt-spclr', function (e) { e.preventDefault(); api('sp_clear').done(pollSp); });
  $(document).on('click', '.stt-spgo', function () {
    var $b = $(this);
    if (!window.confirm('Replace the single episodes of this season with the season pack?\n\n1. Sonarr downloads the pack (the episodes stay as they are meanwhile).\n2. When it is 100% done and holds every episode you have, the season is unmonitored and its files are DELETED in Sonarr.\n3. Sonarr imports the pack; then monitoring is restored and the single-episode torrents are moved to the trash folder.\n\nIt runs in the background; if something goes wrong before step 2 nothing is changed.')) { return; }
    $b.prop('disabled', true);
    api('sp_start', {key: $b.data('key'), guid: $b.data('guid')}).done(function (r) { if (r.ok) { pollSp(); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });

  loadState().done(function () { pollFind(); pollUpd(); pollSp(); loadSeries(); });
  // the autobrr rows can arrive while the page is open: redraw the season list only when it changed (an opened pack list stays open)
  var spSig = '';
  setInterval(function () { api('sp_get').done(function (r) { var g = JSON.stringify([r.ab, r.ab_queue, r.sp && r.sp.t]); if (g === spSig) { return; } spSig = g; SPAB = r.ab || []; SPABQ = r.ab_queue || 0; SP = r.sp; SPJ = r.jobs || SPJ; drawSp(); }); }, 30000);
  setInterval(function () { api('state').done(function (r) { LAST.dl = r.dl; drawPending(r.pending); drawJobs(r.jobs); if (r.packjobs) { SPJ = r.packjobs; drawSp(); } }); api('find_get').done(function (r) { if (!r.find || r.find.state !== 'ready') { return; } drawQueue(r); var sig = JSON.stringify([r.find.items, r.res]); if (sig === lastSig) { return; } lastSig = sig; RES = r.res || RES; drawFind(r.find); }); }, 15000);
});
</script>
