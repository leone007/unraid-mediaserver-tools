  $(document).on('click', '.stt-spgo', function () {
    var $b = $(this);
    if (!window.confirm(T('sp.confirm'))) { return; }
    $b.prop('disabled', true);
    api('sp_start', {key: $b.data('key'), guid: $b.data('guid')}).done(function (r) { if (r.ok) { pollSp(); } else { $b.prop('disabled', false); window.alert(r.error); } }).fail(function (x) { $b.prop('disabled', false); window.alert(err(x)); });
  });

  loadState().done(function () { pollFind(); pollUpd(); pollSp(); loadSeries(); });
  // the autobrr rows can arrive while the page is open: redraw the season list only when it changed (an opened pack list stays open)
  var spSig = '';
  setInterval(function () { api('sp_get').done(function (r) { var g = JSON.stringify([r.ab, r.ab_queue, r.sp && r.sp.t]); if (g === spSig) { return; } spSig = g; SPAB = r.ab || []; SPABQ = r.ab_queue || 0; SP = r.sp; SPJ = r.jobs || SPJ; drawSp(); }); }, 30000);
  setInterval(function () { api('state').done(function (r) { LAST.dl = r.dl; drawPending(r.pending); drawJobs(r.jobs); if (r.packjobs) { SPJ = r.packjobs; drawSp(); } }); api('find_get').done(function (r) { if (!r.find || r.find.state !== 'ready') { return; } drawQueue(r); var sig = JSON.stringify([r.find.items, r.res]); if (sig === lastSig) { return; } lastSig = sig; RES = r.res || RES; drawFind(r.find); }); }, 15000);
});
</script>
